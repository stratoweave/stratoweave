SRC_DNODE_CHILD_8: DLeaf = DLeaf(module='IF-MIB', namespace='urn:ietf:params:xml:ns:yang:smiv2:IF-MIB', prefix='if-mib', name='ifMtu', config=False, description='The size of the largest packet which can be sent/received\non the interface, specified in octets.  For interfaces that\nare used for transmitting network datagrams, this is the\nsize of the largest network datagram that can be sent on the\ninterface.', is_key=False, mandatory=False, type=DTypeIntegerSigned(name='int32', description=None, reference=None, units=None, exts=[], builtin_type='int32', default=None, ranges=Ranges([(-2147483648, 2147483647)])), exts=[
