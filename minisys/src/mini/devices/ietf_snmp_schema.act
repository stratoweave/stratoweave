SRC_YANG_0: str = r"""/*
 * This YANG module has been generated by actsnmp mib.yang 1 (RFC 6643)
 * from the SMI module SNMPv2-MIB
 * (source sha256 b4f8ef130f580b86d2b6bc890564e46100785f589431df76954e878a7b166e11).
