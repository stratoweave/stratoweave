"""Unit tests for the reusable ietf-yang-library + get-schema serving helpers."""

import testing
import std.xml as xml

import yang
import yang.schema as yschema

import monitoring
import swyang


DEMO_YANG = r"""module demo {
  yang-version 1.1;
  namespace "urn:demo";
  prefix d;
  container system {
    leaf hostname { type string; }
  }
}"""


DEMO_SUB_YANG = r"""module demo-sub {
  yang-version 1.1;
  namespace "urn:demo-sub";
  prefix ds;
  include demo-sub-part;
  revision 2026-10-28;
}"""

DEMO_SUB_PART_YANG = r"""submodule demo-sub-part {
  yang-version 1.1;
  belongs-to demo-sub {
    prefix ds;
  }
  revision 2026-10-27;
  container part {
    leaf name { type string; }
  }
}"""


def _schema_with_library() -> yschema.DRoot:
    return yang.compile([DEMO_YANG, swyang.ietf_yang_library, swyang.ietf_datastores,
                         swyang.ietf_yang_types, swyang.ietf_inet_types])


def _test_yl_view_present():
    """When the inventory implements ietf-yang-library, build_yl_view returns a view
    with a non-empty content-id, and module_capabilities advertises yang-library:1.1
    carrying that content-id."""
    schema = _schema_with_library()
    yl_view = monitoring.build_yl_view(schema)
    if yl_view is not None:
        testing.assertTrue(len(yl_view.content_id) > 0, "content-id must be non-empty")
        caps = monitoring.module_capabilities(schema, yl_view)
        found = False
        for c in caps:
            if "yang-library:1.1" in c and "content-id=" + yl_view.content_id in c:
                found = True
        testing.assertTrue(found, "a yang-library:1.1 capability with the content-id must be advertised")
    else:
        testing.error("expected a yang-library view when the closure is compiled in")


def _test_yl_view_absent():
    """Without ietf-yang-library in the inventory, build_yl_view is None and the
    capabilities fall back to one ?module= per module."""
    schema = yang.compile([DEMO_YANG])
    yl_view = monitoring.build_yl_view(schema)
    testing.assertTrue(yl_view is None, "no yang-library view without the module")
    caps = monitoring.module_capabilities(schema, yl_view)
    found = False
    for c in caps:
        if "urn:demo?module=demo" in c:
            found = True
    testing.assertTrue(found, "demo module advertised as a ?module= capability")


def _get_schema_op(request: str) -> xml.Node:
    """A <get-schema> with `request` as its content"""
    return xml.decode('<get-schema xmlns="{monitoring.NS_NETCONF_MONITORING}">{request}</get-schema>')


def _get_schema_error(sources: dict[str, dict[str, str]], request: str) -> monitoring.GetSchemaError:
    """The GetSchemaError that get_schema_reply raises for a <get-schema>
    with `request` as its content"""
    try:
        monitoring.get_schema_reply(_get_schema_op(request), sources)
    except monitoring.GetSchemaError as e:
        return e
    raise testing.NotRaisesError("get-schema {request} raised no GetSchemaError")


def _test_get_schema_reply():
    """get_schema_reply answers a <get-schema> with the source of the
    requested identifier and version, and one without a version when the
    identifier has one version."""
    sources = monitoring.get_schema_sources([
        (name="demo", revision=None, src="demo source"),
        (name="demo", revision="2026-11-02", src="demo@2026-11-02 source"),
        (name="demo-sub", revision="2026-10-28", src="demo-sub@2026-10-28 source"),
        (name="demo-sub", revision="2026-10-28", src="demo-sub@2026-10-28 source"),
    ])
    reply = monitoring.get_schema_reply(_get_schema_op("<identifier>demo-sub</identifier>"), sources)
    testing.assertEqual(reply.tag, "data", "reply is a <data> node")
    testing.assertEqual(reply.text, "demo-sub@2026-10-28 source", "a source that repeats is held once")
    reply = monitoring.get_schema_reply(_get_schema_op("<identifier>demo-sub</identifier><version>2026-10-28</version>"), sources)
    testing.assertEqual(reply.text, "demo-sub@2026-10-28 source", "the requested version")
    reply = monitoring.get_schema_reply(_get_schema_op("<identifier>demo</identifier><version>2026-11-02</version>"), sources)
    testing.assertEqual(reply.text, "demo@2026-11-02 source", "the requested version of an identifier with two")
    reply = monitoring.get_schema_reply(_get_schema_op("<identifier>demo</identifier><version/>"), sources)
    testing.assertEqual(reply.text, "demo source", "the empty version is that of a source without a revision")

    testing.assertEqual(_get_schema_error(sources, "<identifier>demo-sub</identifier><version>2026-01-01</version>").error_tag, "invalid-value", "an unknown version")
    testing.assertEqual(_get_schema_error(sources, "<identifier>nope</identifier>").error_tag, "invalid-value", "an unknown identifier")
    not_unique = _get_schema_error(sources, "<identifier>demo</identifier>")
    testing.assertEqual(not_unique.error_tag, "operation-failed", "no version for an identifier with two")
    testing.assertEqual(not_unique.error_app_tag, "data-not-unique", "no version for an identifier with two")
    testing.assertEqual(_get_schema_error(sources, "<version>2026-11-02</version>").error_tag, "missing-element", "no identifier")


def _test_yang_library_submodules() -> str:
    """The library lists the submodules of a module, with their revisions,
    from its module_metadata."""
    return monitoring.build_yang_library(yang.compile([DEMO_SUB_YANG, DEMO_SUB_PART_YANG])).root.prsrc(deterministic=True)


def _test_get_schema_submodule():
    """An inventory serves the source of a submodule with <get-schema>, as it
    does that of a module."""
    compiled = yang.compile_with_sources([DEMO_SUB_YANG, DEMO_SUB_PART_YANG])
    inventory = monitoring.ModuleInventory(compiled.root, yang_sources=compiled.sources)
    op = xml.decode('<get-schema xmlns="urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring"><identifier>demo-sub-part</identifier></get-schema>')
    reply = monitoring.get_schema_reply(op, inventory.sources)
    testing.assertEqual(reply.text, DEMO_SUB_PART_YANG, "reply carries the submodule source")
