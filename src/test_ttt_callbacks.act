cfg2 = gdata.List([q("name")], [
    gdata.Container({
        q("name"): gdata.Leaf("k1"),
        q("config"): gdata.Container({
            q("val"): gdata.Leaf("one")
        })
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k2"),
        q("config"): gdata.Container({
            q("val"): gdata.Leaf("two")
        })
    })
])

actor reconf2(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    stack = ttt.Layer("devices", ttt.List(ttt.DeviceConfig(dev_registry), [q("name")]), None)
    
    var devs = set()
    
    def reconf_cb(dev):
        devs.add(dev)
        #print("Reconfiguring", dev)
        if devs == {"k1", "k2"}:
            t.success()
        
    dev_registry.on_reconf(reconf_cb)
    sess = stack.newsession()
    
    def cont1(_r):
        dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
        dev_registry.get_or_create("k1").set_dmc(dmc)
        dev_registry.get_or_create("k2").set_dmc(dmc)
    
    sess.edit_config(cfg2, cont1)


