def rfs_val_cfg(v: str) -> gdata.Node:
    return gdata.Container({
        q("rfs"): gdata.List([q("name")], [
            gdata.Container({
                q("name"): gdata.Leaf("k1"),
                q("base"): gdata.List([q("id")], [
                    gdata.Container({
                        q("id"): gdata.Leaf("A"),
                        q("val"): gdata.Leaf(v)
                    })
                ])
            })
        ])
    })

class DynstateEchoRFSTransform(ttt.RFSFunction):
    def transform_wrapper(self, cfg, device_info, memory, dynstate):
        # The output echoes dynstate, so each recompute commit is visible
        # below. The config and memory pass through unchanged.
        out = gdata.Leaf(0)
        if dynstate is not None:
            out = dynstate
        return (gdata.Container({q("echo"): out}), memory)

actor RFSDynstateStormActor(update_dynstate: action(?gdata.Node) -> None, report: action(int) -> None):
    var on_confs = 0

    def tick(i: int):
        update_dynstate(gdata.Leaf(i))
        if i < 6:
            after 0.03: tick(i + 1)

    def on_conf(conf: gdata.Node, linked: gdata.Node, memory: ?gdata.Node):
        on_confs += 1
        val = conf.get_opt_leaf(q("val"))
        if val is not None and val == gdata.Leaf("two"):
            report(on_confs)
        elif on_confs == 1:
            tick(1)

    def shutdown(memory: ?gdata.Node):
        pass

# Dynstate recomputes that leave the config and memory unchanged must not
# re-deliver on_conf: the actor ticks update_dynstate in a loop and must not
# get its own ticks back as an on_conf storm. A real config change after the
# storm must be delivered, so the count at that delivery is exactly 2.
actor rfs_dynstate_unchanged_skips_onconf(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    var configuring = False

    def final_count(n: int):
        testing.assertEqual(n, 2)
        t.success()

    def actor_ctor(params: ttt.TransformActorParams) -> ttt.TransformActor:
        act = RFSDynstateStormActor(params.update_dynstate, final_count)
        return ttt.TransformActor(act.on_conf, act.shutdown)

    stack = ttt.Layer("rfs", ttt.Container({
        q("rfs"): ttt.List(ttt.Container({
            q("base"): ttt.List(ttt.RFSTransform(
                DynstateEchoRFSTransform,
                dev_registry,
                actor_ctor,
            ), [q("id")]),
        }), [q("name")]),
    }), ttt.Sink())
    sess = stack.newsession()

    def echo_below() -> ?gdata.Node:
        devs = sess.below().get().get_opt_cnt(swq("devices"))
        if devs is not None:
            devlist = devs.get_opt_list(swq("device"))
            if devlist is not None:
                for e in devlist.elements:
                    devcfg = e.get_opt_cnt(swq("config"))
                    if devcfg is not None:
                        return devcfg.get_opt_leaf(q("echo"))
        return None

    def edit2():
        sess2 = stack.newsession()
        sess2.edit_config(rfs_val_cfg("two"))

    def check():
        echo = echo_below()
        if echo is not None and echo == gdata.Leaf(6):
            # The last tick's recompute has committed. Settle to let queued
            # recomputes commit, then make the real config change.
            after 0.2: edit2()
        else:
            after 0.05: check()

    def reconf_cb(dev):
        if dev == "k1" and not configuring:
            configuring = True
            sess.edit_config(rfs_val_cfg("one"))
            after 0.05: check()

    dev_registry.on_reconf(reconf_cb)
    dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
    dev_registry.get_or_create("k1").set_dmc(dmc)

########################

class DynstateMemoryRFSTransform(ttt.RFSFunction):
    def transform_wrapper(self, cfg, device_info, memory, dynstate):
        # The memory follows dynstate. The config passes through unchanged.
        mem = gdata.Leaf(0)
        if dynstate is not None:
            mem = dynstate
        return (gdata.Container(), mem)

actor RFSDynstateMemoryActor(update_dynstate: action(?gdata.Node) -> None, t: testing.AsyncT):
    def on_conf(conf: gdata.Node, linked: gdata.Node, memory: ?gdata.Node):
        if memory is not None and memory == gdata.Leaf(1):
            t.success()
        elif memory is not None and memory == gdata.Leaf(0):
            update_dynstate(gdata.Leaf(1))

    def shutdown(memory: ?gdata.Node):
        pass

# A dynstate recompute that changes the memory must still deliver on_conf
# even though the config is unchanged.
actor rfs_dynstate_memory_change_delivers_onconf(t: testing.AsyncT):
    dev_registry = swdev.DeviceRegistry(log_handler=t.log_handler)
    var configuring = False

    def actor_ctor(params: ttt.TransformActorParams) -> ttt.TransformActor:
        act = RFSDynstateMemoryActor(params.update_dynstate, t)
        return ttt.TransformActor(act.on_conf, act.shutdown)

    stack = ttt.Layer("rfs", ttt.Container({
        q("rfs"): ttt.List(ttt.Container({
            q("base"): ttt.List(ttt.RFSTransform(
                DynstateMemoryRFSTransform,
                dev_registry,
                actor_ctor,
            ), [q("id")]),
        }), [q("name")]),
    }), None)
    sess = stack.newsession()

    def reconf_cb(dev):
        if dev == "k1" and not configuring:
            configuring = True
            sess.edit_config(rfs_val_cfg("one"))

    dev_registry.on_reconf(reconf_cb)
    dmc = DeviceMetaConfig("k1", Credentials("admin", "admin"), mock=mock_with_module())
    dev_registry.get_or_create("k1").set_dmc(dmc)
