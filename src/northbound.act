"""Shared by the northbound RESTCONF and NETCONF servers."""

import ttt
import yang.gdata as ygdata


def _merge(a: ?ygdata.Node, b: ?ygdata.Node) -> ?ygdata.Node:
    if a is not None and b is not None:
        return ygdata.merge(a, b)
    return a if a is not None else b


proc def read_data(cfs: ttt.Layer, monitoring_gdata: dict[str, ygdata.Node], filt: ?ygdata.FNode, content: ttt.Content) -> ?ygdata.Node:
    """Combined reader for NB clients with support for filtering

    monitoring_gdata has the config false data that the server builds, keyed
    by namespace. The namespaces of top-level nodes in the selection filter
    are used to select the data source:
    - first check if it belongs to monitoring_gdata,
    - otherwise it is in the CFS
    """
    if filt is not None:
        cfs_children = []
        monitoring_children = {}
        for child in filt.children:
            name = child.name
            if name is not None and name.q in monitoring_gdata:
                if name.q not in monitoring_children:
                    monitoring_children[name.q] = []
                monitoring_children[name.q].append(child)
            else:
                cfs_children.append(child)
        if len(monitoring_children) == 0:
            return cfs.newsession().get_data(filt, content)
        res = cfs.newsession().get_data(ygdata.FNode(children=cfs_children), content) if len(cfs_children) > 0 else None
        if not isinstance(content, ttt.ContentConfig):
            for ns, children in monitoring_children.items():
                res = _merge(res, ygdata.filter(monitoring_gdata[ns], ygdata.FNode(children=children)))
        return res
    data = cfs.newsession().get_data(None, content)
    if not isinstance(content, ttt.ContentConfig):
        for gdata in monitoring_gdata.values():
            data = _merge(data, gdata)
    return data
