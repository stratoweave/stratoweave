"""Formatting at concrete, inherited and erased-type boundaries."""

import testing
import std.xml as xml
import netconf
import ttt
import logs
import logging
from adapters.adapter import ModCap, NotifSpec, NotifEvent
from adapters.iosxe_cli import DirEntry, BgpNeighbor
from cli.lineedit import Key
import yang.gdata as gdata


def render[A(Show)](item: A) -> str:
    return str(item)


def _test_renderer_extensions():
    testing.assertEqual(str(ModCap("m", "urn:m")), "ModCap(name=m, namespace=urn:m, revision=None, feature=[])")
    spec = NotifSpec(gdata.Id("urn:m", "event"), "stream")
    testing.assertEqual(repr(spec), str(spec))
    testing.assertEqual(str(NotifEvent(gdata.Id("urn:m", "event"), "now", None, xml.Node("event"))),
                        "NotifEvent(" + str(gdata.Id("urn:m", "event")) + " @ now)")
    testing.assertEqual(str(DirEntry("image.bin", u64(42), "today")), "image.bin 42 today")
    testing.assertEqual(str(BgpNeighbor("ipv4", "default", "192.0.2.1", "up")), "ipv4 default 192.0.2.1 up 0 0")
    key = Key("char", "x")
    testing.assertEqual(str(key), "Key('char', 'x')")
    testing.assertEqual(repr(key), str(key))
    # An omitted method keeps its old root default, rather than the other renderer.
    testing.assertTrue(repr(DirEntry("x", u64(1), "now")).startswith("<"))


def _test_inherited_path_renderer():
    path: ttt.Path = ttt.PathElem(gdata.Id("urn:m", "items"), ttt.PathRoot("layer"))
    testing.assertEqual(str(path), "/layer/items#urn:m")
    testing.assertEqual(render(path), str(path))
    testing.assertEqual(str(ttt.CfgOk()), "CfgOk()")
    testing.assertEqual(str(ttt.CfgOk(empty=True)), "CfgOk(empty=True)")
    testing.assertIn("status=False", str(ttt.LinkRequest("tag", gdata.FNode(), gdata.FNode(), False)))
    testing.assertIn("tag=tag", str(ttt.LinkUpdate("tag", gdata.FNode(), gdata.FNode(), gdata.Container({}))))


def _test_exception_renderer_and_erasure():
    rpc = netconf.RpcError(xml.Node("rpc-error", children=[xml.Node("error-tag", text="bad-element")]))
    error = netconf.MalformedRpcError(" broken ", [rpc])
    testing.assertEqual(render(error), error._name() + ": broken")
    testing.assertIn("netconf.RpcError(error_type='', error_tag='bad-element'", repr(error))
    try:
        raise error
    except Exception as caught:
        testing.assertEqual(str(caught), str(error))
        testing.assertIn("bad-element", repr(caught))
        testing.assertIn("bad-element", str(ttt.CfgError(caught)))


def _test_erased_log_containers():
    payload: value = {"items": [1, False, "x"], "bytes": b"a"}
    text = logs.TextFormatter().format(logging.Message(logging.INFO, [], None, "payload", {"x": payload, "ok": False}))
    if text is not None:
        expected = r""" payload x="{'items': [1, False, 'x'], 'bytes': b'a'}" ok=False"""
        testing.assertEqual(text[-len(expected):], expected)
    else:
        testing.error("Missing log line")
