actor _test_failed_postcheck_rolls_back(t: testing.EnvT):
    """A failing post-check rolls back instead of committing."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def bad(done: action(bool, str) -> None) -> None:
        done(False, "peer down")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "succeeded":
            t.failure(ValueError("a failed post-check must not end succeeded"))
        elif status == "rolled-back":
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "rollback"],
                                "rollback must replace commit")
            testing.assertEqual(OLD, adapter.running(),
                                "device should be back on the old release")
            testing.assertEqual("fail", _pub_verdict(oper, "postcheck"),
                                "post-check verdict not published")
            testing.assertEqual("a: peer down", _pub_detail(oper, "postcheck"),
                                "detail must name the objector")
            testing.assertEqual("rollback", _pub_stage(oper), "the run should end in the rollback")
            testing.assertEqual("post-check failed: a: peer down", _pub_reason(oper),
                                "the reason should say why it rolled back")
            t.success()

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", bad)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


