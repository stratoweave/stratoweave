actor _test_reached_target_is_not_reinstalled(t: testing.EnvT):
    """Intent restated after a successful upgrade must not install again:
    the status answers it, so nothing runs, and it stays succeeded.

    Measured on a c8000v: sent the sequence a second time, it staged the image,
    accepted the install and reported success -- having changed nothing, which
    afterwards is indistinguishable from a real upgrade.
    """
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def verify() -> None:
        testing.assertEqual(mgr.get_status(), "succeeded", "the status should stay")
        testing.assertEqual(adapter.calls(), ["check", "prepare", "install", "commit", "check", "cleanup"],
                            "the restated intent should run nothing")
        t.success()

    def again() -> None:
        # The same intent again, once the first round has finished, and a
        # reconnect, which looks at the intent again.
        if mgr.get_status() != "succeeded":
            after 0.05: again()
            return
        mgr.set_config("camp-1", NEW, False, {})
        mgr.on_connect()
        after 0.05: verify()

    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: again()


actor _test_unreadable_release_still_installs(t: testing.EnvT):
    """A read that fails is not evidence that the device is up to date.

    Blocking an upgrade on one failed read would be worse than a redundant
    install, so the manager proceeds without the comparison and says so.
    """
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "check")
    dev = _devmgr(t, noop_on_reconf)

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            testing.assertEqual(adapter.calls(), ["check", "prepare", "install", "commit", "check", "cleanup"],
                                "a failed check should not stop the install")
            t.success()

    dev.set_update_oper(on_state)
    mgr = dev.get_swmgr()
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_install_runs_once(t: testing.EnvT):
    """Config that changes during a run, but not its intent, does not run
    the install again: the run's end looks at it once, and the status then
    answers it."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def verify() -> None:
        # Wait for the run to finish before counting its calls.
        if mgr.get_status() != "succeeded":
            after 0.05: verify()
            return
        testing.assertEqual(adapter.calls(), ["check", "prepare", "install", "commit", "check", "cleanup"],
                            "the sequence should have run once, not twice")
        t.success()

    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
    mgr.set_config("camp-1", NEW, True, {})
    mgr.set_config("camp-1", NEW, False, {})
    after 0.05: verify()


actor _test_prechecks_gate_the_install(t: testing.EnvT):
    """Install waits for every pre-check to pass, and both verdicts are
    published."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()
    var answered = 0

    def quick(done: action(bool, str) -> None) -> None:
        answered += 1
        done(True, "")

    def slow(done: action(bool, str) -> None) -> None:
        def reply() -> None:
            testing.assertTrue("install" not in adapter.calls(),
                               "install must wait for all pre-checks")
            answered += 1
            done(True, "")
        after 0.05: reply()

    def on_state(oper: ?ygdata.Node) -> None:
        if _pub_status(oper) == "succeeded":
            testing.assertEqual(2, answered, "both pre-checks must have run")
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "commit", "check", "cleanup"],
                                "install must follow the passed pre-checks")
            testing.assertEqual("pass", _pub_verdict(oper, "precheck"),
                                "pre-check verdict not published")
            testing.assertEqual("a; b", _pub_detail(oper, "precheck"),
                                "pre-check detail not published")
            testing.assertEqual("pass", _pub_verdict(oper, "postcheck"),
                                "post-check verdict not published")
            t.success()

    dev.set_update_oper(on_state)
    mgr.add_precheck("a", quick)
    mgr.add_precheck("b", slow)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_refused_precheck_leaves_the_device_alone(t: testing.EnvT):
    """A refusing pre-check ends the run failed before anything is installed."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def yes(done: action(bool, str) -> None) -> None:
        done(True, "")

    def no(done: action(bool, str) -> None) -> None:
        done(False, "peer down")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "succeeded":
            t.failure(ValueError("a refused pre-check must not install"))
        elif status == "failed":
            testing.assertEqual(adapter.calls(), ["check", "prepare"],
                                "install must not run after a refusal")
            testing.assertEqual(OLD, adapter.running(),
                                "device must still be on the old release")
            testing.assertEqual("fail", _pub_verdict(oper, "precheck"),
                                "pre-check verdict not published")
            testing.assertEqual("b: peer down", _pub_detail(oper, "precheck"),
                                "detail must name the objector")
            testing.assertEqual("not-run", _pub_verdict(oper, "postcheck"),
                                "post-checks must not have run")
            testing.assertEqual("precheck", _pub_stage(oper), "the stage should be the refusing round")
            testing.assertEqual("pre-check failed: b: peer down", _pub_reason(oper),
                                "the reason should name the objector")
            t.success()

    dev.set_update_oper(on_state)
    mgr.add_precheck("a", yes)
    mgr.add_precheck("b", no)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


