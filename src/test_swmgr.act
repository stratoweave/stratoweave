actor _test_failed_rollback_is_failed(t: testing.EnvT):
    """When the rollback itself fails the run ends failed, not rolled-back."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "rollback")
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def bad(done: action(bool, str) -> None) -> None:
        done(False, "peer down")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "failed":
            testing.assertEqual("rollback", _pub_stage(oper), "the stage should be the failed rollback")
            testing.assertEqual("post-check failed: a: peer down; mock: rollback failed",
                                _pub_reason(oper), "the reason should keep why it rolled back")
            t.success()
        elif status == "succeeded" or status == "rolled-back":
            t.failure(ValueError("a failed rollback must end failed, got {status}"))

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", bad)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_failed_commit_rolls_back(t: testing.EnvT):
    """A refused commit rolls back; the device would revert on its own anyway."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, "commit")
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "rolled-back":
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "commit", "rollback"],
                                "a failed commit must be followed by rollback")
            testing.assertEqual("rollback", _pub_stage(oper), "the run should end in the rollback")
            # The passed post-check tells a failed commit from a failed post-check.
            testing.assertEqual("pass", _pub_verdict(oper, "postcheck"),
                                "post-check verdict not published")
            testing.assertEqual("mock: commit failed", _pub_reason(oper),
                                "the adapter's error should be the reason, once")
            t.success()
        elif status == "succeeded" or status == "failed":
            t.failure(ValueError("a failed commit must roll back, got {status}"))

    dev.set_update_oper(on_state)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_no_commit_window_left_rolls_back(t: testing.EnvT):
    """With less than the commit margin left on the device timer the manager
    does not start post-checks; it aborts."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, commit_window=30)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()
    var asked = False

    def check(done: action(bool, str) -> None) -> None:
        asked = True
        done(True, "")

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "rolled-back":
            testing.assertFalse(asked, "no post-check should run without time to commit")
            testing.assertEqual(adapter.calls(),
                                ["check", "prepare", "install", "rollback"],
                                "rollback must replace commit")
            testing.assertEqual("no time left to commit before the device reverts",
                                _pub_reason(oper), "the reason should say why it rolled back")
            t.success()
        elif status == "succeeded":
            t.failure(ValueError("must not commit after the device timer"))

    dev.set_update_oper(on_state)
    mgr.add_postcheck("a", check)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})


actor _test_reverted_device_is_not_succeeded(t: testing.EnvT):
    """A commit that reports ok on a device already back on the old release
    ends failed, not succeeded."""
    def noop_on_reconf(name: str) -> None:
        pass

    adapter = swmock.MockSoftwareAdapter(t.log_handler, OLD, auto_abort=True)
    dev = _devmgr(t, noop_on_reconf)
    mgr = dev.get_swmgr()

    def on_state(oper: ?ygdata.Node) -> None:
        status = _pub_status(oper)
        if status == "failed":
            testing.assertEqual(OLD, adapter.running(),
                                "the device should be back on the old release")
            testing.assertEqual("commit", _pub_stage(oper), "the stage should be the commit")
            testing.assertEqual("device runs {OLD} after the commit, not {NEW}", _pub_reason(oper),
                                "the reason should name both releases")
            t.success()
        elif status == "succeeded":
            t.failure(ValueError("device on the old release must not be succeeded"))

    dev.set_update_oper(on_state)
    mgr.set_adapter(adapter)
    mgr.set_config("camp-1", NEW, False, {})
