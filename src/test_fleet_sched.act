#
# Tests for the window simulator. No StratoWeave runtime, no clock, no
# I/O.
#

import testing

import fleet_sched as core
import fleet_sched_sim as sim

HOUR = 3600
DAY = 86400

#############################################################################
# window simulator
#############################################################################

def _test_a_window_on_estimate_defers_nothing():
    # each decision batch costs a little wall time (the debounce), and the
    # controller repays it from headroom above target rather than deferring
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(228, 600, 600, w, 10, 20, 10, 30, None)
    testing.assertEqual(r.deferred, 0, "a window run on estimate must complete")
    testing.assertTrue(r.peak <= 20, "and stay within max concurrency to do it")

def _test_slow_upgrades_spend_the_headroom():
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(228, 600, 1200, w, 10, 20, 10, 30, None)
    testing.assertEqual(r.peak, 20, "2x duration must drive concurrency to max")

def _test_learned_duration_alarms_at_the_start():
    # same 2x-slow window, seeded with what the previous window observed:
    # it raises the alarm at the start, where the cold start raises it at
    # the first upgrade's expected end, and it defers no more
    w = core.Window("weekly", 0, 4 * HOUR)
    cold = sim.simulate_window(228, 600, 1200, w, 10, 20, 10, 30, None)
    warm = sim.simulate_window(228, 600, 1200, w, 10, 20, 10, 30, 1200)
    testing.assertTrue(warm.deferred <= cold.deferred,
                       "a learned estimate must not defer more devices than a cold start")
    testing.assertTrue("ALARM" in warm.log[1], "a learned estimate alarms at the start")
    testing.assertTrue("ALARM" not in cold.log[1], "a cold start alarms later")

def _test_max_concurrency_is_never_breached():
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(500, 600, 1800, w, 10, 20, 10, 30, None)
    testing.assertTrue(r.peak <= 20, "blast radius is a hard ceiling")

def _test_devices_in_flight_hold_their_slots():
    # two already running until 600 fill target 2: the first new launches
    # wait for them instead of starting at the window opening
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(4, 600, 600, w, 2, 2, 2, 30, None,
                            running=[(600, 600), (600, 600)])
    testing.assertEqual(r.launch_offsets, [630, 630, 1260, 1260], None)

def _test_a_cold_window_completes():
    """How many devices the controller completes in a window it enters
    cold, when there are more devices than fit: the ramp doubles from one
    as each round lands, then rounds of the concurrency, and a round only
    starts while the window leaves room to finish."""
    # (span, concurrency, duration, debounce, devices, completed)
    cases = [
        (60, 4, 8, 2, 31, 19),
        (60, 8, 8, 2, 51, 31),
        (240, 4, 4, 2, 300, 155),
        (3600, 64, 600, 30, 163, 31),
        (40, 3, 8, 2, 19, 9),
        (38, 3, 8, 2, 16, 6),
        (10, 4, 8, 2, 13, 1),
        (8, 4, 8, 2, 12, 0),
    ]
    for c in cases:
        w = core.Window("w", 0, c.0)
        r = sim.simulate_window(c.4, c.2, c.2, w, c.1, c.1, 1, c.3)
        label = "span {c.0} conc {c.1} duration {c.2} debounce {c.3}"
        testing.assertEqual(r.completed, c.5, label)

def _test_slow_upgrades_do_not_raise_concurrency():
    """In an open window, upgrades that take twice the estimate keep the
    target in flight: slower devices lower the pace, they never put more
    devices in flight."""
    w = core.Window("w", 0, 500000)
    r = sim.simulate_window(200, 600, 1200, w, 20, 40, 1, 30)
    testing.assertEqual(r.completed, 200, None)
    testing.assertEqual(r.peak, 20, "slow upgrades must not put more than the target in flight")

def _test_window_entry_is_a_ramp_not_the_placement():
    # 20 devices planned into one window; entering it launches the first
    # ramp rung, and never the whole placement at once
    w = core.Window("w", 0, 4 * HOUR)
    r = sim.simulate_window(20, 20 * 60, 20 * 60, w, 8, 12, 1, 30)
    testing.assertEqual(r.first_launch, 1, "window entry starts one rung, not everything")
    testing.assertEqual(r.completed, 20, None)
    testing.assertEqual(r.overran, 0, None)
    testing.assertTrue(r.peak <= 8, "on estimate the ramp tops out at target")

#############################################################################
# snapshot tests over the window simulator -- the tick table is the record of
# how the concurrency controller behaves
#############################################################################

def _sim_text(label: str, r: sim.SimResult) -> str:
    lines = [label, ""]
    for l in r.log:
        lines.append(l)
    lines.append("")
    lines.append(f"launched {r.launched}, completed {r.completed}, deferred {r.deferred}, "
                 + f"peak concurrency {r.peak}")
    return "\n".join(lines)

def _test_snapshot_window_on_estimate():
    """A window full at target, running exactly on estimate. The debounce
    between rounds costs one round, so the plan runs a little above
    target, and defers nothing."""
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(228, 600, 600, w, 10, 20, 10, 30, None)
    return _sim_text("228 devices, 10min estimate, 10min actual, target 10 / max 20", r)

def _test_snapshot_window_2x_slow():
    """The same window when upgrades take twice as long. The window is the
    commitment, so concurrency climbs toward max rather than deferring."""
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(228, 600, 1200, w, 10, 20, 10, 30, None)
    return _sim_text("228 devices, 10min estimate, 20min actual, target 10 / max 20", r)

def _test_snapshot_window_2x_slow_learned():
    """Same again, but seeded with the duration observed in the previous window:
    the alarm comes at the start."""
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(228, 600, 1200, w, 10, 20, 10, 30, 1200)
    return _sim_text("228 devices, duration learned from last window (20min)", r)

def _test_snapshot_ramp():
    """Ramp up from a single canary to target 64, each rung gated on the
    previous landing cleanly."""
    w = core.Window("weekly", 0, 4 * HOUR)
    r = sim.simulate_window(400, 600, 600, w, 64, 128, 1, 30)
    return _sim_text("400 devices, ramp from 1 to target 64", r)

def _test_snapshot_window_entry_ramp():
    """The tick table behind the window-entry test: twenty placed devices,
    and entering the window launches one of them, not twenty."""
    w = core.Window("w", 0, 4 * HOUR)
    r = sim.simulate_window(20, 20 * 60, 20 * 60, w, 8, 12, 1, 30)
    return _sim_text("20 devices, 20min upgrades on estimate, ramp from 1 to target 8", r)
