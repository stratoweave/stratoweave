"""Scale tests for NETCONF buffering workloads.

Run focused studies from the repository root:

    acton test scale --release --module test_netconf_buffer_perf --name consume_messages --end-scale 16384
    acton test scale --release --module test_netconf_buffer_perf --name incremental_search --end-scale 1048576
    acton test scale --release --module test_netconf_buffer_perf --name fragmented_read --end-scale 1048576

Scale is the number of complete legacy messages or one-byte transport reads.
Each t.loop() body includes Buffer construction and writes because both are
part of the receive-side cost.
"""

import testing

from netconf.buffer import Buffer


SEPARATOR = b"]]>]]>"


def _test_consume_messages(t: testing.SyncT):
    """Parse many complete messages delivered in one transport read."""
    n = t.scale()
    wire = ("x]]>]]>" * n).encode()
    for scale in t.loop():
        buf = Buffer()
        buf.write_bytes(wire)
        messages = 0
        while buf.has_unread_bytes():
            pos = buf.find_bytes(SEPARATOR)
            if isinstance(pos, int):
                assert pos == 1
                assert buf.read_bytes(pos) == b"x"
                assert buf.skip_bytes(len(SEPARATOR)) == True
                buf.consume()
                messages += 1
            else:
                raise ValueError("missing NETCONF separator")
        assert messages == scale


def _test_incremental_search(t: testing.SyncT):
    """Search after every byte-sized transport read until a separator arrives."""
    for scale in t.loop():
        buf = Buffer()
        for i in range(scale):
            buf.write_bytes(b"x")
            assert buf.find_bytes(SEPARATOR) is None
        buf.write_bytes(SEPARATOR)
        assert buf.find_bytes(SEPARATOR) == scale


def _test_fragmented_read(t: testing.SyncT):
    """Assemble one payload delivered as byte-sized transport reads."""
    for scale in t.loop():
        buf = Buffer()
        for i in range(scale):
            buf.write_bytes(b"x")
        payload = buf.read_bytes(scale)
        assert payload == b"x" * scale
        buf.consume()
        assert not buf.has_unread_bytes()
