import argconf
import file
import logging
import ssh
import ssh_config
import std.xml as xml

import db as swdb
import device as swdev
import logs as swlogs
import platform_probes as swplat
import ttt as ttt
import yang.gdata as ygdata
import yang.schema as yschema
import yang.xml as yxml


def _no_yang_src(layer: int) -> list[str]:
    """Default yang_src_for_layer for sysspecs generated before YANG sources
    were plumbed through: no sources, so servers skip schema serving."""
    return []


def _resolve_yang_src(f: ?proc(int) -> list[str]) -> proc(int) -> list[str]:
    if f is not None:
        return f
    return _no_yang_src


class SysSpec(value):
    """Exportable wrapper for generated functions from sysspec.act

    platform_probes is the app's list of platform probes, by default the ones
    that come with StratoWeave (platform_probes.PROBES).
    """
    device_types: dict[str, swdev.DeviceType]
    @property
    get_layers: proc(swdev.DeviceRegistry, ?logging.Handler, ?swdb.Store) -> ttt.Layer
    @property
    schema_for_layer: proc(int) -> yschema.DRoot
    @property
    oper_schema_for_layer: proc(int) -> yschema.DRoot
    platform_probes: list[swdev.PlatformProbe]
    @property
    yang_src_for_layer: proc(int) -> list[str]

    def __init__(self, device_types, get_layers, schema_for_layer,
                 oper_schema_for_layer: proc(int) -> yschema.DRoot,
                 platform_probes: list[swdev.PlatformProbe]=swplat.PROBES,
                 yang_src_for_layer: ?proc(int) -> list[str] = None):
        self.device_types = device_types
        self.get_layers = get_layers
        self.schema_for_layer = schema_for_layer
        self.oper_schema_for_layer = oper_schema_for_layer
        self.platform_probes = platform_probes
        self.yang_src_for_layer = _resolve_yang_src(yang_src_for_layer)


class SshTransportSettings(value):
    """SSH transport settings for a listening or connecting SSH endpoint.

    Empty algorithm lists mean "no preference" and leave the SSH library
    default in place. A rekey limit of None uses the negotiated cipher's RFC
    4344 volume limit for bytes, and disables time-based rekeying for seconds.
    """
    ciphers: list[str]
    macs: list[str]
    key_exchanges: list[str]
    host_key_algorithms: list[str]
    public_key_algorithms: list[str]
    compression_algorithms: list[str]
    compression_level: int
    rekey_after_bytes: ?int
    rekey_after_seconds: ?int
    minimum_rsa_bits: int

    def __init__(self, ciphers: list[str], macs: list[str],
                 key_exchanges: list[str], host_key_algorithms: list[str],
                 public_key_algorithms: list[str],
                 compression_algorithms: list[str],
                 compression_level: int, rekey_after_bytes: ?int,
                 rekey_after_seconds: ?int, minimum_rsa_bits: int):
        self.ciphers = ciphers
        self.macs = macs
        self.key_exchanges = key_exchanges
        self.host_key_algorithms = host_key_algorithms
        self.public_key_algorithms = public_key_algorithms
        self.compression_algorithms = compression_algorithms
        self.compression_level = compression_level
        self.rekey_after_bytes = rekey_after_bytes
        self.rekey_after_seconds = rekey_after_seconds
        self.minimum_rsa_bits = minimum_rsa_bits

    @staticmethod
    def declare(p: argconf.Parser, prefix: str):
        """Declare the transport settings for one endpoint under `prefix`."""
        p.add_str_list(
            prefix + ".cipher", default=[],
            help="Ciphers to offer, most preferred first"
        )
        p.add_str_list(
            prefix + ".mac", default=[],
            help="MAC algorithms to offer, most preferred first"
        )
        p.add_str_list(
            prefix + ".key_exchange", default=[],
            help="Key exchange algorithms to offer, most preferred first"
        )
        p.add_str_list(
            prefix + ".host_key_algorithm", default=[],
            help="Host key algorithms to offer, most preferred first"
        )
        p.add_str_list(
            prefix + ".public_key_algorithm", default=[],
            help="Public key algorithms to accept, most preferred first"
        )
        p.add_str_list(
            prefix + ".compression_algorithm", default=[],
            help="Compression algorithms to offer, most preferred first"
        )
        p.add_int(
            prefix + ".compression_level", default=7,
            help="zlib compression level, 1 (fastest) to 9 (smallest)"
        )
        p.add_int(
            prefix + ".rekey_after_bytes",
            help="Rekey after this many bytes; the cipher's own limit if unset"
        )
        p.add_int(
            prefix + ".rekey_after_seconds",
            help="Rekey after this many seconds; no time-based rekey if unset"
        )
        p.add_int(
            prefix + ".minimum_rsa_bits", default=1024,
            help="Reject RSA keys shorter than this"
        )

    @staticmethod
    def read(args: argconf.Config, prefix: str) -> SshTransportSettings:
        """Read the settings declared by `declare` under the same prefix."""
        return SshTransportSettings(
            args.get_str_list(prefix + ".cipher"),
            args.get_str_list(prefix + ".mac"),
            args.get_str_list(prefix + ".key_exchange"),
            args.get_str_list(prefix + ".host_key_algorithm"),
            args.get_str_list(prefix + ".public_key_algorithm"),
            args.get_str_list(prefix + ".compression_algorithm"),
            args.get_int(prefix + ".compression_level"),
            args.get_opt_int(prefix + ".rekey_after_bytes"),
            args.get_opt_int(prefix + ".rekey_after_seconds"),
            args.get_int(prefix + ".minimum_rsa_bits"))

    def transport_config(self) -> ssh.TransportConfig:
        """Build the SSH TransportConfig these settings describe."""
        return ssh_config.transport_config(
            self.ciphers,
            self.macs,
            self.key_exchanges,
            self.host_key_algorithms,
            self.public_key_algorithms,
            self.compression_algorithms,
            self.compression_level,
            self.rekey_after_bytes,
            self.rekey_after_seconds,
            self.minimum_rsa_bits)


class UdpNotifSettings(value):
    """IOS XR UDP-Notif settings, under udp_notif.

    UDP-Notif is off unless receiver_address is set. An empty string unsets
    receiver_address and source_interface, so a later source can turn off
    what an earlier one set.
    """
    listen_address: str
    receiver_address: ?str
    source_interface: ?str
    max_segment_size: int

    def __init__(self, listen_address: str, receiver_address: ?str,
                 source_interface: ?str, max_segment_size: int):
        self.listen_address = listen_address
        self.receiver_address = receiver_address
        self.source_interface = source_interface
        self.max_segment_size = max_segment_size

    @staticmethod
    def declare(p: argconf.Parser):
        """Declare the UDP-Notif settings under udp_notif."""
        p.add_str(
            "udp_notif.listen_address", default="0.0.0.0",
            help="Local address for IOS XR UDP-Notif listeners"
        )
        p.add_str(
            "udp_notif.receiver_address",
            help="Address IOS XR devices use to reach this StratoWeave instance; UDP-Notif is off if unset or empty"
        )
        p.add_str(
            "udp_notif.source_interface",
            help="IOS XR source interface for UDP-Notif traffic; none if unset or empty"
        )
        p.add_int(
            "udp_notif.max_segment_size", default=1232,
            help="Maximum IOS XR UDP-Notif datagram segment size"
        )

    @staticmethod
    def read(args: argconf.Config) -> UdpNotifSettings:
        """Read the settings declared by declare."""
        def read_opt(name: str) -> ?str:
            text = args.get_opt_str(name)
            return text if text != "" else None

        return UdpNotifSettings(
            args.get_str("udp_notif.listen_address"),
            read_opt("udp_notif.receiver_address"),
            read_opt("udp_notif.source_interface"),
            args.get_int("udp_notif.max_segment_size"))


class SystemSettings(value):
    startup_config_files: list[str]
    db_spec: ?str
    http_port: int
    netconf_port: int
    netconf_host_key_path: ?str
    netconf_user: str
    netconf_password: str
    netconf_ssh: SshTransportSettings
    udp_notif: UdpNotifSettings
    exit_on_done: bool
    log: swlogs.LogSettings
    software_image_dir: ?str

    def __init__(self, startup_config_files: list[str], db_spec: ?str,
                 http_port: int, netconf_port: int,
                 netconf_host_key_path: ?str,
                 netconf_user: str, netconf_password: str,
                 netconf_ssh: SshTransportSettings,
                 udp_notif: UdpNotifSettings,
                 exit_on_done: bool, log: swlogs.LogSettings,
                 software_image_dir: ?str):
        self.startup_config_files = startup_config_files
        self.db_spec = db_spec
        self.http_port = http_port
        self.netconf_port = netconf_port
        self.netconf_host_key_path = netconf_host_key_path
        self.netconf_user = netconf_user
        self.netconf_password = netconf_password
        self.netconf_ssh = netconf_ssh
        self.udp_notif = udp_notif
        self.exit_on_done = exit_on_done
        self.log = log
        self.software_image_dir = software_image_dir

    @staticmethod
    def parser() -> argconf.Parser:
        """Return the system settings schema."""
        p = argconf.Parser("STRATOWEAVE")
        p.add_str_list(
            "startup_config_files", positional="FILE", default=[],
            help="Startup configuration files, applied in order"
        )
        p.add_str("db", help="TTT database: an LMDB path or a database URL")
        p.add_int("http.port", default=80, help="HTTP listen port")
        p.add_int("netconf.port", default=830, help="NETCONF SSH listen port")
        p.add_str(
            "netconf.user", default="admin",
            help="NETCONF SSH username (v1 static credential)"
        )
        p.add_str(
            "netconf.password", default="admin",
            help="NETCONF SSH password (v1 static credential)"
        )
        p.add_str(
            "netconf.ssh.host_key",
            help="SSH host key file for NETCONF; ephemeral in-memory key if unset"
        )
        SshTransportSettings.declare(p, "netconf.ssh")
        UdpNotifSettings.declare(p)
        p.add_bool("exit_on_done", help="Exit after startup config has been applied")
        p.add_str("software.image_dir", help="Folder with software image files; none if unset")
        swlogs.LogSettings.declare(p)
        return p

    @staticmethod
    def parse(argv: list[str],
              system_settings: ?list[dict[str, ?value]]=None,
              environment: ?dict[str, str]=None) -> SystemSettings:
        """Resolve system settings without reading process state or files."""
        args = SystemSettings.parser().parse(argv, system_settings, environment)
        return SystemSettings(
            args.get_str_list("startup_config_files"),
            args.get_opt_str("db"),
            args.get_int("http.port"),
            args.get_int("netconf.port"),
            args.get_opt_str("netconf.ssh.host_key"),
            args.get_str("netconf.user"),
            args.get_str("netconf.password"),
            SshTransportSettings.read(args, "netconf.ssh"),
            UdpNotifSettings.read(args),
            args.get_bool("exit_on_done"),
            swlogs.LogSettings.read(args),
            args.get_opt_str("software.image_dir"))


NS_SW_RFS = "http://stratoweave.org/yang/stratoweave-rfs"


def _rfs_for_device(dev):
    def q(n):
        return ygdata.Id(NS_SW_RFS, n)

    return ygdata.Container({
        q('rfs'): ygdata.List([q("name")], [
            ygdata.Container({
                q("name"): ygdata.Leaf(dev)
            })
        ])
    })


actor RfsReconf(dev_registry: swdev.DeviceRegistry, cfs: ttt.Layer):
    _rfs = cfs
    while True:
        _next = _rfs.below()
        # RFS is 2nd to last layer
        if _next.below() is _next:
            break
        _rfs = _next

    def _on_reconf(dev: str):
        _rfs.edit_config(_rfs_for_device(dev))

    dev_registry.on_reconf(_on_reconf)


actor Lifecycle(logs: swlogs.Logs, env_exit: action(int) -> None):
    """Log the startup events that arrive as callbacks, and exit.

    exit writes the log messages sent so far before the process ends.
    """
    log = logging.Logger(logs.startup)

    def netconf_listening(port: int, error: ?Exception) -> None:
        if error is None:
            log.info("NETCONF server listening", {"port": port})

    def exit(code: int) -> None:
        log.info("StratoWeave exiting", {"code": code})
        logs.drain()
        env_exit(code)


actor StartupConfigApplier(startup_config_files: list[str], exit_on_done: bool, top_schema: yschema.DRoot, cfs: ttt.Layer, exit: action(int) -> None, rfcap: file.ReadFileCap, log_handler: logging.Handler):
    var log = logging.Logger(log_handler)

    def _conf_load_done(result):
        if isinstance(result, Exception):
            log.error("Error applying config file(s)", {"error": result})
            exit(1)
        else:
            log.info("All config files applied")
            if exit_on_done:
                log.info("No more config files to apply, exiting..")
                exit(0)

    def _apply():
        # Read and apply config files; merge multiple snippets (files) into a single intent
        input_merge = ygdata.Container()
        for filename in startup_config_files:
            log.debug("Reading config file", {"config_file": filename})
            try:
                f = file.ReadFile(rfcap, filename)
                data = f.read()
                f.close()
                conf_xml = xml.decode(data.decode())
                conf_gd = yxml.from_xml(top_schema, conf_xml, loose=True)
                input_merge = ygdata.merge(input_merge, conf_gd)
            except Exception as e:
                log.error("Error reading config file", {"config_file": filename, "error": e})
                exit(1)
                return

        log.info("Applying config file(s)...")
        session = cfs.newsession()
        session.edit_config(input_merge, None, _conf_load_done)

    if len(startup_config_files) > 0:
        after 0.5: _apply()


actor StartupBootstrap(cfs: ttt.Layer, restore_from_db: bool, netconf_host_key_path: ?str, rfcap: file.ReadFileCap, start_runtime: proc(?str) -> None, exit: action(int) -> None, log_handler: logging.Handler):
    var log = logging.Logger(log_handler)
    var _netconf_host_key: ?str = None

    def _recompute_done(result):
        if isinstance(result, Exception):
            log.error("Error recomputing restored TTT state", {"error": result})
            exit(1)
            return
        log.info("Restored TTT state reconciled")
        start_runtime(_netconf_host_key)

    def _restore_done(error: ?Exception) -> None:
        if error is not None:
            log.error("Error loading persisted TTT state", {"error": error})
            exit(1)
            return
        log.info("Recomputing restored TTT state")
        cfs.newsession().recompute(_recompute_done)

    def _run():
        # The NETCONF SSH layer wants host-key material, not a path, so read the
        # configured key file here (before launching the runtime) and forward it.
        hkp = netconf_host_key_path
        if hkp is not None:
            try:
                f = file.ReadFile(rfcap, hkp)
                _netconf_host_key = f.read().decode()
                f.close()
            except Exception as e:
                log.error("Error reading NETCONF host key", {"path": hkp, "error": e})
                exit(1)
                return

        if not restore_from_db:
            start_runtime(_netconf_host_key)
            return

        log.info("Loading persisted TTT state")
        cfs.load_from_db(_restore_done)

    after 0: _run()
