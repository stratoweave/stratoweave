"""Integration tests for the northbound RESTCONF server.

An http_router.Router serves the RestconfServer routes in-process, so requests
reach the RESTCONF -> TTT logic without an HTTP transport. The keyed-entry
test shares the fleet-shaped schema and layer with test_netconf_server.
"""

import http
import http_router
import logging
import testing

import yang

import restconf as swrestconf
import test_netconf_server as fixture


actor _test_get_keyed_entry_oper(t: testing.AsyncT):
    """A GET path that continues from a keyed list entry into its config false
    container answers with that entry's state, although the top schema has
    config only."""
    schema = yang.compile([fixture.FLEET_CONFIG_YANG])
    oper_schema = yang.compile([fixture.FLEET_YANG])
    http_root = http_router.Router()
    swrestconf.RestconfServer(http_root, logging.Logger(t.log_handler), schema, oper_schema, fixture.fleet_layer())

    def _put(name: str, on_response: proc(int, dict[str, str], str) -> None):
        body = '<device xmlns="urn:demo-fleet"><name>{name}</name><software><target>2.0</target></software></device>'
        headers = {"content-type": "application/yang-data+xml"}
        http_root.serve(http.Request("PUT", "/restconf/data/demo-fleet:device={name}", b"1.1", headers, body.encode()), on_response)

    def _get():
        http_root.serve(http.Request("GET", "/restconf/data/demo-fleet:device=cpe-17/software/state", b"1.1", {}, b""), _on_get)

    def _on_get(status: int, headers: dict[str, str], body: str):
        # An unresolvable path is a 404 too, but its body is the ValueError
        if status == 404 and body == "No data at path":
            # The entry's oper state is not published yet
            after 0.01: _get()
        elif status != 200:
            t.failure(ValueError("GET returned {status}: {body}"))
        else:
            t.success(body)

    def _on_put_cpe17(status: int, headers: dict[str, str], body: str):
        if status != 201:
            t.failure(ValueError("PUT cpe-17 returned {status}: {body}"))
            return
        _get()

    def _on_put_cpe16(status: int, headers: dict[str, str], body: str):
        if status != 201:
            t.failure(ValueError("PUT cpe-16 returned {status}: {body}"))
            return
        _put("cpe-17", _on_put_cpe17)

    _put("cpe-16", _on_put_cpe16)


actor _test_content_query_bad_request(t: testing.AsyncT):
    """The content query parameter with an unknown value, or on any request
    other than a GET of the datastore or a data resource, is answered with
    400 Bad Request."""
    schema = yang.compile([fixture.FLEET_CONFIG_YANG])
    oper_schema = yang.compile([fixture.FLEET_YANG])
    http_root = http_router.Router()
    swrestconf.RestconfServer(http_root, logging.Logger(t.log_handler), schema, oper_schema, fixture.fleet_layer())

    get_only = "The content query parameter is only allowed for GET of data resources"
    requests = [
        ("GET", "/restconf/data?content=bogus", "Invalid value for the content query parameter: bogus"),
        ("POST", "/restconf/data/demo-fleet:device=cpe-16?content=config", get_only),
        ("PUT", "/restconf/data/demo-fleet:device=cpe-16?content=config", get_only),
        ("PATCH", "/restconf/data/demo-fleet:device=cpe-16?content=config", get_only),
        ("DELETE", "/restconf/data/demo-fleet:device=cpe-16?content=config", get_only),
        ("GET", "/restconf/yang-library-version?content=all", get_only),
    ]
    var current = 0

    def _send():
        method, path, expected = requests[current]
        http_root.serve(http.Request(method, path, b"1.1", {}, b""), _on_response)

    def _on_response(status: int, headers: dict[str, str], body: str):
        method, path, expected = requests[current]
        if status != 400 or body != expected:
            t.failure(ValueError("{method} {path} returned {status}: {body}"))
            return
        current += 1
        if current < len(requests):
            _send()
        else:
            t.success()

    _send()
