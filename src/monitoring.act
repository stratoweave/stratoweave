import std.xml as xml
import hash.wyhash as wyhash

import ietf_yang_library as yl
import yang.gdata as ygdata
import yang.schema as yschema


NS_YANG_LIBRARY = "urn:ietf:params:xml:ns:yang:ietf-yang-library"
NS_NETCONF_MONITORING = "urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring"


def build_yang_library(schema: yschema.DRoot) -> (root: ygdata.Node, content_id: str):
    """Build an ietf-yang-library datastore view (as gdata) plus its content-id.

    It lists the modules of `schema` with the submodules that their
    module_metadata lists: under `module` those that it marks implemented,
    and under `import-only-module` the others.

    `content-id` is a deterministic hash of the assembled `yang-library`
    subtree using a fixed placeholder content-id, so it changes whenever any
    served YANG library content changes. It is returned alongside the tree so
    callers can advertise the matching `yang-library` NETCONF capability.
    """
    implemented_modules = []
    import_only_modules = []
    for ns in sorted(schema.module_metadata.keys()):
        meta = schema.module_metadata[ns]
        rev_opt = meta.revision
        if meta.implemented:
            implemented_modules.append(yl.ietf_yang_library__yang_library__module_set__module_entry(
                name=meta.name,
                namespace=ns,
                revision=rev_opt,
                submodule=[yl.ietf_yang_library__yang_library__module_set__module__submodule_entry(name=sub.name, revision=sub.revision) for sub in meta.submodules],
            ))
        else:
            import_only_modules.append(yl.ietf_yang_library__yang_library__module_set__import_only_module_entry(
                name=meta.name,
                revision=rev_opt if rev_opt is not None else "",
                namespace=ns,
                submodule=[yl.ietf_yang_library__yang_library__module_set__import_only_module__submodule_entry(name=sub.name, revision=sub.revision) for sub in meta.submodules],
            ))

    yang_library = yl.ietf_yang_library__yang_library(
        content_id="__content_id_placeholder__",
        module_set=[yl.ietf_yang_library__yang_library__module_set_entry(name="default", module=implemented_modules, import_only_module=import_only_modules)],
        schema=[yl.ietf_yang_library__yang_library__schema_entry(name="default", module_set=["default"])],
        datastore=[yl.ietf_yang_library__yang_library__datastore_entry(name=yl.ietf_datastores_running, schema="default")],
    )
    root = yl.root(yang_library=yang_library)
    content_id = str(wyhash.hash(0, root.to_gdata().prsrc(deterministic=True).encode()))
    yang_library.content_id = content_id
    return (root=root.to_gdata(), content_id=content_id)


def build_yl_view(schema: yschema.DRoot) -> ?(root: ygdata.Node, content_id: str):
    """The ietf-yang-library view to serve (gdata tree + content-id), or None when
    the inventory doesn't implement ietf-yang-library. Recompute whenever the served
    schema changes so the library and its content-id track the current module set."""
    if NS_YANG_LIBRARY in schema.module_metadata:
        return build_yang_library(schema)
    return None


class ModuleInventory(object):
    """The compiled schema that a server serves and its YANG library, see
    build_yang_library."""
    schema: yschema.DRoot
    yl_view: (root: ygdata.Node, content_id: str)

    def __init__(self, schema: yschema.DRoot):
        self.schema = schema
        self.yl_view = build_yang_library(schema)


def bundled_module_caps(module_metadata: dict[str, yschema.ModuleMetadata]) -> list[str]:
    """One `<namespace>?module=<name>&revision=<rev>` capability per module."""
    caps = []
    for ns, meta in module_metadata.items():
        cap = ns + "?module=" + meta.name
        rev = meta.revision
        if rev is not None:
            cap = cap + "&revision=" + rev
        caps.append(cap)
    return caps


def module_capabilities(schema: yschema.DRoot,
                        yl_view: ?(root: ygdata.Node, content_id: str)) -> list[str]:
    """The module-inventory capabilities for a <hello>: a single yang-library:1.1
    capability carrying the content-id when the inventory implements
    ietf-yang-library, else one ?module= capability per module."""
    if yl_view is not None:
        yl_rev = yl.SRC_DNODE.module_metadata[NS_YANG_LIBRARY].revision
        return ["urn:ietf:params:netconf:capability:yang-library:1.1?{"revision={yl_rev}&" if yl_rev is not None else ""}content-id={yl_view.content_id}"]
    return bundled_module_caps(schema.module_metadata)


def get_schema_identifier(op: xml.Node) -> ?str:
    """The <identifier> (module name) of a <get-schema> request, or None."""
    for c in op.children:
        if c.tag == "identifier":
            return c.text
    return None


def get_schema_reply(op: xml.Node, sources: dict[str, str]) -> ?xml.Node:
    """The <data> reply node for a <get-schema> (RFC 6022, ietf-netconf-monitoring),
    given a module-name -> YANG source map, or None when the requested module is
    unknown (the caller then sends an rpc-error). get-schema is otherwise unserved in
    this codebase, so this lets any mock/server answer it from a source corpus."""
    ident = get_schema_identifier(op)
    if ident is not None:
        src = sources.get(ident)
        if src is not None:
            return xml.Node("data", nsdefs=[(None, NS_NETCONF_MONITORING)], text=src)
    return None
