import std.xml as xml
import std.hash.wyhash as wyhash

import ietf_yang_library as yl
import yang.gdata as ygdata
import yang.schema as yschema


NS_YANG_LIBRARY = "urn:ietf:params:xml:ns:yang:ietf-yang-library"
NS_NETCONF_MONITORING = "urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring"


def build_yang_library(schema: yschema.DRoot, modules: dict[str, yschema.ModuleMetadata]={}, implemented: dict[str, list[str]]={}) -> (root: ygdata.Node, content_id: str):
    """Build an ietf-yang-library datastore view (as gdata) plus its content-id.

    It lists the modules of `schema` and `modules`, with the submodules that
    their module_metadata lists, in /yang-library (RFC 8525) and in
    /modules-state (RFC 7895), which RESTCONF (RFC 8040) requires. Those
    marked implemented are listed under `module`, with conformance-type
    `implement`, and the others under `import-only-module`, with
    conformance-type `import`.

    `modules` is the module_metadata of the modules that the server
    implements in its own code, and of the modules they import. `implemented` names the ones that it implements,
    with the features it supports. Whether `modules` marks a module
    implemented is not used: compiled with them, a module that they only
    import, such as ietf-interfaces, is marked implemented. Where `schema`
    holds a module with the same namespace, its module_metadata is listed.

    `content-id` is a deterministic hash of the assembled tree, with
    placeholders for content-id and module-set-id, so it changes whenever any
    served YANG library content changes. /modules-state carries it as its
    module-set-id. It is returned alongside the tree so callers can advertise
    the matching `yang-library` NETCONF capability.
    """
    merged_meta = {}
    for ns, meta in modules.items():
        merged_meta[ns] = (name=meta.name, revision=meta.revision, submodules=meta.submodules, implemented=meta.name in implemented)
    names = set([meta.name for meta in modules.values()])
    for name in implemented.keys():
        if name not in names:
            raise ValueError("No module_metadata for implemented module {name}")
    for ns, meta in schema.module_metadata.items():
        merged_meta[ns] = meta

    implemented_modules = []
    import_only_modules = []
    modules_state_modules = []
    for ns in sorted(merged_meta.keys()):
        meta = merged_meta[ns]
        rev_opt = meta.revision
        modules_state_submodules = []
        for sub in meta.submodules:
            sub_rev = sub.revision
            modules_state_submodules.append(yl.ietf_yang_library__modules_state__module__submodule_entry(name=sub.name, revision=sub_rev if sub_rev is not None else ""))
        modules_state_modules.append(yl.ietf_yang_library__modules_state__module_entry(
            name=meta.name,
            revision=rev_opt if rev_opt is not None else "",
            namespace=ns,
            conformance_type="implement" if meta.implemented else "import",
            feature=implemented.get_def(meta.name, []),
            submodule=modules_state_submodules,
        ))
        if meta.implemented:
            implemented_modules.append(yl.ietf_yang_library__yang_library__module_set__module_entry(
                name=meta.name,
                namespace=ns,
                revision=rev_opt,
                submodule=[yl.ietf_yang_library__yang_library__module_set__module__submodule_entry(name=sub.name, revision=sub.revision) for sub in meta.submodules],
                feature=implemented.get_def(meta.name, []),
            ))
        else:
            import_only_modules.append(yl.ietf_yang_library__yang_library__module_set__import_only_module_entry(
                name=meta.name,
                revision=rev_opt if rev_opt is not None else "",
                namespace=ns,
                submodule=[yl.ietf_yang_library__yang_library__module_set__import_only_module__submodule_entry(name=sub.name, revision=sub.revision) for sub in meta.submodules],
            ))

    yang_library = yl.ietf_yang_library__yang_library(
        content_id="__content_id_placeholder__",
        module_set=[yl.ietf_yang_library__yang_library__module_set_entry(name="default", module=implemented_modules, import_only_module=import_only_modules)],
        schema=[yl.ietf_yang_library__yang_library__schema_entry(name="default", module_set=["default"])],
        datastore=[yl.ietf_yang_library__yang_library__datastore_entry(name=yl.ietf_datastores_running, schema="default")],
    )
    modules_state = yl.ietf_yang_library__modules_state(
        module_set_id="__module_set_id_placeholder__",
        module=modules_state_modules,
    )
    root = yl.root(yang_library=yang_library, modules_state=modules_state)
    content_id = str(wyhash.hash(0, root.to_gdata().prsrc(deterministic=True).encode()))
    yang_library.content_id = content_id
    modules_state.module_set_id = content_id
    return (root=root.to_gdata(), content_id=content_id)


pure def build_yl_view(schema: yschema.DRoot) -> ?(root: ygdata.Node, content_id: str):
    """The ietf-yang-library view to serve (gdata tree + content-id), or None when
    the inventory doesn't implement ietf-yang-library. Recompute whenever the served
    schema changes so the library and its content-id track the current module set."""
    if NS_YANG_LIBRARY in schema.module_metadata:
        return build_yang_library(schema)
    return None


class ModuleInventory(object):
    """The compiled schema that a server serves, the modules that it
    implements in its own code, and its YANG library, see
    build_yang_library. `sources` holds `yang_sources`, the YANG sources that
    the server serves, see get_schema_sources."""
    schema: yschema.DRoot
    yl_view: (root: ygdata.Node, content_id: str)
    sources: dict[str, dict[str, str]]

    def __init__(self, schema: yschema.DRoot, modules: dict[str, yschema.ModuleMetadata]={}, implemented: dict[str, list[str]]={}, yang_sources: list[yschema.YangSource]=[]):
        self.schema = schema
        self.yl_view = build_yang_library(schema, modules, implemented)
        self.sources = get_schema_sources(yang_sources)


def bundled_module_caps(module_metadata: dict[str, yschema.ModuleMetadata]) -> list[str]:
    """One `<namespace>?module=<name>&revision=<rev>` capability per module."""
    caps = []
    for ns, meta in module_metadata.items():
        cap = ns + "?module=" + meta.name
        rev = meta.revision
        if rev is not None:
            cap = cap + "&revision=" + rev
        caps.append(cap)
    return caps


pure def module_capabilities(schema: yschema.DRoot,
                        yl_view: ?(root: ygdata.Node, content_id: str)) -> list[str]:
    """The module-inventory capabilities for a <hello>: a single yang-library:1.1
    capability carrying the content-id when the inventory implements
    ietf-yang-library, else one ?module= capability per module."""
    if yl_view is not None:
        yl_rev = yl.SRC_DNODE.module_metadata[NS_YANG_LIBRARY].revision
        return ["urn:ietf:params:netconf:capability:yang-library:1.1?{"revision={yl_rev}&" if yl_rev is not None else ""}content-id={yl_view.content_id}"]
    return bundled_module_caps(schema.module_metadata)


class GetSchemaError(Exception):
    """A <get-schema> that get_schema_reply does not answer, with the
    error-tag and error-app-tag of its rpc-error"""
    error_tag: str
    error_app_tag: ?str

    def __init__(self, error_tag: str, error_message: str, error_app_tag: ?str=None):
        self.error_tag = error_tag
        self.error_message = error_message
        self.error_app_tag = error_app_tag


def get_schema_sources(yang_sources: list[yschema.YangSource]) -> dict[str, dict[str, str]]:
    """The sources of `yang_sources` by identifier and version, for
    get_schema_reply. The identifier of a source is the name of its module or
    submodule, and its version is its revision, or empty when it has no
    revision statement, as in /netconf-state/schemas (RFC 6022). A name and
    revision that repeats in `yang_sources`, such as that of ietf-yang-types,
    which several schemas import, is held once."""
    res = {}
    for s in yang_sources:
        rev = s.revision
        if s.name not in res:
            res[s.name] = {}
        res[s.name][rev if rev is not None else ""] = s.src
    return res


def get_schema_reply(op: xml.Node, sources: dict[str, dict[str, str]]) -> xml.Node:
    """The <data> reply to a <get-schema> (RFC 6022, ietf-netconf-monitoring),
    carrying the source of the requested identifier and version, see
    get_schema_sources.

    A request without version matches every version of the identifier.
    Raises GetSchemaError with error-tag invalid-value when no source
    matches, and operation-failed with error-app-tag data-not-unique when
    more than one does. The <format> is not looked at."""
    ident: ?str = None
    version: ?str = None
    for c in op.children:
        if c.tag == "identifier":
            ident = c.text
        elif c.tag == "version":
            # <version/> requests the empty version
            text = c.text
            version = text if text is not None else ""
    if ident is not None:
        versions = sources.get_def(ident, {})
        requested = ident
        matches = list(versions.values())
        if version is not None:
            requested = ident + "@" + version
            matches = [versions[version]] if version in versions else []
        if len(matches) == 0:
            raise GetSchemaError("invalid-value", "No schema {requested}")
        if len(matches) > 1:
            raise GetSchemaError("operation-failed", "More than one schema {requested}, request a version", error_app_tag="data-not-unique")
        return xml.Node("data", nsdefs=[(None, NS_NETCONF_MONITORING)], text=matches[0])
    raise GetSchemaError("missing-element", "Missing <identifier> in <get-schema>")
