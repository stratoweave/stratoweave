"""The platform probes that come with StratoWeave.

SysSpec.platform_probes is PROBES unless the app gives its own list. An app
sets its list in its device_types.act, next to its device types. To add a
probe, or to replace one of these for some devices, put it first:

    platform_probes = [my_probe] + swplat.PROBES

DeviceMgr runs the first probe in the list that applies, so a probe earlier
in the list wins over a later one. The IOS XE probe over NETCONF comes before
the one over the CLI: a device with both adapters gets the NETCONF values.
The other probes apply to different modules, so their order does not matter.
"""

import device as swdev
import adapters.platform_arcos as platform_arcos
import adapters.platform_arcos_yang as arcos_yang
import adapters.platform_iosxe as platform_iosxe
import adapters.platform_iosxe_cli as platform_iosxe_cli
import adapters.platform_iosxr as platform_iosxr
import adapters.platform_iosxr_yang as xr_yang
import adapters.platform_junos as platform_junos
import adapters.platform_srlinux as platform_srlinux
import adapters.platform_srlinux_yang as srl_yang
import adapters.platform_sros as platform_sros
import adapters.platform_sros_yang as sros_yang
import adapters.software_iosxe_yang as xe_yang

PROBES: list[swdev.PlatformProbe] = [
    platform_iosxe.PROBE,
    platform_iosxe_cli.PROBE,
    platform_iosxr.PROBE,
    platform_junos.PROBE,
    platform_srlinux.PROBE,
    platform_sros.PROBE,
    platform_arcos.PROBE,
]

## The YANG that the probes in PROBES read, for a device type that does not
## know which OS its devices run, like the one of ncurl platform. A device type
## for one OS adds only the models of that OS's probe. The IOS XE CLI probe
## reads the module of the CLI adapter, which the adapter has itself.
MODELS: list[str] = (xe_yang.models + xr_yang.models + srl_yang.models
                     + sros_yang.models + arcos_yang.models)
