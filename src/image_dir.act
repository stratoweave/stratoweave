"""The folder of software image files, set with the software.image_dir
setting. Only listing for now."""

import file


def _scan(fs: file.FS, path: str) -> (files: list[(name: str, size: int, modified: float)], error: ?str):
    """The regular files directly in path, by name. Hidden files and
    subfolders are skipped; a folder that cannot be read gives an error."""
    names: list[str] = []
    try:
        names = sorted(fs.listdir(path))
    except OSError as e:
        return (files=[], error="Cannot read image folder {path}: {e}")
    files = []
    for name in names:
        if name.startswith("."):
            continue
        try:
            st = fs.stat(file.join_path([path, name]))
            if st.is_file():
                files.append((name=name, size=int(st.size), modified=st.mtime))
        except OSError:
            # Removed since the listing.
            pass
    return (files=files, error=None)


actor ImageDir(cap: file.FileCap, path: str):
    """Software image files in one folder."""
    _fs = file.FS(cap)

    def list() -> (files: list[(name: str, size: int, modified: float)], error: ?str):
        """The image files by name, or an error when the folder cannot be read."""
        return _scan(_fs, path)
