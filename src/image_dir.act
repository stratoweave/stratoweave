"""The folder of software image files, set with the software.image_dir
setting. A file is first written as .{name}.part, which the listing skips,
and gets its name once all of it is written."""

import file


MAX_NAME = 200

_NAME_CHARS = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")


def _valid_name(name: str) -> bool:
    if name == "" or len(name) > MAX_NAME or name.startswith("."):
        return False
    for c in name:
        if c not in _NAME_CHARS:
            return False
    return True


def check_name(name: str):
    """Raise ValueError unless name can name an image file."""
    if not _valid_name(name):
        raise ValueError("Invalid image file name '{name}': use letters, digits, '.', '_' and '-', at most {MAX_NAME} characters, not starting with '.'")


actor ImageDir(cap: file.FileCap, path: str):
    """Software image files in one folder. Changes go through this actor one
    at a time."""
    _fs = file.FS(cap)
    _wcap = file.WriteFileCap(cap)

    def _file(name: str) -> str:
        return file.join_path([path, name])

    def list() -> list[(name: str, size: int, modified: float)]:
        """The regular files directly in the folder, by name. Hidden files and
        subfolders are skipped. Raises OSError when the folder cannot be read."""
        names: list[str] = []
        try:
            names = sorted(_fs.listdir(path))
        except OSError as e:
            raise OSError("Cannot read image folder {path}: {e}")
        files = []
        for name in names:
            if name.startswith("."):
                continue
            try:
                st = _fs.stat(_file(name))
                if st.is_file():
                    files.append((name=name, size=int(st.size), modified=st.mtime))
            except FileNotFoundError:
                # Removed since the listing.
                pass
        return files

    def save(name: str, data: bytes) -> (size: int, modified: float):
        """Write data as the file name, replacing a file of that name."""
        check_name(name)
        part = file.join_path([path, "." + name + ".part"])
        f = file.WriteFile(_wcap, part)
        try:
            await async f.write(data)
        finally:
            await async f.close()
        target = _file(name)
        await async _fs.rename(part, target)
        st = _fs.stat(target)
        return (size=int(st.size), modified=st.mtime)

    def remove(name: str) -> None:
        """Remove the file name. Raises FileNotFoundError when there is none."""
        check_name(name)
        target = _file(name)
        # stat, unlike remove, raises FileNotFoundError without a log line.
        await async _fs.stat(target)
        await async _fs.remove(target)
