"""The /image-file HTTP routes: list the image folder, upload a file in one
request and remove it. image_dir does the work."""

import http_router
import json
import logging

import image_dir as swimg


def _reply(respond: proc(int, dict[str, str], str) -> None, status: int, body: dict[str, ?value]):
    respond(status, {"Content-Type": "application/json"}, json.encode(body))


actor ImageFileApi(images: swimg.ImageDir, log: logging.Logger):
    """Answers the requests that install() forwards."""

    def _refused(respond: proc(int, dict[str, str], str) -> None, name: str, e: Exception):
        if isinstance(e, FileNotFoundError):
            _reply(respond, 404, {"error": "No image file named {name}"})
        elif isinstance(e, ValueError):
            _reply(respond, 400, {"error": e.error_message})
        else:
            log.error("Image file request failed", {"name": name, "error": str(e)})
            _reply(respond, 500, {"error": str(e)})

    def list_files(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        try:
            files = [{"name": f.name, "size": f.size, "modified": f.modified} for f in images.list()]
            _reply(respond, 200, {"files": files})
        except Exception as e:
            _refused(respond, "", e)

    def put_file(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        name = ctx.param("name")
        try:
            data = ctx.request.body
            if len(data) == 0:
                raise ValueError("The request has no body: send the file as the body")
            saved = images.save(name, data)
            _reply(respond, 200, {"name": name, "size": saved.size, "modified": saved.modified})
        except Exception as e:
            _refused(respond, name, e)

    def remove(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        name = ctx.param("name")
        try:
            await async images.remove(name)
            respond(204, {}, "")
        except Exception as e:
            _refused(respond, name, e)


def install(router: http_router.Router, api: ImageFileApi):
    """Add the /image-file routes to router.

    The handlers only send each request on to api. A method of api given to
    the router directly would run in the HTTP server's turn, and the server
    would wait for every folder call.
    """
    def list_files(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.list_files(ctx, respond)

    def put_file(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.put_file(ctx, respond)

    def remove(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.remove(ctx, respond)

    router.get("/image-file", list_files)
    router.put("/image-file/{{name}}", put_file)
    router.delete("/image-file/{{name}}", remove)
