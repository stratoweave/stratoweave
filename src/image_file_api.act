"""The image folder HTTP routes: list its files and folders, upload a file in
one request, remove a file, make and remove a folder, and move or rename
either. Paths name what is inside the folder, such as
/image-file/iosxe/17.18/c8000v-universalk9.17.18.03a.SPA.bin. image_dir does
the work."""

import http_router
import json
import logging

import image_dir as swimg


def _reply(respond: proc(int, dict[str, str], str) -> None, status: int, body: dict[str, ?value]):
    respond(status, {"Content-Type": "application/json"}, json.encode(body))


actor ImageFileApi(images: swimg.ImageDir, log: logging.Logger):
    """Answers the requests that install() forwards."""

    def _refused(respond: proc(int, dict[str, str], str) -> None, what: str, name: str, e: Exception):
        """Answer the error e of a request about name. what is the kind of
        thing name is, for the 404 text: "image file", "image folder" or
        "file or folder"."""
        if isinstance(e, FileNotFoundError):
            _reply(respond, 404, {"error": "No {what} named {name}"})
        elif isinstance(e, swimg.Conflict):
            _reply(respond, 409, {"error": e.error_message})
        elif isinstance(e, ValueError):
            _reply(respond, 400, {"error": e.error_message})
        else:
            log.error("Image file request failed", {"name": name, "error": str(e)})
            _reply(respond, 500, {"error": str(e)})

    def list_files(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        try:
            listing = images.list()
            files = [{"name": f.name, "size": f.size, "modified": f.modified} for f in listing.files]
            folders = [{"name": name} for name in listing.folders]
            _reply(respond, 200, {"files": files, "folders": folders})
        except Exception as e:
            _refused(respond, "image folder", "", e)

    def put_file(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        name = ctx.param("name")
        try:
            data = ctx.request.body
            if len(data) == 0:
                raise ValueError("The request has no body: send the file as the body")
            saved = images.save(name, data)
            _reply(respond, 200, {"name": name, "size": saved.size, "modified": saved.modified})
        except Exception as e:
            _refused(respond, "image file", name, e)

    def remove_file(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        name = ctx.param("name")
        try:
            await async images.remove(name)
            respond(204, {}, "")
        except Exception as e:
            _refused(respond, "image file", name, e)

    def put_folder(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        name = ctx.param("name")
        try:
            made = images.make_folder(name)
            _reply(respond, 201 if made else 200, {"name": name})
        except Exception as e:
            _refused(respond, "image folder", name, e)

    def remove_folder(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        name = ctx.param("name")
        try:
            await async images.remove_folder(name)
            respond(204, {}, "")
        except Exception as e:
            _refused(respond, "image folder", name, e)

    def move(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        body: dict[str, ?value] = {}
        try:
            body = json.decode(ctx.request.body.decode())
        except Exception:
            pass
        src = body.get("from")
        dst = body.get("to")
        if isinstance(src, str) and isinstance(dst, str):
            try:
                kind = images.move(src, dst)
                _reply(respond, 200, {"from": src, "to": dst, "kind": kind})
            except Exception as e:
                _refused(respond, "file or folder", src, e)
        else:
            _reply(respond, 400, {"error": 'Send the move as JSON: {{"from": "<path>", "to": "<path>"}}'})


def install(router: http_router.Router, api: ImageFileApi):
    """Add the image folder routes to router: /image-file, /image-folder and
    /image-move.

    The handlers only send each request on to api. A method of api given to
    the router directly would run in the HTTP server's turn, and the server
    would wait for every folder call.
    """
    def list_files(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.list_files(ctx, respond)

    def put_file(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.put_file(ctx, respond)

    def remove_file(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.remove_file(ctx, respond)

    def put_folder(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.put_folder(ctx, respond)

    def remove_folder(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.remove_folder(ctx, respond)

    def move(ctx: http_router.Context, respond: proc(int, dict[str, str], str) -> None):
        api.move(ctx, respond)

    # No GET on the wildcards: the router ranks /image-file/*name above
    # /image-file, so it would take the listing.
    router.get("/image-file", list_files)
    router.put("/image-file/*name", put_file)
    router.delete("/image-file/*name", remove_file)
    router.put("/image-folder/*name", put_folder)
    router.delete("/image-folder/*name", remove_folder)
    router.post("/image-move", move)
