# RFC 6470: the module whose presence says a device emits base notifications
# such as netconf-config-change.
MODULE_NETCONF_NOTIFICATIONS = "ietf-netconf-notifications"
CONFIG_CHANGE_NOTIF = ygdata.Id(
    "urn:ietf:params:xml:ns:yang:ietf-netconf-notifications",
    "netconf-config-change")

#############################################################################
# Software management
#
# SoftwareManager owns the upgrade sequence for one device; the platform work
# lives in SoftwareAdapter. Implementers fill in adapters, not sequencing.
#############################################################################

class SoftwareAdapter(object):
    """Platform-specific software installation.

    Software is treated as **monolithic**: a release is a single version name,
    like an IOS XE "17.18.03a", and what the device reports is the same kind of
    name. Platforms that decompose software into separately versioned
    components are out of scope.

    Jobs are idempotent and asynchronous, reporting through a `done` callback in
    the same style as DeviceAdapter. Idempotence is what makes the split safe:
    `prepare` may run two weeks before `install`, and `install` re-runs the
    staging steps anyway, so a deleted image or a full disk self-heals rather
    than failing the upgrade.

    A job's error message is published as the run's reason, so it should name
    the platform operation and the platform's cause, like
    "add failed: install-verify-pkg-fail".
    """
    _log_handler: logging.Handler

    def supports_mocking(self) -> bool:
        return False

    @staticmethod
    def plan_estimate() -> int:
        """What a full upgrade takes, in seconds, before anything has
        been observed.

        The adapter is the best source for an estimate: planners start
        from this figure and controllers correct it from observation.
        """
        raise NotImplementedError("the adapter must estimate its upgrade duration")

    ## Read the release the device is currently running.
    check: proc(done: action(?str, ?Exception) -> None) -> None

    def matches_release(self, running: ?str, target: str) -> bool:
        """Whether what the device reports running is the release intended.

        A method on the adapter rather than `==` in the manager, because how a
        device spells a release is the platform's business: IOS XE reports
        17.18.3a for an image called 17.18.03a, so a string comparison there
        calls a finished upgrade unfinished.

        `running` is None when the device did not say. That is not a match: the
        manager then does the work rather than assume none is needed.
        """
        return running is not None and running! == target

    ## Stage the release: upload the image, verify the checksum. Non-impacting,
    ## so it can run well ahead of the maintenance window, but only when
    ## allow-staging permits it, since image transfers across a whole fleet are
    ## bandwidth bound.
    prepare: proc(done: action(?Exception) -> None, release: str) -> None

    ## Activate and reboot: the impacting step, and the only one that must
    ## happen inside a maintenance window. Re-runs the prepare steps first.
    ## Call `done(None)` only after the device is reachable again and the
    ## requested release is running.
    install: proc(done: action(?Exception) -> None, release: str) -> None

    ## Return the device to the release it was running before install.
    ##
    ## Where the platform has native rollback, use it. Where it does not, this
    ## degrades to installing `previous` again, which is why cleanup is
    ## sequenced last: until the post-checks pass, the old image must still be
    ## on the box.
    rollback: proc(done: action(?Exception) -> None, previous: ?str) -> None

    ## Confirm the release install activated, so the platform keeps it. On
    ## IOS XE this stops the auto-abort timer. Runs after all post-checks pass.
    commit: proc(done: action(?Exception) -> None) -> None

    ## Report the seconds left before the platform reverts the activated
    ## release on its own, counted from activation. None when the platform has
    ## no such timer.
    commit_window: proc(done: action(?int) -> None) -> None

    ## Remove superseded images once the new software is confirmed good.
    ## Reclaims the space the next upgrade needs.
    cleanup: proc(done: action(?Exception) -> None) -> None

    ## Estimated wall-clock seconds for install, with and without staging
    ## already done.
    estimate: proc(staged: bool) -> int


class NoSoftwareAdapter(SoftwareAdapter):
    """Null object for device types with no software support.

    Every device gets a SoftwareManager, but not every platform can install
    software. A do-nothing adapter rather than an optional one keeps the manager
    free of `if adapter is not None` at every step; the jobs simply report that
    the platform cannot do this.
    """
    def __init__(self, log_handler: logging.Handler):
        self._log_handler = log_handler

    def _unsupported(self) -> Exception:
        return ValueError("device type has no software adapter")

    def check(self, done: action(?str, ?Exception) -> None) -> None:
        done(None, self._unsupported())

    def prepare(self, done: action(?Exception) -> None, release: str) -> None:
        done(self._unsupported())

    def install(self, done: action(?Exception) -> None, release: str) -> None:
        done(self._unsupported())

    def rollback(self, done: action(?Exception) -> None, previous: ?str) -> None:
        done(self._unsupported())

    def commit(self, done: action(?Exception) -> None) -> None:
        done(self._unsupported())

    def commit_window(self, done: action(?int) -> None) -> None:
        done(None)

    def cleanup(self, done: action(?Exception) -> None) -> None:
        done(self._unsupported())

    def estimate(self, staged: bool) -> int:
        return 0


ST_UNKNOWN = "unknown"
ST_UP_TO_DATE = "up-to-date"
ST_UPGRADE_NEEDED = "upgrade-needed"
ST_IN_PROGRESS = "in-progress"
ST_SUCCEEDED = "succeeded"
ST_FAILED = "failed"
ST_ROLLED_BACK = "rolled-back"

# The statuses that end a read or a run: one that answers the intent is kept
# until the intent changes.
ST_FINAL = {ST_UP_TO_DATE, ST_SUCCEEDED, ST_FAILED, ST_ROLLED_BACK}

# check-result/verdict
VERDICT_NOT_RUN = "not-run"
VERDICT_PASS = "pass"
VERDICT_FAIL = "fail"

# state/job: the one job the manager reports, and its states.
JOB_PREPARE = "prepare"
JOB_RUNNING = "running"
JOB_DONE = "done"
JOB_FAILED = "failed"

# state/stage. The check rounds use their kind, "precheck" or "postcheck".
STAGE_PREPARE = "prepare"
STAGE_INSTALL = "install"
STAGE_COMMIT = "commit"
STAGE_ROLLBACK = "rollback"

# Pre-checks must answer within this. They judge what the device runs now, so
# there is nothing to wait for but the registrants.
PRECHECK_TIMEOUT = 60.0
# Post-checks must answer within this. The commit also has to land before the
# platform's own abort timer fires, so the deadline is cut to what the adapter
# says is left, minus room for the commit itself.
POSTCHECK_TIMEOUT = 900.0
COMMIT_MARGIN = 120.0

# Seconds before the first retry of a failed platform read. Each retry waits
# twice as long as the one before, up to PLATFORM_RETRY_MAX.
PLATFORM_RETRY_FIRST = 5.0
PLATFORM_RETRY_MAX = 300.0


def _now() -> str:
    """The current UTC time as a yang:date-and-time."""
    d = time.utcnow()
    return f"{d.year:04d}-{d.month:02d}-{d.day:02d}T{d.hour:02d}:{d.minute:02d}:{d.second:02d}Z"


def error_text(err: Exception) -> str:
    """An error as one line for a published reason, without the class name
    str() puts first. An error without a message gives its class name."""
    lines = [l.strip() for l in err.error_message.splitlines()]
    text = " ".join([l for l in lines if l != ""])
    return text if text != "" else str(err).rstrip(": ")


actor SoftwareManager(name: str, log_handler: logging.Handler, devmgr: DeviceMgr):
    """Per-device software manager, one per DeviceMgr.

    Really one half of the DeviceMgr, split out only to keep the code
    readable, so tight coupling is fine: status changes are pushed straight
    to devmgr.on_software_state.

    Implemented so far: check, prepare, pre-checks, install, post-checks,
    commit or rollback, then a check to read the release back, and a resync;
    and a prepare under a veto. Cleanup is still a stub.

    Declarative like the rest of StratoWeave: the manager is told a target
    release and reconciles toward it, rather than being handed a command to
    execute. The contract it must grow into:

        check --> differs? --> prepare --> pre-checks --> install --> post-checks
                                              |                           |
                                     any fail |                  all pass | any fail
                                              v                           v         v
                                        status=failed          commit, cleanup   rollback
                                      device untouched

    * A veto from any holder holds the install, and only the install: the
      manager still reads the release the device runs and reports up-to-date
      or upgrade-needed. The vetoes are read again right before the install
      starts; they never abort one in flight.
    * Each status answers an intent: the upgrade campaign and target release
      of the read or run that set it, published with the status. A final
      status that answers the intent is kept while the intent and the device
      type stay the same, so a reconnect or an unrelated config change does
      not run a failed upgrade again. The install installs the release the
      run read the device for.
    * Under a hold, a read that fails says the release is unknown and is
      tried again when the device connects, or after a while. Without one
      the run goes on, as a failed read is no proof of being up to date.
    * A prepare is never a precondition; a run prepares again. Under a veto,
      `allow_staging` lets the manager prepare the target once per intent,
      ahead of the install. The result goes in job[prepare], never in the
      status: a failed prepare leaves the status upgrade-needed.
    * Every pre-check must pass for install to proceed. A failing pre-check,
      or one that does not answer within PRECHECK_TIMEOUT, ends the run failed
      with nothing activated, which is the whole point of the gate.
    * Any failing post-check triggers a rollback. So does a post-check that
      does not answer within POSTCHECK_TIMEOUT.
    * **Cleanup is the point of no return**: it removes the superseded image,
      which on platforms without native rollback is the way home, so it must
      not run until the post-checks have passed.
    * A failed install does not roll back. A failed activation usually leaves
      the device on the old image, and install is idempotent, so re-running
      beats a rollback that may be a no-op.

    Check callbacks are additive: several RFS transforms will each register
    their own, so registration is keyed by name and independently removable,
    the same shape as vetoes. A check is handed a `done` action to call when it
    has decided, so it may go away and do work first without blocking anything.

    The implementation has to tolerate a late reply: a check that answers after
    the attempt it belonged to was abandoned must be ignored rather than allowed
    to gate a later one.
    """

    _log = logging.Logger(log_handler)

    var adapter: SoftwareAdapter = NoSoftwareAdapter(log_handler)
    var target_release: ?str = None
    var upgrade_campaign: ?str = None
    var allow_staging: bool = False
    var vetoes: dict[str, str] = {}

    # Set from the moment a reconcile starts reading the device until the
    # sequence it started has finished, so repeated config does not stack
    # sequences on top of each other. Wider than `status == in-progress`,
    # because the comparison happens before there is any work to report.
    var busy: bool = False
    # The intent the read or run under way answers.
    var run_campaign: ?str = None
    var run_target: ?str = None
    # Set when the intent or the connection changed while busy: the end of
    # the work reconciles once.
    var again: bool = False
    # A failed read under a veto is tried again after read_retry seconds,
    # twice as long each time up to PLATFORM_RETRY_MAX. read_gen drops a
    # retry that a later read made stale.
    var read_retry_first: float = PLATFORM_RETRY_FIRST
    var read_retry: float = PLATFORM_RETRY_FIRST
    var read_gen: int = 0
    # Set when the state changed without a status change and is not out yet.
    var unpublished: bool = False

    var prechecks: dict[str, action(action(bool, str) -> None) -> None] = {}
    var postchecks: dict[str, action(action(bool, str) -> None) -> None] = {}
    # The round of checks under way, "precheck" or "postcheck", or "" between
    # rounds.
    var checking: str = ""
    # Registrants that have not answered yet in the current round.
    var pending: dict[str, bool] = {}
    var passed: dict[str, str] = {}
    # Bumped at every decision, so a late check reply or timer from an earlier
    # step is ignored.
    var attempt: int = 0
    # What the device ran before install; rollback returns to it.
    var previous_release: ?str = None
    var precheck_timeout: float = PRECHECK_TIMEOUT
    var postcheck_timeout: float = POSTCHECK_TIMEOUT

    # The device/software/state oper tree this manager owns. Every change is
    # pushed to the DeviceMgr, which fuses it into the device entry's oper.
    var state: SoftwareState = SoftwareState(
        status=ST_UNKNOWN,
        precheck=PrecheckResult(VERDICT_NOT_RUN, None, None),
        postcheck=PostcheckResult(VERDICT_NOT_RUN, None, None))

    #### configuration ######################################################

    def set_adapter(a: SoftwareAdapter) -> None:
        """Called by DeviceMgr when the device type is known or changes. A new
        adapter has answered nothing yet, so the status answers no intent."""
        adapter = a
        _set_answers(None, None)
        _reconcile()

    def set_config(campaign: ?str, target: ?str, staging: bool, veto: dict[str, str]) -> None:
        """Software config from DeviceMetaConfig.software: the campaign whose
        intent this is, the target release name, whether staging may run ahead
        of the window, and the current vetoes keyed by holder. Acts only when
        one of them changed."""
        if campaign == upgrade_campaign and target == target_release \
           and staging == allow_staging and veto == vetoes:
            return
        upgrade_campaign = campaign
        target_release = target
        allow_staging = staging
        vetoes = veto
        _reconcile()

    def on_connect() -> None:
        """Called by DeviceMgr when the device's primary adapter connects: a
        read under a veto that could not reach the device runs again."""
        _reconcile()

    #### check registration #################################################

    def add_precheck(registrant: str, cb: action(action(bool, str) -> None) -> None) -> None:
        """Register a gate evaluated before install.

        The manager calls `cb` with a `done` action; the registrant calls
        `done(proceed, reason)` once it has made up its mind, so a check is free
        to go away and do work first:

            def precheck(done: action(bool, str) -> None) -> None:
                if peer_is_up:
                    done(True, "")
                else:
                    done(False, "redundant peer is down")

            swmgr.add_precheck("rfs-l3vpn", precheck)

        Additive: every registrant keeps its own entry and all of them must
        proceed for the install to start. One that does not answer within
        PRECHECK_TIMEOUT counts as refusing. A check added during a run counts
        from the next run.
        """
        prechecks[registrant] = cb

    def remove_precheck(registrant: str) -> None:
        if registrant in prechecks:
            del prechecks[registrant]
        _drop_pending("precheck", registrant)

    def add_postcheck(registrant: str, cb: action(action(bool, str) -> None) -> None) -> None:
        """Register a check evaluated after install, same shape as a pre-check.
        All must pass before commit. Any registrant reporting False, or not
        answering within POSTCHECK_TIMEOUT, triggers a rollback. A check added
        during a run counts from the next run."""
        postchecks[registrant] = cb

    def remove_postcheck(registrant: str) -> None:
        if registrant in postchecks:
            del postchecks[registrant]
        _drop_pending("postcheck", registrant)

    def _drop_pending(kind: str, registrant: str) -> None:
        """A registrant removed during its round no longer holds it up."""
        if checking == kind and registrant in pending:
            del pending[registrant]
            if len(pending) == 0:
                _checks_passed()

    def set_precheck_timeout(secs: float) -> None:
        """Test hook."""
        precheck_timeout = secs

    def set_postcheck_timeout(secs: float) -> None:
        """Test hook."""
        postcheck_timeout = secs

    def set_read_retry(secs: float) -> None:
        """Test hook: the first wait before a failed read under a veto runs
        again."""
        read_retry_first = secs
        read_retry = secs

    #### introspection ######################################################

    def get_status() -> str:
        """One of the ST_* values above."""
        s = state.status
        return s if s is not None else ST_UNKNOWN

    def get_reason() -> ?str:
        return state.reason

    #### install ############################################################

    def _record(status: str) -> None:
        """Update the status and publish it if it or the rest of the state
        changed. The release the device runs is published as its platform
        version, not here."""
        if status != state.status or unpublished:
            state.status = status
            unpublished = False
            # Push a copy: Acton does not copy local message arguments, and
            # the DeviceMgr keeps what it receives in its oper tree.
            devmgr.on_software_state(state.copy())

    def _set_answers(campaign: ?str, target: ?str) -> None:
        """Make the status answer the intent of campaign and target. A status
        that starts to answer another intent drops the stage, the reason and
        the verdicts of the last one. Publishes with the next _record(), or
        now when the intent goes."""
        if campaign == state.upgrade_campaign and target == state.target_release:
            return
        state.upgrade_campaign = campaign
        state.target_release = target
        if target is not None:
            state.stage = None
            state.reason = None
            state.precheck = PrecheckResult(VERDICT_NOT_RUN, None, None)
            state.postcheck = PostcheckResult(VERDICT_NOT_RUN, None, None)
            for job in [e.name for e in state.job]:
                del state.job[job]
            unpublished = True
        else:
            unpublished = False
            devmgr.on_software_state(state.copy())

    def _clear_reason() -> None:
        """Remove the reason; it goes out with the next _record()."""
        if state.reason is not None:
            state.reason = None
            unpublished = True

    def _answers() -> bool:
        """True when the status answers the intent of the configuration."""
        return state.status != ST_UNKNOWN and state.target_release is not None \
            and state.target_release == target_release \
            and state.upgrade_campaign == upgrade_campaign

    def _done() -> None:
        """End the read or run under way. If the intent or the connection
        changed meanwhile, reconcile once."""
        busy = False
        if again:
            again = False
            _reconcile()

    def _fail(why: str) -> None:
        """End the run failed; the reason goes out with the status."""
        state.reason = why
        _record(ST_FAILED)
        _done()

    def _set_stage(s: str) -> None:
        state.stage = s
        devmgr.on_software_state(state.copy())

    def _reconcile() -> None:
        """Read the running release for the intent, unless the status already
        answers it: a final status, or upgrade-needed while a veto holds the
        install. Without a veto, prepare and install the target if the device
        runs another release."""
        if busy:
            again = True
            return
        t = target_release
        if t is None:
            _set_answers(None, None)
            return
        s = state.status
        if s is not None and _answers():
            if s in ST_FINAL:
                return
            if s == ST_UPGRADE_NEEDED and len(vetoes) > 0:
                if allow_staging and not _prepared(t!):
                    busy = True
                    run_campaign = upgrade_campaign
                    run_target = t
                    _prepare_ahead()
                return
        busy = True
        run_campaign = upgrade_campaign
        run_target = t
        adapter.check(_on_check_done)

    def _prepared(release: str) -> bool:
        """True when the prepare job runs or has a result for release."""
        job = state.job.get(JOB_PREPARE)
        return job is not None and job.release == release

    def _job_start(release: str) -> None:
        """Publish the prepare job as running for release."""
        job = state.job.get(JOB_PREPARE)
        if job is not None:
            job.state = JOB_RUNNING
            job.release = release
            job.started = _now()
            job.ended = None
            job.message = None
        else:
            state.job.create(JOB_PREPARE, state=JOB_RUNNING, release=release, started=_now())
        devmgr.on_software_state(state.copy())

    def _job_end(err: ?Exception) -> None:
        """Publish the end of the prepare job: done, or failed with the error."""
        job = state.job.get(JOB_PREPARE)
        if job is not None:
            job.state = JOB_FAILED if err is not None else JOB_DONE
            job.ended = _now()
            job.message = error_text(err!) if err is not None else None
            devmgr.on_software_state(state.copy())

    def _prepare_ahead() -> None:
        """Prepare the target while a veto holds the install: copy the image to
        the device ahead of the window. The status stays upgrade-needed."""
        t = run_target!
        _log.info("software: preparing ahead of the install",
                  {"device": name, "target": t})
        _job_start(t)
        adapter.prepare(_on_ahead_done, t)

    def _on_ahead_done(err: ?Exception) -> None:
        if err is not None:
            _log.warning("software: prepare ahead of the install failed",
                         {"device": name, "error": str(err)})
        _job_end(err)
        _done()

    def _retry_read(gen: int) -> None:
        if gen == read_gen:
            _reconcile()

    def _on_check_done(running: ?str, err: ?Exception) -> None:
        """Decide whether there is anything to do, from what the device reports."""
        if target_release != run_target or upgrade_campaign != run_campaign:
            # The intent changed while we were reading: read for the new one.
            again = True
            _done()
            return
        t = run_target!
        held = len(vetoes) > 0
        if err is not None and held:
            # Under a hold the read is all there is to do: say the release is
            # unknown, and read again when the device connects, or after a
            # while for another error.
            _set_answers(run_campaign, run_target)
            state.reason = "could not read the running release: " + error_text(err!)
            unpublished = True
            _record(ST_UNKNOWN)
            if not isinstance(err, NotConnectedError):
                read_gen += 1
                g = read_gen
                wait = read_retry
                read_retry = min([read_retry * 2.0, PLATFORM_RETRY_MAX])
                _log.info("software: could not read the running release, reading again later",
                          {"device": name, "error": str(err), "retry_in": wait})
                after wait: _retry_read(g)
            _done()
            return
        read_gen += 1
        read_retry = read_retry_first
        if err is not None:
            # Not knowing what the device runs is not the same as it being up to
            # date. Refusing to upgrade because one read failed is worse than a
            # redundant install, so carry on and let the install report.
            _log.warning("software: could not read the running release, "
                         "continuing without the comparison",
                         {"device": name, "error": str(err)})
        elif adapter.matches_release(running, t):
            _log.info("software: already on the target release, nothing to do",
                      {"device": name, "release": running, "target": t})
            _set_answers(run_campaign, run_target)
            _clear_reason()
            _record(ST_UP_TO_DATE)
            _done()
            return
        elif held:
            _log.info("software: upgrade needed, held by a veto",
                      {"device": name, "release": running, "target": t})
            _set_answers(run_campaign, run_target)
            _clear_reason()
            _record(ST_UPGRADE_NEEDED)
            if allow_staging and not _prepared(t):
                _prepare_ahead()
            else:
                _done()
            return
        previous_release = running
        _set_answers(run_campaign, run_target)
        # A new run starts at prepare; the verdicts below are from the last one.
        state.stage = STAGE_PREPARE
        state.reason = None
        state.precheck = PrecheckResult(VERDICT_NOT_RUN, None, None)
        state.postcheck = PostcheckResult(VERDICT_NOT_RUN, None, None)
        _record(ST_IN_PROGRESS)
        _job_start(t)
        adapter.prepare(_on_prepare_done, t)

    def _on_prepare_done(err: ?Exception) -> None:
        _job_end(err)
        if err is not None:
            _log.error("software staging failed", {"device": name, "error": str(err)})
            _fail(error_text(err!))
            return
        _run_checks("precheck", prechecks, precheck_timeout)

    def _on_install_done(err: ?Exception) -> None:
        if err is not None:
            _log.error("software install failed", {"device": name, "error": str(err)})
            _fail(error_text(err!))
            return
        adapter.commit_window(_on_commit_window)

    def _on_commit_window(w: ?int) -> None:
        limit = postcheck_timeout
        if w is not None:
            left = float(w!) - COMMIT_MARGIN
            if left <= 0.0:
                _start_rollback("no time left to commit before the device reverts")
                return
            if left < limit:
                limit = left
        _run_checks("postcheck", postchecks, limit)

    #### checks #############################################################

    def _run_checks(kind: str, reg: dict[str, action(action(bool, str) -> None) -> None],
                    limit: float) -> None:
        """Run every registered check of one kind concurrently. The round ends
        with the first refusal, the deadline, or the last pass; none
        registered passes at once."""
        names = list(reg.keys())
        attempt += 1
        gen = attempt
        checking = kind
        pending = {}
        passed = {}
        for n in names:
            pending[n] = True
        _set_stage(kind)
        if len(names) == 0:
            _checks_passed()
            return
        for n in names:
            reg[n](_check_done(gen, n))
        # Counted from now, when the checks were asked, however late this
        # message runs.
        after now limit: _on_check_timeout(gen)

    def _check_done(gen: int, registrant: str) -> action(bool, str) -> None:
        def done(ok: bool, reason: str) -> None:
            _on_check_result(gen, registrant, ok, reason)
        return done

    def _on_check_result(gen: int, registrant: str, ok: bool, reason: str) -> None:
        if gen != attempt or registrant not in pending:
            _log.debug("software: late check reply ignored",
                       {"device": name, "check": registrant})
            return
        del pending[registrant]
        if not ok:
            _checks_failed("{registrant}: {reason}")
            return
        passed[registrant] = reason
        if len(pending) == 0:
            _checks_passed()

    def _on_check_timeout(gen: int) -> None:
        if gen != attempt:
            return
        silent = ", ".join(sorted(pending.keys()))
        _checks_failed("did not answer: {silent}")

    def _record_check(kind: str, verdict: str, detail: str) -> None:
        if kind == "precheck":
            state.precheck = PrecheckResult(verdict, detail, _now())
        else:
            state.postcheck = PostcheckResult(verdict, detail, _now())
        devmgr.on_software_state(state.copy())

    def _checks_passed() -> None:
        kind = checking
        checking = ""
        attempt += 1
        if len(passed) > 0:
            # What each check saw, so the verdict tells the story on its own.
            parts: list[str] = []
            for r in sorted(passed.keys()):
                reason = passed[r]
                parts.append("{r}: {reason}" if reason != "" else r)
            _record_check(kind, VERDICT_PASS, "; ".join(parts))
        else:
            _record_check(kind, VERDICT_PASS, "no {kind}s registered")
        if kind == "precheck":
            if target_release is None:
                _fail("target release withdrawn before install")
                return
            if target_release != run_target or upgrade_campaign != run_campaign:
                _log.info("software: the intent changed before install, not installing",
                          {"device": name, "target": run_target})
                state.reason = "the intent changed before install"
                unpublished = True
                _record(ST_UPGRADE_NEEDED)
                _done()
                return
            if len(vetoes) > 0:
                holders = ", ".join(sorted(vetoes.keys()))
                _log.info("software: a veto holds the install",
                          {"device": name, "holders": holders})
                state.reason = "held by {holders} before install"
                unpublished = True
                _record(ST_UPGRADE_NEEDED)
                _done()
                return
            _set_stage(STAGE_INSTALL)
            adapter.install(_on_install_done, run_target!)
        else:
            _set_stage(STAGE_COMMIT)
            adapter.commit(_on_commit_done)

    def _checks_failed(detail: str) -> None:
        kind = checking
        checking = ""
        attempt += 1
        _record_check(kind, VERDICT_FAIL, detail)
        if kind == "precheck":
            # Nothing has been activated, so there is nothing to roll back.
            _log.error("software: pre-check refused, not installing",
                       {"device": name, "detail": detail})
            _fail("pre-check failed: {detail}")
        else:
            _start_rollback("post-check failed: {detail}")

    #### commit and rollback ################################################

    def _on_commit_done(err: ?Exception) -> None:
        if err is not None:
            # The device drops an uncommitted release on its own timer anyway.
            # Abort now so the outcome is known.
            _start_rollback(error_text(err!))
            return
        # Check the device is on the target: it may have reverted on its own.
        adapter.check(_on_final_check)

    def _start_rollback(why: str) -> None:
        _log.error("software: rolling back", {"device": name, "reason": why})
        attempt += 1
        state.reason = why
        _set_stage(STAGE_ROLLBACK)
        adapter.rollback(_on_rollback_done, previous_release)

    def _on_rollback_done(err: ?Exception) -> None:
        # The release can change without a reconnect, so read the platform
        # again, also when the rollback failed.
        devmgr.read_platform()
        if err is not None:
            _log.error("software rollback failed", {"device": name, "error": str(err)})
            why = error_text(err!)
            r = state.reason
            if r is not None:
                why = r! + "; " + why
            _fail(why)
            return
        _record(ST_ROLLED_BACK)
        _done()

    def _on_final_check(running: ?str, err: ?Exception) -> None:
        if err is not None:
            # Install already confirmed the target release. Preserve success if
            # this final read fails.
            _log.warning("software: installed, but could not read the release back",
                         {"device": name, "error": str(err)})
        t = run_target
        if running is not None and t is not None and not adapter.matches_release(running, t!):
            # The device reverted on its own before the commit took.
            got = running!
            want = t!
            _log.error("software: device does not run the target after commit",
                       {"device": name, "running": got, "target": want})
            devmgr.read_platform()
            _fail("device runs {got} after the commit, not {want}")
            return
        # New software may mean a different modset, so the device has to be
        # re-discovered before anything trusts its schema again. The release
        # can change without a reconnect, so read the platform again too.
        devmgr.resync()
        devmgr.read_platform()
        _record(ST_SUCCEEDED)
        _done()

    # Report the initial state, so the DeviceMgr's entry oper starts complete.
    devmgr.on_software_state(state.copy())


#############################################################################
# Platform discovery
#
# A platform probe reads what a device is: its OS family, release, chassis
# model and serial number. On every connect, DeviceMgr runs the first probe
# that applies to the device's modules. It tries the device type's own probes
# first, then the app's list, SysSpec.platform_probes. That list is
# platform_probes.PROBES unless the app gives its own.
#############################################################################

class Platform(object):
    """What a device is. A probe leaves a field None when it does not know it."""
    os: ?str
    version: ?str
    model: ?str
    serial_number: ?str

    def __init__(self, os: ?str=None, version: ?str=None, model: ?str=None,
                 serial_number: ?str=None):
        self.os = os
        self.version = version
        self.model = model
        self.serial_number = serial_number


def nonempty(s: ?str) -> ?str:
    """s, or None when it is empty. A device can answer an empty string for a
    value it does not have, and the probe then leaves the field None."""
    if s is not None and s != "":
        return s
    return None


class PlatformMismatch(Exception):
    """A probe gives this to done when it has read the device and found that
    the device is not its case. DeviceMgr then runs the next probe that
    applies."""


class PlatformProbe(object):
    """Reads what a device is. A subclass sets name and implements applies
    and read.

    applies looks only at the module set, so the same modules always pick the
    same probe. read reads the device through dev and calls done once:

    - done(platform, None): the answer. DeviceMgr publishes it.
    - done(None, PlatformMismatch()): the device is not the probe's case.
      DeviceMgr runs the next probe that applies.
    - done(None, error): the read failed. DeviceMgr keeps the values if
      this probe read them, else removes them, and runs the probe again
      later. A read that gives no values is a failure too: right after a
      reload a device can answer with no data.

    A probe reads through the device's schema, so the device type's schema
    must have the nodes that the probe reads.

    read runs in the DeviceMgr, so it must not wait for the result of a call
    to dev: that call would wait for read to end. A reply from dev must go to
    an action, so a probe that waits for one starts an actor to receive it.
    GetPlatformProbe does this for a probe that needs one get.

    The device type's probes run before the app's, so an app cannot put its
    own probe before them. To change them, give the device type other probes.
    """
    name: str

    ## Whether the probe can read a device with these modules.
    applies: proc(modset: dict[str, ModCap]) -> bool

    ## Read the device and call done once, as the class description says.
    read: proc(dev: DeviceMgr, done: action(?Platform, ?Exception) -> None) -> None


class GetPlatformProbe(PlatformProbe):
    """A probe that reads the device with one get.

    A subclass sets name and filt, and implements applies and parse. parse
    gives the platform, None when the reply has no values, or raises
    PlatformMismatch when the reply shows that the device is not its case.
    """
    filt: ygdata.FNode

    ## The platform in a reply. See the class description.
    parse: proc(root: ?ygdata.Node) -> ?Platform

    def read(self, dev: DeviceMgr, done: action(?Platform, ?Exception) -> None) -> None:
        _GetPlatformRead(dev, self, done)


actor _GetPlatformRead(dev: DeviceMgr, probe: GetPlatformProbe,
                       done: action(?Platform, ?Exception) -> None):
    """One read of a GetPlatformProbe: the get, then the probe's parse."""
    def on_reply(root: ?ygdata.Node, err: ?Exception) -> None:
        if err is not None:
            done(None, err)
            return
        try:
            p = probe.parse(root)
            if p is not None:
                done(p, None)
            else:
                done(None, ValueError("the reply has no platform values"))
        except Exception as e:
            done(None, e)

    dev.get(on_reply, probe.filt)


## DeviceType represents a type of device, i.e. a specific platform or
## implementation of a device. It is used to define the schema and
## adapter type for the device.
class DeviceType(object):
    ## Name of the device type
    name: str

    ## Adapter type, i.e. the DeviceAdapter subclass to use
    # TODO: why is @property needed here?
    @property
    adapter_type: proc(DeviceMgr, DeviceSchema, DeviceMetaConfig, SchemaRegistry, logging.Handler, ?Env) -> DeviceAdapter

    bundled_schema: DeviceSchema

    ## Software adapter type, i.e. the SoftwareAdapter subclass to use for this
    ## platform. Optional: a device type with no software adapter simply has no
    ## upgrade capability, and its SoftwareManager stays idle.
    @property
    software_adapter_type: ?proc(DeviceMgr, DeviceMetaConfig, logging.Handler, ?Env) -> SoftwareAdapter

    ## Platform probes for devices of this type. They run before the app's
    ## probes, so an adapter package can bring the probe for its own devices,
    ## like a CLI adapter that knows which commands name the model.
    platform_probes: list[PlatformProbe]

    def __init__(self, name: str, adapter_type, src_dnode, oper_src_dnode: ?yschema.DRoot=None, schema_transforms: list[SchemaTreeTransform]=[], software_adapter_type=None, platform_probes: list[PlatformProbe]=[]):
        self.name = name
        self.adapter_type = adapter_type
        self.bundled_schema = DeviceSchema(name, src_dnode, oper_src_dnode, schema_transforms)
        self.software_adapter_type = software_adapter_type
        self.platform_probes = platform_probes

actor DeviceRegistry(dev_types: dict[str, DeviceType]={}, env: ?Env=None, log_handler: logging.Handler, device_logs: ?swlogs.DeviceLogs=None, platform_probes: list[PlatformProbe]=[]):
    """Device Registry keeps track of all devices and hands out references to
    them based on name.

    There must only be a single Device instance per device, i.e. the same device
    name must always return the same Device instance.

    Each device logs to its own handler under log_handler. With device_logs,
    that handler also writes the device's log file. Every device gets
    platform_probes, the app's list.
    """
    var devices = {}

    var devices_needing_approval = {}

    schema_registry = SchemaRegistry()

    action def _dummy_reconf(name: str):
        # Dummy reconf callback, used to avoid None
        pass

    var reconf_cb: action(str) -> None = _dummy_reconf

    def get(name: str) -> ?DeviceMgr:
        return devices.get(name)

    def get_or_create(name: str) -> DeviceMgr:
        if name not in devices:
            devices[name] = DeviceMgr(dev_types, env, name, log_handler, reconf_cb, schema_registry, self, device_logs, platform_probes)
        dev = devices[name]
        return dev

    def list():
        return devices.keys()

    def on_reconf(on_reconf: action(str) -> None):
        reconf_cb = on_reconf

    def register_needs_approval(name: str):
        """Register that a device has pending configurations needing approval"""
        dev = devices.get(name)
        if dev is not None:
            devices_needing_approval[name] = dev

    def unregister_needs_approval(name: str):
        """Unregister a device from needing approval

        For example when all configs are approved or rejected or approval-required has been disabled
        """
        del devices_needing_approval[name]

    def get_devices_needing_approval() -> dict[str, DeviceMgr]:
        """Get devices that have pending approvals

        Returns a dictionary mapping device name to DeviceMgr instance
        for devices that currently need approval. Clients can then
        directly query each DeviceMgr for details.
        """
        return devices_needing_approval


class SchemaFetchError(Exception):
    """The YANG modules of a schema could not be downloaded

    The download may succeed on another attempt, so the error is not kept.
    """
    pass


actor _SchemaCompiler():
    """Compiles a device schema outside of the SchemaRegistry actor"""
    def compile(done: action(SchemaKey, ?yschema.DRoot, ?Exception) -> None, key: SchemaKey, yang_src: list[str], transforms: list[SchemaTreeTransform]) -> None:
        try:
            compiled = yang.compile(yang_src, strict_quoting=False)
            for t in transforms:
                t.apply(compiled)
            done(key, compiled, None)
        except Exception as e:
            done(key, None, e)


actor SchemaRegistry():
    """Device schemas compiled from YANG modules downloaded from devices

    When we connect to a device we get a list of YANG modules with names and
    revisions. Before downloading the contents, we compute a "schema key" that
    combines the set of YANG modules and the applied transforms into a unique
    identifier. This identifier is then used to coordinate schema fetching and
    compilation when multiple devices of the same type request the schema at the
    same time. Only one DeviceMgr will download the modules and kick off
    compilation. The other (pending) DeviceMgr are notified after it is done.
    The assumption here is that the set of YANG modules and revisions is enough
    to uniquely target a single software version on a device.

    Compilation runs outside the registry actor so that it is not blocked.
    """
    var store: dict[SchemaKey, yschema.DRoot] = {}
    var errors: dict[SchemaKey, Exception] = {}
    # Callbacks of the requests for schemas that are being fetched or compiled
    var waiting: dict[SchemaKey, list[action(?SchemaKey, ?Exception) -> None]] = {}

    def request_schema(done: action(?SchemaKey, ?Exception) -> None, key: SchemaKey) -> bool:
        """Request the schema of key

        Calls done with key when the schema is compiled, or with the error.
        Returns True when the caller is to download the modules of key, or
        False when the schema is compiled or another caller is already fetching it.
        """
        if key in store:
            done(key, None)
            return False
        if key in errors:
            done(None, errors[key])
            return False
        if key in waiting:
            waiting[key].append(done)
            return False
        waiting[key] = [done]
        return True

    def add_schema(key: SchemaKey, yang_src: list[str], transforms: list[SchemaTreeTransform]=[]) -> None:
        """Compile the fetched schema and add it to the registry
        """
        _SchemaCompiler().compile(_on_compiled, key, yang_src, transforms)

    def fetch_failed(key: SchemaKey, error: Exception) -> None:
        """Report that the download of the modules of key failed
        """
        for done in waiting.pop_def(key, []):
            done(None, SchemaFetchError("Failed to download YANG modules: {error}"))

    def _on_compiled(key: SchemaKey, schema: ?yschema.DRoot, error: ?Exception) -> None:
        if schema is not None:
            store[key] = schema
        elif error is not None:
            errors[key] = error
        for done in waiting.pop_def(key, []):
            if key in errors:
                done(None, errors[key])
            else:
                done(key, None)

    def get_schema(key: ?SchemaKey) -> ?yschema.DRoot:
        if key is not None:
            return store.get(key)


def _default_device_log_level(device_logs: ?swlogs.DeviceLogs) -> int:
    """Return the log level of a device without debug settings."""
    if device_logs is not None:
        return device_logs.level
    return logging.DEBUG


def _device_log_level(dmc: DeviceMetaConfig, default: int) -> int:
    """Return the log level that the debug settings of a device ask for.

    debug/connection asks for trace, else debug/log-level for its level.
    Without either, return default.
    """
    if dmc.debug.connection:
        return logging.TRACE
    name = dmc.debug.log_level
    if name is not None:
        return swlogs.parse_level(name)
    return default


def truncate_conf(conf: ?ygdata.Node) -> str:
    """Truncate the configuration to a short string for logging
    """
    if conf is not None:
        sc = conf.to_yang_jsonstr()
        trunc_len = min([len(sc), 50])
        if trunc_len < len(sc):
            sc = sc[:trunc_len] + "..."
        return sc
    return r"{}"


def config_fixer(old: ?ygdata.Node, new: ygdata.Node):
    # Fix up config. On IOS XR we need to bring with us the Mgmt interface
    # configuration that exists on the device. We run XRds for testing using
    # containerlab and containerlab configures the IP addresses as part of a
    # bootstrap process. The IP addresses are dynamically allocated and thus
    # vary between test invocations. Since our transform output does not contain
    # any configuration of the MgmtEth0/RP0/CPU0/0 interface, the diff will
    # remove it. If we deconfigure the interface from the device, we loose
    # connectivity to it. This code simply finds if there is a
    # MgmtEth0/RP0/CPU0/0 interface in the currently running configuraton on the
    # device and then brings that over into the new target config.
    def get_xr_mgmt_interface(n: ?ygdata.Node) -> ygdata.Node:
        def q(n):
            return ygdata.Id("http://cisco.com/ns/yang/Cisco-IOS-XR-um-interface-cfg", n)

        if n is not None:
            xr_interfaces = n.children[q("interfaces")]
            if xr_interfaces.ns != "http://cisco.com/ns/yang/Cisco-IOS-XR-um-interface-cfg":
                raise ValueError("No XR interfaces found")
            xr_interface = xr_interfaces.children[q("interface")]
            if isinstance(xr_interface, ygdata.List):
                key = "MgmtEth0/RP0/CPU0/0"
                elem = xr_interface.get_opt_list_entry(key)
                if elem is not None:
                    return ygdata.Container({
    q('interfaces'): ygdata.Container({
        q('interface'): ygdata.List([q('interface-name')], by_key={key: elem})
    }, ns='http://cisco.com/ns/yang/Cisco-IOS-XR-um-interface-cfg', module='Cisco-IOS-XR-um-interface-cfg')
    })
        raise ValueError("No XR mgmt interface found")

    try:
        mgmt_intf_cfg = get_xr_mgmt_interface(old)
        new2 = ygdata.patch(new, mgmt_intf_cfg)
        if new2 is not None:
            return new2
        raise ValueError("Unreachable, patch will never produce empty (None) config for this config input")
    except Exception as exc:
        pass
    return new


class ConfigItem(object):
    approved: ?bool

    def __init__(self, tid: str, conf: ygdata.Node, modset_id: ?str):
        self.tid = tid
        self.conf = conf
        self.modset_id = modset_id
        self.approved = None

class LogItem():
    def __init__(self, event: str, conf_diff: ?ygdata.Node, modset_id: ?str):
        self.ts = time.now()
        self.event = event
        self.conf_diff = conf_diff

def _is_mock_device(dmc: DeviceMetaConfig) -> bool:
    if dmc.mock.enabled:
        return True
    return len(dmc.mock.module) > 0


def extra_adapter_dmc(dmc: DeviceMetaConfig, extra: ExtraAdapterConfig) -> DeviceMetaConfig:
    """Give the device meta configuration that an extra adapter gets.

    It is the device's, with the device type of the extra adapter. The address
    list holds only the chosen address, the first if none is chosen. Its port
    is the port of the extra adapter, or none: the port of the address is for
    the primary adapter. The credentials and the SSH settings of the extra
    adapter replace the device's when it has them.
    """
    view = dmc.copy()
    view.type = extra.type
    view.extra_adapter = ExtraAdapterList()
    chosen: ?AddressEntry = None
    want = extra.address
    for a in dmc.address:
        if want is not None:
            if a.name == want:
                chosen = a.copy()
                break
        else:
            chosen = a.copy()
            break
    if chosen is not None:
        chosen.port = extra.port
        view.address = AddressList([chosen])
    else:
        view.address = AddressList()
    creds = extra.credentials
    if creds is not None:
        view.credentials = Credentials(creds.username, creds.password,
                                       [CredentialsKey(k.key, k.private_key) for k in creds.key])
    ssh = extra.ssh
    if ssh is not None:
        view.ssh = DeviceSsh.from_gdata(ssh.to_gdata())
    return view


actor _MergedGet(cb: action(?ygdata.Node, ?Exception) -> None, parts: int):
    """Answer a get that went to several adapters, with the merge of their
    replies or with the first error."""
    var pending: int = parts
    var merged: ?ygdata.Node = None
    var answered: bool = False

    def reply(tree: ?ygdata.Node, err: ?Exception) -> None:
        if answered:
            return
        if err is not None:
            answered = True
            cb(None, err)
            return
        merged = ygdata.patch(merged, tree)
        pending -= 1
        if pending == 0:
            answered = True
            cb(merged, None)


actor _MergedTrees():
    """Deliver the subscriptions of one owner that went to several adapters
    as one tree: the merge of the latest tree from each adapter."""
    var owner_cb: ?action(?ygdata.Node, ?Exception) -> None = None
    var latest: dict[str, ygdata.Node] = {}

    def start(cb: action(?ygdata.Node, ?Exception) -> None) -> None:
        owner_cb = cb

    def deliver(adapter: str, tree: ?ygdata.Node, err: ?Exception) -> None:
        cb = owner_cb
        if cb is not None:
            if tree is not None:
                latest[adapter] = tree
                merged: ?ygdata.Node = None
                for t in latest.keys():
                    merged = ygdata.patch(merged, latest[t])
                cb(merged, None)
            else:
                cb(None, err)

    def close() -> None:
        """Deliver nothing more; the owner's subscriptions went elsewhere."""
        owner_cb = None


actor _AllSynced(owner_id: str, synced: action(str) -> None, adapters: list[str]):
    """Tell an owner that its subscriptions are in place once every adapter
    with a part of them has said so."""
    var pending: set[str] = set(adapters)
    var closed: bool = False

    def part_synced(adapter: str) -> None:
        if closed or adapter not in pending:
            return
        pending.discard(adapter)
        if len(pending) == 0:
            synced(owner_id)

    def close() -> None:
        closed = True


def _same_parts[T(Hashable)](a: dict[str, set[T]], b: dict[str, set[T]]) -> bool:
    if len(a) != len(b):
        return False
    for k, v in a.items():
        if k not in b or b[k] != v:
            return False
    return True


class DeviceTreeProvider(ygdata.TreeProvider):
    dev: DeviceMgr

    def __init__(self, dev: DeviceMgr):
        self.dev = dev

    proc def rpc(self, cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node):
        self.dev.rpc(cb, gdata_rpc)

    proc def declare_subscriptions(self, owner_id: str, cb: action(?ygdata.Node, ?Exception) -> None, want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        self.dev.declare_subscriptions(owner_id, cb, want, synced)

    proc def remove_subscriptions(self, owner_id: str):
        self.dev.remove_subscriptions(owner_id)



actor DeviceMgr(dev_types: dict[str, DeviceType]={}, env: ?Env=None, name: str, log_handler: logging.Handler, on_reconf: action(str) -> None, schema_registry: SchemaRegistry, device_registry: ?DeviceRegistry=None, device_logs: ?swlogs.DeviceLogs=None, platform_probes: list[PlatformProbe]=[]):
    """Device Manager manages a device and represents that device, as an
    abstract device, in the system. Platform specific handling is implemented in
    the DeviceAdapter, i.e.  in subclasses of DeviceAdapter, like NetconfAdapter
    and MockAdapter.

    The DeviceMgr sits between the TTT transaction engine and devices out in
    the real world. All changes from TTT are accepted, they are by definition
    the intended target configuration for the device, thus the TTT API is fairly
    simple. Configuration is fed from TTT to DeviceMgr asynchronously (nothing
    can go wrong) together with a transaction id (tid). If a TTT transaction
    wants to await the configuration to reach the device, that is possible via
    the wait_complete(tid). The device configuration interaction is serial,
    which means that we are either idling or have configuration in-transit to
    the device. If new configuration is received from TTT while we have
    configuration in-transit to the device, the new configuration and their
    associated tid is queued up in confq. Once acknowledgement is received from
    the device, and thus the in-transit commit has concluded, the pending
    configurations in confq, can be pushed to the device.

    The device interaction is entirely asynchronous.

    ## Mocking
    Mocking of devices is supported which is very useful for testing and
    development. When in mock mode, we largely skip or simplify device
    interaction. This allows us to test the TTT transaction engine and the
    transforms without needing real devices or real device adapters.

    A device can be configured to be in mock mode through the DeviceMetaConfig,
    which is useful for testing and development, set mock/enabled=True under the
    device. The whole system can also run in mock mode which forces all devices
    to be mocked regardless of their individual configuration. That is the
    case when env is None.

    MockAdapter is the generic adapter for mocked devices, which pretends to be
    a device and accepts configuration but doesn't actually do anything with it.
    It is very useful since it does not require any explicit mocking support in
    the device adapters. On the other hand, its behavior is very simple and does
    not allow for testing of more complex device interaction, like operational
    state or error handling, which is why device adapters can also support a
    mock mode, which allows for more complex mocked behavior. When in mock mode,
    the DeviceAdapter.supports_mocking() -> bool method is used inform us if the
    real device adapter support mock mode and thus we'll use that adapter in
    mock mode or whether we should fall back to the generic MockAdapter.

    The NetconfAdapter supports mock mode, which sets up a mock NETCONF server
    internally. It uses an internal pipe instead of a real SSH / TLS connection
    over the network. Tests can access the mock server and side-load data into
    it in order to verify the DeviceMgr's interaction with the device adapter
    and the adapter's interaction with the device.

    ## Adapters
    The device type gives the primary adapter. The extra adapters in
    DeviceMetaConfig.extra_adapter are device types too, each with its own
    adapter. Each adapter gets the device meta configuration with its own
    device type, see extra_adapter_dmc. It reports its modules with
    on_connect(modules, schema_key, dmc.type) and a lost connection with
    on_disconnect(dmc.type); a call without the device type is the primary's.

    A module belongs to the first adapter that advertises it, the primary
    first. Reads, subscriptions, RPCs and event notification subscriptions go
    to the adapters that serve the namespaces of their top-level nodes, see
    device_routing. Configuration goes only to the primary. The module set of
    the device is the union of the adapters' modules.

    ## Platform
    On every connect the DeviceMgr runs the first platform probe that applies
    to the device's modules and publishes its answer under state/platform.
    The device type's probes come first, then platform_probes, the app's
    list. A probe can give the device to the next probe (PlatformMismatch).
    A failed read keeps the values if the same probe read them, else removes
    them, and runs again after a delay that doubles each time, so a replaced
    box shows once a read succeeds. When no probe applies, the values are
    removed.

    ## Logging
    The device and its adapters log to one handler, named after the device.
    With device_logs, the handler writes the device's log file at the level
    from device_logs. The device's debug/log-level overrides that level, and
    debug/connection sets it to trace.
    """
    _default_log_level = _default_device_log_level(device_logs)
    _log_handler = logging.Handler(name)
    _log_handler.set_handler(log_handler)
    _log_handler.set_output_level(_default_log_level)
    if device_logs is not None:
        device_logs.add_file(_log_handler, name)
    _log = logging.Logger(_log_handler)

    def debug_enabled() -> bool:
        """Build debug payloads only when they will be printed: log arguments are
        evaluated at the call, so a whole config dump costs the same at info."""
        return logging.DEBUG <= _log_handler.get_level()

    system_mock = env is None
    _log.debug("DeviceMgr starting up", {"name": name, "system_mock": system_mock})

    # The device entry's oper tree, in the adata generated from the same
    # YANG as the DeviceMetaConfig. Sub-components push their subtree; the
    # DeviceMgr fuses it in and publishes the whole entry.
    var oper: DeviceOper = DeviceOper(name)

    # The device entry's true update_oper, handed over by TTT when the entry
    # node is created.
    var _update_oper: ?action(?ygdata.Node) -> None = None

    def update_oper() -> None:
        """Publish the device entry's oper tree.

        Always safe to call after a change to oper: it sends the tree to the
        entry's update_oper when TTT has registered one, and does nothing
        before that.
        """
        cb = _update_oper
        if cb is not None:
            cb(oper.to_gdata())

    def on_software_state(state: SoftwareState) -> None:
        """SoftwareManager pushes its oper state: fuse and publish."""
        _log.info("DeviceMgr: software status",
                  {"device": name, "status": str(state.status), "stage": str(state.stage)})
        oper.software.state = state
        update_oper()

    # Per-device software manager. Statically instantiated: every device has
    # one, whether or not its device type can actually install software. It
    # stays idle until it is given both an adapter and a target release.
    swmgr = SoftwareManager(name, _log_handler, self)

    def set_update_oper(cb: action(?ygdata.Node) -> None) -> None:
        """Hand the DeviceMgr the oper publication hook for its device entry.

        The whole device/ entry is served by this DeviceMgr, so the hook
        covers all of its oper state, not one sub-component's. It is a
        setter and not a constructor argument because several TTT nodes
        get-or-create the DeviceMgr and only the device entry has the hook
        to give: whichever node asks first constructs the manager. A
        re-created entry replaces its predecessor's hook. The current oper
        state is pushed on registration, so a subscriber that arrives after
        status changes still publishes the truth.
        """
        _update_oper = cb
        update_oper()

    # The device's meta configuration, like address, credentials, etc.
    var dmc: DeviceMetaConfig = DeviceMetaConfig(name, Credentials("", None))

    # The bundled schema is compiled at build time and bundled with stratoweave
    var bundled_schema: DeviceSchema = DeviceSchema.mock()
    var adapter: DeviceAdapter = MockAdapter(lambda m, k: self.on_connect(m, k), bundled_schema, _log_handler, env) if system_mock else NoAdapter(bundled_schema, _log_handler, env)
    # The device type of the primary adapter, "" before the device has one.
    var primary_type: str = ""
    # The extra adapters by device type, in configured order, and the log
    # handlers they log to.
    var extra_adapters: dict[str, DeviceAdapter] = {}
    var extra_log_handlers: dict[str, logging.Handler] = {}
    # The modules each adapter reported: the primary's, and the extra
    # adapters' by device type.
    var primary_modules: dict[str, ModCap] = {}
    var extra_modules: dict[str, dict[str, ModCap]] = {}
    # The device types whose bundled schemas make up bundled_schema.
    var schema_types: list[str] = []
    # Which adapter serves each namespace.
    var routes: Routes = Routes([""], {})

    # The subscriptions each owner declared. When the adapters or their modules
    # change, the declarations go to the adapters that serve them now. A TTT
    # node can get this DeviceMgr and subscribe before the device entry gives
    # it its adapters.
    var declared: dict[str, (cb: action(?ygdata.Node, ?Exception) -> None,
                             want: set[ygdata.SubscriptionSpec],
                             synced: ?action(str) -> None)] = {}
    # The same for event notification subscriptions.
    var notif_declared: dict[str, (cb: action(?NotifEvent, ?Exception) -> None,
                                   want: set[NotifSpec],
                                   synced: ?action(str) -> None)] = {}
    # The part of each owner's declaration that each adapter got.
    var sub_routes: dict[str, dict[str, set[ygdata.SubscriptionSpec]]] = {}
    var notif_routes: dict[str, dict[str, set[NotifSpec]]] = {}
    # For an owner whose declaration went to several adapters: the merge of
    # their trees, and the wait for all of them to be in place.
    var sub_merges: dict[str, _MergedTrees] = {}
    var sub_synced: dict[str, _AllSynced] = {}
    var notif_synced: dict[str, _AllSynced] = {}

    # The modules supported by the device.
    var modset: dict[str, ModCap] = {}
    var modset_id: ?str = None

    # Key of the fetched schema in the SchemaRegistry
    var schema_key: ?SchemaKey = None

    # The device type's platform probes, run before the app's.
    var type_probes: list[PlatformProbe] = []
    # Bumped on every connect and adapter change, so a probe reply or retry
    # from an earlier connection is dropped.
    var platform_gen: int = 0
    # Bumped for every probe read and every answer, so a probe that calls done
    # twice gets only its first call handled.
    var platform_read: int = 0
    var platform_retry_first: float = PLATFORM_RETRY_FIRST

    # The device's current running configuration, as we know it.
    var running_conf: ?ygdata.Node = None

    # New configuration received from the transaction engine via the
    # DeviceMgr.configure() method are stored in a configuration queue, which
    # uses ConfigItem to track the configuration including the associated tid
    # and modset_id. Any new configuration is appended and we consume the queue
    # when sending configuration to the device.
    var confq: dict[str, ConfigItem] = {}

    # target_conf is the last successfully applied configuration of the device
    # We dequeue configuration from the confq and send to the device. Once that
    # configuration has been successfully applied to thedevice, we remove it
    # from the confq and call the associated callbacks for the tids in the
    # ConfigItem. We also save that config in target_conf, so that if we have
    # the need to reconfigure the device, like after the running_conf has
    # updated, we do that with the latest config that we sent to the device,
    # i.e. target_conf.
    var target_conf: ?ygdata.Node = None

    # current_tids are the ids of the transactions that are currently
    # in-transit, which also means that we can determine if we have an
    # outstanding transaction by checking len(current_tids) > 0.
    var current_tids = set()
    # reconf is a special kind of operation, where an initial transaction
    # intends to configure devices but those devices have no known modset and
    # thus the RFS transforms cannot produce device configuration. It is still
    # valid to await completion of such a transaction and the intent means "we
    # want to await that the RFS transform intended (future) output has reached
    # the device". Those transactions register for the future reconf and we keep
    # track of those in reconf_tids. The next successfuly sent configuration to
    # the device will call the reconf_tids on completion so they in turn can
    # notify their clients that the configuration now has reached the devices.
    var reconf_tids = set()


    # The last successfully sent diff. We use this to detect and break infinite
    # loops in the device config reconciliation loop
    var last_sent_diff: ?ygdata.Node = None

    # TTT transactions can optionally request, through wait_complete(tid, cb), to
    # wait until configuration has been committed to the device. We keep track
    # of those callbacks keyed by tid.
    var callbacks: dict[str, action(value)->None] = {}

    # Track whether we currently have config items in confq that need approval.
    # When we transition this we also register and / unregister with
    # DeviceRegistry through _update_approval_state()
    var needs_approval = False
    var conf_log: list[LogItem] = []

    def get_state():
        """Get the device state information"""
        has_running = False
        has_target = False
        if running_conf is not None:
            has_running = True
        if target_conf is not None:
            has_target = True

        return (
            has_running_config=has_running,
            has_target_config=has_target,
            queue_length=len(confq),
            pending_approvals=len(get_pending_approvals())
        )

    def _update_approval_state():
        if not dmc.approval_required:
            if needs_approval:
                needs_approval = False
                if device_registry is not None:
                    device_registry.unregister_needs_approval(name)
            return

        # Check if there are any items in confq that need approval
        has_pending_approval = False
        for id, ci in confq.items():
            if ci.approved is None:
                has_pending_approval = True
                break

        # Update state and notify device_registry if state changed
        if has_pending_approval and not needs_approval:
            needs_approval = True
            if device_registry is not None:
                device_registry.register_needs_approval(name)
        elif not has_pending_approval and needs_approval:
            needs_approval = False
            if device_registry is not None:
                device_registry.unregister_needs_approval(name)

    def get_device_txid() -> str:
        """Get the device txid from our view of the device's running config"""
        if running_conf is not None:
            rc_txid = running_conf.txid
            if rc_txid is not None:
                return rc_txid
        return ""

    def get_swmgr() -> SoftwareManager:
        return swmgr

    def get_dmc():
        return dmc

    def get_running_conf():
        return running_conf

    def get_target_conf():
        return target_conf

    def on_modset_update(new_modset: dict[str, ModCap]):
        _log.debug("Modset updated", {"new_modset": new_modset})
        on_reconf(name)

    def _on_config_change(ev: ?NotifEvent, err: ?Exception):
        # Channel trouble (err) is resync-neutral: reconnects already resync,
        # which covers any config-change events missed while the channel was
        # down. Only an actual event triggers work.
        if ev is not None:
            _log.info("Device sent netconf-config-change, resyncing", {"event_time": ev.event_time})
            resync()

    def _ensure_config_change_subscription(new_modset: dict[str, ModCap]):
        # Event-driven out-of-band drift detection: when the device implements
        # RFC 6470, subscribe to netconf-config-change and resync on it, so
        # drift is caught near-immediately rather than on the next reconnect.
        # declare is full-state and idempotent, so reasserting per connect is
        # free; devices without the module cost nothing (no channel opens).
        if MODULE_NETCONF_NOTIFICATIONS in new_modset:
            declare_notif_subscriptions("devicemgr-config-change",
                _on_config_change, {NotifSpec(CONFIG_CHANGE_NOTIF)})
        else:
            remove_notif_subscriptions("devicemgr-config-change")

    def _reporting_adapter(dev_type: ?str) -> ?str:
        """Give the device type of the adapter that reports dev_type, or None
        when the device has no such adapter. None reports the primary."""
        if dev_type is not None:
            if dev_type == primary_type:
                return primary_type
            if dev_type in extra_adapters:
                return dev_type
            return None
        return primary_type

    def on_connect(new_modset: dict[str, ModCap], new_schema_key: ?SchemaKey, dev_type: ?str=None):
        """An adapter connected and serves new_modset. dev_type is its device
        type; None is the primary. The schema key of an extra adapter is not
        used."""
        reporter = _reporting_adapter(dev_type)
        if reporter is not None:
            _adapter_connected(reporter, new_modset, new_schema_key)
        else:
            _log.debug("Ignoring a connect from an adapter the device does not have", {"adapter": dev_type})

    def _adapter_connected(reporter: str, new_modset: dict[str, ModCap], new_schema_key: ?SchemaKey):
        _log.debug("Device connected", {"adapter": reporter, "new_modset": new_modset, "schema_modules": len(new_schema_key.modules) if new_schema_key is not None else None})
        is_primary = False
        if reporter == primary_type:
            is_primary = True
        if is_primary:
            primary_modules = new_modset
        else:
            extra_modules[reporter] = new_modset
        _set_connected(reporter, True)
        _update_routes()
        new_union = union_modules(_adapter_types(), _modules_by_type())
        resync()
        _read_platform(new_union)
        if is_primary:
            swmgr.on_connect()
        _ensure_config_change_subscription(new_union)
        if modset_eq(modset, new_union):
            _log.debug("Supported modules unchanged")
        else:
            _log.debug("New supported modules, triggering RFS reconf", {"name": name})
            modset = new_union
            modset_id = hash_modset(modset)
            if is_primary:
                schema_key = new_schema_key
            on_reconf(name)

    def on_disconnect(dev_type: ?str=None):
        """An adapter lost its connection. dev_type is its device type; None
        is the primary."""
        reporter = _reporting_adapter(dev_type)
        if reporter is not None:
            _set_connected(reporter, False)

    def _set_connected(dev_type: str, connected: bool) -> None:
        """Publish whether an adapter is connected, on a change only. The
        entry of a new adapter that is not connected yet goes out with the
        next publication. An adapter without a device type has no entry."""
        if dev_type == "":
            return
        entry = oper.state.adapter.get(dev_type)
        changed = False
        if entry is not None:
            old = entry.connected
            if old is None or old != connected:
                entry.connected = connected
                changed = True
        else:
            oper.state.adapter.create(dev_type, connected)
            changed = connected
        if changed:
            _log.info("DeviceMgr: adapter connected" if connected else "DeviceMgr: adapter disconnected",
                      {"device": name, "adapter": dev_type})
            update_oper()

    def _drop_adapter_entry(dev_type: str) -> None:
        if oper.state.adapter.get(dev_type) is not None:
            del oper.state.adapter[dev_type]
            update_oper()

    def _adapter_types() -> list[str]:
        """The device types of the adapters, the primary first."""
        return [primary_type] + list(extra_adapters.keys())

    def _modules_by_type() -> dict[str, dict[str, ModCap]]:
        mods = {primary_type: primary_modules}
        for t, m in extra_modules.items():
            mods[t] = m
        return mods

    def _adapter_of_type(dev_type: str) -> DeviceAdapter:
        """Give the adapter of a device type; the primary if the device has no
        extra adapter of that type."""
        if dev_type != primary_type:
            extra = extra_adapters.get(dev_type)
            if extra is not None:
                return extra
        return adapter

    def _update_routes() -> None:
        """Decide again which adapter serves each namespace, and send the
        declarations whose route changed to the adapters that serve them
        now."""
        routes = Routes(_adapter_types(), _modules_by_type())
        for owner_id in list(declared.keys()):
            _route_subscriptions(owner_id, False)
        for owner_id in list(notif_declared.keys()):
            _route_notifs(owner_id, False)

    def _forget_adapter(dev_type: str, old: DeviceAdapter) -> None:
        """Remove the declarations from an adapter that is replaced or removed.
        The next _update_routes sends them to the adapters that serve them
        then."""
        owners = 0
        for owner_id, parts in sub_routes.items():
            if dev_type in parts:
                old.remove_subscriptions(owner_id)
                del parts[dev_type]
                owners += 1
        for owner_id, parts in notif_routes.items():
            if dev_type in parts:
                old.remove_notif_subscriptions(owner_id)
                del parts[dev_type]
                owners += 1
        if owners > 0:
            _log.info("DeviceMgr: subscriptions move off the adapter",
                      {"adapter": dev_type, "owners": owners})

    def _part_tree_cb(merge: _MergedTrees, dev_type: str) -> action(?ygdata.Node, ?Exception) -> None:
        def deliver(tree: ?ygdata.Node, err: ?Exception) -> None:
            merge.deliver(dev_type, tree, err)
        return deliver

    def _part_synced(all_synced: _AllSynced, dev_type: str) -> action(str) -> None:
        def part_synced(owner_id: str) -> None:
            all_synced.part_synced(dev_type)
        return part_synced

    def _route_subscriptions(owner_id: str, fresh: bool) -> None:
        """Send an owner's subscription specs to the adapters that serve them.
        fresh is True when the owner declared again, and every part goes out.
        Otherwise only a changed route goes out again."""
        d = declared.get(owner_id)
        if d is not None:
            parts = routes.split_specs(d.want)
            old = sub_routes.get_def(owner_id, {})
            if not fresh and _same_parts(old, parts):
                return
            for t in old.keys():
                if t not in parts:
                    _adapter_of_type(t).remove_subscriptions(owner_id)
            _close_sub_merge(owner_id)
            sub_routes[owner_id] = parts
            if len(parts) == 1:
                for t, specs in parts.items():
                    _adapter_of_type(t).declare_subscriptions(owner_id, d.cb, specs, d.synced)
                return
            merge = _MergedTrees()
            merge.start(d.cb)
            sub_merges[owner_id] = merge
            synced = d.synced
            if synced is not None:
                all_synced = _AllSynced(owner_id, synced, list(parts.keys()))
                sub_synced[owner_id] = all_synced
                for t, specs in parts.items():
                    _adapter_of_type(t).declare_subscriptions(owner_id, _part_tree_cb(merge, t), specs, _part_synced(all_synced, t))
            else:
                for t, specs in parts.items():
                    _adapter_of_type(t).declare_subscriptions(owner_id, _part_tree_cb(merge, t), specs, None)

    def _close_sub_merge(owner_id: str) -> None:
        merge = sub_merges.pop(owner_id)
        if merge is not None:
            merge.close()
        s = sub_synced.pop(owner_id)
        if s is not None:
            s.close()

    def _route_notifs(owner_id: str, fresh: bool) -> None:
        """Send an owner's event notification specs to the adapters that serve
        them, like _route_subscriptions. Events go from each adapter straight
        to the owner."""
        d = notif_declared.get(owner_id)
        if d is not None:
            parts = routes.split_notif_specs(d.want)
            old = notif_routes.get_def(owner_id, {})
            if not fresh and _same_parts(old, parts):
                return
            for t in old.keys():
                if t not in parts:
                    _adapter_of_type(t).remove_notif_subscriptions(owner_id)
            _close_notif_synced(owner_id)
            notif_routes[owner_id] = parts
            if len(parts) == 1:
                for t, specs in parts.items():
                    _adapter_of_type(t).declare_notif_subscriptions(owner_id, d.cb, specs, d.synced)
                return
            synced = d.synced
            if synced is not None:
                all_synced = _AllSynced(owner_id, synced, list(parts.keys()))
                notif_synced[owner_id] = all_synced
                for t, specs in parts.items():
                    _adapter_of_type(t).declare_notif_subscriptions(owner_id, d.cb, specs, _part_synced(all_synced, t))
            else:
                for t, specs in parts.items():
                    _adapter_of_type(t).declare_notif_subscriptions(owner_id, d.cb, specs, None)

    def _close_notif_synced(owner_id: str) -> None:
        s = notif_synced.pop(owner_id)
        if s is not None:
            s.close()

    def _read_platform(mods: dict[str, ModCap]) -> None:
        """Start a new probe walk. An empty module set says nothing about the
        device, so the last values stay."""
        platform_gen += 1
        if len(mods) == 0:
            _log.debug("DeviceMgr: no modules, platform not read", {"device": name})
            return
        _probe_platform(platform_gen, type_probes + platform_probes, 0, mods, platform_retry_first)

    def read_platform() -> None:
        """Read the platform again on the current connection. SoftwareManager
        calls this after an install, which can change the release without a
        reconnect."""
        _read_platform(modset)

    def _end_platform_read() -> None:
        platform_read += 1

    def _probe_platform(gen: int, probes: list[PlatformProbe], start: int,
                        mods: dict[str, ModCap], retry: float) -> None:
        """Run the first probe in probes[start:] that applies to mods.

        gen is the connection the walk belongs to; retry is the delay before
        the probe runs again if its read fails.
        """
        if gen != platform_gen:
            return
        i = start
        while i < len(probes):
            fits = False
            try:
                fits = probes[i].applies(mods)
            except Exception as e:
                _log.error("DeviceMgr: platform probe failed to match",
                           {"device": name, "probe": probes[i].name, "error": e})
            if fits:
                break
            i += 1
        if i >= len(probes):
            _log.debug("DeviceMgr: no platform probe applies", {"device": name})
            _set_platform(None, None)
            return
        probe = probes[i]
        idx = i
        platform_read += 1
        step = platform_read

        def on_read(p: ?Platform, err: ?Exception) -> None:
            if gen != platform_gen or step != platform_read:
                # A reply from an earlier connection or read, or a second
                # call of done.
                return
            _end_platform_read()
            if isinstance(err, NotConnectedError):
                # The session dropped mid-read: the next connect reads again.
                return
            if isinstance(err, PlatformMismatch):
                _log.info("DeviceMgr: platform probe gave the device to the next one",
                          {"device": name, "probe": probe.name})
                _probe_platform(gen, probes, idx + 1, mods, platform_retry_first)
                return
            if p is not None and err is None:
                _set_platform(p, probe.name)
                return
            published = oper.state.platform.probe
            if published is not None and published != probe.name:
                # Values another probe read do not describe this device.
                _set_platform(None, None)
            details = {"device": name, "probe": probe.name,
                       "error": str(err) if err is not None else "no answer",
                       "retry_in": retry}
            if retry == platform_retry_first:
                _log.warning("DeviceMgr: platform read failed", details)
            else:
                _log.info("DeviceMgr: platform read failed again", details)
            after retry: _probe_platform(gen, probes, idx, mods, min([retry * 2.0, PLATFORM_RETRY_MAX]))

        try:
            probe.read(self, on_read)
        except Exception as e:
            on_read(None, e)

    def _set_platform(p: ?Platform, probe: ?str) -> None:
        """Publish the platform, on a change only. None clears it."""
        st = oper.state.platform
        os: ?str = None
        version: ?str = None
        model: ?str = None
        serial: ?str = None
        if p is not None:
            os = p.os
            version = p.version
            model = p.model
            serial = p.serial_number
        if st.os == os and st.version == version and st.model == model and st.serial_number == serial and st.probe == probe:
            return
        old_serial = st.serial_number
        if old_serial is not None and serial is not None and old_serial != serial:
            _log.warning("DeviceMgr: platform serial number changed",
                         {"device": name, "old": old_serial, "new": serial})
        _log.info("DeviceMgr: platform", {"device": name, "os": os, "version": version,
                                           "model": model, "serial_number": serial, "probe": probe})
        st.os = os
        st.version = version
        st.model = model
        st.serial_number = serial
        st.probe = probe
        update_oper()

    def set_platform_retry(secs: float) -> None:
        """Test hook."""
        platform_retry_first = secs

    def _build_adapter(device_type: DeviceType, adapter_dmc: DeviceMetaConfig, effective_mock: bool,
                       log_handler: logging.Handler,
                       report: action(dict[str, ModCap], ?SchemaKey) -> None) -> DeviceAdapter:
        """Build the adapter of a device type. In mock mode, an adapter that
        cannot mock is replaced by a MockAdapter that reports to report."""
        candidate = device_type.adapter_type(self, device_type.bundled_schema, adapter_dmc, schema_registry, log_handler, env)
        if effective_mock and not candidate.supports_mocking():
            return MockAdapter(report, device_type.bundled_schema, log_handler, env)
        return candidate

    def _extra_report(dev_type: str) -> action(dict[str, ModCap], ?SchemaKey) -> None:
        """The connect report of the MockAdapter of an extra adapter."""
        def report(mods: dict[str, ModCap], key: ?SchemaKey) -> None:
            self.on_connect(mods, key, dev_type)
        return report

    def _extra_log_handler(dev_type: str, level: int) -> logging.Handler:
        """The log handler of an extra adapter: a child of the device's
        handler, named after the device type."""
        h = extra_log_handlers.get(dev_type)
        if h is not None:
            return h
        child = logging.Handler(dev_type)
        child.set_handler(_log_handler)
        child.set_output_level(level)
        extra_log_handlers[dev_type] = child
        return child

    def _set_extra_adapter(t: str, device_type: DeviceType, view: DeviceMetaConfig, effective_mock: bool, old_effective_mock: bool, level: int) -> None:
        """Give the extra adapter of device type t its configuration, built
        first if it is new or cannot change mock mode."""
        existing = extra_adapters.get(t)
        if existing is not None:
            if old_effective_mock == effective_mock or existing.supports_mocking():
                existing.set_dmc(view)
                return
            _forget_adapter(t, existing)
            after 0: existing.close()
        built = _build_adapter(device_type, view, effective_mock, _extra_log_handler(t, level), _extra_report(t))
        _log.info("DeviceMgr.set_dmc: using extra adapter", {"device_type": t, "adapter": built})
        extra_adapters[t] = built
        extra_modules[t] = {}
        _set_connected(t, False)
        built.set_dmc(view)

    def _set_extra_adapters(new_dmc: DeviceMetaConfig, effective_mock: bool, old_effective_mock: bool, level: int) -> None:
        """Build, reconfigure and remove the extra adapters to match
        new_dmc.extra_adapter, in its order."""
        wanted: list[str] = []
        for e in new_dmc.extra_adapter:
            t = e.type
            if t == primary_type:
                _log.warning("DeviceMgr.set_dmc: the device type is not an extra adapter, ignored", {"device_type": t})
                continue
            device_type = dev_types.get(t)
            if device_type is not None:
                wanted.append(t)
                _set_extra_adapter(t, device_type, extra_adapter_dmc(new_dmc, e), effective_mock, old_effective_mock, level)
            else:
                _log.warning("DeviceMgr.set_dmc: extra adapter type not available in system", {"device_type": t})
        ordered: dict[str, DeviceAdapter] = {}
        for t, a in extra_adapters.items():
            if t in wanted:
                ordered[t] = a
            else:
                _log.info("DeviceMgr.set_dmc: removing extra adapter", {"device_type": t})
                _forget_adapter(t, a)
                if t in extra_modules:
                    del extra_modules[t]
                if t in extra_log_handlers:
                    del extra_log_handlers[t]
                if t != primary_type:
                    _drop_adapter_entry(t)
                after 0: a.close()
        extra_adapters = {}
        for t in wanted:
            a = ordered.get(t)
            if a is not None:
                extra_adapters[t] = a

    def _update_schema(primary: DeviceType) -> None:
        """Merge the bundled schemas of the adapters' device types into the
        device's bundled schema, when the device types changed."""
        types = _adapter_types()
        if types == schema_types:
            return
        schemas = [primary.bundled_schema]
        for t in extra_adapters.keys():
            dt = dev_types.get(t)
            if dt is not None:
                schemas.append(dt.bundled_schema)
        try:
            bundled_schema = merge_schemas(schemas)
        except ValueError as e:
            _log.error("DeviceMgr: the schemas of the adapters do not merge, using the primary's",
                       {"device": name, "error": str(e)})
            bundled_schema = primary.bundled_schema
        schema_types = types

    def set_dmc(new_dmc: DeviceMetaConfig) -> None:
        level = _device_log_level(new_dmc, _default_log_level)
        _log_handler.set_output_level(level)
        for h in extra_log_handlers.values():
            h.set_output_level(level)
        old_type = str(dmc.type) if dmc is not None else str(None)
        if debug_enabled():
            _log.debug("DeviceMgr.set_dmc", {"old_type": old_type, "new_dmc": dmc_for_log(new_dmc)})

        new_dmc_type = new_dmc.type
        if new_dmc_type is not None:
            device_type = dev_types.get(new_dmc_type)
            if device_type is not None:
                type_changed = old_type != str(new_dmc.type)
                effective_mock = system_mock or _is_mock_device(new_dmc)
                old_effective_mock = system_mock or _is_mock_device(dmc)
                mock_mode_changed = old_effective_mock != effective_mock

                # Same-type DMC changes belong to the existing adapter. In
                # particular, software intent is not transport lifecycle.
                # A replacement is needed only when the type changes, there is
                # no adapter yet, or mock mode changes and this adapter cannot
                # make that transition through set_dmc().
                need_new_adapter = \
                    type_changed or \
                    isinstance(adapter, NoAdapter) or \
                    (mock_mode_changed and not adapter.supports_mocking())

                # Hand the software manager its adapter and config. The
                # software adapter follows the same lifecycle as the device
                # adapter: rebuilt when the device type changes.
                if type_changed:
                    sw_type = device_type.software_adapter_type
                    if sw_type is not None:
                        swmgr.set_adapter(sw_type(self, new_dmc, _log_handler, env))
                sw = new_dmc.software
                sw_vetoes = {}
                for v in sw.veto:
                    sw_vetoes[v.holder] = str(v.reason)
                swmgr.set_config(sw.upgrade_campaign, sw.target_release, sw.allow_staging, sw_vetoes)

                if need_new_adapter:
                    new_adapter = _build_adapter(device_type, new_dmc, effective_mock, _log_handler,
                                                 lambda m, k: self.on_connect(m, k))
                    use_generic_mock_adapter = effective_mock and isinstance(new_adapter, MockAdapter)
                    _log.debug("DeviceMgr.set_dmc: switching adapter", {
                        "old_type": old_type,
                        "new_type": new_dmc.type,
                        "effective_mock": effective_mock,
                        "use_generic_mock_adapter": use_generic_mock_adapter
                    })
                    previous_adapter = adapter
                    adapter = new_adapter
                    _forget_adapter(primary_type, previous_adapter)
                    if primary_type != new_dmc_type:
                        _drop_adapter_entry(primary_type)
                    primary_type = new_dmc_type
                    _set_connected(primary_type, False)
                    # A probe read or retry on the old adapter is dropped.
                    platform_gen += 1
                    after 0: previous_adapter.close()
                    _log.info("DeviceMgr.set_dmc: using adapter", {"adapter": adapter})
                else:
                    use_generic_mock_adapter = effective_mock and isinstance(adapter, MockAdapter)
                    _log.debug("DeviceMgr.set_dmc: adapter unchanged", {
                        "type": new_dmc_type,
                        "effective_mock": effective_mock,
                        "use_generic_mock_adapter": use_generic_mock_adapter
                    })

                _set_extra_adapters(new_dmc, effective_mock, old_effective_mock, level)
                probes = device_type.platform_probes
                for t in extra_adapters.keys():
                    dt = dev_types.get(t)
                    if dt is not None:
                        probes = probes + dt.platform_probes
                type_probes = probes
                _update_schema(device_type)
                _update_routes()
            else:
                _log.warning("DeviceMgr.set_dmc: configured device type not available in system", {"device_type": new_dmc_type})
        else:
            _log.debug("DeviceMgr.set_dmc: no device type configured, not changing adapter")

        adapter.set_dmc(new_dmc)

        if dmc is not None and new_dmc is not None:
            old_dmcg = dmc.to_gdata()
            new_dmcg = new_dmc.to_gdata()
            if old_dmcg is not None and new_dmcg is not None:
                if ygdata.diff(old_dmcg, new_dmcg) is not None:
                    # Configuration that affects our behavior, like
                    # approval-required might have changed, so attempt to
                    # send the configuration again
                    after 0: _send_config()

        dmc = new_dmc
        _update_approval_state()


    def _complete_tids(tids: set[str]):
        """Dispatch and release the wait_complete callbacks for the given tids

        We also drop the config queue and reconf registrations beacuse at this
        point we're done - config was either applied or the device is already in
        sync.
        """
        for tid in tids:
            cb = callbacks.get(tid)
            if cb is not None:
                cb(True)
                del callbacks[tid]
            reconf_tids.discard(tid)
            del confq[tid]

    def _send_config():
        """Send configuration to the device adapter

        This function manages the transaction queue and calls the adapter's
        configure method with the current target configuration.
        """
        # Check if we already have a transaction in progress
        if len(current_tids) > 0:
            _log.debug("DeviceMgr._send_config: there is currently an outstanding configuration, skipping", {"current_tids": current_tids})
            return

        last_confq = None
        # Track which tids we'll process if we actually send config
        pending_tids = []
        # We want to grab as much approved configuration as possible. To be
        # considered, all items from the head of the queue must have an approval
        # status. Any item without an approval status stops the processing.
        # Note however how we skip past items that are rejected if a later item
        # is approved. This is initially surprising since we deal with
        # cumulative configurations, but it does make sense since the later
        # transaction might have negated the earlier rejected configuration.
        for id, ci in confq.items():
            if dmc.approval_required:
                ci_approved = ci.approved
                if ci_approved is not None:
                    if ci_approved:
                        pending_tids.append(ci.tid)
                        last_confq = ci.conf
                    else:
                        _log.debug("DeviceMgr._send_config: configuration not approved, skipping", {"confq_id": id, "tid": ci.tid})
                else:
                    _log.debug("DeviceMgr._send_config: configuration requires approval, stopping", {"confq_id": id, "tid": ci.tid})
                    break
            else:
                pending_tids.append(ci.tid)
                last_confq = ci.conf
        send_conf = last_confq if last_confq is not None else target_conf
        if dmc.approval_required:
            if len(pending_tids) > 0:
                # got work to do, pass and continue further
                pass
            else:
                if len(confq) > 0:
                    # there must be something pending approval
                    _log.debug("DeviceMgr._send_config: no pending work as config queue items pend approval")
                return

        def on_configured(error: ?Exception, resulting_config, new_diff):
            """Handle transaction completion

            This callback is called when the adapter finishes the configuration
            transaction, either successfully or with an error.
            """
            if error is not None:
                if isinstance(error, NotConnectedError):
                    _log.debug("Device not connected, no need to retry - waiting for reconnect")
                    current_tids = set()

                elif isinstance(error, PermanentError):
                    _log.debug("Permanent error pushing configuration to device", {"error": error})
                    if isinstance(error, ConfigError):
                        _log.debug("Configuration failed due to bad config", {"error": error})

                    # Got a permanent error, giving up
                    for tid in current_tids:
                        cb = callbacks.get(tid)
                        if cb is not None:
                            cb(error)
                            del callbacks[tid]

                    # TODO: uh, what else? we need to bubble up this sort of error state to an operator somehow

                    if len(confq) > len(current_tids):
                        _log.debug("New intended configuration available, retrying with latest config")
                        current_tids = set()
                        _send_config()
                    else:
                        _log.debug("No new intended configuration available, no point in retrying with same conf")
                        current_tids = set()

                elif isinstance(error, TransientError):
                    _log.debug("Transient error", {"error": error})
                    if isinstance(error, BusyError):
                        _log.debug("DeviceAdapter busy, ignoring this error as adapter will trigger us once it is done with current operation")
                        return
                    if isinstance(error, TxidMismatchError):
                        _log.debug("Device txid mismatch, re-syncing device")
                        # Clear approval state so we can re-approve the configuration
                        for tid in current_tids:
                            ci = confq.get(tid)
                            if ci is not None:
                                ci.approved = None
                        current_tids = set()
                        _update_approval_state()
                        resync()
                        return

                    if len(confq) > len(current_tids):
                        _log.debug("New intended configuration available, retrying with latest config")
                        current_tids = set()
                        _send_config()
                    else:
                        retry_in = 1
                        _log.debug("No new intended configuration available. Scheduling retry of current config", {"retry_in": retry_in})
                        current_tids = set()
                        after now retry_in: _send_config()

                else:
                    _log.debug("Unhandled error", {"error": error})
                    # Uh, this is indicative of programmer error and we should fix it, but let's do naive retry as well
                    current_tids = set()
                    after now 1: _send_config()

            else:
                _log.debug("Configuration successfully applied on device, calling callbacks...", {"current_tids": current_tids})
                # Since we successfuly sent the configuration from the confq to
                # the device, we updated target_conf so any later resync /
                # reconfigurations will use the latest target configuration
                target_conf = send_conf
                # The device adapters gives us back the resulting config on the
                # device, including an updated txid. We update our view of the
                # device's running to this new resulting config.
                running_conf = resulting_config

                conf_log.append(LogItem("sent", new_diff, None))
                for _ in range(max([0, len(conf_log)-20])):
                    del conf_log[0]

                last_sent_diff = new_diff
                _complete_tids(current_tids)
                current_tids = set()
                _update_approval_state()
                if len(confq) > 0:
                    _log.debug("Configuration changed during in-progress transaction, running again...")
                    _send_config()

        # Check if there is an actual diff right now
        if running_conf is not None and send_conf is not None:
            send_conf2 = config_fixer(running_conf, send_conf)
            send_diff = ygdata.diff(running_conf, send_conf2) if send_conf2 is not None else None
            all_tids = set(pending_tids)
            all_tids.update(reconf_tids)
            if send_diff is not None:
                if last_sent_diff is not None:
                    if send_diff == last_sent_diff:
                        _log.info("Reconciliation loop detected, target diff is same as last diff sent, stopping", {"diff": send_diff})
                        return
                # Actually send the configuration
                current_tids = all_tids
                _log.debug("DeviceMgr._send_config: sending intended target configuration", {"current_tids": current_tids, "diff": send_diff})
                # The resulting running view includes any platform-specific
                # preservation applied by config_fixer, while target_conf
                # remains the rendered intent in send_conf.
                adapter.configure(lambda e, c: on_configured(e, c, send_diff), send_diff, send_conf2!, running_conf)
            else:
                # No diff: the device already holds the intended config, so the
                # pending transactions and any reconf_tids are satisfied.
                _log.debug("DeviceMgr._send_config: no diff between running and target config, nothing to do", {"completed_tids": all_tids})
                _complete_tids(all_tids)
                _update_approval_state()
        else:
            if running_conf is None:
                _log.debug("No running config, cannot compute diff")
            if send_conf is None:
                _log.debug("No send config, cannot compute diff")

    def configure(new_conf: ?ygdata.Node, conf_modset_id: ?str, tid: str="0"):
        if new_conf is not None and conf_modset_id is not None:
            if conf_modset_id != modset_id:
                _log.debug("DeviceMgr.configure: modset_id mismatch, ignoring configuration", {"conf_modset_id": str(conf_modset_id), "modset_id": str(modset_id)})
                return
            if debug_enabled():
                _log.debug("DeviceMgr.configure: received new intended configuration", {"tid": tid, "new_conf": truncate_conf(new_conf)})
            confq[tid] = ConfigItem(tid, new_conf, modset_id)
            _update_approval_state()
            _send_config()
        elif new_conf is None and conf_modset_id is None:
            _log.debug("DeviceMgr.configure: transaction registered intent to configure but awaiting reconf", {"tid": tid})
            reconf_tids.add(tid)
        else:
            if debug_enabled():
                _log.debug("DeviceMgr.configure: invalid input", {"conf_modset_id": str(conf_modset_id), "new_conf": truncate_conf(new_conf), "tid": tid})

    def resync():
        """Ensure our view of the device running configuration is in sync with the real device

        Attempts to efficiently ensure we are in sync by using txid. If the
        device supports txid, we can avoid fetching the full config if the
        txid matches our cached version. If the device does not support txid,
        we have to fetch the full config and diff it against our cached version.
        """
        def on_fetch_config_done(new_conf: ?ygdata.Node, err: ?Exception) -> None:
            if err is not None:
                _log.error("Error fetching config from device", {"error": err})
            elif new_conf is not None:
                _log.debug()
                new_txid = new_conf.txid
                txid_updated = False
                running_conf_txid = None
                if running_conf is not None:
                    running_conf_txid = running_conf.txid
                    if running_conf_txid is not None:
                        if new_txid is not None:
                            if new_txid != running_conf_txid:
                                if debug_enabled():
                                    _log.debug("DeviceMgr._on_update_config: device txid changed", {"old_txid": running_conf_txid, "new_txid": new_txid, "conf": truncate_conf(new_conf)})
                                txid_updated = True
                            else:
                                _log.debug("DeviceMgr._on_update_config: device txid unchanged", {"txid": new_txid})
                        else:
                            _log.debug("DeviceMgr._on_update_config: txid not set in config from adapter, BUG?", {"conf": repr(new_conf)})
                    else:
                        _log.debug("DeviceMgr._on_update_config: txid not set in local config, BUG?", {"conf": repr(running_conf)})
                        txid_updated = True
                else:
                    _log.debug("DeviceMgr._on_update_config: no local running config, considered txid update", {"new_txid": new_txid})
                    txid_updated = True

                if txid_updated:
                    if running_conf != new_conf:
                        sync_diff = ygdata.diff(running_conf, new_conf)
                        conf_log.append(LogItem("Fetched configuration from device", sync_diff, None))
                        running_conf = new_conf

                        if dmc.approval_required and target_conf is not None:
                            _log.debug("DeviceMgr.wait_complete: device requires approval, adding new config item to queue")
                            conf_item = ConfigItem("resync", target_conf, modset_id)
                            new_confq = {conf_item.tid: conf_item}
                            for d, c in confq.items():
                                new_confq[d] = c
                            confq = new_confq
                            _update_approval_state()
                        else:
                            _log.debug("DeviceMgr._on_update_config: got new running config, reconfiguring device", {"new_txid": new_txid})
                            _send_config()
                    else:
                        _log.debug("DeviceMgr._on_update_config: got same config but with differing txid", {"new_txid": new_txid, "old_txid": running_conf_txid})
                        # The content is unchanged, but the fetched tree is now
                        # our verified baseline. Keep its txid and resume any
                        # work that was waiting for this resync.
                        running_conf = new_conf
                        if len(confq) > 0 or len(reconf_tids) > 0:
                            _send_config()

        _log.debug("DeviceMgr.resync: starting resync", {"local_device_txid": running_conf.txid if running_conf is not None else None})
        adapter.fetch_config(on_fetch_config_done)

    def wait_complete(tid: str, done: action(value) -> None):
        _log.debug("DeviceMgr.wait_complete: confq", {"confq": list(confq.keys())})
        if tid not in current_tids | set(confq.keys()) | reconf_tids:
            _log.debug("DeviceMgr.wait_complete: transaction id not found, calling done", {"tid": tid})
            done(True) # Assume tid is very old and has already completed, thus respond immediately
        else:
            _log.debug("DeviceMgr.wait_complete: waiting for transaction to complete", {"tid": tid})
            callbacks[tid] = done

    def get_capabilities():
        return adapter.get_capabilities()

    def subscription_method() -> str:
        return adapter.subscription_method()

    def subscription_status() -> SubscriptionStatus:
        return adapter.subscription_status()

    # TODO: use named fields in the tuple
    def get_modules() -> (dict[str, ModCap], ?str):
        return modset, modset_id

    def get_config():
        """Get the running config of the device, from the adapter which keeps a cached version of it

        Note how this doesn't actually reach out to the device, but only fetches
        a local copy. However, since it is in the adapter contract to keep the
        local view of the config up to date, this is mostly quite safe!
        """
        return adapter.get_config()

    def fetch_config(done: action(?ygdata.Node, ?Exception) -> None) -> None:
        """Fetch the current configuration from the device
        """
        adapter.fetch_config(done)

    def get_bundled_schema():
        return bundled_schema

    def get_fetched_schema():
        return schema_registry.get_schema(schema_key)

    def rpc(cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node):
        """Send an RPC to the adapter that serves its module."""
        _adapter_of_type(routes.rpc_adapter(gdata_rpc)).rpc(cb, gdata_rpc)

    def rpc_xml(cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node):
        """Send a raw RPC to the adapter that serves the namespace of its
        element, the primary when it has none."""
        _adapter_of_type(routes.rpc_xml_adapter(xml_rpc)).rpc_xml(cb, xml_rpc)

    def get(cb: action(?ygdata.Node, ?Exception) -> None, filt: ?ygdata.FNode=None):
        """Read device data once, narrowed by `filt`. The result may contain
        configuration, operational state, or both. Subscribe instead when the
        value is watched continuously.

        A filter across the modules of several adapters is split between them.
        The reply is the merge of theirs, or the first error."""
        parts = routes.split_filter(filt)
        if len(parts) == 1:
            for t, f in parts.items():
                _adapter_of_type(t).get(cb, f)
            return
        merged = _MergedGet(cb, len(parts))
        for t, f in parts.items():
            _adapter_of_type(t).get(merged.reply, f)

    def declare_subscriptions(owner_id: str, cb: action(?ygdata.Node, ?Exception) -> None, want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        """Declare an owner's full set of subscription specs. Specs across the
        modules of several adapters are split between them; the owner gets
        the merge of their trees, and synced when all of them are in place."""
        declared[owner_id] = (cb=cb, want=want, synced=synced)
        _route_subscriptions(owner_id, True)

    def remove_subscriptions(owner_id: str):
        if owner_id in declared:
            del declared[owner_id]
        parts = sub_routes.pop(owner_id)
        if parts is not None:
            for t in parts.keys():
                _adapter_of_type(t).remove_subscriptions(owner_id)
        _close_sub_merge(owner_id)

    def declare_notif_subscriptions(owner_id: str, cb: action(?NotifEvent, ?Exception) -> None, want: set[NotifSpec], synced: ?action(str) -> None=None):
        """Declare an owner's full desired set of event notification
        subscriptions (see DeviceAdapter.declare_notif_subscriptions). Specs
        are split between the adapters like subscription specs."""
        notif_declared[owner_id] = (cb=cb, want=want, synced=synced)
        _route_notifs(owner_id, True)

    def remove_notif_subscriptions(owner_id: str):
        if owner_id in notif_declared:
            del notif_declared[owner_id]
        parts = notif_routes.pop(owner_id)
        if parts is not None:
            for t in parts.keys():
                _adapter_of_type(t).remove_notif_subscriptions(owner_id)
        _close_notif_synced(owner_id)

    def notif_status() -> list[NotifChannelStatus]:
        """The open notification channels of all adapters."""
        channels: list[NotifChannelStatus] = []
        channels.extend(adapter.notif_status())
        for a in extra_adapters.values():
            channels.extend(a.notif_status())
        return channels

    def tree_provider() -> ygdata.TreeProvider:
        return DeviceTreeProvider(self)

    def get_adapter() -> DeviceAdapter:
        """The primary adapter."""
        return adapter

    def get_extra_adapter(dev_type: str) -> ?DeviceAdapter:
        """The extra adapter of a device type."""
        return extra_adapters.get(dev_type)

    def get_module_adapters() -> dict[str, str]:
        """The device type of the adapter that serves each module, by module
        name."""
        res: dict[str, str] = {}
        for mod_name, m in modset.items():
            res[mod_name] = routes.adapter_of(m.namespace)
        return res

    def list_confq():
        return confq

    def get_confq(id: str) -> (ci: ConfigItem, running_conf: ygdata.Node):
        _log.debug("DeviceMgr.get_confq: checking confq for id", {"id": id, "confq": list(confq.keys())})
        first_key = ""
        nxt = next(confq.keys())
        if isinstance(nxt, just):
            first_key = nxt.val
        else:
            raise ValueError("Configuration queue is empty")

        if id == first_key:
            if running_conf is not None:
                return (ci=confq[first_key], running_conf=running_conf)
            else:
                raise ValueError("No device running configuration available for diffing")

        # non-head item
        previous_ci = None
        for tid, ci in confq.items():
            if tid == id and previous_ci is not None:
                return (ci=confq[first_key], running_conf=previous_ci.conf)
            previous_ci = ci
        raise ValueError("No such configuration id ({id}) in queue")

    def set_confq_approval(id: str, device_txid: str, approved: bool):
        _log.debug("DeviceMgr.set_confq_approval: setting approval", {"id": id, "approved": approved})
        _log.debug("DeviceMgr.set_confq_approval: checking confq for id", {"id": id, "confq": list(confq.keys())})
        first_key = ""
        nxt = next(confq.keys())
        if isinstance(nxt, just):
            first_key = nxt.val
        else:
            raise ValueError("Configuration queue is empty")
        if id != first_key:
            raise ValueError("Configuration id not at head of queue")

        if device_txid != get_device_txid():
            raise ValueError("Device txid does not match current device txid")

        if approved:
            _log.debug("DeviceMgr.set_confq_approval: approving configuration", {"id": id})
            ci = confq[first_key]
            ci.approved = True
        else:
            # TODO: ideally we would allow setting approval on non-head items.
            # Each non-head item woud be presented as a diff between the
            # previous item in the queue and that item. This is valid as long as
            # the previous items get approved and applied without txid
            # mismatches. If we get a txid mismatch, we have to clear all
            # pending items as any approval is basically voided. I think we need
            # a log of events on each ConfigItem to convey this to the user
            # though, otherwise it is too confusing that an approved item suddenly
            # goes back to unapproved.
            _log.debug("DeviceMgr.set_confq_approval: rejecting configuration", {"id": id})
            # Notify synchronous requests (wait_complete)
            cb = callbacks.get(first_key)
            if cb is not None:
                cb(Exception("configuration rejected"))
                del callbacks[first_key]
            del confq[first_key]
        _update_approval_state()
        if approved:
            _send_config()

    def get_pending_approvals() -> dict[str, ConfigItem]:
        """Get list of configuration items in approval queue

        Returns all items in the queue when approval is required.
        This includes pending (None), approved (True), and rejected (False) items.
        """
        if dmc.approval_required:
            return confq
        return {}

    def get_conf_log():
        return conf_log
