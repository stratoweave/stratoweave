"""NETCONF framing integration tests."""

import logging
import testing
import std.xml as xml

from pipe import Pipe
import netconf


class FragmentingPipe(Pipe):
    """Split every write into fixed-size reads before forwarding it."""
    pipe: Pipe
    chunk_size: int

    def __init__(self, pipe: Pipe, chunk_size: int):
        if chunk_size <= 0:
            raise ValueError("Fragment size must be positive")
        self.pipe = pipe
        self.chunk_size = chunk_size

    proc def write(self, data: bytes) -> None:
        for start in range(0, len(data), self.chunk_size):
            self.pipe.write(data[start:start + self.chunk_size])

    proc def read_cb(self, cb: action(?Exception, ?bytes) -> None) -> None:
        self.pipe.read_cb(cb)

    proc def close(self, on_close: ?action() -> None) -> None:
        self.pipe.close(on_close)

    proc def restart(self) -> None:
        self.pipe.restart()


def data_reply(value: str) -> list[xml.Node]:
    return [xml.Node("data", [(None, netconf.NS_NC_1_0)], children=[
        xml.Node("value", text=value)
    ])]


def reply_value(result: ?xml.Node) -> ?str:
    if result is not None:
        for rpc_child in result.children:
            if rpc_child.tag == "data":
                for data_child in rpc_child.children:
                    if data_child.tag == "value":
                        return data_child.text
    return None


actor _test_client_server_actor_pipe_fragmented_get(t: testing.EnvT):
    """Legacy hello and chunked RPC framing survive one-byte transport reads."""
    pipes = netconf.actor_pipe_pair()
    client_pipe = FragmentingPipe(pipes.client, 1)
    server_pipe = FragmentingPipe(pipes.server, 1)
    var done = False

    def finish(error: ?Exception) -> None:
        if done:
            return
        done = True
        if error is not None:
            t.failure(error)
        else:
            t.success()

    def on_server_rpc(s: netconf.Server, message_id: str, op: xml.Node) -> None:
        if op.tag != "get":
            finish(ValueError("Unexpected fragmented RPC operation: {op.tag}"))
            return
        s.send_reply(message_id, data_reply("fragmented"))

    def on_get(c: netconf.Client, result: ?xml.Node,
               error: ?netconf.NetconfError) -> None:
        if error is not None:
            finish(error)
        elif reply_value(result) != "fragmented":
            finish(ValueError("Unexpected fragmented rpc-reply"))
        else:
            c.close(None)
            finish(None)

    def on_connect(c: netconf.Client, error: ?Exception) -> None:
        if error is not None:
            finish(error)
        else:
            c.get(on_get)

    def on_timeout() -> None:
        finish(ValueError("Timed out waiting for fragmented NETCONF <get>"))

    after 2.0: on_timeout()
    server = netconf.Server(pipe=server_pipe, on_rpc=on_server_rpc,
                            log_handler=t.log_handler)
    client = netconf.Client(None,
                            address="fragmented-actor-pipe",
                            username="fragmented-actor-pipe",
                            key=None,
                            password=None,
                            port=0,
                            on_connect=on_connect,
                            on_notif=None,
                            log_handler=t.log_handler,
                            pipe=client_pipe)


SERVER_HELLO_1_1: bytes = ("<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
                           + "<hello xmlns=\"urn:ietf:params:xml:ns:netconf:base:1.0\"><capabilities>"
                           + "<capability>urn:ietf:params:netconf:base:1.0</capability>"
                           + "<capability>urn:ietf:params:netconf:base:1.1</capability>"
                           + "</capabilities><session-id>1</session-id></hello>]]>]]>").encode()


def chunked(message: str) -> bytes:
    body = message.encode()
    return ("\n#" + str(len(body)) + "\n").encode() + body + "\n##\n".encode()


actor _test_client_holds_rpcs_until_server_hello(t: testing.EnvT):
    """An RPC requested before the server's hello goes out after it, chunked.

    The server switches to chunked framing once it has read the client's
    hello. An RPC the client sent in base:1.0 framing after its hello, but
    before the server's hello arrived, broke the server's framing.
    """
    pipes = netconf.actor_pipe_pair()
    var received: bytes = b""
    var hello_sent = False
    var done = False

    def finish(error: ?Exception) -> None:
        if done:
            return
        done = True
        if error is not None:
            t.failure(error)
        else:
            t.success()

    def on_get(c: netconf.Client, result: ?xml.Node,
               error: ?netconf.NetconfError) -> None:
        if error is not None:
            finish(error)
        elif reply_value(result) != "held":
            finish(ValueError("Unexpected rpc-reply"))
        else:
            finish(None)

    def on_connect(c: netconf.Client, error: ?Exception) -> None:
        if error is not None:
            finish(error)

    client = netconf.Client(None,
                            address="actor-pipe",
                            username="actor-pipe",
                            key=None,
                            password=None,
                            port=0,
                            on_connect=on_connect,
                            on_notif=None,
                            log_handler=t.log_handler,
                            pipe=pipes.client)
    client.get(on_get)

    def on_server_data(error: ?Exception, data: ?bytes) -> None:
        if error is not None:
            finish(error)
            return
        if data is not None:
            received = received + data
        else:
            return
        end_of_hello = received.find(netconf.LEGACY_SEPARATOR)
        if end_of_hello < 0:
            return
        hello = received[:end_of_hello]
        if hello.find(b"<rpc") >= 0 or hello.find(b"<hello") < 0:
            finish(ValueError("The client did not start with its hello: {hello.decode()}"))
            return
        if not hello_sent:
            hello_sent = True
            # The client handles the get before this call returns
            caps = client.get_capabilities()
            if len(caps) > 0:
                finish(ValueError("The client has capabilities before the server's hello"))
                return
            pipes.server.write(SERVER_HELLO_1_1)
            return
        rest = received[end_of_hello + len(netconf.LEGACY_SEPARATOR):]
        if len(rest) < 2:
            return
        if not rest.startswith(netconf.CHUNK_TAG_PREFIX):
            finish(ValueError("The client sent an RPC in base:1.0 framing: {rest.decode()}"))
            return
        if rest.find(b"\n##\n") >= 0:
            pipes.server.write(chunked(
                "<rpc-reply xmlns=\"urn:ietf:params:xml:ns:netconf:base:1.0\" message-id=\"1\">"
                + "<data><value>held</value></data></rpc-reply>"))

    def on_timeout() -> None:
        finish(ValueError("Timed out waiting for the held RPC"))

    pipes.server.read_cb(on_server_data)
    after now 2.0: on_timeout()


class _ErrorSink(logging.Sink):
    """Count error messages per actor class and text."""
    counter: _ErrorCount

    def __init__(self, counter: _ErrorCount):
        self.formatter = logging.DefaultFormatter()
        self.counter = counter

    proc def handle(self, m: logging.Message):
        msg = m.msg
        if m.level <= logging.ERR and msg is not None:
            self.counter.add(m.actor_class + ": " + msg)


actor _ErrorCount():
    """Count errors."""
    var counts: dict[str, int] = {}

    def add(key: str) -> None:
        if key in counts:
            counts[key] += 1
        else:
            counts[key] = 1

    def get() -> dict[str, int]:
        return counts


def _error_handler(counter: _ErrorCount) -> logging.Handler:
    h = logging.Handler("framing")
    h.set_output_level(logging.ERR)
    h.add_sink(_ErrorSink(counter))
    return h


actor _test_client_coalesces_back_to_back_restarts(t: testing.EnvT):
    """Two restarts in a row start one session.

    Each restart of an actor pipe gives one connected event. When the second
    restart came before the first connected event, the client sent a hello on
    each of them, and the server read the second hello as broken chunked data.
    """
    pipes = netconf.actor_pipe_pair()
    errors = _ErrorCount()
    log_handler = _error_handler(errors)
    var restarted = False
    var done = False

    def finish(error: ?Exception) -> None:
        if done:
            return
        done = True
        if error is not None:
            t.failure(error)
        else:
            t.success()

    def on_server_rpc(s: netconf.Server, message_id: str, op: xml.Node) -> None:
        s.send_reply(message_id, data_reply("restarted" if restarted else "first"))

    def on_get(c: netconf.Client, result: ?xml.Node,
               error: ?netconf.NetconfError) -> None:
        if error is not None:
            finish(error)
        elif not restarted:
            restarted = True
            c.restart()
            c.restart()
        elif reply_value(result) != "restarted":
            finish(ValueError("Unexpected rpc-reply after the restarts"))
        else:
            counts = errors.get()
            if len(counts) > 0:
                finish(ValueError("Errors logged: {counts}"))
            else:
                finish(None)

    def on_connect(c: netconf.Client, error: ?Exception) -> None:
        if error is not None:
            finish(error)
        else:
            c.get(on_get)

    def on_timeout() -> None:
        finish(ValueError("Timed out after two restarts, errors logged: {errors.get()}"))

    server = netconf.Server(pipe=pipes.server, on_rpc=on_server_rpc,
                            log_handler=log_handler)
    client = netconf.Client(None,
                            address="actor-pipe",
                            username="actor-pipe",
                            key=None,
                            password=None,
                            port=0,
                            on_connect=on_connect,
                            on_notif=None,
                            log_handler=log_handler,
                            pipe=pipes.client)
    after now 2.0: on_timeout()


actor _test_client_keeps_message_ids_across_restarts(t: testing.EnvT):
    """A late reply from the session before a restart does not answer a new RPC.

    The server accepts a reply for the RPC that it runs. When the client
    numbered the RPCs of each session from 1, a late reply to RPC 1 of the
    session before answered RPC 1 of the new session.
    """
    pipes = netconf.actor_pipe_pair()
    var client: ?netconf.Client = None
    var held_id: ?str = None
    var connects = 0
    var done = False

    def finish(error: ?Exception) -> None:
        if done:
            return
        done = True
        if error is not None:
            t.failure(error)
        else:
            t.success()

    def on_first(c: netconf.Client, result: ?xml.Node,
                 error: ?netconf.NetconfError) -> None:
        if not isinstance(error, netconf.SessionClosedError):
            finish(ValueError("Expected a SessionClosedError, got {error}"))

    def on_second(c: netconf.Client, result: ?xml.Node,
                  error: ?netconf.NetconfError) -> None:
        if error is not None:
            finish(error)
        elif reply_value(result) != "fresh":
            finish(ValueError("The new RPC got the reply of the session before"))
        else:
            finish(None)

    def on_server_rpc(s: netconf.Server, message_id: str, op: xml.Node) -> None:
        old = held_id
        if old is not None:
            # The late reply to the RPC of the session before comes first
            s.send_reply(old, data_reply("stale"))
            s.send_reply(message_id, data_reply("fresh"))
            return
        held_id = message_id
        cl = client
        if cl is not None:
            cl.restart()

    def on_connect(c: netconf.Client, error: ?Exception) -> None:
        if error is not None:
            finish(error)
            return
        connects += 1
        client = c
        if connects == 1:
            c.get(on_first)
        else:
            c.get(on_second)

    def on_timeout() -> None:
        finish(ValueError("Timed out waiting for the reply after the restart"))

    server = netconf.Server(pipe=pipes.server, on_rpc=on_server_rpc,
                            log_handler=t.log_handler)
    netconf.Client(None,
                   address="actor-pipe",
                   username="actor-pipe",
                   key=None,
                   password=None,
                   port=0,
                   on_connect=on_connect,
                   on_notif=None,
                   log_handler=t.log_handler,
                   pipe=pipes.client)
    after now 2.0: on_timeout()
