"""ArcOS platform probe.

It applies to a device that lists arcos-openconfig-system-augments. One get
reads system/version/state, which 'show version' prints from: the platform,
the serial number and the release. The device type's schema must have the
pruned YANG in adapters.platform_arcos_yang, or the real modules.

The OpenConfig chassis component of an ArcOS container has no part or serial
number, so the probe does not read it.
"""

import yang.gdata as ygdata

import device as swdev
import adapters.platform_arcos_oper as arcosoper
from adapters.adapter import ModCap

OS = "arcos"
MODULE = "arcos-openconfig-system-augments"


def platform_filter() -> ygdata.FNode:
    """Select the platform, the serial number and the release."""
    st = arcosoper.subs.system.version.state
    return st.subscribe(select=[st.platform, st.serial_number, st.sw_version]).filt!


def platform(root: ?ygdata.Node) -> ?swdev.Platform:
    """Return the platform in a reply, or None when the reply has neither a
    release nor a platform."""
    st = arcosoper.root.from_gdata(root).system.version.state
    version = swdev.nonempty(st.sw_version)
    model = swdev.nonempty(st.platform)
    serial = swdev.nonempty(st.serial_number)
    if version is None and model is None:
        return None
    return swdev.Platform(OS, version, model, serial)


class ArcOsProbe(swdev.GetPlatformProbe):
    """The ArcOS probe. One get per read."""
    def __init__(self):
        self.name = OS
        self.filt = platform_filter()

    def applies(self, modset: dict[str, ModCap]) -> bool:
        return MODULE in modset

    def parse(self, root: ?ygdata.Node) -> ?swdev.Platform:
        return platform(root)


PROBE = ArcOsProbe()
