#
# IOS XE software adapter.
#
# IOS XE workflow:
#
#   prepare  = make sure that the device has the image       non-impacting
#   install  = prepare again, add the image unless the
#              device has added it, then activate it with
#              an auto-abort timer; the device reloads       impacting
#   commit   = install-commit, stops the timer
#   rollback = abort; the device reloads on the old release  impacting
#
# Without a commit the device reverts on its own when the timer runs out.
#
# Prepare and install can run again at any time and do only what is left. A
# release that the device has added needs no image file. An image file on
# bootflash that passes a check stays: the checksum of the software intent,
# else the signature that the image holds, both with the verify RPC of the
# IOS XE CLI adapter. A missing file, or one that fails, is transferred with
# xcopy and checked again. Without the CLI adapter, prepare transfers the
# file and install trusts what prepare staged.
#
# Cleanup and retry are not implemented. Cleanup leaves the previous image on
# the device.
#
# Install RPCs are asynchronous. An <ok/> reply means accepted, not complete.
# The adapter polls operational state for completion.
#
# See src/adapters/test_software_iosxe.act for the device side, mocked.
#

import logging
import time

import yang.gdata as ygdata

import device as swdev
import adapters.iosxe_cli_data as xecli_data
import adapters.iosxe_cli_yang as xecli_yang
import adapters.software_iosxe_oper as ixoper
import adapters.software_iosxe_rpc as ixrpc

from device_meta_config import stratoweave_rfs__device_entry as DeviceMetaConfig

# install-oper op-status. MARKED_SUCC means the device had nothing to do, which
# is not confirmation that what we asked for happened -- but it is not a failure
# either. FAIL_REVERT means the device is undoing the operation.
OP_SUCC = "install-op-succ"
OP_MARKED_SUCC = "install-op-marked-succ"
OP_FAIL_REVERT = "install-op-fail-revert"
# install-oper op-done.
OP_COMPLETE = "op-complete"
OP_REVERTED = "op-reverted"
# install-oper txn-status of a transaction that did not succeed.
TXN_FAIL = "install-txn-sts-fail"
TXN_FAILED = [TXN_FAIL, "install-txn-sts-dep-fail", "install-txn-sts-timeout",
              "install-txn-sts-cancel", "install-txn-sts-op-timeout",
              "install-txn-sts-disconnect"]
# txn-sub-state when the device says nothing more.
SUB_STATE_NONE = "none"

# The stage that ends each records-polled job. A pure file copy really does
# report through the install records.
STAGE_DOWNLOAD = "install-txn-download"
STAGE_ADD_END = "install-txn-add-postchk"

POLL_PERIOD = 10.0
RELOAD_POLL_PERIOD = 20.0
# Seconds that staging waits for adapters that are not connected, such as an
# IOS XE CLI adapter that connects after NETCONF. Without them the plan
# lacks their steps: without the CLI, the image cannot be checked, so it is
# transferred again.
ADAPTER_WAIT = 120.0
ADAPTER_POLL = 5.0
# Generous: the transfer and the add each take minutes.
MAX_POLLS = 180

# Minutes the device waits for install-commit after activation before it
# reverts. 30 is the smallest value it accepts.
AUTO_ABORT_TIMER_MIN = 30
# Reload polls stop a little past the abort timer: by then the device has
# reverted and the release we wait for cannot appear. Roughly (30 + 5) minutes
# over the 20 s reload poll period.
VERSION_MAX_POLLS = (AUTO_ABORT_TIMER_MIN + 5) * 3


#############################################################################
# Pure: version handling
#
# The device spells one release three ways -- the operator writes 17.18.03a, the
# banner says 17.18.3a, the inventory says 17.18.03a.0.5540 -- so none of this
# can be a string compare.
#############################################################################

DIGITS = "0123456789"


def _split_component(c: str) -> (num: ?int, suffix: str):
    """Split a version component into its leading number and any suffix, so
    "03a" becomes (3, "a")."""
    digits = ""
    i = 0
    while i < len(c) and c[i] in DIGITS:
        digits += c[i]
        i += 1
    num = None
    if len(digits) > 0:
        num = int(digits)
    return (num=num, suffix=c[i:])


def _component_eq(a: str, b: str) -> bool:
    sa = _split_component(a)
    sb = _split_component(b)
    an = sa.num
    bn = sb.num
    if an is not None and bn is not None:
        return an == bn and sa.suffix == sb.suffix
    return a == b


def releases_equal(a: ?str, b: ?str) -> bool:
    """Compare two release names per component, not as strings.

    The device reports 17.18.3a where the image file says 17.18.03a, so a string
    comparison declares a successful upgrade a failure.
    """
    if a is None:
        return False
    if b is None:
        return False
    ap = a!.split(".")
    bp = b!.split(".")
    if len(ap) != len(bp):
        return False
    i = 0
    while i < len(ap):
        if not _component_eq(ap[i], bp[i]):
            return False
        i += 1
    return True


def release_from_filename(filename: str) -> ?str:
    """The release an image file is named for, or None.

    The mock reports whatever image it installed, and a campaign may target any
    catalogue release, so the release has to come out of the file name:
    c8000v-universalk9.17.18.03a.SPA.bin gives 17.18.03a. It is the run of
    dot-separated components that start with a digit, whatever the platform
    prefix and the suffix are; fewer than two such components is no release.
    """
    run: list[str] = []
    for part in filename.split("."):
        if len(part) > 0 and part[0] in DIGITS:
            run.append(part)
        elif len(run) > 0:
            break
    if len(run) < 2:
        return None
    return ".".join(run)


def reported_release(release: str) -> str:
    """How the device banner spells a release: leading zeros dropped from each
    component, so 17.18.03a becomes 17.18.3a. Equal to the input under
    releases_equal."""
    out: list[str] = []
    for c in release.split("."):
        s = _split_component(c)
        n = s.num
        if n is not None:
            out.append(str(n!) + s.suffix)
        else:
            out.append(c)
    return ".".join(out)


def running_release(root: ?ygdata.Node) -> ?str:
    """The release the device reports running, from device-hardware-oper
    over NETCONF, or from show version over the CLI.

    The NETCONF leaf carries a whole banner line, so pull the version out of
    it. The CLI release is spelled as the banner spells it: 17.15.6 for
    17.15.06.
    """
    oper = ixoper.root.from_gdata(root)
    hardware = oper.device_hardware_data.device_hardware
    text = hardware.device_system_data.software_version
    if text is None:
        cli = xecli_data.root.from_gdata(root).version.version
        return reported_release(cli) if cli is not None else None
    # "Cisco IOS XE Software, Version 17.18.02" -> "17.18.02"
    marker = "Version "
    body = text!
    idx = body.find(marker)
    if idx < 0:
        return body
    rest = body[idx + len(marker):]
    end = rest.find(",")
    if end >= 0:
        rest = rest[:end]
    return rest.strip()


#############################################################################
# Pure: operation records
#############################################################################

def failure_cause(status: str, txns: list[(cmd: str, status: str, sub_state: str)]) -> str:
    """Why an operation failed, as far as the device says: the sub-state of the
    first failed transaction, else its command and status, else the operation
    status. The first, because the device records a notify transaction
    after the one that failed."""
    for t in txns:
        if t.status in TXN_FAILED:
            if t.sub_state != "" and t.sub_state != SUB_STATE_NONE:
                return t.sub_state
            return "{t.cmd}: {t.status}"
    return status


def _txn(cmd: ?str, status: ?str, sub_state: ?str) -> (cmd: str, status: str, sub_state: str):
    return (cmd=cmd! if cmd is not None else "",
            status=status! if status is not None else "",
            sub_state=sub_state! if sub_state is not None else "")


def _record_of(status: ?str, done: ?str,
               txns: list[(cmd: str, status: str, sub_state: str)]) -> (status: str, done: str,
                                                                        stages: list[str], cause: str):
    st = status! if status is not None else ""
    stages: list[str] = []
    for t in txns:
        if t.cmd != "":
            stages.append(t.cmd)
    return (status=st, done=done! if done is not None else "", stages=stages,
            cause=failure_cause(st, txns))


def records_for(root: ?ygdata.Node, uuid: str) -> list[(status: str,
                                                        done: str,
                                                        stages: list[str],
                                                        cause: str)]:
    """Every record carrying this uuid, live and historical.

    Both lists, because a record moves from install-oper to install-oper-hist
    when it finishes and the move can happen between two polls. Both
    transaction lists of each, because a record keeps its transactions in
    install-txn-sum-op-hist once complete, also while still in install-oper.
    """
    out: list[(status: str, done: str, stages: list[str], cause: str)] = []
    iod = ixoper.root.from_gdata(root).install_oper_data
    for e in iod.install_oper:
        if e.op_uuid != uuid:
            continue
        txns: list[(cmd: str, status: str, sub_state: str)] = []
        for t in e.install_txn_summary_op:
            txns.append(_txn(t.txn_cmd, t.txn_status, t.txn_sub_state))
        for t in e.install_txn_sum_op_hist:
            txns.append(_txn(t.txn_cmd, t.txn_status, t.txn_sub_state))
        out.append(_record_of(e.op_status, e.op_done, txns))
    for e in iod.install_oper_hist:
        if e.op_uuid != uuid:
            continue
        txns = []
        for t in e.install_txn_summary_op:
            txns.append(_txn(t.txn_cmd, t.txn_status, t.txn_sub_state))
        for t in e.install_txn_sum_op_hist:
            txns.append(_txn(t.txn_cmd, t.txn_status, t.txn_sub_state))
        out.append(_record_of(e.op_status, e.op_done, txns))
    return out


def aggregate(root: ?ygdata.Node, uuid: str, expect_stage: str,
              allow_noop: bool=True) -> (done: bool, failed: bool, detail: str):
    """Return completion and failure state for an operation UUID.

    Completion requires terminal records and the expected final stage. A later
    record may not have appeared yet even when all current records succeeded.
    An empty `expect_stage` skips that wait, for operations with one record.
    With `allow_noop` False, `install-op-marked-succ` is a failure: the device
    found nothing to do. A failure's detail is the device's cause.
    """
    recs = records_for(root, uuid)
    if len(recs) == 0:
        return (done=False, failed=False, detail="no records yet")
    saw_end = False
    for r in recs:
        if r.done == OP_REVERTED or r.status == OP_FAIL_REVERT:
            return (done=True, failed=True, detail="operation reverted: {r.cause}")
        finished = r.done == OP_COMPLETE
        if finished and r.status == OP_MARKED_SUCC and not allow_noop:
            return (done=True, failed=True, detail="nothing to do: {r.status}")
        if finished and r.status != OP_SUCC and r.status != OP_MARKED_SUCC:
            return (done=True, failed=True, detail=r.cause)
        if not finished:
            return (done=False, failed=False, detail="still running")
        for s in r.stages:
            if s == expect_stage:
                saw_end = True
    if expect_stage != "" and not saw_end:
        return (done=False, failed=False, detail="waiting for {expect_stage}")
    return (done=True, failed=False, detail="")


#############################################################################
# Pure: the plan for a device
#
# How each step runs depends on what the device has, not on its release:
# the modules that its adapters report. The IOS XE CLI adapter reports its
# own module, stratoweave-iosxe-cli. See the table in adapters.iosxe_cli.
#############################################################################

HARDWARE_MODULE = "Cisco-IOS-XE-device-hardware-oper"
XCOPY_MODULE = "Cisco-IOS-XE-xcopy-rpc"
INSTALL_MODULE = "Cisco-IOS-XE-install-rpc"
FILES_MODULE = "Cisco-IOS-XE-platform-software-oper"
CISCO_RPC_MODULE = "Cisco-IOS-XE-rpc"
## Causes of a failed add that say that the image file is bad. The driver
## deletes the file, so that the next run transfers it again.
BAD_IMAGE_CAUSES = ["install-verify-pkg-fail", "install-status-invalid-image-file"]
FILES_NS = "http://cisco.com/ns/yang/Cisco-IOS-XE-platform-software-oper"


def upgrade_plan(modules: set[str]) -> (check: str, transfer: str, listing: str, verify: str, install: str, delete: str):
    """Return how each step of an upgrade runs on a device with these modules:
    "netconf", "cli", or "" when the driver cannot run the step there. A step
    runs over NETCONF when the device has the module for it, and over the CLI
    only when it has not, as on IOS XE 16.8 without NETCONF. No NETCONF
    module checks a file's content, so the check of an image runs over the
    CLI. check reads the running release, install also reads the versions
    that the device has."""
    cli = "cli" if xecli_yang.MODULE in modules else ""
    check = "netconf" if HARDWARE_MODULE in modules else cli
    transfer = "netconf" if XCOPY_MODULE in modules else cli
    listing = "netconf" if FILES_MODULE in modules else cli
    install = "netconf" if INSTALL_MODULE in modules else cli
    delete = "netconf" if CISCO_RPC_MODULE in modules else cli
    return (check=check, transfer=transfer, listing=listing, verify=cli, install=install, delete=delete)


def usable_checksum(checksums: list[(algorithm: str, digest: str)]) -> ?(algorithm: str, digest: str):
    """Return a checksum that IOS XE can compute, sha512 before md5. IOS XE
    verify has no sha256."""
    for algorithm in ["sha512", "md5"]:
        for c in checksums:
            if c.algorithm == algorithm:
                return c
    return None


def staged_file(root: ?ygdata.Node, filename: str) -> bool:
    """Return True if the files of bootflash: in root have filename, in a
    listing over NETCONF or over the CLI."""
    for q in ixoper.root.from_gdata(root).cisco_platform_software.q_filesystem:
        p = q.partitions.get("bootflash:")
        if p is not None and p.partition_content.get("/bootflash/" + filename) is not None:
            return True
    fs = xecli_data.root.from_gdata(root).file_systems.file_system.get("bootflash:")
    if fs is not None:
        return fs.file.get(filename) is not None
    return False


def free_space(root: ?ygdata.Node) -> ?u64:
    """Return the free bytes of bootflash: in root, from a listing over
    NETCONF, which counts in KiB, or over the CLI. None when the listing has
    no sizes."""
    for q in ixoper.root.from_gdata(root).cisco_platform_software.q_filesystem:
        p = q.partitions.get("bootflash:")
        if p is not None:
            total = p.total_size
            used = p.used_size
            if total is not None and used is not None and total >= used:
                return (total - used) * u64(1024)
    fs = xecli_data.root.from_gdata(root).file_systems.file_system.get("bootflash:")
    if fs is not None:
        return fs.free
    return None


def room_needed(image_size: ?u64) -> ?u64:
    """Return the free space that the transfer and the add of an image need,
    or None without an image size. The add unpacks the image into packages
    next to it: on a C1111 the packages of 17.15.06 take 807 MB, 1.1 times
    the 735 MB image. So the room is 2.2 times the image."""
    if image_size is not None:
        return image_size * u64(11) // u64(5)
    return None


def staged_size(root: ?ygdata.Node, filename: str) -> ?u64:
    """Return the size of filename on bootflash: in root, from a listing
    over NETCONF or over the CLI, or None when the listing has no size for
    it."""
    for q in ixoper.root.from_gdata(root).cisco_platform_software.q_filesystem:
        p = q.partitions.get("bootflash:")
        if p is not None:
            f = p.partition_content.get("/bootflash/" + filename)
            if f is not None:
                return f.size
    fs = xecli_data.root.from_gdata(root).file_systems.file_system.get("bootflash:")
    if fs is not None:
        c = fs.file.get(filename)
        if c is not None:
            return c.size
    return None


def bootflash_filter(listing: str) -> ygdata.FNode:
    """Select the files of bootflash: over NETCONF, from
    Cisco-IOS-XE-platform-software-oper, or over the CLI."""
    if listing == "netconf":
        f = lambda name: ygdata.Id(FILES_NS, name)
        return ygdata.FNode(children=[ygdata.FNode(f("cisco-platform-software"), children=[
            ygdata.FNode(f("q-filesystem"), children=[
                ygdata.FNode(f("partitions"), children=[ygdata.FNode(f("name"), value_match="bootflash:")])])])])
    q = lambda name: ygdata.Id(xecli_yang.NS, name)
    return ygdata.FNode(children=[ygdata.FNode(q("file-systems"), children=[
        ygdata.FNode(q("file-system"), children=[ygdata.FNode(q("name"), value_match="bootflash:")])])])


#############################################################################
# Pure: filters and RPC bodies
#############################################################################

def version_filter() -> ygdata.FNode:
    """Select the running software version."""
    paths = ixoper.subs.device_hardware_data.device_hardware.device_system_data
    return paths.software_version.filt()!


def cli_filter(top: str) -> ygdata.FNode:
    """Select one top-level node of the CLI adapter's module, such as
    version for show version or install-summary for show install
    summary."""
    return ygdata.FNode(children=[ygdata.FNode(ygdata.Id(xecli_yang.NS, top))])


def records_filter() -> ygdata.FNode:
    """Select the active and finished operation lists.

    Selecting complete lists avoids `ygdata.filter`'s keyless-list bug while
    excluding large siblings such as `install-packages`.
    """
    # TODO: Select only the required leaves after acton-yang preserves every
    # keyless-list entry and an empty selected list no longer drops matching
    # sibling data.
    paths = ixoper.subs.install_oper_data
    return paths.subscribe(select=[paths.install_oper,
                                   paths.install_oper_hist]).filt!


def versions_filter() -> ygdata.FNode:
    """Select the per-location version state, which names the added image.

    Selecting the whole location list, like `records_filter`, keeps every
    keyless entry and drops the large install-packages sibling.
    """
    paths = ixoper.subs.install_oper_data
    return paths.subscribe(select=[paths.install_location_information]).filt!


# The states of a version in install-version-state-info, from
# Cisco-IOS-XE-install-oper on a C1111 with 17.15.04c.
VS_INSTALLED = "install-version-state-installed"
VS_IN_PROGRESS = "install-version-state-in-progress"
VS_UNCOMMITTED = "install-version-state-provisioned-uncommitted"
VS_COMMITTED = "install-version-state-provisioned-committed"
## The states of a version whose packages the device has: added, marked for
## activation, activated, or committed. An invalid version lacks part of its
## image.
USABLE_VERSION_STATES = [VS_INSTALLED, VS_IN_PROGRESS, VS_UNCOMMITTED, VS_COMMITTED]


def _release_of_version(version: str) -> str:
    """The release of a device version: 17.15.04c of 17.15.04c.0.107."""
    return ".".join(version.split(".")[:3])


## The NETCONF version state of each package state in show install summary.
_SUMMARY_STATES = {"inactive": VS_INSTALLED, "activated-uncommitted": VS_UNCOMMITTED,
                   "activated-committed": VS_COMMITTED}


def device_versions(root: ?ygdata.Node) -> list[(version: str, state: str)]:
    """The versions of the device's software and their states, from
    install-version-state-info over NETCONF, or from the IMG packages of
    show install summary over the CLI. A CLI state is given as the NETCONF
    state with the same meaning. A device in bundle mode has none."""
    out: list[(version: str, state: str)] = []
    iod = ixoper.root.from_gdata(root).install_oper_data
    for loc in iod.install_location_information:
        for v in loc.install_version_state_info:
            ver = v.version
            if ver is not None:
                state = v.version_state
                out.append((version=ver, state=state if state is not None else ""))
    for loc in xecli_data.root.from_gdata(root).install_summary.location:
        for p in loc.package:
            ptype = p.type
            if ptype is not None and ptype == "IMG":
                state = ""
                pstate = p.state
                if pstate is not None:
                    mapped = _SUMMARY_STATES.get(pstate)
                    if mapped is not None:
                        state = mapped
                out.append((version=p.name, state=state))
    return out


def version_of(root: ?ygdata.Node, release: str) -> ?(version: str, state: str):
    """The device's version and its state for `release`.

    The device names a version like 17.18.03a.0.5540, which `activate`
    needs, so match on the release that the version starts with.
    """
    for v in device_versions(root):
        if releases_equal(_release_of_version(v.version), release):
            return v
    return None


def added_version(root: ?ygdata.Node, release: str) -> ?str:
    """The device's version for `release` when the device has its packages."""
    v = version_of(root, release)
    if v is not None and v.state in USABLE_VERSION_STATES:
        return v.version
    return None


def committed_release(root: ?ygdata.Node) -> ?str:
    """The release that the device keeps: the committed version."""
    for v in device_versions(root):
        if v.state == VS_COMMITTED:
            return _release_of_version(v.version)
    return None


def bundle_image(root: ?ygdata.Node) -> ?str:
    """The image that a device in bundle mode booted, from show version, as
    bootflash:x.bin. None in install mode, which boots packages.conf, and
    when the reply has no show version."""
    image = xecli_data.root.from_gdata(root).version.system_image
    if image is not None and image.endswith(".bin"):
        return image
    return None


def conversion_boot_lines(image: str) -> list[str]:
    """The boot statements for a conversion to install mode: packages.conf,
    which install mode boots, then the image that the device runs, which
    ROMMON boots when packages.conf is missing or fails."""
    return ["no boot system", "boot system flash bootflash:packages.conf", "boot system flash " + image]


def image_filename(url: str) -> str:
    """The filename an image URL will land under on bootflash.

    The last path component, which is right for every scheme the device
    supports: an scp source is scp://user:password@host:/path/to/file, so the
    credentials and the colon before the path fall to the left of the last
    slash.
    """
    parts = url.split("/")
    return parts[len(parts) - 1]


def redact_url(url: str) -> str:
    """A URL with any embedded credentials removed, for logging.

    scp and ftp sources carry them in the URL itself, so it cannot be logged as
    given. Everything between the scheme and the last `@` goes, which covers a
    password containing `@` or `:` as well.
    """
    marker = "://"
    at = url.rfind("@")
    scheme_end = url.find(marker)
    if at < 0 or scheme_end < 0 or at < scheme_end:
        return url
    return url[:scheme_end + len(marker)] + "***@" + url[at + 1:]


def job_uuid(phase: str, release: str, token: str) -> str:
    """The uuid one operation runs under.

    The token is what keeps two attempts apart. The device keeps finished
    operations in install-oper-hist and we find our records by uuid, so a uuid
    that is only a function of the release makes a second attempt match the
    first attempt's failure and give up before the device has begun.
    """
    return "swi-{phase}-{release}-{token}"


def operation_name(phase: str) -> str:
    """A driver phase as the device names the operation: staging is a download."""
    return "download" if phase == "stage" else phase


def xcopy_input(uuid: str, url: str, filename: str) -> ixrpc.Cisco_IOS_XE_xcopy_rpc__xcopy__input:
    """Stage an image. `destination_path` must be a bare filename: the device
    prepends /bootflash itself, so passing a path doubles it and fails."""
    return ixrpc.Cisco_IOS_XE_xcopy_rpc__xcopy__input(
        uuid=uuid, source_path=url, destination_path=filename)


def install_input(uuid: str, filename: str) -> ixrpc.Cisco_IOS_XE_install_rpc__install__input:
    """Add the staged file without activating it.

    `path` needs the `bootflash:` prefix, the opposite convention to xcopy's
    destination.
    """
    return ixrpc.Cisco_IOS_XE_install_rpc__install__input(
        uuid=uuid, one_shot=False, path="bootflash:" + filename)


def activate_input(uuid: str, version: str,
                   timer_min: int) -> ixrpc.Cisco_IOS_XE_install_rpc__activate__input:
    """Boot an added image by version. The device reverts unless install-commit
    arrives within `timer_min` minutes."""
    return ixrpc.Cisco_IOS_XE_install_rpc__activate__input(
        uuid=uuid, auto_abort_timer_val=u64(timer_min), version=version)


def commit_input(uuid: str) -> ixrpc.Cisco_IOS_XE_install_rpc__install_commit__input:
    return ixrpc.Cisco_IOS_XE_install_rpc__install_commit__input(uuid=uuid)


def abort_input(uuid: str) -> ixrpc.Cisco_IOS_XE_install_rpc__abort__input:
    return ixrpc.Cisco_IOS_XE_install_rpc__abort__input(uuid=uuid)


def remove_inactive_input(uuid: str) -> ixrpc.Cisco_IOS_XE_install_rpc__remove__input:
    return ixrpc.Cisco_IOS_XE_install_rpc__remove__input(uuid=uuid, inactive=True)


#############################################################################
# The adapter
#############################################################################

actor IosXeSoftwareDriver(dev: swdev.DeviceMgr, log_handler: logging.Handler,
                          poll_period: float=POLL_PERIOD,
                          reload_poll_period: float=RELOAD_POLL_PERIOD,
                          adapter_wait: float=ADAPTER_WAIT):
    """Serializes IOS XE software jobs and owns their polling state.

    One job at a time. Install is two phases: add, then activate the added
    image by the version the device assigned it. Record phases poll
    install-oper-data until the expected stage completes; version phases poll
    the running release until it reaches the target.
    """
    _log = logging.Logger(log_handler)
    # The adapter is built inside DeviceMgr.set_dmc. Calling dev.tree_provider()
    # synchronously here would call back into the same actor and deadlock.
    _rpcs = ixrpc.rpc_root(swdev.DeviceTreeProvider(dev))
    _cli = xecli_data.rpc_root(swdev.DeviceTreeProvider(dev))

    var _phase = ""          # stage | add | activate | commit | abort
    var _gen = 0
    var _polls = 0
    var _release = ""
    var _uuid = ""
    var _filename = ""
    var _expect_stage = ""
    var _allow_noop = True
    # Release a version phase waits for. None while aborting with the previous
    # release unknown: then any release but the aborted one will do.
    var _want: ?str = None
    var _done: ?action(?Exception) -> None = None
    # Activate has run and the device is reloading, so poll the release now
    # instead of the operation record.
    var _activate_booting = False
    # Monotonic seconds when activate was sent; the device timer runs from there.
    var _activated_at: ?int = None
    var _url = ""
    # The checksum that staging checks the image against, if any.
    var _check: ?(algorithm: str, digest: str) = None
    # Install stages the image first, then adds it.
    var _then_add = False
    # The conversion to install mode committed the release with its
    # activation, so commit has nothing left to do and abort cannot undo it.
    var _committed = False
    # What a remove goes on with: "stage" lists bootflash again and
    # transfers, "cleanup" ends the job.
    var _after_remove = ""

    def _finish(err: ?Exception) -> None:
        d = _done
        _phase = ""
        _done = None
        _activate_booting = False
        _gen += 1
        if d is not None:
            d!(err)

    def _fail(detail: str) -> None:
        """End the job with an error naming the operation; the manager
        publishes it as the run's reason."""
        op = operation_name(_phase)
        _finish(ValueError("{op} failed: {detail}"))

    def _busy() -> bool:
        return _phase != ""

    def _new_token() -> str:
        """A timestamp token with microsecond resolution."""
        secs, nanos = time.get_realtime()
        return "{secs}-{nanos // 1000}"

    def _modules() -> set[str]:
        return set(dev.get_modules().0.keys())

    def _release_filter() -> ygdata.FNode:
        """Select the running release, over NETCONF or else over the CLI."""
        return version_filter() if upgrade_plan(_modules()).check == "netconf" else cli_filter("version")

    def _versions_filter() -> ygdata.FNode:
        """Select the versions that the device has, over NETCONF or else
        over the CLI."""
        return versions_filter() if upgrade_plan(_modules()).install == "netconf" else cli_filter("install-summary")

    def _cli_install(done: action(?Exception) -> None,
                     inp: xecli_data.stratoweave_iosxe_cli__install__input) -> None:
        """Run an install command over the CLI. The RPC returns when the
        command ends, or when the session ends as the device reloads."""
        def ran(out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception) -> None:
            done(err)
        _cli.install(ran, inp)

    def _staging_check() -> ?(algorithm: str, digest: str):
        """The checksum that the device can check the staged image against,
        or None when there is none or the device cannot check."""
        if upgrade_plan(_modules()).verify != "cli":
            return None
        checksums: list[(algorithm: str, digest: str)] = []
        for c in dev.get_dmc().software.image_checksum:
            checksums.append((algorithm=c.algorithm, digest=c.digest))
        return usable_checksum(checksums)

    def _size_check(verify: str, listing: str) -> ?u64:
        """The size that the staged image is checked against: the image
        size of the intent, when the device can list files but compute no
        checksum."""
        if verify != "cli" and listing != "":
            return dev.get_dmc().software.image_size
        return None

    def _image_url() -> ?str:
        """Read the image URL at job start so configuration changes take effect."""
        url = dev.get_dmc().software.image_url
        if url is None or url! == "":
            return None
        return url

    def _start(phase: str, done: action(?Exception) -> None, release: str) -> bool:
        """Claim the driver for a job. False, after reporting, if one is running."""
        if _busy():
            done(ValueError("software job already running: {_phase}"))
            return False
        _done = done
        _release = release
        _enter(phase)
        return True

    def _enter(phase: str) -> None:
        """Begin a phase under a fresh uuid. Bumping _gen drops the previous
        phase's pending polls."""
        _gen += 1
        _phase = phase
        _uuid = job_uuid(phase, _release, _new_token())
        _polls = 0
        _expect_stage = ""
        _allow_noop = True
        _want = None
        _activate_booting = False

    def _on_rpc(gen: int, period: float) -> action(?Exception) -> None:
        """Reply handler for an input-only RPC: start polling once accepted."""
        def cb(err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
                return
            after now period: _poll(gen)
        return cb

    ####################################################################
    # check
    ####################################################################

    def check(done: action(?str, ?Exception) -> None) -> None:
        """Report the release that the device keeps. That is the running
        release, unless the device has activated it and not committed it:
        then the committed release, so that a new run commits the running
        one rather than calling the device up to date."""
        def on_reply(root: ?ygdata.Node, err: ?Exception) -> None:
            if err is not None:
                done(None, err)
                return
            running = running_release(root)
            if running is not None:
                _check_committed(done, running)
            else:
                done(None, None)
        dev.get(on_reply, _release_filter())

    def _check_committed(done: action(?str, ?Exception) -> None, running: str) -> None:
        def on_versions(root: ?ygdata.Node, err: ?Exception) -> None:
            v = version_of(root, running) if err is None else None
            if v is not None and v.state == VS_UNCOMMITTED:
                kept = committed_release(root)
                _log.info("software: the running release is not committed",
                          {"running": running, "committed": kept})
                done(kept, None)
            else:
                done(running, None)
        dev.get(on_versions, _versions_filter())

    ####################################################################
    # prepare: stage the image, touching no install state
    ####################################################################

    def prepare(done: action(?Exception) -> None, release: str) -> None:
        if not _start("stage", done, release):
            return
        url = _image_url()
        if url is None:
            _finish(ValueError("no image-url configured for release {release}"))
            return
        _url = url!
        _filename = image_filename(url!)
        _then_add = False
        _stage_when_connected(_gen, adapter_wait)

    def _stage_when_connected(gen: int, left: float) -> None:
        """Stage once every adapter of the device is connected, because the
        plan follows the modules of the adapters that are connected. After
        adapter_wait, stage with the adapters that are there."""
        if gen != _gen:
            return
        missing = dev.get_unconnected_adapters()
        if len(missing) == 0:
            _stage()
        elif left <= 0.0:
            _log.warning("software: staging without adapters that are not connected", {"adapters": missing})
            _stage()
        else:
            if left == adapter_wait:
                _log.info("software: waiting for adapters before staging", {"adapters": missing})
            step = ADAPTER_POLL if ADAPTER_POLL < left else left
            after now step: _stage_when_connected(gen, left - step)

    def _stage() -> None:
        """Make sure that the device has the image. A release that the
        device has added needs no image file: activate uses the packages
        that the add made."""
        gen = _gen
        def on_versions(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            ver = added_version(root, _release) if err is None else None
            if ver is not None:
                _log.info("software: release added already, no image needed", {"version": ver})
                _staged()
            else:
                _stage_file()
        dev.get(on_versions, _versions_filter())

    def _stage_file() -> None:
        """Make sure that the image file is on bootflash. When the device can
        check the file, against a checksum or else against the signature in
        the image, a file there that passes stays; one that is missing or
        fails is transferred and checked again. A device that can compute
        no checksum compares the size of the file with the image size of
        the intent instead."""
        _check = _staging_check()
        plan = upgrade_plan(_modules())
        if _check is None and plan.verify != "cli" and _size_check(plan.verify, plan.listing) is None:
            if _then_add:
                # Install cannot check the file either: trust what prepare
                # staged.
                _staged()
            else:
                _transfer()
            return
        gen = _gen
        def listed(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
            elif staged_file(root, _filename):
                _verify(gen, True)
            else:
                _transfer_with_room(root, False)
        dev.get(listed, bootflash_filter(plan.listing))

    def _transfer_with_room(root: ?ygdata.Node, removed: bool) -> None:
        """Transfer the image when bootflash has room for it and for the
        packages that the add makes of it. Without the room, remove the
        software that the device does not run, once, and look again: the
        running release stays. Without an image size or a free space, just
        transfer."""
        need = room_needed(dev.get_dmc().software.image_size)
        free = free_space(root)
        if need is None or free is None or free! >= need!:
            _transfer()
        elif removed:
            _fail("bootflash: has {free} bytes free, the image and its packages need {need}")
        else:
            _log.info("software: removing inactive software to make room", {"free": free, "need": need})
            _remove_inactive("stage")

    def _list_again() -> None:
        """After a remove that made room: list bootflash, then transfer."""
        _enter("stage")
        gen = _gen
        def listed(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
            else:
                _transfer_with_room(root, True)
        dev.get(listed, bootflash_filter(upgrade_plan(_modules()).listing))

    def _remove_inactive(after_remove: str) -> None:
        """Remove the software that the device does not run and the image
        files that it does not use, with the NETCONF remove RPC or else over
        the CLI. Then go on as after_remove says."""
        _enter("remove")
        _after_remove = after_remove
        how = upgrade_plan(_modules()).install
        if how == "cli":
            gen = _gen
            def removed(err: ?Exception) -> None:
                if gen != _gen:
                    return
                if err is not None:
                    _fail(swdev.error_text(err!))
                    return
                _log.info("software: remove done")
                _end_phase()
            _cli_install(removed, xecli_data.stratoweave_iosxe_cli__install__input(
                remove=xecli_data.stratoweave_iosxe_cli__install__input__remove(inactive=True)))
            return
        if how != "netconf":
            _fail("the device has no way to remove software: no {INSTALL_MODULE} and no CLI adapter")
            return
        # Nothing to remove completes as a no-op, which is fine.
        _log.info("software: removing inactive software", {"uuid": _uuid})
        _rpcs.remove(_on_rpc(_gen, poll_period), remove_inactive_input(_uuid))

    def _verify(gen: int, before_transfer: bool) -> None:
        c = _check
        plan = upgrade_plan(_modules())
        size = _size_check(plan.verify, plan.listing)
        if c is not None:
            _verify_against(gen, before_transfer, c)
        elif plan.verify == "cli":
            _verify_image(gen, before_transfer)
        elif size is not None:
            _verify_size(gen, before_transfer, size, plan.listing)
        else:
            _staged()

    def _verify_size(gen: int, before_transfer: bool, size: u64, listing: str) -> None:
        """Compare the size of the staged image with the image size of the
        intent, which finds a transfer that stopped early."""
        def listed(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
                return
            got = staged_size(root, _filename)
            if got is not None and got == size:
                _log.info("software: image size matches", {"file": _filename, "size": size})
                _staged()
            elif before_transfer:
                _log.info("software: staged image has another size, transferring it again",
                          {"file": _filename, "size": got, "want": size})
                _transfer()
            else:
                _fail("size mismatch: {_filename} is {got} bytes, not {size}")
        dev.get(listed, bootflash_filter(listing))

    def _verify_image(gen: int, before_transfer: bool) -> None:
        """Check the hashes and the signature that the image holds."""
        def verified(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail("verify: " + swdev.error_text(err!))
                return
            ok = out.verified if out is not None else None
            if ok is not None and ok:
                _log.info("software: image signature verified", {"file": _filename})
                _staged()
            elif before_transfer:
                _log.info("software: staged image fails its signature check, transferring it again", {"file": _filename})
                _transfer()
            else:
                _fail("{_filename} fails its signature check")
        _cli.verify(verified, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", _filename))

    def _verify_against(gen: int, before_transfer: bool, c: (algorithm: str, digest: str)) -> None:
        def verified(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail("verify: " + swdev.error_text(err!))
                return
            ok = out.verified if out is not None else None
            if ok is not None and ok:
                _log.info("software: image verified", {"file": _filename, "algorithm": c.algorithm})
                _staged()
            elif before_transfer:
                _log.info("software: staged image differs, transferring it again", {"file": _filename})
                _transfer()
            else:
                computed = out.digest if out is not None else None
                _fail("checksum mismatch: {c.algorithm} of {_filename} is {computed}, not {c.digest}")
        _cli.verify(verified, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", _filename, c.algorithm, c.digest))

    def _staged() -> None:
        if _then_add:
            _install_mode()
        else:
            _finish(None)

    def _transfer() -> None:
        how = upgrade_plan(_modules()).transfer
        if how == "cli":
            _transfer_cli()
            return
        if how != "netconf":
            _fail("the device has no way to transfer the image: no {XCOPY_MODULE} and no CLI adapter")
            return
        url = _url
        _expect_stage = STAGE_DOWNLOAD
        gen = _gen
        _log.info("software: staging image",
                  {"url": redact_url(url), "uuid": _uuid})
        def on_rpc(out: ?ixrpc.Cisco_IOS_XE_xcopy_rpc__xcopy__output,
                   err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                # The device may quote the source, credentials and all.
                _fail(swdev.error_text(err!).replace(url, redact_url(url)))
                return
            after now poll_period: _poll(gen)
        _rpcs.xcopy(on_rpc, xcopy_input(_uuid, url, _filename))

    def _transfer_cli() -> None:
        """Copy the image with the CLI's copy, which returns when the copy
        ends. Then check it, as after xcopy."""
        url = _url
        gen = _gen
        _log.info("software: staging image over the CLI", {"url": redact_url(url)})
        def copied(out: ?xecli_data.stratoweave_iosxe_cli__copy__output, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!).replace(url, redact_url(url)))
                return
            _log.info("software: image copied", {"file": _filename, "size": out.size if out is not None else None})
            _end_phase()
        _cli.copy(copied, xecli_data.stratoweave_iosxe_cli__copy__input(url, "bootflash:", _filename))

    ####################################################################
    # install: add, then activate the added image; device reloads
    ####################################################################

    def install(done: action(?Exception) -> None, release: str) -> None:
        """Stage again, as prepare does, but without a transfer when the
        device cannot check the file: then trust what prepare staged. Then
        add the image unless the device has added it, and activate it."""
        if not _start("stage", done, release):
            return
        url = _image_url()
        if url is None:
            _finish(ValueError("no image-url configured for release {release}"))
            return
        _url = url!
        _filename = image_filename(url!)
        _activated_at = None
        _then_add = True
        _committed = False
        _stage_when_connected(_gen, adapter_wait)

    def _install_mode() -> None:
        """A device in bundle mode refuses install add alone, so convert it
        to install mode. Only an install over the CLI looks: the conversion
        runs over the CLI, and a device with the NETCONF install RPCs is
        taken to be in install mode."""
        if upgrade_plan(_modules()).install != "cli":
            _add_unless_added()
            return
        gen = _gen
        def on_version(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
                return
            image = bundle_image(root)
            if image is not None:
                _convert(image)
            else:
                _add_unless_added()
        dev.get(on_version, cli_filter("version"))

    def _convert(image: str) -> None:
        """Convert a device in bundle mode to install mode with the release.
        Point the boot statements at packages.conf, with the running image
        after it, save them, then add, activate and commit the image in one
        command: in bundle mode the device takes no other form. The device
        reloads, and the release is committed with the activation, so there
        is no commit window."""
        _enter("activate")
        _want = _release
        _committed = True
        gen = _gen
        lines = conversion_boot_lines(image)
        _log.info("software: converting to install mode, device will reload",
                  {"running": image, "file": _filename, "boot": lines})
        def activated(err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
                return
            _activate_booting = True
            after now reload_poll_period: _poll(gen)
        def saved(err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail("write memory: " + swdev.error_text(err!))
                return
            _cli_install(activated, xecli_data.stratoweave_iosxe_cli__install__input(
                add=xecli_data.stratoweave_iosxe_cli__install__input__add(
                    "bootflash:" + _filename, activate=True, commit=True, prompt_level="none")))
        def configured(err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail("boot system: " + swdev.error_text(err!))
                return
            _cli.write_memory(saved)
        _cli.configure(configured, xecli_data.stratoweave_iosxe_cli__configure__input(lines))

    def _add_unless_added() -> None:
        """Activate the image when the device has added it already, as after
        an install that stopped after the add. IOS XE refuses to add an image
        again: the add pre-check fails with install-add-prechk-fail. When the
        device runs the release, activated and not committed, install is
        done."""
        gen = _gen
        def on_versions(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
                return
            v = version_of(root, _release)
            if v is not None and v.state == VS_UNCOMMITTED:
                # Activated before, as by a run that stopped before the
                # commit: the device runs it, and the commit follows.
                _log.info("software: release activated already", {"version": v.version})
                _finish(None)
            elif v is not None and v.state in USABLE_VERSION_STATES:
                _log.info("software: image added already", {"file": _filename, "version": v.version})
                _activate(v.version)
            else:
                _add()
        dev.get(on_versions, _versions_filter())

    def _add() -> None:
        _enter("add")
        if upgrade_plan(_modules()).install == "cli":
            gen = _gen
            _log.info("software: adding image over the CLI", {"file": _filename})
            def added(err: ?Exception) -> None:
                if gen != _gen:
                    return
                if err is not None:
                    _fail(swdev.error_text(err!))
                    return
                _log.info("software: add done", {"file": _filename})
                _end_phase()
            _cli_install(added, xecli_data.stratoweave_iosxe_cli__install__input(
                add=xecli_data.stratoweave_iosxe_cli__install__input__add("bootflash:" + _filename)))
            return
        _expect_stage = STAGE_ADD_END
        _log.info("software: adding image", {"file": _filename, "uuid": _uuid})
        _rpcs.install(_on_rpc(_gen, poll_period), install_input(_uuid, _filename))

    def _after_add() -> None:
        # An added image is activated by the version the device assigned it,
        # not by its bootflash path, so read the version state first.
        gen = _gen
        def on_versions(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _fail(swdev.error_text(err!))
                return
            ver = added_version(root, _release)
            if ver is None:
                _fail("added image for {_release} not found")
                return
            _activate(ver!)
        dev.get(on_versions, _versions_filter())

    def _activate(version: str) -> None:
        _enter("activate")
        _want = _release
        secs, nanos = time.get_monotonic()
        _activated_at = secs
        if upgrade_plan(_modules()).install == "cli":
            gen = _gen
            _log.info("software: activating over the CLI, device will reload", {"version": version})
            def activated(err: ?Exception) -> None:
                if gen != _gen:
                    return
                if err is not None:
                    _fail(swdev.error_text(err!))
                    return
                _activate_booting = True
                after now reload_poll_period: _poll(gen)
            _cli_install(activated, xecli_data.stratoweave_iosxe_cli__install__input(
                activate=xecli_data.stratoweave_iosxe_cli__install__input__activate(
                    auto_abort_timer=u64(AUTO_ABORT_TIMER_MIN), prompt_level="none")))
            return
        _log.info("software: activating, device will reload",
                  {"version": version, "uuid": _uuid})
        _rpcs.activate(_on_rpc(_gen, poll_period),
                       activate_input(_uuid, version, AUTO_ABORT_TIMER_MIN))

    ####################################################################
    # commit: keep the activated release, stop the abort timer
    ####################################################################

    def commit(done: action(?Exception) -> None) -> None:
        if not _start("commit", done, _release):
            return
        if _committed:
            _log.info("software: committed with the activation", {"release": _release})
            _finish(None)
            return
        if upgrade_plan(_modules()).install == "cli":
            gen = _gen
            _log.info("software: committing over the CLI", {"release": _release})
            def committed(err: ?Exception) -> None:
                if gen != _gen:
                    return
                if err is not None:
                    _fail(swdev.error_text(err!))
                    return
                _finish(None)
            _cli_install(committed, xecli_data.stratoweave_iosxe_cli__install__input(commit=True))
            return
        # One record and no reload, so completion alone ends the job. A no-op
        # means nothing was uncommitted: the device had already reverted.
        _allow_noop = False
        _log.info("software: committing", {"release": _release, "uuid": _uuid})
        _rpcs.install_commit(_on_rpc(_gen, poll_period), commit_input(_uuid))

    def commit_window(done: action(?int) -> None) -> None:
        a = _activated_at
        if a is None or _committed:
            done(None)
            return
        secs, nanos = time.get_monotonic()
        done(AUTO_ABORT_TIMER_MIN * 60 - (secs - a!))

    ####################################################################
    # rollback: abort the uncommitted release; device reloads
    ####################################################################

    def rollback(done: action(?Exception) -> None, previous: ?str) -> None:
        if not _start("abort", done, _release):
            return
        _want = previous
        if _committed:
            _fail("the conversion to install mode committed {_release}: nothing to abort")
            return
        if upgrade_plan(_modules()).install == "cli":
            gen = _gen
            _log.info("software: aborting over the CLI, device will reload", {"previous": str(previous)})
            def aborted(err: ?Exception) -> None:
                if gen != _gen:
                    return
                if err is not None:
                    _fail(swdev.error_text(err!))
                    return
                after now reload_poll_period: _poll(gen)
            _cli_install(aborted, xecli_data.stratoweave_iosxe_cli__install__input(abort=True))
            return
        _log.info("software: aborting, device will reload",
                  {"previous": str(previous), "uuid": _uuid})
        _rpcs.abort(_on_rpc(_gen, reload_poll_period), abort_input(_uuid))

    ####################################################################
    # polling -- the only completion signal an accepted RPC gives
    #
    # Polls are scheduled with after now, so reads of the device stay a
    # full period apart however late a round runs. A plain after counts
    # from when the round was due; a round that runs late would catch up
    # with back-to-back reads and spend the poll budget before the device
    # has had the time the budget allows it.
    ####################################################################

    def _poll(gen: int) -> None:
        if gen != _gen or not _busy():
            return
        _polls += 1
        limit = VERSION_MAX_POLLS if (_phase == "activate" or _phase == "abort") else MAX_POLLS
        if _polls > limit:
            op = operation_name(_phase)
            _finish(ValueError("{op} did not finish in time"))
            return
        if _phase == "abort":
            _poll_version(gen)
        elif _phase == "activate":
            if _activate_booting:
                _poll_version(gen)
            else:
                _poll_activate(gen)
        else:
            _poll_records(gen)

    def _poll_activate(gen: int) -> None:
        # Watch the activate operation until it fails its prechecks or the
        # session drops as the device reloads. A read error is the reload, not
        # a failure, so switch to waiting for the release.
        after now poll_period: _poll(gen)
        def on_oper(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                _activate_booting = True
                return
            v = aggregate(root, _uuid, "", True)
            if not v.done:
                return
            if v.failed:
                _fail(v.detail)
                return
            _activate_booting = True
        dev.get(on_oper, records_filter())

    def _poll_records(gen: int) -> None:
        # Schedule the next poll before starting the read so a missing callback
        # does not stop polling.
        after now poll_period: _poll(gen)
        def on_oper(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                return
            v = aggregate(root, _uuid, _expect_stage, _allow_noop)
            if not v.done:
                return
            if v.failed:
                if _phase == "add" and v.detail in BAD_IMAGE_CAUSES:
                    _delete_bad_image(v.detail)
                else:
                    _fail(v.detail)
                return
            _log.info("software: {_phase} done", {"uuid": _uuid})
            _end_phase()
        dev.get(on_oper, records_filter())

    def _delete_bad_image(cause: str) -> None:
        """Delete the image file that the device refused to add, so that the
        next run transfers it again, then fail with the cause."""
        _gen += 1
        gen = _gen
        path = "bootflash:" + _filename
        if CISCO_RPC_MODULE not in _modules():
            _fail(cause)
            return
        def deleted(out: ?ixrpc.Cisco_IOS_XE_rpc__delete__output, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                why = swdev.error_text(err!)
                _fail("{cause}; could not delete {path}: {why}")
            else:
                _log.warning("software: deleted the image that the device refused",
                             {"file": path, "cause": cause})
                _fail("{cause}; deleted {path}")
        _rpcs.delete(deleted, ixrpc.Cisco_IOS_XE_rpc__delete__input(path))

    def _end_phase() -> None:
        """Go on from a phase that its records report done. Bumping _gen
        stops the polls of the phase, so that the next one does not run the
        next step again."""
        _gen += 1
        if _phase == "add":
            _after_add()
        elif _phase == "stage":
            _verify(_gen, False)
        elif _phase == "remove" and _after_remove == "stage":
            _list_again()
        else:
            _finish(None)

    def _reached(got: str) -> bool:
        w = _want
        if w is not None:
            return releases_equal(got, w)
        return not releases_equal(got, _release)

    def _poll_version(gen: int) -> None:
        after now reload_poll_period: _poll(gen)
        def on_version(root: ?ygdata.Node, err: ?Exception) -> None:
            if gen != _gen:
                return
            if err is not None:
                # The device is reloading. Not a failure.
                return
            got = running_release(root)
            if got is None:
                return
            if _reached(got!):
                _log.info("software: device booted", {"release": got!})
                _end_phase()
        dev.get(on_version, _release_filter())

    ####################################################################
    # not implemented -- continues without acting
    ####################################################################

    def cleanup(done: action(?Exception) -> None) -> None:
        """Remove the software that the device does not run and the image
        files that it does not use. The manager calls it after the commit,
        when the release that passed the post-checks is the one to keep,
        and the next upgrade needs the room."""
        if not _start("cleanup", done, _release):
            return
        _remove_inactive("cleanup")


class IosXeSoftwareAdapter(swdev.SoftwareAdapter):
    @staticmethod
    def plan_estimate() -> int:
        """The c8000v timing profile the device mock also scales from:
        install, activate and commit, about six and a half minutes."""
        return 395

    @staticmethod
    def prepare_estimate() -> int:
        """The copy of the image in the c8000v timing profile that
        plan_estimate is from: 130 of its 395 s."""
        return 130

    """Software adapter for IOS XE. See the module header for the scope."""

    _driver: IosXeSoftwareDriver

    def __init__(self, dev: swdev.DeviceMgr, dmc: DeviceMetaConfig,
                 log_handler: logging.Handler, env: ?Env,
                 poll_period: float=POLL_PERIOD,
                 reload_poll_period: float=RELOAD_POLL_PERIOD,
                 adapter_wait: float=ADAPTER_WAIT):
        # The periods are parameters only so a test can drive them fast.
        # A device type names a small factory that calls this with defaults;
        # `_fast_adapter` in adapters.test_software_iosxe is the pattern.
        self._log_handler = log_handler
        self._driver = IosXeSoftwareDriver(dev, log_handler, poll_period,
                                          reload_poll_period, adapter_wait)

    def supports_mocking(self) -> bool:
        return True

    def check(self, done: action(?str, ?Exception) -> None) -> None:
        self._driver.check(done)

    def matches_release(self, running: ?str, target: str) -> bool:
        return releases_equal(running, target)

    def prepare(self, done: action(?Exception) -> None, release: str) -> None:
        self._driver.prepare(done, release)

    def install(self, done: action(?Exception) -> None, release: str) -> None:
        self._driver.install(done, release)

    def rollback(self, done: action(?Exception) -> None, previous: ?str) -> None:
        self._driver.rollback(done, previous)

    def commit(self, done: action(?Exception) -> None) -> None:
        self._driver.commit(done)

    def commit_window(self, done: action(?int) -> None) -> None:
        self._driver.commit_window(done)

    def cleanup(self, done: action(?Exception) -> None) -> None:
        self._driver.cleanup(done)
