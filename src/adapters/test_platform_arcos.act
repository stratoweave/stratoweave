#
# ArcOS platform probe: replies other than the lab container's, which
# test_platform_lab covers.
#

import testing
import std.xml as xml
import yang
import yang.gdata as ygdata
import yang.xml as yxml

import device as swdev
import adapters.platform_arcos as arcos
import adapters.platform_arcos_yang as arcos_yang
from adapters.adapter import ModCap


def _show(p: ?swdev.Platform) -> str:
    if p is not None:
        return "{p.os} {p.version} {p.model} {p.serial_number}"
    return "no platform"


def _state(body: str) -> ygdata.Node:
    return yxml.from_xml(yang.compile(arcos_yang.models), xml.decode("<data><system xmlns=\"http://openconfig.net/yang/system\"><version xmlns=\"http://yang.arrcus.com/arcos/openconfig/system/augments\"><state>{body}</state></version></system></data>"), loose=True)


def _test_platform_from_replies():
    cases: list[(label: str, reply: ygdata.Node, want: str)] = [
        (label="hardware",
         reply=_state("<platform>UFISPACE-S9600-72XC</platform><serial-number>WE12345</serial-number><sw-version>8.2.1A.P4</sw-version>"),
         want="arcos 8.2.1A.P4 UFISPACE-S9600-72XC WE12345"),
        (label="empty-serial",
         reply=_state("<platform>Virtual</platform><serial-number></serial-number><sw-version>8.2.1A.P4</sw-version>"),
         want="arcos 8.2.1A.P4 Virtual None"),
    ]
    for c in cases:
        p = arcos.platform(c.reply)
        testing.assertEqual(c.want, _show(p), c.label)


def _test_platform_without_values():
    testing.assertTrue(arcos.platform(None) is None, "no reply")
    testing.assertTrue(arcos.platform(ygdata.Container({})) is None, "an empty reply")


def _test_probe_applies_on_its_module():
    m = arcos.MODULE
    testing.assertTrue(arcos.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not arcos.PROBE.applies({"openconfig-system": ModCap("openconfig-system", "urn:y")}),
                       "the device lists only openconfig-system")
