#
# ArcOS platform probe: replies other than the lab container's, which
# test_platform_lab covers.
#

import testing
import std.xml as xml
import yang
import yang.gdata as ygdata
import yang.xml as yxml

import device as swdev
import adapters.platform_arcos as arcos
import adapters.platform_arcos_yang as arcos_yang
from adapters.adapter import ModCap


def _show(p: ?swdev.Platform) -> str:
    if p is not None:
        return "{p.os} {p.version} {p.model} {p.serial_number}"
    return "no platform"


# 2026-11-19T08:12:40Z
BOOT = 1795075960
VERSION = "<platform>Virtual</platform><sw-version>8.2.1A.P4</sw-version>"


def _state(body: str, system_state: str="") -> ygdata.Node:
    """A reply with body in system/version/state and system_state in
    system/state."""
    return yxml.from_xml(yang.compile(arcos_yang.models), xml.decode("<data><system xmlns=\"http://openconfig.net/yang/system\"><version xmlns=\"http://yang.arrcus.com/arcos/openconfig/system/augments\"><state>{body}</state></version><state>{system_state}</state></system></data>"), loose=True)


def _test_platform_from_replies():
    cases: list[(label: str, reply: ygdata.Node, want: str)] = [
        (label="hardware",
         reply=_state("<platform>UFISPACE-S9600-72XC</platform><serial-number>WE12345</serial-number><sw-version>8.2.1A.P4</sw-version>"),
         want="arcos 8.2.1A.P4 UFISPACE-S9600-72XC WE12345"),
        (label="empty-serial",
         reply=_state("<platform>Virtual</platform><serial-number></serial-number><sw-version>8.2.1A.P4</sw-version>"),
         want="arcos 8.2.1A.P4 Virtual None"),
    ]
    for c in cases:
        p = arcos.platform(c.reply)
        testing.assertEqual(c.want, _show(p), c.label)


def _test_last_boot_from_reply():
    """boot-time counts nanoseconds since the epoch. A boot-time of 0 or none
    gives no last boot, and the rest of the platform stays."""
    cases: list[(label: str, system_state: str, want: ?int)] = [
        (label="nanoseconds", system_state="<boot-time>1795075960123456789</boot-time>", want=BOOT),
        (label="whole second", system_state="<boot-time>1795075960000000000</boot-time>", want=BOOT),
        (label="zero", system_state="<boot-time>0</boot-time>", want=None),
        (label="no boot-time", system_state="", want=None),
    ]
    for c in cases:
        p = arcos.platform(_state(VERSION, c.system_state))
        if p is not None:
            testing.assertEqual(c.want, p.last_boot, c.label)
            testing.assertEqual("arcos 8.2.1A.P4 Virtual None", _show(p), "{c.label}: the rest")
        else:
            testing.error("{c.label}: no platform")


def _test_filter_selects_version_and_boot_time():
    """One get with the filter gives the version and the boot time."""
    reply = _state(VERSION, "<boot-time>1795075960123456789</boot-time>")
    got = ygdata.filter(reply, ygdata.FNode(children=[arcos.platform_filter()]))
    p = arcos.platform(got)
    if p is not None:
        testing.assertEqual("arcos 8.2.1A.P4 Virtual None", _show(p), "version")
        testing.assertEqual(BOOT, p.last_boot, "last boot")
    else:
        testing.error("no platform")


def _test_platform_without_values():
    testing.assertTrue(arcos.platform(None) is None, "no reply")
    testing.assertTrue(arcos.platform(ygdata.Container({})) is None, "an empty reply")


def _test_probe_applies_on_its_module():
    m = arcos.MODULE
    testing.assertTrue(arcos.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not arcos.PROBE.applies({"openconfig-system": ModCap("openconfig-system", "urn:y")}),
                       "the device lists only openconfig-system")
