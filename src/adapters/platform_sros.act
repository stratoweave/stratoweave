"""SR OS platform probe.

It applies to a device that lists nokia-state, which a model-driven or mixed
mode SR OS serves. One get reads, under /state, the platform, the release and
the serial number of every chassis. The device type's schema must have the
pruned YANG in adapters.platform_sros_yang, or the real module.
"""

import yang.gdata as ygdata

import device as swdev
import adapters.platform_sros_oper as srosoper
from adapters.adapter import ModCap

OS = "sros"
MODULE = "nokia-state"
CHASSIS_ROUTER = "router"


def platform_filter() -> ygdata.FNode:
    """Select the platform, the version number, and the class, number and
    serial number of every chassis. The filter takes every chassis because a
    system can have more than one."""
    st = srosoper.subs.state
    ch = st.chassis
    return st.subscribe(select=[st.system.platform,
                                st.system.version.version_number,
                                ch.chassis_class, ch.chassis_number,
                                ch.hardware_data.serial_number]).filt!


def release(version_number: ?str) -> ?str:
    """The release in an SR OS version number, which starts with the image
    type: C-23.10.R1 gives 23.10.R1."""
    v = swdev.nonempty(version_number)
    if v is not None:
        dash = v.find("-")
        if dash > 0 and v[:dash].isalpha():
            return swdev.nonempty(v[dash + 1:])
    return v


def platform(root: ?ygdata.Node) -> ?swdev.Platform:
    """Return the platform in a reply, or None when the reply has neither a
    version nor a platform.

    The serial number comes from the router chassis with the lowest number,
    so a system of two chassis gives the same answer whatever order the
    entries come in.
    """
    st = srosoper.root.from_gdata(root).state
    version = release(st.system.version.version_number)
    model = swdev.nonempty(st.system.platform)
    number: ?u64 = None
    serial: ?str = None
    for c in st.chassis:
        if c.chassis_class != CHASSIS_ROUTER:
            continue
        if number is not None and c.chassis_number >= number:
            continue
        number = c.chassis_number
        serial = swdev.nonempty(c.hardware_data.serial_number)
    if version is None and model is None:
        return None
    return swdev.Platform(OS, version, model, serial)


class SrOsProbe(swdev.GetPlatformProbe):
    """The SR OS probe. One get per read."""
    def __init__(self):
        self.name = OS
        self.filt = platform_filter()

    def applies(self, modset: dict[str, ModCap]) -> bool:
        return MODULE in modset

    def parse(self, root: ?ygdata.Node) -> ?swdev.Platform:
        return platform(root)


PROBE = SrOsProbe()
