"""IOS XE platform probe.

It applies to a device that lists Cisco-IOS-XE-device-hardware-oper. One get
reads the inventory entries and the software version banner. As for the
software adapter, the device type's schema must have the pruned IOS XE YANG
in adapters.software_iosxe_yang.

Cisco-IOS-XE-platform-oper names the chassis too, but a lab c8000v returned
invalid UTF-8 in that tree.
"""

import yang.gdata as ygdata

import device as swdev
import adapters.software_iosxe as swxe
import adapters.software_iosxe_oper as ixoper
from adapters.adapter import ModCap

OS = "ios-xe"
MODULE = "Cisco-IOS-XE-device-hardware-oper"
HW_TYPE_CHASSIS = "hw-type-chassis"


def platform_filter() -> ygdata.FNode:
    """Select the type, index, part-number and serial number of every
    inventory entry, and the software version banner. The filter takes every
    entry because the chassis need not be index 0."""
    hw = ixoper.subs.device_hardware_data.device_hardware
    inv = hw.device_inventory
    return hw.subscribe(select=[inv.hw_type, inv.hw_dev_index, inv.part_number,
                                inv.serial_number,
                                hw.device_system_data.software_version]).filt!


def platform(root: ?ygdata.Node) -> ?swdev.Platform:
    """Return the platform in a reply, or None when the reply has neither a
    software version nor a chassis part number.

    The model and serial number come from the chassis entry with the lowest
    index, so a stack gives the same answer whatever order the entries come in.
    """
    version = swxe.running_release(root)
    hardware = ixoper.root.from_gdata(root).device_hardware_data.device_hardware
    chassis_index: ?u64 = None
    model: ?str = None
    serial: ?str = None
    for e in hardware.device_inventory:
        if e.hw_type != HW_TYPE_CHASSIS:
            continue
        if chassis_index is not None and e.hw_dev_index >= chassis_index:
            continue
        chassis_index = e.hw_dev_index
        model = swdev.nonempty(e.part_number)
        serial = swdev.nonempty(e.serial_number)
    if version is None and model is None:
        return None
    return swdev.Platform(OS, version, model, serial)


class IosXeProbe(swdev.GetPlatformProbe):
    """The IOS XE probe. One get per read."""
    def __init__(self):
        self.name = OS
        self.filt = platform_filter()

    def applies(self, modset: dict[str, ModCap]) -> bool:
        return MODULE in modset

    def parse(self, root: ?ygdata.Node) -> ?swdev.Platform:
        return platform(root)


PROBE = IosXeProbe()
