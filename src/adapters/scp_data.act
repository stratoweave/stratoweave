SRC_YANG_0: str = r"""module stratoweave-scp {
  yang-version "1.1";
  namespace "http://stratoweave.org/yang/stratoweave-scp";
  prefix scp;

  description
    "Files that the StratoWeave SCP adapter copies to a device over SCP, on
     an SSH connection of its own.";

  rpc put {
    description
      "Copy a file from the image folder (the software.image_dir setting)
       to the device. The adapter logs in, runs 'scp -t' with remote-file
       on an exec channel, sends the file, and closes the connection. The
       RPC returns when the device has written the file, or fails with the
       error that the device or the connection gave.";
    input {
      leaf local-file {
        type string;
        mandatory true;
        description
          "The path of the file in the image folder: its folders and its
           file name joined by '/', such as
           iosxe/c8000v-universalk9.17.18.03a.SPA.bin.";
      }
      leaf remote-file {
        type string;
        mandatory true;
        description
          "Where the device writes the file, in the form that its SCP
           server takes, such as bootflash:x.bin on IOS XE,
           /harddisk:/x.bin on IOS XR or /var/tmp/x.bin on Junos. The file
           name is the text after the last '/' or ':'.";
      }
    }
    output {
      leaf size {
        type uint64;
        units "bytes";
        description "The size of the file that the adapter sent.";
      }
    }
  }
}
"""

