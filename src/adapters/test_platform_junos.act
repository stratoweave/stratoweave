#
# Junos platform probe: what it makes of the replies of devices other than
# the lab's cRPD, which test_platform_lab covers.
#

import testing
import std.xml as xml

import device as swdev
import adapters.platform_junos as junos
from adapters.adapter import ModCap


def _show(p: ?swdev.Platform) -> str:
    if p is not None:
        return "{p.os} {p.version} {p.model} {p.serial_number}"
    return "no platform"


def _reply(body: str) -> xml.Node:
    return xml.decode("<rpc-reply xmlns=\"urn:ietf:params:xml:ns:netconf:base:1.0\">{body}</rpc-reply>")


def _sw(model: str, version: str) -> str:
    return "<software-information><host-name>r1</host-name><product-model>{model}</product-model><product-name>{model}</product-name><junos-version>{version}</junos-version></software-information>"


def _test_platform_from_replies():
    mx = _sw("mx204", "23.4R2-S3.9")
    re0 = _sw("mx960", "23.4R2.13")
    re1 = _sw("mx960", "22.4R3.25")
    cases: list[(label: str, software: ?xml.Node, system: ?xml.Node, want: str)] = [
        (label="hardware",
         software=_reply(mx),
         system=_reply("<system-information><hardware-model>mx204</hardware-model><os-name>junos</os-name><os-version>23.4R2-S3.9</os-version><serial-number>BT1234</serial-number><host-name>r1</host-name></system-information>"),
         want="junos 23.4R2-S3.9 mx204 BT1234"),
        (label="two-routing-engines-first-taken",
         software=_reply("<multi-routing-engine-results><multi-routing-engine-item><re-name>re0</re-name>{re0}</multi-routing-engine-item><multi-routing-engine-item><re-name>re1</re-name>{re1}</multi-routing-engine-item></multi-routing-engine-results>"),
         system=None,
         want="junos 23.4R2.13 mx960 None"),
        (label="system-information-failed",
         software=_reply(mx), system=None,
         want="junos 23.4R2-S3.9 mx204 None"),
        (label="no-junos-version-uses-os-version",
         software=_reply("<software-information><product-model>ex4300-48p</product-model></software-information>"),
         system=_reply("<system-information><hardware-model>ex4300-48p</hardware-model><os-version>21.4R3.15</os-version></system-information>"),
         want="junos 21.4R3.15 ex4300-48p None"),
        (label="whitespace-around-text",
         software=_reply("<software-information>\n<product-model>\nvmx\n</product-model>\n<junos-version> 24.2R1.17 </junos-version>\n</software-information>"),
         system=None,
         want="junos 24.2R1.17 vmx None"),
    ]
    for c in cases:
        p = junos.platform(c.software, c.system)
        testing.assertEqual(c.want, _show(p), c.label)


def _test_platform_without_values():
    """Replies with neither a model nor a release are no platform."""
    testing.assertTrue(junos.platform(None, None) is None, "no replies")
    empty = _reply("<software-information><host-name>r1</host-name></software-information>")
    testing.assertTrue(junos.platform(empty, _reply("")) is None, "empty replies")


def _test_probe_applies_on_its_module():
    m = junos.MODULE
    testing.assertTrue(junos.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not junos.PROBE.applies({"junos-conf-root": ModCap("junos-conf-root", "urn:y")}),
                       "the device does not list the module")
