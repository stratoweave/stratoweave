#
# Junos platform probe: what it makes of the replies of devices other than
# the lab's cRPD, which test_platform_lab covers.
#

import testing
import std.xml as xml

import device as swdev
import adapters.netconf as swna
import adapters.platform_junos as junos
from adapters.adapter import ModCap


# 2026-11-19T08:12:40Z
BOOT = 1795075960


def _show(p: ?swdev.Platform) -> str:
    if p is not None:
        return "{p.os} {p.version} {p.model} {p.serial_number}"
    return "no platform"


def _reply(body: str) -> xml.Node:
    return xml.decode("<rpc-reply xmlns=\"urn:ietf:params:xml:ns:netconf:base:1.0\" xmlns:junos=\"http://xml.juniper.net/junos/23.4R2/junos\">{body}</rpc-reply>")


def _uptime(booted: str) -> str:
    """A reply to get-system-uptime-information, as 'show system uptime'
    prints it, with this system-booted-time. The device has been up for 4
    days and 14 hours."""
    return "<system-uptime-information><current-time><date-time junos:seconds=\"1795472000\">2026-11-23 22:13:20 UTC</date-time></current-time><time-source> NTP CLOCK </time-source><system-booted-time>{booted}<time-length junos:seconds=\"396040\">4d 14:00</time-length></system-booted-time><protocols-started-time><date-time junos:seconds=\"1795076090\">2026-11-19 08:14:50 UTC</date-time><time-length junos:seconds=\"395910\">4d 13:58</time-length></protocols-started-time><uptime-information><date-time junos:seconds=\"1795472000\">10:13PM</date-time><up-time junos:seconds=\"396000\">4 days, 14 hrs</up-time></uptime-information></system-uptime-information>"


def _sw(model: str, version: str) -> str:
    return "<software-information><host-name>r1</host-name><product-model>{model}</product-model><product-name>{model}</product-name><junos-version>{version}</junos-version></software-information>"


def _test_platform_from_replies():
    mx = _sw("mx204", "23.4R2-S3.9")
    re0 = _sw("mx960", "23.4R2.13")
    re1 = _sw("mx960", "22.4R3.25")
    cases: list[(label: str, software: ?xml.Node, system: ?xml.Node, want: str)] = [
        (label="hardware",
         software=_reply(mx),
         system=_reply("<system-information><hardware-model>mx204</hardware-model><os-name>junos</os-name><os-version>23.4R2-S3.9</os-version><serial-number>BT1234</serial-number><host-name>r1</host-name></system-information>"),
         want="junos 23.4R2-S3.9 mx204 BT1234"),
        (label="two-routing-engines-first-taken",
         software=_reply("<multi-routing-engine-results><multi-routing-engine-item><re-name>re0</re-name>{re0}</multi-routing-engine-item><multi-routing-engine-item><re-name>re1</re-name>{re1}</multi-routing-engine-item></multi-routing-engine-results>"),
         system=None,
         want="junos 23.4R2.13 mx960 None"),
        (label="system-information-failed",
         software=_reply(mx), system=None,
         want="junos 23.4R2-S3.9 mx204 None"),
        (label="no-junos-version-uses-os-version",
         software=_reply("<software-information><product-model>ex4300-48p</product-model></software-information>"),
         system=_reply("<system-information><hardware-model>ex4300-48p</hardware-model><os-version>21.4R3.15</os-version></system-information>"),
         want="junos 21.4R3.15 ex4300-48p None"),
        (label="whitespace-around-text",
         software=_reply("<software-information>\n<product-model>\nvmx\n</product-model>\n<junos-version> 24.2R1.17 </junos-version>\n</software-information>"),
         system=None,
         want="junos 24.2R1.17 vmx None"),
    ]
    for c in cases:
        p = junos.platform(c.software, c.system, None)
        testing.assertEqual(c.want, _show(p), c.label)


def _test_last_boot_from_reply():
    """The last boot is the junos:seconds of system-booted-time, whatever
    time zone the device prints it in. A reply without a number there gives
    no last boot."""
    booted = "<date-time junos:seconds=\"1795075960\">2026-11-19 08:12:40 UTC</date-time>"
    cases: list[(label: str, uptime: ?xml.Node, want: ?int)] = [
        (label="utc", uptime=_reply(_uptime(booted)), want=BOOT),
        (label="other time zone",
         uptime=_reply(_uptime("<date-time junos:seconds=\"1795075960\">2026-11-19 09:12:40 CET</date-time>")),
         want=BOOT),
        (label="two routing engines, first taken",
         uptime=_reply("<multi-routing-engine-results><multi-routing-engine-item><re-name>re0</re-name>{_uptime(booted)}</multi-routing-engine-item><multi-routing-engine-item><re-name>re1</re-name>{_uptime("<date-time junos:seconds=\"1795000000\">2026-11-18 11:06:40 UTC</date-time>")}</multi-routing-engine-item></multi-routing-engine-results>"),
         want=BOOT),
        (label="no seconds", uptime=_reply(_uptime("<date-time>2026-11-19 08:12:40 UTC</date-time>")), want=None),
        (label="seconds not a number",
         uptime=_reply(_uptime("<date-time junos:seconds=\"-1\">1969-12-31 23:59:59 UTC</date-time>")),
         want=None),
        (label="epoch", uptime=_reply(_uptime("<date-time junos:seconds=\"0\">1970-01-01 00:00:00 UTC</date-time>")),
         want=None),
        (label="no system-booted-time", uptime=_reply("<system-uptime-information/>"), want=None),
        (label="uptime RPC failed", uptime=None, want=None),
    ]
    software = _reply(_sw("mx204", "23.4R2-S3.9"))
    for c in cases:
        p = junos.platform(software, None, c.uptime)
        if p is not None:
            testing.assertEqual(c.want, p.last_boot, c.label)
            testing.assertEqual("junos 23.4R2-S3.9 mx204 None", _show(p), "{c.label}: the rest")
        else:
            testing.error("{c.label}: no platform")


def _test_platform_without_values():
    """Replies with neither a model nor a release are no platform."""
    testing.assertTrue(junos.platform(None, None, None) is None, "no replies")
    empty = _reply("<software-information><host-name>r1</host-name></software-information>")
    testing.assertTrue(junos.platform(empty, _reply(""), _reply(_uptime(""))) is None, "empty replies")


def _test_probe_applies_on_its_module():
    m = junos.MODULE
    testing.assertTrue(junos.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not junos.PROBE.applies({"junos-conf-root": ModCap("junos-conf-root", "urn:y")}),
                       "the device does not list the module")


def _test_probe_applies_to_junos_without_yang():
    # The hello of a Junos 10.4, which lists no modules
    modset = swna.modset_from_capabilities([
        "urn:ietf:params:xml:ns:netconf:base:1.0",
        "urn:ietf:params:xml:ns:netconf:capability:candidate:1.0",
        "http://xml.juniper.net/netconf/junos/1.0",
        "http://xml.juniper.net/dmi/system/1.0",
    ])
    testing.assertTrue(junos.PROBE.applies(modset), "the hello has the Junos capability")
