"""Pruned IOS XE YANG modules for the software adapter and the platform probe.

Apps must add them to the device-type schema: `DeviceMgr.rpc` validates RPCs
against it and `get` uses it to parse replies.

Loose on purpose, so unexpected device output parses instead of failing:
enums are plain strings and the install oper lists have no keys; the
hardware inventory keeps its keys.
"""

xcopy_rpc = r"""module Cisco-IOS-XE-xcopy-rpc {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-xcopy-rpc";
  prefix xcopy-ios-xe-rpc;

  description
    "Pruned to the file copy that stages an image. The device fetches it
     itself, over scp, ftp, http or https; the URL must therefore be reachable
     from the device rather than from us.

     The destination is a bare filename: the device prepends /bootflash itself,
     so passing a path doubles it and the operation fails.

     Unlike the install RPCs, which are input-only, xcopy declares an output. It
     must be declared here too: the reply is parsed against this schema, and an
     undeclared output fails the call with 'Unexpected rpc-reply' after the
     device has already transferred the image. The output carries only the uuid
     we sent, so it confirms nothing about the copy -- progress is read from
     install-oper-data like everything else.";

  rpc xcopy {
    input {
      leaf uuid { type string; }
      leaf source-path { type string; }
      leaf destination-path { type string; }
    }
    output {
      leaf uuid { type string; }
    }
  }
}
"""

install_rpc = r"""module Cisco-IOS-XE-install-rpc {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-install-rpc";
  prefix install-ios-xe-rpc;

  description
    "Pruned to the five RPCs the adapter sends: install (add), activate,
     install-commit, abort and remove. The real module has ten, all
     input-only: they reply <ok/> meaning accepted, and progress arrives in
     install-oper-data under the uuid.

     Without `one-shot`, `install` only adds the image. `activate` boots it
     with an auto-abort timer; the device reverts unless `install-commit`
     arrives before the timer runs out.";

  rpc install {
    input {
      leaf uuid {
        description "Correlates the operation with its records in
          install-oper-data. The real module caps this at 128 characters on
          some RPCs and not others.";
        type string;
        mandatory true;
      }
      leaf one-shot { type boolean; }
      leaf path {
        description "bootflash:<filename> to add an already-staged file. The
          real module limits this to 256 characters, where xcopy's paths allow
          4096, so a URL xcopy accepts can be too long here.";
        type string;
      }
    }
  }

  rpc activate {
    input {
      leaf uuid { type string; mandatory true; }
      leaf auto-abort-timer-val {
        description "Minutes until the device aborts an uncommitted
          activation. 30 is the smallest value the device accepts.";
        type uint32 { range "30 .. 1200"; }
        units "minutes";
      }
      leaf version {
        description "Version of an already-added image, from
          install-version-state-info. Activating an added image by its
          bootflash path fails; it must be named by version.";
        type string;
      }
    }
  }

  rpc install-commit {
    input {
      leaf uuid { type string; mandatory true; }
    }
  }

  rpc abort {
    input {
      leaf uuid { type string; mandatory true; }
    }
  }

  rpc remove {
    input {
      leaf uuid { type string; mandatory true; }
      leaf inactive {
        description "Remove the software that the device does not run, and
          the image files that it does not use. The real module has a
          choice of what to remove; the adapter removes only this.";
        type boolean;
      }
    }
  }
}
"""

install_oper = r"""module Cisco-IOS-XE-install-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-install-oper";
  prefix install-ios-xe-oper;

  description
    "Pruned to the operation records, which are how an asynchronous install
     reports progress, and the version state, which names the added image so
     it can be activated. One RPC produces several records sharing an op-uuid
     and differing in op-id, and a record moves from install-oper to
     install-oper-hist when it finishes -- so both lists have to be read.
     The sub-state log of each transaction is left out.";

  grouping transaction {
    leaf txn-cmd    { type string; }
    leaf txn-status { type string; }
    leaf txn-sub-state {
      description "Why a failed transaction failed, e.g.
        install-download-fail. The device has no free-text error here.";
      type string;
    }
  }

  grouping operation {
    leaf op-uuid   { type string; }
    leaf op-id     { type string; }
    leaf op-status { type string; }
    leaf op-done   { type string; }
    list install-txn-summary-op {
      description "The transactions while op-done is op-not-complete.";
      uses transaction;
    }
    list install-txn-sum-op-hist {
      description "The transactions once op-done is op-complete, also while
        the record is still in install-oper.";
      uses transaction;
    }
  }

  container install-oper-data {
    config false;

    list install-oper {
      description "Operations currently executing.";
      uses operation;
    }

    list install-oper-hist {
      description "Finished operations retained by the device. Each attempt
        needs a new uuid.";
      uses operation;
    }

    list install-location-information {
      description "Per-location install detail. Pruned to the version state
        and the abort timer: after an add the device names the added image
        here, and `activate` needs that version. The real list is keyed by fru/slot/bay/chassis
        and carries large siblings like install-packages, left out here.";
      list install-version-state-info {
        description "One entry per known image version and its state, e.g.
          provisioned-committed for the running image and
          provisioned-uncommitted for one added but not yet committed.";
        leaf version-state { type string; }
        leaf version        { type string; }
      }
      container oper-state {
        container auto-abort-timer {
          description "While an activated release is not committed, the
            device goes back at end-time.";
          leaf state { type string; }
          leaf end-time { type string; }
        }
        leaf boot-mode {
          description "install-boot-mode-install when the device boots
            packages.conf, install-boot-mode-bundle when it booted an image
            file.";
          type string;
        }
      }
    }
  }
}
"""

device_hardware_oper = r"""module Cisco-IOS-XE-device-hardware-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-device-hardware-oper";
  prefix device-hardware-xe-oper;

  description
    "Pruned to the running release, which is how the impacting step is known to
     have landed, and to the inventory entry that names the chassis.";

  container device-hardware-data {
    config false;
    container device-hardware {
      list device-inventory {
        description "The chassis entry's part-number is the product id, e.g.
          C8000V.";
        key "hw-type hw-dev-index";
        leaf hw-type       { type string; }
        leaf hw-dev-index  { type uint32; }
        leaf part-number   { type string; }
        leaf serial-number { type string; }
      }
      container device-system-data {
        leaf software-version {
          description "Carries a whole banner line, not a bare version:
            'Cisco IOS XE Software, Version 17.18.02'.";
          type string;
        }
      }
    }
  }
}
"""

platform_software_oper = r"""module Cisco-IOS-XE-platform-software-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-platform-software-oper";
  prefix platform-sw-ios-xe-oper;

  description
    "Pruned to the size, the use and the files of each partition, which tell
     whether an image is on the device and whether there is room for one. A
     C1111 sends q-filesystem without its location keys, so the
     list has no key here. The files of a partition are recursive, with paths
     such as /bootflash/packages.conf.";

  container cisco-platform-software {
    config false;
    list q-filesystem {
      list partitions {
        key "name";
        leaf name { type string; }
        leaf total-size {
          description "In KiB: 2818084 on the bootflash of a C1111, which dir
            shows as 2885718016 bytes total.";
          type uint64;
        }
        leaf used-size {
          description "In KiB, as total-size.";
          type uint64;
        }
        list partition-content {
          key "full-path";
          leaf full-path { type string; }
          leaf size { type uint64; units "bytes"; }
        }
      }
    }
  }
}
"""

cisco_rpc = r"""module Cisco-IOS-XE-rpc {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-rpc";
  prefix ios-xe-rpc;

  description
    "Pruned to delete, which removes an image file that install add refuses,
     so that the next run transfers it again.";

  rpc delete {
    input {
      leaf filename-drop-node-name {
        description "The file to delete, such as bootflash:a.bin.";
        mandatory true;
        type string;
      }
    }
    output {
      leaf result { type string; }
    }
  }
}
"""

## Modules an app must add to its IOS XE device type. Duplicate module
## namespaces fail schema compilation, preventing two definitions of the same
## module from being used.
models: list[str] = [
    xcopy_rpc,
    install_rpc,
    install_oper,
    device_hardware_oper,
    platform_software_oper,
    cisco_rpc,
]
