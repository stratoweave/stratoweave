#
# SR Linux platform probe: the release in a version, and replies other than
# the lab device's, which test_platform_lab covers.
#

import testing
import std.xml as xml
import yang
import yang.gdata as ygdata
import yang.xml as yxml

import device as swdev
import adapters.platform_srlinux as srlinux
import adapters.platform_srlinux_yang as srl_yang
from adapters.adapter import ModCap


def _show(p: ?swdev.Platform) -> str:
    if p is not None:
        return "{p.os} {p.version} {p.model} {p.serial_number}"
    return "no platform"


def _data(body: str) -> ygdata.Node:
    return yxml.from_xml(yang.compile(srl_yang.models), xml.decode("<data>{body}</data>"), loose=True)


def _version(v: str) -> ygdata.Node:
    return _data("<system xmlns=\"urn:nokia.com:srlinux:general:system\"><information xmlns=\"urn:nokia.com:srlinux:linux:system-info\"><version>{v}</version></information></system>")


def _chassis(body: str) -> ygdata.Node:
    return _data("<platform xmlns=\"urn:nokia.com:srlinux:chassis:platform\"><chassis xmlns=\"urn:nokia.com:srlinux:chassis:platform-chassis\">{body}</chassis></platform>")


def _test_release():
    cases: list[(version: ?str, want: ?str)] = [
        (version="v25.3.2-312-ga0c5002f15", want="25.3.2"),
        (version="v24.10.1-492-gf8858c5836", want="24.10.1"),
        (version="v23.10.1", want="23.10.1"),
        (version="25.3.2", want="25.3.2"),
        (version="v", want=None),
        (version="", want=None),
        (version=None, want=None),
    ]
    for c in cases:
        testing.assertEqual(c.want, srlinux.release(c.version), "release of {c.version}")


def _test_platform_from_replies():
    hw = _chassis("<type>7220 IXR-D3L</type><serial-number>NK123456789</serial-number>")
    cases: list[(label: str, version: ?ygdata.Node, chassis: ?ygdata.Node, want: str)] = [
        (label="hardware", version=_version("v24.10.1-492-gf8858c5836"), chassis=hw,
         want="srlinux 24.10.1 7220 IXR-D3L NK123456789"),
        (label="no-chassis", version=_version("v24.10.1-492-gf8858c5836"), chassis=None,
         want="srlinux 24.10.1 None None"),
        (label="no-version", version=None, chassis=hw,
         want="srlinux None 7220 IXR-D3L NK123456789"),
    ]
    for c in cases:
        p = srlinux.platform(c.version, c.chassis)
        testing.assertEqual(c.want, _show(p), c.label)
    testing.assertTrue(srlinux.platform(None, None) is None, "no replies")
    testing.assertTrue(srlinux.platform(ygdata.Container({}), ygdata.Container({})) is None, "empty replies")


def _test_probe_applies_with_both_modules():
    def mods(names: list[str]) -> dict[str, ModCap]:
        return {n: ModCap(n, "urn:" + n) for n in names}
    testing.assertTrue(srlinux.PROBE.applies(mods(srlinux.MODULES + ["srl_nokia-system"])),
                       "the device lists both modules")
    for m in srlinux.MODULES:
        testing.assertTrue(not srlinux.PROBE.applies(mods([m])), "the device lists only {m}")
