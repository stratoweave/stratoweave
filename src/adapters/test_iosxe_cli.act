        ("add, activate, commit", xecli_data.stratoweave_iosxe_cli__install__input(add=xecli_data.stratoweave_iosxe_cli__install__input__add(image, activate=True, commit=True, prompt_level="none")),
         "install add file " + image + " activate commit prompt-level none"),
        ("commit without activate", xecli_data.stratoweave_iosxe_cli__install__input(add=xecli_data.stratoweave_iosxe_cli__install__input__add(image, commit=True)), "error: install add needs activate to commit"),
        ("file with a space", xecli_data.stratoweave_iosxe_cli__install__input(add=xecli_data.stratoweave_iosxe_cli__install__input__add(image + " activate")), "error: invalid file or URL"),
        ("file with a question mark", xecli_data.stratoweave_iosxe_cli__install__input(add=xecli_data.stratoweave_iosxe_cli__install__input__add(image + "?")), "error: invalid file or URL"),
        ("file without a file system", xecli_data.stratoweave_iosxe_cli__install__input(add=xecli_data.stratoweave_iosxe_cli__install__input__add(SIGNED_IMAGE)), "error: invalid file or URL"),
        ("activate", xecli_data.stratoweave_iosxe_cli__install__input(activate=xecli_data.stratoweave_iosxe_cli__install__input__activate()), "install activate"),
        ("activate with a timer", xecli_data.stratoweave_iosxe_cli__install__input(activate=xecli_data.stratoweave_iosxe_cli__install__input__activate(auto_abort_timer=u64(120), prompt_level="none")),
         "install activate auto-abort-timer 120 prompt-level none"),
        ("commit", xecli_data.stratoweave_iosxe_cli__install__input(commit=True), "install commit"),
        ("abort", xecli_data.stratoweave_iosxe_cli__install__input(abort=True), "install abort"),
        ("remove inactive", xecli_data.stratoweave_iosxe_cli__install__input(remove=xecli_data.stratoweave_iosxe_cli__install__input__remove(inactive=True)), "install remove inactive"),
        ("remove a file", xecli_data.stratoweave_iosxe_cli__install__input(remove=xecli_data.stratoweave_iosxe_cli__install__input__remove(file="bootflash:old.pkg")), "install remove file bootflash:old.pkg"),
        ("roll back to committed", xecli_data.stratoweave_iosxe_cli__install__input(rollback=xecli_data.stratoweave_iosxe_cli__install__input__rollback(committed=True)), "install rollback to committed"),
        ("roll back to an id", xecli_data.stratoweave_iosxe_cli__install__input(rollback=xecli_data.stratoweave_iosxe_cli__install__input__rollback(id=u64(3))), "install rollback to id 3"),
        ("roll back to a label", xecli_data.stratoweave_iosxe_cli__install__input(rollback=xecli_data.stratoweave_iosxe_cli__install__input__rollback(label="before-17")), "install rollback to label before-17"),
        ("bad label", xecli_data.stratoweave_iosxe_cli__install__input(rollback=xecli_data.stratoweave_iosxe_cli__install__input__rollback(label="a b")), "error: invalid label"),
        ("no command", xecli_data.stratoweave_iosxe_cli__install__input(), "error: an install request must have exactly one command"),
        ("two commands", xecli_data.stratoweave_iosxe_cli__install__input(commit=True, abort=True), "error: an install request must have exactly one command"),
    ]
    for name, inp, want in cases:
