actor _test_session_answers_a_question(t: testing.EnvT):
    """A command that stops at a question in its answers gets the answer, and
    its output goes on to the prompt."""
    t.timeout(10.0)
    m = xecli.CliMock()
    m.set_question("install remove inactive", REMOVE_BEFORE, "y", REMOVE_AFTER)
    var session: ?xecli.CliSession = None

    def removed(output: ?str, err: ?Exception):
        try:
            if err is not None:
                raise err
            text = output if output is not None else ""
            testing.assertTrue(xecli.REMOVE_QUESTION + "y" in text, "the answer follows the question")
            testing.assertTrue(text.rstrip().endswith("SUCCESS: install_remove Tue Nov 10 13:57:46 UTC 2026"), text)
            xecli.check_install_output(text)
        except Exception as e:
            t.failure(e)
            return
        t.success()

    def ready():
        s = session
        if s is not None:
            s.run("install remove inactive", 2.0, removed, [(question=xecli.REMOVE_QUESTION, answer="y")])

    def ended(err: Exception):
        t.failure(err)

    session = xecli.CliSession(None, Dmc("xe", Credentials("admin", "admin")), m, 2.0, ready, ended)


actor _test_adapter_remove(t: testing.EnvT):
    """The install RPC with remove answers the question of the device."""
    t.timeout(10.0)
    m = xecli.CliMock()
    m.set_question("install remove inactive", REMOVE_BEFORE, "y", REMOVE_AFTER)
    var dev: ?swdev.DeviceMgr = None

    def removed(out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception):
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.reloading if out is not None else None, False)
            testing.assertEqual(m.get_commands(), ["install remove inactive"])
        except Exception as e:
            t.failure(e)
            return
        t.success()

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            r = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            r.install(removed, xecli_data.stratoweave_iosxe_cli__install__input(
                remove=xecli_data.stratoweave_iosxe_cli__install__input__remove(inactive=True)))
            return
        after 0.01: connected()

    dev = _mock_device(t, m)
    connected()


