actor _test_session(t: testing.EnvT):
    """A CliSession against a CliMock: commands run one at a time in the
    order they came, configure types into configure terminal, and a closed
    session fails the commands that come after."""
    t.timeout(10.0)
    m = _mock({"show version": SHOW_VERSION})
    var outputs: list[str] = []
    var finished = False
    var session: ?xecli.CliSession = None

    def finish(err: ?Exception):
        if not finished:
            finished = True
            if err is not None:
                t.failure(err)
            else:
                t.success()

    def after_close(output: ?str, err: ?Exception):
        try:
            testing.assertTrue(isinstance(err, NotConnectedError), "a closed session fails the command")
            testing.assertEqual(m.get_commands(), ["show version", "show versoin", "show version"])
            testing.assertEqual(m.get_configured(), ["hostname Router"])
        except Exception as e:
            finish(e)
            return
        finish(None)

    def collect(output: ?str, err: ?Exception):
        if err is not None:
            finish(err)
            return
        outputs.append(output if output is not None else "")
        if len(outputs) < 4:
            return
        s = session
        try:
            testing.assertTrue("Cisco IOS XE Software, Version 17.18.02" in outputs[0], "the output of show version")
            testing.assertTrue("% Invalid input detected" in outputs[1], "an unknown command: " + outputs[1])
            testing.assertTrue(outputs[2].endswith("Router#"), "configure ends at the exec prompt")
            testing.assertEqual(outputs[3], outputs[0], "show version after configure")
        except Exception as e:
            finish(e)
            return
        if s is not None:
            s.close()
            s.run("show version", 2.0, after_close)

    def ready():
        s = session
        if s is not None:
            s.run("show version", 2.0, collect)
            s.run("show versoin", 2.0, collect)
            s.configure(["hostname Router"], collect)
            s.run("show version", 2.0, collect)

    def ended(err: Exception):
        finish(err)

    session = xecli.CliSession(None, Dmc("xe", Credentials("admin", "admin")), m, 2.0, ready, ended)


