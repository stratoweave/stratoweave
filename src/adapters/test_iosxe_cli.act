def _test_check_install_output():
    reason = "ERROR: install_add: Booted in bundle mode. For Bundle-to-Install mode conversion, please use one-shot CLI - install add file <> activate commit"
    cases = [
        ("a failure with its reason", INSTALL_ADD_BUNDLE_MODE, reason),
        ("a failure without a reason", INSTALL_ADD_BUNDLE_MODE.replace(reason, ""), "FAILED: install_add  exit(1)"),
        ("a device error", "\r\n% Invalid input detected at '^' marker.\r\n", "% Invalid input"),
    ]
    for name, output, want in cases:
        try:
            xecli.check_install_output(output)
            testing.assertTrue(False, name + ": no error")
        except xecli.CommandError as e:
            testing.assertTrue(e.error_message.startswith(want), name + ": " + e.error_message)
    xecli.check_install_output("\r\n\r\n")


def _install_reply(inp: xecli_data.stratoweave_iosxe_cli__install__input, output: str) -> str:
    c = xecli.rpc_call(gdata.Container({_q("install"): inp.to_gdata()}))
    try:
        out = xecli_data.stratoweave_iosxe_cli__install__output.from_gdata(c.reply(output))
        return "reloading " + str(out.reloading)
    except Exception as e:
        return "error: " + str(e)


def _install_ended(inp: xecli_data.stratoweave_iosxe_cli__install__input, output: ?str) -> str:
    c = xecli.rpc_call(gdata.Container({_q("install"): inp.to_gdata()}))
    try:
        out = xecli_data.stratoweave_iosxe_cli__install__output.from_gdata(c.ended(output, ValueError("session closed")))
        return "reloading " + str(out.reloading)
    except Exception as e:
        return "error: " + str(e)


def _test_install_reload():
    image = "bootflash:" + SIGNED_IMAGE
    one_shot = xecli_data.stratoweave_iosxe_cli__install__input(
        add=xecli_data.stratoweave_iosxe_cli__install__input__add(image, activate=True, commit=True, prompt_level="none"))
    add = xecli_data.stratoweave_iosxe_cli__install__input(add=xecli_data.stratoweave_iosxe_cli__install__input__add(image))
    activate = xecli_data.stratoweave_iosxe_cli__install__input(activate=xecli_data.stratoweave_iosxe_cli__install__input__activate())
    commit = xecli_data.stratoweave_iosxe_cli__install__input(commit=True)
    started = INSTALL_ONE_SHOT[:INSTALL_ONE_SHOT.find("--- Starting Commit")]
    cases = [
        ("the device says it reloads", _install_reply(one_shot, INSTALL_ONE_SHOT), "reloading True"),
        ("the device reports a failure", _install_reply(add, INSTALL_ADD_BUNDLE_MODE), "error: "),
        ("a command that does not activate", _install_reply(commit, "\r\n\r\n"), "reloading False"),
        ("the session ends during an activation", _install_ended(activate, started), "reloading True"),
        ("the session ends after a failure", _install_ended(one_shot, INSTALL_ADD_BUNDLE_MODE), "error: "),
        ("the session ends without output", _install_ended(activate, None), "error: "),
        ("the session of an add ends", _install_ended(add, started), "error: "),
    ]
    for name, got, want in cases:
        testing.assertTrue(got.startswith(want), name + ": " + got)


def _dialog(lines: list[str], replies: dict[str, str], piece: int) -> (typed: list[str], error: ?str, finished: bool):
    """Run a ConfigDialog against replies, which map a typed command to what
    the device prints. The device output arrives in pieces of piece
    characters."""
    d = xecli.ConfigDialog(lines)
    typed = [t.rstrip() for t in d.start()]
    queue = list(typed)
    while len(queue) > 0 and len(typed) < 20:
        command = queue[0]
        queue = queue[1:]
        reply = replies.get(command)
        if reply is not None:
            i = 0
            while i < len(reply):
                for t in d.received(reply[i:i + piece]):
                    typed.append(t.rstrip())
                    queue.append(t.rstrip())
                i += piece
    return (typed=typed, error=d.error, finished=d.finished())


def _test_config_dialog():
    rejected = "hostnme Router: % Invalid input detected at '^' marker."
    locked = {# Constructed: the device answers configure terminal without a
              # configuration prompt.
              "configure terminal": "configure terminal\r\n% Configuration mode is locked\r\nRouter#"}
    cases = [
        ("an accepted line", ["hostname Router"], CONFIG_REPLIES, 1000,
         ["configure terminal", "hostname Router", "end"], None),
        ("output in pieces", ["hostname Router"], CONFIG_REPLIES, 3,
         ["configure terminal", "hostname Router", "end"], None),
        ("a rejected line stops the session", ["hostnme Router", "hostname Router"], CONFIG_REPLIES, 1000,
         ["configure terminal", "hostnme Router", "end"], rejected),
        ("a rejected line after an accepted one", ["hostname Router", "hostnme Router"], CONFIG_REPLIES, 7,
         ["configure terminal", "hostname Router", "hostnme Router", "end"], rejected),
        ("no configuration prompt", ["hostname Router"], locked, 1000,
         ["configure terminal"], "configure terminal: % Configuration mode is locked"),
    ]
    for name, lines, replies, piece, typed, error in cases:
        got = _dialog(lines, replies, piece)
        testing.assertEqual(got.typed, typed, name)
        testing.assertEqual(got.error, error, name)
        testing.assertTrue(got.finished, name + ": finished")


