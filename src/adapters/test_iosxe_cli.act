def _copy_result(output: str) -> str:
    try:
        return str(xecli.parse_copy(output))
    except xecli.CommandError as e:
        return "error: " + e.error_message


def _test_parse_copy():
    cases = [
        ("copied", COPY_DONE, "300000"),
        ("overwritten", COPY_OVERWRITE, "300000"),
        ("missing source", COPY_MISSING, "error: %Error opening http://192.168.1.234:8081/no-such-file.bin"),
        ("no count", _crlf("Accessing http://h/a.bin...\nLoading http://h/a.bin !!"), "error: copy output has no count"),
    ]
    for name, output, want in cases:
        got = _copy_result(output)
        testing.assertTrue(got.startswith(want), name + ": " + got)


def _test_copy_and_delete_answers():
    copy = xecli.CopyCall(xecli_data.stratoweave_iosxe_cli__copy__input(COPY_SOURCE, "bootflash:", "sw-copy-test.bin"))
    testing.assertEqual(copy.answers(), [(question="Destination filename [sw-copy-test.bin]?", answer=""),
                                         (question="[confirm]", answer="")])
    testing.assertEqual(copy.timeout(60.0), xecli.INSTALL_TIMEOUT)
    delete = xecli.DeleteCall(xecli_data.stratoweave_iosxe_cli__delete__input("bootflash:", "sw-copy-test.bin"))
    testing.assertEqual(delete.answers(), [(question="Delete filename [sw-copy-test.bin]?", answer=""),
                                           (question="[confirm]", answer="")])
    try:
        delete.reply(DELETE_MISSING)
        testing.error("a delete of a missing file passed")
    except xecli.CommandError as e:
        testing.assertTrue(e.error_message.startswith("%Error deleting"), e.error_message)


actor _test_adapter_copy(t: testing.EnvT):
    """The copy RPC answers the question for the destination file name and
    reports the size that the device copied."""
    t.timeout(10.0)
    m = xecli.CliMock()
    command = "copy " + COPY_SOURCE + " bootflash:sw-copy-test.bin"
    m.set_question(command, COPY_QUESTION, "", COPY_DONE)
    var dev: ?swdev.DeviceMgr = None

    def copied(out: ?xecli_data.stratoweave_iosxe_cli__copy__output, err: ?Exception):
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.size if out is not None else None, u64(300000))
            testing.assertEqual(m.get_commands(), [command])
        except Exception as e:
            t.failure(e)
            return
        t.success()

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            r = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            r.copy(copied, xecli_data.stratoweave_iosxe_cli__copy__input(COPY_SOURCE, "bootflash:", "sw-copy-test.bin"))
            return
        after 0.01: connected()

    dev = _mock_device(t, m)
    connected()


def _test_check_config_line():
    cases = [
        ("boot system flash bootflash:packages.conf", ""),
        ("no boot system", ""),
        ("hostname a?b", "invalid configuration command"),
        ("hostname a\nreload", "invalid configuration command"),
        ("hostname a\tb", "invalid configuration command"),
        ("hostname a\x7fb", "invalid configuration command"),
        ("   ", "invalid configuration command"),
    ]
    for line, want in cases:
        got = ""
        try:
            xecli.check_config_line(line)
        except ValueError as e:
            got = e.error_message
        testing.assertTrue(got.startswith(want), line + ": " + got)


def _test_write_memory_reply():
    call = xecli.rpc_call(gdata.Container({_q("write-memory"): gdata.Container({})}))
    testing.assertEqual(call.command, "write memory")
    call.reply(WRITE_MEMORY)
    for name, output, want in [
        ("no [OK]", "Building configuration...\r\n", "write memory output has no [OK]"),
        ("an error", "\r\n%Error opening nvram:startup-config\r\n", "%Error opening"),
    ]:
        try:
            call.reply(output)
            testing.assertTrue(False, name + ": no error")
        except xecli.CommandError as e:
            testing.assertTrue(e.error_message.startswith(want), name + ": " + e.error_message)


def _configure_request(lines: list[str]) -> gdata.Node:
    inp = xecli_data.stratoweave_iosxe_cli__configure__input(line=lines)
    return gdata.Container({_q("configure"): inp.to_gdata()})


def _test_configure_lines():
    boot = ["no boot system", "boot system flash bootflash:packages.conf"]
    write = gdata.Container({_q("write-memory"): gdata.Container({})})
    cases = [
        ("two lines", _configure_request(boot), "no boot system | boot system flash bootflash:packages.conf"),
        ("another RPC", write, "none"),
        ("a line with ?", _configure_request(["hostname a?"]), "error: invalid configuration command"),
        ("two RPCs", gdata.Container({_q("configure"): gdata.Container({}), _q("write-memory"): gdata.Container({})}),
         "error: an RPC request must have exactly one child"),
    ]
    for name, request, want in cases:
        got = ""
        try:
            lines = xecli.configure_lines(request)
            got = " | ".join(lines) if lines is not None else "none"
        except ValueError as e:
            got = "error: " + e.error_message
        testing.assertTrue(got.startswith(want), name + ": " + got)


def _bootvar(output: str) -> str:
    try:
        b = xecli.parse_bootvar(output)
        return " ".join(list(b.boot)) + " | " + _opt(b.config_file) + " " + _opt(b.bootldr) + " " + \
            _opt(b.configuration_register) + " " + _opt(b.next_configuration_register)
    except xecli.CommandError as e:
        return "error: " + e.error_message


def _test_parse_bootvar():
    two = "bootflash:c1100-universalk9_ias.16.08.01.SPA.bin,1;bootflash:c1100-universalk9.17.09.05a.SPA.bin,1;"
    cases = [
        ("install mode", BOOTVAR_INSTALL, "bootflash:packages.conf | - - 0x2102 -"),
        ("two files, in order", BOOTVAR_INSTALL.replace("bootflash:packages.conf,1;", two),
         "bootflash:c1100-universalk9_ias.16.08.01.SPA.bin bootflash:c1100-universalk9.17.09.05a.SPA.bin | - - 0x2102 -"),
        ("no files", BOOTVAR_INSTALL.replace("bootflash:packages.conf,1;", ""), " | - - 0x2102 -"),
        ("a config file", BOOTVAR_INSTALL.replace("CONFIG_FILE variable does not exist", "CONFIG_FILE variable = bootflash:x.cfg"),
         "bootflash:packages.conf | bootflash:x.cfg - 0x2102 -"),
        ("a new register at the next reload",
         BOOTVAR_INSTALL.replace("is 0x2102", "is 0x2142 (will be 0x2102 at next reload)"),
         "bootflash:packages.conf | - - 0x2142 0x2102"),
        ("no BOOT variable", BOOTVAR_INSTALL.replace("BOOT variable", "BOOT setting"), "error: show bootvar output has no BOOT variable"),
        ("an error", "\r\n% Invalid input detected at '^' marker.\r\n", "error: % Invalid input"),
    ]
    for name, output, want in cases:
        got = _bootvar(output)
        testing.assertTrue(got.startswith(want), name + ": " + got)


def _test_parse_install_summary():
    got = xecli.parse_install_summary(INSTALL_SUMMARY)
    testing.assertEqual(got.auto_abort_timer, "inactive")
    rows = [loc.name + " " + p.name + " " + _opt(p.type) + " " + _opt(p.state) for loc in got.location for p in loc.package]
    testing.assertEqual(rows, ["R0 17.09.05a.0.6476 IMG activated-committed"])
    # 16.8.1 in bundle mode prints nothing.
    empty = xecli.parse_install_summary("\r\n")
    testing.assertEqual(len(empty.location), 0, "bundle mode has no locations")
    testing.assertEqual(empty.auto_abort_timer, None)
    for name, output, want in [
        ("unknown state", INSTALL_SUMMARY.replace("IMG   C ", "IMG   X "), "unexpected show install summary line: IMG   X"),
        ("no location", INSTALL_SUMMARY.replace("[ R0 ] ", ""), "show install summary output has no location"),
        ("error", "\r\n% Invalid input detected at '^' marker.\r\n", "% Invalid input"),
    ]:
        try:
            xecli.parse_install_summary(output)
            testing.assertTrue(False, name + ": no error")
        except xecli.CommandError as e:
            testing.assertTrue(e.error_message.startswith(want), name + ": " + e.error_message)


def _opt(value: ?str) -> str:
    return value if value is not None else "-"


def _command(file_system: str, file: str, algorithm: str) -> str:
    try:
        return xecli.verify_command(file_system, file, algorithm)
    except ValueError as e:
        return "error: " + e.error_message


def _test_verify_command():
    cases = [
        ("bootflash:", IMAGE, "md5", "verify /md5 bootflash:sw-xe-image-staging.bin"),
        ("harddisk:", "c8000v-universalk9.17.18.02.SPA.bin", "sha512", "verify /sha512 harddisk:c8000v-universalk9.17.18.02.SPA.bin"),
        ("bootflash:", "sw.bin;reload", "md5", "error: invalid file name: sw.bin;reload"),
        ("bootflash:", "sw.bin | redirect bootflash:x", "md5", "error: invalid file name"),
        ("bootflash:", "dir/sw.bin", "md5", "error: invalid file name"),
        ("bootflash:", "..", "md5", "error: invalid file name"),
        ("bootflash:", "", "md5", "error: invalid file name"),
        ("bootflash", IMAGE, "md5", "error: invalid file system name: bootflash"),
        (":", IMAGE, "md5", "error: invalid file system name"),
        ("boot flash:", IMAGE, "md5", "error: invalid file system name"),
        ("bootflash:", IMAGE, "sha256", "error: unsupported checksum algorithm: sha256"),
    ]
    for file_system, file, algorithm, want in cases:
        got = _command(file_system, file, algorithm)
        testing.assertTrue(got.startswith(want), file_system + " " + file + " " + algorithm + ": " + got)
    testing.assertEqual(xecli.dir_command("bootflash:"), "dir bootflash:")


def _fs(names: list[str]) -> gdata.FNode:
    """Return a filter of file-systems that selects these file systems by name."""
    return gdata.FNode(_q("file-systems"), children=[
        gdata.FNode(_q("file-system"), children=[gdata.FNode(_q("name"), value_match=n)]) for n in names])


def _top(children: list[gdata.FNode]) -> gdata.FNode:
    return gdata.FNode(children=children)


def _test_file_systems_selected():
    whole = gdata.FNode(_q("file-systems"))
    unnamed = gdata.FNode(_q("file-systems"), children=[
        gdata.FNode(_q("file-system"), children=[gdata.FNode(_q("file"))])])
    cases = [
        ("whole node", whole, ["bootflash:"]),
        ("file-system without a name", unnamed, ["bootflash:"]),
        ("one name", _fs(["harddisk:"]), ["harddisk:"]),
        ("two names", _fs(["harddisk:", "bootflash:"]), ["harddisk:", "bootflash:"]),
        ("the same name twice", _fs(["bootflash:", "bootflash:"]), ["bootflash:"]),
    ]
    for name, top, want in cases:
        testing.assertEqual(xecli.file_systems_selected(top), want, name)


def _reads_error(filt: ?gdata.FNode) -> str:
    try:
        xecli.reads(filt)
    except ValueError as e:
        return e.error_message
    return "no error"


def _test_reads():
    version = gdata.FNode(_q("version"))
    other = gdata.FNode(gdata.Id("urn:other", "system"))
    cases = [
        ("no filter", None, ["dir bootflash:", "show version", "show bootvar", "show install summary"]),
        ("file-systems", _top([_fs(["harddisk:"])]), ["dir harddisk:"]),
        ("install summary", _top([gdata.FNode(_q("install-summary"))]), ["show install summary"]),
        ("bootvar", _top([gdata.FNode(_q("bootvar"))]), ["show bootvar"]),
        ("version", _top([version]), ["show version"]),
        ("version leaf", _top([gdata.FNode(_q("version"), children=[gdata.FNode(_q("model"))])]), ["show version"]),
        ("filter rooted at version", version, ["show version"]),
        ("filter rooted at file-systems", _fs(["harddisk:"]), ["dir harddisk:"]),
        ("both nodes", _top([version, _fs(["bootflash:", "harddisk:"])]), ["show version", "dir bootflash:", "dir harddisk:"]),
        ("the same node twice", _top([version, version]), ["show version"]),
        ("another module", _top([other]), []),
        ("another module and version", _top([other, version]), ["show version"]),
    ]
    for name, filt, want in cases:
        testing.assertEqual([r.command for r in xecli.reads(filt)], want, name)
    testing.assertTrue(_reads_error(_top([_fs(["boot flash:"])])).startswith("invalid file system name"), "bad name")


def _test_parse_version():
    v = xecli.parse_version(SHOW_VERSION)
    testing.assertEqual((v.version, v.model, v.serial_number, v.system_image),
                        ("17.18.02", "C8000V", "9KSKL403GG7", "bootflash:packages.conf"))
    # Only the first lines: the release, but no hardware.
    head = SHOW_VERSION[:SHOW_VERSION.find("Technical Support")]
    v = xecli.parse_version(head)
    testing.assertEqual((v.version, v.model, v.serial_number, v.system_image), ("17.18.02", None, None, None))


def _version_error(output: str) -> str:
    try:
        xecli.parse_version(output)
    except xecli.CommandError as e:
        return e.error_message
    return "no error"


def _test_parse_version_errors():
    cases = [
        ("unknown command", _crlf("\n\n\nLine has invalid autocommand \"show versoin\""), "Line has invalid autocommand"),
        ("no release", SHOW_VERSION.replace("Cisco IOS XE Software, Version", "Cisco IOS Software, Version"),
         "show version output has no IOS XE release"),
        ("empty", "", "show version output has no IOS XE release"),
    ]
    for name, output, want in cases:
        got = _version_error(output)
        testing.assertTrue(got.startswith(want), name + ": " + got)


def _test_reads_fill_the_tree():
    r = xecli_data.root()
    xecli.DirRead("bootflash:").parse(r, DIR_BOOTFLASH)
    xecli.VersionRead().parse(r, SHOW_VERSION)
    back = xecli_data.root.from_gdata(r.to_gdata())
    fs = back.file_systems.file_system["bootflash:"]
    testing.assertEqual([f.name + " " + str(f.size) + " " + str(f.modified) for f in fs.file], BOOTFLASH_FILES)
    testing.assertEqual(back.version.model, "C8000V")


def _rpc_error(request: gdata.Node) -> str:
    try:
        xecli.rpc_call(request)
    except ValueError as e:
        return e.error_message
    return "no error"


def _test_rpc_call():
    body = xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", IMAGE, "md5").to_gdata()
    c = xecli.rpc_call(gdata.Container({_q("verify"): body}))
    testing.assertEqual(c.command, "verify /md5 bootflash:" + IMAGE)
    out = xecli_data.stratoweave_iosxe_cli__verify__output.from_gdata(c.reply(VERIFY_MD5))
    testing.assertEqual(out.digest, IMAGE_MD5)
    testing.assertEqual(out.verified, None)
    forms = [
        ("an image", xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", SIGNED_IMAGE), VERIFY_IMAGE, None, True),
        ("an equal hash", xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", OLD_IMAGE, "md5", OLD_IMAGE_MD5), VERIFY_MD5_EQUAL, OLD_IMAGE_MD5, True),
        ("another hash", xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", OLD_IMAGE, "md5", "0" * 32), VERIFY_MD5_DIFFERS, OLD_IMAGE_MD5, False),
    ]
    for name, inp, output, digest, verified in forms:
        call = xecli.rpc_call(gdata.Container({_q("verify"): inp.to_gdata()}))
        got = xecli_data.stratoweave_iosxe_cli__verify__output.from_gdata(call.reply(output))
        testing.assertEqual(got.digest, digest, name)
        testing.assertEqual(got.verified, verified, name)
    bad = xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", "a;b", "md5").to_gdata()
    other = gdata.Id("http://cisco.com/ns/yang/Cisco-IOS-XE-xcopy-rpc", "xcopy")
    cases = [
        ("another RPC", gdata.Container({other: body}), "RPC "),
        ("two RPCs", gdata.Container({_q("verify"): body, other: body}), "an RPC request must have exactly one child"),
        ("no RPC", gdata.Container({}), "an RPC request must have exactly one child"),
        ("bad file name", gdata.Container({_q("verify"): bad}), "invalid file name: a;b"),
    ]
    for name, request, want in cases:
        got = _rpc_error(request)
        testing.assertTrue(got.startswith(want), name + ": " + got)


actor _test_adapter_install(t: testing.EnvT):
    """The install RPC and a read of the version and the install summary
    together, through DeviceMgr."""
    t.timeout(10.0)
    image = "bootflash:" + SIGNED_IMAGE
    m = _mock({
        "show version": SHOW_VERSION,
        "show install summary": INSTALL_SUMMARY,
        "install add file " + image: _crlf("\n\n"),
    })
    var dev: ?swdev.DeviceMgr = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def added(out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception):
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.reloading if out is not None else None, False)
            testing.assertEqual(m.get_commands(), ["show version", "show install summary", "install add file " + image])
        except Exception as e:
            finish(e)
            return
        finish(None)

    def read(tree: ?gdata.Node, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            got = xecli_data.root.from_gdata(tree)
            testing.assertEqual(got.version.version, "17.18.02")
            testing.assertEqual(got.install_summary.auto_abort_timer, "inactive")
            testing.assertEqual([p.name for loc in got.install_summary.location for p in loc.package], ["17.09.05a.0.6476"])
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.install(added, xecli_data.stratoweave_iosxe_cli__install__input(
                add=xecli_data.stratoweave_iosxe_cli__install__input__add(image)))

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            rpcs = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            d.get(read, _top([gdata.FNode(_q("version")), gdata.FNode(_q("install-summary"))]))
            return
        after 0.01: connected()

    dev = _mock_device(t, m)
    connected()


actor _test_mock_mode(t: testing.EnvT):
    """In mock mode, the adapter answers from its CliMock: reads, RPCs and
    configuration sessions, without SSH."""
    t.timeout(10.0)
    var dev: ?swdev.DeviceMgr = None
    var mock: ?xecli.CliMock = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False

    def finish(err: ?Exception):
        if not finished:
            finished = True
            if err is not None:
                t.failure(err)
            else:
                t.success()

    def rejected(err: ?Exception):
        m = mock
        try:
            testing.assertTrue(isinstance(err, xecli.CommandError), "a rejected line fails")
            if err is not None:
                testing.assertEqual(err.error_message, "hostnme Router: % Invalid input detected at '^' marker.")
            if m is not None:
                testing.assertEqual(m.get_configured(), ["boot system flash bootflash:packages.conf"])
        except Exception as e:
            finish(e)
            return
        finish(None)

    def configured(err: ?Exception):
        r = rpcs
        if err is not None:
            finish(err)
        elif r is not None:
            r.configure(rejected, xecli_data.stratoweave_iosxe_cli__configure__input(line=["hostnme Router"]))

    def verified(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.verified if out is not None else None, True)
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.configure(configured, xecli_data.stratoweave_iosxe_cli__configure__input(
                line=["boot system flash bootflash:packages.conf"]))

    def read(tree: ?gdata.Node, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            testing.assertEqual(xecli_data.root.from_gdata(tree).version.version, "17.18.02")
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.verify(verified, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", OLD_IMAGE, "md5", OLD_IMAGE_MD5))

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            adapter = d.get_adapter()
            if isinstance(adapter, xecli.IosXeCliAdapter):
                m = adapter.get_mock()
                if m is not None:
                    mock = m
                    m.set_reply("show version", SHOW_VERSION)
                    m.set_reply("verify /md5 bootflash:" + OLD_IMAGE + " " + OLD_IMAGE_MD5, VERIFY_MD5_EQUAL)
                    m.set_reply("hostnme Router", CONFIG_REPLIES["hostnme Router"])
                    rpcs = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
                    d.get(read, _top([gdata.FNode(_q("version"))]))
                    return
            finish(ValueError("no CliMock in mock mode"))
            return
        after 0.01: connected()

    schema = yang.compile(xecli_yang.models)
    types = {"iosxe-cli": swdev.DeviceType("iosxe-cli", _fast_adapter, schema, oper_src_dnode=schema)}
    d = swdev.DeviceMgr(types, t.env, "xe", t.log_handler, lambda name: None, swdev.SchemaRegistry())
    dmc = Dmc("xe", Credentials("admin", "admin"), type="iosxe-cli")
    dmc.mock.enabled = True
    d.set_dmc(dmc)
    dev = d
    connected()


def _fast_adapter(dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, dmc: Dmc, registry: swdev.SchemaRegistry,
                  log_handler: logging.Handler, env: ?Env) -> DeviceAdapter:
    return xecli.IosXeCliAdapter(dev, bundled_schema, dmc, registry, log_handler, env,
                                 command_timeout=2.0, rpc_timeout=2.0)


def _mock(replies: dict[str, str]) -> xecli.CliMock:
    """Return a CliMock that answers the commands in replies."""
    m = xecli.CliMock()
    for command, output in replies.items():
        m.set_reply(command, output)
    return m


def _mock_adapter(m: xecli.CliMock) -> proc(swdev.DeviceMgr, DeviceSchema, Dmc, swdev.SchemaRegistry, logging.Handler, ?Env) -> DeviceAdapter:
    """Return an adapter type whose adapters run against m."""
    def adapter(dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, dmc: Dmc, registry: swdev.SchemaRegistry,
                log_handler: logging.Handler, env: ?Env) -> DeviceAdapter:
        return xecli.IosXeCliAdapter(dev, bundled_schema, dmc, registry, log_handler, None,
                                     command_timeout=2.0, rpc_timeout=2.0, mock=m)
    return adapter


def _mock_device(t: testing.EnvT, m: xecli.CliMock) -> swdev.DeviceMgr:
    """Return a DeviceMgr for one device whose CLI runs against m."""
    schema = yang.compile(xecli_yang.models)
    types = {"iosxe-cli": swdev.DeviceType("iosxe-cli", _mock_adapter(m), schema, oper_src_dnode=schema)}
    dev = swdev.DeviceMgr(types, t.env, "xe", t.log_handler, lambda name: None, swdev.SchemaRegistry())
    dev.set_dmc(Dmc("xe", Credentials("admin", "admin"), type="iosxe-cli"))
    return dev


def _device(t: testing.EnvT, adapter_type: proc(swdev.DeviceMgr, DeviceSchema, Dmc, swdev.SchemaRegistry, logging.Handler, ?Env) -> DeviceAdapter,
            on_reconf: action(str) -> None, address: str, port: int, credentials: Credentials,
            ssh: ?Ssh=None) -> swdev.DeviceMgr:
    """Return a DeviceMgr for one device of a device type that uses adapter_type."""
    schema = yang.compile(xecli_yang.models)
    types = {"iosxe-cli": swdev.DeviceType("iosxe-cli", adapter_type, schema, oper_src_dnode=schema)}
    dev = swdev.DeviceMgr(types, t.env, "xe", t.log_handler, on_reconf, swdev.SchemaRegistry())
    dmc = Dmc("xe", credentials, type="iosxe-cli")
    if ssh is not None:
        dmc.ssh = ssh
    dmc.address.create("primary", address, port=u64(port))
    dev.set_dmc(dmc)
    return dev


actor _test_adapter_reads_and_checksums(t: testing.EnvT):
    """Reads of each node and verify RPCs through DeviceMgr."""
    t.timeout(10.0)
    m = _mock({
        "dir bootflash:": DIR_BOOTFLASH,
        "show version": SHOW_VERSION,
        "verify /md5 bootflash:" + IMAGE: VERIFY_MD5,
        "verify /md5 bootflash:no-such-file.bin": VERIFY_MISSING,
    })
    var dev: ?swdev.DeviceMgr = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def missing_checked(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        try:
            testing.assertTrue(isinstance(err, xecli.CommandError), "a missing file is a command error")
            if err is not None:
                testing.assertTrue(err.error_message.startswith("%Error computing MD5 hash"), err.error_message)
            testing.assertEqual(m.get_commands(), [
                "dir bootflash:",
                "show version",
                "verify /md5 bootflash:" + IMAGE,
                "verify /md5 bootflash:no-such-file.bin",
            ])
        except Exception as e:
            finish(e)
            return
        finish(None)

    def checksummed(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.digest if out is not None else None, IMAGE_MD5)
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.verify(missing_checked, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", "no-such-file.bin", "md5"))

    def versioned(tree: ?gdata.Node, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            got = xecli_data.root.from_gdata(tree)
            v = got.version
            testing.assertEqual((v.version, v.model, v.serial_number, v.system_image),
                                ("17.18.02", "C8000V", "9KSKL403GG7", "bootflash:packages.conf"))
            testing.assertEqual(len(got.file_systems.file_system), 0, "a version read has no files")
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.verify(checksummed, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", IMAGE, "md5"))

    def listed(tree: ?gdata.Node, err: ?Exception):
        d = dev
        try:
            if err is not None:
                raise err
            got = xecli_data.root.from_gdata(tree)
            fs = got.file_systems.file_system["bootflash:"]
            testing.assertEqual([f.name + " " + str(f.size) + " " + str(f.modified) for f in fs.file], BOOTFLASH_FILES)
            testing.assertEqual(got.version.version, None, "a file read has no version")
        except Exception as e:
            finish(e)
            return
        if d is not None:
            d.get(versioned, _top([gdata.FNode(_q("version"))]))

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            rpcs = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            d.get(listed, _top([_fs(["bootflash:"])]))
            return
        after 0.01: connected()

    dev = _mock_device(t, m)
    connected()


actor _FakeXe(t: testing.EnvT, replies: dict[str, str], on_listen: action(int) -> None):
    """An SSH server that acts as the shell of an IOS XE device. It prints a
    prompt, echoes each line that the client types, and answers it with the
    output in replies, or as IOS XE answers a command that it does not know.
    It accepts the terminal commands of a session. It takes the password
    admin of the user admin only.
    """
    var commands: list[str] = []
    var typed = b""

    def _on_listen(s: ssh.Server, err: ?str):
        if err is not None:
            on_listen(0)
        else:
            on_listen(int(s.bound_port()))

    def _on_server_close(s: ssh.Server, reason: str):
        pass

    def _on_session(session: ssh.ServerSession):
        pass

    def _on_auth(session: ssh.ServerSession, request: ssh.AuthRequest):
        if request.method == "password" and request.user == "admin" and request.password == "admin":
            session.accept_auth()
        else:
            session.reject_auth("invalid credentials")

    def _run(channel: ssh.ServerChannel, line: str):
        if line == "":
            channel.write(b"\r\nRouter#")
            return
        if line.startswith("terminal "):
            channel.write((line + "\r\nRouter#").encode())
            return
        commands.append(line)
        output = (" " * (len(line) + 7)) + "^\r\n% Invalid input detected at '^' marker.\r\n"
        reply = replies.get(line)
        if reply is not None:
            output = reply
        end = "" if output.endswith("\n") else "\r\n"
        channel.write((line + "\r\n" + output + end + "Router#").encode())

    def _on_data(channel: ssh.ServerChannel, data: ?bytes):
        if data is not None:
            typed += data
        cr = typed.find(b"\r")
        while cr >= 0:
            line = typed[:cr].decode().strip()
            typed = typed[cr + 1:]
            _run(channel, line)
            cr = typed.find(b"\r")

    def _on_stderr(channel: ssh.ServerChannel, data: ?bytes):
        pass

    def _on_channel_close(channel: ssh.ServerChannel, reason: str):
        pass

    def _on_channel(session: ssh.ServerSession):
        session.accept_channel(ssh.ServerChannel(session, _on_data, _on_stderr, _on_channel_close))

    def _on_shell(session: ssh.ServerSession, channel: ssh.ServerChannel, pty: ?ssh.PtyRequest):
        channel.accept_request()
        channel.write(b"\r\nRouter#")

    def get_commands() -> list[str]:
        return commands

    server = ssh.Server(net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
                        "127.0.0.1", u16(0), _on_listen, _on_server_close,
                        _on_session, _on_auth, _on_channel, on_shell=_on_shell)

    def close():
        server.close()


MODEL_PRIMARY = r"""module xe-primary {
  yang-version 1.1;
  namespace "urn:test:xe-primary";
  prefix xp;
  container system { config false; leaf hostname { type string; } }
}"""


def _mock_primary(dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, dmc: Dmc, registry: swdev.SchemaRegistry,
                  log_handler: logging.Handler, env: ?Env) -> DeviceAdapter:
    """A primary adapter that connects at once and serves the modules of its schema."""
    return MockAdapter(lambda mods, key: dev.on_connect(mods, key), bundled_schema, log_handler, env)


actor _test_extra_adapter(t: testing.EnvT):
    """The CLI adapter as an extra adapter beside a primary. It connects on its
    own port with its own credentials, serves the reads of its module, and
    shows as disconnected when its login fails."""
    t.timeout(10.0)
    var server: ?_FakeXe = None
    var dev: ?swdev.DeviceMgr = None
    var port = 0
    var step = "connect"
    var finished = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        s = server
        if s is not None:
            s.close()
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def config(cli_password: str) -> Dmc:
        """The primary's address and credentials do not work for the CLI."""
        dmc = Dmc("xe", Credentials("netconf", "secret"), type="primary")
        dmc.address.create("mgmt", "127.0.0.1", port=u64(830))
        cli = dmc.extra_adapter.create("iosxe-cli", port=u64(port))
        cli.credentials = ExtraCredentials("admin", cli_password)
        return dmc

    def listed(tree: ?gdata.Node, err: ?Exception):
        d = dev
        try:
            if err is not None:
                raise err
            fs = xecli_data.root.from_gdata(tree).file_systems.file_system["bootflash:"]
            testing.assertEqual([f.name + " " + str(f.size) + " " + str(f.modified) for f in fs.file], BOOTFLASH_FILES)
        except Exception as e:
            finish(e)
            return
        if d is not None:
            step = "lose"
            d.set_dmc(config("wrong"))

    def on_oper(n: ?gdata.Node):
        d = dev
        if n is not None and d is not None and not finished:
            entries = []
            for e in swdevoper.stratoweave_rfs__device_entry.from_gdata(n).state.adapter:
                c = e.connected
                connected = "no"
                if c is not None and c:
                    connected = "yes"
                entries.append(e.type + "=" + connected)
            adapters = sorted(entries)
            if step == "connect" and adapters == ["iosxe-cli=yes", "primary=yes"]:
                step = "read"
                served_by = d.get_module_adapters().get(xecli_yang.MODULE)
                if served_by != "iosxe-cli":
                    finish(ValueError("the CLI module is served by {served_by}"))
                    return
                d.get(listed, _top([_fs(["bootflash:"])]))
            elif step == "lose" and adapters == ["iosxe-cli=no", "primary=yes"]:
                finish(None)

    def on_reconf(name: str):
        pass

    def listening(p: int):
        if p == 0:
            finish(ValueError("the SSH server did not start"))
            return
        port = p
        schema = yang.compile(xecli_yang.models)
        types = {"primary": swdev.DeviceType("primary", _mock_primary, yang.compile([MODEL_PRIMARY])),
                 "iosxe-cli": swdev.DeviceType("iosxe-cli", _fast_adapter, schema, oper_src_dnode=schema)}
        d = swdev.DeviceMgr(types, t.env, "xe", t.log_handler, on_reconf, swdev.SchemaRegistry())
        dev = d
        d.set_update_oper(on_oper)
        d.set_dmc(config("admin"))

    server = _FakeXe(t, {"dir bootflash:": DIR_BOOTFLASH}, listening)


# Tests against a real IOS XE device over SSH. Run them with, for example:
#
#   IOSXE_CLI_PORT=28422 IOSXE_CLI_FILE=sw-xe-image-staging.bin \
#   IOSXE_CLI_MD5=35a91bebe3b1f38606bd0a845426929f \
#   acton test --tag iosxe-cli --module adapters.test_iosxe_cli
#
# IOSXE_CLI_ADDRESS (default 127.0.0.1), IOSXE_CLI_PORT (default 22),
# IOSXE_CLI_USERNAME and IOSXE_CLI_PASSWORD (default admin, as in the lab)
# select the device. IOSXE_CLI_KEY is a private key file to log in with
# instead of the password. IOSXE_CLI_KEY_EXCHANGES,
# IOSXE_CLI_HOST_KEY_ALGORITHMS and IOSXE_CLI_PUBLIC_KEY_ALGORITHMS set the
# SSH algorithms of the CLI, comma separated: an RSA key needs ssh-rsa on
# the IOS SSH server of 17.9, and 16.8 needs diffie-hellman-group14-sha1 and
# ssh-rsa host keys too. IOSXE_CLI_FILE is a file on bootflash: and
# IOSXE_CLI_MD5 its MD5 checksum.
#
# The test beside NETCONF has the device compare the MD5 with IOSXE_CLI_MD5,
# and checks IOSXE_CLI_IMAGE, an IOS XE image on bootflash:. It connects
# NETCONF to IOSXE_NETCONF_PORT (default 830).

proc def live_setting(t: testing.EnvT, name: str, default: str) -> str:
    """Return the environment variable name, or default."""
    value = t.env.vars.getenv(name)
    return value if value is not None else default


proc def _algorithms(t: testing.EnvT, name: str) -> list[str]:
    return [a for a in live_setting(t, name, "").split(",") if a != ""]


proc def live_ssh(t: testing.EnvT) -> Ssh:
    """Return the SSH settings of the IOSXE_CLI_* algorithm variables."""
    return Ssh(key_exchange=_algorithms(t, "IOSXE_CLI_KEY_EXCHANGES"),
               host_key_algorithm=_algorithms(t, "IOSXE_CLI_HOST_KEY_ALGORITHMS"),
               public_key_algorithm=_algorithms(t, "IOSXE_CLI_PUBLIC_KEY_ALGORITHMS"))


proc def live_credentials(t: testing.EnvT) -> Credentials:
    """Return the credentials of IOSXE_CLI_USERNAME and IOSXE_CLI_KEY or
    IOSXE_CLI_PASSWORD."""
    c = Credentials(live_setting(t, "IOSXE_CLI_USERNAME", "admin"))
    key_file = live_setting(t, "IOSXE_CLI_KEY", "")
    if key_file != "":
        f = ReadFile(ReadFileCap(FileCap(t.env.cap)), key_file)
        c.key.create("live", f.read().decode())
        f.close()
    else:
        c.password = live_setting(t, "IOSXE_CLI_PASSWORD", "admin")
    return c


actor _test_live_iosxe(t: testing.EnvT):
    """Read every node of a real device and verify the checksum of a file."""
    t.require("iosxe-cli")
    t.timeout(120.0)

    file = live_setting(t, "IOSXE_CLI_FILE", "")
    md5 = live_setting(t, "IOSXE_CLI_MD5", "").lower()
    var dev: ?swdev.DeviceMgr = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def sha512_checked(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        try:
            if err is not None:
                raise err
            digest = out.digest if out is not None else None
            testing.assertEqual(len(digest if digest is not None else ""), 128, "SHA-512 digest length")
        except Exception as e:
            finish(e)
            return
        finish(None)

    def md5_checked(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.digest if out is not None else None, md5)
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.verify(sha512_checked, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", file, "sha512"))

    def listed(tree: ?gdata.Node, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            got = xecli_data.root.from_gdata(tree)
            fs = got.file_systems.file_system["bootflash:"]
            entry = fs.file.get(file)
            testing.assertTrue(entry is not None, file + " is on bootflash:")
            testing.assertTrue(len(fs.file) > 1, "bootflash: has more files")
            v = got.version
            for name, value in [("version", v.version), ("model", v.model),
                                ("serial-number", v.serial_number), ("system-image", v.system_image)]:
                testing.assertTrue(value is not None, "show version gives " + name)
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.verify(md5_checked, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", file, "md5"))

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            rpcs = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            d.get(listed, None)
            return
        after 0.1: connected()

    def on_reconf(name: str):
        pass

    if file == "" or md5 == "":
        finish(ValueError("set IOSXE_CLI_FILE and IOSXE_CLI_MD5"))
    else:
        dev = _device(t, xecli.IosXeCliAdapter, on_reconf, live_setting(t, "IOSXE_CLI_ADDRESS", "127.0.0.1"),
                      int(live_setting(t, "IOSXE_CLI_PORT", "22")), live_credentials(t), live_ssh(t))
        connected()


actor _test_live_iosxe_beside_netconf(t: testing.EnvT):
    """Run the RPCs of the CLI adapter on a real device that also has NETCONF.

    NETCONF is the primary adapter. The CLI adapter is an extra adapter with
    its own SSH settings.
    """
    t.require("iosxe-cli")
    t.timeout(300.0)

    file = live_setting(t, "IOSXE_CLI_FILE", "")
    md5 = live_setting(t, "IOSXE_CLI_MD5", "").lower()
    image = live_setting(t, "IOSXE_CLI_IMAGE", "")
    var dev: ?swdev.DeviceMgr = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def image_checked(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.verified if out is not None else None, True, image + " is verified")
        except Exception as e:
            finish(e)
            return
        finish(None)

    def md5_checked(out: ?xecli_data.stratoweave_iosxe_cli__verify__output, err: ?Exception):
        r = rpcs
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.digest if out is not None else None, md5)
            testing.assertEqual(out.verified if out is not None else None, True, "the device finds the MD5 equal")
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.verify(image_checked, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", image))

    def connected():
        d = dev
        if d is not None:
            mods = d.get_modules().0
            if xecli_yang.MODULE in mods and "Cisco-IOS-XE-native" in mods:
                r = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
                rpcs = r
                r.verify(md5_checked, xecli_data.stratoweave_iosxe_cli__verify__input("bootflash:", file, "md5", md5))
                return
        after 0.1: connected()

    if file == "" or md5 == "" or image == "":
        finish(ValueError("set IOSXE_CLI_FILE, IOSXE_CLI_MD5 and IOSXE_CLI_IMAGE"))
    else:
        types = {
            "iosxe": swdev.DeviceType("iosxe", swna.NetconfAdapter, yschema.DRoot()),
            "iosxe-cli": swdev.DeviceType("iosxe-cli", xecli.IosXeCliAdapter, yang.compile(xecli_yang.models)),
        }
        d = swdev.DeviceMgr(types, t.env, "xe", t.log_handler, lambda name: None, swdev.SchemaRegistry())
        dmc = Dmc("xe", live_credentials(t), type="iosxe")
        dmc.address.create("primary", live_setting(t, "IOSXE_CLI_ADDRESS", "127.0.0.1"),
                           port=u64(int(live_setting(t, "IOSXE_NETCONF_PORT", "830"))))
        extra = dmc.extra_adapter.create("iosxe-cli", port=u64(int(live_setting(t, "IOSXE_CLI_PORT", "22"))))
        extra.ssh = ExtraSsh(key_exchange=_algorithms(t, "IOSXE_CLI_KEY_EXCHANGES"),
                             host_key_algorithm=_algorithms(t, "IOSXE_CLI_HOST_KEY_ALGORITHMS"),
                             public_key_algorithm=_algorithms(t, "IOSXE_CLI_PUBLIC_KEY_ALGORITHMS"))
        d.set_dmc(dmc)
        dev = d
        connected()


# The install test upgrades a real device and reloads it. Run it on a lab
# device only, with --tag iosxe-install and the settings above.
# IOSXE_INSTALL_FILE is the image to install, e.g.
# bootflash:c1100-universalk9.17.09.05a.SPA.bin, and IOSXE_INSTALL_VERSION the
# release that show version gives after the install, e.g. 17.09.05a.

def _install_state(tree: ?gdata.Node) -> (version: str, image: str, states: list[str], timer: str):
    """Return the release, the system image, the package states and the
    auto-abort timer in tree."""
    r = xecli_data.root.from_gdata(tree)
    states = [p.name + " " + _opt(p.state) for loc in r.install_summary.location for p in loc.package]
    return (version=_opt(r.version.version), image=_opt(r.version.system_image), states=states,
            timer=_opt(r.install_summary.auto_abort_timer))


def _has_state(states: list[str], state: str) -> bool:
    return any([s.endswith(" " + state) for s in states])


actor _test_live_install(t: testing.EnvT):
    """Upgrade a real device with the install RPC.

    A device in install mode adds the image, activates it with an
    auto-abort timer, reloads, and commits. A device in bundle mode boots a
    .bin file and cannot add alone: it converts to install mode with one
    command that adds, activates and commits, and reloads.
    """
    t.require("iosxe-install")
    t.timeout(5400.0)
    log = logging.Logger(t.log_handler)
    image = live_setting(t, "IOSXE_INSTALL_FILE", "")
    release = live_setting(t, "IOSXE_INSTALL_VERSION", "")
    var dev: ?swdev.DeviceMgr = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False
    var waited = 0
    var bundle = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def read(cb: action(?gdata.Node, ?Exception) -> None):
        d = dev
        if d is not None:
            q = lambda name: gdata.FNode(_q(name))
            d.get(cb, gdata.FNode(children=[q("version"), q("install-summary")]))

    def install(cb: action(?xecli_data.stratoweave_iosxe_cli__install__output, ?Exception) -> None,
                inp: xecli_data.stratoweave_iosxe_cli__install__input):
        r = rpcs
        if r is not None:
            log.info("install: " + xecli.install_command(inp))
            r.install(cb, inp)

    def checked(name: str, out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception, reloading: bool) -> bool:
        try:
            if err is not None:
                raise err
            testing.assertEqual(out.reloading if out is not None else None, reloading, name + ": reloading")
        except Exception as e:
            finish(e)
            return False
        return True

    def after_commit(tree: ?gdata.Node, err: ?Exception):
        try:
            if err is not None:
                raise err
            s = _install_state(tree)
            log.info("after commit", {"version": s.version, "packages": s.states, "timer": s.timer})
            testing.assertTrue(_has_state(s.states, "activated-committed"), "a package is committed: " + str(s.states))
            testing.assertEqual(s.timer, "inactive", "the auto-abort timer stops")
        except Exception as e:
            finish(e)
            return
        finish(None)

    def committed(out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception):
        if checked("commit", out, err, False):
            read(after_commit)

    def after_reload(tree: ?gdata.Node, err: ?Exception):
        if err is not None or (_install_state(tree).version != release):
            waited += 1
            if waited > 80:
                finish(ValueError("the device did not come back with {release}: {err}"))
                return
            after now 30.0: read(after_reload)
            return
        try:
            s = _install_state(tree)
            log.info("after the reload", {"version": s.version, "image": s.image, "packages": s.states, "timer": s.timer})
            if bundle:
                testing.assertTrue(_has_state(s.states, "activated-committed"), "the one command commits: " + str(s.states))
                testing.assertEqual(s.image, "bootflash:packages.conf", "the device boots in install mode")
            else:
                testing.assertTrue(_has_state(s.states, "activated-uncommitted"), "a package is activated: " + str(s.states))
                testing.assertNotEqual(s.timer, "inactive", "the auto-abort timer runs")
        except Exception as e:
            finish(e)
            return
        if bundle:
            finish(None)
        else:
            install(committed, xecli_data.stratoweave_iosxe_cli__install__input(commit=True))

    def activated(out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception):
        if checked("activate", out, err, True):
            after now 60.0: read(after_reload)

    def after_add(tree: ?gdata.Node, err: ?Exception):
        try:
            if err is not None:
                raise err
            s = _install_state(tree)
            log.info("after add", {"version": s.version, "packages": s.states, "timer": s.timer})
            testing.assertTrue(_has_state(s.states, "inactive"), "the added package is inactive: " + str(s.states))
        except Exception as e:
            finish(e)
            return
        install(activated, xecli_data.stratoweave_iosxe_cli__install__input(
            activate=xecli_data.stratoweave_iosxe_cli__install__input__activate(auto_abort_timer=u64(60), prompt_level="none")))

    def added(out: ?xecli_data.stratoweave_iosxe_cli__install__output, err: ?Exception):
        if checked("add", out, err, False):
            read(after_add)

    def before(tree: ?gdata.Node, err: ?Exception):
        try:
            if err is not None:
                raise err
            s = _install_state(tree)
            log.info("before", {"version": s.version, "image": s.image, "packages": s.states, "timer": s.timer})
            testing.assertNotEqual(s.version, release, "the device does not run the release yet")
            bundle = s.image.endswith(".bin")
        except Exception as e:
            finish(e)
            return
        if bundle:
            install(activated, xecli_data.stratoweave_iosxe_cli__install__input(
                add=xecli_data.stratoweave_iosxe_cli__install__input__add(image, activate=True, commit=True, prompt_level="none")))
        else:
            install(added, xecli_data.stratoweave_iosxe_cli__install__input(
                add=xecli_data.stratoweave_iosxe_cli__install__input__add(image)))

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            rpcs = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            read(before)
            return
        after 0.5: connected()

    def on_reconf(name: str):
        pass

    if image == "" or release == "":
        finish(ValueError("set IOSXE_INSTALL_FILE and IOSXE_INSTALL_VERSION"))
    else:
        dev = _device(t, xecli.IosXeCliAdapter, on_reconf, live_setting(t, "IOSXE_CLI_ADDRESS", "127.0.0.1"),
                      int(live_setting(t, "IOSXE_CLI_PORT", "22")), live_credentials(t), live_ssh(t))
        connected()


# The configure test changes the configuration of a real device and saves
# it. Run it on a lab device only, with --tag iosxe-configure and the
# settings above. It sets the BOOT variable to IOSXE_BOOT_FILE, e.g.
# bootflash:packages.conf for a device in install mode.

actor _test_live_configure(t: testing.EnvT):
    """Configure a real device: a rejected command fails the RPC, the boot
    statements change, write memory saves them, and show bootvar has them."""
    t.require("iosxe-configure")
    t.timeout(300.0)
    boot = live_setting(t, "IOSXE_BOOT_FILE", "")
    var dev: ?swdev.DeviceMgr = None
    var rpcs: ?xecli_data.rpc_root = None
    var finished = False

    def finish(err: ?Exception):
        if finished:
            return
        finished = True
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def booted(tree: ?gdata.Node, err: ?Exception):
        try:
            if err is not None:
                raise err
            r = xecli_data.root.from_gdata(tree)
            testing.assertEqual(list(r.bootvar.boot), [boot], "the BOOT variable")
        except Exception as e:
            finish(e)
            return
        finish(None)

    def saved(err: ?Exception):
        d = dev
        if err is not None:
            finish(err)
        elif d is not None:
            d.get(booted, _top([gdata.FNode(_q("bootvar"))]))

    def configured(err: ?Exception):
        r = rpcs
        if err is not None:
            finish(err)
        elif r is not None:
            r.write_memory(saved)

    def rejected(err: ?Exception):
        r = rpcs
        try:
            testing.assertTrue(isinstance(err, xecli.CommandError), "a misspelled command fails")
            if err is not None:
                testing.assertTrue("% Invalid input" in err.error_message, err.error_message)
        except Exception as e:
            finish(e)
            return
        if r is not None:
            r.configure(configured, xecli_data.stratoweave_iosxe_cli__configure__input(
                line=["no boot system", "boot system flash " + boot]))

    def connected():
        d = dev
        if d is not None and xecli_yang.MODULE in d.get_modules().0:
            r = xecli_data.rpc_root(swdev.DeviceTreeProvider(d))
            rpcs = r
            r.configure(rejected, xecli_data.stratoweave_iosxe_cli__configure__input(line=["hostnme Router"]))
            return
        after 0.5: connected()

    def on_reconf(name: str):
        pass

    if boot == "":
        finish(ValueError("set IOSXE_BOOT_FILE"))
    else:
        dev = _device(t, xecli.IosXeCliAdapter, on_reconf, live_setting(t, "IOSXE_CLI_ADDRESS", "127.0.0.1"),
                      int(live_setting(t, "IOSXE_CLI_PORT", "22")), live_credentials(t), live_ssh(t))
        connected()
