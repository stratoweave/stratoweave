def _test_verify_command_forms():
    cases: list[(?str, ?str, str)] = [
        (None, None, "verify bootflash:" + OLD_IMAGE),
        ("md5", OLD_IMAGE_MD5, "verify /md5 bootflash:" + OLD_IMAGE + " " + OLD_IMAGE_MD5),
        ("md5", OLD_IMAGE_MD5.upper(), "verify /md5 bootflash:" + OLD_IMAGE + " " + OLD_IMAGE_MD5),
        ("sha512", OLD_IMAGE_SHA512, "verify /sha512 bootflash:" + OLD_IMAGE + " " + OLD_IMAGE_SHA512),
        (None, OLD_IMAGE_MD5, "error: a hash needs an algorithm"),
        ("md5", OLD_IMAGE_MD5[:8], "error: invalid md5 hash: 8dee04c8. Use 32 hexadecimal digits"),
        ("md5", OLD_IMAGE_SHA512, "error: invalid md5 hash"),
        ("sha512", OLD_IMAGE_MD5, "error: invalid sha512 hash"),
        ("md5", OLD_IMAGE_MD5[:31] + ";", "error: invalid md5 hash"),
        ("md5", OLD_IMAGE_MD5[:30] + " x", "error: invalid md5 hash"),
    ]
    for algorithm, expected, want in cases:
        try:
            got = xecli.verify_command("bootflash:", OLD_IMAGE, algorithm, expected)
        except ValueError as e:
            got = "error: " + e.error_message
        testing.assertTrue(got.startswith(want), "{algorithm} {expected}: {got}")


