                                "the device must still run the old release")
            testing.assertEqual("activate failed: install-smu-not-added: mock refuses to activate",
                                d!.get_swmgr().get_reason(),
                                "the reason must carry the device's refusal")
            t.success()
            return
        if st == "succeeded" or st == "rolled-back":
