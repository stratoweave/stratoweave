## show install summary on a C1111 activated to 17.15.04c and not committed.
SUMMARY_UNCOMMITTED = "\r\n[ R0 ] Installed Package(s) Information:\r\nState (St): I - Inactive, U - Activated & Uncommitted,\r\n            C - Activated & Committed, D - Deactivated & Uncommitted\r\n--------------------------------------------------------------------------------\r\nType  St   Filename/Version\r\n--------------------------------------------------------------------------------\r\nIMG   U    17.15.04c.0.107\r\n\r\n--------------------------------------------------------------------------------\r\nAuto abort timer: active , time before rollback - 00:25:36\r\n--------------------------------------------------------------------------------\r\n"


def _test_abort_timer_left():
    cli = xecli_data.root()
    xecli.InstallRead().parse(cli, SUMMARY_UNCOMMITTED)
    testing.assertEqual(swxe.abort_timer_left(cli.to_gdata(), 0), 25 * 60 + 36, "CLI")
    testing.assertEqual(swxe.device_versions(cli.to_gdata()),
                        [(version="17.15.04c.0.107", state=swxe.VS_UNCOMMITTED)], "only the activated release")
    committed = xecli_data.root()
    xecli.InstallRead().parse(committed, _summary(["IMG   C    " + OLD_VERSION]))
    testing.assertEqual(swxe.abort_timer_left(committed.to_gdata(), 0), None, "inactive")
    r = ixoper.root()
    loc = r.install_oper_data.install_location_information.create()
    loc.oper_state.auto_abort_timer.state = "install-timer-state-active"
    loc.oper_state.auto_abort_timer.end_time = "2026-11-10T23:41:31+00:00"
    testing.assertEqual(swxe.abort_timer_left(r.to_gdata(), 1794354091 - 1536), 1536, "NETCONF")


actor _test_iosxe_pending_release_is_aborted_first(t: testing.EnvT):
    """The device runs 17.18.04 activated and not committed, as after a run
    that stopped before its commit. An install of another release aborts it
    first; the device reloads to the committed release. The aborted release
    stays added, so staging removes it, which removes the staged image too,
    and transfers again."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["xcopy", "abort", "remove", "xcopy", "install", "activate", "install-commit", "remove"],
                                m.get_rpcs())
            testing.assertEqual(NEW_REPORTED, m.get_running())
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        _StagingRun(t, "d-pending", DIR_EMPTY, VERIFY_EQUAL, settled, preadded="17.18.04",
                    running="17.18.04", committed=OLD_RELEASE)



def _test_transfer_failure():
    cause = swxemock.SUB_DOWNLOAD_FAIL
    testing.assertEqual(swxe.transfer_failure(cause, u64(239529984), u64(734643332)),
                        cause + ": bootflash: has 239529984 bytes free, the image is 734643332", "out of room")
    testing.assertEqual(swxe.transfer_failure(cause, u64(1786126336), u64(734643332)), cause, "room enough")
    testing.assertEqual(swxe.transfer_failure(cause, None, u64(734643332)), cause, "free space unknown")
    testing.assertEqual(swxe.transfer_failure(cause, u64(1), None), cause, "size unknown")


def _test_xcopy_takes_timeout():
    cases: list[(str, ?str, bool)] = [
        ("the first revision, IOS XE 17.5 to 17.7", "2021-03-01", False),
        ("IOS XE 17.8", "2022-03-01", True),
        ("IOS XE 17.9", "2022-07-01", True),
        ("IOS XE 17.18", "2025-07-01", True),
        ("no revision", None, False),
    ]
    for what, revision, want in cases:
        testing.assertEqual(want, swxe.xcopy_takes_timeout(revision), what)


def _test_xcopy_input_has_the_timeout_when_given():
    with_timeout = swxe.xcopy_input("u1", IMAGE_URL, IMAGE_FILE, u64(swxe.XCOPY_TIMEOUT))
    testing.assertEqual("29", str(with_timeout.timeout), "the timeout in minutes")
    without = swxe.xcopy_input("u1", IMAGE_URL, IMAGE_FILE)
    testing.assertTrue(without.timeout is None, "no timeout for a device that does not take one")


def _test_xcopy_failure():
    cases: list[(str, str, str, str, str)] = [
        ("the download error, then the error string",
         "xcopy-utility-failed", "Curl error - 7", "derr-no-con", "derr-no-con: Curl error - 7"),
        ("before IOS XE 17.18: the error code, then the error string",
         "xcopy-utility-failed", "Curl error - 22", "", "xcopy-utility-failed: Curl error - 22"),
        ("derr-ok says nothing", "xcopy-timeout-error", "", "derr-ok", "xcopy-timeout-error"),
        ("an error string alone", "", "Curl error - 28", "", "Curl error - 28"),
        ("nothing", "", "", "", "xcopy-failed"),
    ]
    for what, errcode, errstr, download_error, want in cases:
        testing.assertEqual(want, swxe.xcopy_failure(errcode, errstr, download_error), what)


## xcopy-status notifications from a C8000V with 17.18.2: of a file that
## the http server does not have, of a server without a route to it, of a
## wrong scp password, of a copy that succeeded and of one that runs.
XCOPY_STATUS_MISSING = """<xcopy-status xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-xcopy-events">
  <uuid>f-404</uuid><status>xcopy-failed</status><percentage>0</percentage><download-speed>0</download-speed>
  <expected-duration>0</expected-duration><time-left>0</time-left><time-spent>0</time-spent><filesize>0</filesize>
  <downloaded-size>0</downloaded-size><start-time>2026-11-26T10:20:19+00:00</start-time>
  <event-time>2026-11-26T10:20:21+00:00</event-time><errcode>xcopy-utility-failed</errcode>
  <errstr>Curl error - 22</errstr><dwnld-err>derr-http-returned-error</dwnld-err>
</xcopy-status>"""
XCOPY_STATUS_NO_ROUTE = XCOPY_STATUS_MISSING.replace("f-404", "f-noroute").replace("Curl error - 22", "Curl error - 28") \
    .replace("derr-http-returned-error", "derr-oper-tout")
XCOPY_STATUS_SCP_PASSWORD = XCOPY_STATUS_MISSING.replace("f-404", "s-badpw").replace("<percentage>0", "<percentage>232") \
    .replace("Curl error - 22", "Curl error - 67").replace("derr-http-returned-error", "derr-login-denied")
XCOPY_STATUS_SUCCESS = XCOPY_STATUS_MISSING.replace("f-404", "ok-2").replace("xcopy-failed", "xcopy-success") \
    .replace("xcopy-utility-failed", "xcopy-no-error").replace("<errstr>Curl error - 22</errstr>", "<errstr/>") \
    .replace("derr-http-returned-error", "derr-ok")
XCOPY_STATUS_RUNNING = XCOPY_STATUS_SUCCESS.replace("xcopy-success", "xcopy-inprogress")


def _test_xcopy_status_reads_the_notification():
    """The uuid, the status, and the reason of a failure come out of an
    xcopy-status as the device sends it, decoded as the adapter decodes
    it. The other leaves do not matter."""
    schema = yang.compile(swxe_yang.models)
    cases: list[(str, str, str)] = [
        ("a missing file", XCOPY_STATUS_MISSING,
         "f-404 xcopy-failed derr-http-returned-error: Curl error - 22"),
        ("no route to the server", XCOPY_STATUS_NO_ROUTE, "f-noroute xcopy-failed derr-oper-tout: Curl error - 28"),
        ("a wrong scp password", XCOPY_STATUS_SCP_PASSWORD,
         "s-badpw xcopy-failed derr-login-denied: Curl error - 67"),
        ("before IOS XE 17.18, without the download error",
         XCOPY_STATUS_MISSING.replace("<dwnld-err>derr-http-returned-error</dwnld-err>", ""),
         "f-404 xcopy-failed xcopy-utility-failed: Curl error - 22"),
        ("a copy that succeeded", XCOPY_STATUS_SUCCESS, "ok-2 xcopy-success "),
        ("a copy that runs", XCOPY_STATUS_RUNNING, "ok-2 xcopy-inprogress "),
        ("no uuid", XCOPY_STATUS_MISSING.replace("<uuid>f-404</uuid>", ""), "none"),
    ]
    for what, text, want in cases:
        payload = yxml.from_xml(schema, xml.decode(text), loose=True,
                                root_path=["Cisco-IOS-XE-xcopy-events:xcopy-status"])
        got = swxe.xcopy_status(payload)
        testing.assertEqual(want, "{got.uuid} {got.status} {got.reason}" if got is not None else "none", what)


