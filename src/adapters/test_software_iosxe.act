            return
        after 0.05: assess()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(
                    ms!, t.log_handler, failure=swxemock.FAILURE_ACTIVATE_REFUSED)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig("d5", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.05: assess()
                return
        t.failure(ValueError("no mock server on the device adapter"))

    dev_ref = new_iosxe_mock_device_mgr(t, "d5", on_reconf)
    after 0.01: start()
    after 2.5: t.failure(ValueError("timed out"))


actor _UpgradeRun(t: testing.EnvT, name: str, upgrade_duration: float,
                  failure: str, running: str, target: str, image_url: str,
                  settled: action(swxemock.IosXeSoftwareMock, swdev.DeviceMgr,
                                  str) -> None,
                  timeout: float=2.5):
    """Drive one mock device from software intent to a settled status, then
    call `settled` with the mock, the device and the status. The timeout
    failure dumps what the device saw."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        settled(m!, d!, st)

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler,
                                               upgrade_duration=upgrade_duration,
                                               failure=failure, running=running)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig(name, Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", target, image_url))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.02: poll()
                return
        finished = True
        t.failure(ValueError("no mock server on the device adapter"))

    def report_timeout() -> None:
        if finished:
            return
        finished = True
        m = mock
        d = dev_ref
        rpcs = m!.get_rpcs() if m is not None else []
        run = m!.get_running() if m is not None else "?"
        st = d!.get_swmgr().get_status() if d is not None else "?"
        t.failure(ValueError("timed out: rpcs={rpcs} running={run} status={st}"))

    dev_ref = new_iosxe_mock_device_mgr(t, name, on_reconf)
    after 0.01: start()
    after timeout: report_timeout()


actor _test_iosxe_download_failure_fails_in_prepare(t: testing.EnvT):
    """The device accepts the copy and the download fails later, as with a bad
    URL; the run fails in prepare and nothing is installed."""
    def settled(m: swxemock.IosXeSoftwareMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("failed", status, "a failed download is a failed run")
            testing.assertEqual(["xcopy"], m.get_rpcs(),
                                "nothing may be installed after a failed download")
            testing.assertEqual(OLD_REPORTED, m.get_running(),
                                "the device must still run the old release")
            testing.assertEqual("download failed: " + swxemock.SUB_DOWNLOAD_FAIL,
                                d.get_swmgr().get_reason(),
                                "the reason must name the download and the device's cause")
            t.success()
        except Exception as e:
            t.failure(e)

    _UpgradeRun(t, "d-download", 0.0, swxemock.FAILURE_DOWNLOAD, OLD_RELEASE,
                NEW_REQUESTED, IMAGE_URL, settled)


actor _test_iosxe_commit_failure_rolls_back(t: testing.EnvT):
    """A failed commit makes the manager abort; the device reloads the committed
    release and the run ends rolled back, not failed."""
    def settled(m: swxemock.IosXeSoftwareMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("rolled-back", status, "a failed commit must roll back")
            testing.assertEqual(["xcopy", "install", "activate", "install-commit", "abort"],
                                m.get_rpcs(), "the manager must abort after the commit")
            testing.assertEqual(OLD_REPORTED, m.get_running(),
                                "the abort must reload the committed release")
            testing.assertEqual(OLD_REPORTED, m.get_committed(),
                                "nothing may have been committed")
            testing.assertEqual("commit failed: " + swxemock.SUB_COMMIT_FAIL,
                                d.get_swmgr().get_reason(),
                                "the reason must say why it rolled back")
            t.success()
        except Exception as e:
            t.failure(e)

    _UpgradeRun(t, "d-commit", 0.0, swxemock.FAILURE_COMMIT, OLD_RELEASE,
                NEW_REQUESTED, IMAGE_URL, settled)


actor _test_iosxe_revert_before_commit_is_failed(t: testing.EnvT):
    """When the abort timer beats the commit, the commit has nothing to do and
    the abort nothing to abort; the run is a plain failure."""
    def settled(m: swxemock.IosXeSoftwareMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("failed", status, "a reverted device is a failed run")
            testing.assertEqual(["xcopy", "install", "activate", "install-commit", "abort"],
                                m.get_rpcs(), "the manager must try to commit and abort")
            testing.assertEqual(OLD_REPORTED, m.get_running(),
                                "the device must run the committed release again")
            testing.assertEqual(OLD_REPORTED, m.get_committed(),
                                "the target may not have been committed")
            testing.assertEqual("commit failed: nothing to do: install-op-marked-succ; "
                                + "abort failed: nothing to abort",
                                d.get_swmgr().get_reason(),
                                "the reason must keep the commit and the abort")
            t.success()
        except Exception as e:
            t.failure(e)

    _UpgradeRun(t, "d-revert", 0.0, swxemock.FAILURE_REVERTS, OLD_RELEASE,
                NEW_REQUESTED, IMAGE_URL, settled)


actor _test_iosxe_release_follows_the_image(t: testing.EnvT):
    """The device ends up on the image it installed, so a campaign to any
    release reports the right running release."""
    def settled(m: swxemock.IosXeSoftwareMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, "the upgrade must succeed")
            testing.assertEqual("17.18.4", m.get_running(),
                                "the running release must come from the image name")
            testing.assertEqual("17.18.4", m.get_committed(),
                                "the committed release must come from the image name")
            t.success()
        except Exception as e:
            t.failure(e)

    _UpgradeRun(t, "d-image", 0.0, swxemock.FAILURE_NONE, OLD_RELEASE, "17.18.04",
                "scp://root:labpass@10.0.0.9:/images/c8000v-universalk9.17.18.04.bin",
                settled)


#############################################################################
# The plan and the staging check
#############################################################################

def _test_upgrade_plan_follows_the_modules():
    cli = {xecli_yang.MODULE}
    netconf = {swxe.HARDWARE_MODULE, swxe.XCOPY_MODULE, swxe.INSTALL_MODULE, swxe.FILES_MODULE, swxe.CISCO_RPC_MODULE}
    no_files = {swxe.HARDWARE_MODULE, swxe.XCOPY_MODULE, swxe.INSTALL_MODULE}
    # Columns: check, transfer, listing, verify, install, delete.
    cases = [
        ("NETCONF and the CLI, as a C1111 with 17.15", netconf | cli,
         ("netconf", "netconf", "netconf", "cli", "netconf", "netconf")),
        ("NETCONF without the files and delete, and the CLI", no_files | cli,
         ("netconf", "netconf", "cli", "cli", "netconf", "cli")),
        ("only the CLI, as a C1111 with 16.8.1", cli, ("cli", "cli", "cli", "cli", "cli", "cli")),
        ("only NETCONF, without the CLI adapter", netconf, ("netconf", "netconf", "netconf", "", "netconf", "netconf")),
        ("nothing", set(), ("", "", "", "", "", "")),
    ]
    for name, modules, want in cases:
        p = swxe.upgrade_plan(modules)
        testing.assertEqual((p.check, p.transfer, p.listing, p.verify, p.install, p.delete), want, name)


def _files_root(partitions: list[(name: str, paths: list[str])]) -> ygdata.Node:
    r = ixoper.root()
    q = r.cisco_platform_software.q_filesystem.create()
    for p in partitions:
        entry = q.partitions.create(p.name)
        for path in p.paths:
            entry.partition_content.create(path, size=u64(1))
    return r.to_gdata()


def _dir_root(files: list[str]) -> ygdata.Node:
    r = xecli_data.root()
    fs = r.file_systems.file_system.create("bootflash:")
    for f in files:
        fs.file.create(f, size=u64(1))
    return r.to_gdata()


def _test_staged_file_reads_both_listings():
    image = "c1100-universalk9.17.15.04c.SPA.bin"
    cases = [
        ("NETCONF: on bootflash", _files_root([(name="bootflash:", paths=["/bootflash/packages.conf", "/bootflash/" + image])]), True),
        ("NETCONF: in a subdirectory", _files_root([(name="bootflash:", paths=["/bootflash/old/" + image])]), False),
        ("NETCONF: on another partition", _files_root([(name="webui:", paths=["/bootflash/" + image])]), False),
        ("NETCONF: not there", _files_root([(name="bootflash:", paths=["/bootflash/packages.conf"])]), False),
        ("CLI: on bootflash", _dir_root([image]), True),
        ("CLI: not there", _dir_root(["packages.conf"]), False),
        ("no data", None, False),
    ]
    for name, root, want in cases:
        testing.assertEqual(swxe.staged_file(root, image), want, name)


def _test_usable_checksum_prefers_sha512():
    md5 = (algorithm="md5", digest="aa")
    sha256 = (algorithm="sha256", digest="bb")
    sha512 = (algorithm="sha512", digest="cc")
    cases = [
        ("sha512 before md5", [md5, sha512], "sha512"),
        ("md5 alone", [md5], "md5"),
        ("sha256 cannot be checked", [sha256], "-"),
        ("none", [], "-"),
    ]
    for name, checksums, want in cases:
        c = swxe.usable_checksum(checksums)
        testing.assertEqual(c.algorithm if c is not None else "-", want, name)


HASH = "3ad02abe" * 16
OTHER_HASH = "0" * 128
VERIFY_COMMAND = "verify /sha512 bootflash:" + IMAGE_FILE + " " + HASH
## What the CLI reads before an install, to tell whether the configuration is saved.
CONFIG_CHANGE_COMMANDS = [clitest.RUNNING_CHANGE_COMMAND, clitest.STARTUP_CHANGE_COMMAND]


def _dir(files: list[str], free: int=1458692096) -> str:
    """dir bootflash: of a C1111, with these files and free bytes."""
    lines = ["", "", "Directory of bootflash:/", ""]
    i = 15
    for f in files:
        lines.append("   " + str(i) + "  -rw-        427968764  Jun 18 2019 18:22:26 +00:00  " + f)
        i += 1
    lines.extend(["", "2885718016 bytes total (" + str(free) + " bytes free)", ""])
    return "\r\n".join(lines)


DIR_STAGED = _dir(["packages.conf", IMAGE_FILE])
DIR_EMPTY = _dir(["packages.conf"])
VERIFY_EQUAL = "\r\n\r\n.....Done!\r\nVerified (bootflash:" + IMAGE_FILE + ") = " + HASH + "\r\n"
VERIFY_DIFFERS = "\r\n\r\n.....Done!\r\n%Error verifying bootflash:" + IMAGE_FILE + \
    "\r\nComputed signature  = " + OTHER_HASH + "\r\nSubmitted signature = " + HASH + "\r\n\r\n"

## verify without an algorithm: the hashes and the signature that the image
## holds, as the C1111 printed them for another image.
VERIFY_IMAGE_COMMAND = "verify bootflash:" + IMAGE_FILE
IMAGE_SIGNED = clitest.VERIFY_IMAGE.replace(clitest.SIGNED_IMAGE, IMAGE_FILE)
## Constructed: the computed SHA1 differs from the embedded one, and the
## device verifies no signature.
IMAGE_UNSIGNED = IMAGE_SIGNED.replace("Computed Hash   SHA1 : A6C3", "Computed Hash   SHA1 : 0000") \
    .replace("Digital signature successfully verified in file bootflash:" + IMAGE_FILE, "")


def new_iosxe_cli_mock_device_mgr(t: testing.EnvT, name: str,
                                  on_reconf: action(str) -> None, files: bool=True) -> swdev.DeviceMgr:
    """A mock device with NETCONF and the IOS XE CLI adapter beside it.
    Without files, its NETCONF has no Cisco-IOS-XE-platform-software-oper."""
    models = list(swxe_yang.models) if files else [swxe_yang.xcopy_rpc, swxe_yang.install_rpc,
                                                   swxe_yang.install_oper, swxe_yang.device_hardware_oper]
    schema = yang.compile(models)
    cli_schema = yang.compile(xecli_yang.models)
    dev_types = {
        "iosxe": swdev.DeviceType(name="iosxe", adapter_type=swna.NetconfAdapter, src_dnode=schema,
                                  oper_src_dnode=schema, software_adapter_type=_fast_adapter),
        "iosxe-cli": swdev.DeviceType(name="iosxe-cli", adapter_type=xecli.IosXeCliAdapter,
                                      src_dnode=cli_schema, oper_src_dnode=cli_schema),
    }
    dev = swdev.DeviceMgr(dev_types, t.env, name, t.log_handler, on_reconf, swdev.SchemaRegistry())
    dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe")
    dmc.mock.enabled = True
    dmc.extra_adapter.create("iosxe-cli")
    dev.set_dmc(dmc)
    return dev


actor _StagingRun(t: testing.EnvT, name: str, dir_output: str, verify_output: str,
                  settled: action(swxemock.IosXeSoftwareMock, xecli.CliMock, swdev.DeviceMgr, str) -> None,
                  timeout: float=2.5, preadded: ?str=None, checksum: bool=True, image_output: str="",
                  running: str=OLD_RELEASE, committed: ?str=None, files: bool=True,
                  verify_delay: float=0.0):
    """Drive one mock device with a sha512 image checksum from software intent
    to a settled status. The CliMock answers dir bootflash: with dir_output,
    and with a listing that has the image once the device took an xcopy, and
    the verify of the image with verify_output. When dir_output lists the
    image, the image is on bootflash from the start. preadded is a release
    that the device has added from the start. Without checksum, the intent
    has no checksum, and the CliMock answers the check of the image's
    signature with image_output. The device runs running, and keeps
    committed when it differs."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var cli: ?xecli.CliMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        c = cli
        d = dev_ref
        if finished or m is None or c is None or d is None:
            return
        if "xcopy" in m!.get_rpcs():
            c!.set_reply("dir bootflash:", DIR_STAGED)
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        settled(m!, c!, d!, st)

    def start() -> None:
        d = dev_ref
        if d is not None:
            mods = d.get_modules().0
            if "Cisco-IOS-XE-install-oper" not in mods or xecli_yang.MODULE not in mods:
                after 0.01: start()
                return
            _attach(d)

    def _attach(d: swdev.DeviceMgr) -> None:
        dev_adapter = d.get_adapter()
        extra = d.get_extra_adapter("iosxe-cli")
        if isinstance(dev_adapter, swna.NetconfAdapter):
            if isinstance(extra, xecli.IosXeCliAdapter):
                ms = dev_adapter.get_mock_server()
                c = extra.get_mock()
                if ms is not None:
                    if c is not None:
                        _run(d, ms, c)
                        return
        finished = True
        t.failure(ValueError("no mock server or CliMock on the device"))

    def _run(d: swdev.DeviceMgr, ms: swna.NetconfMockServer, c: xecli.CliMock) -> None:
        prestaged = IMAGE_FILE if dir_output == DIR_STAGED else None
        m = swxemock.IosXeSoftwareMock(ms, t.log_handler, upgrade_duration=0.0,
                                       failure=swxemock.FAILURE_NONE, running=running,
                                       prestaged=prestaged, preadded=preadded, committed_release=committed)
        mock = m
        cli = c
        m.attach()
        c.set_reply("dir bootflash:", dir_output)
        c.set_reply(clitest.RUNNING_CHANGE_COMMAND, clitest.CONFIG_CHANGE_SAVED)
        c.set_reply(clitest.STARTUP_CHANGE_COMMAND, clitest.CONFIG_CHANGE_SAVED)
        c.set_reply(VERIFY_COMMAND, verify_output)
        c.set_reply(VERIFY_IMAGE_COMMAND, image_output)
        c.set_delay(VERIFY_COMMAND, verify_delay)
        software = Software("camp-1", NEW_REQUESTED, IMAGE_URL)
        if checksum:
            software.image_checksum.create("sha512", HASH)
        dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe", software=software)
        dmc.mock.enabled = True
        dmc.extra_adapter.create("iosxe-cli")
        d.set_dmc(dmc)
        after 0.02: poll()

    def report_timeout() -> None:
        if finished:
            return
        finished = True
        m = mock
        c = cli
        d = dev_ref
        rpcs = m!.get_rpcs() if m is not None else []
        commands = c!.get_commands() if c is not None else []
        st = d!.get_swmgr().get_status() if d is not None else "?"
        t.failure(ValueError("timed out: rpcs={rpcs} commands={commands} status={st}"))

    dev_ref = new_iosxe_cli_mock_device_mgr(t, name, on_reconf, files)
    after 0.01: start()
    after timeout: report_timeout()


actor _test_iosxe_staged_image_is_not_copied_again(t: testing.EnvT):
    """An image on bootflash that matches its checksum stays: the run installs
    it without an xcopy."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["install", "activate", "install-commit", "remove"], m.get_rpcs())
            testing.assertTrue(VERIFY_COMMAND in c.get_commands(), "the image is verified")
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-staged", DIR_STAGED, VERIFY_EQUAL, settled)


actor _test_iosxe_added_image_is_activated(t: testing.EnvT):
    """An image that the device has added already, as after an install that
    stopped after the add, is activated without a new add, which the device
    would refuse."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["activate", "install-commit", "remove"], m.get_rpcs())
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-added", DIR_STAGED, VERIFY_EQUAL, settled,
                preadded=swxe.release_from_filename(IMAGE_FILE))


actor _test_iosxe_added_release_needs_no_image(t: testing.EnvT):
    """A release that the device has added needs no image file, so prepare
    neither copies nor checks one."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["activate", "install-commit", "remove"], m.get_rpcs())
            testing.assertEqual(CONFIG_CHANGE_COMMANDS, c.get_commands(),
                                "no listing and no check of the image, only of the configuration")
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-added-no-file", DIR_EMPTY, VERIFY_EQUAL, settled,
                preadded=swxe.release_from_filename(IMAGE_FILE))


actor _test_iosxe_uncommitted_release_is_committed(t: testing.EnvT):
    """A device that runs the target activated and not committed, as after a
    run that stopped before the commit, is not up to date: the run commits
    the release without an add or an activate."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["install-commit", "remove"], m.get_rpcs())
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-uncommitted", DIR_STAGED, VERIFY_EQUAL, settled,
                preadded=NEW_REQUESTED, running=NEW_REQUESTED, committed=OLD_RELEASE)


actor _test_iosxe_signed_image_stays_without_a_checksum(t: testing.EnvT):
    """Without a checksum, an image on bootflash whose signature the device
    verifies stays."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["install", "activate", "install-commit", "remove"], m.get_rpcs())
            testing.assertTrue(VERIFY_IMAGE_COMMAND in c.get_commands(), "the signature is checked")
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-signed", DIR_STAGED, VERIFY_EQUAL, settled, checksum=False, image_output=IMAGE_SIGNED)


actor _test_iosxe_unsigned_image_fails_prepare(t: testing.EnvT):
    """Without a checksum, an image that fails its signature check is copied
    again; when the copy fails too, prepare fails and nothing is installed."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("failed", status)
            testing.assertEqual(["xcopy"], m.get_rpcs(), "nothing is installed")
            testing.assertEqual("download failed: " + IMAGE_FILE + " fails its signature check",
                                d.get_swmgr().get_reason())
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-unsigned", DIR_STAGED, VERIFY_EQUAL, settled, checksum=False, image_output=IMAGE_UNSIGNED)


actor _test_iosxe_missing_image_is_copied_and_verified(t: testing.EnvT):
    """An image that is not on bootflash is copied, then verified."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["xcopy", "install", "activate", "install-commit", "remove"], m.get_rpcs())
            testing.assertEqual(c.get_commands(), [VERIFY_COMMAND, VERIFY_COMMAND] + CONFIG_CHANGE_COMMANDS,
                                "NETCONF lists; the CLI verifies the copy in prepare and again in install")
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-missing", DIR_EMPTY, VERIFY_EQUAL, settled)


actor _test_iosxe_slow_verify_runs_once(t: testing.EnvT):
    """A check that takes longer than the poll period runs once after the
    transfer: the polls of the transfer stop when it is done."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual([VERIFY_COMMAND, VERIFY_COMMAND] + CONFIG_CHANGE_COMMANDS, c.get_commands(),
                                "one check after the transfer in prepare, one in install")
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-slow-verify", DIR_EMPTY, VERIFY_EQUAL, settled, verify_delay=0.2, timeout=5.0)


actor _test_iosxe_listing_falls_back_to_the_cli(t: testing.EnvT):
    """A device without Cisco-IOS-XE-platform-software-oper lists bootflash
    over the CLI."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
