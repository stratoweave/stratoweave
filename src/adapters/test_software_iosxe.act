actor _test_iosxe_scp_refusal_fails_prepare(t: testing.EnvT):
    """A device that refuses the SCP transfer fails prepare at once, with
    the error of the SCP adapter and what IOS XE needs, and no xcopy. The
    SCP adapter gives a refusal as a PermanentError."""
    error = "SCP to bootflash:" + IMAGE_FILE + " failed: unexpected SCP reply: Administratively disabled."
    recorder = _ScpRecorder(error=error, permanent=True)

    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("failed", status, d.get_swmgr().get_reason())
            reason = d.get_swmgr().get_reason()
            testing.assertTrue(reason is not None and error + " (the device needs ip scp server enable)" in reason, str(reason))
            testing.assertEqual([], m.get_rpcs())
            testing.assertEqual(1, len(recorder.get_calls()))
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        _StagingRun(t, "d-scp-refused", DIR_EMPTY, VERIFY_EQUAL, settled, scp_recorder=recorder,
                    image_file="iosxe/" + IMAGE_FILE)



actor _test_iosxe_scp_progress(t: testing.EnvT):
    """While the SCP adapter sends the image, the prepare job shows how far
    it is, from the size of the file on bootflash."""
    recorder = _ScpRecorder(slow=True)
    var run: ?_StagingRun = None

    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            r = run
            seen = r!.get_progress_seen() if r is not None else []
            testing.assertTrue(u64(40) in seen, "the progress of 400 of 1000 bytes: {seen}")
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        run = _StagingRun(t, "d-scp-progress", DIR_EMPTY, VERIFY_EQUAL, settled, scp_recorder=recorder,
                          sized=True, image_url=False, image_file="iosxe/" + IMAGE_FILE, timeout=5.0)



actor _test_iosxe_image_file_without_scp_fails_prepare(t: testing.EnvT):
    """A device without an SCP adapter fetches its image: an intent with an
    image file and no image URL fails prepare, and so does one with
    neither."""
    var left = 2

    def check(want: str) -> action(swxemock.IosXeSoftwareMock, xecli.CliMock, swdev.DeviceMgr, str) -> None:
        def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
            try:
                testing.assertEqual("failed", status, d.get_swmgr().get_reason())
                reason = d.get_swmgr().get_reason()
                testing.assertTrue(reason is not None and want in reason, str(reason))
                testing.assertEqual([], m.get_rpcs())
            except Exception as e:
                t.failure(e)
                return
            left -= 1
            if left == 0:
                t.success()
        return settled

    def __startup__():
        _StagingRun(t, "d-file-no-scp", DIR_EMPTY, VERIFY_EQUAL,
                    check("no image-url configured: without an SCP adapter, the device fetches its image"),
                    image_url=False, image_file="iosxe/" + IMAGE_FILE)
        _StagingRun(t, "d-no-source", DIR_EMPTY, VERIFY_EQUAL,
                    check("no image-url or image-file configured for release " + NEW_REQUESTED),
                    image_url=False)



actor _test_iosxe_slow_verify_runs_once(t: testing.EnvT):
    """A check that takes longer than the poll period runs once after the
    transfer: the polls of the transfer stop when it is done."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["dir bootflash:", VERIFY_COMMAND, "dir bootflash:"] + CONFIG_CHANGE_COMMANDS,
                                c.get_commands(), "one check after the transfer in prepare, none in install")
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        _StagingRun(t, "d-slow-verify", DIR_EMPTY, VERIFY_EQUAL, settled, verify_delay=0.2, timeout=5.0)



actor _test_iosxe_transfer_progress(t: testing.EnvT):
    """While xcopy writes the image, the prepare job shows how far it is,
    from the size of the file on bootflash."""
