actor _test_iosxe_failed_postcheck_aborts(t: testing.EnvT):
    """A failing post-check sends abort instead of install-commit, and the
    device returns to the old release."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def fail(e: Exception) -> None:
        if not finished:
            finished = True
            t.failure(e)

    def on_reconf(n: str) -> None:
        pass

    def bad_check(done: action(bool, str) -> None) -> None:
        done(False, "bgp neighbors down")

    def assess() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "succeeded":
            fail(ValueError("a failed post-check must not end succeeded"))
            return
        if st != "rolled-back":
            after 0.05: assess()
            return
        finished = True
        testing.assertEqual(["xcopy", "install", "activate", "abort"], m!.get_rpcs(),
                            "unexpected RPCs on the device")
        testing.assertEqual(OLD_REPORTED, m!.get_running(),
                            "the device must be back on the old release")
        t.success()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler)
                mock = m
                m.attach()
                d!.get_swmgr().add_postcheck("test", bad_check)
                dmc = DeviceMetaConfig("d4", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         image_url=IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.05: assess()
                return
        fail(ValueError("no mock server on the device adapter"))


    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, "d4", on_reconf)
        after 0.01: start()
        after 2.5: t.failure(ValueError("timed out"))



actor _test_iosxe_activate_refusal_is_failed(t: testing.EnvT):
    """A refused activate leaves the device on the old release: failed, and
    nothing to abort."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def assess() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "failed":
            finished = True
            testing.assertEqual(["xcopy", "install", "activate"], m!.get_rpcs(),
                                "no abort after a refused activate")
            testing.assertEqual(OLD_REPORTED, m!.get_running(),
                                "the device must still run the old release")
            testing.assertEqual("activate failed: install-smu-not-added: mock refuses to activate",
                                d!.get_swmgr().get_reason(),
                                "the reason must carry the device's refusal")
            t.success()
            return
        if st == "succeeded" or st == "rolled-back":
            finished = True
            t.failure(ValueError("a refused activate must end failed, got {st}"))
            return
        after 0.05: assess()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(
                    ms!, t.log_handler, failure=swxemock.FAILURE_ACTIVATE_REFUSED)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig("d5", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         image_url=IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.05: assess()
                return
        t.failure(ValueError("no mock server on the device adapter"))


    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, "d5", on_reconf)
        after 0.01: start()
        after 2.5: t.failure(ValueError("timed out"))



actor _UpgradeRun(t: testing.EnvT, name: str, upgrade_duration: float,
                  failure: str, running: str, target: str, image_url: str,
                  settled: action(swxemock.IosXeSoftwareMock, swdev.DeviceMgr,
                                  str) -> None,
                  timeout: float=2.5, bundle: bool=False, xcopy_records: bool=True,
                  xcopy_status: bool=True):
    """Drive one mock device from software intent to a settled status, then
    call `settled` with the mock, the device and the status. The timeout
    failure dumps what the device saw. xcopy_records and xcopy_status are
    the mock's."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        settled(m!, d!, st)

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler,
                                               upgrade_duration=upgrade_duration,
                                               failure=failure, running=running, bundle=bundle,
                                               xcopy_records=xcopy_records, xcopy_status=xcopy_status)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig(name, Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", target, image_url=image_url))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.02: poll()
                return
        finished = True
        t.failure(ValueError("no mock server on the device adapter"))

    def report_timeout() -> None:
        if finished:
            return
        finished = True
        m = mock
        d = dev_ref
        rpcs = m!.get_rpcs() if m is not None else []
        run = m!.get_running() if m is not None else "?"
        st = d!.get_swmgr().get_status() if d is not None else "?"
        t.failure(ValueError("timed out: rpcs={rpcs} running={run} status={st}"))


    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, name, on_reconf)
        after 0.01: start()
        after timeout: report_timeout()



actor _test_iosxe_download_failure_fails_in_prepare(t: testing.EnvT):
    """The device accepts the copy and the download fails later, as with a bad
    URL; the run fails in prepare and nothing is installed. Without the
    status of the xcopy, the reason is the one of the records."""
    def settled(m: swxemock.IosXeSoftwareMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("failed", status, "a failed download is a failed run")
            testing.assertEqual(["xcopy"], m.get_rpcs(),
                                "nothing may be installed after a failed download")
            testing.assertEqual(OLD_REPORTED, m.get_running(),
                                "the device must still run the old release")
            testing.assertEqual("download failed: " + swxemock.SUB_DOWNLOAD_FAIL,
                                d.get_swmgr().get_reason(),
                                "the reason must name the download and the device's cause")
            t.success()
        except Exception as e:
            t.failure(e)


    def __startup__():
        _UpgradeRun(t, "d-download", 0.0, swxemock.FAILURE_DOWNLOAD, OLD_RELEASE,
                    NEW_REQUESTED, IMAGE_URL, settled, xcopy_status=False)



