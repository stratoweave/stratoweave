actor _test_iosxe_checksum_mismatch_fails_in_prepare(t: testing.EnvT):
    """An image that differs from its checksum is copied again; when the copy
    differs too, the run fails in prepare and nothing is installed."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("failed", status)
            testing.assertEqual(["xcopy"], m.get_rpcs(), "nothing is installed")
            testing.assertEqual("download failed: checksum mismatch: sha512 of " + IMAGE_FILE + " is " +
                                OTHER_HASH + ", not " + HASH, d.get_swmgr().get_reason())
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-mismatch", DIR_STAGED, VERIFY_DIFFERS, settled)


# The live test upgrades a real IOS XE device through the software manager,
# over NETCONF with the IOS XE CLI adapter beside it. It stages the release
# under a veto first, then lifts the veto. Run it on a lab device
# only, with --tag iosxe-software, the IOSXE_CLI_* settings of
# adapters.test_iosxe_cli, and:
#
#   IOSXE_SOFTWARE_RELEASE    the release to upgrade to, e.g. 17.15.04c
#   IOSXE_SOFTWARE_IMAGE_URL  where the device fetches the image from
#   IOSXE_SOFTWARE_SHA512     the sha512 of the image, optional
#
# NETCONF connects to IOSXE_NETCONF_PORT, default 830.

def _live_adapter(dev: swdev.DeviceMgr, dmc: DeviceMetaConfig, log_handler: logging.Handler,
                  env: ?Env) -> swdev.SoftwareAdapter:
    """The adapter with its default poll periods. Called through the optional
    proc of DeviceType, the class itself gets 0 for its default arguments."""
    return swxe.IosXeSoftwareAdapter(dev, dmc, log_handler, env)


actor _test_live_software_upgrade(t: testing.EnvT):
    """Stage the release under a veto, then lift the veto and upgrade a real
    device. Report the status and the prepare job as they change."""
    t.require("iosxe-software")
    t.timeout(5400.0)
    log = logging.Logger(t.log_handler)
    release = clitest.live_setting(t, "IOSXE_SOFTWARE_RELEASE", "")
    url = clitest.live_setting(t, "IOSXE_SOFTWARE_IMAGE_URL", "")
    sha512 = clitest.live_setting(t, "IOSXE_SOFTWARE_SHA512", "")
    var dev: ?swdev.DeviceMgr = None
    var dmc: ?DeviceMetaConfig = None
    var last = ""
    var finished = False
    var staging = True

    def finish(err: ?Exception):
        if not finished:
            finished = True
            if err is not None:
                t.failure(err)
            else:
                t.success()

    def poll():
        d = dev
        if finished or d is None:
            return
        st = d!.get_swmgr().get_status()
        reason = d!.get_swmgr().get_reason()
        job = d!.get_swmgr().get_job_state("prepare")
        now = "{st} {reason} {job}"
        if now != last:
            last = now
            log.info("software status", {"status": st, "reason": reason, "prepare": job})
        if staging:
            if job == "done" and st == "upgrade-needed":
                staging = False
                m = dmc
                if m is not None:
                    log.info("staged under the veto, lifting it")
                    lifted = DeviceMetaConfig.from_gdata(m.to_gdata())
                    del lifted.software.veto["live-test"]
                    d!.set_dmc(lifted)
                after 15.0: poll()
            elif job == "failed" or st == "failed":
                finish(ValueError("staging failed: {st} {job}"))
            else:
                after 15.0: poll()
        elif st == "succeeded":
            finish(None)
        elif st == "failed" or st == "rolled-back":
            finish(ValueError("the upgrade ended {st}: {reason}"))
        else:
            after now 15.0: poll()

    def connected(tries: int):
        d = dev
        m = dmc
        if finished or d is None or m is None:
            return
        mods = d!.get_modules().0
        wanted = [swxe.INSTALL_MODULE, swxe.XCOPY_MODULE, xecli_yang.MODULE]
        missing = [w for w in wanted if w not in mods]
        if len(missing) == 0:
            log.info("both adapters are up, setting the software intent", {"release": release})
            d!.set_dmc(m!)
            after 5.0: poll()
        elif tries == 0:
            finish(ValueError("the device has no {missing}"))
        else:
            after 1.0: connected(tries - 1)

    if release == "" or url == "":
        finish(ValueError("set IOSXE_SOFTWARE_RELEASE and IOSXE_SOFTWARE_IMAGE_URL"))
    else:
        schema = yang.compile(swxe_yang.models)
        cli_schema = yang.compile(xecli_yang.models)
        types = {
            "iosxe": swdev.DeviceType(name="iosxe", adapter_type=swna.NetconfAdapter, src_dnode=schema,
                                      oper_src_dnode=schema, software_adapter_type=_live_adapter),
            "iosxe-cli": swdev.DeviceType(name="iosxe-cli", adapter_type=xecli.IosXeCliAdapter,
                                          src_dnode=cli_schema, oper_src_dnode=cli_schema),
        }
        d = swdev.DeviceMgr(types, t.env, "xe", t.log_handler, lambda name: None, swdev.SchemaRegistry())
        software = Software("live", release, url, allow_staging=True)
        software.veto.create("live-test", reason="stage first")
        if sha512 != "":
            software.image_checksum.create("sha512", sha512)
        m = DeviceMetaConfig("xe", clitest.live_credentials(t), type="iosxe")
        m.address.create("primary", clitest.live_setting(t, "IOSXE_CLI_ADDRESS", "127.0.0.1"),
                           port=u64(int(clitest.live_setting(t, "IOSXE_NETCONF_PORT", "830"))))
        extra = m.extra_adapter.create("iosxe-cli", port=u64(int(clitest.live_setting(t, "IOSXE_CLI_PORT", "22"))))
        ssh = clitest.live_ssh(t)
        extra.ssh = ExtraSsh(key_exchange=list(ssh.key_exchange), host_key_algorithm=list(ssh.host_key_algorithm),
                             public_key_algorithm=list(ssh.public_key_algorithm))
        # The driver picks its plan from the modules when prepare starts, so
        # the intent waits until both adapters are up.
        d.set_dmc(DeviceMetaConfig.from_gdata(m.to_gdata()))
        m.software = software
        dmc = m
        dev = d
        after 1.0: connected(600)


#############################################################################
# Over the CLI only, as IOS XE 16.8 on a C1111, where NETCONF does not start
#############################################################################

## The old image that a device in bundle mode boots.
BUNDLE_IMAGE = "bootflash:c8000v-universalk9.17.18.02.SPA.bin"
COPY_COMMAND = "copy " + IMAGE_URL + " bootflash:" + IMAGE_FILE
COPY_QUESTION = "Destination filename [" + IMAGE_FILE + "]? "
COPY_DONE = "\r\nAccessing " + IMAGE_URL + "...\r\nLoading " + IMAGE_URL + " !!\r\n1000 bytes copied in 0.128 secs (7812 bytes/sec)"
ADD_COMMAND = "install add file bootflash:" + IMAGE_FILE
ACTIVATE_COMMAND = "install activate auto-abort-timer 30 prompt-level none"
ONE_SHOT_COMMAND = "install add file bootflash:" + IMAGE_FILE + " activate commit prompt-level none"
ADD_DONE = "\r\ninstall_add: START Tue Nov 10 09:43:02 UTC 2026\r\ninstall_add: Adding PACKAGE\r\nFinished Add\r\nSUCCESS: install_add  Tue Nov 10 09:45:02 UTC 2026\r\n"
ACTIVATE_DONE = "\r\ninstall_activate: START Tue Nov 10 09:46:02 UTC 2026\r\nFinished Activate\r\nInstall will reload the system now!\r\nSUCCESS: install_activate  Tue Nov 10 09:48:02 UTC 2026\r\n"
COMMIT_DONE = "\r\ninstall_commit: START Tue Nov 10 10:06:02 UTC 2026\r\nFinished Commit\r\nSUCCESS: install_commit  Tue Nov 10 10:06:12 UTC 2026\r\n"


def _show_version(release: str, image: str) -> str:
    """show version of the C8000V capture, running release from image."""
    return clitest.SHOW_VERSION.replace("Cisco IOS XE Software, Version 17.18.02",
                                        "Cisco IOS XE Software, Version " + release) \
        .replace("System image file is \"bootflash:packages.conf\"", "System image file is \"" + image + "\"")


def _summary(packages: list[str]) -> str:
    """show install summary with these package lines, as IMG   C    17.18.02.0.5540.
    No lines is a device in bundle mode."""
    return clitest.INSTALL_SUMMARY.replace("IMG   C    17.09.05a.0.6476\r\n", "".join([p + "\r\n" for p in packages]))


def _test_cli_version_reads():
    """The release, the versions and the mode, from what the CLI reads."""
    r = xecli_data.root()
    xecli.VersionRead().parse(r, _show_version(OLD_RELEASE, BUNDLE_IMAGE))
    xecli.InstallRead().parse(r, _summary(["IMG   I    " + NEW_VERSION, "IMG   C    " + OLD_VERSION]))
    root = r.to_gdata()
    testing.assertEqual(swxe.running_release(root), OLD_REPORTED)
    testing.assertEqual(swxe.device_versions(root), [(version=NEW_VERSION, state=swxe.VS_INSTALLED),
                                                     (version=OLD_VERSION, state=swxe.VS_COMMITTED)])
    testing.assertEqual(swxe.added_version(root, NEW_REQUESTED), NEW_VERSION)
    testing.assertEqual(swxe.committed_release(root), OLD_RELEASE)
    testing.assertEqual(swxe.bundle_image(root), BUNDLE_IMAGE)
    r2 = xecli_data.root()
    xecli.VersionRead().parse(r2, _show_version(OLD_RELEASE, "bootflash:packages.conf"))
    testing.assertEqual(swxe.bundle_image(r2.to_gdata()), None, "install mode")
    testing.assertEqual(swxe.conversion_boot_lines(BUNDLE_IMAGE),
                        ["no boot system", "boot system flash bootflash:packages.conf",
                         "boot system flash " + BUNDLE_IMAGE])


actor _CliOnlyRun(t: testing.EnvT, name: str, bundle: bool,
                  settled: action(xecli.CliMock, swdev.DeviceMgr, str) -> None,
                  short: bool=False, unsaved: bool=False, other_added: bool=False):
    """Drive a mock device whose NETCONF never connects, over the CLI only,
    from a software intent with a sha512 checksum to a settled status. The
    image is not on bootflash. The device runs OLD_RELEASE, in bundle mode
    or in install mode. The CliMock answers as the device does: each install
    command changes what show version and show install summary say. Each
    such command takes 0.1 s, so the replies change before its output
    comes. When short, the intent has an image size of 600 MB and bootflash
    has 100 MB free until a remove makes room. When unsaved, the running
    configuration changed after the last write memory. When other_added,
    the device has added 17.15.04c until a remove."""
    var dev_ref: ?swdev.DeviceMgr = None
    var cli: ?xecli.CliMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        c = cli
        d = dev_ref
        if finished or c is None or d is None:
            return
        commands = c!.get_commands()
        if COPY_COMMAND in commands:
            c!.set_reply("dir bootflash:", DIR_STAGED)
        elif "install remove inactive" in commands:
            c!.set_reply("dir bootflash:", DIR_EMPTY)
            if other_added and ADD_COMMAND not in commands:
                c!.set_reply("show install summary", _summary(["IMG   C    " + OLD_VERSION]))
        if ADD_COMMAND in commands:
            c!.set_reply("show install summary", _summary(["IMG   I    " + NEW_VERSION, "IMG   C    " + OLD_VERSION]))
        if ACTIVATE_COMMAND in commands or ONE_SHOT_COMMAND in commands:
            c!.set_reply("show version", _show_version(NEW_REQUESTED, "bootflash:packages.conf"))
            if ONE_SHOT_COMMAND in commands:
                c!.set_reply("show install summary", _summary(["IMG   C    " + NEW_VERSION]))
            else:
                c!.set_reply("show install summary", _summary(["IMG   U    " + NEW_VERSION, "IMG   I    " + OLD_VERSION]))
        if "install commit" in commands:
            c!.set_reply("show install summary", _summary(["IMG   C    " + NEW_VERSION]))
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        settled(c!, d!, st)

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if xecli_yang.MODULE not in d!.get_modules().0:
            after 0.01: start()
            return
        extra = d!.get_extra_adapter("iosxe-cli")
        if isinstance(extra, xecli.IosXeCliAdapter):
            c = extra.get_mock()
            if c is not None:
                _run(d!, c)
                return
        finished = True
        t.failure(ValueError("no CliMock on the device"))

    def _run(d: swdev.DeviceMgr, c: xecli.CliMock) -> None:
        cli = c
        image = BUNDLE_IMAGE if bundle else "bootflash:packages.conf"
        c.set_reply("show version", _show_version(OLD_RELEASE, image))
        packages = [] if bundle else ["IMG   C    " + OLD_VERSION]
        if other_added:
            packages = ["IMG   I    17.15.04c.0.107"] + packages
        c.set_reply("show install summary", _summary(packages))
        c.set_reply("dir bootflash:", _dir(["packages.conf"], 100000000) if short else DIR_EMPTY)
        c.set_question(COPY_COMMAND, COPY_QUESTION, "", COPY_DONE)
        c.set_reply(VERIFY_COMMAND, VERIFY_EQUAL)
        c.set_reply(ADD_COMMAND, ADD_DONE)
        c.set_reply(ACTIVATE_COMMAND, ACTIVATE_DONE)
        c.set_reply(ONE_SHOT_COMMAND, clitest.INSTALL_ONE_SHOT)
        c.set_reply("install commit", COMMIT_DONE)
        c.set_reply("write memory", clitest.WRITE_MEMORY)
        c.set_question("install remove inactive", clitest.REMOVE_BEFORE, "y", clitest.REMOVE_AFTER)
        c.set_reply(clitest.RUNNING_CHANGE_COMMAND, clitest.CONFIG_CHANGE_LATER if unsaved else clitest.CONFIG_CHANGE_SAVED)
        c.set_reply(clitest.STARTUP_CHANGE_COMMAND, clitest.CONFIG_CHANGE_SAVED)
        for command in [ADD_COMMAND, ACTIVATE_COMMAND, ONE_SHOT_COMMAND, "install commit", "install remove inactive"]:
            c.set_delay(command, 0.1)
        software = Software("camp-1", NEW_REQUESTED, IMAGE_URL)
        software.image_checksum.create("sha512", HASH)
        if short:
            software.image_size = u64(600000000)
        dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe", software=software)
        dmc.mock.enabled = True
        dmc.extra_adapter.create("iosxe-cli")
        d.set_dmc(dmc)
        after 0.02: poll()

    def report_timeout() -> None:
        if finished:
            return
        finished = True
        c = cli
        d = dev_ref
        commands = c!.get_commands() if c is not None else []
        st = d!.get_swmgr().get_status() if d is not None else "?"
        reason = d!.get_swmgr().get_reason() if d is not None else None
        t.failure(ValueError("timed out: commands={commands} status={st} reason={reason}"))

    schema = yang.compile(swxe_yang.models)
    cli_schema = yang.compile(xecli_yang.models)
    dev_types = {
        "iosxe": swdev.DeviceType(name="iosxe", adapter_type=_never_connects, src_dnode=schema,
                                  oper_src_dnode=schema, software_adapter_type=_fast_adapter),
        "iosxe-cli": swdev.DeviceType(name="iosxe-cli", adapter_type=xecli.IosXeCliAdapter,
                                      src_dnode=cli_schema, oper_src_dnode=cli_schema),
    }
    dev = swdev.DeviceMgr(dev_types, t.env, name, t.log_handler, on_reconf, swdev.SchemaRegistry())
    dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe")
    dmc.mock.enabled = True
    dmc.extra_adapter.create("iosxe-cli")
    dev.set_dmc(dmc)
    dev_ref = dev
    after 0.01: start()
    after 5.0: report_timeout()


actor _test_iosxe_cli_only_install_mode(t: testing.EnvT):
    """Without NETCONF, a device in install mode is upgraded over the CLI:
    copy, check, add, activate with the abort timer, commit."""
    def settled(c: xecli.CliMock, d: swdev.DeviceMgr, st: str) -> None:
        try:
            testing.assertEqual("succeeded", st, d.get_swmgr().get_reason())
            testing.assertEqual(None, d.get_swmgr().get_reason(), "the cleanup succeeded")
            steps = [cmd for cmd in c.get_commands() if cmd.startswith("copy ") or cmd.startswith("install ")]
            testing.assertEqual([COPY_COMMAND, ADD_COMMAND, ACTIVATE_COMMAND, "install commit",
                                 "install remove inactive"], steps)
            testing.assertEqual([], c.get_configured(), "install mode needs no boot statement")
            t.success()
        except Exception as e:
            t.failure(e)
    _CliOnlyRun(t, "d-cli-install", False, settled)


actor _test_iosxe_cli_only_bundle_mode(t: testing.EnvT):
    """Without NETCONF, a device in bundle mode is converted: the boot
    statements name packages.conf and then the old image, the configuration
    is saved, and one command adds, activates and commits."""
    def settled(c: xecli.CliMock, d: swdev.DeviceMgr, st: str) -> None:
        try:
            testing.assertEqual("succeeded", st, d.get_swmgr().get_reason())
            steps = [cmd for cmd in c.get_commands()
                     if cmd.startswith("copy ") or cmd.startswith("install ") or cmd == "write memory"]
            testing.assertEqual([COPY_COMMAND, "write memory", ONE_SHOT_COMMAND, "install remove inactive"], steps)
            testing.assertEqual(swxe.conversion_boot_lines(BUNDLE_IMAGE), c.get_configured())
            t.success()
        except Exception as e:
            t.failure(e)
    _CliOnlyRun(t, "d-cli-bundle", True, settled)


actor _test_iosxe_cli_only_makes_room(t: testing.EnvT):
    """Without room for the image and its packages, the driver removes the
    inactive software first, lists bootflash again, then copies."""
    def settled(c: xecli.CliMock, d: swdev.DeviceMgr, st: str) -> None:
        try:
            testing.assertEqual("succeeded", st, d.get_swmgr().get_reason())
            steps = [cmd for cmd in c.get_commands() if cmd.startswith("copy ") or cmd.startswith("install ")]
            testing.assertEqual(["install remove inactive", COPY_COMMAND, ADD_COMMAND, ACTIVATE_COMMAND,
                                 "install commit", "install remove inactive"], steps)
            t.success()
        except Exception as e:
            t.failure(e)
    _CliOnlyRun(t, "d-cli-room", False, settled, True)


def _test_free_space_and_room():
    """Free space over NETCONF counts in KiB; over the CLI in bytes. The
    room is 2.2 times the image."""
    r = ixoper.root()
    q = r.cisco_platform_software.q_filesystem.create()
    q.partitions.create("bootflash:", total_size=u64(2818084), used_size=u64(1253100))
    testing.assertEqual(swxe.free_space(r.to_gdata()), u64(1564984 * 1024), "NETCONF")
    cli = xecli_data.root()
    xecli.DirRead("bootflash:").parse(cli, DIR_EMPTY)
    testing.assertEqual(swxe.free_space(cli.to_gdata()), u64(1458692096), "CLI")
    testing.assertEqual(swxe.free_space(_files_root([(name="bootflash:", paths=["/bootflash/a.bin"])])), None,
                        "a listing without sizes")
    testing.assertEqual(swxe.room_needed(u64(734643332)), u64(1616215330))
    testing.assertEqual(swxe.room_needed(None), None)


actor _test_iosxe_unsaved_configuration_refuses_the_install(t: testing.EnvT):
    """The running configuration changed after the last write memory: the
    install stops before the add, since the reload would lose the change."""
    def settled(c: xecli.CliMock, d: swdev.DeviceMgr, st: str) -> None:
        try:
            testing.assertEqual("failed", st)
            reason = d.get_swmgr().get_reason()
            testing.assertTrue(reason is not None and "not saved" in reason!, str(reason))
            steps = [cmd for cmd in c.get_commands() if cmd.startswith("install ")]
            testing.assertEqual([], steps, "nothing installed")
            t.success()
        except Exception as e:
            t.failure(e)
    _CliOnlyRun(t, "d-cli-unsaved", False, settled, False, True)


def _test_unsaved_configuration():
    def root(running: str, startup: ?str) -> ygdata.Node:
        r = xecli_data.root()
        xecli.RunningChangeRead().parse(r, running)
        if startup is not None:
            xecli.StartupChangeRead().parse(r, startup)
        return r.to_gdata()
    cases: list[(label: str, running: str, startup: ?str, unsaved: bool)] = [
        (label="saved", running=clitest.CONFIG_CHANGE_SAVED, startup=clitest.CONFIG_CHANGE_SAVED, unsaved=False),
        (label="changed later", running=clitest.CONFIG_CHANGE_LATER, startup=clitest.CONFIG_CHANGE_SAVED, unsaved=True),
        (label="no change since the boot", running=clitest.CONFIG_NOT_CHANGED, startup=clitest.CONFIG_CHANGE_SAVED, unsaved=False),
        (label="no startup line", running=clitest.CONFIG_CHANGE_SAVED, startup=None, unsaved=True),
    ]
    for c in cases:
        testing.assertEqual(swxe.unsaved_configuration(root(c.running, c.startup)) is not None, c.unsaved, c.label)


def _test_other_added_version():
    """Another release that the device added and does not run is removed
    before staging; the committed and the running ones are not."""
    def root(packages: list[str]) -> ygdata.Node:
        r = xecli_data.root()
        xecli.InstallRead().parse(r, _summary(packages))
        return r.to_gdata()
    cases: list[(label: str, packages: list[str], want: ?str)] = [
        (label="another added", packages=["IMG   I    17.15.04c.0.107", "IMG   C    " + OLD_VERSION], want="17.15.04c.0.107"),
        (label="the target added", packages=["IMG   I    " + NEW_VERSION, "IMG   C    " + OLD_VERSION], want=None),
        (label="only the committed", packages=["IMG   C    " + OLD_VERSION], want=None),
        (label="another release activated, not committed",
         packages=["IMG   U    17.15.04c.0.107", "IMG   I    " + OLD_VERSION], want=None),
    ]
    for c in cases:
        testing.assertEqual(swxe.other_added_version(root(c.packages), NEW_REQUESTED), c.want, c.label)


actor _test_iosxe_cli_only_removes_another_added_release(t: testing.EnvT):
    """A run that stopped after the add left 17.15.04c added: the next run
    removes it before staging its own release."""
    def settled(c: xecli.CliMock, d: swdev.DeviceMgr, st: str) -> None:
        try:
            testing.assertEqual("succeeded", st, d.get_swmgr().get_reason())
            steps = [cmd for cmd in c.get_commands() if cmd.startswith("copy ") or cmd.startswith("install ")]
            testing.assertEqual(["install remove inactive", COPY_COMMAND, ADD_COMMAND, ACTIVATE_COMMAND,
                                 "install commit", "install remove inactive"], steps)
            t.success()
        except Exception as e:
            t.failure(e)
    _CliOnlyRun(t, "d-cli-other", False, settled, False, False, True)


def _test_epoch_seconds():
    cases: list[(text: str, want: ?int)] = [
        (text="2026-11-10T23:41:31+00:00", want=1794354091),
        (text="2026-11-10T23:41:31.123456+00:00", want=1794354091),
        (text="2026-11-11T00:41:31+01:00", want=1794354091),
        (text="1970-01-01T00:00:00Z", want=0),
        (text="2000-02-29T12:00:00-05:30", want=951845400),
        (text="2026-11-10 23:41:31", want=None),
        (text="2026-11-10T23:41:31", want=None),
        (text="", want=None),
    ]
    for c in cases:
        testing.assertEqual(swxe.epoch_seconds(c.text), c.want, c.text)


## show install summary on a C1111 activated to 17.15.04c and not committed.
SUMMARY_UNCOMMITTED = "\r\n[ R0 ] Installed Package(s) Information:\r\nState (St): I - Inactive, U - Activated & Uncommitted,\r\n            C - Activated & Committed, D - Deactivated & Uncommitted\r\n--------------------------------------------------------------------------------\r\nType  St   Filename/Version\r\n--------------------------------------------------------------------------------\r\nIMG   U    17.15.04c.0.107\r\n\r\n--------------------------------------------------------------------------------\r\nAuto abort timer: active , time before rollback - 00:25:36\r\n--------------------------------------------------------------------------------\r\n"


def _test_abort_timer_left():
    cli = xecli_data.root()
    xecli.InstallRead().parse(cli, SUMMARY_UNCOMMITTED)
    testing.assertEqual(swxe.abort_timer_left(cli.to_gdata(), 0), 25 * 60 + 36, "CLI")
    testing.assertEqual(swxe.device_versions(cli.to_gdata()),
                        [(version="17.15.04c.0.107", state=swxe.VS_UNCOMMITTED)], "only the activated release")
    committed = xecli_data.root()
    xecli.InstallRead().parse(committed, _summary(["IMG   C    " + OLD_VERSION]))
    testing.assertEqual(swxe.abort_timer_left(committed.to_gdata(), 0), None, "inactive")
    r = ixoper.root()
    loc = r.install_oper_data.install_location_information.create()
    loc.oper_state.auto_abort_timer.state = "install-timer-state-active"
    loc.oper_state.auto_abort_timer.end_time = "2026-11-10T23:41:31+00:00"
    testing.assertEqual(swxe.abort_timer_left(r.to_gdata(), 1794354091 - 1536), 1536, "NETCONF")


actor _test_iosxe_pending_release_is_aborted_first(t: testing.EnvT):
    """The device runs 17.18.04 activated and not committed, as after a run
    that stopped before its commit. An install of another release aborts it
    first; the device reloads to the committed release. The aborted release
    stays added, so staging removes it, which removes the staged image too,
    and transfers again."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["xcopy", "abort", "remove", "xcopy", "install", "activate", "install-commit", "remove"],
                                m.get_rpcs())
            testing.assertEqual(NEW_REPORTED, m.get_running())
            t.success()
        except Exception as e:
            t.failure(e)
    _StagingRun(t, "d-pending", DIR_EMPTY, VERIFY_EQUAL, settled, preadded="17.18.04",
                running="17.18.04", committed=OLD_RELEASE)
