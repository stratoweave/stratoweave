#############################################################################
# The plan and the staging check
#############################################################################

def _test_upgrade_plan_follows_the_modules():
    cli = {xecli_yang.MODULE}
    netconf = {swxe.HARDWARE_MODULE, swxe.XCOPY_MODULE, swxe.INSTALL_MODULE, swxe.FILES_MODULE, swxe.CISCO_RPC_MODULE}
    no_files = {swxe.HARDWARE_MODULE, swxe.XCOPY_MODULE, swxe.INSTALL_MODULE}
    scp_mod = {scp_yang.MODULE}
    # Columns: check, transfer, listing, verify, install, delete.
    cases = [
        ("NETCONF and the CLI, as a C1111 with 17.15", netconf | cli,
         ("netconf", "netconf", "netconf", "cli", "netconf", "netconf")),
        ("NETCONF without the files and delete, and the CLI", no_files | cli,
         ("netconf", "netconf", "cli", "cli", "netconf", "cli")),
        ("only the CLI, as a C1111 with 16.8.1", cli, ("cli", "cli", "cli", "cli", "cli", "cli")),
        ("only NETCONF, without the CLI adapter", netconf, ("netconf", "netconf", "netconf", "", "netconf", "netconf")),
        ("NETCONF, the CLI and SCP", netconf | cli | scp_mod, ("netconf", "scp", "netconf", "cli", "netconf", "netconf")),
        ("only the CLI and SCP", cli | scp_mod, ("cli", "scp", "cli", "cli", "cli", "cli")),
        ("only SCP", scp_mod, ("", "scp", "", "", "", "")),
        ("nothing", set(), ("", "", "", "", "", "")),
    ]
    for name, modules, want in cases:
        p = swxe.upgrade_plan(modules)
        testing.assertEqual((p.check, p.transfer, p.listing, p.verify, p.install, p.delete), want, name)


def _files_root(partitions: list[(name: str, paths: list[str])]) -> ygdata.Node:
    r = ixoper.root()
    q = r.cisco_platform_software.q_filesystem.create()
    for p in partitions:
        entry = q.partitions.create(p.name)
        for path in p.paths:
            entry.partition_content.create(path, size=u64(1))
    return r.to_gdata()


def _dir_root(files: list[str]) -> ygdata.Node:
    r = xecli_data.root()
    fs = r.file_systems.file_system.create("bootflash:")
    for f in files:
        fs.file.create(f, size=u64(1))
    return r.to_gdata()


def _test_staged_file_reads_both_listings():
    image = "c1100-universalk9.17.15.04c.SPA.bin"
    cases = [
        ("NETCONF: on bootflash", _files_root([(name="bootflash:", paths=["/bootflash/packages.conf", "/bootflash/" + image])]), True),
        ("NETCONF: in a subdirectory", _files_root([(name="bootflash:", paths=["/bootflash/old/" + image])]), False),
        ("NETCONF: on another partition", _files_root([(name="webui:", paths=["/bootflash/" + image])]), False),
        ("NETCONF: not there", _files_root([(name="bootflash:", paths=["/bootflash/packages.conf"])]), False),
        ("CLI: on bootflash", _dir_root([image]), True),
        ("CLI: not there", _dir_root(["packages.conf"]), False),
        ("no data", None, False),
    ]
    for name, root, want in cases:
        testing.assertEqual(swxe.staged_file(root, image), want, name)


def _test_file_stamp():
    cli = xecli_data.root()
    fs = cli.file_systems.file_system.create("bootflash:")
    fs.file.create(IMAGE_FILE, size=u64(734643332), modified="2026-11-11T09:04:08+00:00", index=u64(17))
    fs.file.create("no-date.bin", size=u64(1), index=u64(18))
    cases = [
        ("index, size and date", cli.to_gdata(), IMAGE_FILE, "17 734643332 2026-11-11T09:04:08+00:00"),
        ("no date", cli.to_gdata(), "no-date.bin", "-"),
        ("not there", cli.to_gdata(), "other.bin", "-"),
        ("NETCONF listing", _files_root([(name="bootflash:", paths=["/bootflash/" + IMAGE_FILE])]), IMAGE_FILE, "-"),
    ]
    for name, root, filename, want in cases:
        got = swxe.file_stamp(root, filename)
        testing.assertEqual(want, got if got is not None else "-", name)


def _test_check_still_holds():
    stamp = "17 734643332 2026-11-11T09:04:08+00:00"
    passed = (file=IMAGE_FILE, stamp=stamp, check="sha512 aa")
    cases = [
        ("unchanged", passed, IMAGE_FILE, stamp, True),
        ("written again", passed, IMAGE_FILE, "17 734643332 2026-11-12T10:00:00+00:00", False),
        ("copied anew in the same second", passed, IMAGE_FILE, "23 734643332 2026-11-11T09:04:08+00:00", False),
        ("another file", passed, "other.bin", stamp, False),
        ("no stamp", passed, IMAGE_FILE, None, False),
        ("never passed", None, IMAGE_FILE, stamp, False),
    ]
    for name, p, filename, st, want in cases:
        testing.assertEqual(want, swxe.check_still_holds(p, filename, st, "sha512 aa"), name)
    testing.assertEqual(False, swxe.check_still_holds(passed, IMAGE_FILE, stamp, "sha512 bb"), "another checksum")


def _test_adapter_wait_left():
    cases = [
        ("nothing missing", {}, 0.0),
        ("just lost", {"iosxe": 0.0}, 120.0),
        ("lost a while ago", {"iosxe": 100.0}, 20.0),
        ("lost before a whole wait", {"iosxe": 600.0}, 0.0),
        ("the most recent loss counts", {"iosxe": 600.0, "iosxe-cli": 30.0}, 90.0),
    ]
    for name, down, want in cases:
        testing.assertEqual(want, swxe.adapter_wait_left(down, 120.0), name)


def _test_usable_checksum_prefers_sha512():
    md5 = (algorithm="md5", digest="aa")
    sha256 = (algorithm="sha256", digest="bb")
    sha512 = (algorithm="sha512", digest="cc")
    cases = [
        ("sha512 before md5", [md5, sha512], "sha512"),
        ("md5 alone", [md5], "md5"),
        ("sha256 cannot be checked", [sha256], "-"),
        ("none", [], "-"),
    ]
    for name, checksums, want in cases:
        c = swxe.usable_checksum(checksums)
        testing.assertEqual(c.algorithm if c is not None else "-", want, name)


HASH = "3ad02abe" * 16
OTHER_HASH = "0" * 128
VERIFY_COMMAND = "verify /sha512 bootflash:" + IMAGE_FILE + " " + HASH
## What the CLI reads before an install, to tell whether the configuration is saved.
CONFIG_CHANGE_COMMANDS = [clitest.RUNNING_CHANGE_COMMAND, clitest.STARTUP_CHANGE_COMMAND]


def _dir(files: list[str], free: int=1458692096, modified: str="Jun 18 2019 18:22:26",
         size: int=427968764) -> str:
    """dir bootflash: of a C1111, with these files of size bytes, modified
    at modified, and free bytes."""
    lines = ["", "", "Directory of bootflash:/", ""]
    i = 15
    for f in files:
        lines.append("   " + str(i) + "  -rw-        " + str(size) + "  " + modified + " +00:00  " + f)
        i += 1
    lines.extend(["", "2885718016 bytes total (" + str(free) + " bytes free)", ""])
    return "\r\n".join(lines)


DIR_STAGED = _dir(["packages.conf", IMAGE_FILE])
DIR_STAGED_LATER = _dir(["packages.conf", IMAGE_FILE], modified="Nov 11 2026 09:04:08")
DIR_EMPTY = _dir(["packages.conf"])
VERIFY_EQUAL = "\r\n\r\n.....Done!\r\nVerified (bootflash:" + IMAGE_FILE + ") = " + HASH + "\r\n"
VERIFY_DIFFERS = "\r\n\r\n.....Done!\r\n%Error verifying bootflash:" + IMAGE_FILE + \
    "\r\nComputed signature = " + OTHER_HASH + "\r\nSubmitted signature = " + HASH + "\r\n\r\n"

## verify without an algorithm: the hashes and the signature that the image
## holds, as the C1111 printed them for another image.
VERIFY_IMAGE_COMMAND = "verify bootflash:" + IMAGE_FILE
IMAGE_SIGNED = clitest.VERIFY_IMAGE.replace(clitest.SIGNED_IMAGE, IMAGE_FILE)
## Constructed: the computed SHA1 differs from the embedded one, and the
## device verifies no signature.
IMAGE_UNSIGNED = IMAGE_SIGNED.replace("Computed Hash   SHA1 : A6C3", "Computed Hash   SHA1 : 0000") \
    .replace("Digital signature successfully verified in file bootflash:" + IMAGE_FILE, "")


actor _ScpRecorder(error: ?str=None, permanent: bool=False, slow: bool=False):
    """What the SCP adapter of a mock device does. It records each put, and
    gives it error, a PermanentError when permanent and else a
    TransientError, or puts the image on the bootflash of the mock and its
    CliMock. When slow, the image is first there with 400 of its bytes for
    0.3 s."""
    var calls: list[str] = []
    var mock: ?swxemock.IosXeSoftwareMock = None
    var cli: ?xecli.CliMock = None

    def set_device(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock) -> None:
        mock = m
        cli = c

    def connect(dev: swdev.DeviceMgr) -> None:
        dev.on_connect(scp.modules(), None, "scp")

    def _written(file: str, size: int) -> None:
        m = mock
        c = cli
        if m is not None:
            m.place(file, size)
        if c is not None:
            c.set_reply("dir bootflash:", _dir(["packages.conf", file], size=size))

    def _done(file: str, size: int, cb: action(?ygdata.Node, ?Exception) -> None) -> None:
        _written(file, size)
        cb(scp_data.stratoweave_scp__put__output(size=u64(size)).to_gdata(), None)

    def put(cb: action(?ygdata.Node, ?Exception) -> None, request: ygdata.Node) -> None:
        try:
            inp = scp.put_input(request)
        except Exception as e:
            cb(None, e)
            return
        calls.append(inp.local_file + " -> " + inp.remote_file)
        e = error
        if e is not None:
            cb(None, PermanentError(e) if permanent else TransientError(e))
            return
        file = scp.remote_name(inp.remote_file)
        size = swxemock.IMAGE_SIZE
        if slow:
            _written(file, 400)
            after 0.3: _done(file, size, cb)
        else:
            _done(file, size, cb)

    def get_calls() -> list[str]:
        return calls


class _FakeScpAdapter(DeviceAdapter):
    """The SCP adapter of a mock device: it connects at once, and gives each
    put to recorder."""
    def __init__(self, dev: swdev.DeviceMgr, log_handler, env: ?Env, recorder: _ScpRecorder):
        self._log_handler = log_handler
        self._env = env
        self._dev = dev
        self._recorder = recorder

    def supports_mocking(self) -> bool:
        return True

    def set_dmc(self, new_dmc: DeviceMetaConfig):
        self._recorder.connect(self._dev)

    def configure(self, done, new_diff, new_conf, running_conf):
        done(None, None)

    def get_capabilities(self) -> list[str]:
        return []

    def get_modules(self) -> dict[str, ModCap]:
        return scp.modules()

    def subscription_method(self) -> str:
        return SUBSCRIPTION_POLL

    def subscription_status(self) -> SubscriptionStatus:
        return SubscriptionStatus(SUBSCRIPTION_POLL, emulated=True)

    def fetch_config(self, done: action(?ygdata.Node, ?Exception) -> None):
        done(ygdata.Container({}), None)

    def get_config(self) -> ?ygdata.Node:
        return ygdata.Container({})

    def get(self, cb: action(?ygdata.Node, ?Exception) -> None, filt: ?ygdata.FNode=None):
        cb(ygdata.Container({}), None)

    def rpc(self, cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node):
        self._recorder.put(cb, gdata_rpc)

    def rpc_xml(self, cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node):
        cb(None, ValueError("no XML RPCs"))

    def declare_subscriptions(self, owner_id: str, cb: action(?ygdata.Node, ?Exception) -> None,
                              want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        pass

    def remove_subscriptions(self, owner_id: str):
        pass


def _fake_scp(recorder: _ScpRecorder) -> proc(swdev.DeviceMgr, DeviceSchema, DeviceMetaConfig, swdev.SchemaRegistry, logging.Handler, ?Env) -> DeviceAdapter:
    """Return an adapter type whose adapters give their puts to recorder."""
    proc def adapter(dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, dmc: DeviceMetaConfig,
                     registry: swdev.SchemaRegistry, log_handler: logging.Handler, env: ?Env) -> DeviceAdapter:
        return _FakeScpAdapter(dev, log_handler, env, recorder)
    return adapter


def new_iosxe_cli_mock_device_mgr(t: testing.EnvT, name: str,
                                  on_reconf: action(str) -> None, files: bool=True,
                                  scp_recorder: ?_ScpRecorder=None) -> swdev.DeviceMgr:
    """A mock device with NETCONF and the IOS XE CLI adapter beside it.
    Without files, its NETCONF has no Cisco-IOS-XE-platform-software-oper.
    With scp_recorder, the device has an SCP adapter that gives its puts to
    it."""
    models = list(swxe_yang.models) if files else [swxe_yang.xcopy_rpc, swxe_yang.install_rpc,
                                                   swxe_yang.install_oper, swxe_yang.device_hardware_oper]
    schema = yang.compile(models)
    cli_schema = yang.compile(xecli_yang.models)
    dev_types = {
        "iosxe": swdev.DeviceType(name="iosxe", adapter_type=swna.NetconfAdapter, src_dnode=schema,
                                  oper_src_dnode=schema, software_adapter_type=_fast_adapter),
        "iosxe-cli": swdev.DeviceType(name="iosxe-cli", adapter_type=clitest.live_adapter,
                                      src_dnode=cli_schema, oper_src_dnode=cli_schema),
    }
    if scp_recorder is not None:
        scp_schema = yang.compile(scp_yang.models)
        dev_types["scp"] = swdev.DeviceType(name="scp", adapter_type=_fake_scp(scp_recorder),
                                            src_dnode=scp_schema, oper_src_dnode=scp_schema)
    dev = swdev.DeviceMgr(dev_types, t.env, name, t.log_handler, on_reconf, swdev.SchemaRegistry())
    dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe")
    dmc.mock.enabled = True
    dmc.extra_adapter.create("iosxe-cli")
    if scp_recorder is not None:
        dmc.extra_adapter.create("scp")
    dev.set_dmc(dmc)
    return dev


actor _StagingRun(t: testing.EnvT, name: str, dir_output: str, verify_output: str,
                  settled: action(swxemock.IosXeSoftwareMock, xecli.CliMock, swdev.DeviceMgr, str) -> None,
                  timeout: float=2.5, preadded: ?str=None, checksum: bool=True, image_output: str="",
                  running: str=OLD_RELEASE, committed: ?str=None, files: bool=True,
                  verify_delay: float=0.0, restamped: bool=False, upgrade_duration: float=0.0,
                  sized: bool=False, xcopy_records: bool=True, xcopy_status: bool=True,
                  scp_recorder: ?_ScpRecorder=None, image_url: bool=True, image_file: ?str=None):
    """Drive one mock device with a sha512 image checksum from software intent
    to a settled status. The CliMock answers dir bootflash: with dir_output,
    and with a listing that has the image once the device took an xcopy, and
    the verify of the image with verify_output. When dir_output lists the
    image, the image is on bootflash from the start. preadded is a release
    that the device has added from the start. Without checksum, the intent
    has no checksum, and the CliMock answers the check of the image's
    signature with image_output. The device runs running, and keeps
    committed when it differs. When restamped, the image has another date
    after its first check, as when someone copies it again. upgrade_duration
    is the mock's, as are xcopy_records and xcopy_status; when sized, the
    intent has the image size of the mock. With scp_recorder, the device
    has an SCP adapter that gives its puts to it. Without image_url, the
    intent has no image URL; image_file is the image's file in the image
    folder that it names. The progress that the prepare job showed is in
    progress_seen."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var cli: ?xecli.CliMock = None
    var finished = False
    var progress_seen: list[u64] = []

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        c = cli
        d = dev_ref
        if finished or m is None or c is None or d is None:
            return
        if "xcopy" in m!.get_rpcs():
            c!.set_reply("dir bootflash:", DIR_STAGED)
        seen = d!.get_swmgr().get_job_progress("prepare")
        if seen is not None and (len(progress_seen) == 0 or progress_seen[-1] != seen!):
            progress_seen.append(seen!)
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        settled(m!, c!, d!, st)

    def start() -> None:
        d = dev_ref
        if d is not None:
            mods = d.get_modules().0
            if "Cisco-IOS-XE-install-oper" not in mods or xecli_yang.MODULE not in mods or \
                    (scp_recorder is not None and scp_yang.MODULE not in mods):
                after 0.01: start()
                return
            _attach(d)

    def _attach(d: swdev.DeviceMgr) -> None:
        dev_adapter = d.get_adapter()
        extra = d.get_extra_adapter("iosxe-cli")
        if isinstance(dev_adapter, swna.NetconfAdapter):
            if isinstance(extra, xecli.IosXeCliAdapter):
                ms = dev_adapter.get_mock_server()
                c = extra.get_mock()
                if ms is not None:
                    if c is not None:
                        _run(d, ms, c)
                        return
        finished = True
        t.failure(ValueError("no mock server or CliMock on the device"))

    def _run(d: swdev.DeviceMgr, ms: swna.NetconfMockServer, c: xecli.CliMock) -> None:
        prestaged = IMAGE_FILE if dir_output == DIR_STAGED else None
        m = swxemock.IosXeSoftwareMock(ms, t.log_handler, upgrade_duration=upgrade_duration,
                                       failure=swxemock.FAILURE_NONE, running=running,
                                       prestaged=prestaged, preadded=preadded, committed_release=committed,
                                       xcopy_records=xcopy_records, xcopy_status=xcopy_status)
        mock = m
        cli = c
        if scp_recorder is not None:
            scp_recorder.set_device(m, c)
        m.attach()
        c.set_reply("dir bootflash:", dir_output)
        c.set_reply(clitest.RUNNING_CHANGE_COMMAND, clitest.CONFIG_CHANGE_SAVED)
        c.set_reply(clitest.STARTUP_CHANGE_COMMAND, clitest.CONFIG_CHANGE_SAVED)
        c.set_reply(VERIFY_COMMAND, verify_output)
        c.set_reply(VERIFY_IMAGE_COMMAND, image_output)
        c.set_delay(VERIFY_COMMAND, verify_delay)
        if restamped:
            c.set_reply_on(VERIFY_COMMAND, "dir bootflash:", DIR_STAGED_LATER)
        software = Software("camp-1", NEW_REQUESTED, image_url=IMAGE_URL if image_url else None)
        software.image_file = image_file
        if sized:
            software.image_size = u64(swxemock.IMAGE_SIZE)
        if checksum:
            software.image_checksum.create("sha512", HASH)
        dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe", software=software)
        dmc.mock.enabled = True
        dmc.extra_adapter.create("iosxe-cli")
        if scp_recorder is not None:
            dmc.extra_adapter.create("scp")
        d.set_dmc(dmc)
        after 0.02: poll()

    def get_progress_seen() -> list[u64]:
        return progress_seen

    def report_timeout() -> None:
        if finished:
            return
        finished = True
        m = mock
        c = cli
        d = dev_ref
        rpcs = m!.get_rpcs() if m is not None else []
        commands = c!.get_commands() if c is not None else []
        st = d!.get_swmgr().get_status() if d is not None else "?"
        t.failure(ValueError("timed out: rpcs={rpcs} commands={commands} status={st}"))


    def __startup__():
        dev_ref = new_iosxe_cli_mock_device_mgr(t, name, on_reconf, files, scp_recorder)
        after 0.01: start()
        after timeout: report_timeout()



actor _test_iosxe_staged_image_is_not_copied_again(t: testing.EnvT):
    """An image on bootflash that matches its checksum stays: the run installs
    it without an xcopy."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["install", "activate", "install-commit", "remove"], m.get_rpcs())
            testing.assertTrue(VERIFY_COMMAND in c.get_commands(), "the image is verified")
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        _StagingRun(t, "d-staged", DIR_STAGED, VERIFY_EQUAL, settled)



actor _test_iosxe_added_image_is_activated(t: testing.EnvT):
    """An image that the device has added already, as after an install that
    stopped after the add, is activated without a new add, which the device
    would refuse."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
        try:
            testing.assertEqual("succeeded", status, d.get_swmgr().get_reason())
            testing.assertEqual(["activate", "install-commit", "remove"], m.get_rpcs())
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        _StagingRun(t, "d-added", DIR_STAGED, VERIFY_EQUAL, settled,
                    preadded=swxe.release_from_filename(IMAGE_FILE))



actor _test_iosxe_added_release_needs_no_image(t: testing.EnvT):
    """A release that the device has added needs no image file, so prepare
    neither copies nor checks one."""
    def settled(m: swxemock.IosXeSoftwareMock, c: xecli.CliMock, d: swdev.DeviceMgr, status: str) -> None:
