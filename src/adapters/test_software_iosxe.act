OLD_RELEASE = swxemock.OLD_RELEASE
OLD_REPORTED = swxemock.OLD_REPORTED
NEW_REQUESTED = swxemock.NEW_REQUESTED
NEW_REPORTED = swxemock.NEW_REPORTED
IMAGE_FILE = swxemock.IMAGE_FILE
IMAGE_URL = swxemock.IMAGE_URL
OLD_VERSION = swxemock.OLD_VERSION
NEW_VERSION = swxemock.NEW_VERSION


def _hw_ds(version: str) -> ygdata.Node:
    return swxemock.hardware_datastore(version)


def _record(uuid: str, op_id: str, status: str, done: str,
            stages: list[str]) -> ygdata.Node:
    return swxemock.operation_record(uuid, op_id, status, done, stages)


def _oper_ds(version: str, hist: list[ygdata.Node],
             vstates: list[ygdata.Node]=[]) -> ygdata.Node:
    return swxemock.operational_datastore(version, hist, vstates)


def _vstate(state: str, version: str) -> ygdata.Node:
    return swxemock.version_state_info(state, version)

#############################################################################
# Pure-layer tests -- everything the adapter decides from a readout
#############################################################################

def _test_releases_equal_ignores_zero_padding():
    """The device says 17.18.3a where the image file says 17.18.03a. Comparing
    as strings would call a successful upgrade a failure."""
    testing.assertTrue(swxe.releases_equal(NEW_REPORTED, NEW_REQUESTED),
                       "padded and unpadded forms must match")
    testing.assertTrue(swxe.releases_equal("17.18.02", "17.18.2"),
                       "padded and unpadded numerics must match")
    testing.assertFalse(swxe.releases_equal("17.18.3a", "17.18.3b"),
                        "different suffixes are different releases")
    testing.assertFalse(swxe.releases_equal("17.18.3a", "17.16.3a"),
                        "different minors are different releases")
    testing.assertFalse(swxe.releases_equal(None, NEW_REQUESTED),
                        "an unknown release equals nothing")


def _test_release_from_filename_reads_the_version_run():
    """The mock reports whatever image it installed, so the release must come
    out of the file name, whatever the platform prefix and suffix are."""
    testing.assertEqual("17.18.03a", swxe.release_from_filename(IMAGE_FILE),
                        "release not found in the c8000v image name")
    testing.assertEqual("17.18.04",
                        swxe.release_from_filename("c8000v-universalk9.17.18.04.bin"),
                        "release not found without the SPA marker")
    testing.assertTrue(swxe.release_from_filename("recovery.bin") is None,
                       "a name without a version run is no release")


def _test_reported_release_spells_like_the_banner():
    """The banner drops leading zeros per component, and the adapter compares
    per component, so both spellings name one release."""
    testing.assertEqual(NEW_REPORTED, swxe.reported_release(NEW_REQUESTED),
                        "leading zero must be dropped")
    testing.assertEqual("17.18.4", swxe.reported_release("17.18.04"),
                        "a component without suffix must still lose its zero")
    testing.assertTrue(swxe.releases_equal(swxe.reported_release(NEW_REQUESTED),
                                           NEW_REQUESTED),
                       "the banner spelling must compare equal to the request")


def _test_op_seconds_keeps_the_measured_proportions():
    """Each operation gets its measured share of the upgrade duration; 0
    completes at once. The slowest operation sizes the adapter's polls."""
    testing.assertEqual(swxemock.FAST, swxemock.op_seconds("xcopy", 0.0),
                        "duration 0 must complete after FAST")
    testing.assertEqual(130.0, swxemock.op_seconds("xcopy", 395.0),
                        "the measured duration must give the measured staging time")
    testing.assertEqual(480.0, swxemock.op_seconds("activate", 790.0),
                        "twice the duration must double the reload")
    staging = swxemock.op_seconds("xcopy", 60.0)
    testing.assertTrue(staging > 19.7 and staging < 19.8,
                       "a 60 s upgrade must stage for its share, about 19.7 s")
    testing.assertEqual(240.0, swxemock.longest_op_seconds(395.0),
                        "the reload is the slowest operation")
    testing.assertEqual(swxemock.FAST, swxemock.longest_op_seconds(0.0),
                        "at duration 0 nothing is slower than FAST")


def _test_varied_duration_spans_the_variance():
    """A draw of 0 gives the shortest duration the variance allows, 1 the
    longest and 0.5 the configured one; no variance keeps it exact."""
    cases = [
        ("shortest", 60.0, 0.2, 0.0, 48.0),
        ("longest", 60.0, 0.2, 1.0, 72.0),
        ("middle", 60.0, 0.2, 0.5, 60.0),
        ("no variance", 60.0, 0.0, 0.9, 60.0),
        ("full variance", 10.0, 1.0, 0.0, 0.0),
    ]
    for c in cases:
        got = swxemock.varied_duration(c.1, c.2, c.3)
        testing.assertTrue(got > c.4 - 0.001 and got < c.4 + 0.001,
                           "{c.0}: expected {c.4}, got {got}")


def _test_delay_for_prefers_the_upgrade_duration():
    """A positive upgrade duration decides the delay; without one a caller's
    fixed delay applies, and without either the mock is instant."""
    testing.assertEqual(swxemock.FAST, swxemock.delay_for("xcopy", 0.0, None),
                        "no duration and no fixed delay must be instant")
    testing.assertEqual(0.5, swxemock.delay_for("xcopy", 0.0, 0.5),
                        "a fixed delay applies without a duration")
    testing.assertEqual(130.0, swxemock.delay_for("xcopy", 395.0, 0.5),
                        "the duration wins over a fixed delay")
    testing.assertEqual(265.0, swxemock.one_shot_seconds(395.0),
                        "one-shot adds, activates and commits")


def _test_failed_record_stops_at_the_failed_stage():
    """A device reports a failed operation with the stages it ran up to the
    failed one and a notify after it; the adapter reads that as a failure."""
    rec = swxemock.operation_record("u1", "1", swxemock.OP_FAIL, swxe.OP_COMPLETE,
                                    ["install-txn-dwnld-precheck",
                                     "install-txn-download"],
                                    "install-txn-dwnld-precheck",
                                    swxemock.SUB_DOWNLOAD_FAIL)
    ds = _oper_ds(OLD_RELEASE, [rec])
    got = swxe.records_for(ds, "u1")
    testing.assertEqual(1, len(got), "one record expected")
    testing.assertEqual(["install-txn-dwnld-precheck", "install-txn-notify"], got[0].stages,
                        "only the notify may follow the failed stage")
    testing.assertEqual(swxemock.SUB_DOWNLOAD_FAIL, got[0].cause,
                        "the cause is the failed transaction's sub-state")
    v = swxe.aggregate(ds, "u1", swxe.STAGE_DOWNLOAD)
    testing.assertTrue(v.done and v.failed, "a failed record is a finished failure")
    testing.assertEqual(swxemock.SUB_DOWNLOAD_FAIL, v.detail, "the detail is the cause")


def _test_failure_cause_is_the_failed_transaction():
    """The first failed transaction's sub-state, else its command and status,
    else the operation status. The transactions around it must not hide it:
    a c8000v records a failed add as sched, add-prechk (failed) and notify."""
    ok = (cmd="install-txn-sched", status=swxemock.TXN_SUCC, sub_state="install-sub-state-undef")
    prechk = (cmd="install-txn-add-prechk", status=swxe.TXN_FAIL,
              sub_state=swxemock.SUB_VERIFY_FAIL)
    notify = (cmd="install-txn-notify", status=swxemock.TXN_SUCC, sub_state="none")
    testing.assertEqual(swxemock.SUB_VERIFY_FAIL,
                        swxe.failure_cause(swxemock.OP_FAIL, [ok, prechk, notify]),
                        "the failed transaction's sub-state")
    silent = (cmd="install-txn-add-prechk", status=swxe.TXN_FAIL, sub_state="none")
    testing.assertEqual("install-txn-add-prechk: install-txn-sts-fail",
                        swxe.failure_cause(swxemock.OP_FAIL, [ok, silent, notify]),
                        "without a sub-state, the transaction that failed")
    timeout = (cmd="install-txn-download", status="install-txn-sts-timeout", sub_state="")
    testing.assertEqual("install-txn-download: install-txn-sts-timeout",
                        swxe.failure_cause(swxemock.OP_FAIL, [timeout]),
                        "a timed-out transaction failed too")
    testing.assertEqual(swxemock.OP_FAIL, swxe.failure_cause(swxemock.OP_FAIL, [ok]),
                        "without a failed transaction, the operation status")


def _test_finished_record_is_read_before_it_moves():
    """A record that completed while still in install-oper keeps its
    transactions in install-txn-sum-op-hist; they are read there too."""
    rec = swxemock.operation_record("u1", "1", swxemock.OP_FAIL, swxe.OP_COMPLETE,
                                    ["install-txn-add-prechk", "install-txn-verify"],
                                    "install-txn-verify", swxemock.SUB_VERIFY_FAIL)
    ds = swxemock.operational_datastore(OLD_RELEASE, [], active=[rec])
    got = swxe.records_for(ds, "u1")
    testing.assertEqual(1, len(got), "the live record must be read")
    testing.assertEqual(["install-txn-add-prechk", "install-txn-verify", "install-txn-notify"],
                        got[0].stages, "its transactions must be read")
    testing.assertEqual(swxemock.SUB_VERIFY_FAIL, got[0].cause,
                        "the cause must come from them")


def _test_running_release_comes_out_of_the_banner():
    """The leaf carries a whole line, not a version."""
    got = swxe.running_release(_hw_ds(OLD_RELEASE))
    testing.assertEqual(OLD_RELEASE, got, "version not extracted from banner")
    testing.assertEqual(None, swxe.running_release(None),
                        "absent tree has no release")


def _test_aggregate_waits_for_the_terminal_stage():
    """The absence of failures is not completion: a later stage's record may not
    have appeared yet."""
    empty = _oper_ds(OLD_RELEASE, [])
    v0 = swxe.aggregate(empty, "job-1", "install-txn-download")
    testing.assertFalse(v0.done, "no records means not done")
    testing.assertFalse(v0.failed, "and not a failure")

    other = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", swxe.OP_SUCC, swxe.OP_COMPLETE,
                ["install-txn-dwnld-precheck"])])
    v1 = swxe.aggregate(other, "job-1", "install-txn-download")
    testing.assertFalse(v1.done, "must wait for the stage that ends the job")

    full = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", swxe.OP_SUCC, swxe.OP_COMPLETE,
                ["install-txn-dwnld-precheck", "install-txn-download"])])
    v2 = swxe.aggregate(full, "job-1", "install-txn-download")
    testing.assertTrue(v2.done, "done once the stage is there and terminal")
    testing.assertFalse(v2.failed, "and not a failure")


def _test_aggregate_fails_on_a_failed_record():
    root = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", "install-op-fail", swxe.OP_COMPLETE,
                ["install-txn-add-prechk"])])
    v = swxe.aggregate(root, "job-1", "install-txn-download")
    testing.assertTrue(v.done, "a failed operation is finished")
    testing.assertTrue(v.failed, "and must be reported failed")


def _test_aggregate_treats_marked_succ_as_not_a_failure():
    """`install-op-marked-succ` means the device had nothing to do. Not
    confirmation, but not an error either."""
    root = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", swxe.OP_MARKED_SUCC, swxe.OP_COMPLETE,
                ["install-txn-download"])])
    v = swxe.aggregate(root, "job-1", "install-txn-download")
    testing.assertFalse(v.failed, "marked-succ must not read as failure")


def _test_aggregate_ignores_another_uuid():
    """The device keeps finished operations, so a run must not read someone
    else's -- or its own previous attempt's."""
    root = _oper_ds(OLD_RELEASE, [
        _record("someone-else", "1", "install-op-fail", swxe.OP_COMPLETE,
                ["install-txn-download"])])
    v = swxe.aggregate(root, "job-1", "install-txn-download")
    testing.assertFalse(v.failed, "another run's failure is not ours")
    testing.assertFalse(v.done, "and gives us no records")


def _test_aggregate_fails_on_a_reverted_record():
    """The device undoing an operation is terminal, whatever the stages say."""
    reverted = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", swxe.OP_SUCC, swxe.OP_REVERTED,
                ["install-txn-act-prechk", "install-txn-img-act"])])
    v = swxe.aggregate(reverted, "job-1", "install-txn-img-act")
    testing.assertTrue(v.done and v.failed, "op-reverted must read as failed")
    reverting = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", swxe.OP_FAIL_REVERT, "op-not-complete",
                ["install-txn-act-prechk"])])
    v2 = swxe.aggregate(reverting, "job-1", "install-txn-img-act")
    testing.assertTrue(v2.done and v2.failed,
                       "fail-revert must not wait for op-complete")


def _test_current_step_is_the_last_transaction_begun():
    """The step of an operation that runs is the txn-cmd of its last
    transaction, without install-txn-. A finished operation, or one that
    install-oper does not list, has none."""
    add = ["install-txn-add-prechk", "install-txn-copy", "install-txn-verify"]
    running = swxemock.running_record("job-1", "1", add)
    finished = _record("job-1", "1", swxe.OP_SUCC, swxe.OP_COMPLETE, add)
    cases = [
        ("three stages begun", swxemock.operational_datastore(OLD_RELEASE, [], active=[running]),
         "job-1", "verify"),
        ("another uuid", swxemock.operational_datastore(OLD_RELEASE, [], active=[running]), "job-2", None),
        ("finished", _oper_ds(OLD_RELEASE, [finished]), "job-1", None),
        ("no records", _oper_ds(OLD_RELEASE, []), "job-1", None),
        ("a txn-cmd without the prefix",
         swxemock.operational_datastore(OLD_RELEASE, [], active=[swxemock.running_record("job-1", "1", ["notify"])]),
         "job-1", "notify"),
    ]
    for name, ds, uuid, want in cases:
        testing.assertEqual(want, swxe.current_step(ds, uuid), name)


def _test_added_version_picks_the_target_by_prefix():
    """activate needs the device version of the added image, matched by the
    release prefix so the committed running image is not chosen."""
    ds = _oper_ds(OLD_RELEASE, [], [
        _vstate("install-version-state-provisioned-committed", OLD_VERSION),
        _vstate("install-version-state-provisioned-uncommitted", NEW_VERSION),
    ])
    testing.assertEqual(NEW_VERSION, swxe.added_version(ds, NEW_REQUESTED),
                        "must return the added image version for the target")
    testing.assertEqual(None, swxe.added_version(ds, "17.19.01"),
                        "no matching release means no version")


def _test_records_filter_preserves_keyless_history():
    """The mock must return every record from the keyless history list, and
    every transaction of each."""
    root = _oper_ds(OLD_RELEASE, [
        _record("job-1", "1", swxe.OP_SUCC, swxe.OP_COMPLETE,
                ["install-txn-download"]),
        _record("job-2", "1", swxe.OP_SUCC, swxe.OP_COMPLETE,
                ["install-txn-download"]),
        swxemock.operation_record("job-3", "1", swxemock.OP_FAIL, swxe.OP_COMPLETE,
                                  ["install-txn-add-prechk", "install-txn-copy",
                                   "install-txn-verify", "install-txn-extract"],
                                  "install-txn-verify", swxemock.SUB_VERIFY_FAIL),
    ])
    # NetconfMockServer parses the wire filter into an unnamed root FNode.
    filt = ygdata.FNode(children=[swxe.records_filter()])
    got = ygdata.filter(root, filt)
    testing.assertTrue(got is not None, "record filter returned no data")
    oper = ixoper.root.from_gdata(got).install_oper_data
    testing.assertEqual(0, len(oper.install_oper),
                        "empty active list was not preserved")
    testing.assertEqual(3, len(oper.install_oper_hist),
                        "keyless history entries were collapsed")
    failed = swxe.records_for(got, "job-3")
    testing.assertEqual(["install-txn-add-prechk", "install-txn-copy", "install-txn-verify",
                         "install-txn-notify"],
                        failed[0].stages, "keyless transactions were collapsed")
    testing.assertEqual(swxemock.SUB_VERIFY_FAIL, failed[0].cause,
                        "the failed transaction's sub-state was lost")
    hardware = ixoper.root.from_gdata(got).device_hardware_data.device_hardware
    version = hardware.device_system_data.software_version
    testing.assertEqual(None, version,
                        "filter returned an unrelated subtree")


def _test_job_uuid_separates_two_attempts():
    a = swxe.job_uuid("stage", NEW_REQUESTED, "1787835372-104512")
    b = swxe.job_uuid("stage", NEW_REQUESTED, "1787835372-981004")
    testing.assertNotEqual(a, b, "two attempts in one second must differ")
    testing.assertNotEqual(swxe.job_uuid("install", NEW_REQUESTED, "t"),
                           swxe.job_uuid("stage", NEW_REQUESTED, "t"),
                           "the two stages are separate operations")


def _test_job_error_keeps_a_transient_cause():
    """A job that fails for a transient cause ends with a TransientError,
    so that it can be tried again. Any other cause, and no cause, gives a
    ValueError, which needs a person."""
    # (case, the cause, whether the error is transient)
    cases: list[(str, ?Exception, bool)] = [
        ("not connected", NotConnectedError(), True),
        ("connection closed", TransientError("SSH connection closed: eof"), True),
        ("busy", BusyError("b"), True),
        ("CLI error", xecli.CommandError("%Error opening"), False),
        ("other error", ValueError("v"), False),
        ("no cause", None, False),
    ]
    for case in cases:
        err = swxe.job_error("download", "x", case.1)
        testing.assertEqual(swdev.error_text(err), "download failed: x", case.0)
        testing.assertEqual(isinstance(err, TransientError), case.2, case.0)
        testing.assertEqual(isinstance(err, ValueError), not case.2, case.0)


def _test_timeout_error_follows_the_last_poll():
    """A job that does not finish in time is transient when the device did
    not answer the last poll, and needs a person when it did."""
    # (whether the device did not answer, whether the error is transient)
    cases: list[(bool, bool)] = [(True, True), (False, False)]
    for case in cases:
        err = swxe.timeout_error("download", case.0)
        testing.assertEqual(swdev.error_text(err), "download did not finish in time", str(case.0))
        testing.assertEqual(isinstance(err, TransientError), case.1, str(case.0))
        testing.assertEqual(isinstance(err, ValueError), not case.1, str(case.0))


def _test_image_filename_and_paths():
    """Two conventions one stage apart: xcopy wants a bare filename, install
    wants the bootflash: prefix."""
    testing.assertEqual(IMAGE_FILE, swxe.image_filename(IMAGE_URL),
                        "filename must be the last path component of the URL")
    x = swxe.xcopy_input("u", IMAGE_URL, IMAGE_FILE)
    testing.assertEqual(IMAGE_FILE, x.destination_path,
                        "xcopy destination must be a bare filename")
    testing.assertEqual(IMAGE_URL, x.source_path, "source must be the URL")
    i = swxe.install_input("u", IMAGE_FILE)
    testing.assertEqual("bootflash:" + IMAGE_FILE, i.path,
                        "install path must carry the bootflash: prefix")
    testing.assertEqual(False, i.one_shot,
                        "install must only add; activate is a separate step")
    a = swxe.activate_input("u", NEW_VERSION, 30)
    testing.assertEqual(NEW_VERSION, a.version,
                        "activate must name the added image by version")
    testing.assertEqual(u64(30), a.auto_abort_timer_val,
                        "activate must set the abort timer")
    testing.assertEqual("u", swxe.commit_input("u").uuid, "commit carries the uuid")
    testing.assertEqual("u", swxe.abort_input("u").uuid, "abort carries the uuid")


def _test_staged_filename():
    cases: list[(url: ?str, image_file: ?str, want: str)] = [
        (url=IMAGE_URL, image_file=None, want=IMAGE_FILE),
        (url=None, image_file="iosxe/" + IMAGE_FILE, want=IMAGE_FILE),
        (url=None, image_file=IMAGE_FILE, want=IMAGE_FILE),
        (url=IMAGE_URL, image_file="iosxe/other.bin", want="other.bin"),
        (url=IMAGE_URL, image_file="", want=IMAGE_FILE),
        (url=None, image_file=None, want=""),
        (url="", image_file="", want=""),
    ]
    for c in cases:
        testing.assertEqual(swxe.staged_filename(c.url, c.image_file), c.want, "{c.url} {c.image_file}")


def _test_scp_failure_names_the_scp_server():
    cases: list[(detail: str, want: str)] = [
        (detail="SCP to bootflash:x.bin failed: unexpected SCP reply: Administratively disabled.",
         want="SCP to bootflash:x.bin failed: unexpected SCP reply: Administratively disabled. (the device needs ip scp server enable)"),
        (detail="SCP to bootflash:x.bin failed: Write failed",
         want="SCP to bootflash:x.bin failed: Write failed"),
    ]
    for c in cases:
        testing.assertEqual(swxe.scp_failure(c.detail), c.want, c.detail)


def _test_redact_url_strips_credentials():
    """scp sources carry a password in the URL, and the URL gets logged."""
    testing.assertEqual("scp://***@10.0.0.9:/images/" + IMAGE_FILE,
                        swxe.redact_url(IMAGE_URL),
                        "credentials must not survive")
    testing.assertEqual("http://images/x.bin",
                        swxe.redact_url("http://images/x.bin"),
                        "a URL with no credentials is left alone")


def _test_mock_bgp_follows_the_failure():
    """bgp-down keeps the mock's BGP session idle, bgp-lost only while the
    activated release runs uncommitted; every other failure leaves it up."""
    testing.assertTrue(swxemock.bgp_up("reverts", NEW_REPORTED, OLD_RELEASE),
                       "other failures leave BGP up")
    testing.assertFalse(swxemock.bgp_up("bgp-down", OLD_RELEASE, OLD_RELEASE),
                        "bgp-down is idle from the start")
    testing.assertTrue(swxemock.bgp_up("bgp-lost", OLD_RELEASE, OLD_RELEASE),
                       "bgp-lost is up before the upgrade")
    testing.assertFalse(swxemock.bgp_up("bgp-lost", NEW_REPORTED, OLD_RELEASE),
                        "bgp-lost is idle on the uncommitted release")
    testing.assertTrue(swxemock.bgp_up("bgp-lost", NEW_REPORTED, NEW_REPORTED),
                       "bgp-lost is up again once committed")


def _test_mock_interfaces_follow_the_failure():
    """interface-lost takes two interfaces down only while the activated
    release runs uncommitted; the shut interface stays down either way."""
    testing.assertTrue(swxemock.interfaces_up("bgp-lost", NEW_REPORTED, OLD_RELEASE),
                       "other failures leave the interfaces up")
    testing.assertTrue(swxemock.interfaces_up("interface-lost", OLD_RELEASE, OLD_RELEASE),
                       "interface-lost is up before the upgrade")
    testing.assertFalse(swxemock.interfaces_up("interface-lost", NEW_REPORTED, OLD_RELEASE),
                        "interface-lost is down on the uncommitted release")
    down = swxemock.interfaces_datastore(False).to_xmlstr()
    testing.assertEqual(down.count("if-oper-state-no-pass"), 3)
    testing.assertEqual(swxemock.interfaces_datastore(True).to_xmlstr().count("if-oper-state-no-pass"), 1)


def _test_mock_ospf_follows_the_failure():
    """ospf-lost keeps one OSPF neighbor in init only while the activated
    release runs uncommitted."""
    testing.assertTrue(swxemock.ospf_full("interface-lost", NEW_REPORTED, OLD_RELEASE),
                       "other failures leave OSPF full")
    testing.assertTrue(swxemock.ospf_full("ospf-lost", OLD_RELEASE, OLD_RELEASE),
                       "ospf-lost is full before the upgrade")
    testing.assertFalse(swxemock.ospf_full("ospf-lost", NEW_REPORTED, OLD_RELEASE),
                        "ospf-lost is stuck on the uncommitted release")
    testing.assertEqual(swxemock.ospf_datastore(True).to_xmlstr().count("ospf-nbr-full"), 2)
    testing.assertEqual(swxemock.ospf_datastore(False).to_xmlstr().count("ospf-nbr-init"), 1)


#############################################################################
# Device-level tests, through the mock
#############################################################################

proc def _fast_adapter(dev: swdev.DeviceMgr, dmc: DeviceMetaConfig,
                  log_handler: logging.Handler,
                  env: ?Env) -> swdev.SoftwareAdapter:
    """The adapter with the poll periods wound down.

    Production polls every 10 s and 20 s because a transfer and a reload take
    minutes. A test that waited for those would take a minute per assertion, so
    the device type here names a factory instead of the class.
    """
    return swxe.IosXeSoftwareAdapter(dev, dmc, log_handler, env,
                                     0.02, 0.02, 0.3)


def new_iosxe_mock_device_mgr(t: testing.EnvT, name: str,
                              on_reconf: action(str) -> None) -> swdev.DeviceMgr:
    schema = yang.compile(swxe_yang.models)
    dev_types = {
        "iosxe": swdev.DeviceType(
            name="iosxe",
            adapter_type=swna.NetconfAdapter,
            src_dnode=schema,
            oper_src_dnode=schema,
            software_adapter_type=_fast_adapter)
    }
    dev = swdev.DeviceMgr(dev_types, t.env,
                          name, t.log_handler, on_reconf, swdev.SchemaRegistry())
    dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe")
    dmc.mock.enabled = True
    dev.set_dmc(dmc)
    return dev


class _SilentAdapter(NoAdapter):
    """An adapter that never connects, as an IOS XE CLI adapter whose device
    does not answer. It mocks, so that mock mode keeps it."""
    def supports_mocking(self) -> bool:
        return True


def _never_connects(dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, dmc: DeviceMetaConfig,
                    registry: swdev.SchemaRegistry, log_handler: logging.Handler, env: ?Env) -> DeviceAdapter:
    return _SilentAdapter(bundled_schema, log_handler, env)


proc def _test_iosxe_staging_waits_for_adapters(t: testing.EnvT):
    """Staging waits for an adapter that is not connected, then stages with
    the adapters that are there: without the CLI, it transfers the image."""
    t.timeout(10.0)
    schema = yang.compile(swxe_yang.models)
    _test_iosxe_staging_waits_for_adaptersActor(t=t, schema=schema)


actor _test_iosxe_staging_waits_for_adaptersActor(t: testing.EnvT, schema: yschema.DRoot):
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        try:
            testing.assertEqual("succeeded", st, d!.get_swmgr().get_reason())
            testing.assertEqual(["never"], d!.get_unconnected_adapters())
            testing.assertEqual(["xcopy", "install", "activate", "install-commit", "remove"], m!.get_rpcs())
            t.success()
        except Exception as e:
            t.failure(e)

    def start() -> None:
        d = dev_ref
        if d is not None:
            if swxe.INSTALL_MODULE not in d.get_modules().0:
                after 0.01: start()
                return
            a = d.get_adapter()
            if isinstance(a, swna.NetconfAdapter):
                ms = a.get_mock_server()
                if ms is not None:
                    m = swxemock.IosXeSoftwareMock(ms, t.log_handler, running=OLD_RELEASE)
                    mock = m
                    m.attach()
                    dmc = DeviceMetaConfig("d-waits", Credentials("admin", "admin"), type="iosxe",
                                           software=Software("camp-1", NEW_REQUESTED, image_url=IMAGE_URL))
                    dmc.mock.enabled = True
                    dmc.extra_adapter.create("never")
                    d.set_dmc(dmc)
                    after 0.02: poll()
                    return
            finished = True
            t.failure(ValueError("no NETCONF mock server"))

    dev_types = {
        "iosxe": swdev.DeviceType(name="iosxe", adapter_type=swna.NetconfAdapter, src_dnode=schema,
                                  oper_src_dnode=schema, software_adapter_type=_fast_adapter),
        "never": swdev.DeviceType(name="never", adapter_type=_never_connects, src_dnode=schema),
    }
    d = swdev.DeviceMgr(dev_types, t.env, "d-waits", t.log_handler, on_reconf, swdev.SchemaRegistry())
    def __startup__():
        dmc = DeviceMetaConfig("d-waits", Credentials("admin", "admin"), type="iosxe")
        dmc.mock.enabled = True
        dmc.extra_adapter.create("never")
        d.set_dmc(dmc)
        dev_ref = d
        after 0.01: start()



proc def _test_iosxe_prepare_without_a_connected_adapter_is_transient(t: testing.EnvT):
    """A prepare on a device whose only adapter never connects waits for
    the adapter, and then ends with a TransientError: a later try can
    succeed once the adapter connects."""
    t.timeout(10.0)
    schema = yang.compile(swxe_yang.models)
    _UnconnectedPrepareActor(t=t, schema=schema, jobs=1)


proc def _test_iosxe_a_second_job_is_busy(t: testing.EnvT):
    """A job that comes while another job runs on the driver ends at once
    with a BusyError."""
    t.timeout(10.0)
    schema = yang.compile(swxe_yang.models)
    _UnconnectedPrepareActor(t=t, schema=schema, jobs=2)


actor _UnconnectedPrepareActor(t: testing.EnvT, schema: yschema.DRoot, jobs: int):
    """Give jobs prepares to the driver of a device whose only adapter
    never connects, and check how the last one ends."""
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def check(err: ?Exception, busy: bool, text: str) -> None:
        if finished:
            return
        finished = True
        try:
            if err is None:
                raise ValueError("the prepare did not fail")
            testing.assertEqual(swdev.error_text(err!), text)
            if busy:
                testing.assertTrue(isinstance(err!, BusyError), "a BusyError")
            else:
                testing.assertTrue(isinstance(err!, TransientError), "a TransientError")
            t.success()
        except Exception as e:
            t.failure(e)

    def first_done(err: ?Exception) -> None:
        if jobs == 1:
            check(err, False, "download failed: no adapter that can transfer the image is connected")

    def second_done(err: ?Exception) -> None:
        check(err, True, "software job already running: stage")

    dev_types = {
        "iosxe": swdev.DeviceType(name="iosxe", adapter_type=_never_connects, src_dnode=schema),
    }
    d = swdev.DeviceMgr(dev_types, t.env, "d-unconnected", t.log_handler, on_reconf,
                        swdev.SchemaRegistry())
    def __startup__():
        dmc = DeviceMetaConfig("d-unconnected", Credentials("admin", "admin"), type="iosxe",
                               software=Software(image_url=IMAGE_URL))
        d.set_dmc(dmc)
        a = swxe.IosXeSoftwareAdapter(d, dmc, t.log_handler, t.env, 0.02, 0.02, 0.3)
        a.prepare(first_done, NEW_REQUESTED)
        if jobs == 2:
            a.prepare(second_done, NEW_REQUESTED)


proc def _test_iosxe_room_without_a_connected_remove_is_transient(t: testing.EnvT):
    """A prepare that must make room on bootflash ends with a TransientError
    while no adapter that can remove software is connected: a later try can
    succeed once that adapter connects. The device lists bootflash over
    NETCONF with too little room for the image, has no install RPC there,
    and its other adapter never connects."""
    t.timeout(10.0)
    schema = yang.compile([swxe_yang.platform_software_oper])
    _RoomWithoutRemoveActor(t=t, schema=schema)


actor _RoomWithoutRemoveActor(t: testing.EnvT, schema: yschema.DRoot):
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def done(err: ?Exception) -> None:
        if finished:
            return
        finished = True
        try:
            if err is None:
                raise ValueError("the prepare did not fail")
            testing.assertEqual(swdev.error_text(err!),
                                "remove failed: no adapter that can remove software is connected")
            testing.assertTrue(isinstance(err!, TransientError), "a TransientError")
            t.success()
        except Exception as e:
            t.failure(e)

    def dmc() -> DeviceMetaConfig:
        m = DeviceMetaConfig("d-room", Credentials("admin", "admin"), type="iosxe",
                             software=Software(image_url=IMAGE_URL, image_size=u64(734643332)))
        m.mock.enabled = True
        m.extra_adapter.create("never")
        return m

    dev_types = {
        "iosxe": swdev.DeviceType(name="iosxe", adapter_type=swna.NetconfAdapter, src_dnode=schema,
                                  oper_src_dnode=schema),
        "never": swdev.DeviceType(name="never", adapter_type=_never_connects, src_dnode=schema),
    }
    d = swdev.DeviceMgr(dev_types, t.env, "d-room", t.log_handler, on_reconf, swdev.SchemaRegistry())

    def start() -> None:
        if swxe.FILES_MODULE not in d.get_modules().0:
            after 0.01: start()
            return
        a = d.get_adapter()
        if isinstance(a, swna.NetconfAdapter):
            ms = a.get_mock_server()
            if ms is not None:
                r = ixoper.root()
                q = r.cisco_platform_software.q_filesystem.create()
                q.partitions.create("bootflash:", total_size=u64(2818084), used_size=u64(2800000))
                ms.set_oper_ds(r.to_gdata())
                drv = swxe.IosXeSoftwareAdapter(d, dmc(), t.log_handler, t.env, 0.02, 0.02, 0.3)
                drv.prepare(done, NEW_REQUESTED)
                return
        finished = True
        t.failure(ValueError("no NETCONF mock server"))

    def __startup__():
        d.set_dmc(dmc())
        after 0.01: start()


actor _test_iosxe_upgrade_through_the_software_manager(t: testing.EnvT):
    """Run an IOS XE upgrade from software intent through the NETCONF mock."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def fail(e: Exception) -> None:
        if not finished:
            finished = True
            t.failure(e)

    def on_reconf(n: str) -> None:
        pass

    def assess() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        if m!.get_running() != NEW_REPORTED:
            return
        if d!.get_swmgr().get_status() == "in-progress":
            # The manager marks the run succeeded one poll after the mock
            # reports the new release; keep polling until it catches up.
            return
        finished = True
        testing.assertEqual(["xcopy", "install", "activate", "install-commit", "remove"],
                            m!.get_rpcs(), "unexpected RPCs on the device")
        inp = m!.get_inputs()
        testing.assertEqual(IMAGE_URL, inp.source,
                            "xcopy source must be image-url verbatim")
        testing.assertEqual(IMAGE_FILE, inp.destination,
                            "xcopy destination must be the bare filename")
        testing.assertEqual("bootflash:" + IMAGE_FILE, inp.path,
                            "install path must carry the bootflash: prefix")
        testing.assertEqual("false", inp.one_shot, "install must only add")
        testing.assertEqual(NEW_VERSION, inp.act_version,
                            "activate must name the added image by version")
        testing.assertEqual("30", inp.timer,
                            "activate must set a 30 minute abort timer")
        testing.assertEqual(NEW_REPORTED, m!.get_committed(),
                            "the new release must be committed")
        testing.assertEqual("succeeded", d!.get_swmgr().get_status(),
                            "the run must end succeeded")
        t.success()

    def poll() -> None:
        if finished:
            return
        assess()
        if not finished:
            after 0.05: poll()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                # Uncommitted, the mock reverts after a second; the run must commit first.
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler)
                mock = m
                m.attach()
                # Intent: the release, and where the device fetches it from.
                dmc = DeviceMetaConfig("d1", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         image_url=IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.05: poll()
                return
        fail(ValueError("no mock server on the device adapter"))

    def report_timeout() -> None:
        m = mock
        d = dev_ref
        rpcs = m!.get_rpcs() if m is not None else []
        run = m!.get_running() if m is not None else "?"
        st = d!.get_swmgr().get_status() if d is not None else "?"
        fail(ValueError("timed out: rpcs={rpcs} running={run} status={st}"))

    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, "d1", on_reconf)
        after 0.01: start()

        after 2.5: report_timeout()



actor _test_iosxe_install_reports_its_steps(t: testing.EnvT):
    """While the install runs, its job says what the device does: the
    stages of the add and of the activate that the device lists, then the
    wait for the reload. After the install, the job says when the commit
    window ends."""
    expected = ["add", "add: add-prechk", "add: copy", "add: verify", "add: extract", "add: add-postchk",
                "activate", "activate: act-prechk", "activate: img-act", "activate: reload",
                "waiting for the device to boot"]
    var dev_ref: ?swdev.DeviceMgr = None
    var seen: list[str] = []
    var window = ""
    var finished = False

    def fail(e: Exception) -> None:
        if not finished:
            finished = True
            t.failure(e)

    def on_reconf(n: str) -> None:
        pass

    def assess() -> None:
        # Each step must be one that the device or the driver gives, in
        # order. A poll can miss a stage; it cannot miss the steps that the
        # driver reports itself.
        i = 0
        for step in seen:
            while i < len(expected) and expected[i] != step:
                i += 1
            if i == len(expected):
                raise ValueError("unexpected step {step} in {seen}")
        for step in ["add", "activate", "waiting for the device to boot"]:
            if step not in seen:
                raise ValueError("no {step} in {seen}")
        if not any([s.startswith("add: ") for s in seen]) or not any([s.startswith("activate: ") for s in seen]):
            raise ValueError("no stage of the device in {seen}")
        if not window.startswith("commit window ends "):
            raise ValueError("no commit window: {window}")

    def on_state(oper: ?ygdata.Node) -> None:
        if oper is not None and not finished:
            st = swdevoper.stratoweave_rfs__device_entry.from_gdata(oper).software.state
            a = st.attempt.get(u64(0))
            if a is not None:
                on_software(a)

    def on_software(st: swdevoper.stratoweave_rfs__device__software__state__attempt_entry) -> None:
        job = st.job.get("install")
        if job is not None:
            m = job.message
            if m is not None:
                if job.state == "running" and (len(seen) == 0 or seen[-1] != m):
                    seen.append(m)
                elif job.state == "done" and m.startswith("commit window "):
                    window = m
        if st.status == "succeeded":
            finished = True
            try:
                assess()
            except Exception as e:
                t.failure(e)
                return
            t.success()
        elif st.status == "failed":
            fail(ValueError("the run failed: {st.reason}"))

    def start() -> None:
        d = dev_ref
        if d is not None:
            if "Cisco-IOS-XE-install-oper" not in d.get_modules().0:
                after 0.01: start()
                return
            dev_adapter = d.get_adapter()
            if isinstance(dev_adapter, swna.NetconfAdapter):
                ms = dev_adapter.get_mock_server()
                if ms is not None:
                    # Each operation takes 0.4 s, many polls per stage.
                    m = swxemock.IosXeSoftwareMock(ms, t.log_handler, complete_after=0.4)
                    m.attach()
                    d.set_update_oper(on_state)
                    dmc = DeviceMetaConfig("d-steps", Credentials("admin", "admin"), type="iosxe",
                                           software=Software("camp-1", NEW_REQUESTED,
                                                             image_url=IMAGE_URL))
                    dmc.mock.enabled = True
                    d.set_dmc(dmc)
                    return
        fail(ValueError("no mock server on the device adapter"))


    def __startup__():
        t.timeout(10.0)
        dev_ref = new_iosxe_mock_device_mgr(t, "d-steps", on_reconf)
        after 0.01: start()



actor _test_iosxe_device_already_on_target_sends_nothing(t: testing.EnvT):
    """Send no RPCs when the reported and requested releases are equivalent."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def fail(e: Exception) -> None:
        if not finished:
            finished = True
            t.failure(e)

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "up-to-date":
            finished = True
            testing.assertEqual([], m!.get_rpcs(),
                                "a device already on target must get no RPCs")
            testing.assertEqual(NEW_REPORTED, m!.get_running(),
                                "the device must not have been touched")
            t.success()
            return
        if st == "in-progress" or st == "succeeded":
            fail(ValueError("ran an upgrade on a device already on target, "
                            "status={st} rpcs={m!.get_rpcs()}"))
            return
        after 0.05: poll()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                # The device is already there, in its own spelling.
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler,
                                               running=NEW_REPORTED)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig("d1", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         image_url=IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.05: poll()
                return
        fail(ValueError("no mock server on the device adapter"))


    def report_timeout() -> None:
        m = mock
        d = dev_ref
        rpcs = m!.get_rpcs() if m is not None else []
        st = d!.get_swmgr().get_status() if d is not None else "?"
        fail(ValueError("timed out: rpcs={rpcs} status={st}"))

    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, "d1", on_reconf)
        after 0.01: start()

        after 2.5: report_timeout()



actor _test_iosxe_reply_is_not_completion(t: testing.EnvT):
    """The mock replies <ok/> before it moves any state, as the device does.

    So immediately after the RPCs are accepted the device still reports the old
    release. An adapter that treated the reply as completion would report the
    upgrade done here. A second look 0.2 s later shows the copy still running,
    which is what a configured upgrade duration must do.
    """
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def still_copying() -> None:
        m = mock
        if finished or m is None:
            return
        finished = True
        try:
            testing.assertEqual(OLD_REPORTED, m!.get_running(),
                                "the release must not move while the copy runs")
            testing.assertEqual(["xcopy"], m!.get_rpcs(),
                                "no install may be sent while the copy runs")
            t.success()
        except Exception as e:
            t.failure(e)

    def check_then_wait() -> None:
        m = mock
        if finished or m is None:
            return
        if "xcopy" not in m!.get_rpcs():
            after 0.01: check_then_wait()
            return
        # Accepted, but with 40 s for the whole upgrade the copy takes 13 s, so
        # nothing can have changed yet, nor 0.2 s from now, however loaded the
        # machine is.
        testing.assertEqual(OLD_REPORTED, m!.get_running(),
                            "an accepted RPC must not have moved the release")
        after 0.2: still_copying()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler, upgrade_duration=40.0)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig("d2", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         image_url=IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.01: check_then_wait()
                return
        t.failure(ValueError("no mock server on the device adapter"))


    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, "d2", on_reconf)
        after 0.01: start()
        after 2.5: t.failure(ValueError("timed out"))



actor _test_iosxe_device_failure_is_reported(t: testing.EnvT):
    """A device-side failure of the add operation surfaces as a failed run,
    and the manager never claims success. The device refused the image, so
    the driver deletes it, and the next run transfers it again."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def assess() -> None:
        d = dev_ref
        m = mock
        if finished or d is None or m is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "failed":
            finished = True
            testing.assertEqual("add failed: " + swxemock.SUB_VERIFY_FAIL + "; deleted bootflash:" + IMAGE_FILE,
                                d!.get_swmgr().get_reason(),
                                "the reason must name the add, the device's cause and the deletion")
            testing.assertEqual(["xcopy", "install", "delete"], m!.get_rpcs())
            t.success()
            return
        if st == "succeeded":
            finished = True
            t.failure(ValueError("a failed add must not report succeeded"))
            return
        after 0.05: assess()

    def start() -> None:
        d = dev_ref
        if d is None:
            return
        if "Cisco-IOS-XE-install-oper" not in d!.get_modules().0:
            after 0.01: start()
            return
        dev_adapter = d!.get_adapter()
        if isinstance(dev_adapter, swna.NetconfAdapter):
            ms = dev_adapter.get_mock_server()
            if ms is not None:
                m = swxemock.IosXeSoftwareMock(ms!, t.log_handler,
                                               failure=swxemock.FAILURE_ADD)
                mock = m
                m.attach()
                dmc = DeviceMetaConfig("d3", Credentials("admin", "admin"),
                                       type="iosxe",
                                       software=Software("camp-1", NEW_REQUESTED,
                                                         image_url=IMAGE_URL))
                dmc.mock.enabled = True
                d!.set_dmc(dmc)
                after 0.05: assess()
                return
        t.failure(ValueError("no mock server on the device adapter"))


    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, "d3", on_reconf)
        after 0.01: start()
        after 2.5: t.failure(ValueError("timed out"))



actor _NetconfOnlyRun(t: testing.EnvT, name: str,
                      settled: action(swxemock.IosXeSoftwareMock, swdev.DeviceMgr, str) -> None,
                      image_size: int, mock_image_size: int=swxemock.IMAGE_SIZE,
                      prestaged: bool=False, prestaged_size: ?int=None):
    """Drive one mock device with NETCONF and no CLI adapter, so that it can
    compute no checksum, from software intent with image_size to a settled
    status. The mock fetches images of mock_image_size, and with prestaged
    has the image on bootflash from the start, of prestaged_size."""
    var dev_ref: ?swdev.DeviceMgr = None
    var mock: ?swxemock.IosXeSoftwareMock = None
    var finished = False

    def on_reconf(n: str) -> None:
        pass

    def poll() -> None:
        m = mock
        d = dev_ref
        if finished or m is None or d is None:
            return
        st = d!.get_swmgr().get_status()
        if st == "unknown" or st == "in-progress":
            after 0.02: poll()
            return
        finished = True
        settled(m!, d!, st)

    def start() -> None:
        d = dev_ref
        if d is not None:
            if swxe.INSTALL_MODULE not in d.get_modules().0:
                after 0.01: start()
                return
            a = d.get_adapter()
            if isinstance(a, swna.NetconfAdapter):
                ms = a.get_mock_server()
                if ms is not None:
                    m = swxemock.IosXeSoftwareMock(ms, t.log_handler, running=OLD_RELEASE,
                                                   prestaged=IMAGE_FILE if prestaged else None,
                                                   image_size=mock_image_size, prestaged_size=prestaged_size)
                    mock = m
                    m.attach()
                    software = Software("camp-1", NEW_REQUESTED, image_url=IMAGE_URL)
                    software.image_size = u64(image_size)
                    dmc = DeviceMetaConfig(name, Credentials("admin", "admin"), type="iosxe", software=software)
                    dmc.mock.enabled = True
                    d.set_dmc(dmc)
                    after 0.02: poll()
                    return
            finished = True
            t.failure(ValueError("no NETCONF mock server"))

    def report_timeout() -> None:
        if not finished:
            finished = True
            m = mock
            rpcs = m!.get_rpcs() if m is not None else []
            t.failure(ValueError("timed out: rpcs={rpcs}"))


    def __startup__():
        dev_ref = new_iosxe_mock_device_mgr(t, name, on_reconf)
        after 0.01: start()
        after 2.5: report_timeout()



