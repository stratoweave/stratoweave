            r = run
            seen = r!.get_progress_seen() if r is not None else []
            testing.assertTrue(any([p > u64(0) and p < u64(100) for p in seen]), "a progress between 0 and 100: {seen}")
            t.success()
        except Exception as e:
            t.failure(e)

    def __startup__():
        run = _StagingRun(t, "d-progress", DIR_EMPTY, VERIFY_EQUAL, settled, upgrade_duration=2.0, sized=True,
                          timeout=8.0)



