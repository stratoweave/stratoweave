"""MIB-backed device reads and periodic YANG subscriptions over SNMPv2c."""

import logging
import net
import std.xml as xml
import snmp.client as client
import snmp.errors as errors
import snmp.mib.meta as mibmeta
import snmp.oid as oid
import snmp.security as security
import snmp.values as values
import yang.gdata as gdata

import device as swdev
import snmp_schema
import snmp_mock
import subscriptions
import adapters.polling as polling
from device_meta_config import stratoweave_rfs__device_entry as DeviceMetaConfig
from device_schema import DeviceSchema
from adapters.adapter import DeviceAdapter, ModCap, ConfigError, NotConnectedError, SubscriptionStatus, \
    SUBSCRIPTION_POLL


# A table walk stops at this many values and reports an error.
MAX_VARBINDS = 100000


def _udp(env: ?Env) -> ?net.UDPConnectCap:
    if env is not None:
        return net.UDPConnectCap(net.UDPCap(net.NetCap(env.cap)))
    return None


actor _Read(c: client.Client, schema: snmp_schema.Schema, plan: snmp_schema.Plan, filt: ?gdata.FNode,
            done: action(?gdata.Node, ?Exception) -> None):
    """Send the GET and the table walks of plan at once, then build the tree."""
    var bindings: dict[oid.Oid, values.VarBind] = {}
    var pending = len(plan.walks) + (1 if len(plan.get_oids) > 0 else 0)
    var failed = False

    def received(batch: list[values.VarBind], error: ?Exception):
        if failed:
            return
        if error is not None:
            failed = True
            done(None, error)
            return
        # Folded subscriptions can read an OID twice, by GET and by a walk.
        for vb in batch:
            bindings[vb.oid] = vb
        pending -= 1
        if pending == 0:
            try:
                tree = schema.to_tree([bindings[o] for o in sorted(bindings.keys())], filt)
            except Exception as err:
                done(None, err)
            else:
                done(tree, None)

    def got(cl: client.Client, response: ?client.Response, error: ?errors.SnmpError):
        if error is not None:
            received([], error)
        elif response is None:
            received([], ValueError("SNMP read completed without a response"))
        else:
            received(response!.varbinds, None)

    def walked(cl: client.Client, table: ?client.Table, error: ?errors.SnmpError):
        if error is not None:
            received([], error)
        elif table is None:
            received([], ValueError("SNMP table walk completed without a table"))
        elif table!.truncated:
            received([], ValueError("SNMP table exceeded {MAX_VARBINDS} values"))
        else:
            batch: list[values.VarBind] = []
            for row in table!.rows:
                for i, cell in enumerate(row.cells):
                    if cell is not None:
                        batch.append(values.VarBind(oid.Oid(table!.columns[i].arcs + row.index), cell!))
            received(batch, None)

    def start():
        if len(plan.get_oids) > 0:
            c.get(got, plan.get_oids)
        for walk in plan.walks:
            c.get_table(walked, walk.oids, index_prefix=walk.index_prefix)
        if pending == 0:
            done(schema.to_tree([], filt), None)

    after 0: start()


actor SnmpDriver(dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, metadata: mibmeta.MibBundle,
                 modules: dict[str, ModCap], timeout: float, retries: int,
                 log_handler: logging.Handler, env: ?Env):
    schema = snmp_schema.Schema(bundled_schema.oper_src_dnode, metadata)
    udp = _udp(env)
    var c: ?client.Client = None
    var mock: ?snmp_mock.SnmpMockServer = None
    var settings: ?gdata.Node = None
    var configured = False
    var generation = 0
    var closed = False
    poller = polling.Poller()

    def get(cb: action(?gdata.Node, ?Exception) -> None, filt: ?gdata.FNode=None):
        current = c
        gen = generation
        if current is None:
            cb(None, NotConnectedError("SNMP device has no configured transport"))
            return
        def completed(tree: ?gdata.Node, error: ?Exception):
            if gen != generation:
                cb(None, NotConnectedError("SNMP device changed during read"))
            else:
                cb(tree, error)
        try:
            _Read(current!, schema, schema.plan(filt), filt, completed)
        except Exception as err:
            cb(None, err)

    def declare_subscriptions(owner_id: str, cb: action(?gdata.Node, ?Exception) -> None,
                              want: set[gdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        try:
            for f in subscriptions.fold(want).values():
                schema.plan(f)
        except Exception as err:
            cb(None, err)
            if synced is not None:
                synced(owner_id)
            return
        poller.declare_subscriptions(owner_id, cb, want, synced)

    def remove_subscriptions(owner_id: str):
        poller.remove_subscriptions(owner_id)

    def close(on_close: ?action() -> None=None):
        closed = True
        generation += 1
        poller.close()
        if c is not None:
            c!.close()
            c = None
        if mock is not None:
            mock!.close()
            mock = None
        if on_close is not None:
            on_close()

    def get_mock_server() -> ?snmp_mock.SnmpMockServer:
        return mock

    def set_dmc(dmc: DeviceMetaConfig):
        if closed:
            return
        tree = dmc.to_gdata()
        selected = gdata.FNode(children=[gdata.FNode(gdata.Id("http://stratoweave.org/yang/stratoweave-rfs", name))
                                       for name in ["address", "credentials", "mock"]])
        new_settings = gdata.filter(tree, selected)
        if configured and settings == new_settings:
            return
        configured = True
        settings = new_settings
        generation += 1
        poller.restart()
        gen = generation
        previous = c
        previous_mock = mock
        c = None
        mock = None
        if previous is not None:
            previous.close()
        if previous_mock is not None:
            previous_mock.close()
        mocked = dmc.mock.enabled or len(dmc.mock.module) > 0 or env is None
        community = dmc.credentials.password
        if community is None:
            if mocked:
                community = "public"
            else:
                return
        opts = client.Options(timeout=timeout, retries=retries, max_walk_varbinds=MAX_VARBINDS, max_queued=64,
                              check_community=True)
        candidate: ?client.Client = None
        candidate_mock: ?snmp_mock.SnmpMockServer = None
        if mocked:
            server = snmp_mock.SnmpMockServer(community=community!)
            transport = server.transport()
            if closed or gen != generation:
                server.close()
                return
            candidate_mock = server
            candidate = client.Client(None, snmp_mock.ADDRESS, security.Community(community!), log_handler,
                                      port=snmp_mock.PORT, opts=opts, transport=transport)
        elif udp is not None and len(dmc.address) > 0:
            address = list(dmc.address)[0]
            port = address.port
            candidate = client.Client(udp, address.address, security.Community(community!),
                                      log_handler, port=int(port) if port is not None else 161, opts=opts)
        if closed or gen != generation:
            if candidate is not None:
                candidate.close()
            if candidate_mock is not None:
                candidate_mock.close()
            return
        c = candidate
        mock = candidate_mock
        if c is not None:
            async dev.on_connect(modules, None, dmc.type)

    poller.attach(get)


class SnmpAdapter(DeviceAdapter):
    def __init__(self, dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, init_dmc: DeviceMetaConfig,
                 schema_registry: swdev.SchemaRegistry, log_handler, env: ?Env,
                 metadata: mibmeta.MibBundle, timeout: float=1.0, retries: int=2):
        """Read the device described by metadata, waiting timeout seconds per request attempt."""
        self._log_handler = log_handler
        self._env = env
        self._modules = {meta.name: ModCap(meta.name, ns, meta.revision)
                         for ns, meta in bundled_schema.module_inventory().items()}
        self._driver = SnmpDriver(dev, bundled_schema, metadata, self._modules, timeout, retries, log_handler, env)

    def supports_mocking(self) -> bool:
        return True

    def set_dmc(self, new_dmc: DeviceMetaConfig):
        self._driver.set_dmc(new_dmc)

    def configure(self, done, new_diff, new_conf, running_conf):
        done(ConfigError("SNMP adapters currently support reads only", new_diff, new_conf), None)

    def get_capabilities(self) -> list[str]:
        return []

    def get_modules(self) -> dict[str, ModCap]:
        return self._modules

    def subscription_method(self) -> str:
        return SUBSCRIPTION_POLL

    def subscription_status(self) -> SubscriptionStatus:
        return SubscriptionStatus(SUBSCRIPTION_POLL, emulated=True)

    def fetch_config(self, done: action(?gdata.Node, ?Exception) -> None):
        done(gdata.Container({}), None)

    def get_config(self) -> ?gdata.Node:
        return gdata.Container({})

    def get(self, cb: action(?gdata.Node, ?Exception) -> None, filt: ?gdata.FNode=None):
        self._driver.get(cb, filt)

    def rpc(self, cb: action(?gdata.Node, ?Exception) -> None, gdata_rpc: gdata.Node):
        cb(None, ConfigError("SNMP adapters do not support YANG RPCs"))

    def rpc_xml(self, cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node):
        cb(None, ConfigError("SNMP adapters do not support XML RPCs"))

    def declare_subscriptions(self, owner_id: str, cb: action(?gdata.Node, ?Exception) -> None,
                              want: set[gdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        self._driver.declare_subscriptions(owner_id, cb, want, synced)

    def remove_subscriptions(self, owner_id: str):
        self._driver.remove_subscriptions(owner_id)

    def close(self, on_close: ?action() -> None=None):
        self._driver.close(on_close)

    proc def get_mock_server(self) -> ?snmp_mock.SnmpMockServer:
        return self._driver.get_mock_server()
