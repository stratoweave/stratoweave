#
# IOS XR platform probe: replies other than the lab XRd's and XRv 9000's,
# which test_platform_lab covers.
#

import testing
import std.xml as xml
import yang
import yang.gdata as ygdata
import yang.xml as yxml

import device as swdev
import adapters.platform_iosxr as iosxr
import adapters.platform_iosxr_yang as xr_yang
from adapters.adapter import ModCap


def _show(p: ?swdev.Platform) -> str:
    if p is not None:
        return "{p.os} {p.version} {p.model} {p.serial_number}"
    return "no platform"


def _data(body: str) -> ygdata.Node:
    return yxml.from_xml(yang.compile(xr_yang.models), xml.decode("<data>{body}</data>"), loose=True)


def _version(body: str) -> ygdata.Node:
    return _data("<install xmlns=\"http://cisco.com/ns/yang/Cisco-IOS-XR-install-oper\"><version>{body}</version></install>")


def _racks(racks: list[(name: str, model: str, serial: str)]) -> ygdata.Node:
    entries = ""
    for r in racks:
        entries += "<rack><name>{r.name}</name><attributes><inv-basic-bag><model-name>{r.model}</model-name><serial-number>{r.serial}</serial-number></inv-basic-bag></attributes></rack>"
    return _data("<inventory xmlns=\"http://cisco.com/ns/yang/Cisco-IOS-XR-invmgr-oper\"><racks>{entries}</racks></inventory>")


def _test_platform_from_replies():
    rack0 = (name="0", model="NCS-5501", serial="FOC2222R0AB")
    cases: list[(label: str, version: ?ygdata.Node, inventory: ?ygdata.Node, want: str)] = [
        (label="chassis-pid-no-inventory",
         version=_version("<label>24.4.2</label><chassis-pid>8201-32FH</chassis-pid>"),
         inventory=None,
         want="ios-xr 24.4.2 8201-32FH None"),
        (label="model-from-inventory",
         version=_version("<label>24.4.2</label>"),
         inventory=_racks([rack0]),
         want="ios-xr 24.4.2 NCS-5501 FOC2222R0AB"),
        (label="chassis-pid-over-inventory-model",
         version=_version("<label>24.4.2</label><chassis-pid>8201-32FH</chassis-pid>"),
         inventory=_racks([(name="0", model="8201-32FH-O", serial="FLM2611AAAA")]),
         want="ios-xr 24.4.2 8201-32FH FLM2611AAAA"),
        (label="lowest-rack-last",
         version=_version("<label>7.11.2</label>"),
         inventory=_racks([(name="1", model="ASR-9922", serial="S1"), (name="0", model="ASR-9922", serial="S0")]),
         want="ios-xr 7.11.2 ASR-9922 S0"),
        (label="empty-inventory",
         version=_version("<label>24.4.2</label>"),
         inventory=ygdata.Container({}),
         want="ios-xr 24.4.2 None None"),
        (label="empty-chassis-pid",
         version=_version("<label>24.4.2</label><chassis-pid></chassis-pid>"),
         inventory=None,
         want="ios-xr 24.4.2 None None"),
        (label="no-version",
         version=ygdata.Container({}),
         inventory=_racks([rack0]),
         want="ios-xr None NCS-5501 FOC2222R0AB"),
    ]
    for c in cases:
        testing.assertEqual(c.want, _show(iosxr.platform(c.version, c.inventory)), c.label)


def _test_platform_without_values():
    testing.assertTrue(iosxr.platform(None, None) is None, "no replies")
    testing.assertTrue(iosxr.platform(ygdata.Container({}), ygdata.Container({})) is None, "empty replies")


def _test_probe_applies_on_its_module():
    m = iosxr.MODULE
    testing.assertTrue(iosxr.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not iosxr.PROBE.applies({"Cisco-IOS-XR-invmgr-oper": ModCap("Cisco-IOS-XR-invmgr-oper", "urn:y")}),
                       "the device lists only the inventory")
