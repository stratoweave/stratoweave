"""IOS XE exec commands over SSH, with the results as YANG data.

The adapter implements the stratoweave-iosxe-cli module only. It reads and
runs commands; it does not configure the device.

The adapter logs in once and keeps an SSH shell open, in which it types
one command at a time. A command is done when the prompt follows its
output. IOS XE closes the connection when an exec channel ends, so the
shell saves a login for each command. The adapter finds errors in the
output text.

What the IOS XE releases that we tried give for software management, over
NETCONF and over the CLI:

                       NETCONF                    CLI
  Release   Platform   files verify install ev    dir sum hash image install bootvar config  Notes
  16.8.1    C1111      -     -      -       -     yes yes -    yes   yes     yes     yes     1 2 3 4 5 9
  17.9.5a   C1111      yes   no     has     yes   yes yes yes  yes   has     yes     yes     6 7 9
  17.18.2   C8000V     -     no     yes     yes   yes yes -    -     -       -       -       8

  files    Cisco-IOS-XE-platform-software-oper, the files of each partition
  verify   Cisco-IOS-XE-verify-rpc and Cisco-IOS-XE-verify-events
  install  Cisco-IOS-XE-install-rpc and Cisco-IOS-XE-xcopy-rpc
  ev       netconf-config-change on the NETCONF stream, also for CLI changes,
           and the -events-oper modules on yang-notif-native only
  dir      dir of a file system
  sum      verify /md5 and verify /sha512
  hash     verify /md5 or /sha512 with a hash: Verified or %Error verifying
  image    verify without an algorithm: the hashes that an image holds and
           its digital signature
  install  install add, activate, commit, abort, remove and rollback
  bootvar  show bootvar: the files that ROMMON boots
  config   configure terminal in an SSH shell, and write memory

  yes      tried, and it works
  no       the device does not have it
  has      the device has it; not tried
  -        not tried

Notes:

1. The NETCONF SSH server does not start: the trustpoint has no certificate.
2. In bundle mode the device refuses install add alone. The one command
   install add file F activate commit converts it to install mode.
3. Install mode boots bootflash:packages.conf, which boot system must name.
   The conversion on 16.8.1 does not set it.
4. With prompt-level none, install refuses to run while the configuration
   has unsaved changes.
5. The SSH server offers only diffie-hellman-group14-sha1,
   diffie-hellman-group-exchange-sha1 and ssh-rsa host keys.
6. The files of a partition are recursive, without hidden entries.
   q-filesystem comes without its location keys.
7. The sha1sum of an image is the hash that the image holds, not a checksum
   of the file.
8. The device answers the verify RPC with the rpc-error unknown-namespace.
9. The CLI SSH server sends no server-sig-algs, so an RSA user key needs
   public-key-algorithm ssh-rsa.
"""

import logging
import net
import ssh
import std.xml as xml
import yang.gdata as gdata

import device as swdev
import adapters.iosxe_cli_data as xecli_data
import adapters.iosxe_cli_yang as xecli_yang
from device_meta_config import stratoweave_rfs__device_entry as DeviceMetaConfig
from device_schema import DeviceSchema
from adapters.adapter import DeviceAdapter, ModCap, ConfigError, NotConnectedError, \
    PermanentError, TransientError, SubscriptionStatus, SUBSCRIPTION_UNKNOWN, ssh_transport_config

## The file systems that a read gets when its filter does not name any.
DEFAULT_FILE_SYSTEMS = ["bootflash:"]

## Seconds that the command of a read can run. A dir of bootflash: takes less
## than a second on a C8000V.
COMMAND_TIMEOUT = 60.0

## Seconds that the command of an RPC can run. The verify RPC runs verify:
## MD5 of an 838 MB image takes 23 s on a C8000V.
RPC_TIMEOUT = 600.0

## Seconds that an install command can run. install add copies and expands
## an image, from a URL too.
INSTALL_TIMEOUT = 3600.0

## Seconds to wait for the prompt after each configuration command.
CONFIG_LINE_TIMEOUT = 30.0

## The question that install remove asks before it deletes files, on a C1111
## with 17.15.04c. It has no prompt-level none.
REMOVE_QUESTION = "Do you want to remove the above files? [y/n]"

## Seconds without a command after which the shell gets an empty line, so a
## dead connection shows and the device does not end the session. IOS XE
## ends a session after 10 idle minutes by default.
KEEPALIVE_INTERVAL = 60.0

## The commands that set up the shell after login: no paging, and lines up
## to 511 characters.
SHELL_SETUP = ["terminal length 0", "terminal width 511"]

## The start of a line in which the device rejects a configuration command.
_CONFIG_ERRORS = ["% Invalid input", "% Incomplete command", "% Ambiguous command", "% Unknown command",
                  "%Error", "% Error", "ERROR:"]

## Seconds between login attempts after a failure: the first delay, and the
## limit for the delay that doubles after each failure.
RETRY_FIRST = 1.0
RETRY_MAX = 60.0

_RFS_NS = "http://stratoweave.org/yang/stratoweave-rfs"
_FILE_SYSTEM_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789-"
_FILE_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
_DIGITS = "0123456789"
_PROMPT_START = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
_HEX = "0123456789abcdef"
# A file, a URL or a label in an install command.
_LOCATION_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._~:/@%+=,-"
_LABEL_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
_INSTALL_STATES = {"I": "inactive", "U": "activated-uncommitted", "C": "activated-committed",
                   "D": "deactivated-uncommitted"}
_MONTHS = {"Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04", "May": "05", "Jun": "06",
           "Jul": "07", "Aug": "08", "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12"}


class CommandError(PermanentError):
    """The device rejected a command, or the output was not as expected."""


def modules() -> dict[str, ModCap]:
    """Return the modules that the adapter implements."""
    return {xecli_yang.MODULE: ModCap(xecli_yang.MODULE, xecli_yang.NS)}


def check_file_system(name: str) -> None:
    """Raise ValueError if name is not a file system name such as bootflash:."""
    if len(name) < 2 or not name.endswith(":") or any([c not in _FILE_SYSTEM_CHARS for c in name[:-1]]):
        raise ValueError("invalid file system name: " + name)


def check_file(name: str) -> None:
    """Raise ValueError if name is not a plain file name.

    The name goes into an IOS XE command, so only letters, digits, dots,
    underscores and hyphens are permitted.
    """
    if name in ["", ".", ".."] or any([c not in _FILE_CHARS for c in name]):
        raise ValueError("invalid file name: " + name + ". Use only letters, digits, dots, underscores and hyphens")


def dir_command(file_system: str) -> str:
    """Return the command that lists the top directory of file_system."""
    check_file_system(file_system)
    return "dir " + file_system


def _digest_length(algorithm: str) -> int:
    return 32 if algorithm == "md5" else 128


def verify_command(file_system: str, file: str, algorithm: ?str=None, expected: ?str=None) -> str:
    """Return the verify command for a file.

    With an algorithm, the command computes the checksum of the file, and
    with an expected hash it also compares the checksum with the hash.
    Without an algorithm, the command checks an IOS XE image.
    """
    check_file_system(file_system)
    check_file(file)
    if algorithm is not None:
        if algorithm not in ["md5", "sha512"]:
            raise ValueError("unsupported checksum algorithm: " + algorithm)
        command = "verify /" + algorithm + " " + file_system + file
        if expected is not None:
            length = _digest_length(algorithm)
            if len(expected) != length or any([c not in _HEX for c in expected.lower()]):
                raise ValueError("invalid " + algorithm + " hash: " + expected + ". Use " + str(length) + " hexadecimal digits")
            command += " " + expected.lower()
        return command
    if expected is not None:
        raise ValueError("a hash needs an algorithm")
    return "verify " + file_system + file


def check_location(location: str) -> None:
    """Raise ValueError if location is not a file or a URL for an install command."""
    if ":" not in location or any([c not in _LOCATION_CHARS for c in location]):
        raise ValueError("invalid file or URL: " + location + ". Use a file system or a scheme, and only letters, digits and ._~:/@%+=,-")


def install_command(inp: xecli_data.stratoweave_iosxe_cli__install__input) -> str:
    """Return the install command of an install RPC request.

    Raise ValueError unless the request has exactly one command, with input
    that is valid.
    """
    add = inp.add
    activate = inp.activate
    remove = inp.remove
    rollback = inp.rollback
    given = [c for c in [add is not None, activate is not None, inp.commit is not None,
                         inp.abort is not None, remove is not None, rollback is not None] if c]
    if len(given) != 1:
        raise ValueError("an install request must have exactly one command")
    if add is not None:
        check_location(add.file)
        command = "install add file " + add.file
        if add.activate is not None:
            command += " activate"
            if add.commit is not None:
                command += " commit"
        elif add.commit is not None:
            raise ValueError("install add needs activate to commit")
        level = add.prompt_level
        if level is not None:
            command += " prompt-level " + level
        return command
    if activate is not None:
        command = "install activate"
        f = activate.file
        if f is not None:
            check_location(f)
            command += " file " + f
        timer = activate.auto_abort_timer
        if timer is not None:
            command += " auto-abort-timer " + str(timer)
        level = activate.prompt_level
        if level is not None:
            command += " prompt-level " + level
        return command
    if inp.commit is not None:
        return "install commit"
    if inp.abort is not None:
        return "install abort"
    if remove is not None:
        f = remove.file
        if f is not None:
            check_location(f)
            return "install remove file " + f
        return "install remove inactive"
    if rollback is not None:
        if rollback.base is not None:
            return "install rollback to base"
        if rollback.committed is not None:
            return "install rollback to committed"
        point = rollback.id
        if point is not None:
            return "install rollback to id " + str(point)
        label = rollback.label
        if label is not None:
            if label == "" or any([c not in _LABEL_CHARS for c in label]):
                raise ValueError("invalid label: " + label)
            return "install rollback to label " + label
    raise ValueError("an install request must have exactly one command")


def _digits(s: str) -> bool:
    return len(s) > 0 and all([c in _DIGITS for c in s])


def _device_error(lines: list[str]) -> ?str:
    """Return the first line where the device reports an error."""
    for line in lines:
        if line.startswith("%") or line.startswith("Line has invalid autocommand"):
            return line
    return None


class DirEntry(object):
    """A regular file in a dir listing."""
    name: str
    size: u64
    modified: str

    def __init__(self, name: str, size: u64, modified: str):
        self.name = name
        self.size = size
        self.modified = modified

    def __str__(self) -> str:
        return self.name + " " + str(self.size) + " " + self.modified


def date_and_time(month: str, day: str, year: str, clock: str, offset: str) -> str:
    """Write a dir date, e.g. Nov 7 2026 20:28:06 +00:00, in the
    yang:date-and-time format, e.g. 2026-11-07T20:28:06+00:00.

    Raise ValueError if a part is not as expected.
    """
    ok = True
    if month not in _MONTHS or not _digits(day) or len(day) > 2 or not _digits(year) or len(year) != 4:
        ok = False
    elif len(clock) != 8 or clock[2] != ":" or clock[5] != ":" or not _digits(clock[0:2] + clock[3:5] + clock[6:8]):
        ok = False
    elif len(offset) != 6 or offset[0] not in "+-" or offset[3] != ":" or not _digits(offset[1:3] + offset[4:6]):
        ok = False
    if not ok:
        raise ValueError("unexpected date: " + " ".join([month, day, year, clock, offset]))
    return year + "-" + _MONTHS[month] + "-" + day.zfill(2) + "T" + clock + offset


def _dir_line(line: str) -> ?DirEntry:
    """Read one entry line of a dir listing. Return None for an entry that is
    not a regular file.

    An entry line has the inode, the permissions, the size, the date and the
    name, e.g. 55 -rw- 1048576 Nov 7 2026 20:28:04 +00:00 sw.bin.
    """
    fields = line.split()
    if len(fields) < 9 or not _digits(fields[0]) or len(fields[1]) != 4 or not _digits(fields[2]):
        raise CommandError("unexpected dir line: " + line)
    try:
        modified = date_and_time(fields[3], fields[4], fields[5], fields[6], fields[7])
    except ValueError:
        raise CommandError("unexpected dir line: " + line)
    if not fields[1].startswith("-"):
        return None
    return DirEntry(" ".join(fields[8:]), u64(int(fields[2])), modified)


def _total_line(line: str) -> bool:
    """True for the last line of a listing, e.g. 11546681344 bytes total (9966010368 bytes free)."""
    fields = line.split()
    return len(fields) == 6 and _digits(fields[0]) and fields[1:3] == ["bytes", "total"] and fields[5] == "free)"


def parse_dir(output: str, file_system: str) -> list[DirEntry]:
    """Read the regular files from the output of dir_command(file_system).

    Raise CommandError when the device reports an error, when a listing line
    is not as expected, or when the listing has no total line at the end.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    header = "Directory of " + file_system + "/"
    files: list[DirEntry] = []
    listing = False
    for line in lines:
        if not listing:
            if line == header:
                listing = True
        elif _total_line(line):
            return files
        elif line != "" and line != "No files in directory":
            entry = _dir_line(line)
            if entry is not None:
                files.append(entry)
    if listing:
        raise CommandError("dir output of " + file_system + " ended before the total line")
    raise CommandError("dir output has no listing of " + file_system)


def parse_verify(output: str, file_system: str, file: str, algorithm: str) -> str:
    """Read the digest from the output of verify_command(file_system, file, algorithm).

    Progress dots are not a result. Raise CommandError unless the output has
    exactly one result line for this file and algorithm, with a digest of the
    correct length.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    marker = "verify /" + algorithm + " (" + file_system + file + ") = "
    digest: ?str = None
    for line in lines:
        if line.startswith(marker):
            if digest is not None:
                raise CommandError("verify output has more than one result")
            digest = _digest(line, len(marker), algorithm)
    if digest is not None:
        return digest
    raise CommandError("verify output has no result for " + file_system + file)


def _digest(line: str, start: int, algorithm: str) -> str:
    """Return the digest at start of a result line of verify."""
    value = line[start:].strip().lower()
    if len(value) != _digest_length(algorithm) or any([c not in _HEX for c in value]):
        raise CommandError("verify output has an invalid digest: " + line)
    return value


def parse_verify_hash(output: str, file_system: str, file: str, algorithm: str) -> (digest: str, verified: bool):
    """Read the result of verify_command(file_system, file, algorithm, expected).

    The device prints the checksum after Verified when it is equal to the
    expected hash. When it is not, the device prints %Error verifying and
    then the computed checksum. Raise CommandError when the output has
    neither, or when the device reports another error.
    """
    lines = [line.strip() for line in output.splitlines()]
    path = file_system + file
    verified = "Verified (" + path + ") = "
    computed = "Computed signature"
    for i in range(len(lines)):
        line = lines[i]
        if line.startswith(verified):
            return (digest=_digest(line, len(verified), algorithm), verified=True)
        if line == "%Error verifying " + path:
            for later in lines[i + 1:]:
                if later.startswith(computed) and "=" in later:
                    return (digest=_digest(later, later.find("=") + 1, algorithm), verified=False)
            raise CommandError("verify output has no computed checksum for " + path)
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    raise CommandError("verify output has no result for " + path)


def parse_verify_image(output: str, file_system: str, file: str) -> bool:
    """Read the result of verify_command(file_system, file).

    The output holds an embedded and a computed hash for each algorithm. A
    long hash continues on the next lines. Return True if each pair of hashes
    is equal and the device verified the digital signature of this file.
    Return False if not. Raise CommandError if the device cannot check the
    file, or if the output has no hashes.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    embedded: dict[str, str] = {}
    computed: dict[str, str] = {}
    signed = False
    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if line.endswith("does not support verification."):
            raise CommandError(line)
        if line == "Digital signature successfully verified in file " + file_system + file:
            signed = True
        if line.startswith("Embedded Hash") or line.startswith("Computed Hash"):
            colon = line.find(":")
            words = line[:colon].split() if colon > 0 else []
            if len(words) != 3:
                raise CommandError("unexpected verify line: " + line)
            value = line[colon + 1:].strip().lower()
            while i < len(lines) and lines[i] != "" and all([c in _HEX for c in lines[i].lower()]):
                value += lines[i].lower()
                i += 1
            if words[0] == "Embedded":
                embedded[words[2]] = value
            else:
                computed[words[2]] = value
    if len(embedded) == 0 and len(computed) == 0:
        raise CommandError("verify output has no hashes for " + file_system + file)
    if len(embedded) != len(computed):
        return False
    for algorithm, value in embedded.items():
        got = computed.get(algorithm)
        if got is None or got != value:
            return False
    return signed


def _variable(line: str, name: str) -> ?str:
    """Return the value in a line such as CONFIG_FILE variable = X, or None
    when the variable does not exist."""
    marker = name + " variable = "
    if line.startswith(marker):
        return line[len(marker):].strip()
    return None


def parse_bootvar(output: str) -> xecli_data.stratoweave_iosxe_cli__bootvar:
    """Read the boot variables from show bootvar.

    The BOOT variable lists files with a number after each, as in
    bootflash:packages.conf,1; the number is not kept. An empty BOOT variable
    gives no files. Raise CommandError when the device reports an error or
    the output has no BOOT variable.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    result = xecli_data.stratoweave_iosxe_cli__bootvar()
    found = False
    for line in lines:
        if line.startswith("BOOT variable ="):
            found = True
            for entry in line[len("BOOT variable ="):].strip().split(";"):
                f = entry.strip()
                comma = f.rfind(",")
                if comma > 0:
                    f = f[:comma]
                if f != "":
                    result.boot.append(f)
        elif line.startswith("CONFIG_FILE variable"):
            result.config_file = _variable(line, "CONFIG_FILE")
        elif line.startswith("BOOTLDR variable"):
            result.bootldr = _variable(line, "BOOTLDR")
        elif line.startswith("Configuration register is "):
            # Configuration register is 0x2142 (will be 0x2102 at next reload)
            rest = line[len("Configuration register is "):]
            words = rest.split()
            if len(words) > 0:
                result.configuration_register = words[0]
            at = rest.find("(will be ")
            if at >= 0:
                upcoming = rest[at + len("(will be "):].split()
                if len(upcoming) > 0:
                    result.next_configuration_register = upcoming[0]
    if not found:
        raise CommandError("show bootvar output has no BOOT variable")
    return result


def parse_install_summary(output: str) -> xecli_data.stratoweave_iosxe_cli__install_summary:
    """Read the packages and the auto-abort timer from show install summary.

    A location starts with a line such as [ R0 ] Installed Package(s)
    Information. Its packages are the rows between the Type St header and
    the next dashed line. A device in bundle mode prints nothing. Raise
    CommandError when the device reports an error or a line is not as
    expected.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    result = xecli_data.stratoweave_iosxe_cli__install_summary()
    location: ?xecli_data.stratoweave_iosxe_cli__install_summary__location_entry = None
    in_rows = False
    for line in lines:
        if line.startswith("[") and "]" in line:
            location = result.location.create(line[1:line.find("]")].strip())
            in_rows = False
        elif line.startswith("Type") and "Filename/Version" in line:
            in_rows = True
        elif line.startswith("---"):
            # A dashed line follows the header too, before any row.
            loc = location
            if in_rows and loc is not None:
                if len(loc.package) > 0:
                    in_rows = False
        elif line.startswith("Auto abort timer:"):
            result.auto_abort_timer = line[len("Auto abort timer:"):].strip()
            in_rows = False
        elif in_rows and line != "":
            fields = line.split()
            loc = location
            if loc is not None:
                if len(fields) != 3 or fields[1] not in _INSTALL_STATES:
                    raise CommandError("unexpected show install summary line: " + line)
                loc.package.create(fields[2], type=fields[0], state=_INSTALL_STATES[fields[1]])
    if len(result.location) == 0 and any([line != "" for line in lines]):
        raise CommandError("show install summary output has no location")
    return result


def parse_version(output: str) -> xecli_data.stratoweave_iosxe_cli__version:
    """Read the release and the hardware from the output of show version.

    Raise CommandError when the device reports an error or the output has no
    IOS XE release. The model, the serial number and the system image are
    optional.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    release = "Cisco IOS XE Software, Version "
    serial = "Processor board ID "
    image = "System image file is \""
    v = xecli_data.stratoweave_iosxe_cli__version()
    for line in lines:
        if line.startswith(release):
            v.version = line[len(release):].split(",")[0].strip()
        elif line.startswith("cisco ") and " processor " in line:
            v.model = line.split()[1]
        elif line.startswith(serial):
            v.serial_number = line[len(serial):]
        elif line.startswith(image) and line.endswith("\""):
            v.system_image = line[len(image):-1]
    if v.version is None:
        raise CommandError("show version output has no IOS XE release")
    return v


def file_systems_selected(top: gdata.FNode) -> list[str]:
    """Return the file systems that a filter of file-systems selects.

    A file-system entry with a name gives that name. A filter without
    children, or a file-system entry without a name, gives
    DEFAULT_FILE_SYSTEMS.
    """
    file_system = gdata.Id(xecli_yang.NS, "file-system")
    key = gdata.Id(xecli_yang.NS, "name")
    names: list[str] = []
    if len(top.children) == 0:
        names.extend(DEFAULT_FILE_SYSTEMS)
    for fs in top.children:
        named = False
        if fs.name == file_system:
            for c in fs.children:
                value = c.value_match
                if c.name == key and isinstance(value, str):
                    names.append(value)
                    named = True
        if not named:
            names.extend(DEFAULT_FILE_SYSTEMS)
    selected: list[str] = []
    for name in names:
        if name not in selected:
            selected.append(name)
    return selected


class Read(object):
    """An exec command whose output becomes operational data.

    A subclass sets command and implements parse.
    """
    command: str

    ## Add the data in the output of command to r. Raise CommandError when
    ## the output is not as expected.
    parse: proc(r: xecli_data.root, output: str) -> None


class DirRead(Read):
    """Read the files of a file system with dir."""
    file_system: str

    def __init__(self, file_system: str):
        self.command = dir_command(file_system)
        self.file_system = file_system

    def parse(self, r: xecli_data.root, output: str) -> None:
        fs = r.file_systems.file_system.create(self.file_system)
        for e in parse_dir(output, self.file_system):
            fs.file.create(e.name, size=e.size, modified=e.modified)


class VersionRead(Read):
    """Read the release and the hardware with show version."""
    def __init__(self):
        self.command = "show version"

    def parse(self, r: xecli_data.root, output: str) -> None:
        r.version = parse_version(output)


class BootvarRead(Read):
    """Read the boot variables with show bootvar."""
    def __init__(self):
        self.command = "show bootvar"

    def parse(self, r: xecli_data.root, output: str) -> None:
        r.bootvar = parse_bootvar(output)


class InstallRead(Read):
    """Read the installed packages with show install summary."""
    def __init__(self):
        self.command = "show install summary"

    def parse(self, r: xecli_data.root, output: str) -> None:
        r.install_summary = parse_install_summary(output)


def _node_reads(top: gdata.FNode) -> list[Read]:
    """Return the reads for one top-level node of a filter. A node of
    another module gives no reads."""
    if top.name == gdata.Id(xecli_yang.NS, "file-systems"):
        return [DirRead(name) for name in file_systems_selected(top)]
    if top.name == gdata.Id(xecli_yang.NS, "version"):
        return [VersionRead()]
    if top.name == gdata.Id(xecli_yang.NS, "install-summary"):
        return [InstallRead()]
    if top.name == gdata.Id(xecli_yang.NS, "bootvar"):
        return [BootvarRead()]
    return []


def reads(filt: ?gdata.FNode) -> list[Read]:
    """Return the reads that a get with filt needs.

    Each top-level node that filt selects gives its own reads. A get without
    filt reads all top-level nodes of the module. Raise ValueError when filt
    names a file system that is not valid.
    """
    tops: list[gdata.FNode] = []
    if filt is not None:
        tops = filt.children if filt.name is None else [filt]
    else:
        tops = [gdata.FNode(gdata.Id(n.namespace, n.name)) for n in xecli_data.SRC_DNODE.children]
    result: list[Read] = []
    for top in tops:
        for read in _node_reads(top):
            if all([r.command != read.command for r in result]):
                result.append(read)
    return result


class Call(object):
    """An exec command that runs an RPC of the module. The configure RPC is
    a dialog in configure terminal, not an exec command: see
    configure_lines.

    A subclass sets command and implements reply.
    """
    command: str

    ## Return the RPC output in the output of command. Raise CommandError
    ## when the output is not as expected.
    reply: proc(output: str) -> gdata.Node

    def ended(self, output: ?str, err: Exception) -> gdata.Node:
        """Return the RPC output when the session ended with err, after
        output. The session of a command fails when it ends early."""
        raise err

    def timeout(self, default: float) -> float:
        """Return the seconds that the command can run."""
        return default

    def answers(self) -> list[(question: str, answer: str)]:
        """Return the questions that command asks, with their answers."""
        return []


class VerifyCall(Call):
    """Run the verify RPC."""
    file_system: str
    file: str
    algorithm: ?str
    expected: ?str

    def __init__(self, inp: xecli_data.stratoweave_iosxe_cli__verify__input):
        self.command = verify_command(inp.file_system, inp.file, inp.algorithm, inp.hash)
        self.file_system = inp.file_system
        self.file = inp.file
        self.algorithm = inp.algorithm
        self.expected = inp.hash

    def reply(self, output: str) -> gdata.Node:
        algorithm = self.algorithm
        if algorithm is not None:
            if self.expected is not None:
                r = parse_verify_hash(output, self.file_system, self.file, algorithm)
                return xecli_data.stratoweave_iosxe_cli__verify__output(digest=r.digest, verified=r.verified).to_gdata()
            digest = parse_verify(output, self.file_system, self.file, algorithm)
            return xecli_data.stratoweave_iosxe_cli__verify__output(digest=digest).to_gdata()
        verified = parse_verify_image(output, self.file_system, self.file)
        return xecli_data.stratoweave_iosxe_cli__verify__output(verified=verified).to_gdata()


def check_install_output(output: str) -> None:
    """Raise CommandError when the output of an install command reports an
    error or a failure.

    A failed install command prints the reason on an ERROR line before its
    FAILED line. The error has the reason when the output has one.
    """
    lines = [line.strip() for line in output.splitlines()]
    err = _device_error(lines)
    if err is not None:
        raise CommandError(err)
    reason: ?str = None
    for line in lines:
        if line.startswith("ERROR:") and reason is None:
            reason = line
        if line.startswith("FAILED:"):
            raise CommandError(reason if reason is not None else line)


def check_config_line(line: str) -> None:
    """Raise ValueError if line cannot be typed as one configuration command.

    A control character would end the command early or type another one, and
    ? asks the device for help instead of running the command.
    """
    if line.strip() == "" or any([c == "?" or ord(c) < 32 or ord(c) == 127 for c in line]):
        raise ValueError("invalid configuration command: " + line.replace("\n", "\\n").replace("\r", "\\r"))


def config_error(output: str) -> ?str:
    """Return the line in output where the device rejects a configuration
    command, or None."""
    for line in output.splitlines():
        text = line.strip()
        if any([text.startswith(e) for e in _CONFIG_ERRORS]):
            return text
    return None


def looks_like_prompt(line: str) -> bool:
    """Return True if line looks like an IOS XE prompt: a host name that
    starts with a letter or a digit, maybe a mode in parentheses, then # or
    >, without spaces."""
    if len(line) < 2 or len(line) > 80 or " " in line or "\t" in line:
        return False
    return line[0] in _PROMPT_START and (line.endswith("#") or line.endswith(">"))


def last_line(text: str) -> str:
    """Return the last line of text, without the spaces around it."""
    return text[text.rfind("\n") + 1:].strip()


def command_output(text: str, prompt: str) -> ?str:
    """Return the output of a command typed into a shell, or None while the
    command runs. text is what the device printed since the command was
    typed: the echo of the command, the output, then prompt on a line of its
    own."""
    newline = text.rfind("\n")
    if newline < 0 or text[newline + 1:].strip() != prompt:
        return None
    first = text.find("\n")
    return text[first + 1:newline] if first < newline else ""


class ConfigDialog(object):
    """Type configuration commands into an IOS XE shell, one at a time.

    start gives what to type at the exec prompt: configure terminal.
    received takes what the device prints and returns what to type next. A
    command is done when the echo of the command has ended and the last line
    is a prompt, which ends with #. The dialog types each line, then end. It
    types end after the first line that the device rejects, and keeps the
    error. prompt is the last prompt that the device printed.
    """
    lines: list[str]
    sent: int
    step: int
    pending: str
    transcript: str
    prompt: str
    error: ?str

    def __init__(self, lines: list[str]):
        self.lines = lines
        self.sent = 0
        # 0: not started, 1: configure terminal typed, 2: a line typed,
        # 3: end typed, 4: done.
        self.step = 0
        self.pending = ""
        self.transcript = ""
        self.prompt = ""
        self.error = None

    def finished(self) -> bool:
        return self.step == 4

    def current(self) -> str:
        """Return what the dialog typed last."""
        if self.step == 1:
            return "configure terminal"
        if self.step == 2:
            return self.lines[self.sent - 1]
        return "end"

    mut def start(self) -> list[str]:
        self.step = 1
        return ["configure terminal\r"]

    mut def received(self, text: str) -> list[str]:
        self.transcript += text
        self.pending += text
        newline = self.pending.rfind("\n")
        if self.step == 0 or newline < 0:
            return []
        prompt = self.pending[newline + 1:].strip()
        if not prompt.endswith("#"):
            return []
        first = self.pending.find("\n")
        output = self.pending[first + 1:newline] if first < newline else ""
        self.pending = ""
        self.prompt = prompt
        if self.step == 1 and "(config" not in prompt:
            self.error = "configure terminal: " + (output.strip() if output.strip() != "" else "no configuration prompt")
            self.step = 4
            return []
        if self.step == 2:
            err = config_error(output)
            if err is not None:
                self.error = self.lines[self.sent - 1] + ": " + err
                self.step = 3
                return ["end\r"]
        if self.step == 1 or self.step == 2:
            if self.sent < len(self.lines):
                line = self.lines[self.sent]
                self.sent += 1
                self.step = 2
                return [line + "\r"]
            self.step = 3
            return ["end\r"]
        self.step = 4
        return []


def install_reloads(output: str) -> bool:
    """Return True if the output of an install command says that the device
    reloads now."""
    return any([line.strip().startswith("Install will reload the system") for line in output.splitlines()])


class InstallCall(Call):
    """Run the install RPC."""
    reloads: bool

    def __init__(self, inp: xecli_data.stratoweave_iosxe_cli__install__input):
        self.command = install_command(inp)
        add = inp.add
        self.reloads = inp.activate is not None or inp.rollback is not None or (add is not None and add.activate is not None)

    def reply(self, output: str) -> gdata.Node:
        check_install_output(output)
        reloading = self.reloads and install_reloads(output)
        return xecli_data.stratoweave_iosxe_cli__install__output(reloading=reloading).to_gdata()

    def ended(self, output: ?str, err: Exception) -> gdata.Node:
        """A command that activates software reloads the device. When the
        session ends early and the output reports no failure, the reload has
        begun."""
        if self.reloads:
            if output is not None:
                check_install_output(output)
                return xecli_data.stratoweave_iosxe_cli__install__output(reloading=True).to_gdata()
        raise err

    def timeout(self, default: float) -> float:
        return INSTALL_TIMEOUT if INSTALL_TIMEOUT > default else default

    def answers(self) -> list[(question: str, answer: str)]:
        """install remove asks before it deletes files; the RPC means yes."""
        if self.command.startswith("install remove"):
            return [(question=REMOVE_QUESTION, answer="y")]
        return []


class WriteMemoryCall(Call):
    """Run the write-memory RPC."""
    def __init__(self):
        self.command = "write memory"

    def reply(self, output: str) -> gdata.Node:
        lines = [line.strip() for line in output.splitlines()]
        err = _device_error(lines)
        if err is not None:
            raise CommandError(err)
        if "[OK]" not in lines:
            raise CommandError("write memory output has no [OK]")
        return gdata.Container({})


def _rpc_of(request: gdata.Node) -> (rpc_id: gdata.Id, body: gdata.Node):
    """Return the RPC of a request and its input."""
    items = list(request.children.items())
    if len(items) != 1:
        raise ValueError("an RPC request must have exactly one child")
    rpc_id, body = items[0]
    return (rpc_id=rpc_id, body=body)


def configure_lines(request: gdata.Node) -> ?list[str]:
    """Return the lines of a configure RPC request, or None for another RPC.
    Raise ValueError when there is no line, or a line is not one
    configuration command."""
    r = _rpc_of(request)
    if r.rpc_id != gdata.Id(xecli_yang.NS, "configure"):
        return None
    lines = list(xecli_data.stratoweave_iosxe_cli__configure__input.from_gdata(r.body).line)
    if len(lines) == 0:
        raise ValueError("configure needs at least one line")
    for line in lines:
        check_config_line(line)
    return lines


def rpc_call(request: gdata.Node) -> Call:
    """Return the call for the request of an RPC that runs an exec command.
    Raise ValueError for an RPC that the adapter does not run that way, or
    for input that is not valid."""
    r = _rpc_of(request)
    rpc_id = r.rpc_id
    body = r.body
    if rpc_id == gdata.Id(xecli_yang.NS, "verify"):
        return VerifyCall(xecli_data.stratoweave_iosxe_cli__verify__input.from_gdata(body))
    if rpc_id == gdata.Id(xecli_yang.NS, "install"):
        return InstallCall(xecli_data.stratoweave_iosxe_cli__install__input.from_gdata(body))
    if rpc_id == gdata.Id(xecli_yang.NS, "write-memory"):
        return WriteMemoryCall()
    raise ValueError("RPC " + str(rpc_id) + " is not supported by the IOS XE CLI adapter")


def _tcp(env: ?Env) -> ?net.TCPConnectCap:
    if env is not None:
        return net.TCPConnectCap(net.TCPCap(net.NetCap(env.cap)))
    return None


def _client(cap: net.TCPConnectCap, dmc: DeviceMetaConfig,
            on_connect: action(ssh.Client, ?Exception) -> None,
            on_close: action(ssh.Client, str) -> None,
            on_hostkey: action(ssh.Client, str, ssh.HostKeyInfo) -> None) -> ssh.Client:
    """Return an SSH client that logs in to the first address of the device
    with its credentials and SSH settings. Raise NotConnectedError when the
    device has no address."""
    addresses = list(dmc.address)
    if len(addresses) == 0:
        raise NotConnectedError("the device has no address")
    address = addresses[0]
    port = address.port
    keys: list[ssh.PrivateKey] = []
    for key in dmc.credentials.key:
        material = key.private_key
        if material is not None:
            keys.append(ssh.PrivateKey(material.encode()))
    return ssh.Client(cap, address.address, dmc.credentials.username,
                      on_connect, on_close, on_hostkey,
                      password=dmc.credentials.password,
                      private_keys=keys if len(keys) > 0 else None,
                      port=u16(port) if port is not None else u16(22),
                      transport=ssh_transport_config(dmc.ssh))


def _job(command: str, lines: list[str], timeout: float, done: action(?str, ?Exception) -> None,
         answers: list[(question: str, answer: str)]=[]) -> (command: str, lines: list[str], timeout: float, done: action(?str, ?Exception) -> None, answers: list[(question: str, answer: str)]):
    """Return a job for the shell: a command, or configuration lines when
    lines is not empty. done gets what the device printed. When the output
    of the command stops at a question in answers, the job types its
    answer."""
    return (command=command, lines=lines, timeout=timeout, done=done, answers=answers)


def _after_echo(text: str) -> str:
    """Return what a shell printed after the echo of the typed command."""
    first = text.find("\n")
    return text[first + 1:] if first >= 0 else ""


actor CliSession(cap: ?net.TCPConnectCap, dmc: DeviceMetaConfig, mock: ?CliMock, login_timeout: float,
                 on_ready: action() -> None, on_end: action(Exception) -> None):
    """One login to an IOS XE device with a shell that runs one command at a
    time.

    The session logs in over SSH, or types into mock when it has one, and
    waits for the first prompt. It types SHELL_SETUP and then calls
    on_ready. A command is done when the prompt follows its output.
    configure types lines with a ConfigDialog. After KEEPALIVE_INTERVAL
    without a command, the session types an empty line.

    The session ends when the connection closes, or when the login or a
    command does not end within its time, because the state of the shell is
    then unknown. It fails the command that runs, with the output so far
    when the connection closed, and the commands in the queue. Then it calls
    on_end. close ends the session without on_end.
    """
    var client: ?ssh.Client = None
    var channel: ?ssh.Channel = None
    # The exec prompt, such as Router#.
    var prompt = ""
    var started = False
    var ended = False
    var setup_left = len(SHELL_SETUP)
    # What the device printed for the job that runs.
    var text = ""
    # The length of text when the job last typed an answer.
    var answered = 0
    # Received bytes that are not complete UTF-8 yet.
    var raw = b""
    var queue: list[(command: str, lines: list[str], timeout: float, done: action(?str, ?Exception) -> None, answers: list[(question: str, answer: str)])] = []
    var job: ?(command: str, lines: list[str], timeout: float, done: action(?str, ?Exception) -> None, answers: list[(question: str, answer: str)]) = None
    var dialog: ?ConfigDialog = None
    # Bumped when a job starts, types or ends, so an old timer does nothing.
    var serial = 0

    def run(command: str, timeout: float, done: action(?str, ?Exception) -> None,
            answers: list[(question: str, answer: str)]=[]) -> None:
        """Run command and give done its output. When the output stops at a
        question in answers, type its answer."""
        _add(_job(command, [], timeout, done, answers))

    def configure(lines: list[str], done: action(?str, ?Exception) -> None) -> None:
        """Type lines in configure terminal and give done what the device
        printed."""
        _add(_job("configure terminal", lines, CONFIG_LINE_TIMEOUT, done))

    def close() -> None:
        _end(NotConnectedError("the SSH session is closed"), False, False)

    def _add(j: (command: str, lines: list[str], timeout: float, done: action(?str, ?Exception) -> None, answers: list[(question: str, answer: str)])):
        if ended:
            j.done(None, NotConnectedError("the SSH session has ended"))
            return
        queue.append(j)
        _next()

    def _next():
        if ended or not started or job is not None or len(queue) == 0:
            return
        j = queue[0]
        queue = queue[1:]
        job = j
        text = ""
        answered = 0
        if len(j.lines) > 0:
            d = ConfigDialog(j.lines)
            dialog = d
            _type(d.start())
        else:
            dialog = None
            _type([j.command + "\r"])
        _watch(j.timeout)

    def _watch(timeout: float):
        serial += 1
        at = serial
        after timeout: _stalled(at, timeout)

    def _stalled(at: int, timeout: float):
        if ended or at != serial:
            return
        what = "login"
        j = job
        if j is not None:
            what = j.command
            d = dialog
            if d is not None:
                what = d.current()
        _end(TransientError("no prompt after " + what + " within " + str(int(timeout)) + " s"), True, False)

    def _finish_job(output: str, err: ?Exception):
        j = job
        job = None
        dialog = None
        text = ""
        serial += 1
        if j is not None:
            j.done(output, err)
        if len(queue) > 0:
            _next()
        elif mock is None:
            at = serial
            after KEEPALIVE_INTERVAL: _keepalive(at)

    def _keepalive(at: int):
        if not ended and at == serial and job is None and len(queue) == 0:
            _add(_job("", [], login_timeout, _kept_alive))

    def _kept_alive(output: ?str, err: ?Exception):
        pass

    def _set_up(output: ?str, err: ?Exception):
        if err is None:
            setup_left -= 1
            if setup_left == 0:
                on_ready()

    def _end(err: Exception, notify: bool, with_output: bool):
        if ended:
            return
        ended = True
        serial += 1
        j = job
        job = None
        waiting = queue
        queue = []
        if j is not None:
            output: ?str = None
            if with_output:
                d = dialog
                if d is not None:
                    output = d.transcript
                else:
                    output = _after_echo(text)
            j.done(output, err)
        for w in waiting:
            w.done(None, NotConnectedError(swdev.error_text(err)))
        c = client
        client = None
        channel = None
        if c is not None:
            c.close()
        if notify:
            on_end(err)

    def _on_text(chunk: str):
        if ended:
            return
        if not started:
            text += chunk
            p = last_line(text)
            if looks_like_prompt(p):
                if p.endswith(">"):
                    _end(PermanentError("the user gets no privileged prompt, only " + p), True, False)
                    return
                prompt = p
                started = True
                text = ""
                serial += 1
                queue = [_job(c, [], login_timeout, _set_up) for c in SHELL_SETUP] + queue
                _next()
            return
        # Output between commands, such as a log message, is dropped.
        j = job
        if j is not None:
            d = dialog
            if d is not None:
                typed = d.received(chunk)
                if d.finished():
                    p = d.prompt
                    if looks_like_prompt(p) and p.endswith("#") and "(" not in p:
                        # A hostname command changes the prompt.
                        prompt = p
                    err = d.error
                    _finish_job(d.transcript, CommandError(err) if err is not None else None)
                elif len(typed) > 0:
                    _type(typed)
                    _watch(j.timeout)
            else:
                text += chunk
                out = command_output(text, prompt)
                if out is not None:
                    _finish_job(out, None)
                else:
                    _answer(j.answers)

    def _answer(answers: list[(question: str, answer: str)]):
        """Type the answer to a question that ends the output so far."""
        tail = last_line(text)
        for a in answers:
            if tail.endswith(a.question) and text.rfind(a.question) >= answered:
                answered = len(text)
                _type([a.answer + "\r"])
                return

    def _type(texts: list[str]):
        m = mock
        if m is not None:
            replies = ""
            for t in texts:
                replies += m.type_text(t.rstrip())
            after 0: _on_text(replies)
            return
        ch = channel
        if ch is not None:
            for t in texts:
                ch.write(t.encode())

    def _decode():
        """Pass on the complete UTF-8 in raw. A character can be split
        between two reads."""
        n = 0
        while n < 4 and n < len(raw):
            try:
                t = raw[:len(raw) - n].decode()
            except Exception:
                n += 1
            else:
                raw = raw[len(raw) - n:]
                _on_text(t)
                return
        if len(raw) > 3:
            _end(CommandError("the SSH shell output is not UTF-8"), True, False)

    def _on_stdout(ch: ssh.Channel, data: ?bytes):
        if data is not None and not ended:
            raw += data
            _decode()

    def _on_stderr(ch: ssh.Channel, data: ?bytes):
        pass

    def _on_exit(ch: ssh.Channel, code: int, signal: ?str):
        pass

    def _on_channel_close(ch: ssh.Channel, reason: str):
        _end(TransientError("SSH shell closed: " + reason), True, True)

    def _on_open(ch: ssh.Channel, err: ?str):
        if err is not None:
            _end(TransientError("SSH shell failed: " + err), True, False)
            return
        # A wide terminal keeps the device from scrolling long commands.
        ch.request_shell(cols=500)

    def _on_hostkey(c: ssh.Client, state: str, info: ssh.HostKeyInfo):
        # The NETCONF adapter does not check host keys either.
        c.accept_hostkey()

    def _on_connect(c: ssh.Client, err: ?Exception):
        if err is not None:
            _end(NotConnectedError("SSH login failed: " + swdev.error_text(err)), True, False)
            return
        channel = ssh.Channel(c, _on_open, _on_stdout, _on_stderr, _on_exit, _on_channel_close)

    def _on_close(c: ssh.Client, reason: str):
        _end(TransientError("SSH connection closed: " + reason), True, True)

    def _start():
        _watch(login_timeout)
        m = mock
        if m is not None:
            banner = m.login()
            after 0: _on_text(banner)
            return
        k = cap
        if k is not None:
            try:
                client = _client(k, dmc, _on_connect, _on_close, _on_hostkey)
            except Exception as e:
                _end(e, True, False)
        else:
            _end(NotConnectedError("the IOS XE CLI adapter cannot open network connections"), True, False)

    _start()


actor CliMock():
    """A device for the IOS XE CLI adapter in mock mode.

    type_text answers a line typed into the shell as IOS XE does: the echo,
    the output, then the prompt. A command gets the output that set_reply
    gave it, or the error of IOS XE for a command that it does not know.
    The terminal commands of the session are accepted. In configure
    terminal, a line is accepted and kept unless set_reply gave it what the
    device prints, as for a line that the device rejects.
    """
    var replies: dict[str, str] = {}
    # The answer to the question of a command, and what follows it.
    var answer_of: dict[str, str] = {}
    var after_answer: dict[str, str] = {}
    # The command whose question waits for a line.
    var asking: ?str = None
    var commands: list[str] = []
    var configured: list[str] = []
    var config_mode = False

    def set_reply(command: str, output: str) -> None:
        replies[command] = output

    def set_question(command: str, output: str, answer: str, rest: str) -> None:
        """Make command print output, which ends with a question, and wait
        for a line. The line answer gets rest and the prompt; another line
        ends the command."""
        replies[command] = output
        answer_of[command] = answer
        after_answer[command] = rest

    def get_commands() -> list[str]:
        """Return the commands typed at the exec prompt, without the terminal
        commands and configure terminal."""
        return commands

    def get_configured() -> list[str]:
        return configured

    def login() -> str:
        """Return what the device prints when a shell opens."""
        config_mode = False
        return "\r\n\r\nRouter#"

    def type_text(text: str) -> str:
        c = asking
        if c is not None:
            asking = None
            want = answer_of.get(c)
            rest = after_answer.get(c)
            if want is not None and rest is not None and text == want:
                return text + "\r\n" + rest + "\r\nRouter#"
            return text + "\r\nAborted.\r\nRouter#"
        if config_mode:
            if text == "end":
                config_mode = False
                return "end\r\nRouter#"
            if text == "":
                return "\r\nRouter(config)#"
            reply = replies.get(text)
            if reply is not None:
                return reply
            configured.append(text)
            return text + "\r\nRouter(config)#"
        if text == "":
            return "\r\nRouter#"
        if text == "configure terminal":
            config_mode = True
            return "configure terminal\r\nEnter configuration commands, one per line.  End with CNTL/Z.\r\nRouter(config)#"
        if text.startswith("terminal "):
            return text + "\r\nRouter#"
        commands.append(text)
        r = replies.get(text)
        if r is not None and text in answer_of:
            asking = text
            return text + "\r\n" + r
        output = (" " * (len(text) + 7)) + "^\r\n% Invalid input detected at '^' marker.\r\n"
        if r is not None:
            output = r
        return text + "\r\n" + output + ("" if output.endswith("\n") else "\r\n") + "Router#"


def mock_mode(dmc: DeviceMetaConfig, env: ?Env) -> bool:
    """Return True if the adapter runs against a CliMock: without an
    environment, or for a device in mock mode."""
    return env is None or dmc.mock.enabled or len(dmc.mock.module) > 0


actor IosXeCliDriver(dev: swdev.DeviceMgr, log_handler: logging.Handler, env: ?Env,
                     command_timeout: float, rpc_timeout: float, given_mock: ?CliMock):
    """Run the commands of one device and turn their output into YANG data.

    A change of the address, the credentials or the SSH settings starts a
    new CliSession. When its shell is ready, the driver tells DeviceMgr that
    the device is connected. When the session ends or the login fails, the
    driver tells DeviceMgr that the device is not connected and logs in
    again later. The driver reports its device type, so it can run beside
    the adapter of another device type. In mock mode, the session types into
    a CliMock: given_mock, or a new one.
    """
    _log = logging.Logger(log_handler)
    tcp = _tcp(env)
    var dmc: ?DeviceMetaConfig = None
    var settings: ?gdata.Node = None
    var configured = False
    var generation = 0
    var closed = False
    var mock: ?CliMock = None
    var session: ?CliSession = None
    var ready = False

    def get_mock() -> ?CliMock:
        return mock

    def _session(command: str, timeout: float, done: action(?str, ?Exception) -> None):
        s = session
        if s is not None and ready:
            s.run(command, timeout, done)
        else:
            done(None, NotConnectedError("the IOS XE CLI adapter has no SSH session"))

    def _start_session(gen: int, delay: float):
        if closed or gen != generation:
            return
        d = dmc
        if d is not None:
            session = CliSession(tcp, d, mock, command_timeout,
                                 lambda: _session_ready(gen),
                                 lambda err: _session_ended(gen, delay, err))

    def _session_ready(gen: int):
        if closed or gen != generation:
            return
        ready = True
        d = dmc
        _log.info("IOS XE CLI: SSH session ready")
        async dev.on_connect(modules(), None, d.type if d is not None else None)

    def _session_ended(gen: int, delay: float, err: Exception):
        if closed or gen != generation:
            return
        # A session that was ready logs in again soon; a failed login waits
        # longer each time.
        wait = RETRY_FIRST if ready else delay
        next_delay = wait * 2.0
        if next_delay > RETRY_MAX:
            next_delay = RETRY_MAX
        ready = False
        session = None
        d = dmc
        _log.warning("IOS XE CLI: SSH session ended", {"error": err, "retry_in": wait})
        dev.on_disconnect(d.type if d is not None else None)
        after now wait: _start_session(gen, next_delay)

    def _restart():
        generation += 1
        ready = False
        s = session
        session = None
        if s is not None:
            s.close()
        _start_session(generation, RETRY_FIRST)

    def set_dmc(new_dmc: DeviceMetaConfig):
        if closed:
            return
        dmc = new_dmc
        if mock_mode(new_dmc, env):
            if mock is None:
                mock = given_mock if given_mock is not None else CliMock()
                _restart()
            return
        if mock is not None:
            mock = None
            configured = False
        selected = gdata.FNode(children=[gdata.FNode(gdata.Id(_RFS_NS, name))
                                       for name in ["address", "credentials", "ssh"]])
        new_settings = gdata.filter(new_dmc.to_gdata(), selected)
        if configured and settings == new_settings:
            return
        configured = True
        settings = new_settings
        if len(new_dmc.address) > 0:
            _restart()

    def _read(rs: list[Read], i: int, r: xecli_data.root, filt: ?gdata.FNode,
              cb: action(?gdata.Node, ?Exception) -> None):
        """Run the reads from rs[i] on, one after the other, and add their data to r."""
        if i == len(rs):
            try:
                tree = gdata.filter(r.to_gdata(), filt)
            except Exception as e:
                cb(None, e)
            else:
                cb(tree, None)
            return
        read = rs[i]
        def received(output: ?str, err: ?Exception):
            if err is not None:
                cb(None, err)
                return
            try:
                read.parse(r, output if output is not None else "")
            except Exception as e:
                cb(None, e)
            else:
                _read(rs, i + 1, r, filt, cb)
        _session(read.command, command_timeout, received)

    def get(cb: action(?gdata.Node, ?Exception) -> None, filt: ?gdata.FNode=None):
        try:
            rs = reads(filt)
        except Exception as e:
            cb(None, e)
        else:
            if len(rs) > 0:
                _read(rs, 0, xecli_data.root(), filt, cb)
            else:
                cb(gdata.Container({}), None)

    def _call(cb: action(?gdata.Node, ?Exception) -> None, c: Call):
        def received(output: ?str, err: ?Exception):
            _log.debug("IOS XE CLI: RPC command ended", {"command": c.command, "output": output, "error": err})
            try:
                reply = c.ended(output, err) if err is not None else c.reply(output if output is not None else "")
            except Exception as e:
                cb(None, e)
            else:
                cb(reply, None)
        s = session
        if s is not None and ready:
            s.run(c.command, c.timeout(rpc_timeout), received, c.answers())
        else:
            received(None, NotConnectedError("the IOS XE CLI adapter has no SSH session"))

    def _configure(cb: action(?gdata.Node, ?Exception) -> None, lines: list[str]):
        def received(output: ?str, err: ?Exception):
            _log.debug("IOS XE CLI: configure ended", {"lines": lines, "output": output, "error": err})
            if err is not None:
                cb(None, err)
            else:
                cb(gdata.Container({}), None)
        s = session
        if s is not None and ready:
            s.configure(lines, received)
        else:
            received(None, NotConnectedError("the IOS XE CLI adapter has no SSH session"))

    def _exec(cb: action(?gdata.Node, ?Exception) -> None, request: gdata.Node):
        try:
            c = rpc_call(request)
        except Exception as e:
            cb(None, e)
        else:
            _call(cb, c)

    def rpc(cb: action(?gdata.Node, ?Exception) -> None, request: gdata.Node):
        try:
            lines = configure_lines(request)
        except Exception as e:
            cb(None, e)
        else:
            if lines is not None:
                _configure(cb, lines)
            else:
                _exec(cb, request)

    def close(on_close: ?action() -> None=None):
        closed = True
        generation += 1
        s = session
        session = None
        if s is not None:
            s.close()
        if on_close is not None:
            on_close()


class IosXeCliAdapter(DeviceAdapter):
    """Device adapter for the IOS XE CLI over SSH.

    The device address and port are those of the SSH server, port 22 by
    default. command_timeout and rpc_timeout are in seconds. In mock mode,
    the adapter runs against mock, or a new CliMock.
    """
    def __init__(self, dev: swdev.DeviceMgr, bundled_schema: DeviceSchema, init_dmc: DeviceMetaConfig,
                 schema_registry: swdev.SchemaRegistry, log_handler, env: ?Env,
                 command_timeout: float=COMMAND_TIMEOUT, rpc_timeout: float=RPC_TIMEOUT, mock: ?CliMock=None):
        self._log_handler = log_handler
        self._env = env
        self._modules = modules()
        self._driver = IosXeCliDriver(dev, log_handler, env, command_timeout, rpc_timeout, mock)

    def set_dmc(self, new_dmc: DeviceMetaConfig):
        self._driver.set_dmc(new_dmc)

    def supports_mocking(self) -> bool:
        return True

    proc def get_mock(self) -> ?CliMock:
        """Return the CliMock that the adapter runs against in mock mode."""
        return self._driver.get_mock()

    def configure(self, done, new_diff, new_conf, running_conf):
        done(ConfigError("the IOS XE CLI adapter does not configure devices", new_diff, new_conf), None)

    def get_capabilities(self) -> list[str]:
        return []

    def get_modules(self) -> dict[str, ModCap]:
        return self._modules

    def subscription_method(self) -> str:
        return SUBSCRIPTION_UNKNOWN

    def subscription_status(self) -> SubscriptionStatus:
        return SubscriptionStatus(SUBSCRIPTION_UNKNOWN)

    def fetch_config(self, done: action(?gdata.Node, ?Exception) -> None):
        done(gdata.Container({}), None)

    def get_config(self) -> ?gdata.Node:
        return gdata.Container({})

    def get(self, cb: action(?gdata.Node, ?Exception) -> None, filt: ?gdata.FNode=None):
        self._driver.get(cb, filt)

    def rpc(self, cb: action(?gdata.Node, ?Exception) -> None, gdata_rpc: gdata.Node):
        self._driver.rpc(cb, gdata_rpc)

    def rpc_xml(self, cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node):
        cb(None, ConfigError("the IOS XE CLI adapter does not support XML RPCs"))

    def declare_subscriptions(self, owner_id: str, cb: action(?gdata.Node, ?Exception) -> None,
                              want: set[gdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        cb(None, PermanentError("the IOS XE CLI adapter does not support subscriptions"))
        if synced is not None:
            synced(owner_id)

    def remove_subscriptions(self, owner_id: str):
        pass

    def close(self, on_close: ?action() -> None=None):
        self._driver.close(on_close)
