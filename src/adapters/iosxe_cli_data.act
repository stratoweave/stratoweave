SRC_DNODE_RPC_7: DRpc = DRpc(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='verify', description="Run 'verify' on a file. With an algorithm, the device computes the\nchecksum of the file, and with a hash it also compares the checksum\nwith the hash. Without an algorithm, the device checks an IOS XE\nimage: it compares the hashes that the image holds with the hashes of\nits content, and it checks the digital signature of the image.", input=DInput(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', children=[
    DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='file-system', config=False, description='The file system name with its colon, e.g. bootflash:.', is_key=False, mandatory=True, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='file_system'),
    DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='file', config=False, description='The name of a file in the top directory. Only letters, digits,\ndots, underscores and hyphens are permitted.', is_key=False, mandatory=True, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='file'),
    DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='algorithm', config=False, is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'md5':0, 'sha512':1}), adata_name='algorithm'),
    DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='hash', config=False, description='The expected checksum in hexadecimal digits: 32 for md5, 128 for\nsha512. It needs an algorithm.', is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='hash')
]), output=DOutput(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', children=[
    DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='digest', config=False, description='The checksum that the device computed, in lower-case hexadecimal\ndigits. Only with an algorithm.', is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='digest'),
    DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='verified', config=False, description='With a hash: true if the checksum is equal to the hash. Without an\nalgorithm: true if each computed hash is equal to the hash that the\nimage holds and the device verified the digital signature.', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, units=None, exts=[], builtin_type='boolean', default=None), adata_name='verified')
]), children=[
    DInput(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', adata_name='input', children=[
        DLeaf(module='stratoweave-iosxe-cli', namespace='http://stratoweave.org/yang/stratoweave-iosxe-cli', prefix='xecli', name='file-system', config=False, description='The file system name with its colon, e.g. bootflash:.', is_key=False, mandatory=True, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='file_system'),
