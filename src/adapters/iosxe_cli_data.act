SRC_YANG_0: str = r"""module stratoweave-iosxe-cli {
  yang-version "1.1";
  namespace "http://stratoweave.org/yang/stratoweave-iosxe-cli";
  prefix xecli;

  description
    "Data that the StratoWeave IOS XE CLI adapter reads with exec commands
     over SSH, and the commands that it runs on request.";

  container file-systems {
    config false;
    list file-system {
      key "name";
      description
        "The top directory of a file system, as 'dir' shows it. A read
         that does not select file systems by name gets bootflash:.";
      leaf name {
        type string;
        description "The file system name with its colon, e.g. bootflash:.";
      }
      leaf total {
        type uint64;
        units "bytes";
        description "The size of the file system, from the last line of the listing.";
      }
      leaf free {
        type uint64;
        units "bytes";
        description "The free space of the file system, from the last line of the listing.";
      }
      list file {
        key "name";
        description "A regular file. Directories are not included.";
        leaf name {
          type string;
        }
        leaf size {
          type uint64;
          units "bytes";
        }
        leaf modified {
          type string;
          description
            "The modification time in the yang:date-and-time format, e.g.
             2026-11-07T20:28:06+00:00.";
        }
        leaf index {
          type uint64;
          description
            "The number that dir gives the file, its inode: a file that is
             written again gets another.";
        }
      }
    }
  }

  container version {
    config false;
    description "The software and the hardware, as 'show version' shows them.";
    leaf version {
      type string;
      description "The IOS XE release, e.g. 17.18.02.";
    }
    leaf model {
      type string;
      description "The chassis model, e.g. C8000V.";
    }
    leaf serial-number {
      type string;
      description "The processor board ID.";
    }
    leaf system-image {
      type string;
      description "The file that the device booted, e.g. bootflash:packages.conf.";
    }
  }

  container config-change {
    config false;
    description
      "The comment lines at the top of show running-config and show
       startup-config that say when the configuration changed last. Both
       say the same after write memory.";
    leaf running {
      type string;
      description
        "E.g. 'Last configuration change at 22:34:25 UTC Tue Nov 10 2026 by
         admin', or 'No configuration change since last restart'.";
    }
    leaf startup {
      type string;
      description "The line in the startup configuration, from the last write memory.";
    }
  }

  container bootvar {
    config false;
    description "The boot variables, as 'show bootvar' shows them.";
    leaf-list boot {
      type string;
      ordered-by user;
      description
        "The files of the BOOT variable, in the order that ROMMON tries
         them, e.g. bootflash:packages.conf. The number after each file in
         the output is not kept.";
    }
    leaf config-file {
      type string;
      description "The CONFIG_FILE variable. Absent when it does not exist.";
    }
    leaf bootldr {
      type string;
      description "The BOOTLDR variable. Absent when it does not exist.";
    }
    leaf configuration-register {
      type string;
      description "The configuration register, e.g. 0x2102.";
    }
    leaf next-configuration-register {
      type string;
      description
        "The configuration register at the next reload, when the output
         gives one.";
    }
  }

  container install-summary {
    config false;
    description "The installed packages, as 'show install summary' shows them.";
    list location {
      key "name";
      description "A part of the device that runs software, e.g. R0.";
      leaf name {
        type string;
      }
      list package {
        key "name";
        leaf name {
          type string;
          description "The file name or the version, e.g. 17.09.05a.0.6476.";
        }
        leaf type {
          type string;
          description "The package type, e.g. IMG.";
        }
        leaf state {
          type enumeration {
            enum inactive;
            enum activated-uncommitted;
            enum activated-committed;
            enum deactivated-uncommitted;
          }
        }
      }
    }
    leaf auto-abort-timer {
      type string;
      description "The state of the auto-abort timer, e.g. inactive.";
    }
  }

  container copy-progress {
    config false;
    description
      "How far the copy that runs now is, from the marks that it prints. The
       adapter answers without a command, also while the copy runs. Empty
       while no copy runs.";
    leaf file {
      type string;
      description "The destination of the copy, e.g. bootflash:sw.bin.";
    }
    leaf bytes {
      type uint64;
      units "bytes";
      description
        "The bytes copied so far: IOS XE prints ! for each 196608 bytes
         that it copies over http, on a C1111 with 16.8.1 and with
         17.15.06.";
    }
  }

  rpc install {
    description
      "Run an 'install' command. Only letters, digits and the characters
       ._~:/@%+=,- are permitted in a file, a URL or a label. A command that
       activates software reloads the device.";
    input {
      choice command {
        mandatory true;
        container add {
          presence "install add";
          leaf file {
            type string;
            mandatory true;
            description
              "A package file or a URL, e.g. bootflash:x.bin or
               http://host/x.bin.";
          }
          leaf activate {
            type empty;
          }
          leaf commit {
            type empty;
            description "Commit after the activation. It needs activate.";
          }
          leaf prompt-level {
            type enumeration {
              enum none;
            }
          }
        }
        container activate {
          presence "install activate";
          leaf file {
            type string;
          }
          leaf auto-abort-timer {
            type uint16 {
              range "30..1200";
            }
            units "minutes";
          }
          leaf prompt-level {
            type enumeration {
              enum none;
            }
          }
        }
        leaf commit {
          type empty;
        }
        leaf abort {
          type empty;
        }
        container remove {
          presence "install remove";
          choice what {
            mandatory true;
            leaf file {
              type string;
            }
            leaf inactive {
              type empty;
            }
          }
        }
        container rollback {
          presence "install rollback";
          choice to {
            mandatory true;
            leaf base {
              type empty;
            }
            leaf committed {
              type empty;
            }
            leaf id {
              type uint32;
            }
            leaf label {
              type string;
            }
          }
        }
      }
    }
    output {
      leaf reloading {
        type boolean;
        description
          "True if the device reloads to finish the command: it says so, or
           it ends the session early.";
      }
    }
  }

  rpc configure {
    description
      "Type configuration commands in 'configure terminal', one at a time,
       then 'end'. The device applies each command when it gets it; there
       is no transaction. The RPC stops at the first command that the
       device rejects, and the commands before it stay applied. A command
       that asks a question fails the RPC when no prompt follows.";
    input {
      leaf-list line {
        type string;
        ordered-by user;
        min-elements 1;
        description
          "A configuration command, e.g. boot system flash
           bootflash:packages.conf. Control characters and ? are not
           permitted.";
      }
    }
  }

  rpc write-memory {
    description "Save the running configuration with 'write memory'.";
  }

  rpc copy {
    description
      "Copy a file to a file system with 'copy SOURCE FILE-SYSTEMFILE'. The
       RPC gives the destination file name when the device asks for it, and
       confirms that a file with the same name is overwritten.";
    input {
      leaf source {
        type string;
        mandatory true;
        description
          "A URL or a file, e.g. http://host/x.bin. Only letters, digits and
           the characters ._~:/@%+=,- are permitted.";
      }
      leaf file-system {
        type string;
        mandatory true;
        description "The file system name with its colon, e.g. bootflash:.";
      }
      leaf file {
        type string;
        mandatory true;
        description
          "The name of the file in the top directory. Only letters, digits,
           dots, underscores and hyphens are permitted.";
      }
    }
    output {
      leaf size {
        type uint64;
        units "bytes";
        description "The size of the copy, as the device reports it.";
      }
    }
  }

  rpc delete {
    description
      "Delete a file with 'delete FILE-SYSTEMFILE'. The RPC gives the file
       name when the device asks for it, and confirms the delete.";
    input {
      leaf file-system {
        type string;
        mandatory true;
        description "The file system name with its colon, e.g. bootflash:.";
      }
      leaf file {
        type string;
        mandatory true;
        description
          "The name of a file in the top directory. Only letters, digits,
           dots, underscores and hyphens are permitted.";
      }
    }
  }

  rpc verify {
    description
      "Run 'verify' on a file. With an algorithm, the device computes the
       checksum of the file, and with a hash it also compares the checksum
       with the hash. Without an algorithm, the device checks an IOS XE
       image: it compares the hashes that the image holds with the hashes of
       its content, and it checks the digital signature of the image.";
    input {
      leaf file-system {
        type string;
        mandatory true;
        description "The file system name with its colon, e.g. bootflash:.";
      }
      leaf file {
        type string;
        mandatory true;
        description
          "The name of a file in the top directory. Only letters, digits,
           dots, underscores and hyphens are permitted.";
      }
      leaf algorithm {
        type enumeration {
          enum md5;
          enum sha512;
        }
      }
      leaf hash {
        type string;
        description
          "The expected checksum in hexadecimal digits: 32 for md5, 128 for
           sha512. It needs an algorithm.";
      }
    }
    output {
      leaf digest {
        type string;
        description
          "The checksum that the device computed, in lower-case hexadecimal
           digits. Only with an algorithm.";
      }
      leaf verified {
        type boolean;
        description
          "With a hash: true if the checksum is equal to the hash. Without an
           algorithm: true if each computed hash is equal to the hash that the
           image holds and the device verified the digital signature.";
      }
    }
  }
}
"""

SRC_YANG_1: str = r"""module Cisco-IOS-XE-bgp-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XE-bgp-oper";
  prefix bgp-ios-xe-oper;

  description
    "Pruned to what the IOS XE CLI adapter reads: the session state and the
     current prefixes of each neighbor. The keys are those of the full
     module. Enumerations are strings.";

  container bgp-state-data {
    config false;
    container neighbors {
      list neighbor {
        key "afi-safi vrf-name neighbor-id";
        leaf afi-safi {
          type string;
          description "The address family, e.g. ipv4-unicast or vpnv4-unicast.";
        }
        leaf vrf-name {
          type string;
          description "The VRF of the neighbor, default for the global table.";
        }
        leaf neighbor-id {
          type string;
          description "The address of the neighbor.";
        }
        leaf session-state {
          type string;
          description "The state of the session, e.g. fsm-established or fsm-idle.";
        }
        container prefix-activity {
          container sent {
            leaf current-prefixes {
              type uint64;
              description "The prefixes that the device advertises to the neighbor now.";
            }
          }
          container received {
            leaf current-prefixes {
              type uint64;
              description "The prefixes that the device has from the neighbor now.";
            }
          }
        }
      }
    }
  }
}
"""

pure def src_yang() -> list[str]:
    return [
        SRC_YANG_0,
        SRC_YANG_1,
    ]


