#
# SR OS platform probe: the release in a version number, and which chassis
# names the serial number. test_platform_lab covers the lab's vSIM.
#

import testing
import std.xml as xml
import yang
import yang.gdata as ygdata
import yang.xml as yxml

import adapters.platform_sros as sros
import adapters.platform_sros_yang as sros_yang
from adapters.adapter import ModCap


def _state(chassis: list[(cls: str, number: int, serial: str)]) -> ygdata.Node:
    """A reply with platform 7750 SR-7, release B-24.10.R3 and these chassis."""
    entries = ""
    for c in chassis:
        entries += "<chassis><chassis-class>{c.cls}</chassis-class><chassis-number>{c.number}</chassis-number><hardware-data><serial-number>{c.serial}</serial-number></hardware-data></chassis>"
    body = "<state xmlns=\"urn:nokia.com:sros:ns:yang:sr:state\"><system><platform>7750 SR-7</platform><version><version-number>B-24.10.R3</version-number></version></system>{entries}</state>"
    return yxml.from_xml(yang.compile(sros_yang.models), xml.decode("<data>{body}</data>"), loose=True)


def _test_release():
    cases: list[(version: ?str, want: ?str)] = [
        (version="C-23.10.R1", want="23.10.R1"),
        (version="B-24.10.R3", want="24.10.R3"),
        (version="23.10.R1", want="23.10.R1"),
        (version="C-", want=None),
        (version="", want=None),
        (version=None, want=None),
    ]
    for c in cases:
        testing.assertEqual(c.want, sros.release(c.version), "release of {c.version}")


def _test_serial_from_the_lowest_router_chassis():
    """The serial number comes from the router chassis with the lowest
    number, whatever order the entries come in. Other chassis classes do not
    count."""
    cases: list[(label: str, chassis: list[(cls: str, number: int, serial: str)], serial: ?str)] = [
        (label="lowest-last",
         chassis=[(cls="router", number=2, serial="S2"), (cls="router", number=1, serial="S1")],
         serial="S1"),
        (label="lowest-first",
         chassis=[(cls="router", number=1, serial="S1"), (cls="router", number=2, serial="S2")],
         serial="S1"),
        (label="other-class-lower",
         chassis=[(cls="satellite", number=1, serial="SAT"), (cls="router", number=3, serial="S3")],
         serial="S3"),
        (label="no-router-chassis",
         chassis=[(cls="satellite", number=1, serial="SAT")],
         serial=None),
        (label="no-chassis", chassis=[], serial=None),
    ]
    for c in cases:
        p = sros.platform(_state(c.chassis))
        if p is not None:
            testing.assertEqual("sros 24.10.R3 7750 SR-7", "{p.os} {p.version} {p.model}", c.label)
            testing.assertEqual(c.serial, p.serial_number, "{c.label}: serial number")
        else:
            testing.error("{c.label}: no platform")


def _test_platform_without_values():
    testing.assertTrue(sros.platform(None) is None, "no reply")
    testing.assertTrue(sros.platform(ygdata.Container({})) is None, "an empty reply")


def _test_probe_applies_on_its_module():
    m = sros.MODULE
    testing.assertTrue(sros.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not sros.PROBE.applies({"nokia-conf": ModCap("nokia-conf", "urn:y")}),
                       "the device does not list the module")
