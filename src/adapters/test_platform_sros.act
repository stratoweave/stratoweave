#
# SR OS platform probe: the release in a version number, and which chassis
# names the serial number. test_platform_lab covers the lab's vSIM.
#

import testing
import std.xml as xml
import yang
import yang.gdata as ygdata
import yang.xml as yxml

import adapters.platform_sros as sros
import adapters.platform_sros_yang as sros_yang
from adapters.adapter import ModCap


# 2026-11-19T08:12:40Z
BOOT = 1795075960


def _state(chassis: list[(cls: str, number: int, serial: str)], system: str="",
           cpms: str="") -> ygdata.Node:
    """A reply with platform 7750 SR-7, release B-24.10.R3, these chassis,
    more of system and these cpm entries."""
    entries = ""
    for c in chassis:
        entries += "<chassis><chassis-class>{c.cls}</chassis-class><chassis-number>{c.number}</chassis-number><hardware-data><serial-number>{c.serial}</serial-number></hardware-data></chassis>"
    body = "<state xmlns=\"urn:nokia.com:sros:ns:yang:sr:state\"><system><platform>7750 SR-7</platform><version><version-number>B-24.10.R3</version-number></version>{system}</system>{entries}{cpms}</state>"
    return yxml.from_xml(yang.compile(sros_yang.models), xml.decode("<data>{body}</data>"), loose=True)


def _cpm(slot: str, booted: str) -> str:
    """A cpm entry whose software booted at booted, or without
    software-last-boot-time when booted is empty."""
    t = "<software-last-boot-time>{booted}</software-last-boot-time>" if booted != "" else ""
    return "<cpm><cpm-slot>{slot}</cpm-slot><hardware-data>{t}</hardware-data></cpm>"


def _test_release():
    cases: list[(version: ?str, want: ?str)] = [
        (version="C-23.10.R1", want="23.10.R1"),
        (version="B-24.10.R3", want="24.10.R3"),
        (version="23.10.R1", want="23.10.R1"),
        (version="C-", want=None),
        (version="", want=None),
        (version=None, want=None),
    ]
    for c in cases:
        testing.assertEqual(c.want, sros.release(c.version), "release of {c.version}")


def _test_serial_from_the_lowest_router_chassis():
    """The serial number comes from the router chassis with the lowest
    number, whatever order the entries come in. Other chassis classes do not
    count."""
    cases: list[(label: str, chassis: list[(cls: str, number: int, serial: str)], serial: ?str)] = [
        (label="lowest-last",
         chassis=[(cls="router", number=2, serial="S2"), (cls="router", number=1, serial="S1")],
         serial="S1"),
        (label="lowest-first",
         chassis=[(cls="router", number=1, serial="S1"), (cls="router", number=2, serial="S2")],
         serial="S1"),
        (label="other-class-lower",
         chassis=[(cls="satellite", number=1, serial="SAT"), (cls="router", number=3, serial="S3")],
         serial="S3"),
        (label="no-router-chassis",
         chassis=[(cls="satellite", number=1, serial="SAT")],
         serial=None),
        (label="no-chassis", chassis=[], serial=None),
    ]
    for c in cases:
        p = sros.platform(_state(c.chassis))
        if p is not None:
            testing.assertEqual("sros 24.10.R3 7750 SR-7", "{p.os} {p.version} {p.model}", c.label)
            testing.assertEqual(c.serial, p.serial_number, "{c.label}: serial number")
        else:
            testing.error("{c.label}: no platform")


def _test_last_boot_from_the_active_cpm():
    """The last boot is when the software of the active CPM booted. A
    standby CPM can have booted at another time."""
    active_a = "<active-cpm-slot>A</active-cpm-slot>"
    active_b = "<active-cpm-slot>B</active-cpm-slot>"
    cases: list[(label: str, system: str, cpms: str, want: ?int)] = [
        (label="one cpm", system=active_a, cpms=_cpm("A", "2026-11-19T08:12:40.0Z"), want=BOOT),
        (label="offset", system=active_a, cpms=_cpm("A", "2026-11-19T09:12:40+01:00"), want=BOOT),
        (label="active b", system=active_b,
         cpms=_cpm("A", "2026-11-18T11:06:40.0Z") + _cpm("B", "2026-11-19T08:12:40.0Z"), want=BOOT),
        (label="active a, standby booted later", system=active_a,
         cpms=_cpm("A", "2026-11-19T08:12:40.0Z") + _cpm("B", "2026-11-20T08:00:00.0Z"), want=BOOT),
        (label="active cpm without a boot time", system=active_a,
         cpms=_cpm("A", "") + _cpm("B", "2026-11-19T08:12:40.0Z"), want=None),
        (label="no active cpm slot", system="", cpms=_cpm("A", "2026-11-19T08:12:40.0Z"), want=None),
        (label="no cpm entries", system=active_a, cpms="", want=None),
        (label="not a date and time", system=active_a, cpms=_cpm("A", "11/19/2026 08:12:40"), want=None),
    ]
    for c in cases:
        p = sros.platform(_state([(cls="router", number=1, serial="S1")], c.system, c.cpms))
        if p is not None:
            testing.assertEqual(c.want, p.last_boot, c.label)
            testing.assertEqual("sros 24.10.R3 7750 SR-7 S1",
                                "{p.os} {p.version} {p.model} {p.serial_number}", "{c.label}: the rest")
        else:
            testing.error("{c.label}: no platform")


def _test_filter_selects_the_boot_of_the_cpms():
    """One get with the filter gives the last boot with the rest."""
    reply = _state([(cls="router", number=1, serial="S1")], "<active-cpm-slot>B</active-cpm-slot>",
                   _cpm("A", "2026-11-18T11:06:40.0Z") + _cpm("B", "2026-11-19T08:12:40.0Z"))
    got = ygdata.filter(reply, ygdata.FNode(children=[sros.platform_filter()]))
    p = sros.platform(got)
    if p is not None:
        testing.assertEqual("sros 24.10.R3 7750 SR-7 S1 {BOOT}",
                            "{p.os} {p.version} {p.model} {p.serial_number} {p.last_boot}", "platform")
    else:
        testing.error("no platform")


def _test_platform_without_values():
    testing.assertTrue(sros.platform(None) is None, "no reply")
    testing.assertTrue(sros.platform(ygdata.Container({})) is None, "an empty reply")


def _test_probe_applies_on_its_module():
    m = sros.MODULE
    testing.assertTrue(sros.PROBE.applies({m: ModCap(m, "urn:x")}),
                       "the device lists the module")
    testing.assertTrue(not sros.PROBE.applies({"nokia-conf": ModCap("nokia-conf", "urn:y")}),
                       "the device does not list the module")
