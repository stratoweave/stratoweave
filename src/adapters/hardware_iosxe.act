#
# IOS XE hardware read: the chassis product id, like C8000V, out of the
# Cisco-IOS-XE-device-hardware-oper inventory. Cisco-IOS-XE-platform-oper
# names it too, but a lab c8000v returned invalid UTF-8 in that tree.
#

import yang.gdata as ygdata

import adapters.software_iosxe_oper as ixoper

MODULE = "Cisco-IOS-XE-device-hardware-oper"

HW_TYPE_CHASSIS = "hw-type-chassis"


def inventory_filter() -> ygdata.FNode:
    """The whole inventory: the generated entry filter pins hw-dev-index too,
    and a chassis need not be index 0."""
    paths = ixoper.subs.device_hardware_data.device_hardware
    return paths.device_inventory.filt()!


def chassis_model(root: ?ygdata.Node) -> ?str:
    """Part-number of the first chassis entry, like C8000V, or None."""
    hardware = ixoper.root.from_gdata(root).device_hardware_data.device_hardware
    for e in hardware.device_inventory:
        if e.hw_type == HW_TYPE_CHASSIS:
            pn = e.part_number
            if pn is not None and len(pn) > 0:
                return pn
    return None


READ = (module=MODULE, filt=inventory_filter(), parse=chassis_model)
