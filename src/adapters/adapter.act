import logging
import ssh
import ssh_config
import testing
import std.xml as xml

import yang.adata as yadata
import yang.gdata as ygdata
import subscriptions

import yp

from device_schema import DeviceSchema, SchemaKey

from device_meta_config import \
    stratoweave_rfs__device_entry as DeviceMetaConfig, \
    stratoweave_rfs__device__ssh as DeviceMetaConfigSsh

DISCONNECTED  = 0
CONNECTING    = 1
CONNECTED     = 2
TRANSACTION   = 3

_SECRET_NODES = {"credentials", "initial-credentials"}


def _without_secrets(n: ygdata.Node) -> ygdata.Node:
    if isinstance(n, ygdata.Container):
        children: dict[ygdata.Id, ygdata.Node] = {}
        for k, v in n.children.items():
            if k.name not in _SECRET_NODES:
                children[k] = _without_secrets(v)
        return ygdata.Container(children, presence=n.presence, ns=n.ns, module=n.module)
    if isinstance(n, ygdata.ListNode):
        return n.like([_without_secrets(e) for e in n.entries()])
    return n


def dmc_for_log(dmc: DeviceMetaConfig) -> str:
    """Return the device meta configuration as JSON for a log message.

    Credentials and initial credentials are left out.
    """
    return _without_secrets(dmc.to_gdata()).to_yang_jsonstr()


def ssh_transport_config(cfg: DeviceMetaConfigSsh) -> ssh.TransportConfig:
    """Build an SSH TransportConfig from a device's ssh container."""
    # Bind the optionals to locals: narrowing does not carry through an
    # attribute access.
    rekey_bytes = cfg.rekey_after_bytes
    rekey_seconds = cfg.rekey_after_seconds
    return ssh_config.transport_config(
        cfg.cipher,
        cfg.mac,
        cfg.key_exchange,
        cfg.host_key_algorithm,
        cfg.public_key_algorithm,
        cfg.compression_algorithm,
        int(cfg.compression_level),
        int(rekey_bytes) if rekey_bytes is not None else None,
        int(rekey_seconds) if rekey_seconds is not None else None,
        int(cfg.minimum_rsa_bits))


class MockRoot(yadata.MNode):
    """Mock root node for mock devices"""
    def __init__(self):
        self._name = "dummy"
        self._ns = "dummy_ns"
        self._schema = None
        self._parent = None

    mut def to_gdata(self, prev) -> ygdata.Node:
        return ygdata.Leaf(self._name)

    @staticmethod
    mut def from_gdata(self, gdata: ?ygdata.Node=None) -> yadata.MNode:
        return MockRoot()

    mut def prsrc(self, self_name='ad') -> str:
        return f"{self_name}.{self._name}"

class DeviceError(Exception):
    """Exception raised when the device configuration fails
    """

class TransientError(DeviceError):
    """Transient errors are temporary and can typically be recovered from by retrying
    """

class PermanentError(DeviceError):
    """Permanent errors are typically not recoverable

    Like the device things the configuration is invalid, which is not going to
    change no matter how many times we retry
    """

class NotConnectedError(TransientError):
    """The device is not connected
    """

class BusyError(TransientError):
    """The device is busy, i.e. it is currently processing a configuration transaction
    """

class LockedError(TransientError):
    """The device is locked, i.e. it is not possible to configure it at the moment
    """

class TxidMismatchError(TransientError):
    """The device's txid doesn't match the expected txid, configuration drift detected
    """

class ConfigError(PermanentError):
    """Configuration error, i.e. the device rejected the configuration

    Retrying the same configuration typically does not help.

    Args:
        message (str): The error message from the device
        conf: The configuration sent to the device that caused the error,
            normally a diff computed from the current running configuration and
            the target configuration.
        target_conf: The target configuration, i.e. the configuration that we
            intended to have on the device, which is the entire declarative
            configuration for the device as outputted by transforms.
    """
    conf: ?ygdata.Node
    target_conf: ?ygdata.Node

    def __init__(self, message: str="", conf: ?ygdata.Node=None, target_conf: ?ygdata.Node=None):
        PermanentError.__init__(self, message)
        self.conf = conf
        self.target_conf = target_conf

class ModCap(object):
    name: str
    namespace: str
    revision: ?str
    feature: list[str]

    def __init__(self, name: str, namespace: str, revision: ?str=None, feature: list[str]=[]):
        self.name = name
        self.namespace = namespace
        self.revision = revision
        self.feature = feature

    def __str__(self) -> str:
        return f"ModCap(name={self.name}, namespace={self.namespace}, revision={self.revision}, feature={self.feature})"

extension ModCap(Eq):
    def __eq__(self, other: ModCap) -> bool:
        self_revision = self.revision
        other_revision = other.revision
        revision_eq = (self_revision is None and other_revision is None) or (self_revision is not None and other_revision is not None and self_revision == other_revision)
        return self.name == other.name and self.namespace == other.namespace and revision_eq and self.feature == other.feature


def hash_modset(modset: dict[str, ModCap]) -> str:
    # TODO: use a better hash function
    # We use map here instead of a list comprehension to avoid creating the
    # intermediate list of strings. Ideally we could achieve the same with a
    # generator expression.
    modset_str = map(lambda m: str(modset[m]), sorted(modset.keys()))
    return str(hash("".join(modset_str)))


def modset_eq(a: dict[str, ModCap], b: dict[str, ModCap]) -> bool:
    if len(a) != len(b):
        return False
    if set(a.keys()) != set(b.keys()):
        return False
    for k in a.keys():
        if a[k] != b[k]:
            return False
    return True


def parse_cap(tcap: str) -> ModCap:
    parts = tcap.split("?", 1)

    name = parts[0]
    namespace = parts[0]
    revision = None
    feature = []

    qps = {}
    if len(parts) > 1:
        qparts = parts[1].split("&")
        for qpart in qparts:
            qkvparts = qpart.split("=")
            if len(qkvparts) == 2:
                qk, qv = qkvparts[0], qkvparts[1]
                qps[qk] = qv

    if "module" in qps:
        name = qps["module"]
    if "revision" in qps:
        revision = qps["revision"]

    return ModCap(name, namespace, revision, feature)


class DeviceStream(object):
    """One folded device read or native stream, shared by equal declarations.

    A rooted stream keeps indexed instances instead of a merged feed.
    done includes an unsuccessful first read; error keeps that result for
    consumers joining before the next successful read.
    """
    spec: ygdata.SubscriptionSpec
    latest: ?ygdata.Node
    instances: ?subscriptions.InstanceTree
    owners: set[str]
    active: bool
    done: bool
    error: ?Exception

    def __init__(self, spec: ygdata.SubscriptionSpec):
        self.spec = spec
        self.latest = None
        point = ygdata.root_names(spec.root)
        self.instances = subscriptions.InstanceTree(None, point) if len(point) > 0 else None
        self.owners = set()
        self.active = True
        self.done = False
        self.error = None


class Subscription(object):
    """One destination; synced follows the first pass of every folded read."""
    @property
    cb: action(?ygdata.Node, ?Exception) -> None
    @property
    synced: ?action(str) -> None
    want: set[ygdata.SubscriptionSpec]
    pending: set[ygdata.SubscriptionSpec]
    owed: bool
    previous: list[ygdata.Node]

    def __init__(self, cb: action(?ygdata.Node, ?Exception) -> None, want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        self.cb = cb
        self.synced = synced
        self.want = set(want)
        self.pending = set(want)
        self.owed = True
        self.previous = []


# subscription_method() / SubscriptionStatus.method values: the transport used to
# realize a subscription against a device.
SUBSCRIPTION_YANG_PUSH = "yang-push"   # device pushes natively (RFC 8641)
SUBSCRIPTION_POLL = "poll"             # client-side periodic <get> polling
SUBSCRIPTION_CONNECTING = "connecting" # not yet determined (device connecting)
SUBSCRIPTION_MOCK = "mock"             # in-process mock adapter
SUBSCRIPTION_UNKNOWN = "unknown"       # adapter does not realize subscriptions


class SubscriptionStatus(object):
    """Operational state of how a device's subscriptions are realized.

    method is the transport (see SUBSCRIPTION_* above). periodic is True for
    periodic delivery, False for on-change (RFC 8641). emulated is True when
    periodic delivery is faked by client-side get polling because the device has no
    yang-push, and False when the device pushes natively - i.e. it distinguishes
    true periodic from periodic emulated via poll. This is the home for further
    per-subscription state (period, device subscription-id, established/error) as
    it is needed."""
    method: str
    periodic: bool
    emulated: bool

    def __init__(self, method: str, periodic: bool=True, emulated: bool=False):
        self.method = method
        self.periodic = periodic
        self.emulated = emulated

    def description(self) -> str:
        """One-line, human-facing summary for e.g. ncurl monitor."""
        if self.method == SUBSCRIPTION_YANG_PUSH:
            return "true periodic (yang-push)" if self.periodic else "true on-change (yang-push)"
        if self.method == SUBSCRIPTION_POLL:
            return "emulated periodic (polling)"
        return self.method


# notif_status() mechanism values: how a notification channel reaches the device.
NOTIF_5277 = "create-subscription"          # RFC 5277 classic
NOTIF_ESTABLISH = "establish-subscription"  # RFC 8639 or the IOS XE draft dialect
NOTIF_MOCK = "mock"                         # in-process mock adapter


class NotifSpec(value):
    """Declarative event notification subscription.

    name is the qualified notification name to deliver; None means all
    notifications (scoped to `stream` if given, else the device's default
    channels). stream pins the spec to a named device stream (e.g. "snmpevents")
    instead of the adapter's routing policy — the explicit opt-in for streams no
    policy can infer; None routes by policy.
    """
    name: ?ygdata.Id
    stream: ?str

    def __init__(self, name: ?ygdata.Id=None, stream: ?str=None):
        self.name = name
        self.stream = stream

    def __str__(self) -> str:
        name = self.name
        name_str = str(name) if name is not None else "*"
        stream = self.stream
        if stream is not None:
            return "NotifSpec({name_str} @ {stream})"
        return "NotifSpec({name_str})"

    def __repr__(self) -> str:
        return str(self)


extension NotifSpec(Hashable):
    def __eq__(self, other: NotifSpec) -> bool:
        self_name = self.name
        other_name = other.name
        if self_name is None:
            if other_name is not None:
                return False
        elif other_name is None or self_name != other_name:
            return False
        self_stream = self.stream
        other_stream = other.stream
        if self_stream is None:
            return other_stream is None
        return other_stream is not None and self_stream == other_stream

    def hash(self, hasher):
        name = self.name
        if name is not None:
            "some".hash(hasher)
            name.q.hash(hasher)
            name.name.hash(hasher)
        else:
            "none".hash(hasher)
        stream = self.stream
        if stream is not None:
            "some".hash(hasher)
            stream.hash(hasher)
        else:
            "none".hash(hasher)


class NotifEvent(object):
    """One received event notification.

    payload is the event decoded against the device schema, rooted at the
    notification; None when the notification is not in the schema or failed to
    decode — raw always carries the payload element as received, so taps and
    debugging see everything. raw also carries the namespace prefixes that the
    device declared on the envelope, so it reads correctly on its own.
    event_time is the envelope's eventTime, verbatim RFC 3339 text.
    """
    name: ygdata.Id
    event_time: str
    payload: ?ygdata.Node
    raw: xml.Node

    def __init__(self, name: ygdata.Id, event_time: str, payload: ?ygdata.Node,
                 raw: xml.Node):
        self.name = name
        self.event_time = event_time
        self.payload = payload
        self.raw = raw

    def __str__(self) -> str:
        return "NotifEvent({self.name} @ {self.event_time})"


class NotifChannelStatus(object):
    """Operational state of one open notification channel: the mechanism (see
    NOTIF_* above), the device stream it consumes (None when the mechanism has
    no stream concept), whether it rides the main session or a dedicated one,
    and its state ("active" | "connecting" | "unsupported")."""
    mechanism: str
    stream: ?str
    session: str
    state: str

    def __init__(self, mechanism: str, stream: ?str, session: str, state: str):
        self.mechanism = mechanism
        self.stream = stream
        self.session = session
        self.state = state

    def description(self) -> str:
        stream = self.stream
        at_stream = " stream={stream}" if stream is not None else ""
        return "{self.mechanism}{at_stream} ({self.session} session, {self.state})"


class NotifOwner(object):
    """One logical event subscriber: its callback, desired spec set, and
    whether it still waits to hear that its subscriptions are in place."""
    @property
    cb: action(?NotifEvent, ?Exception) -> None
    want: set[NotifSpec]
    @property
    synced: ?action(str) -> None
    owed: bool

    def __init__(self, cb: action(?NotifEvent, ?Exception) -> None, want: set[NotifSpec], synced: ?action(str) -> None=None):
        self.cb = cb
        self.want = set(want)
        self.synced = synced
        self.owed = synced is not None


def notif_want_matches(want: set[NotifSpec], name: ygdata.Id, src_stream: ?str=None) -> bool:
    """True if an event with this qualified name, arriving on src_stream
    (None when the channel has no stream concept), should be delivered to an
    owner with this want set. Named specs match by name regardless of arrival
    channel — the stream only steers routing. A wildcard spec pinned to a
    stream takes only that stream's events; a bare wildcard takes everything."""
    for spec in want:
        spec_name = spec.name
        spec_stream = spec.stream
        if spec_name is not None:
            if spec_name.q == name.q and spec_name.name == name.name:
                return True
        elif spec_stream is None:
            return True
        elif src_stream is not None and spec_stream == src_stream:
            return True
    return False


def subscription_delay(spec: ygdata.SubscriptionSpec) -> float:
    pn = spec.period
    if pn is not None:
        return float(pn) / 1000000000.0
    return float(1)


def merge_subscription_tree(want: set[ygdata.SubscriptionSpec], streams: dict[ygdata.SubscriptionSpec, DeviceStream]) -> ?ygdata.Node:
    """Merge folded reads in cadence order, with on-change state last."""
    merged = None
    periodic: dict[u64, ygdata.SubscriptionSpec] = {}
    change: list[ygdata.SubscriptionSpec] = []
    for spec in want:
        period = spec.period
        if period is not None:
            periodic[period] = spec
        else:
            change.append(spec)
    for spec in [periodic[p] for p in sorted(periodic.keys())] + change:
        if spec in streams:
            stream = streams[spec]
            if stream.latest is not None:
                merged = ygdata.patch(merged, stream.latest) if merged is not None else stream.latest
    return merged


class DeviceAdapter(object):
    """Abstract base class for Device Adapters
    """
    _log_handler: logging.Handler
    _env: ?Env

    def supports_mocking(self) -> bool:
        return False

    proc def close(self, on_close: ?action() -> None=None):
        if on_close is not None:
            on_close()

    set_dmc: proc(new_dmc: DeviceMetaConfig) -> None

    ## Configure the device with the given configuration
    ##
    ## :param done: callback to call when the configuration is done
    ## :param new_diff: the diff to apply (computed by DeviceMgr)
    ## :param new_conf: the new configuration to apply
    ## :param running_conf: the current running configuration (with device txid)
    configure: proc(done: action(?Exception, ?ygdata.Node) -> None, new_diff: ygdata.Node, new_conf: ygdata.Node, running_conf: ?ygdata.Node) -> None

    get_capabilities: proc() -> list[str]

    ## How this adapter realizes subscriptions (the transport, e.g. NETCONF picks
    ## yang-push vs poll from device capabilities), and the richer operational
    ## status behind it (subscription_status().method == subscription_method()).
    subscription_method: proc() -> str
    subscription_status: proc() -> SubscriptionStatus

    get_modules: proc() -> dict[str, ModCap]

    ## Get the current running config from the device
    ##
    ## :param done: callback to call when the operation is completed
    ##
    ## This is an async operation with the results available in the callback.
    fetch_config: proc(done: action(?ygdata.Node, ?Exception) -> None) -> None

    get_config: proc() -> ?ygdata.Node

    ## Send a RPC to the device (gdata)
    ##
    ## This action works with gdata - the request as well as the reply are gdata
    ## nodes. Processing the reply therefore needs the schema.
    rpc: proc(cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node) -> None

    ## Send a raw RPC, bypassing the device schema.
    ##
    ## The schemaless counterpart of rpc() - the request and as well as the
    ## reply are XML nodes.
    rpc_xml: proc(cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node) -> None

    ## Read device data once, narrowed by `filt`.
    ##
    ## The result may contain configuration, operational state, or both. For
    ## callers that need a value now rather than a stream of updates. A
    ## subscription is the better choice for anything watched continuously.
    get: proc(cb: action(?ygdata.Node, ?Exception) -> None, filt: ?ygdata.FNode) -> None

    declare_subscriptions: proc(str, action(?ygdata.Node, ?Exception) -> None, set[ygdata.SubscriptionSpec], ?action(str) -> None) -> None
    remove_subscriptions: proc(str) -> None

    ## Declare an owner's full desired set of event notification subscriptions.
    ##
    ## Like declare_subscriptions but for discrete events: each call replaces
    ## the owner's previous set; matching events arrive as cb(event, None), and
    ## cb(None, err) signals channel trouble (events may be missing until it
    ## recovers on its own). Delivery is at-most-once with no replay.
    ##
    ## synced, if given, is called once per declaration, when the device
    ## subscriptions for every spec in want are in place: events from then on
    ## reach cb. Send an RPC whose result arrives as an event only after it.
    ##
    ## The default tells the owner that this adapter does not deliver event
    ## notifications. Adapters that deliver them override all three methods.
    proc def declare_notif_subscriptions(self, owner_id: str, cb: action(?NotifEvent, ?Exception) -> None, want: set[NotifSpec], synced: ?action(str) -> None=None):
        if len(want) > 0:
            cb(None, PermanentError("this device adapter does not deliver event notifications"))

    proc def remove_notif_subscriptions(self, owner_id: str):
        pass

    ## The open notification channels and how each reaches the device.
    proc def notif_status(self) -> list[NotifChannelStatus]:
        return []


class NoAdapter(DeviceAdapter):
    def __init__(self, bundled_schema: object, log_handler, env: ?Env):
        self._bundled_schema = bundled_schema
        self._log_handler = log_handler
        self._env = env
        self._log = logging.Logger(self._log_handler)

    def set_dmc(self, new_dmc):
        self._log.debug("NoAdapter.set_dmc", {"new_dmc": dmc_for_log(new_dmc)})

    def configure(self, done, new_diff, new_conf, running_conf):
        # The NoAdapter cannot configure anything, so we just call done() with False
        done(NotConnectedError(), None)

    def get_capabilities(self):
        return []

    def subscription_method(self) -> str:
        return SUBSCRIPTION_UNKNOWN

    def subscription_status(self) -> SubscriptionStatus:
        return SubscriptionStatus(SUBSCRIPTION_UNKNOWN)

    def get_modules(self):
        return {}

    def fetch_config(self, done: action(?ygdata.Node, ?Exception) -> None):
        pass

    def get_config(self):
        pass

    def rpc(self, cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node) -> None:
        cb(None, NotConnectedError())

    def rpc_xml(self, cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node) -> None:
        cb(None, NotConnectedError())

    def get(self, cb: action(?ygdata.Node, ?Exception) -> None, filt: ?ygdata.FNode=None) -> None:
        cb(None, NotConnectedError())

    def declare_subscriptions(self, owner_id: str, cb: action(?ygdata.Node, ?Exception) -> None, want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        cb(None, NotConnectedError())
        s = synced
        if s is not None:
            s(owner_id)

    def remove_subscriptions(self, owner_id: str):
        pass

    def declare_notif_subscriptions(self, owner_id: str, cb: action(?NotifEvent, ?Exception) -> None, want: set[NotifSpec], synced: ?action(str) -> None=None):
        cb(None, NotConnectedError())

class MockAdapter(DeviceAdapter):
    """Mock device adapter
    """
    def __init__(self, on_connect: action(dict[str, ModCap], ?SchemaKey) -> None, bundled_schema: DeviceSchema, log_handler, env: ?Env):
        self._on_connect = on_connect
        self._bundled_schema = bundled_schema
        self._log_handler = log_handler
        self._env = env
        self._log = logging.Logger(self._log_handler)
        self._modset = {}
        self._dmc = None
        self._driver = MockDriver(self._on_connect, self._bundled_schema, self._log_handler, self._env)

    def set_dmc(self, new_dmc: DeviceMetaConfig):
        self._driver.set_dmc(new_dmc)

    def configure(self, done, new_diff, new_conf, running_conf):
        return self._driver.configure(done, new_diff, new_conf, running_conf)

    def get_capabilities(self) -> list[str]:
        return self._driver.get_capabilities()

    def subscription_method(self) -> str:
        return SUBSCRIPTION_MOCK

    def subscription_status(self) -> SubscriptionStatus:
        return SubscriptionStatus(SUBSCRIPTION_MOCK)

    def get_modules(self) -> dict[str, ModCap]:
        return self._driver.get_modules()

    def fetch_config(self, done):
        return self._driver.fetch_config(done)

    def get_config(self):
        return self._driver.get_config()

    def rpc(self, cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node) -> None:
        return self._driver.rpc(cb, gdata_rpc)

    def rpc_xml(self, cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node) -> None:
        return self._driver.rpc_xml(cb, xml_rpc)

    def get(self, cb: action(?ygdata.Node, ?Exception) -> None, filt: ?ygdata.FNode=None) -> None:
        return self._driver.get(cb, filt)

    def declare_subscriptions(self, owner_id: str, cb: action(?ygdata.Node, ?Exception) -> None, want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        self._driver.declare_subscriptions(owner_id, cb, want, synced)

    def remove_subscriptions(self, owner_id: str):
        self._driver.remove_subscriptions(owner_id)

    def declare_notif_subscriptions(self, owner_id: str, cb: action(?NotifEvent, ?Exception) -> None, want: set[NotifSpec], synced: ?action(str) -> None=None):
        self._driver.declare_notif_subscriptions(owner_id, cb, want, synced)

    def remove_notif_subscriptions(self, owner_id: str):
        self._driver.remove_notif_subscriptions(owner_id)

    def notif_status(self) -> list[NotifChannelStatus]:
        return [NotifChannelStatus(NOTIF_MOCK, None, "main", "active")]

    def inject_notif(self, name: ygdata.Id, payload: ?ygdata.Node=None, stream: ?str=None) -> None:
        """Test hook: deliver an event to every owner whose specs match name
        (and stream, for stream-pinned taps), as if the device had emitted it.
        payload becomes the event's decoded body; raw is a synthesized bare
        element."""
        self._driver.inject_notif(name, payload, stream)

    def set_data(self, tree: ?ygdata.Node) -> None:
        """Test hook: set the device data that get and subscriptions serve."""
        self._driver.set_data(tree)

    proc def requests(self) -> list[str]:
        """Test hook: the last requests, one line each, like
        "get a-top,b-top" or "rpc a-rpc"."""
        return self._driver.get_requests()

    def clear_requests(self) -> None:
        """Test hook: forget the requests so far."""
        self._driver.clear_requests()


def _filter_names(filt: ?ygdata.FNode) -> str:
    """Give the names of the top-level nodes of a filter, sorted, or "*" for
    no filter."""
    if filt is not None:
        name = filt.name
        if name is not None:
            return name.name
        names = []
        for c in filt.children:
            cn = c.name
            if cn is not None:
                names.append(cn.name)
        return ",".join(sorted(names))
    return "*"


actor MockDriver(on_connect: action(dict[str, ModCap], ?SchemaKey) -> None, bundled_schema: DeviceSchema, log_handler: logging.Handler, env: ?Env):
    _log = logging.Logger(log_handler)
    _log.info("MockDriver starting up")

    var dmc: ?DeviceMetaConfig = None
    var modset: dict[str, ModCap] = {}

    var conn_state: int = DISCONNECTED
    var running_conf: ?ygdata.Node = None

    # Test hooks: the device data that get and subscriptions serve, and the
    # last REQUESTS_KEPT requests.
    var data: ?ygdata.Node = None
    var requests: list[str] = []
    REQUESTS_KEPT = 50

    NS_NC_1_0 = "urn:ietf:params:xml:ns:netconf:base:1.0"

    def set_data(tree: ?ygdata.Node) -> None:
        data = tree

    def get_requests() -> list[str]:
        return list(requests)

    def clear_requests() -> None:
        requests = []

    def _record(request: str) -> None:
        requests.append(request)
        if len(requests) > REQUESTS_KEPT:
            del requests[0]

    def _select(filt: ?ygdata.FNode) -> ygdata.Node:
        """The device data that filt selects, an empty tree when it selects
        nothing."""
        d = data
        if d is not None:
            selected = ygdata.filter(d, filt)
            if selected is not None:
                return selected
        return ygdata.Container({})

    # The bundled schema is the device's baseline module inventory; advertise it
    # so enabling mock connects without listing modules by hand. The mock/module
    # extras (folded in per set_dmc) layer on top.
    for ns, meta in bundled_schema.module_inventory().items():
        modset[meta.name] = ModCap(meta.name, ns, meta.revision)

    def set_dmc(new_dmc):
        if dmc is not None and new_dmc is not None:
            old_dmcg = dmc.to_gdata()
            new_dmcg = new_dmc.to_gdata()
            if old_dmcg is not None and new_dmcg is not None:
                if ygdata.diff(old_dmcg, new_dmcg) is None:
                    _log.debug("Device.set_dmc: ignoring new device meta-config identical to current device meta-config")
                    return
        _log.debug("MockAdapter.set_dmc", {"new_dmc": dmc_for_log(new_dmc)})
        dmc = new_dmc

        if len(new_dmc.mock.module) > 0:
            for mock_cap in new_dmc.mock.module:
                m = ModCap(mock_cap.name, mock_cap.namespace, mock_cap.revision, mock_cap.feature)
                _log.debug("Adding mock cap", {"cap": m.name})
                modset[m.name] = m

        if len(modset) > 0:
            _log.debug("Mock capabilities set, \"connecting\"...")
            conn_state = CONNECTED
            running_conf = ygdata.Container()
            # The mock has no fetched schema
            on_connect(modset, None)
        else:
            _log.debug("No mock capabilities set, idling as not connected")

    def configure(done, new_diff, new_conf, running_conf):
        if conn_state == CONNECTED:
            _log.debug("MockAdapter.configure: device 'connected', responding done")
            running_conf = new_conf
            done(None, new_conf)
        else:
            _log.debug("MockAdapter.configure: device not connected")
            done(NotConnectedError(), None)

    def get_capabilities():
        return []

    def get_modules():
        return modset

    def fetch_config(done):
        done(running_conf, None)

    def get_config():
        return running_conf

    def rpc(cb: action(?ygdata.Node, ?Exception) -> None, gdata_rpc: ygdata.Node) -> None:
        _record("rpc " + ",".join(sorted([k.name for k in gdata_rpc.children.keys()])))
        cb(ygdata.Container({}), None)

    def rpc_xml(cb: action(?xml.Node, ?Exception) -> None, xml_rpc: xml.Node) -> None:
        _record("rpc_xml " + xml_rpc.tag)
        # The same answer rpc() gives, written as XML: accepted, nothing returned.
        cb(xml.Node("rpc-reply", [(None, NS_NC_1_0)], children=[xml.Node("ok")]), None)

    def get(cb: action(?ygdata.Node, ?Exception) -> None, filt: ?ygdata.FNode=None) -> None:
        _record("get " + _filter_names(filt))
        cb(_select(filt), None)

    def declare_subscriptions(owner_id: str, cb: action(?ygdata.Node, ?Exception) -> None, want: set[ygdata.SubscriptionSpec], synced: ?action(str) -> None=None) -> None:
        """Deliver the data that the specs select once, then call synced.
        Without data, report that there is no connection, as a device that
        cannot be read."""
        _record("subscribe {owner_id} " + ",".join(sorted([_filter_names(s.filt) for s in want])))
        if data is not None:
            tree: ?ygdata.Node = ygdata.Container({})
            for spec in want:
                tree = ygdata.patch(tree, _select(spec.filt))
            cb(tree, None)
        else:
            cb(None, NotConnectedError())
        if synced is not None:
            synced(owner_id)

    def remove_subscriptions(owner_id: str) -> None:
        _record("unsubscribe {owner_id}")

    var notif_owners: dict[str, NotifOwner] = {}

    def declare_notif_subscriptions(owner_id: str, cb: action(?NotifEvent, ?Exception) -> None, want: set[NotifSpec], synced: ?action(str) -> None=None) -> None:
        names = []
        for spec in want:
            n = spec.name
            names.append(n.name if n is not None else "*")
        _record("notif {owner_id} " + ",".join(sorted(names)))
        notif_owners[owner_id] = NotifOwner(cb, want)
        if synced is not None:
            synced(owner_id)

    def remove_notif_subscriptions(owner_id: str) -> None:
        _record("unnotif {owner_id}")
        if owner_id in notif_owners:
            del notif_owners[owner_id]

    def inject_notif(name: ygdata.Id, payload: ?ygdata.Node=None, stream: ?str=None) -> None:
        raw = xml.Node(name.name, nsdefs=[(None, name.q)])
        ev = NotifEvent(name, yp.event_time_now(), payload, raw)
        for owner in notif_owners.values():
            if notif_want_matches(owner.want, name, stream):
                owner.cb(ev, None)




def _test_notif_spec_identity():
    verify = ygdata.Id("urn:test:events", "verify-event")
    other = ygdata.Id("urn:test:events", "other-event")
    testing.assertEqual(NotifSpec(verify), NotifSpec(ygdata.Id("urn:test:events", "verify-event")))
    testing.assertNotEqual(NotifSpec(verify), NotifSpec(other))
    testing.assertNotEqual(NotifSpec(verify), NotifSpec(verify, stream="snmpevents"))
    testing.assertNotEqual(NotifSpec(), NotifSpec(verify))
    # Value semantics: equal specs collapse in a set.
    testing.assertEqual(len({NotifSpec(verify), NotifSpec(ygdata.Id("urn:test:events", "verify-event")), NotifSpec()}), 2)

def _test_notif_want_matches():
    verify = ygdata.Id("urn:test:events", "verify-event")
    other = ygdata.Id("urn:test:events", "other-event")
    foreign = ygdata.Id("urn:other:ns", "verify-event")
    testing.assertEqual(notif_want_matches({NotifSpec(verify)}, verify), True)
    testing.assertEqual(notif_want_matches({NotifSpec(verify)}, other), False)
    # Same local name in a different module must not match.
    testing.assertEqual(notif_want_matches({NotifSpec(verify)}, foreign), False)
    # Named specs match regardless of which channel the event arrived on.
    testing.assertEqual(notif_want_matches({NotifSpec(verify)}, verify, "snmpevents"), True)
    # A bare wildcard matches everything; a stream-pinned wildcard only takes
    # events that arrived on that stream's channel.
    testing.assertEqual(notif_want_matches({NotifSpec()}, other), True)
    testing.assertEqual(notif_want_matches({NotifSpec()}, other, "snmpevents"), True)
    testing.assertEqual(notif_want_matches({NotifSpec(stream="snmpevents")}, other), False)
    testing.assertEqual(notif_want_matches({NotifSpec(stream="snmpevents")}, other, "snmpevents"), True)
    testing.assertEqual(notif_want_matches({NotifSpec(stream="snmpevents")}, other, "NETCONF"), False)
    testing.assertEqual(notif_want_matches(set(), verify), False)

def _test_parse_cap_base():
    mod = parse_cap("urn:ietf:params:netconf:base:1.1")
    testing.assertEqual(mod.name, "urn:ietf:params:netconf:base:1.1")
    testing.assertEqual(mod.namespace, "urn:ietf:params:netconf:base:1.1")
    testing.assertEqual(mod.revision, None)
    testing.assertEqual(mod.feature, [])

