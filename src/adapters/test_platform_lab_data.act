## cRPD's reply to get-software-information.
CRPD_SOFTWARE_INFORMATION = r"""<rpc-reply xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:junos="http://xml.juniper.net/junos/24.4R0/junos" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0" message-id="urn:uuid:e5b2a332-c3dd-4c56-a414-7a349629d657">
<software-information>
<host-name>crpd</host-name>
<product-model>cRPD</product-model>
<product-name>crpd</product-name>
<os-name>junos</os-name>
<junos-version>24.4R1.9</junos-version>
<package-information>
<name>container package version</name>
<comment>cRPD package version : 24.4R1.9 built by builder on 2024-12-19 08:11:26 UTC</comment>
</package-information>
</software-information>
</rpc-reply>
"""

## cRPD's reply to get-system-information. A cRPD leaves os-version empty and has no serial number.
CRPD_SYSTEM_INFORMATION = r"""<rpc-reply xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:junos="http://xml.juniper.net/junos/24.4R0/junos" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0" message-id="urn:uuid:632cf313-0cb0-4263-a2e3-2e1c792d0648">
<system-information>
<host-name>crpd</host-name>
<hardware-model>cRPD</hardware-model>
<os-name>junos</os-name>
<os-version></os-version>
</system-information>
</rpc-reply>
"""

