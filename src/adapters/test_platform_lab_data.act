## SR OS's reply to the get of /state. Chassis 2 of the extended topology
## has no hardware data.
SROS_STATE = r"""<data>
        <state xmlns="urn:nokia.com:sros:ns:yang:sr:state">
            <chassis>
                <chassis-class>router</chassis-class>
                <chassis-number>1</chassis-number>
                <hardware-data>
                    <serial-number>vSIM</serial-number>
                </hardware-data>
            </chassis>
            <chassis>
                <chassis-class>router</chassis-class>
                <chassis-number>2</chassis-number>
            </chassis>
            <system>
                <platform>7950 XRS-20</platform>
                <version>
                    <version-number>C-23.10.R1</version-number>
                </version>
            </system>
        </state>
    </data>
"""

