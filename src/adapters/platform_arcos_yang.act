"""Pruned ArcOS YANG that the ArcOS platform probe reads.

The namespaces and the node names are the real modules'. ArcOS puts what
'show version' prints in system/version, an augment of openconfig-system. An
ArcOS device type whose schema lacks these modules adds models; one that has
the real modules already must keep the nodes below in them.
"""

oc_system = r"""module openconfig-system {
  yang-version "1";
  namespace "http://openconfig.net/yang/system";
  prefix oc-sys;

  description
    "Pruned to the system container, which ArcOS augments.";

  container system {
  }
}
"""

system_augments = r"""module arcos-openconfig-system-augments {
  yang-version "1.1";
  namespace "http://yang.arrcus.com/arcos/openconfig/system/augments";
  prefix arc-oc-sys-aug;

  import openconfig-system {
    prefix oc-sys;
  }

  description
    "Pruned to the platform, serial number and release that system/version
     reports, as 'show version' does.";

  augment "/oc-sys:system" {
    container version {
      config false;
      container state {
        leaf platform {
          description "The platform, e.g. Virtual for a container.";
          type string;
        }
        leaf serial-number {
          type string;
        }
        leaf sw-version {
          description "The release, e.g. 8.2.1A.P4.";
          type string;
        }
      }
    }
  }
}
"""

## Modules an app adds to its ArcOS device type for the platform probe.
models: list[str] = [
    oc_system,
    system_augments,
]
