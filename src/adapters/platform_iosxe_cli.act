"""IOS XE platform probe over the CLI.

It applies to a device that has the IOS XE CLI adapter, which serves
stratoweave-iosxe-cli. One get reads show version. In PROBES it comes after
the NETCONF probe, so it reads a device only while the device has no
NETCONF, like IOS XE 16.8 on a C1111, where NETCONF does not start. When
NETCONF connects, the NETCONF probe reads the device and its values replace
these.

Both probes give the release as the device banner spells it, 17.15.6 for
17.15.06, so the release does not change when the NETCONF probe takes over.
"""

import yang.gdata as ygdata

import device as swdev
import adapters.iosxe_cli_data as xecli_data
import adapters.iosxe_cli_yang as xecli_yang
import adapters.platform_iosxe as platform_iosxe
import adapters.software_iosxe as swxe
from adapters.adapter import ModCap

NAME = "ios-xe-cli"


def platform_filter() -> ygdata.FNode:
    """Select the output of show version."""
    return ygdata.FNode(children=[ygdata.FNode(ygdata.Id(xecli_yang.NS, "version"))])


def platform(root: ?ygdata.Node) -> ?swdev.Platform:
    """Return the platform in a reply, or None when the reply has neither a
    release nor a model."""
    v = xecli_data.root.from_gdata(root).version
    version = v.version
    model = swdev.nonempty(v.model)
    if version is None and model is None:
        return None
    release: ?str = None
    if version is not None:
        release = swxe.reported_release(version)
    return swdev.Platform(platform_iosxe.OS, release, model, swdev.nonempty(v.serial_number))


class IosXeCliProbe(swdev.GetPlatformProbe):
    """The IOS XE probe over the CLI. One get per read."""
    def __init__(self):
        self.name = NAME
        self.filt = platform_filter()

    def applies(self, modset: dict[str, ModCap]) -> bool:
        return xecli_yang.MODULE in modset

    def parse(self, root: ?ygdata.Node) -> ?swdev.Platform:
        return platform(root)


PROBE = IosXeCliProbe()
