#
# IOS XE hardware adapter tests: the pure side, the inventory filter and the
# chassis model out of a reply. The device side, the model read on connect
# through the NETCONF mock, is in test_software_iosxe.act with the mock device
# harness.
#

import testing
import yang.gdata as ygdata

import adapters.hardware_iosxe as swxehw
import adapters.software_iosxe_mock as swxemock
import adapters.software_iosxe_oper as ixoper

OLD_RELEASE = swxemock.OLD_RELEASE


def _test_inventory_filter_keeps_every_entry():
    """The inventory read must return the whole keyed list and nothing else."""
    root = swxemock.operational_datastore(OLD_RELEASE, [], inventory=[
        swxemock.inventory_entry("hw-type-pim", 1, "C8000V"),
        swxemock.chassis_entry("C8000V"),
    ])
    filt = ygdata.FNode(children=[swxehw.inventory_filter()])
    got = ygdata.filter(root, filt)
    testing.assertTrue(got is not None, "inventory filter returned no data")
    hardware = ixoper.root.from_gdata(got).device_hardware_data.device_hardware
    testing.assertEqual(2, len(hardware.device_inventory),
                        "keyed inventory entries were lost")
    testing.assertEqual(None, hardware.device_system_data.software_version,
                        "filter returned an unrelated subtree")
    testing.assertEqual("C8000V", swxehw.chassis_model(got),
                        "the chassis entry must name the model")


def _test_chassis_model_picks_the_chassis_entry():
    """The model is the chassis part-number, whatever else the list holds."""
    def inventory(entries: list[ygdata.Node]) -> ygdata.Node:
        return swxemock.operational_datastore(OLD_RELEASE, [], inventory=entries)
    testing.assertEqual("C8300-1N1S-4T2X", swxehw.chassis_model(inventory([
        swxemock.inventory_entry("hw-type-pim", 1, "C8300-1N1S-4T2X"),
        swxemock.inventory_entry("hw-type-cpu", 4, " AuthenticAMD"),
        swxemock.chassis_entry("C8300-1N1S-4T2X"),
    ])), "the chassis need not come first")
    testing.assertEqual(None, swxehw.chassis_model(inventory([
        swxemock.inventory_entry("hw-type-pim", 1, "C8000V"),
    ])), "no chassis entry means no model")
    testing.assertEqual(None, swxehw.chassis_model(inventory([
        swxemock.inventory_entry(swxehw.HW_TYPE_CHASSIS, 0, ""),
    ])), "an empty part-number is no model")
    testing.assertEqual(None, swxehw.chassis_model(inventory([])),
                        "an empty inventory means no model")
    testing.assertEqual(None, swxehw.chassis_model(None), "no reply means no model")
