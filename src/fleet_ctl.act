#
# The release decisions of a campaign, now and ahead.
#
# One piece of logic decides which devices start: Controller.step. The
# campaign actor steps the controller on the clock. plan() runs the same
# step ahead of time, from the controller's state and at the expected
# upgrade durations, to say where and when each waiting device starts:
# the plan is the run, ahead of time. The controller runs at the
# smallest concurrency at which that run keeps its promises. It has no
# clock and no I/O: the caller passes the time in.
#

# End of a window that never closes: the year 2100 as seconds since the
# Unix epoch, far beyond any campaign.
OPEN_END = 4102444800

# The default close margin, in percent of a device's slow time.
CLOSE_MARGIN = 150

# How many device names an alarm gives.
ALARM_NAMES = 5

# How many times plan() runs ahead until its promises stop changing.
PLAN_ROUNDS = 3

# Microseconds in a second: the stagger times the starts in them.
MICRO = 1000000

# The weight that need_weights() gives a schedule that needs no slot now.
# While another schedule needs one, the slots are shared without it, and
# it takes only the slots the others leave. Every other weight is below it.
NO_SHARE = 1000000000


def is_final(status: ?str) -> bool:
    """True when the status ends an upgrade attempt."""
    if status == "succeeded" or status == "up-to-date":
        return True
    return is_failure(status)


def is_failure(status: ?str) -> bool:
    """True when the status ends an upgrade attempt that did not
    succeed."""
    return status == "failed" or status == "rolled-back"


def is_answer(status: ?str) -> bool:
    """True when the status answers the campaign's target: the device
    needs the upgrade, or its status is final. No status, unknown and
    in-progress are no answer."""
    if status == "upgrade-needed":
        return True
    return is_final(status)


def names_text(names: list[str]) -> str:
    """The first names of a list, for an alarm."""
    shown = ", ".join(names[:ALARM_NAMES])
    if len(names) > ALARM_NAMES:
        return shown + " and {len(names) - ALARM_NAMES} more"
    return shown


def follow(start: list[(str, str)], later: dict[str, list[str]]) -> dict[str, str]:
    """The devices in start, each given as (device, holder), and every
    device after them through later, each with a holder: the holder of
    the first entry of start that it is, or that it is after."""
    seen: dict[str, str] = {}
    for s in start:
        if s.0 in seen:
            continue
        seen[s.0] = s.1
        todo = [s.0]
        while len(todo) > 0:
            name = todo.pop()
            for d in later.get_def(name, []):
                if d not in seen:
                    seen[d] = s.1
                    todo.append(d)
    return seen


# TODO: upstream: the builtin min and max take one Iterable, so each call
# builds a list; the plan calls these for each device.
def imin(a: int, b: int) -> int:
    """The smaller of a and b."""
    if a < b:
        return a
    return b


def imax(a: int, b: int) -> int:
    """The larger of a and b."""
    if a > b:
        return a
    return b


def earliest(a: int, b: int) -> int:
    """The earlier of the times a and b, where -1 is no time."""
    if a < 0 or (b >= 0 and b < a):
        return b
    return a


# TODO: upstream, as a heapq module in the standard library.
def heap_push[A(Ord)](h: list[A], x: A) -> None:
    """Add x to the binary heap h, smallest first."""
    h.append(x)
    k = len(h) - 1
    while k > 0:
        up = (k - 1) // 2
        if not h[k] < h[up]:
            break
        y = h[k]
        h[k] = h[up]
        h[up] = y
        k = up


def heap_pop[A(Ord)](h: list[A]) -> A:
    """Remove and return the smallest entry of the binary heap h."""
    top = h[0]
    last = h.pop()
    n = len(h)
    if n > 0:
        h[0] = last
        k = 0
        while True:
            m = k
            a = 2 * k + 1
            if a < n and h[a] < h[m]:
                m = a
            if a + 1 < n and h[a + 1] < h[m]:
                m = a + 1
            if m == k:
                break
            y = h[k]
            h[k] = h[m]
            h[m] = y
            k = m
    return top


def pace_samples(target: int) -> int:
    """How many of the last upgrades the observed pace is the mean of:
    target + target // 4."""
    return imax(1, target + target // 4)


def slow_samples(maxc: int) -> int:
    """How many of the last upgrades the slow time is taken from at
    max-concurrency maxc: two rounds, and at least 50."""
    return imax(50, 2 * maxc)


def slow_time(took: list[int], pace: int) -> int:
    """The 98th percentile of the times in took by nearest rank, or pace
    when pace is longer. took is not empty."""
    s = sorted(took)
    return imax(pace, s[(98 * len(s) + 99) // 100 - 1])


def below(level: int, weight: int, k: int) -> int:
    """How many slots a window takes before its next slot would count k or
    more: a slot counts twice the devices in flight before it, plus one,
    times the weight."""
    return imax(0, (k + weight - 1) // weight // 2 - level)


def shares(levels: list[int], weights: list[int], n: int) -> list[int]:
    """Share n slots between windows, given each window's devices in flight
    and its weight of at least 1, in the order the windows open. The slots
    go one at a time, each to the window whose devices in flight plus a
    half, times its weight, are the fewest, the first window on a tie. So
    the devices in flight follow the inverse of the weights, each window's
    share rounded to the nearest slot; the weights are whole numbers, so a
    tie is a tie of those products. Return how many slots each window
    takes."""
    m = len(levels)
    # The largest count k for which the slots that count less than k fit
    # in n. Every slot that counts less is taken, and the slots that count
    # k go to the first windows.
    lo = 0
    hi = 0
    for j in range(m):
        hi = imax(hi, (2 * (levels[j] + n) + 1) * weights[j])
    while lo < hi:
        mid = (lo + hi + 1) // 2
        total = 0
        for j in range(m):
            total += below(levels[j], weights[j], mid)
        if total <= n:
            lo = mid
        else:
            hi = mid - 1
    out = [below(levels[j], weights[j], lo) for j in range(m)]
    rest = n
    for q in out:
        rest -= q
    for j in range(m):
        if rest > 0 and (2 * (levels[j] + out[j]) + 1) * weights[j] == lo:
            out[j] += 1
            rest -= 1
    return out


def window_needs(work: list[int], ends: list[int], t: int, c: int) -> list[int]:
    """What each schedule with an open window needs at time t: the upgrade
    time of its waiting devices that it must start before the first of
    the schedules' last starts, at concurrency c. work gives each
    schedule's waiting upgrade time and ends its last start, in seconds.
    The time after a last start counts for the schedules that can still
    start devices then: from the last of the last starts back to the
    first, the time between two goes to those schedules in proportion to
    the upgrade time they have left, as c devices at once over that time.
    The devices still in flight at a last start are not taken off that
    time."""
    k = len(work)
    by_end = sorted([(imax(t + 1, ends[j]), j) for j in range(k)])
    rest = list(work)
    for q in range(k - 1):
        m = k - 1 - q
        span = by_end[m].0 - by_end[m - 1].0
        if span > 0:
            room = c * span
            total = 0
            for p in range(m, k):
                total += rest[by_end[p].1]
            for p in range(m, k):
                j = by_end[p].1
                if total <= room:
                    rest[j] = 0
                else:
                    # In bigint: the product passes 64 bits beyond about
                    # 3e9 s of waiting upgrade time.
                    rest[j] -= int(bigint(rest[j]) * bigint(room) // bigint(total))
    return rest


def prepare_gap(deadlines: list[int], upto: list[int], lo: int, taken: int, last: int) -> int:
    """The time from the turn last to the next turn, in microseconds: the
    longest at which each member left still has its turn by its deadline.
    deadlines holds the members' deadlines, each once and in order, and
    upto how many members have that deadline or an earlier one. lo is the
    first deadline with members left, and taken is how many members have
    a turn. For each deadline D, the members left with deadline D or
    earlier share the time from last to D. The gap is the smallest of
    those shares, and never below 0."""
    gap = -1
    for j in range(lo, len(deadlines)):
        share = 0
        if deadlines[j] > last:
            share = (deadlines[j] - last) // (upto[j] - taken)
        if gap < 0 or share < gap:
            gap = share
    return imax(0, gap)


def copy_set[A(Hashable)](s: set[A]) -> set[A]:
    out: set[A] = set()
    for x in s:
        out.add(x)
    return out


# A time that is not set: below any time the controller takes.
NO_TIME = -4611686018427387904

# An entry in the heaps of the controller is a time times SCALE, plus a
# device's number or its rank by name.
SCALE = 16777216


class Names(object):
    """The devices that a controller and its copies have state for, each
    with a number: the place of its state in the controller's lists. A
    device keeps its number."""
    num: dict[str, int]
    names: list[str]

    def __init__(self):
        self.num = {}
        self.names = []

    def number(self, name: str) -> int:
        """The number of a device, a new one when it has none."""
        k = self.num.get(name)
        if k is not None:
            return k
        n = len(self.names)
        self.num[name] = n
        self.names.append(name)
        return n


class Plan(object):
    """A run of the controller ahead of time.

    c is the concurrency the run uses. starts gives each waiting device
    that starts the window it starts in, as an index into the
    controller's windows, and the time. held gives each device that is
    held the window promised to it, or else the first window of its
    schedule that has not closed, and the earliest time it could start
    there. why gives each device that is held, also one without a
    window, its reason and its holder as Controller gives them: a device,
    the holder of a veto, or "" for neither. alarms says which promises the run breaks
    and which devices are held."""
    c: int
    starts: dict[str, (int, int)]
    held: dict[str, (int, int)]
    why: dict[str, (str, str)]
    alarms: list[str]

    def __init__(self, c: int, starts: dict[str, (int, int)], held: dict[str, (int, int)],
                 why: dict[str, (str, str)], alarms: list[str]):
        self.c = c
        self.starts = starts
        self.held = held
        self.why = why
        self.alarms = alarms


class Prepares(object):
    """The prepares of a campaign at a time t.

    starts gives the second at which each member prepares: when it was
    let in this run, or, for a member that waits to prepare, the start of
    the debounce slot of its turn, and not before t. c is the most members
    that prepare at once, each from its start for its expected prepare
    time, the prepares that run now included. alarms names the members
    that cannot prepare before their window opens and the members that
    wait for their release and whose prepare failed."""
    starts: dict[str, int]
    c: int
    alarms: list[str]

    def __init__(self, starts: dict[str, int], c: int, alarms: list[str]):
        self.starts = starts
        self.c = c
        self.alarms = alarms


class Step(object):
    """What one decision did.

    started holds the devices to start now. wake is the next time to
    decide if no report comes first, or -1 when only a report can change
    the plan. finished is true when every device is done. plan is
    the plan the decision followed. prepares is the prepares after the
    decision."""
    started: list[str]
    wake: int
    finished: bool
    plan: Plan
    prepares: Prepares

    def __init__(self, started: list[str], wake: int, finished: bool, plan: Plan,
                 prepares: Prepares):
        self.started = started
        self.wake = wake
        self.finished = finished
        self.plan = plan
        self.prepares = prepares


class Run(object):
    """Where and when a run ahead starts each device, by device number:
    the window as an index, or -1 when the run does not start it, and the
    time. moves is how many promises move on in the run."""
    win: list[int]
    at: list[int]
    moves: int

    def __init__(self, win: list[int], at: list[int]):
        self.win = win
        self.at = at
        self.moves = 0


class Controller(object):
    """The release decisions of one campaign.

    configure() takes the windows, the devices and the limits; it can
    come again with new ones during a run. start() begins a run.
    report() takes the latest status of a device and the time it came.
    decide() plans and takes the first step of the plan; plan() only
    plans.

    A device can start in the windows of its schedule. A report counts one
    debounce after it came. A step marks the released devices whose final
    report counts as done at the time of the report, or at the step when
    the report came before the release, and grows the ramp: one device at
    first, and three more for each device that is done without a failure,
    up to the concurrency. So the ramp takes four times as many devices
    each round, but it does not wait for a round to end, and when the
    concurrency rises, the ramp follows it as devices finish. A failed
    upgrade does not grow the ramp. Then it starts waiting devices while
    fewer devices than the ramp are in flight. The schedules with an open
    window share the free slots by what each needs: the expected upgrade
    time of its waiting devices that it must start before the first of
    their last starts. A schedule's last start is the close of its last
    open window less the close margin of its mean waiting device; a window
    that never closes has none. The time after a last start counts for the
    schedules that can still start devices then: from the last of the last
    starts back to the first, the time between two goes to those schedules
    in proportion to the upgrade time they have left, as many devices at
    once as the concurrency. So a schedule with time of its own
    at the end leaves the slots to one whose window closes first, and
    schedules whose windows close together share in proportion to the
    upgrade time waiting in them. When none needs a slot before the first
    last start, they share in that proportion too. Each schedule then has
    its share of the devices in flight, rounded to the nearest slot as
    shares() rounds it, and starts it in its open windows in the order
    they open. A schedule that needs no slot now, or has nothing more to
    start, leaves its slots to the others. With a stagger, a device that
    starts holds the
    next start back by the stagger's percent of its expected upgrade time,
    divided by the concurrency. So as many devices as the concurrency
    start over that part of an upgrade, also when a window opens with room
    for many, and the starts go faster in a larger campaign. At 100 percent
    the starts can go as fast as devices end on average; below it they can
    also catch up when more devices end at once. The stagger does not hold
    a device that reported before its release: it runs no upgrade. But
    while the stagger holds back another start, nothing starts before that
    start's turn. A
    window starts only a device that is ready and
    that has its close margin left before the window closes: its slow
    time times the close margin, one and a half by default. A device that
    has not reported when a fifth of its upgrade has passed since the
    upgrade was expected to end, and its report could have counted, is
    late: it is expected to take one more upgrade from then. Before that,
    a plan expects it to end at the next decision. The next decision is
    when the next report counts, when an upgrade is expected to end and
    its report to count, when a device is late, at the next opening or
    close of a window with devices waiting, or when the stagger lets a
    waiting device start.

    Devices in a redundancy group back each other up, so the members of a
    group upgrade one at a time, lower priority first and equal priorities
    by name. A member may start when the member before it in each of its
    groups is done and the group's min-separation after that has passed,
    and no other member of its groups is in flight or down, or failed in
    a group that the failure holds. A member that may not start yet is looked at again when another member
    of its groups is done, reports a success after a failure, or comes
    back up, and when its min-separation has passed. A member that reports
    a success after a failure is done again at that report. A member that
    is down holds the other waiting members of its groups, and a held
    member holds the members after it in its other groups. A member that
    failed holds the other waiting members of the groups that hold on a
    failure, until an operator acts. In the other groups it holds no one
    once it is done and up again, so the next member starts after the
    group's min-separation; but a member whose rollback failed is in an
    unknown state, and holds all its groups.

    A device is up until set_live() says that it is down. A waiting device
    that is down is held, in a redundancy group or not, and is looked at
    again when it comes back up. Likewise a waiting device with a veto of
    another holder than the campaign, as set_vetoed() says, is held until
    the veto goes. A released device that gets such a veto before its run
    starts, or that stops before its install, waits again. A member that is down while it upgrades
    holds no one and keeps its slot: the plan expects it back up when its
    upgrade ends. The plan gives an alarm for it while it is down after
    its expected end: its release and its expected duration after that.

    A device starts only when its latest report answers the campaign's
    target: it needs the upgrade, or its status is final. A device that
    has not answered is held, also before a run, and it holds the members
    after it in its redundancy groups. It is looked at again when it
    answers. So a plan made before the first run shows what that run would
    do if it started now. After a run, a copy of the controller that starts
    a new run shows what the new run would do.

    A waiting device that reports in-progress during a run still upgrades
    from before the run: a pause or a restart did not stop it. The run
    takes it in flight at once, in the first window of its schedule that
    has not closed, so it holds a slot and its redundancy groups until it
    is done. resumed has it: the campaign keeps holding it, so it stops if
    it has not reached its install, and its upgrade gives no pace sample.
    When it reports upgrade-needed, it stopped before its install, and it
    waits again.

    drop() forgets the devices that left the campaign. A device that
    joins again is then a new member: it waits until it answers, and
    starts in a window.

    A held device keeps the window promised to it, and the plan gives an
    alarm for it. When that window closes while the device is held, its
    promise moves to the next window of its schedule, and the plan gives
    an alarm for it until it starts. A held device without a promise gets
    none while it is held: the plan shows it in the first window of its
    schedule that has not closed, and other devices can take that window.

    A held device has one reason, the first of these that applies to it,
    and a holder: the device that holds it, when another device does, or
    the holder of the veto that holds it. When several hold it, the holder
    is one of them.

    - down: it is down.
    - not-answered: it has not answered the campaign's target.
    - vetoed: it has a veto of another holder than the campaign.
    - group-failed: it waits behind a member that failed, in a group that
      the failure holds.
    - group-down: it waits behind a member that is down.
    - group-not-answered: it waits behind a member that has not answered.
    - group-vetoed: it waits behind a member that has such a veto.
    - failure-budget: more members have failed than the failure budget.

    A member has failed while its latest report is a failure. With a
    failure budget, no device starts while more members have failed than
    the budget. The devices in flight finish. The waiting devices are
    held, the plan gives an alarm, and no member is let prepare. A member
    that reports a success after its failure, or leaves the campaign, no
    longer counts.

    The observed pace is kept at the scale of the campaign's estimate: an
    upgrade that took twice its device's estimate counts as twice the
    campaign's estimate, and each device's expected duration is its
    estimate at that pace. The pace is the mean time of the last upgrades:
    a round at target-concurrency and a quarter of a round. So at a target
    of several devices one upgrade far from the others moves the pace
    little, a change that every upgrade shows is mostly in the pace after
    one round, and the order in which the upgrades of a round end does not
    make the pace swing. A run
    starts as if the last upgrades took the pace it starts from. An
    upgrade that ends when it was expected to leaves the pace as it is,
    and so does a device that reported before its release: it ran no
    upgrade.

    The slow time is the 98th percentile of the times of the last
    upgrades, two rounds at max-concurrency and at least 50, or the pace
    when the pace is longer. A device's slow time is its estimate at that
    slow time. So the margin a window keeps before its close grows when
    slow upgrades show, and one upgrade far longer than the others moves
    it only through the pace. The fast upgrades of a round that end
    together do not push the slow ones of the round before out of view,
    and the slow time does not depend on the concurrency, so a plan gains
    nothing by a higher one.

    A plan runs the step ahead, from the current state, every upgrade
    ending when it is expected to, until nothing more starts. During a
    run, the controller promises each waiting device the window that the
    plan starts it in, in the order of those starts. A window starts the
    devices promised to it first, in the order of the promises, then the
    others in their order. A device that misses its window keeps its
    place in that order and is promised the next window of its schedule.
    The plan runs at
    target-concurrency, or else at the smallest concurrency up to
    max-concurrency that breaks no more promises than max-concurrency
    does, counting each window a device misses, and, with a deadline,
    leaves no more devices without a start before it. During a run the
    concurrency only rises until the limits change. The promises a plan
    breaks are its alarms.

    A plan places the members of a spread group in windows as far apart
    as the windows its run ahead uses allow. When it promises windows, a
    later member of the group takes the promise of a device in a later
    window that has the same estimate and is in no group, and that device
    takes the member's promise. In each of the member's groups, that
    window must open after each member before it ends and that group's
    min-separation has passed, and must close, with that min-separation
    after it, before the window of each member after it opens. A member
    ends when it was done, when its upgrade is expected to end, or else
    when the window promised to it closes. The plan keeps the swaps only
    when the run ahead with them breaks no more promises and leaves no
    more devices without a start. A promise made before does not move.
    The members of a pack group, and the members of a spread group in one
    window, go one after the other.

    When every upgrade takes its expected time, a run whose plan has no
    alarm starts every device where and when the plan said. When its only
    alarms are for held devices, the run starts every other device so,
    while the held devices stay held. A plan holds one concurrency for the
    whole run ahead; when it breaks promises, a later decision can find
    that rising then keeps some of them, and the run follows that later
    plan.

    With prepare on, a run lets members prepare: copy their image before
    their window, once per run. A member waits to prepare while it is not
    released, it is up, its latest report says that it needs the upgrade,
    it has a promise, it was not let prepare in this run, it reports no
    prepare, and it has a deadline. Its deadline is the opening of the
    first window of its schedule that has not closed, less the close
    margin of its expected prepare time. It has none while that window is open, or when
    its schedule has no window in view. A member whose deadline has passed
    cannot prepare in time, and the prepares give an alarm for it. The
    waiting members take turns: by deadline, then in the order of their
    promises, then in the campaign's order. The first turn is now, or one
    gap after the last turn. Each gap is as long as it can be while every
    member left has its turn by its deadline. So the turns are as far
    apart as the deadlines allow, and they cover the whole time to the
    last deadline. A turn depends only on the last turn and the members
    left. A decision lets each member whose turn is before the end of the
    decision's debounce slot, and wakes at the slot of the next turn: the
    members whose turns are in one slot start together. So when nothing
    comes in, each member is let at the time that prepares() showed. When a decision comes after a turn's slot, it lets
    one member now and spreads the rest from now. A member stops being let
    when its prepare is done or failed, it is released, its latest report
    no longer says that it needs the upgrade, it leaves the campaign, a
    window of its schedule opens, prepare goes off, the run stops, or more
    members have failed than the failure budget.
    Prepares change no release decision: step(), plan() and the quiet time
    read nothing of them."""
    # Configuration.
    # The windows: schedule, start, end, by start. They include the
    # windows that released devices were released in, also when the
    # schedules no longer give them; such a window takes no new devices.
    windows: list[(str, int, int)]
    index: dict[(str, int, int), int]
    # The devices as configure() took them, in the order they start, and
    # their estimates and schedules.
    devices: list[(str, int, str)]
    order: list[str]
    est: dict[str, int]
    schedule_of: dict[str, str]
    # The windows the schedules give.
    current: list[(str, int, int)]
    # The redundancy groups: each group's members, campaign or not; each
    # device's priority; and per group whether it spreads and its
    # min-separation in seconds.
    groups: dict[str, list[str]]
    priority: dict[str, int]
    separation: dict[str, (bool, int)]
    # The groups whose members wait for an operator while a member is
    # failed.
    hold_failed: set[str]
    # Per campaign device: the member right before it in each of its
    # groups, with the group. Per device: its groups of two or more
    # members. Whether any group of two or more campaign devices spreads.
    before: dict[str, list[(str, str)]]
    groups_of: dict[str, list[str]]
    spreads: bool
    target: int
    maxc: int
    # True when every device must start in a window: a deadline that the
    # windows show in full.
    must_place: bool
    debounce: int
    # The campaign's estimated duration: the scale of observed_s.
    estimate_s: int
    # How much of its slow time a device must have left before a window
    # closes to start there, in percent.
    close_margin: int
    # The time over which as many devices as the concurrency start, in
    # percent of the expected upgrade time; 0 starts them at once.
    stagger: int
    # Whether the members may prepare their image before their window, and
    # each member's expected prepare time, in seconds.
    prepare: bool
    prepare_est: dict[str, int]
    # The most members that may fail, or -1 for no limit.
    failure_budget: int

    # Each device that the controller has state for has a number: the
    # place of its state in the lists below. size is how many devices
    # those lists hold. A copy shares the numbers. Per number, the
    # device's rank by name among the devices with a number; per rank, the
    # number. A device numbered after the last ranking has no rank yet.
    names: Names
    size: int
    rank: list[int]
    by_rank: list[int]
    # -1 per device number, to copy.
    unset: list[int]

    # Derived from the configuration and the state by rebuild().
    # Per device number: whether the device is in the campaign; its
    # estimate, or the campaign's estimate when it is not; the windows it
    # can start in, by start; and whether it is in a redundancy group of
    # two or more devices. A number beyond these lists is a device that is
    # not in the campaign. The numbers of the campaign's devices, in order.
    member: list[bool]
    est_of: list[int]
    wins: list[list[int]]
    grouped: list[bool]
    order_n: list[int]
    # Per window: the devices that can start in it, in order and by
    # estimate; the devices promised to it, in the order of the promises;
    # and each with the place where the devices not looked at yet begin. A
    # device that did not fit is looked at again when the slow time falls.
    queue: list[list[int]]
    by_est: list[list[int]]
    pqueue: list[list[int]]
    qcur: list[int]
    ecur: list[int]
    pcur: list[int]
    # Per window: the place of its schedule in waiting and waiting_est, or
    # -1 when the schedules do not give it. Per schedule with a window: how
    # many of its devices wait, and their estimates in total. The windows of
    # a schedule have the same waiting devices.
    sched_at: list[int]
    waiting: list[int]
    waiting_est: list[int]
    # Per window: the place of its schedule among the schedules of the
    # windows; whether the schedules give it; and whether its promises
    # have moved on since it closed or the schedules stopped giving it.
    wsched: list[int]
    is_current: list[bool]
    moved: list[bool]
    # The devices a window passed while they waited for their groups; per
    # window the devices to look at again, each once, and those pairs as
    # retry_key(); and the devices that wait for their min-separation to
    # pass, by the time it passes, as entry(): by time, then by name.
    parked: set[int]
    retry: list[list[int]]
    retrying: set[int]
    timed: list[int]
    # How many devices of the campaign are done.
    devices_done: int

    # State.
    running: bool
    # Per device number: the time of its final report, NO_TIME without
    # one, and that report's final status, "" without one.
    final_at: list[int]
    final_status: list[str]
    # Per device number: whether its latest report answers the campaign's
    # target.
    answered: list[bool]
    # Per device number: whether its latest report is a failure. How many
    # devices of the campaign have one.
    failing: list[bool]
    failures: int
    # The latest prepare state each member reports for the campaign's
    # target: running, done or failed. It outlives a run, as final_at does.
    prepare_state: dict[str, str]
    # The members let prepare in this run, with the second they were let,
    # and the members let prepare now.
    prepare_at: dict[str, int]
    allowed: set[str]
    # The turn of the last member let prepare, in microseconds; -1 when no
    # member was let since the last turns ended.
    prep_last: int
    # Per device number: the time the first of its latest in-progress
    # reports came, NO_TIME when its latest report is not in-progress.
    progress: list[int]
    # Per device number: whether it is a released device that a run took in
    # flight because it still upgraded from before the run.
    resumed: list[bool]
    # Per device number: whether it is done and its upgrade failed or
    # rolled back; whether its latest final report is a failed rollback,
    # which only a later final report, a retry or a removal clears, also
    # when the report is lost or a run starts; and whether it is known
    # down; downs counts those.
    failed: list[bool]
    rollback_failed: list[bool]
    down: list[bool]
    downs: int
    # Per device number: the holder of a veto of another holder than the
    # campaign that holds its install, or "".
    vetoed: list[str]
    # Per device number: whether it is a released device that is not done
    # and has a final status: a step marks it done once its report counts.
    reported: list[bool]
    # The devices that reported by when their report came, as entry(): by
    # time, then by name. An entry is stale once its device has not
    # reported or its report came at another time.
    reports: list[int]
    # Per device number: whether it is a released device whose final report
    # came before its release: it ran no upgrade.
    no_upgrade: list[bool]
    # Per device number: whether it is released; when, in which window, as
    # an index into windows, and at which estimate; and when its upgrade is
    # expected to end.
    released: list[bool]
    released_at: list[int]
    released_in: list[int]
    released_est: list[int]
    due: list[int]
    # Per device number: whether it is a device of the campaign in flight;
    # flights counts them. Per schedule, at its place in wsched: how many of
    # them were released in its windows.
    flying: list[bool]
    flights: int
    in_flight: list[int]
    # The devices in flight without a report, by when their upgrade is
    # expected to end: a heap of due_key(). An entry is stale once its
    # device reported, is done, or is due at another time. The devices
    # that left the heap because their report would have counted by now.
    dues: list[int]
    overdue: set[int]
    # Per device number: when it was done, NO_TIME when it is not.
    done_at: list[int]
    # Per device number: the window promised to it during a run while it
    # waits, as an index into windows, or -1; and the order of the promises.
    promised: list[int]
    promise_seq: list[int]
    seq: int
    # The waiting members whose promised window closed while they were
    # held, until they start.
    lost_promises: set[int]
    # How many promises moved on, or ended with no window left: a run
    # ahead counts its own.
    moves: int
    # The last slow_samples(maxc) upgrades' times, at the scale of the
    # campaign's estimate, the place of the next one, and the sum of the
    # last pace_samples() of them. The observed pace is their mean, and
    # the slow time is taken from all of them.
    took_s: list[int]
    took_at: int
    took_sum: int
    observed_s: int
    slow_s: int
    # How many devices the ramp lets be in flight.
    rung: int
    c: int
    # When the last device started, in microseconds, -1 before the first,
    # and its estimate. The stagger lets the next device start a gap after
    # it. held is true when the last step had slots free and a device that
    # the stagger held.
    last_start: int
    last_est: int
    held: bool
    # The last plan when a decision can take it again: made during a run,
    # with its promises settled and no alarm other than for held devices.
    # From the step at quiet_from until quiet_until the run ahead only
    # starts devices; anything that comes in ends that time.
    last_plan: ?Plan
    quiet_from: int
    quiet_until: int
    # The members in flight without a report that are down, by the first
    # second in which they are past their expected end, as due_key() is by
    # the due time. An entry is stale once its device is up, has reported
    # or is done. The wake of the last decision, -1 for none.
    down_ends: list[int]
    wake_at: int

    def __init__(self):
        self.windows = []
        self.index = {}
        self.devices = []
        self.order = []
        self.est = {}
        self.schedule_of = {}
        self.current = []
        self.groups = {}
        self.priority = {}
        self.separation = {}
        self.hold_failed = set()
        self.before = {}
        self.groups_of = {}
        self.spreads = False
        self.target = 1
        self.maxc = 1
        self.must_place = False
        self.debounce = 0
        self.close_margin = CLOSE_MARGIN
        self.stagger = 0
        self.prepare = False
        self.prepare_est = {}
        self.failure_budget = -1
        self.estimate_s = 1
        self.names = Names()
        self.size = 0
        self.rank = []
        self.by_rank = []
        self.unset = []
        self.member = []
        self.est_of = []
        self.wins = []
        self.grouped = []
        self.order_n = []
        self.queue = []
        self.by_est = []
        self.pqueue = []
        self.qcur = []
        self.ecur = []
        self.pcur = []
        self.sched_at = []
        self.waiting = []
        self.waiting_est = []
        self.wsched = []
        self.is_current = []
        self.moved = []
        self.parked = set()
        self.retry = []
        self.retrying = set()
        self.timed = []
        self.devices_done = 0
        self.running = False
        self.final_at = []
        self.final_status = []
        self.answered = []
        self.failing = []
        self.failures = 0
        self.prepare_state = {}
        self.prepare_at = {}
        self.allowed = set()
        self.prep_last = -1
        self.progress = []
        self.resumed = []
        self.failed = []
        self.rollback_failed = []
        self.vetoed = []
        self.down = []
        self.downs = 0
        self.reported = []
        self.reports = []
        self.no_upgrade = []
        self.released = []
        self.released_at = []
        self.released_in = []
        self.released_est = []
        self.due = []
        self.flying = []
        self.flights = 0
        self.in_flight = []
        self.dues = []
        self.overdue = set()
        self.done_at = []
        self.promised = []
        self.promise_seq = []
        self.seq = 0
        self.lost_promises = set()
        self.moves = 0
        self.observed_s = 1
        self.took_s = [1]
        self.took_at = 0
        self.took_sum = 1
        self.slow_s = 1
        self.rung = 1
        self.c = 1
        self.last_start = -1
        self.last_est = 0
        self.held = False
        self.last_plan = None
        self.quiet_from = 0
        self.quiet_until = 0
        self.down_ends = []
        self.wake_at = -1

    def grow(self, n: int) -> None:
        """Make room in the per-device state lists for the devices with a
        number below n, each with no state."""
        while self.size < n:
            self.final_at.append(NO_TIME)
            self.final_status.append("")
            self.answered.append(False)
            self.failing.append(False)
            self.progress.append(NO_TIME)
            self.resumed.append(False)
            self.failed.append(False)
            self.rollback_failed.append(False)
            self.vetoed.append("")
            self.down.append(False)
            self.reported.append(False)
            self.no_upgrade.append(False)
            self.released.append(False)
            self.released_at.append(0)
            self.released_in.append(-1)
            self.released_est.append(0)
            self.due.append(0)
            self.flying.append(False)
            self.done_at.append(NO_TIME)
            self.promised.append(-1)
            self.promise_seq.append(0)
            self.unset.append(-1)
            self.size += 1

    def number(self, name: str) -> int:
        """The number of a device, with room for its state."""
        k = self.names.number(name)
        if k >= self.size:
            self.grow(k + 1)
        return k

    def known(self, name: str) -> int:
        """The number of a device that the controller may have state for,
        or -1 when it has none."""
        k = self.names.num.get(name)
        if k is not None and k < self.size:
            return k
        return -1

    def entry(self, at: int, k: int) -> int:
        """The heap entry of the device with number k at time at, which
        orders by time, then by name."""
        if k >= len(self.rank):
            self.rerank()
        return at * SCALE + self.rank[k]

    def entry_device(self, e: int) -> int:
        """The number of the device of the heap entry e."""
        return self.by_rank[e % SCALE]

    def rerank(self) -> None:
        """Rank every device with a number by name, and give the entries in
        reports and timed the new ranks."""
        old = self.by_rank
        order = sorted([(self.name_of(k), k) for k in range(self.size)])
        by_rank = [e.1 for e in order]
        rank = [0 for _k in range(self.size)]
        for r in range(len(by_rank)):
            rank[by_rank[r]] = r
        # A sorted list is a heap.
        self.reports = sorted([e // SCALE * SCALE + rank[old[e % SCALE]] for e in self.reports])
        self.timed = sorted([e // SCALE * SCALE + rank[old[e % SCALE]] for e in self.timed])
        self.rank = rank
        self.by_rank = by_rank

    def name_of(self, k: int) -> str:
        """The name of the device with number k."""
        return self.names.names[k]

    def is_member(self, k: int) -> bool:
        """True when the device with number k is in the campaign."""
        return k >= 0 and k < len(self.member) and self.member[k]

    def est_n(self, k: int) -> int:
        """The estimate of the device with number k: the campaign's
        estimate when it is not in the campaign."""
        if k >= 0 and k < len(self.est_of):
            return self.est_of[k]
        return self.estimate_s

    def wins_of(self, k: int) -> list[int]:
        """The windows the device with number k can start in, by start; none
        for -1."""
        if k >= 0 and k < len(self.wins):
            return self.wins[k]
        return []

    def in_group(self, k: int) -> bool:
        """True when the device with number k is in a redundancy group of
        two or more devices."""
        if k < len(self.grouped):
            return self.grouped[k]
        return self.name_of(k) in self.groups_of

    def configure(self, windows: list[(str, int, int)], devices: list[(str, int, str)],
                  target: int, maxc: int, must_place: bool, debounce: int,
                  estimate_s: int, groups: dict[str, list[str]]={},
                  priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
                  close_margin: int=CLOSE_MARGIN, stagger: int=0, prepare: bool=False,
                  prepare_est: dict[str, int]={}, failure_budget: int=-1,
                  hold_failed: ?set[str]=None) -> None:
        """Take the windows the schedules give, the devices as (name,
        estimated duration, schedule) in the order they start, the target
        and the max concurrency, whether every device must start in a
        window, the debounce in seconds, the campaign's estimated
        duration, the redundancy groups of the devices as their members,
        the priority of each device, per group whether it spreads and its
        min-separation in seconds, the close margin in percent of the slow
        time, the stagger in percent of the expected upgrade time, whether
        the members may prepare, each member's expected prepare time in
        seconds, the most members that may fail, below 0 for no limit, and
        the groups that hold on a failure, none when None. A group without
        a separation packs with none. New limits
        start the concurrency over at the target, and the ramp at most at
        the target. New limits keep the last upgrade times, and the pace
        and the slow time are taken from them again. Prepare and the
        prepare times change no release decision. When prepare goes off,
        no member is let prepare any more."""
        self.prepare_est = prepare_est
        if prepare != self.prepare:
            self.prepare = prepare
            if not prepare:
                self.allowed = set()
                self.prep_last = -1
        m = imax(target, maxc)
        e = imax(1, estimate_s)
        margin = imax(100, close_margin)
        st = imax(0, stagger)
        budget = imax(-1, failure_budget)
        hold: set[str] = hold_failed if hold_failed is not None else set()
        same_groups = False
        if groups == self.groups and priority == self.priority and separation == self.separation \
           and hold == self.hold_failed:
            same_groups = True
        if windows == self.current and devices == self.devices and target == self.target \
           and m == self.maxc and must_place == self.must_place \
           and debounce == self.debounce and e == self.estimate_s and same_groups \
           and margin == self.close_margin and st == self.stagger \
           and budget == self.failure_budget:
            return
        self.quiet_until = 0
        self.failure_budget = budget
        retarget = target != self.target
        if retarget or m != self.maxc:
            self.c = target
            self.rung = imin(self.rung, target)
        if e != self.estimate_s:
            # Keep the observed pace at the scale of the new estimate.
            for k in range(len(self.took_s)):
                self.took_s[k] = imax(1, self.took_s[k] * e // self.estimate_s)
            self.took_sum = self.pace_sum()
            self.observed_s = imax(1, self.took_sum // self.pace_count())
            self.take_slow()
            self.estimate_s = e
        self.stagger = st
        self.current = windows
        self.devices = devices
        self.order = [d.0 for d in devices]
        est: dict[str, int] = {}
        schedule_of: dict[str, str] = {}
        for d in devices:
            est[d.0] = imax(1, d.1)
            schedule_of[d.0] = d.2
            self.number(d.0)
        self.est = est
        self.schedule_of = schedule_of
        self.groups = groups
        self.priority = priority
        self.separation = separation
        self.hold_failed = hold
        self.target = target
        self.maxc = m
        self.must_place = must_place
        self.debounce = debounce
        self.close_margin = margin
        if retarget or len(self.took_s) != slow_samples(m):
            self.keep_times(slow_samples(m))
        self.rebuild()

    def start(self, rung: int=1, observed_s: ?int=None) -> None:
        """Begin a run: nothing is released or promised, the observed
        pace is observed_s or else the campaign's estimate, the ramp is at
        rung devices, the concurrency at the target, and a device may start
        now. No member is let prepare yet, and the first turn to prepare is
        now. The reports, the answers and the prepare states among them,
        and the configuration stay. The run takes in flight each device
        that still reports in-progress (take_running)."""
        self.running = True
        self.prepare_at = {}
        self.allowed = set()
        self.prep_last = -1
        n = self.size
        self.released = [False for _k in range(n)]
        self.released_at = [0 for _k in range(n)]
        self.released_in = [-1 for _k in range(n)]
        self.released_est = [0 for _k in range(n)]
        self.due = [0 for _k in range(n)]
        self.done_at = [NO_TIME for _k in range(n)]
        self.reported = [False for _k in range(n)]
        self.reports = []
        self.no_upgrade = [False for _k in range(n)]
        self.resumed = [False for _k in range(n)]
        self.failed = [False for _k in range(n)]
        self.promised = [-1 for _k in range(n)]
        self.promise_seq = [0 for _k in range(n)]
        self.lost_promises = set()
        self.set_pace(imax(1, observed_s) if observed_s is not None else self.estimate_s)
        self.rung = rung
        self.c = self.target
        self.last_start = -1
        self.held = False
        self.quiet_until = 0
        self.rebuild()
        for k in self.order_n:
            at = self.progress[k]
            if at != NO_TIME:
                self.take_running(k, at)

    def set_pace(self, pace: int) -> None:
        """Set the observed pace and the slow time to pace, as if each of
        the last upgrades took that time."""
        self.took_s = [pace for _k in range(slow_samples(self.maxc))]
        self.took_at = 0
        self.took_sum = pace * self.pace_count()
        self.observed_s = pace
        self.slow_s = pace

    def keep_times(self, n: int) -> None:
        """Keep the newest n upgrade times, older places taking the pace
        when fewer are kept, and take the pace and the slow time from them
        again."""
        m = len(self.took_s)
        # Oldest first: the next place to write holds the oldest time.
        times = [self.took_s[(self.took_at + j) % m] for j in range(m)]
        if n <= m:
            self.took_s = times[m - n:]
        else:
            self.took_s = [self.observed_s for _k in range(n - m)] + times
        self.took_at = 0
        self.took_sum = self.pace_sum()
        self.observed_s = imax(1, self.took_sum // self.pace_count())
        self.take_slow()

    def take_slow(self) -> None:
        """Take the slow time from the kept upgrade times."""
        self.slow_s = slow_time(self.took_s, self.observed_s)

    def pace_count(self) -> int:
        """How many of the kept upgrade times the pace is the mean of."""
        return imin(len(self.took_s), pace_samples(self.target))

    def pace_sum(self) -> int:
        """The sum of the last pace_count() upgrade times."""
        n = len(self.took_s)
        total = 0
        for j in range(self.pace_count()):
            total += self.took_s[(self.took_at - 1 - j + n) % n]
        return total

    def stop(self) -> None:
        """End the run: no promises are kept, and no member is let prepare.
        The released devices stay released."""
        self.running = False
        self.allowed = set()
        self.promised = [-1 for _k in range(self.size)]
        self.promise_seq = [0 for _k in range(self.size)]
        self.lost_promises = set()
        self.quiet_until = 0
        self.rebuild()

    def resume(self, name: str, at: int, win: (str, int, int)) -> None:
        """Take a device that was released at time at, in the window win,
        before the first step of the run. It holds its slot until it is
        done."""
        i = self.index.get(win)
        if i is not None:
            k = self.number(name)
            self.release(k, at, i)
            self.lost_promises.discard(k)
            self.quiet_until = 0

    def take_running(self, k: int, at: int) -> None:
        """Take in flight the waiting device with number k, which reported
        in-progress at time at: it still upgrades from before the run. It is
        released at at in the first window of its schedule that had not
        closed then, and holds its slot and its redundancy groups until it
        is done. A device whose schedule has no such window stays held."""
        for j in self.wins_of(k):
            if at < self.windows[j].2:
                self.release(k, at, j)
                self.resumed[k] = True
                self.lost_promises.discard(k)
                self.quiet_until = 0
                return

    def take_back(self, k: int) -> None:
        """The released device with number k stopped before its install, or
        has a veto of another holder and has not started its run: it waits
        again, as if it had not been released."""
        self.resumed[k] = False
        self.released[k] = False
        self.released_at[k] = 0
        self.released_in[k] = -1
        self.released_est[k] = 0
        self.due[k] = 0
        self.reported[k] = False
        self.no_upgrade[k] = False
        self.quiet_until = 0
        self.rebuild()

    def drop(self, names: set[str]) -> None:
        """Forget all that the run knows of the devices in names, which left
        the campaign: their release, their reports and answers, their
        prepares, and whether they are done or failed. A device that joins
        the campaign again is then a new member: it waits until it answers,
        and starts in a window. configure() alone keeps this for a device
        that leaves, so that its report still counts."""
        if len(names) == 0:
            return
        for name in names:
            self.prepare_state.pop(name)
            self.prepare_at.pop(name)
            self.allowed.discard(name)
            k = self.known(name)
            if k < 0:
                continue
            self.released[k] = False
            self.released_at[k] = 0
            self.released_in[k] = -1
            self.released_est[k] = 0
            self.due[k] = 0
            self.done_at[k] = NO_TIME
            self.final_at[k] = NO_TIME
            self.final_status[k] = ""
            self.progress[k] = NO_TIME
            self.promised[k] = -1
            self.promise_seq[k] = 0
            self.lost_promises.discard(k)
            self.answered[k] = False
            self.failing[k] = False
            self.resumed[k] = False
            self.failed[k] = False
            self.rollback_failed[k] = False
            self.reported[k] = False
            self.no_upgrade[k] = False
            self.overdue.discard(k)
        self.quiet_until = 0
        self.rebuild()

    def rebuild(self) -> None:
        """Derive the windows, queues and counts from the configuration
        and the state."""
        if len(self.rank) < self.size:
            self.rerank()
        old = self.windows
        current: set[(str, int, int)] = set()
        keys: set[(str, int, int)] = set()
        for w in self.current:
            current.add(w)
            keys.add(w)
        for k in range(self.size):
            if self.released[k]:
                keys.add(old[self.released_in[k]])
        for k in range(self.size):
            p = self.promised[k]
            if p >= 0 and not self.released[k]:
                w = old[p]
                if w not in current and w.0 == self.schedule_of.get_def(self.name_of(k), ""):
                    keys.add(w)
        windows = [(k.1, k.0, k.2) for k in sorted([(w.1, w.0, w.2) for w in keys])]
        index: dict[(str, int, int), int] = {}
        queue: list[list[int]] = []
        sched_at: list[int] = []
        waiting: list[int] = []
        waiting_est: list[int] = []
        by_schedule: dict[str, list[int]] = {}
        place: dict[str, int] = {}
        for i in range(len(windows)):
            w = windows[i]
            index[w] = i
            queue.append([])
            if w in current:
                if w.0 not in by_schedule:
                    by_schedule[w.0] = []
                    place[w.0] = len(waiting)
                    waiting.append(0)
                    waiting_est.append(0)
                by_schedule[w.0].append(i)
                sched_at.append(place[w.0])
            else:
                sched_at.append(-1)
        # Each released device keeps its window, at its new index.
        for k in range(self.size):
            if self.released[k]:
                self.released_in[k] = index[old[self.released_in[k]]]
        n = self.size
        member = [False for _k in range(n)]
        est_of = [self.estimate_s for _k in range(n)]
        wins: list[list[int]] = [[] for _k in range(n)]
        grouped = [False for _k in range(n)]
        order_n: list[int] = []
        promised = [-1 for _k in range(n)]
        by_promise: list[list[(int, str, int)]] = [[] for _w in windows]
        for name in self.order:
            k = self.names.num[name]
            order_n.append(k)
            member[k] = True
            est_of[k] = self.est[name]
            ws = by_schedule.get_def(self.schedule_of[name], [])
            wins[k] = ws
            if len(ws) > 0:
                # The windows of a schedule share one queue.
                queue[ws[0]].append(k)
            if len(ws) > 0 and not self.released[k]:
                q = sched_at[ws[0]]
                waiting[q] += 1
                waiting_est[q] += self.est[name]
            # A promise holds to a window of the device's schedule; one to
            # a window the schedules no longer give moves on at the next
            # step.
            p = self.promised[k]
            if p >= 0 and not self.released[k] and old[p].0 == self.schedule_of[name]:
                i = index[old[p]]
                promised[k] = i
                by_promise[i].append((self.promise_seq[k], name, k))
        # Each group's campaign devices in order: priority, then name.
        before: dict[str, list[(str, str)]] = {}
        groups_of: dict[str, list[str]] = {}
        spreads = False
        for g, members in self.groups.items():
            ordered = sorted([(self.priority.get_def(m, 0), m) for m in members if m in self.est])
            if self.separation.get_def(g, (False, 0)).0 and len(ordered) > 1:
                spreads = True
            for j in range(1, len(ordered)):
                name = ordered[j].1
                if name not in before:
                    before[name] = []
                before[name].append((ordered[j - 1].1, g))
            if len(members) > 1:
                for m in members:
                    if m not in groups_of:
                        groups_of[m] = []
                    groups_of[m].append(g)
        for name in groups_of.keys():
            k = self.known(name)
            if k >= 0:
                grouped[k] = True
        scheds: dict[str, int] = {}
        wsched: list[int] = []
        for w in windows:
            if w.0 not in scheds:
                scheds[w.0] = len(scheds)
            wsched.append(scheds[w.0])
        flying = [False for _k in range(n)]
        flights = 0
        in_flight = [0 for _s in scheds]
        devices_done = 0
        failures = 0
        for k in range(n):
            if member[k] and self.failing[k]:
                failures += 1
            if self.released[k] and member[k]:
                if self.done_at[k] != NO_TIME:
                    devices_done += 1
                else:
                    flying[k] = True
                    flights += 1
                    in_flight[wsched[self.released_in[k]]] += 1
        self.windows = windows
        self.index = index
        self.member = member
        self.est_of = est_of
        self.wins = wins
        self.grouped = grouped
        self.order_n = order_n
        self.queue = queue
        by_est: list[list[int]] = [[] for _w in windows]
        for ws in by_schedule.values():
            q = queue[ws[0]]
            e_q = [e.2 for e in sorted([(est_of[k], self.name_of(k), k) for k in q])]
            for i in ws:
                queue[i] = q
                by_est[i] = e_q
        self.by_est = by_est
        self.pqueue = [[e.2 for e in sorted(b)] for b in by_promise]
        self.qcur = [0 for _w in windows]
        self.ecur = [0 for _w in windows]
        self.pcur = [0 for _w in windows]
        self.sched_at = sched_at
        self.waiting = waiting
        self.waiting_est = waiting_est
        self.wsched = wsched
        self.is_current = [w in current for w in windows]
        self.moved = [False for _w in windows]
        self.parked = set()
        self.retry = [[] for _w in windows]
        self.retrying = set()
        self.timed = []
        self.before = before
        self.groups_of = groups_of
        self.spreads = spreads
        self.promised = promised
        self.flying = flying
        self.flights = flights
        self.in_flight = in_flight
        self.dues = sorted([self.due_key(k) for k in range(n)
                            if flying[k] and not self.reported[k]])
        self.overdue = set()
        self.devices_done = devices_done
        self.failures = failures

    def report(self, name: str, status: ?str, at: int, rollback_failed: bool=False) -> None:
        """Take the latest status of a device, which came at time at, and
        whether a failed status ended in a failed rollback. A final report
        after another final report keeps the time of the first. A failed
        device that reports a success is done again at that time, and no
        longer holds the other members of its groups. The
        device has answered the campaign's target while its latest status
        is an answer. A waiting device that reports in-progress during a
        run still upgrades from before the run, and the run takes it in
        flight (take_running). If it reports upgrade-needed before it is
        done, it stopped before its install, and it waits again
        (take_back). So does a released device with a veto of another
        holder that reports upgrade-needed."""
        k = self.known(name)
        if k < 0:
            if status is None or not (is_final(status) or is_answer(status)
                                      or status == "in-progress"):
                # No state to keep.
                return
            k = self.number(name)
        self.report_n(k, status, at, rollback_failed)

    def report_n(self, k: int, status: ?str, at: int, rollback_failed: bool=False) -> None:
        """report() for the device with number k."""
        if status is not None and is_final(status):
            self.take_failing(k, is_failure(status))
            stuck = rollback_failed and status == "failed"
            if stuck != self.rollback_failed[k]:
                self.rollback_failed[k] = stuck
                self.quiet_until = 0
                if not stuck:
                    self.wake_members(k)
            if self.final_at[k] == NO_TIME:
                self.final_at[k] = at
                self.final_status[k] = status
                if self.released[k] and self.done_at[k] == NO_TIME:
                    self.reported[k] = True
                    heap_push(self.reports, self.entry(at, k))
                self.quiet_until = 0
            elif not is_failure(status) and self.final_status[k] != status:
                self.final_status[k] = status
                self.quiet_until = 0
            if self.failed[k] and not is_failure(status):
                self.failed[k] = False
                # The min-separation of its groups counts from the success.
                self.done_at[k] = imax(self.done_at[k], at)
                self.wake_members(k)
                self.quiet_until = 0
        elif self.final_at[k] != NO_TIME:
            self.lost_n(k)
        if status == "in-progress":
            if self.progress[k] == NO_TIME:
                self.progress[k] = at
        elif self.progress[k] != NO_TIME:
            self.progress[k] = NO_TIME
        if status == "upgrade-needed" and self.released[k] and self.done_at[k] == NO_TIME \
           and (self.resumed[k] or self.vetoed[k] != ""):
            self.take_back(k)
        self.take_answer(k, is_answer(status))
        if status == "in-progress" and self.running and self.is_member(k) \
           and not self.released[k]:
            self.take_running(k, self.progress[k])

    def take_answer(self, k: int, answers: bool) -> None:
        """Take whether the latest status of the device with number k
        answers the campaign's target. A waiting device that starts to
        answer is looked at again, once its groups let it start. A change of
        answer of a waiting device ends the quiet time; a released device's
        answer counts for nothing, so its change does not."""
        if answers == self.answered[k]:
            return
        if answers:
            self.answered[k] = True
            if k in self.parked and self.gate(k) >= 0:
                self.parked.discard(k)
                self.look_again(k)
        else:
            self.answered[k] = False
        if self.is_member(k) and not self.released[k]:
            self.quiet_until = 0

    def take_failing(self, k: int, failing: bool) -> None:
        """Take whether the latest report of the device with number k is a
        failure, and count the members whose latest report is one. A new
        count ends the quiet time when more members have failed than the
        failure budget before it or after it: the starts stop or go on, or
        the plan's alarm gives the new count."""
        if failing == self.failing[k]:
            return
        over = self.over_budget()
        self.failing[k] = failing
        if self.is_member(k):
            if failing:
                self.failures += 1
            else:
                self.failures -= 1
            if over or self.over_budget():
                self.quiet_until = 0

    def over_budget(self) -> bool:
        """True when more members have failed than the failure budget:
        their latest report is a failure."""
        return self.failure_budget >= 0 and self.failures > self.failure_budget

    def report_prepare(self, name: str, state: ?str) -> None:
        """Take the latest prepare state of a member for the campaign's
        target: running, done or failed, or None when it reports none. It
        changes no release decision, so the quiet time stays."""
        if state is not None:
            self.prepare_state[name] = state
        else:
            self.prepare_state.pop(name)

    def lost(self, name: str) -> None:
        """Forget the status of a device."""
        k = self.known(name)
        if k >= 0:
            self.lost_n(k)

    def lost_n(self, k: int) -> None:
        """lost() for the device with number k."""
        self.take_answer(k, False)
        self.take_failing(k, False)
        self.progress[k] = NO_TIME
        if self.final_at[k] != NO_TIME:
            self.final_at[k] = NO_TIME
            self.final_status[k] = ""
            self.reported[k] = False
            self.no_upgrade[k] = False
            if self.flying[k]:
                heap_push(self.dues, self.due_key(k))
            self.quiet_until = 0

    def lost_all(self) -> None:
        """Forget the status and the prepare state of every device."""
        n = self.size
        self.final_at = [NO_TIME for _k in range(n)]
        self.final_status = ["" for _k in range(n)]
        self.answered = [False for _k in range(n)]
        self.failing = [False for _k in range(n)]
        self.failures = 0
        self.prepare_state = {}
        self.progress = [NO_TIME for _k in range(n)]
        self.reported = [False for _k in range(n)]
        self.reports = []
        self.no_upgrade = [False for _k in range(n)]
        self.dues = sorted([self.due_key(k) for k in range(n) if self.flying[k]])
        self.overdue = set()
        self.quiet_until = 0

    def set_live(self, name: str, live: bool) -> bool:
        """Take whether a device is up. A device that comes back up is
        looked at again, and so are the members of its groups, once their
        groups let them start. A change ends the quiet time for a member
        that is not released and for a device in a redundancy group, but
        not for a member in flight without a report. Its change ends the
        quiet time only when it was past its expected end at the last step.
        Return True when the campaign must decide before the wake of the
        last decision: the quiet time ends, or a member in flight goes down
        and is past its expected end more than a debounce before that
        wake."""
        k = self.known(name)
        if live:
            if k < 0 or not self.down[k]:
                return False
            self.down[k] = False
            self.downs -= 1
            if k in self.parked and self.gate(k) >= 0:
                self.parked.discard(k)
                self.look_again(k)
            self.wake_members(k)
        else:
            if k < 0:
                k = self.number(name)
            if self.down[k]:
                return False
            self.down[k] = True
            self.downs += 1
        if self.flying[k] and not self.reported[k]:
            # It holds no one, and the plan expects it back up when its
            # upgrade ends.
            end = self.expected_end(k)
            if end < self.quiet_from:
                self.quiet_until = 0
                return True
            if live:
                return False
            heap_push(self.down_ends, (end + 1) * SCALE + k)
            return self.wake_at < 0 or end + 1 + self.debounce < self.wake_at
        if (self.is_member(k) and not self.released[k]) or self.in_group(k):
            self.quiet_until = 0
            return True
        return False

    def set_vetoed(self, name: str, holder: str) -> bool:
        """Take the holder of a veto of another holder than the campaign
        that the device name has, or "" for none. A waiting device with
        such a veto is held, and is looked at again when the veto goes. A
        released device that has not started its run waits again: its
        device does not install while the veto holds. Return True when the
        campaign must decide."""
        k = self.known(name)
        if k < 0:
            if holder == "":
                return False
            k = self.number(name)
        if holder == self.vetoed[k]:
            return False
        self.vetoed[k] = holder
        if holder == "":
            if k in self.parked and self.gate(k) >= 0:
                self.parked.discard(k)
                self.look_again(k)
        elif self.released[k] and self.done_at[k] == NO_TIME \
             and self.final_at[k] == NO_TIME and self.progress[k] == NO_TIME:
            self.take_back(k)
        if self.is_member(k):
            self.quiet_until = 0
            return True
        return False

    def separation_of(self, g: str) -> int:
        """The min-separation of group g: the time from when one member is
        done until the next may start."""
        return self.separation.get_def(g, (False, 0)).1

    def failure_holds(self, k: int, g: str) -> bool:
        """True when a failure of the device with number k holds the other
        members of group g: g holds on a failure, or the rollback of the
        device failed, which leaves it in an unknown state."""
        return g in self.hold_failed or self.rollback_failed[k]

    def holds(self, name: str, g: str) -> bool:
        """True when the device name holds the other members of group g: it
        is in flight or down, or it failed and its failure holds g."""
        k = self.known(name)
        return k >= 0 and (self.flying[k] or self.down[k]
                           or (self.failed[k] and self.failure_holds(k, g)))

    def done_time_of(self, name: str) -> int:
        """When the device name was done, or -1 when it is not."""
        k = self.known(name)
        if k >= 0 and self.done_at[k] != NO_TIME:
            return self.done_at[k]
        return -1

    def gate(self, k: int) -> int:
        """The time from which the waiting device with number k may start,
        or -1 while it must wait: while it has not answered the campaign's
        target, while it is down or vetoed, or while its redundancy groups
        hold it. A group holds it while the member before it in the group is not
        done, or another member of the group is in flight or down, or
        failed and its failure holds the group.
        The time is when the member before it was done, and the group's
        min-separation after that."""
        if not self.answered[k] or self.down[k] or self.vetoed[k] != "":
            return -1
        if not self.in_group(k):
            return 0
        name = self.name_of(k)
        gs = self.groups_of[name]
        at = 0
        for b in self.before.get_def(name, []):
            done = self.done_time_of(b.0)
            if done < 0:
                return -1
            at = imax(at, done + self.separation_of(b.1))
        for g in gs:
            for q in self.groups[g]:
                if self.holds(q, g):
                    return -1
        return at

    def wake_members(self, k: int) -> None:
        """Look again at the devices of the groups of the device with
        number k, itself included, that a window passed while they waited
        for their groups, once their groups let them start."""
        if not self.in_group(k):
            return
        for g in self.groups_of[self.name_of(k)]:
            for d in self.groups[g]:
                j = self.known(d)
                if j >= 0 and j in self.parked and self.gate(j) >= 0:
                    self.parked.discard(j)
                    self.look_again(j)

    def look_again(self, k: int) -> None:
        """Look at the waiting device with number k again in each of its
        windows."""
        if not self.released[k]:
            for j in self.wins_of(k):
                self.retry_in(j, k)

    def retry_key(self, i: int, k: int) -> int:
        """The entry in retrying of the device with number k in window i."""
        return i * SCALE + k

    def retry_in(self, i: int, k: int) -> None:
        """Look at the device with number k again in window i, unless it is
        already to be looked at again there."""
        e = self.retry_key(i, k)
        if e not in self.retrying:
            self.retrying.add(e)
            self.retry[i].append(k)

    def is_waiting(self, name: str) -> bool:
        """True when the device name is in the campaign and not released."""
        k = self.known(name)
        return name in self.est and not (k >= 0 and self.released[k])

    def waiting_members(self, devs: list[str], failures: bool=False) -> list[(str, str)]:
        """The waiting campaign devices that the devices devs hold, each
        as (device, holder), in the order of devs: each device of devs that
        waits itself, then the other waiting campaign devices of its
        groups. When failures is true, the devices devs failed, and a
        device holds only the groups that its failure holds."""
        out: list[(str, str)] = []
        for x in devs:
            if self.is_waiting(x):
                out.append((x, x))
            for g in self.groups_of.get_def(x, []):
                if failures and not self.failure_holds(self.names.num[x], g):
                    continue
                for d in self.groups[g]:
                    if d != x and self.is_waiting(d):
                        out.append((d, x))
        return out

    def stuck(self) -> (list[(int, str, str)], set[int]):
        """The held devices, in the campaign's order, each as (number,
        reason, holder): the device that holds it, the holder of its veto,
        or "" for neither; and the ones among them that wait for a device that failed or
        is down. A device held in its groups holds the members after it in
        its other groups, for the same reason and holder. A device that has
        not answered, or that has a veto of another holder, holds only the
        members after it in its groups. A failure report holds the other
        members of the groups that the failure holds at once, before a step
        marks the device done. A member that is down while it upgrades holds
        no one until it reports."""
        later: dict[str, list[str]] = {}
        for name, bs in self.before.items():
            if not self.released[self.names.num[name]]:
                for b in bs:
                    if b.0 not in later:
                        later[b.0] = []
                    later[b.0].append(name)
        failed: list[str] = []
        down: list[str] = []
        for k in range(self.size):
            if self.failed[k] or (self.reported[k] and is_failure(self.final_status[k])):
                failed.append(self.name_of(k))
            if self.down[k] and (not self.flying[k] or self.reported[k]):
                down.append(self.name_of(k))
        unanswered: list[(str, str)] = []
        vetoed: list[(str, str)] = []
        for k in self.order_n:
            if not self.released[k] and not self.answered[k]:
                unanswered.append((self.name_of(k), self.name_of(k)))
            elif not self.released[k] and self.vetoed[k] != "":
                vetoed.append((self.name_of(k), self.name_of(k)))
        behind_failed = follow(self.waiting_members(failed, True), later)
        behind_down = follow(self.waiting_members(down), later)
        behind_unanswered = follow(unanswered, later)
        behind_vetoed = follow(vetoed, later)
        over = self.over_budget()
        out: list[(int, str, str)] = []
        park: set[int] = set()
        for k in self.order_n:
            if self.released[k]:
                continue
            name = self.name_of(k)
            reason = ""
            holder = ""
            if self.down[k]:
                reason = "down"
            elif not self.answered[k]:
                reason = "not-answered"
            elif self.vetoed[k] != "":
                reason = "vetoed"
                holder = self.vetoed[k]
            elif name in behind_failed:
                reason = "group-failed"
                holder = behind_failed[name]
            elif name in behind_down:
                reason = "group-down"
                holder = behind_down[name]
            elif name in behind_unanswered:
                reason = "group-not-answered"
                holder = behind_unanswered[name]
            elif name in behind_vetoed:
                reason = "group-vetoed"
                holder = behind_vetoed[name]
            elif over:
                reason = "failure-budget"
            if reason != "":
                out.append((k, reason, holder))
            if name in behind_failed or name in behind_down:
                park.add(k)
        return (out, park)

    def duration(self, k: int) -> int:
        """The expected duration of the upgrade of the device with number k
        at the observed pace."""
        return imax(1, self.est_n(k) * self.observed_s // self.estimate_s)

    def slow(self, k: int) -> int:
        """The slow time of the upgrade of the device with number k: its
        estimate at the slow time of the last upgrades."""
        return imax(1, self.est_n(k) * self.slow_s // self.estimate_s)

    def fits(self, k: int, t: int, end: int) -> bool:
        """True when the device with number k, started at t, has its close
        margin left before end: its slow time times close_margin percent."""
        return end == OPEN_END or (end - t) * 100 >= self.slow(k) * self.close_margin

    def late_at(self, k: int) -> int:
        """The time after which the released device with number k is late
        when it has no final report: a fifth of its upgrade after its
        upgrade was expected to end, and not before its report could have
        counted."""
        return self.due[k] + imax(self.debounce, self.duration(k) // 5)

    def expected_end(self, k: int) -> int:
        """When the upgrade of the released device with number k is
        expected to end: its release and its expected duration after
        that."""
        return self.released_at[k] + self.duration(k)

    def promise(self, k: int, t: int) -> int:
        """The window promised to the device with number k, as an index,
        while that window is open or yet to open; -1 without one."""
        i = self.promised[k]
        if i >= 0 and t < self.windows[i].2:
            return i
        return -1

    def release(self, k: int, t: int, i: int) -> None:
        """Release the device with number k at time t in window i: it waits
        in no window any more and holds a slot until it is done."""
        self.released[k] = True
        self.released_at[k] = t
        self.released_in[k] = i
        self.released_est[k] = self.est_n(k)
        self.due[k] = t + self.duration(k)
        member = self.is_member(k)
        if member:
            if not self.flying[k]:
                self.flying[k] = True
                self.flights += 1
            self.in_flight[self.wsched[i]] += 1
        wins = self.wins_of(k)
        if len(wins) > 0:
            q = self.sched_at[wins[0]]
            self.waiting[q] -= 1
            self.waiting_est[q] -= self.est_n(k)
        if self.final_at[k] != NO_TIME:
            self.reported[k] = True
            heap_push(self.reports, self.entry(self.final_at[k], k))
            self.no_upgrade[k] = True
        elif member:
            heap_push(self.dues, self.due_key(k))

    def waiting_in(self, i: int) -> int:
        """How many devices that can start in window i wait."""
        q = self.sched_at[i]
        return self.waiting[q] if q >= 0 else 0

    def move_promises(self, t: int) -> list[int]:
        """Promise the devices still waiting for a window that has closed,
        or that the schedules no longer give, the next window of their
        schedule, in the same place in the order of the promises. Return
        the devices whose promise moved, as numbers."""
        moved: list[int] = []
        moves: dict[int, list[(int, str, int)]] = {}
        for i in range(len(self.windows)):
            win = self.windows[i]
            if self.moved[i] or (t < win.2 and self.is_current[i]):
                continue
            self.moved[i] = True
            for k in self.pqueue[i]:
                if not self.released[k] and self.promised[k] == i:
                    nxt = -1
                    for j in self.wins_of(k):
                        if nxt < 0 and j != i and t < self.windows[j].2:
                            nxt = j
                    self.promised[k] = nxt
                    if nxt >= 0:
                        if nxt not in moves:
                            moves[nxt] = []
                        moves[nxt].append((self.promise_seq[k], self.name_of(k), k))
                    self.moves += 1
                    moved.append(k)
        for j, ms in moves.items():
            # Both lists are in the order of the promises.
            q = self.pqueue[j]
            merged: list[int] = []
            first = -1
            a = 0
            for m in sorted(ms):
                while a < len(q) and self.promise_seq[q[a]] < m.0:
                    merged.append(q[a])
                    a += 1
                if first < 0:
                    first = len(merged)
                merged.append(m.2)
            while a < len(q):
                merged.append(q[a])
                a += 1
            self.pqueue[j] = merged
            self.pcur[j] = imin(self.pcur[j], first)
        return moved

    def fill(self, i: int, t: int, slots: int, started: list[int], c: int) -> int:
        """Start devices in the open window i at time t, at most slots of
        them, at concurrency c: first the devices promised to it, in the
        order of the promises, then the ones promised no window, the ones
        looked at again first. Return the slots left, 0 when the stagger
        holds the next device. A device that does not fit is
        not looked at again in this window until the slow time falls; one
        that waits for its groups is looked at again when they let it
        start."""
        end = self.windows[i].2
        # Nothing fits when the shortest waiting device does not.
        q = self.by_est[i]
        k = self.ecur[i]
        while k < len(q) and self.released[q[k]]:
            k += 1
        self.ecur[i] = k
        if k >= len(q) or not self.fits(q[k], t, end):
            return slots
        again = self.retry[i]
        self.retry[i] = []
        for d in again:
            self.retrying.discard(self.retry_key(i, d))
        n = slots
        # The devices looked at again that are promised this window, in
        # the order of the promises, merged with the ones not looked at yet.
        mine = sorted([(self.promise_seq[d], self.name_of(d), d) for d in again
                       if self.promise(d, t) == i])
        a = 0
        q = self.pqueue[i]
        k = self.pcur[i]
        while a < len(mine) or (n > 0 and k < len(q)):
            if a < len(mine) and (n == 0 or k >= len(q)
                                  or mine[a].0 < self.promise_seq[q[k]]):
                n = self.try_start(mine[a].2, i, t, end, n, started, c)
                a += 1
            else:
                d = q[k]
                k += 1
                if self.promise(d, t) == i:
                    n = self.try_start(d, i, t, end, n, started, c)
        self.pcur[i] = k
        for d in again:
            if self.promise(d, t) < 0:
                n = self.try_start(d, i, t, end, n, started, c)
        q = self.queue[i]
        k = self.qcur[i]
        while n > 0 and k < len(q):
            d = q[k]
            k += 1
            if self.promise(d, t) < 0:
                n = self.try_start(d, i, t, end, n, started, c)
        self.qcur[i] = k
        return n

    def try_start(self, k: int, i: int, t: int, end: int, n: int,
                  started: list[int], c: int) -> int:
        """Start the device with number k in window i at t if it waits,
        gate() lets it start, it fits and the stagger at concurrency c lets
        it start. Park it while it must wait for its answer or its groups,
        and keep it until its separation has passed. Return the slots left,
        0 when the stagger holds it."""
        if self.released[k]:
            return n
        if n == 0:
            # No slot left: look at it again in a later step.
            self.retry_in(i, k)
            return n
        at = self.gate(k)
        if at < 0:
            self.parked.add(k)
            return n
        if at > t:
            heap_push(self.timed, self.entry(at, k))
            return n
        if self.fits(k, t, end):
            # A device that reported before its release runs no upgrade: the
            # stagger does not hold it, and it holds no start back.
            if self.stagger > 0 and self.final_at[k] == NO_TIME:
                first = self.first_start(t, c)
                if first >= (t + 1) * MICRO:
                    # Look at it again when the stagger lets it start.
                    self.retry_in(i, k)
                    return 0
                self.last_start = first
                self.last_est = self.est_n(k)
            self.release(k, t, i)
            started.append(k)
            return n - 1
        return n

    def count(self, t: int) -> int:
        """Take the reports that count by time t: mark the devices that
        are done, take the pace and the slow time again, and look again at
        the devices that waited for t. Returns how many devices are done
        without a failure."""
        slow = self.slow_s
        sampled = False
        succeeded = 0
        # The reports that count by now, in the order they came.
        while len(self.reports) > 0:
            fr = self.reports[0]
            if not self.in_reports(fr):
                heap_pop(self.reports)
                continue
            end = fr // SCALE
            if end + self.debounce > t:
                break
            heap_pop(self.reports)
            k = self.entry_device(fr)
            self.reported[k] = False
            at = self.released_at[k]
            ran = not self.no_upgrade[k]
            self.no_upgrade[k] = False
            if not ran:
                end = t
            self.done_at[k] = end
            if is_failure(self.final_status[k]):
                self.failed[k] = True
            # At the scale of the campaign's estimate; an upgrade that
            # ends when it was expected to leaves the pace as it is. An
            # upgrade from before the run has no known start.
            if ran and not self.resumed[k] and (not self.released[k] or end != self.due[k]):
                est = self.released_est[k] if self.released[k] else self.estimate_s
                took = imax(1, imax(1, end - at) * self.estimate_s // est)
                n = len(self.took_s)
                p = self.pace_count()
                self.took_sum += took - self.took_s[(self.took_at - p + n) % n]
                self.took_s[self.took_at] = took
                self.took_at = (self.took_at + 1) % n
                self.observed_s = imax(1, self.took_sum // p)
                sampled = True
            if self.flying[k]:
                self.flying[k] = False
                self.flights -= 1
                self.in_flight[self.wsched[self.released_in[k]]] -= 1
                self.devices_done += 1
                if not is_failure(self.final_status[k]):
                    succeeded += 1
            self.wake_members(k)

        while len(self.timed) > 0 and self.timed[0] // SCALE <= t:
            self.look_again(self.entry_device(heap_pop(self.timed)))

        if sampled:
            self.take_slow()
        if self.slow_s < slow:
            # Devices that did not fit may fit now.
            self.qcur = [0 for _w in self.windows]
            self.ecur = [0 for _w in self.windows]
            self.pcur = [0 for _w in self.windows]
        return succeeded

    def start_gap(self, est: int, c: int) -> int:
        """The time from the start of a device with estimate est to the
        next start at concurrency c, in microseconds: the stagger's part of
        the device's expected upgrade time, divided by c."""
        expected = imax(1, est * self.observed_s // self.estimate_s)
        return self.stagger * expected * (MICRO // 100) // imax(1, c)

    def first_start(self, t: int, c: int) -> int:
        """The time from which the stagger at concurrency c lets a device
        start at the second t, in microseconds: a gap after the last start,
        and not before t. When the last step held a device, a step that
        comes later than its turn starts it as of its turn, so the devices
        whose turn has passed all start at t."""
        if self.last_start < 0:
            return t * MICRO
        nxt = self.last_start + self.start_gap(self.last_est, c)
        if self.held:
            return nxt
        return imax(t * MICRO, nxt)

    def step(self, t: int, c: int) -> (list[str], int, bool):
        """Decide at time t at concurrency c: take the reports that count,
        grow the ramp, start what fits, unless more members have failed
        than the failure budget, and say when to decide next. Returns the
        started devices, the wake and whether every device is done."""
        started, wake, finished = self.step_n(t, c)
        return ([self.name_of(k) for k in started], wake, finished)

    def step_n(self, t: int, c: int) -> (list[int], int, bool):
        """step() with the started devices as numbers."""
        succeeded = self.count(t)
        if self.rung < c:
            self.rung = imin(c, self.rung + 3 * succeeded)

        self.move_promises(t)
        started: list[int] = []
        n = imin(self.rung, c) - self.flights
        if self.over_budget():
            n = 0
        # True when the stagger holds back devices that wait in an open
        # window while slots are left.
        held_back = False
        wake = -1
        # The schedules with an open window that has devices waiting, in the
        # order their first such window opens, each with those windows in
        # the order they open.
        turns: list[str] = []
        open_of: dict[str, list[int]] = {}
        for i in range(len(self.windows)):
            win = self.windows[i]
            if self.waiting_in(i) > 0 and win.1 <= t and t < win.2:
                if win.0 not in open_of:
                    turns.append(win.0)
                    open_of[win.0] = []
                open_of[win.0].append(i)
        if n > 0 and len(turns) > 0 and self.stagger > 0 and self.held \
           and self.first_start(t, c) >= (t + 1) * MICRO:
            # The last step held a start: nothing starts before its turn.
            held_back = True
        # Share the free slots, then start each schedule's share in its open
        # windows, the schedule that takes the first slot first. A schedule
        # that cannot use all of its share starts nothing more now; the
        # slots it leaves are shared again between the others.
        while n > 0 and len(turns) > 0 and not held_back:
            share = [n]
            order = [(0, 0)]
            if len(turns) > 1:
                # One schedule takes every free slot; more share them.
                levels = [self.in_flight[self.wsched[open_of[name][0]]] for name in turns]
                weights = self.need_weights(turns, open_of, t, c)
                # The schedules that need a slot share them; the others wait
                # for the slots those leave.
                needy = [k for k in range(len(turns)) if weights[k] < NO_SHARE]
                share = [0 for _k in turns]
                some = shares([levels[k] for k in needy], [weights[k] for k in needy], n)
                for q in range(len(needy)):
                    share[needy[q]] = some[q]
                order = sorted([((2 * levels[k] + 1) * weights[k], k)
                                for k in range(len(turns))])
            keep: list[str] = []
            for e in order:
                k = e.1
                left = share[k]
                if not held_back:
                    for i in open_of[turns[k]]:
                        if left > 0 and not held_back:
                            before = len(started)
                            rest = self.fill(i, t, left, started, c)
                            took = len(started) - before
                            n -= took
                            left -= took
                            if rest == 0 and left > 0:
                                # The stagger holds the next start.
                                held_back = True
                if held_back or left == 0:
                    keep.append(turns[k])
            if len(keep) == len(turns):
                break
            turns = [name for name in turns if name in keep]
        for i in range(len(self.windows)):
            if self.waiting_in(i) == 0:
                continue
            win = self.windows[i]
            if win.1 > t:
                if wake < 0 or win.1 < wake:
                    wake = win.1
            elif t < win.2 and win.2 != OPEN_END:
                if wake < 0 or win.2 < wake:
                    wake = win.2
        if len(self.timed) > 0 and (wake < 0 or self.timed[0] // SCALE < wake):
            wake = self.timed[0] // SCALE
        # Until quiet the run ahead only starts devices: no report counts,
        # no device is due, and no window opens or closes.
        quiet = wake
        fl = self.flying_times(t)
        wake = earliest(wake, fl.0)
        quiet = earliest(quiet, fl.1)
        self.held = held_back
        if held_back:
            # The second in which the next device may start. A decision
            # after it starts that device later than the run ahead did.
            w = self.first_start(t, c) // MICRO
            wake = earliest(wake, w)
            quiet = earliest(quiet, w + 1)
        self.quiet_from = t
        self.quiet_until = quiet if quiet >= 0 else OPEN_END
        if len(self.lost_promises) > 0:
            # A member that lost its promised window leaves the plan's
            # alarm when it starts.
            for k in started:
                if k in self.lost_promises:
                    self.lost_promises.discard(k)
                    self.quiet_until = 0
        return (started, wake, self.devices_done >= len(self.est))

    def need_weights(self, turns: list[str], open_of: dict[str, list[int]], t: int,
                     c: int) -> list[int]:
        """The weight of each schedule in turns, whose open windows open_of
        gives, at time t and concurrency c, for shares(): a thousand times
        the total of what the schedules need, divided by its own need. When
        none needs anything before the first last start, their waiting
        upgrade time takes the place of the needs. A schedule that needs
        nothing gets NO_SHARE. A schedule's last start is the close of its
        last open window less the close margin of its mean waiting device;
        a window that never closes has none."""
        work: list[int] = []
        ends: list[int] = []
        for name in turns:
            # Each open window of a schedule has the same waiting devices.
            wins = open_of[name]
            k = self.sched_at[wins[0]]
            work.append(imax(1, self.waiting_est[k] * self.observed_s // self.estimate_s))
            mean = self.waiting_est[k] // imax(1, self.waiting[k])
            margin = mean * self.slow_s // self.estimate_s * self.close_margin // 100
            end = 0
            for j in wins:
                close = self.windows[j].2
                end = imax(end, OPEN_END if close == OPEN_END else close - margin)
            ends.append(end)
        part = window_needs(work, ends, t, c)
        total = 0
        for x in part:
            total += x
        if total == 0:
            part = work
            for x in part:
                total += x
        return [NO_SHARE if x == 0 else imin(NO_SHARE - 1, imax(1, total * 1000 // x))
                for x in part]

    def flying_times(self, t: int) -> (int, int):
        """For the devices in flight at time t: the next time to decide for
        them, and the time until which the run ahead takes no report from
        them; -1 for none. A device that is late is expected to take one
        more upgrade from t."""
        w = -1
        q = -1
        # A report counts one debounce after it came. The report of a device
        # no longer in the campaign counts too: it takes the pace. The first
        # report gives q, and the first of a device in flight gives w.
        aside: list[int] = []
        while len(self.reports) > 0:
            e = self.reports[0]
            if not self.in_reports(e):
                heap_pop(self.reports)
                continue
            r = imax(e // SCALE + self.debounce, t + 1)
            q = earliest(q, r)
            if self.flying[self.entry_device(e)]:
                w = r
                break
            aside.append(heap_pop(self.reports))
        for e in aside:
            heap_push(self.reports, e)
        # The devices whose report would have counted by now leave the heap.
        while len(self.dues) > 0:
            e = self.dues[0]
            if not self.in_dues(e):
                heap_pop(self.dues)
            elif e // SCALE + self.debounce <= t:
                heap_pop(self.dues)
                self.overdue.add(e % SCALE)
            else:
                break
        for k in list(self.overdue):
            if not self.flying[k] or self.reported[k]:
                self.overdue.discard(k)
            elif self.late_at(k) < t:
                # Late: one more upgrade from now.
                self.due[k] = t + self.duration(k)
                heap_push(self.dues, self.due_key(k))
                self.overdue.discard(k)
            else:
                # Its report could have counted: decide when it is late.
                w = earliest(w, self.late_at(k) + 1)
                q = earliest(q, self.due[k])
        if len(self.dues) > 0:
            # When its report counts if it comes when expected.
            w = earliest(w, self.dues[0] // SCALE + self.debounce)
            q = earliest(q, self.dues[0] // SCALE)
        return (w, q)

    def in_reports(self, e: int) -> bool:
        """True when e is the entry in reports of a device that reported."""
        k = self.entry_device(e)
        return self.reported[k] and self.final_at[k] == e // SCALE

    def due_key(self, k: int) -> int:
        """The entry in dues of the device with number k: its due time and
        its number as one number, which orders by due time first."""
        return self.due[k] * SCALE + k

    def in_dues(self, e: int) -> bool:
        """True when e is the entry in dues of a device in flight without a
        report."""
        k = e % SCALE
        return self.flying[k] and not self.reported[k] and self.due[k] == e // SCALE

    def take_due(self, now: int) -> list[int]:
        """Take from dues the devices in flight without a report whose
        upgrade is expected to have ended by now, as numbers."""
        out: list[int] = []
        for k in self.overdue:
            if self.flying[k] and not self.reported[k]:
                out.append(k)
        while len(self.dues) > 0 and self.dues[0] // SCALE <= now:
            e = heap_pop(self.dues)
            if self.in_dues(e):
                out.append(e % SCALE)
        return out

    def copy(self) -> Controller:
        """A controller with this one's configuration and a copy of its
        state, to run ahead without changing this one."""
        c = Controller()
        c.windows = self.windows
        c.index = self.index
        c.devices = self.devices
        c.order = self.order
        c.est = self.est
        c.schedule_of = self.schedule_of
        c.current = self.current
        c.groups = self.groups
        c.priority = self.priority
        c.separation = self.separation
        c.hold_failed = self.hold_failed
        c.before = self.before
        c.groups_of = self.groups_of
        c.spreads = self.spreads
        c.target = self.target
        c.maxc = self.maxc
        c.must_place = self.must_place
        c.debounce = self.debounce
        c.estimate_s = self.estimate_s
        c.close_margin = self.close_margin
        c.stagger = self.stagger
        c.prepare = self.prepare
        c.prepare_est = self.prepare_est
        c.failure_budget = self.failure_budget
        c.names = self.names
        c.size = self.size
        c.rank = self.rank
        c.by_rank = self.by_rank
        c.unset = self.unset
        c.member = self.member
        c.est_of = self.est_of
        c.wins = self.wins
        c.grouped = self.grouped
        c.order_n = self.order_n
        c.queue = self.queue
        c.by_est = self.by_est
        c.pqueue = [q.copy() for q in self.pqueue]
        c.qcur = self.qcur.copy()
        c.ecur = self.ecur.copy()
        c.pcur = self.pcur.copy()
        c.sched_at = self.sched_at
        c.waiting = self.waiting.copy()
        c.waiting_est = self.waiting_est.copy()
        c.parked = copy_set(self.parked)
        c.retry = [r.copy() for r in self.retry]
        c.retrying = copy_set(self.retrying)
        c.timed = self.timed.copy()
        c.wsched = self.wsched
        c.is_current = self.is_current
        c.moved = self.moved.copy()
        c.devices_done = self.devices_done
        c.running = self.running
        c.final_at = self.final_at.copy()
        c.final_status = self.final_status.copy()
        # The run ahead reports into its copy.
        c.answered = self.answered.copy()
        c.failing = self.failing.copy()
        c.failures = self.failures
        c.prepare_state = {k: v for k, v in self.prepare_state.items()}
        c.prepare_at = {k: v for k, v in self.prepare_at.items()}
        c.allowed = copy_set(self.allowed)
        c.prep_last = self.prep_last
        c.progress = self.progress.copy()
        c.resumed = self.resumed.copy()
        c.failed = self.failed.copy()
        c.rollback_failed = self.rollback_failed.copy()
        c.vetoed = self.vetoed.copy()
        c.down = self.down.copy()
        c.downs = self.downs
        c.reported = self.reported.copy()
        c.reports = self.reports.copy()
        c.no_upgrade = self.no_upgrade.copy()
        c.released = self.released.copy()
        c.released_at = self.released_at.copy()
        c.released_in = self.released_in.copy()
        c.released_est = self.released_est.copy()
        c.due = self.due.copy()
        c.flying = self.flying.copy()
        c.flights = self.flights
        c.in_flight = self.in_flight.copy()
        c.dues = self.dues.copy()
        c.overdue = copy_set(self.overdue)
        c.done_at = self.done_at.copy()
        c.promised = self.promised.copy()
        c.promise_seq = self.promise_seq.copy()
        c.seq = self.seq
        c.lost_promises = copy_set(self.lost_promises)
        c.moves = self.moves
        c.observed_s = self.observed_s
        c.took_s = self.took_s.copy()
        c.took_at = self.took_at
        c.took_sum = self.took_sum
        c.slow_s = self.slow_s
        c.rung = self.rung
        c.c = self.c
        c.last_start = self.last_start
        c.last_est = self.last_est
        c.held = self.held
        return c

    def project(self, t: int, c: int, skip: set[int]) -> Run:
        """Run ahead from time t at concurrency c, every upgrade ending
        when it is expected to. The devices in skip keep no promise in the
        run, so their promises do not move in it. Return where and when
        each device that the run starts starts, and how many promises move
        on in the run."""
        s = self.copy()
        s.moves = 0
        for k in skip:
            s.promised[k] = -1
        run = Run(self.unset.copy(), self.unset.copy())
        now = t
        while True:
            started, wake, finished = s.step_n(now, c)
            for k in started:
                run.win[k] = s.released_in[k]
                run.at[k] = now
            if wake < 0 or finished:
                break
            now = wake
            for k in s.take_due(now):
                # A member that is down while it upgrades comes back up.
                if s.downs > 0 and s.down[k]:
                    s.down[k] = False
                    s.downs -= 1
                s.report_n(k, "succeeded", s.due[k])
        run.moves = s.moves
        return run

    def breaks(self, run: Run, t: int, skip: set[int]) -> (list[str], list[str], int):
        """The promises a run breaks: the waiting devices not in skip that
        do not start in their promised window, the ones that start in no
        window, and how many times promises move on in the run: once for
        each window a device misses."""
        missed: list[str] = []
        unplaced: list[str] = []
        for k in self.order_n:
            if not self.released[k] and k not in skip:
                s = run.win[k]
                p = self.promise(k, t)
                if s >= 0:
                    if p >= 0 and s != p:
                        missed.append(self.name_of(k))
                else:
                    unplaced.append(self.name_of(k))
                    if p >= 0:
                        missed.append(self.name_of(k))
        return (missed, unplaced, run.moves)

    def worse(self, a: (list[str], list[str], int), b: (list[str], list[str], int)) -> bool:
        """True when the run with breaks a breaks more promises than the
        run with breaks b."""
        if a.2 > b.2:
            return True
        return self.must_place and len(a.1) > len(b.1)

    def choose(self, t: int, skip: set[int]) -> (int, Run, (list[str], list[str], int)):
        """The run ahead at the concurrency the plan uses: the current
        one, or else the smallest up to max-concurrency that breaks no
        more promises than max-concurrency does. The search assumes that
        a run at a higher concurrency breaks no more promises. The devices
        in skip break no promise."""
        none: (list[str], list[str], int) = ([], [], 0)
        c = self.target
        if self.running:
            c = imin(imax(self.c, self.target), self.maxc)
        run = self.project(t, c, skip)
        b = self.breaks(run, t, skip)
        if self.worse(b, none) and self.maxc > c:
            top_run = self.project(t, self.maxc, skip)
            top = self.breaks(top_run, t, skip)
            if self.worse(b, top):
                lo = c + 1
                hi = self.maxc
                while lo < hi:
                    mid = (lo + hi) // 2
                    if self.worse(self.breaks(self.project(t, mid, skip), t, skip), top):
                        lo = mid + 1
                    else:
                        hi = mid
                c = lo
                run = top_run if c == self.maxc else self.project(t, c, skip)
                b = self.breaks(run, t, skip)
        return (c, run, b)

    def held_windows(self, names: list[str], t: int) -> dict[str, (int, int)]:
        """The window to show each held device in names in: the one
        promised to it, or else the first window of its schedule that has
        not closed, which stays free for other devices. Return each window
        and the earliest time the device could start there."""
        held: dict[str, (int, int)] = {}
        for name in names:
            k = self.known(name)
            i = -1
            if k >= 0:
                i = self.promise(k, t)
                if i < 0:
                    for j in self.wins_of(k):
                        if i < 0 and t < self.windows[j].2:
                            i = j
            if i >= 0:
                held[name] = (i, imax(t, self.windows[i].1))
        return held

    def promise_starts(self, run: Run, t: int) -> list[int]:
        """Promise each waiting device without a promise the window that
        the run starts it in, in the order the run starts them, and return
        the devices it promises."""
        # By start, and at one time in the order of the devices.
        new: list[(int, int, int)] = []
        for p in range(len(self.order_n)):
            k = self.order_n[p]
            if not self.released[k] and self.promise(k, t) < 0 and run.win[k] >= 0:
                new.append((run.at[k], p, k))
        fresh: list[int] = []
        for e in sorted(new):
            k = e.2
            i = run.win[k]
            self.promised[k] = i
            self.promise_seq[k] = self.seq
            self.seq += 1
            self.pqueue[i].append(k)
            fresh.append(k)
        return fresh

    def window_of(self, k: int, t: int) -> int:
        """The window the device with number k was released in, or else the
        one promised to it, as an index; -1 without one."""
        if self.released[k]:
            return self.released_in[k]
        return self.promise(k, t)

    def ends_by(self, k: int, t: int) -> int:
        """When the device with number k is done at the latest, as far as
        the plan knows: when it was done, when its upgrade is expected to
        end, or else when the window promised to it closes; -1 without
        one."""
        if self.done_at[k] != NO_TIME:
            return self.done_at[k]
        if self.released[k]:
            return self.due[k]
        i = self.promise(k, t)
        if i >= 0:
            return self.windows[i].2
        return -1

    def swap_promises(self, a: int, b: int, at: dict[int, int]) -> None:
        """Give the waiting devices with numbers a and b each other's
        promise and place in the order of the promises. at gives the place
        of each in the promises of its window."""
        i = self.promised[a]
        j = self.promised[b]
        self.promised[a] = j
        self.promised[b] = i
        sa = self.promise_seq[a]
        self.promise_seq[a] = self.promise_seq[b]
        self.promise_seq[b] = sa
        ka = at[a]
        kb = at[b]
        self.pqueue[i][ka] = b
        self.pqueue[j][kb] = a
        at[a] = kb
        at[b] = ka

    def spread_out(self, fresh: list[int], t: int, c: int, run: Run,
                   b: (list[str], list[str], int), skip: set[int]) -> None:
        """Move the members of spread groups among the devices in fresh,
        which the run ahead run at concurrency c just gave their promises,
        to later windows, as far apart as the windows the run uses allow.
        A member moves only to a window that opens after the members before
        it in its group end, at the latest, and the group's min-separation
        has passed. When a member that moved does not end, with the
        min-separation, before the window of each member after it opens, or
        its window opens too soon after a member before it ends, in any
        group, no member of its group moves. Undo every move when the run
        ahead with the moves breaks more promises or leaves more devices
        without a start than run, whose breaks are b."""
        is_fresh: set[int] = set(fresh)
        # The place of each device in fresh in the promises of its window.
        at: dict[int, int] = {}
        for i in range(len(self.pqueue)):
            q = self.pqueue[i]
            for j in range(len(q)):
                if q[j] in is_fresh and self.promise(q[j], t) == i:
                    at[q[j]] = j
        # Per schedule, the last window the run starts a device in.
        last: dict[str, int] = {}
        for k in self.order_n:
            w = run.win[k]
            if w >= 0:
                sched = self.windows[w].0
                if w > last.get_def(sched, -1):
                    last[sched] = w
        # The members right after each device, in any group.
        later: dict[str, list[(str, str)]] = {}
        for name, bs in self.before.items():
            for bf in bs:
                if bf.0 not in later:
                    later[bf.0] = []
                later[bf.0].append((name, bf.1))
        # The devices that can give a member their promise, by window and
        # estimate, the latest promise last.
        spare: dict[(int, int), list[int]] = {}
        for k in fresh:
            if not self.in_group(k) and k not in skip:
                key = (self.promise(k, t), self.est_n(k))
                if key not in spare:
                    spare[key] = []
                spare[key].append(k)
        swaps: list[(int, int)] = []
        for g in sorted(self.groups.keys()):
            if not self.separation.get_def(g, (False, 0)).0:
                continue
            members = [self.names.num[m.1] for m in sorted([(self.priority.get_def(m, 0), m)
                                                            for m in self.groups[g]
                                                            if m in self.est])]
            n = len(members)
            if n < 2:
                continue
            a = self.window_of(members[0], t)
            if a < 0:
                continue
            sep = self.separation_of(g)
            # When the members placed so far are done, and the
            # min-separation has passed.
            ready = self.ends_by(members[0], t) + sep
            moved: list[(int, int)] = []
            for j in range(1, n):
                m = members[j]
                w = self.window_of(m, t)
                if m in is_fresh and m not in skip and w >= 0:
                    # The windows of m's schedule from the first member's
                    # window to the last one the run uses.
                    span = [x for x in self.wins_of(m)
                            if self.windows[x].1 >= self.windows[a].1
                            and x <= last.get_def(self.schedule_of[self.name_of(m)], -1)]
                    if len(span) > 1:
                        top = (j * (len(span) - 1) + (n - 1) // 2) // (n - 1)
                        pos = top
                        while pos >= 0 and span[pos] > w and self.windows[span[pos]].1 >= ready:
                            pool = spare.get_def((span[pos], self.est_n(m)), [])
                            if len(pool) > 0:
                                partner = pool.pop()
                                self.swap_promises(m, partner, at)
                                moved.append((m, partner))
                                break
                            pos -= 1
                e = self.ends_by(m, t)
                if e >= 0:
                    ready = imax(ready, e + sep)
            # Each moved member must keep its order with the devices before
            # and after it in every group.
            fine = True
            for mv in moved:
                wm = self.windows[self.promise(mv.0, t)]
                for bf in self.before.get_def(self.name_of(mv.0), []):
                    kb = self.known(bf.0)
                    e = self.ends_by(kb, t) if kb >= 0 else -1
                    if e < 0 or e + self.separation_of(bf.1) > wm.1:
                        fine = False
                for y in later.get_def(self.name_of(mv.0), []):
                    ky = self.known(y.0)
                    if ky >= 0 and not self.released[ky]:
                        wy = self.promise(ky, t)
                        if wy >= 0 and wm.2 + self.separation_of(y.1) > self.windows[wy].1:
                            fine = False
            if fine:
                swaps.extend(moved)
            else:
                for mv in reversed(moved):
                    self.swap_promises(mv.0, mv.1, at)
                    spare[(self.promise(mv.1, t), self.est_n(mv.1))].append(mv.1)
        if len(swaps) > 0:
            r = self.project(t, c, skip)
            rb = self.breaks(r, t, skip)
            if self.worse(rb, b) or len(rb.1) > len(b.1):
                for mv in reversed(swaps):
                    self.swap_promises(mv.0, mv.1, at)

    def plan(self, t: int) -> Plan:
        """Plan from time t: the run ahead, at the concurrency choose()
        gives, with the promises the plan makes. It runs ahead again until
        its promises stop changing. During a run the controller keeps the
        promises and the concurrency."""
        moved = self.move_promises(t)
        # The devices that no concurrency can start keep their windows, but
        # break no promise. The ones that wait for a device that failed or
        # is down are looked at again when it lets them start. The others
        # are not parked here: parked, they would be looked at again in the
        # order they answer, not in the campaign's order.
        held_list, park = self.stuck()
        skip: set[int] = set()
        why: dict[str, (str, str)] = {}
        held_names: list[str] = []
        by_reason: dict[str, list[str]] = {}
        for e in held_list:
            name = self.name_of(e.0)
            skip.add(e.0)
            why[name] = (e.1, e.2)
            held_names.append(name)
            if e.1 not in by_reason:
                by_reason[e.1] = []
            by_reason[e.1].append(name)
        for k in park:
            self.parked.add(k)
        for k in moved:
            if k in skip:
                self.lost_promises.add(k)
        over = self.over_budget()
        s = self.copy()
        held = s.held_windows(held_names, t)
        c, run, b = s.choose(t, skip)
        settled = False
        for _round in range(PLAN_ROUNDS):
            fresh = s.promise_starts(run, t)
            if len(fresh) == 0:
                settled = True
                break
            if s.spreads:
                s.spread_out(fresh, t, c, run, b, skip)
            c, run, b = s.choose(t, skip)
        # The reports that count by now, as the run ahead had them, and the
        # pace and the slow time after them, as the step at t has them.
        s.count(t)
        starts: dict[str, (int, int)] = {}
        lost: list[str] = []
        gone: list[str] = []
        down_ends: list[int] = []
        for k in self.order_n:
            if run.win[k] >= 0:
                starts[self.name_of(k)] = (run.win[k], run.at[k])
            if s.flying[k] and s.down[k] and not s.reported[k]:
                end = s.expected_end(k)
                if end < t:
                    gone.append(self.name_of(k))
                else:
                    down_ends.append((end + 1) * SCALE + k)
            elif not s.released[k] and k in s.lost_promises:
                lost.append(self.name_of(k))
        self.down_ends = sorted(down_ends)
        if self.running:
            self.promised = s.promised
            self.promise_seq = s.promise_seq
            self.seq = s.seq
            self.pqueue = s.pqueue
            self.c = c

        alarms: list[str] = []
        if over:
            alarms.append("{self.failures} device(s) failed, more than the failure budget of "
                          + "{self.failure_budget}: no more devices start")
        texts: list[(str, str)] = [
            ("group-failed", "wait behind a failed redundancy group member"),
            ("down", "are down"),
            ("group-down", "wait while a redundancy group member is down"),
            ("not-answered", "have not answered the campaign's target"),
            ("vetoed", "are held by a veto of another holder"),
            ("group-vetoed", "wait behind a redundancy group member that is held by a veto"),
            ("group-not-answered", "wait behind a redundancy group member that has not answered"),
        ]
        for r in texts:
            ns = by_reason.get_def(r.0, [])
            if len(ns) > 0:
                alarms.append("{len(ns)} device(s) {r.1}: {names_text(ns)}")
        if len(lost) > 0:
            alarms.append("{len(lost)} device(s) lost their promised window while held: "
                          + names_text(lost))
        if len(gone) > 0:
            alarms.append("{len(gone)} device(s) in flight are down past their expected end: "
                          + names_text(gone))
        # A plan whose only alarms are for held devices, for devices in
        # flight that are down, and for lost windows can be taken again.
        n_hold = len(alarms)
        at_max = " even at max-concurrency {self.maxc}" if c >= self.maxc else ""
        missed = b.0
        if len(missed) > 0:
            alarms.append("{len(missed)} device(s) will miss the window they were "
                          + "promised{at_max}: {names_text(missed)}")
        # The devices with no promise that start in no window.
        unplaced = [name for name in b.1 if s.promise(s.names.num[name], t) < 0]
        if len(unplaced) > 0:
            if self.must_place:
                alarms.append("{len(unplaced)} device(s) cannot start before the deadline"
                              + "{at_max}: {names_text(unplaced)}")
            else:
                alarms.append("{len(unplaced)} device(s) are in no window yet: "
                              + names_text(unplaced))
        # Why devices start in no window, at the slow time after the reports
        # that count by now.
        short = s.windows_too_short(missed + unplaced, t)
        if len(short) > 0:
            alarms.append("{len(short)} device(s) fit in no window: {self.close_margin} percent "
                          + "of their slow time, {s.slow_s} s at the campaign's estimate, is "
                          + "longer than the time left in every window of their schedule: "
                          + names_text(short))
        p = Plan(c, starts, held, why, alarms)
        self.last_plan = p if self.running and settled and len(alarms) == n_hold else None
        return p

    def windows_too_short(self, names: list[str], t: int) -> list[str]:
        """The devices in names whose close margin is longer than the time
        left from t in every window of their schedule that has not closed,
        when such a window is left and none of them stays open. They start
        in no window until the slow time falls, which only upgrades of
        other devices can bring about, or until the windows or the close
        margin change."""
        # Per schedule, the most time left in one of its windows, or -1
        # when none is left.
        most: dict[str, int] = {}
        out: list[str] = []
        for name in names:
            k = self.names.num[name]
            sched = self.schedule_of.get_def(name, "")
            left = most.get_def(sched, -2)
            if left == -2:
                left = -1
                for j in self.wins_of(k):
                    w = self.windows[j]
                    if w.2 == OPEN_END:
                        left = OPEN_END
                    elif w.2 > t:
                        left = imax(left, w.2 - imax(w.1, t))
                most[sched] = left
            if left >= 0 and left != OPEN_END \
               and left * 100 < self.slow(k) * self.close_margin:
                out.append(name)
        return out

    def decide(self, t: int) -> Step:
        """Plan at time t and take the plan's first step. The last plan
        holds when its only alarms are for held devices, for lost windows
        and for members in flight that are down, nothing came in since the
        last step, no member that lost its window started, and from that
        step until t the run ahead only starts devices: no report counts,
        no device is due, no window opens or closes, and no member in
        flight that is down passes its expected end. A status of a device
        in flight that is not final, such as in-progress, brings in
        nothing, and neither does a member in flight without a report that
        goes down or comes back up before its expected end. Then the
        decision takes that plan again, without the devices that started
        since, with the held devices at the earliest times they could start
        from t, and only starts the devices it starts now. Then it lets
        members prepare whose turn has come (take_prepares). The decision
        also wakes when a member in flight that is down passes its expected
        end."""
        last = self.last_plan
        down = self.down_end()
        if last is not None and self.quiet_from <= t and t < self.quiet_until \
           and (down < 0 or t < down):
            p = Plan(last.c, {name: s for name, s in last.starts.items()
                              if not self.released[self.names.num[name]]},
                     self.held_windows(list(last.held.keys()), t), last.why, last.alarms)
            self.last_plan = p
        else:
            p = self.plan(t)
        started, wake, finished = self.step(t, p.c)
        wake = earliest(wake, self.take_prepares(t))
        wake = earliest(wake, self.down_end())
        self.wake_at = wake
        return Step(started, wake, finished, p, self.prepares(t))

    def down_end(self) -> int:
        """The first second in which a member in flight without a report
        that is down is past its expected end, -1 for none."""
        while len(self.down_ends) > 0:
            e = self.down_ends[0]
            k = e % SCALE
            if self.flying[k] and self.down[k] and not self.reported[k]:
                return e // SCALE
            heap_pop(self.down_ends)
        return -1

    def slot(self, s: int) -> int:
        """The start of the debounce slot of the second s, in seconds."""
        q = imax(1, self.debounce)
        return s // q * q

    def in_window(self, name: str, t: int) -> bool:
        """True when the first window of the device's schedule that has not
        closed at t is open at t."""
        for j in self.wins_of(self.known(name)):
            w = self.windows[j]
            if t < w.2:
                return w.1 <= t
        return False

    def prepare_deadline(self, name: str, t: int) -> ?int:
        """The time by which a member must start to prepare, in
        microseconds: the opening of the first window of its schedule that
        has not closed at t, less the close margin of its expected prepare
        time. None while that window is open at t, or when its schedule has
        no such window."""
        for j in self.wins_of(self.known(name)):
            w = self.windows[j]
            if t < w.2:
                if w.1 <= t:
                    return None
                return w.1 * MICRO \
                    - self.prepare_est.get_def(name, 1) * self.close_margin * (MICRO // 100)
        return None

    def turns(self, t: int) -> (list[(int, str)], list[str]):
        """The turns to prepare of the members that wait to prepare at t,
        in order, as (time in microseconds, name), and the members whose
        deadline has passed, in the campaign's order. A member waits to
        prepare while the run is on, prepare is on, no more members have
        failed than the failure budget, it is not released, it is up,
        its latest report says that it needs the upgrade, it has a promise,
        it was not let prepare in this run, it reports no prepare, and it
        has a deadline. The turns go by deadline, then by the order of the
        promises, then by the campaign's order. The first turn is t, or one
        gap after the last turn let, and t when that is before the start
        of t's debounce slot. Each next turn is one gap after the turn
        before it (prepare_gap)."""
        late: list[str] = []
        if not self.running or not self.prepare or self.over_budget():
            return ([], late)
        waiting: list[(int, int, int, str)] = []
        for p in range(len(self.order_n)):
            k = self.order_n[p]
            if self.released[k] or self.down[k] or not self.answered[k] \
               or self.final_at[k] != NO_TIME or self.promise(k, t) < 0:
                continue
            name = self.name_of(k)
            if name in self.prepare_at or name in self.prepare_state:
                continue
            d = self.prepare_deadline(name, t)
            if d is not None:
                if d < t * MICRO:
                    late.append(name)
                else:
                    waiting.append((d, self.promise_seq[k], p, name))
        if len(waiting) == 0:
            return ([], late)
        ordered = sorted(waiting)
        # Each deadline once, with how many members have it or an earlier
        # one.
        deadlines: list[int] = []
        upto: list[int] = []
        for j in range(len(ordered)):
            d = ordered[j].0
            if len(deadlines) > 0 and deadlines[-1] == d:
                upto[-1] = j + 1
            else:
                deadlines.append(d)
                upto.append(j + 1)
        turn = t * MICRO
        if self.prep_last >= 0:
            turn = self.prep_last + prepare_gap(deadlines, upto, 0, 0, self.prep_last)
            if turn < self.slot(t) * MICRO:
                # Behind: one member now, and the rest spread from now.
                turn = t * MICRO
        out: list[(int, str)] = [(turn, ordered[0].3)]
        lo = 0
        for j in range(1, len(ordered)):
            while upto[lo] <= j:
                lo += 1
            turn += prepare_gap(deadlines, upto, lo, j, turn)
            out.append((turn, ordered[j].3))
        return (out, late)

    def prepares(self, t: int) -> Prepares:
        """The prepares at t, as turns() gives them and without changing
        anything. The members let prepare in this run start when they were
        let, and each waiting member at the start of the debounce slot of
        its turn, and not before t. The most members that prepare at once
        counts each waiting member from that start for its expected prepare
        time, and the prepares that run now: the members let prepare now,
        and the members not released that report their prepare running,
        each from when it was let, or else from t. The failed prepares are
        those of the members that wait for their release: not released,
        and their latest report says that they need the upgrade."""
        tr = self.turns(t)
        starts: dict[str, int] = {}
        for name, at in self.prepare_at.items():
            starts[name] = at
        for e in tr.0:
            starts[e.1] = imax(t, self.slot(e.0 // MICRO))
        now = copy_set(self.allowed)
        for name, st in self.prepare_state.items():
            if st == "running" and not self.is_released(name):
                now.add(name)
        # Each prepare as (start, end, name), in microseconds.
        spans: list[(int, int, str)] = []
        for name in now:
            begin = self.prepare_at.get_def(name, t) * MICRO
            end = begin + self.prepare_est.get_def(name, 1) * MICRO
            if end > t * MICRO:
                spans.append((begin, end, name))
        for e in tr.0:
            begin = starts[e.1] * MICRO
            spans.append((begin, begin + self.prepare_est.get_def(e.1, 1) * MICRO, e.1))
        # The ends of the prepares that run at each start.
        ends: list[(int, str)] = []
        c = 0
        for sp in sorted(spans):
            while len(ends) > 0 and ends[0].0 <= sp.0:
                heap_pop(ends)
            heap_push(ends, (sp.1, sp.2))
            c = imax(c, len(ends))
        alarms: list[str] = []
        if len(tr.1) > 0:
            alarms.append("{len(tr.1)} device(s) cannot prepare before their window opens: "
                          + names_text(tr.1))
        failed: list[str] = []
        for k in self.order_n:
            if not self.released[k] and self.answered[k] and self.final_at[k] == NO_TIME:
                name = self.name_of(k)
                if self.prepare_state.get(name) == "failed":
                    failed.append(name)
        if len(failed) > 0:
            alarms.append("{len(failed)} device(s) failed to prepare and copy the image in "
                          + "their window: {names_text(failed)}")
        return Prepares(starts, c, alarms)

    def revoke_prepares(self, t: int) -> None:
        """Stop letting prepare each member that may no longer prepare at
        t: all of them when the run is off, prepare is off, or more members
        have failed than the failure budget, and each one that is released,
        whose latest report no longer says that it needs the upgrade, that
        left the campaign, whose prepare is done or failed, or for which a
        window of its schedule is open."""
        if len(self.allowed) == 0:
            return
        if not self.running or not self.prepare or self.over_budget():
            self.allowed = set()
            return
        keep: set[str] = set()
        for name in self.allowed:
            st = self.prepare_state.get(name)
            k = self.known(name)
            if k < 0 or self.released[k] or not self.answered[k] \
               or self.final_at[k] != NO_TIME or name not in self.est \
               or st == "done" or st == "failed" or self.in_window(name, t):
                continue
            keep.add(name)
        self.allowed = keep

    def take_prepares(self, t: int) -> int:
        """Stop letting prepare the members that may no longer prepare
        (revoke_prepares), and let prepare each member whose turn is
        before the end of t's debounce slot. Return the start of the
        debounce slot of the next turn, or -1 when no turn is left. With no
        turn left, the next member that comes to wait goes at once."""
        self.revoke_prepares(t)
        tr = self.turns(t)
        end = (self.slot(t) + imax(1, self.debounce)) * MICRO
        wake = -1
        for e in tr.0:
            if e.0 < end:
                self.allowed.add(e.1)
                self.prepare_at[e.1] = t
                self.prep_last = e.0
            elif wake < 0:
                wake = self.slot(e.0 // MICRO)
        if wake < 0:
            self.prep_last = -1
        return wake

    def layout(self, p: Plan) -> list[(str, int, int, list[(str, int, int)])]:
        """The windows with their devices, by start: one (schedule, start,
        end, devices) entry per window that has devices, each device as
        (name, start, estimated duration), with its real start when it was
        released, the plan's start when it waits, and, when it is held, the
        earliest start in the window that the plan's held gives it."""
        released: list[list[(int, str, int)]] = [[] for _w in self.windows]
        planned: list[list[(int, str)]] = [[] for _w in self.windows]
        for k in range(self.size):
            if self.released[k]:
                released[self.released_in[k]].append((self.released_at[k], self.name_of(k), k))
        for name, s in p.starts.items():
            if not self.is_released(name):
                planned[s.0].append((s.1, name))
        for name, h in p.held.items():
            if not self.is_released(name) and name not in p.starts:
                planned[h.0].append((h.1, name))
        out: list[(str, int, int, list[(str, int, int)])] = []
        for i in range(len(self.windows)):
            entries: list[(str, int, int)] = []
            for d in sorted(released[i]):
                entries.append((d.1, d.0, self.released_est[d.2]))
            for d in sorted(planned[i]):
                entries.append((d.1, d.0, self.est.get_def(d.1, self.estimate_s)))
            if len(entries) > 0:
                w = self.windows[i]
                out.append((w.0, w.1, w.2, entries))
        return out

    # The state of the devices by name, for the campaign and for tests.

    def is_released(self, name: str) -> bool:
        """True when the device name is released."""
        k = self.known(name)
        return k >= 0 and self.released[k]

    def has_answered(self, name: str) -> bool:
        """True when the latest report of the device name answers the
        campaign's target."""
        k = self.known(name)
        return k >= 0 and self.answered[k]

    def has_final(self, name: str) -> bool:
        """True when the device name has a final report."""
        k = self.known(name)
        return k >= 0 and self.final_at[k] != NO_TIME

    def release_time(self, name: str) -> ?int:
        """When the device name was released, or None."""
        k = self.known(name)
        if k >= 0 and self.released[k]:
            return self.released_at[k]
        return None

    def done_time(self, name: str) -> ?int:
        """When the device name was done, or None."""
        k = self.known(name)
        if k >= 0 and self.done_at[k] != NO_TIME:
            return self.done_at[k]
        return None

    def due_time(self, name: str) -> ?int:
        """When the upgrade of the released device name is expected to end,
        or None."""
        k = self.known(name)
        if k >= 0 and self.released[k]:
            return self.due[k]
        return None

    def promised_window(self, name: str) -> ?(str, int, int):
        """The window promised to the device name, or None."""
        k = self.known(name)
        if k >= 0 and self.promised[k] >= 0:
            return self.windows[self.promised[k]]
        return None

    def done_count(self) -> int:
        """How many devices are done."""
        n = 0
        for k in range(self.size):
            if self.done_at[k] != NO_TIME:
                n += 1
        return n

    def released_devices(self) -> set[str]:
        """The released devices."""
        return {self.name_of(k) for k in range(self.size) if self.released[k]}

    def release_times(self) -> dict[str, int]:
        """When each released device was released."""
        return {self.name_of(k): self.released_at[k] for k in range(self.size)
                if self.released[k]}

    def release_windows(self) -> dict[str, (str, int, int)]:
        """The window each released device was released in."""
        return {self.name_of(k): self.windows[self.released_in[k]] for k in range(self.size)
                if self.released[k]}

    def done_times(self) -> dict[str, int]:
        """When each device that is done was done."""
        return {self.name_of(k): self.done_at[k] for k in range(self.size)
                if self.done_at[k] != NO_TIME}

    def flying_devices(self) -> set[str]:
        """The devices of the campaign in flight."""
        return {self.name_of(k) for k in range(self.size) if self.flying[k]}

    def failed_devices(self) -> set[str]:
        """The devices done whose upgrade failed or rolled back."""
        return {self.name_of(k) for k in range(self.size) if self.failed[k]}

    def resumed_devices(self) -> set[str]:
        """The released devices that a run took in flight because they
        still upgraded from before the run."""
        return {self.name_of(k) for k in range(self.size) if self.resumed[k]}

    def upgrading(self) -> set[str]:
        """The devices in flight that run an upgrade: not the ones whose
        final report came before their release, and not the ones that
        still upgrade from before the run."""
        return {self.name_of(k) for k in range(self.size)
                if self.flying[k] and not self.no_upgrade[k] and not self.resumed[k]}

