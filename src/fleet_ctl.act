#
# The release decisions of a campaign, now and ahead.
#
# One piece of logic decides which devices start: Controller.step. The
# campaign actor steps the controller on the clock. plan() runs the same
# step ahead of time, from the controller's state and at the expected
# upgrade durations, to say where and when each waiting device starts:
# the plan is the run, ahead of time. The controller runs at the
# smallest concurrency at which that run keeps its promises. It has no
# clock and no I/O: the caller passes the time in.
#

# End of a window that never closes: the year 2100 as seconds since the
# Unix epoch, far beyond any campaign.
OPEN_END = 4102444800

# The default close margin, in percent of a device's slow time.
CLOSE_MARGIN = 150

# How many device names an alarm gives.
ALARM_NAMES = 5

# How many times plan() runs ahead until its promises stop changing.
PLAN_ROUNDS = 3

# Microseconds in a second: the stagger times the starts in them.
MICRO = 1000000

# The weight that need_weights() gives a schedule that needs no slot now.
# While another schedule needs one, the slots are shared without it, and
# it takes only the slots the others leave. Every other weight is below it.
NO_SHARE = 1000000000


def is_final(status: ?str) -> bool:
    """True when the status ends an upgrade attempt."""
    if status == "succeeded" or status == "up-to-date":
        return True
    return is_failure(status)


def is_failure(status: ?str) -> bool:
    """True when the status ends an upgrade attempt that did not
    succeed."""
    return status == "failed" or status == "rolled-back"


def is_answer(status: ?str) -> bool:
    """True when the status answers the campaign's target: the device
    needs the upgrade, or its status is final. No status, unknown and
    in-progress are no answer."""
    if status == "upgrade-needed":
        return True
    return is_final(status)


def names_text(names: list[str]) -> str:
    """The first names of a list, for an alarm."""
    shown = ", ".join(names[:ALARM_NAMES])
    if len(names) > ALARM_NAMES:
        return shown + " and {len(names) - ALARM_NAMES} more"
    return shown


def follow(start: list[(str, str)], later: dict[str, list[str]]) -> dict[str, str]:
    """The devices in start, each given as (device, holder), and every
    device after them through later, each with a holder: the holder of
    the first entry of start that it is, or that it is after."""
    seen: dict[str, str] = {}
    for s in start:
        if s.0 in seen:
            continue
        seen[s.0] = s.1
        todo = [s.0]
        while len(todo) > 0:
            name = todo.pop()
            for d in later.get_def(name, []):
                if d not in seen:
                    seen[d] = s.1
                    todo.append(d)
    return seen


# TODO: upstream: the builtin min and max take one Iterable, so each call
# builds a list; the plan calls these for each device.
def imin(a: int, b: int) -> int:
    """The smaller of a and b."""
    if a < b:
        return a
    return b


def imax(a: int, b: int) -> int:
    """The larger of a and b."""
    if a > b:
        return a
    return b


def coarse(steps: list[(int, int)], most: int) -> list[(int, int)]:
    """Return steps, a list of (time, level) in time order where each level
    holds until the next time, as at most most steps. When steps has more,
    the time from its first step to its last is cut into most - 1 equal
    stretches. Each stretch gives one step at its start, with the highest
    level that the stretch reaches, so the peak stays. A last step after
    the stretches gives the level of the last step. A step with the same
    level as the step before it is left out."""
    if len(steps) <= most or most < 2:
        return steps
    first = steps[0].0
    n = most - 1
    width = (steps[-1].0 - first) // n + 1
    out: list[(int, int)] = []
    j = 0
    level = 0
    for i in range(n):
        start = first + i * width
        while j < len(steps) and steps[j].0 <= start:
            level = steps[j].1
            j += 1
        top = level
        while j < len(steps) and steps[j].0 < start + width:
            level = steps[j].1
            top = imax(top, level)
            j += 1
        if len(out) == 0 or out[-1].1 != top:
            out.append((start, top))
    if out[-1].1 != steps[-1].1:
        out.append((first + n * width, steps[-1].1))
    return out


def earliest(a: int, b: int) -> int:
    """The earlier of the times a and b, where -1 is no time."""
    if a < 0 or (b >= 0 and b < a):
        return b
    return a


# TODO: upstream, as a heapq module in the standard library.
def heap_push[A(Ord)](h: list[A], x: A) -> None:
    """Add x to the binary heap h, smallest first."""
    h.append(x)
    k = len(h) - 1
    while k > 0:
        up = (k - 1) // 2
        if not h[k] < h[up]:
            break
        y = h[k]
        h[k] = h[up]
        h[up] = y
        k = up


def heap_pop[A(Ord)](h: list[A]) -> A:
    """Remove and return the smallest entry of the binary heap h."""
    top = h[0]
    last = h.pop()
    n = len(h)
    if n > 0:
        h[0] = last
        k = 0
        while True:
            m = k
            a = 2 * k + 1
            if a < n and h[a] < h[m]:
                m = a
            if a + 1 < n and h[a + 1] < h[m]:
                m = a + 1
            if m == k:
                break
            y = h[k]
            h[k] = h[m]
            h[m] = y
            k = m
    return top


def pace_samples(target: int) -> int:
    """How many of the last upgrades the observed pace is the mean of:
    target + target // 4."""
    return imax(1, target + target // 4)


def slow_samples(maxc: int) -> int:
    """How many of the last upgrades the slow time is taken from at
    max-concurrency maxc: two rounds, and at least 50."""
    return imax(50, 2 * maxc)


def slow_time(took: list[int], pace: int) -> int:
    """The 98th percentile of the times in took by nearest rank, or pace
    when pace is longer. took is not empty."""
    s = sorted(took)
    return imax(pace, s[(98 * len(s) + 99) // 100 - 1])


def below(level: int, weight: int, k: int) -> int:
    """How many slots a window takes before its next slot would count k or
    more: a slot counts twice the devices in flight before it, plus one,
    times the weight."""
    return imax(0, (k + weight - 1) // weight // 2 - level)


def shares(levels: list[int], weights: list[int], n: int) -> list[int]:
    """Share n slots between windows, given each window's devices in flight
    and its weight of at least 1, in the order the windows open. The slots
    go one at a time, each to the window whose devices in flight plus a
    half, times its weight, are the fewest, the first window on a tie. So
    the devices in flight follow the inverse of the weights, each window's
    share rounded to the nearest slot; the weights are whole numbers, so a
    tie is a tie of those products. Return how many slots each window
    takes."""
    m = len(levels)
    # The largest count k for which the slots that count less than k fit
    # in n. Every slot that counts less is taken, and the slots that count
    # k go to the first windows.
    lo = 0
    hi = 0
    for j in range(m):
        hi = imax(hi, (2 * (levels[j] + n) + 1) * weights[j])
    while lo < hi:
        mid = (lo + hi + 1) // 2
        total = 0
        for j in range(m):
            total += below(levels[j], weights[j], mid)
        if total <= n:
            lo = mid
        else:
            hi = mid - 1
    out = [below(levels[j], weights[j], lo) for j in range(m)]
    rest = n
    for q in out:
        rest -= q
    for j in range(m):
        if rest > 0 and (2 * (levels[j] + out[j]) + 1) * weights[j] == lo:
            out[j] += 1
            rest -= 1
    return out


def window_needs(work: list[int], ends: list[int], t: int, c: int) -> list[int]:
    """What each schedule with an open window needs at time t: the upgrade
    time of its waiting devices that it must start before the first of
    the schedules' last starts, at concurrency c. work gives each
    schedule's waiting upgrade time and ends its last start, in seconds.
    The time after a last start counts for the schedules that can still
    start devices then: from the last of the last starts back to the
    first, the time between two goes to those schedules in proportion to
    the upgrade time they have left, as c devices at once over that time.
    The devices still in flight at a last start are not taken off that
    time."""
    k = len(work)
    by_end = sorted([(imax(t + 1, ends[j]), j) for j in range(k)])
    rest = list(work)
    for q in range(k - 1):
        m = k - 1 - q
        span = by_end[m].0 - by_end[m - 1].0
        if span > 0:
            room = c * span
            total = 0
            for p in range(m, k):
                total += rest[by_end[p].1]
            for p in range(m, k):
                j = by_end[p].1
                if total <= room:
                    rest[j] = 0
                else:
                    # In bigint: the product passes 64 bits beyond about
                    # 3e9 s of waiting upgrade time.
                    rest[j] -= int(bigint(rest[j]) * bigint(room) // bigint(total))
    return rest


def prepare_gap(deadlines: list[int], upto: list[int], lo: int, taken: int, last: int) -> int:
    """The time from the turn last to the next turn, in microseconds: the
    longest at which each member left still has its turn by its deadline.
    deadlines holds the members' deadlines, each once and in order, and
    upto how many members have that deadline or an earlier one. lo is the
    first deadline with members left, and taken is how many members have
    a turn. For each deadline D, the members left with deadline D or
    earlier share the time from last to D. The gap is the smallest of
    those shares, and never below 0."""
    gap = -1
    for j in range(lo, len(deadlines)):
        share = 0
        if deadlines[j] > last:
            share = (deadlines[j] - last) // (upto[j] - taken)
        if gap < 0 or share < gap:
            gap = share
    return imax(0, gap)


def merge_spans(spans: list[(int, int)]) -> list[(int, int)]:
    """The spans, each (start, end), by start, with the spans that overlap
    merged into one. Spans that only touch stay apart."""
    out: list[(int, int)] = []
    for s in sorted(spans):
        if len(out) > 0 and s.0 < out[-1].1:
            if s.1 > out[-1].1:
                out[-1] = (out[-1].0, s.1)
        else:
            out.append(s)
    return out


class FreeTime(object):
    """The time from an origin on that is free to prepare: the time
    outside the blackouts, up to OPEN_END, all in microseconds. It is a
    list of closed stretches (start, end), by start. A blackout's start
    and its end are free, so two blackouts that touch leave a stretch of
    no length between them. An origin inside a blackout starts at that
    blackout's end. Free values count the free time from the origin."""
    blackouts: list[(int, int)]
    spans: list[(int, int)]
    # The free time before each stretch, and the total at the end.
    cum: list[int]

    def __init__(self, blackouts: list[(int, int)], origin: int):
        self.blackouts = merge_spans(blackouts)
        spans: list[(int, int)] = []
        at = origin
        for b in self.blackouts:
            if b.1 <= at:
                continue
            if b.0 >= at:
                spans.append((at, b.0))
            at = b.1
        if at < OPEN_END * MICRO:
            spans.append((at, OPEN_END * MICRO))
        self.spans = spans
        cum = [0]
        for s in spans:
            cum.append(cum[-1] + s.1 - s.0)
        self.cum = cum

    def find(self, x: int) -> int:
        """The place of the last stretch that starts at or before x, -1 for
        none."""
        lo = 0
        hi = len(self.spans)
        while lo < hi:
            mid = (lo + hi) // 2
            if self.spans[mid].0 <= x:
                lo = mid + 1
            else:
                hi = mid
        return lo - 1

    def before(self, x: int) -> int:
        """The free time from the origin to x. Inside a blackout, the free
        time to its start."""
        j = self.find(x)
        if j < 0:
            return 0
        return self.cum[j] + imin(x, self.spans[j].1) - self.spans[j].0

    def is_free(self, x: int) -> bool:
        """True when x lies in a free stretch."""
        j = self.find(x)
        return j >= 0 and x <= self.spans[j].1

    def instant(self, c: int, lo: int) -> int:
        """The earliest free x at or after lo with before(x) at least c:
        the end of a stretch when c falls there, and the end of the
        blackout when lo lies inside one. OPEN_END when there is none."""
        n = len(self.spans)
        # The first stretch whose end has free time c.
        a = 0
        b = n
        while a < b:
            mid = (a + b) // 2
            if self.cum[mid + 1] >= c:
                b = mid
            else:
                a = mid + 1
        if a >= n:
            return OPEN_END * MICRO
        x = self.spans[a].0 + imax(0, c - self.cum[a])
        j = self.find(lo)
        first = lo
        if j < 0 or lo > self.spans[j].1:
            first = self.spans[j + 1].0 if j + 1 < n else OPEN_END * MICRO
        return imax(x, first)

    def inside(self, x: int) -> int:
        """The end of the blackout that x lies inside, after its start and
        before its end, or -1 when x lies inside none."""
        # The last blackout that starts before x.
        lo = 0
        hi = len(self.blackouts)
        while lo < hi:
            mid = (lo + hi) // 2
            if self.blackouts[mid].0 < x:
                lo = mid + 1
            else:
                hi = mid
        if lo > 0 and x < self.blackouts[lo - 1].1:
            return self.blackouts[lo - 1].1
        return -1


def span_middle(s: (int, int)) -> int:
    """The middle of the stretch s, rounded down."""
    return s.0 + (s.1 - s.0) // 2


def span_gap(s: (int, int), pos: int) -> int:
    """The gap that a turn at pos leaves in the stretch s: its length at
    its middle, and else twice the smaller distance to its ends."""
    if pos == span_middle(s):
        return s.1 - s.0
    return 2 * imin(pos - s.0, s.1 - pos)


class Fit(object):
    """Whether a member of place_turns() may take a place. This one lets
    every member take every place."""

    def __init__(self):
        pass

    mut def fits(self, j: int, pos: int) -> bool:
        """True when member j may take its turn at the free value pos."""
        return True

    mut def take(self, j: int, pos: int) -> None:
        """Member j takes its turn at the free value pos."""
        pass

    mut def no_easier(self, j: int, i: int) -> bool:
        """True when member j fits at no place where member i does not."""
        return False


def place_turns(points: list[int], anchor: int, now: int, members: list[(int, bool)],
                fit: Fit=Fit()) -> list[int]:
    """Place members among the turns points, as free values: one at a
    time, in order, each given as (deadline, due). The stretches a member
    can take are from anchor, the last turn let, to the first turn,
    between two turns, and from the last turn to its deadline, each cut
    at its deadline; one that ends at or before now is none. A member
    goes to the middle of a stretch that starts at or after now. In the
    stretch that holds now, which starts before it, a new member goes to
    the later of its middle and now, and a due member, whose turn passed,
    goes now. So of several due members one goes now, and the others
    spread after it. Of those places, it takes the one that leaves the
    widest gap, and that fit lets it take: twice the smaller distance to
    the stretch's two ends, the latest stretch on a tie. With no stretch,
    it goes now when fit lets it. Each member placed is a turn for the
    members after it. Return each member's turn, or -1 for a member that
    fit lets take no place. No turn of points moves."""
    pts = sorted(points)
    # The stretches from now on as (-gap, -start, start, end): a member
    # goes to the middle, and the gap is the stretch's length.
    ahead: list[(int, int, int, int)] = []
    holding = False
    hold = (0, 0)
    tail = anchor
    j = 0
    out: list[int] = []
    # The last member that took no place, with its deadline and whether
    # it was due, while no member took a place after it: a member that
    # fits no easier, with the same deadline, takes no place either.
    failed = -1
    failed_d = 0
    failed_due = False
    for idx in range(len(members)):
        m = members[idx]
        d = m.0
        due = m.1
        # The stretches up to the turns at or before d are whole.
        while j < len(pts) and pts[j] <= d:
            s = (tail, pts[j])
            if s.1 > now and s.1 >= s.0:
                if s.0 < now:
                    holding = True
                    hold = s
                else:
                    heap_push(ahead, (s.0 - s.1, -s.0, s.0, s.1))
            tail = imax(tail, pts[j])
            j += 1
        if failed >= 0 and d == failed_d and due == failed_due and fit.no_easier(idx, failed):
            out.append(-1)
            continue
        use_hold = holding
        use_tail = d > now and d >= tail
        aside: list[(int, int, int, int)] = []
        # The candidates as (gap, start, place, which): 0 from now on, 1
        # the stretch that holds now, 2 the stretch to the deadline.
        best = (-1, 0, now, -1)
        rejected = False
        while True:
            best = (-1, 0, now, -1)
            if len(ahead) > 0:
                top = ahead[0]
                s = (top.2, top.3)
                best = (s.1 - s.0, s.0, span_middle(s), 0)
            if use_hold:
                pos = now if due else imax(span_middle(hold), now)
                c = (span_gap(hold, pos), hold.0, pos, 1)
                if c.0 > best.0 or (c.0 == best.0 and c.1 > best.1):
                    best = c
            if use_tail:
                s = (tail, d)
                pos = span_middle(s)
                if s.0 < now:
                    pos = now if due else imax(pos, now)
                c = (span_gap(s, pos), s.0, pos, 2)
                if c.0 > best.0 or (c.0 == best.0 and c.1 > best.1):
                    best = c
            if best.3 < 0 or fit.fits(idx, best.2):
                break
            rejected = True
            if best.3 == 0:
                aside.append(heap_pop(ahead))
            elif best.3 == 1:
                use_hold = False
            else:
                use_tail = False
        if best.3 < 0 and (rejected or not fit.fits(idx, now)):
            for e in aside:
                heap_push(ahead, e)
            out.append(-1)
            failed = idx
            failed_d = d
            failed_due = due
            continue
        failed = -1
        pos = best.2
        out.append(pos)
        fit.take(idx, pos)
        halves: list[(int, int)] = []
        if best.3 == 0:
            # The stretch taken is at the top: the ones set aside are not.
            top = heap_pop(ahead)
            halves = [(top.2, pos), (pos, top.3)]
        elif best.3 == 1:
            holding = False
            halves = [(hold.0, pos), (pos, hold.1)]
        elif best.3 == 2:
            halves = [(tail, pos)]
            tail = pos
        elif tail < now and (j >= len(pts) or pts[j] >= now):
            tail = now
        for e in aside:
            heap_push(ahead, e)
        for s in halves:
            if s.1 > now:
                if s.0 < now:
                    holding = True
                    hold = s
                else:
                    heap_push(ahead, (s.0 - s.1, -s.0, s.0, s.1))
    return out


class Sweep(object):
    """The bandwidth of the prepares at an instant that only moves later,
    for the cap, in bits per second: the prepares that run then, each as
    (start, end, bandwidth) in microseconds. cap is the most bandwidth, or
    below 0 for none. A prepare whose bandwidth alone is over the cap
    fits when no other prepare runs."""
    cap: int
    # The prepares that run, as a heap of (end, bandwidth), and the sum of
    # their bandwidths. The prepares that ended since mark().
    ends: list[(int, int)]
    total: int
    gone: list[(int, int)]

    def __init__(self, cap: int, spans: list[(int, int, int)]):
        """Take the cap and the prepares that run, each of which starts
        at or before the first instant asked."""
        self.cap = cap
        self.ends = []
        self.total = 0
        self.gone = []
        for sp in spans:
            self.add(sp.1, sp.2)

    def fits(self, s: int, bw: int) -> bool:
        """True when a prepare of bandwidth bw that starts at s keeps the
        bandwidth at or under the cap. s is at or after every instant
        asked before, since the last undo()."""
        if self.cap < 0:
            return True
        while len(self.ends) > 0 and self.ends[0].0 <= s:
            e = heap_pop(self.ends)
            self.total -= e.1
            self.gone.append(e)
        return self.cap < 0 or self.total == 0 or self.total + bw <= self.cap

    def mark(self) -> None:
        """Start to keep the prepares that end, for undo()."""
        self.gone = []

    def keep(self) -> None:
        """Forget the prepares that ended since mark()."""
        self.gone = []

    def undo(self) -> None:
        """Take back the prepares that ended since mark(), so that an
        instant before them can be asked again."""
        for e in self.gone:
            heap_push(self.ends, e)
            self.total += e.1
        self.gone = []

    def next_end(self) -> int:
        """The first end of a prepare that runs, or -1 when none runs."""
        if len(self.ends) > 0:
            return self.ends[0].0
        return -1

    def add(self, e: int, bw: int) -> None:
        """Take a prepare that runs until e at bandwidth bw. Without a cap,
        nothing needs it."""
        if self.cap >= 0:
            heap_push(self.ends, (e, bw))
            self.total += bw


class Load(object):
    """The bandwidth of the prepares over time, for the cap, in bits per
    second: each prepare as (start, end, bandwidth) in microseconds, by
    start. cap is the most bandwidth, or below 0 for none. A prepare whose
    bandwidth alone is over the cap fits when no other prepare runs."""
    cap: int
    spans: list[(int, int, int)]
    # The longest time that a prepare runs.
    longest: int

    def __init__(self, cap: int, spans: list[(int, int, int)]):
        self.cap = cap
        self.spans = sorted(spans)
        self.longest = 0
        for sp in spans:
            self.longest = imax(self.longest, sp.1 - sp.0)

    def first_from(self, x: int) -> int:
        """The place of the first prepare that starts at or after x."""
        lo = 0
        hi = len(self.spans)
        while lo < hi:
            mid = (lo + hi) // 2
            if self.spans[mid].0 < x:
                lo = mid + 1
            else:
                hi = mid
        return lo

    def fits(self, s: int, e: int, bw: int) -> bool:
        """True when a prepare of bandwidth bw from s to e keeps the
        bandwidth at or under the cap at every instant from s to e: at s,
        and at the start of each prepare that starts in that time."""
        if self.cap < 0:
            return True
        near: list[(int, int, int)] = []
        for p in range(self.first_from(s - self.longest), len(self.spans)):
            sp = self.spans[p]
            if sp.0 >= e:
                break
            if sp.1 > s:
                near.append(sp)
        for x in [s] + [sp.0 for sp in near if sp.0 > s]:
            total = 0
            for sp in near:
                if sp.0 <= x and x < sp.1:
                    total += sp.2
            if total > 0 and total + bw > self.cap:
                return False
        return True

    def add(self, s: int, e: int, bw: int) -> None:
        """Take a prepare from s to e at bandwidth bw."""
        self.spans.insert(self.first_from(s), (s, e, bw))
        self.longest = imax(self.longest, e - s)


def copy_set[A(Hashable)](s: set[A]) -> set[A]:
    out: set[A] = set()
    for x in s:
        out.add(x)
    return out


# A time that is not set: below any time the controller takes.
NO_TIME = -4611686018427387904

# An entry in the heaps of the controller is a time times SCALE, plus a
# device's number or its rank by name.
SCALE = 16777216


class Names(object):
    """The devices that a controller and its copies have state for, each
    with a number: the place of its state in the controller's lists. A
    device keeps its number."""
    num: dict[str, int]
    names: list[str]

    def __init__(self):
        self.num = {}
        self.names = []

    def number(self, name: str) -> int:
        """The number of a device, a new one when it has none."""
        k = self.num.get(name)
        if k is not None:
            return k
        n = len(self.names)
        self.num[name] = n
        self.names.append(name)
        return n


class Plan(object):
    """A run of the controller ahead of time.

    c is the concurrency the run uses. starts gives each waiting device
    that starts the window it starts in, as an index into the
    controller's windows, and the time. held gives each device that is
    held the window promised to it, or else the first window of its
    schedule that has not closed, and the earliest time it could start
    there. held also gives each waiting device that keeps a promise but
    that the run does not start, in the window promised to it, so the
    plan shows it where it was promised. why gives each device that is
    held, also one without a window, its reason and its holder as
    Controller gives them: a device, the holder of a veto, or "" for
    neither. A device that the run does not start has no reason. alarms
    says which promises the run breaks and which devices are held."""
    c: int
    starts: dict[str, (int, int)]
    held: dict[str, (int, int)]
    why: dict[str, (str, str)]
    alarms: list[str]

    def __init__(self, c: int, starts: dict[str, (int, int)], held: dict[str, (int, int)],
                 why: dict[str, (str, str)], alarms: list[str]):
        self.c = c
        self.starts = starts
        self.held = held
        self.why = why
        self.alarms = alarms


class Prepares(object):
    """The prepares of a campaign at a time t.

    starts gives the second at which each member prepares: when it was
    first let, or, for a member that waits to prepare, the second its turn
    lets it (Controller.turns), and not before t. runs gives, for each
    member let prepare whose prepare does not count from its start, the
    second it counts from, or -1 when it does not count. c is the most
    members that prepare at once, each for its expected prepare time, the
    prepares that run now included. steps is the bandwidth of those
    prepares over time, in bits per second, as (second, bandwidth from
    then on), each a change, and none when the bandwidth stays 0; peak is
    the most of it. between is whether the members may prepare between
    windows. alarms names the members that cannot prepare before their
    window opens and the members that wait for their release and whose
    prepare failed."""
    starts: dict[str, int]
    c: int
    alarms: list[str]
    steps: list[(int, int)]
    peak: int
    between: bool
    runs: dict[str, int]

    pure def __init__(self, starts: dict[str, int], c: int, alarms: list[str],
                 steps: list[(int, int)]=[], peak: int=0, between: bool=False,
                 runs: dict[str, int]={}):
        self.starts = starts
        self.c = c
        self.alarms = alarms
        self.steps = steps
        self.peak = peak
        self.between = between
        self.runs = runs


class Step(object):
    """What one decision did.

    started holds the devices to start now. wake is the next time to
    decide if no report comes first, or -1 when only a report can change
    the plan. finished is true when every device is done. plan is
    the plan the decision followed. prepares is the prepares after the
    decision."""
    started: list[str]
    wake: int
    finished: bool
    plan: Plan
    prepares: Prepares

    def __init__(self, started: list[str], wake: int, finished: bool, plan: Plan,
                 prepares: Prepares):
        self.started = started
        self.wake = wake
        self.finished = finished
        self.plan = plan
        self.prepares = prepares


class Run(object):
    """Where and when a run ahead starts each device, by device number:
    the window as an index, or -1 when the run does not start it, and the
    time. moves is how many promises move on in the run."""
    win: list[int]
    at: list[int]
    moves: int

    def __init__(self, win: list[int], at: list[int]):
        self.win = win
        self.at = at
        self.moves = 0


class Controller(object):
    """The release decisions of one campaign.

    configure() takes the windows, the devices and the limits; it can
    come again with new ones during a run. start() runs, and stop() pauses
    the run: a pause keeps all that the run knows, and start() carries the
    run on from there.
    report() takes the latest status of a device and the time it came.
    decide() plans and takes the first step of the plan; plan() only
    plans.

    A device can start in the windows of its schedule. A report counts one
    debounce after it came. A step marks the released devices whose final
    report counts as done at the time of the report, and grows the ramp: one
    device at first, and three more for each device that is done without a
    failure, up to the concurrency. So the ramp takes four times as many
    devices each round, but it does not wait for a round to end, and when
    the concurrency rises, the ramp follows it as devices finish. A failed
    upgrade does not grow the ramp. Then it starts waiting devices while
    fewer devices than the ramp are in flight. The schedules with an open
    window share the free slots by what each needs: the expected upgrade
    time of its waiting devices that it must start before the first of
    their last starts. A schedule's last start is the close of its last
    open window less the close margin of its mean waiting device; a window
    that never closes has none. The time after a last start counts for the
    schedules that can still start devices then: from the last of the last
    starts back to the first, the time between two goes to those schedules
    in proportion to the upgrade time they have left, as many devices at
    once as the concurrency. So a schedule with time of its own
    at the end leaves the slots to one whose window closes first, and
    schedules whose windows close together share in proportion to the
    upgrade time waiting in them. When none needs a slot before the first
    last start, they share in that proportion too. Each schedule then has
    its share of the devices in flight, rounded to the nearest slot as
    shares() rounds it, and starts it in its open windows in the order
    they open. A schedule that needs no slot now, or has nothing more to
    start, leaves its slots to the others. With a stagger, a device that
    starts holds the
    next start back by the stagger's percent of its expected upgrade time,
    divided by the concurrency. So as many devices as the concurrency
    start over that part of an upgrade, also when a window opens with room
    for many, and the starts go faster in a larger campaign. At 100 percent
    the starts can go as fast as devices end on average; below it they can
    also catch up when more devices end at once. While the stagger holds
    back a start, nothing starts before that start's turn. A
    window starts only a device that is ready and
    that has its close margin left before the window closes: its slow
    time times the close margin, one and a half by default. A device that
    has not reported when a fifth of its upgrade has passed since the
    upgrade was expected to end, and its report could have counted, is
    late: it is expected to take one more upgrade from then. Before that,
    a plan expects it to end at the next decision. The next decision is
    when the next report counts, when an upgrade is expected to end and
    its report to count, when a device is late, at the next opening or
    close of a window with devices waiting, or when the stagger lets a
    waiting device start.

    Devices in a redundancy group back each other up, so the members of a
    group upgrade one at a time, lower priority first and equal priorities
    by name. A member may start when the member before it in each of its
    groups is done and the group's min-separation after that has passed,
    and no other member of its groups is in flight or down, or failed in
    a group that the failure holds. It also waits the group's
    min-separation after the done time of each other member of the group,
    before or after it in the group, that ran an upgrade in the run, or
    that is done without a release with a final status other than
    up-to-date, such as a success from before a restart. While a member
    that ran an upgrade in the run is not done, the others wait the
    min-separation after the end of that upgrade. A member that may not
    start yet is looked at again when its min-separation has passed, and
    when another member of its groups is done, reports a success after a
    failure or comes back up. It is also looked at again when another
    member of its groups that is done without a release reports a new
    final status that is not a failure or loses its status, and when the
    device of such a member tells a new boot. A member that reports a
    success after a failure is done again at that report. A member that is
    down holds the other waiting members of its groups, and a held member
    holds the members after it in its other groups. A member that failed
    holds the other waiting members of the groups that hold on a failure,
    until an operator acts. In the other groups it holds no one once it is
    done and up again, so the next member starts after the group's
    min-separation; but a member whose rollback failed is in an unknown
    state, and holds all its groups.

    A member whose status is final while it waits is done at once, without
    a release: it is up to date, or it succeeded or failed before, such as
    before it left the campaign and joined it again with the same attempt.
    It takes no window, no promise and no slot, and adds nothing to the
    pace or the ramp. The member after it in its groups waits the group's
    min-separation from its done time, and also waits for the member
    before it. A member that is up to date is done at its answer. But a
    member that upgraded in the run and then got a new attempt, or left
    the campaign and joined it again, is done at the end of that upgrade
    when it answers that it is up to date. A member that succeeded or
    failed before is done at its report. When a member done without a
    release reports a new final status that is not a failure, for example
    up-to-date after a failure, it is done at that report.
    When its device tells when it last booted (report_last_boot()), a
    member done at the end of an upgrade that the run saw end is done at
    the boot when that came later. Any other member is done at the boot
    instead of its answer or its report: after a restart, the next member
    need not wait for a device that has run the target for months, and
    waits the min-separation from the boot of one that booted a minute
    ago. But a member that upgraded in the run is not done before the end
    of that upgrade, also when its device booted before then. A failure
    still counts: it holds the other members of its groups, and counts
    against the failure budget. The member waits again when its
    final status goes, but a member whose rollback failed keeps it: it
    stays done and failed until a later final report, a new attempt or a
    removal.

    A device is up until set_live() says that it is down. A waiting device
    that is down is held, in a redundancy group or not, and is looked at
    again when it comes back up. Likewise a waiting device with a veto of
    another holder than the campaign, as set_vetoed() says, is held until
    the veto goes. A released device that gets such a veto before its run
    starts, or that stops before its install, waits again (take_back). A
    member that is down while it upgrades holds no one and keeps its slot:
    the plan expects it back up when its upgrade ends. The plan gives an
    alarm for it while it is down after its expected end: its release and
    its expected duration after that.

    A device starts only when its latest report answers the campaign's
    target: it needs the upgrade. A final status answers too, and makes a
    member done at once. A device that has not answered is held, also
    before a run, and it holds the members after it in its redundancy
    groups. It is looked at again when it answers. So a plan made before
    the first run shows what that run would do if it started now. In a
    pause, a copy of the controller that starts shows what the run does
    when it carries on.

    A run that carries on after a pause keeps each released device. One
    that is done keeps its release, its done time and its failure: it
    takes no window, and the min-separation of its groups counts from
    when it was done. One whose final report came in the pause keeps its
    slot until the next step counts that report. One that still reports
    in-progress keeps its release and its slot. One that does neither did
    not start its run, and waits again (take_back). The promises, the
    pace, the slow time, the ramp and the concurrency stay too.

    A device that still reports in-progress when a paused run carries on
    still upgrades from before the pause, and a waiting device that
    reports in-progress during a run still upgrades from before a
    restart. The run takes a waiting one in flight at once, in the first
    window of its schedule that has not closed, so it holds a slot and its
    redundancy groups until it is done. A device in flight whose run waits
    to try its prepare again, after the prepare failed for a transient
    reason, keeps its slot while a try that starts now fits its window
    (last_fit()); after that, the campaign holds it too, and also a run
    that tried again after that (stop_waiting_runs()). resumed has all of
    them: the campaign keeps holding them, so they stop if they have not
    reached their install, and their upgrades give no pace sample.
    Neither does the upgrade of a device whose run waited in its flight.
    When such a device reports upgrade-needed, it stopped before its
    install, and it waits again (take_back).

    drop() forgets the devices that left the campaign, and the members
    that the campaign gives a new attempt. A device that joins again, or
    that has a new attempt, is then a new member: it waits until it
    answers, and starts in a window. It keeps the end of an upgrade that
    it ran in the run, for the min-separation of its groups. When its
    device answers that it is up to date, the member is done again at the
    end of that upgrade, or at a later boot. An answer of another status
    before that says that the device can have changed since the upgrade.
    Then, and when its device answers with the final status that it keeps
    for its attempt, as when the member joins again with the same attempt,
    the member is done again at that final answer, or at its boot when its
    device tells, but not before the end of that upgrade. retarget() takes
    a new target release for members.

    A held device keeps the window promised to it, and the plan gives an
    alarm for it. When that window closes while the device is held, its
    promise moves to the next window of its schedule, and the plan gives
    an alarm for it until it starts. A held device without a promise gets
    none while it is held: the plan shows it in the first window of its
    schedule that has not closed, and other devices can take that window.

    A held device has one reason, the first of these that applies to it,
    and a holder: the device that holds it, when another device does, or
    the holder of the veto that holds it. When several hold it, the holder
    is one of them.

    - down: it is down.
    - not-answered: it has not answered the campaign's target.
    - vetoed: it has a veto of another holder than the campaign.
    - group-failed: it waits behind a member that failed, in a group that
      the failure holds.
    - group-down: it waits behind a member that is down.
    - group-not-answered: it waits behind a member that has not answered.
    - group-vetoed: it waits behind a member that has such a veto.
    - failure-budget: more members have failed than the failure budget.

    A member has failed while its latest report is a failure, and while
    its latest final report is a failed rollback, also when that report
    is lost (lost_n()). With a failure budget, no device starts while more
    members have failed than the budget. The devices in flight finish. The
    waiting devices are held, the plan gives an alarm, and no member is let
    prepare. A member that reports a success after its failure, gets a new
    attempt, or leaves the campaign, no longer counts.

    The observed pace is kept at the scale of the campaign's estimate: an
    upgrade that took twice its device's estimate counts as twice the
    campaign's estimate, and each device's expected duration is its
    estimate at that pace. The pace is the mean time of the last upgrades:
    a round at target-concurrency and a quarter of a round. So at a target
    of several devices one upgrade far from the others moves the pace
    little, a change that every upgrade shows is mostly in the pace after
    one round, and the order in which the upgrades of a round end does not
    make the pace swing. A run
    starts as if the last upgrades took the pace it starts from. An
    upgrade that ends when it was expected to leaves the pace as it is.

    The slow time is the 98th percentile of the times of the last
    upgrades, two rounds at max-concurrency and at least 50, or the pace
    when the pace is longer. A device's slow time is its estimate at that
    slow time. So the margin a window keeps before its close grows when
    slow upgrades show, and one upgrade far longer than the others moves
    it only through the pace. The fast upgrades of a round that end
    together do not push the slow ones of the round before out of view,
    and the slow time does not depend on the concurrency, so a plan gains
    nothing by a higher one.

    A plan runs the step ahead, from the current state, every upgrade
    ending when it is expected to, until nothing more starts. During a
    run, the controller promises each waiting device the window that the
    plan starts it in, in the order of those starts. A window starts the
    devices promised to it first, in the order of the promises, then the
    others in their order. A device that misses its window keeps its
    place in that order and is promised the next window of its schedule.
    A window that an edit takes away before it closes gives each of
    its promises the window of the schedule that has not closed and
    whose opening is nearest its own, the later one of two as near, so
    a window moved by less than half a day that closes after the edit
    keeps its promises on their day. A held device whose promise an
    edit moves keeps it with no alarm; one whose window closes while it is
    held gets the alarm that it lost its promised window.
    A released device that waits again is promised the window it was
    released in, in its place in that order, and first when it had no
    promise. A pause keeps the promises.
    The plan runs at
    target-concurrency, or else at the smallest concurrency up to
    max-concurrency that breaks no more promises than max-concurrency
    does, counting each window a device misses, and, with a deadline,
    leaves no more devices without a start before it. During a run the
    concurrency only rises, until the target falls: then it starts over at
    the target. A lower max-concurrency caps it. The promises a plan
    breaks are its alarms. A device that the run ahead starts in no window
    keeps its promise, and the plan shows it in that window.

    A plan places the members of a spread group in windows as far apart
    as the windows its run ahead uses allow. When it promises windows, a
    later member of the group takes the promise of a device in a later
    window that has the same estimate and is in no group, and that device
    takes the member's promise. In each of the member's groups, that
    window must open after each member before it ends and that group's
    min-separation has passed, and must close, with that min-separation
    after it, before the window of each member after it opens. A member
    ends when it was done, when its upgrade is expected to end, or else
    when the window promised to it closes. The plan keeps the swaps only
    when the run ahead with them breaks no more promises and leaves no
    more devices without a start. A promise made before does not move.
    The members of a pack group, and the members of a spread group in one
    window, go one after the other.

    When every upgrade takes its expected time, a run whose plan has no
    alarm starts every device where and when the plan said. When its only
    alarms are for held devices, the run starts every other device so,
    while the held devices stay held. A plan holds one concurrency for the
    whole run ahead; when it breaks promises, a later decision can find
    that rising then keeps some of them, and the run follows that later
    plan.

    With prepare on, a run lets members prepare: copy their image before
    their window. A member waits to prepare while it is not released, it is
    up, its latest report says that it needs the upgrade, it has a promise,
    it was not let prepare before, it reports no prepare or its prepare
    retrying, and the window promised to it has not opened. Three settings
    say when the members may prepare: before the campaign's first window
    opens (prepare_first), between windows (prepare_between) and during
    windows (prepare_during). The campaign's first window is the first of
    its windows; once it opens in the run, it stays the first window, also
    after it closes (first_open()). A member's deadline before the first
    window is the opening of that window, less the close margin of its
    expected prepare time. With prepare between or during windows, its
    latest deadline is the opening of the window promised to it, less that
    margin; without them, its deadline before the first window is its
    latest. A member whose latest deadline has passed, or that the cap
    leaves no turn by it, cannot prepare in time, and the prepares give an
    alarm for it.

    The members prepare in the free time only (FreeTime): without
    prepare_first, not before the first window opens; with
    prepare_between False, not after that outside the windows, nor in the
    tail before each window closes; and without prepare_during, not while
    a window that the schedules give, or one that holds a member in
    flight, is open, nor in the tail before it opens. The tail is the close
    margin of the longest expected prepare time. So no prepare is planned
    to run into a window, or, with prepare_between False, out of one.
    prepare_between None is automatic: the members may prepare between
    windows, and the prepares say that it is on when a member is let, or
    has a turn, there (Prepares.between).

    Each prepare runs from the second it is let for its expected prepare
    time, at the size of its image divided by that time (prepare_bw). The
    prepares keep the sum of their bandwidths at or under prepare_cap: a
    turn that would take it over comes later, at the start of the first
    debounce slot after enough prepares end. A prepare that alone is over
    the cap runs alone.

    The waiting members take turns on free time. Each decision keeps the
    turns it gives for the next one. A waiting member keeps its turn while
    that turn is ahead, by its latest deadline, free and under the cap: when
    other members join or leave, the others keep their turns. When no member
    has a turn, the turns are new. First go the members that can prepare
    before the first window, by that deadline on free time, then by the
    opening of the window promised to them, the order of their promises and
    the campaign's order. A deadline in the tail before the first window
    counts from the tail's start, so without prepare_during the members of
    the earliest windows go first. The first is now, or the end of the time
    that is not free, or one gap after the last turn let, and each gap is as
    long as it can be while every member left has its turn by its deadline,
    and at least cap_gap() after the turn before it; a turn that the cap
    still holds comes later. The members that the cap leaves no turn before
    the first window follow, by their latest deadline, spread in the same
    way. A member without a turn, new, one whose turn a decision passed, or
    one that the spread leaves without a turn, takes the place that leaves
    the widest gap between the turns, the latest of two as wide, of the
    places that the cap lets it take, before the first window when it can:
    the middle of a time between two turns, or now in the time that holds
    now, for a new member only once the middle has passed. So the turns are
    as far apart as the deadlines allow, no two prepares bunch, and a change
    moves no turn that need not move. A hold of the failure budget, or a
    pause, keeps the turns. A change of the settings or the cap gives every
    waiting member a new turn, from the last turn let; prepare off and on
    again gives new turns from now.

    A decision lets each member whose turn starts its debounce slot by
    then, and none while the time is not free; it wakes at the slot of the
    next turn, and while a member is let also when a window opens, without
    prepare_during, or closes, with prepare_between False. The members
    whose turns are in one slot start
    together. So when nothing comes in, each member is let at the time
    that prepares() showed. A member stops being let when its prepare is
    done or failed, it is released, its latest report no longer says that
    it needs the upgrade, it leaves the campaign, a window that stops it
    opens (without prepare_during any window, and with it the window
    promised to it), with prepare_between False a window closes, prepare
    goes off, the run pauses, or more members have failed than the failure
    budget. A prepare that is retrying keeps its member let: it failed for
    a transient reason, and its device tries it again. A member let that
    reports no prepare, its prepare running or its prepare retrying, is
    let again with the time it was first let once it could be let at a
    turn by its latest deadline and under the cap: after the window
    closes, the pause or the hold ends, or its answer comes back
    (let_again). Its prepare counts from the latest time it was let while
    it reported no prepare or its prepare retrying, or from when its
    prepare ran again after it was retrying, and while it waits to be let
    again, from the second let_again will let it. A member let that
    reports its prepare retrying, or no prepare a debounce after it was
    let, is late once its latest deadline has passed (late_from()): it
    stays let, and the prepares name it. A member that an operator asks to
    prepare again (retry_prepare()) is let at once, as soon as the cap
    lets it, also after its deadline, and keeps the time it was first
    let; it is not let while it is down, inside a time without prepares,
    or once the window promised to it has opened. Only drop() and
    retarget() forget that a member was let. A member let whose prepare is
    done or failed is let again only when an operator asks, and a prepare
    changes nothing in its window.
    Prepares change no release decision: step(), plan() and the quiet time
    read nothing of them."""
    # Configuration.
    # The windows: schedule, start, end, by start. They include the
    # windows that released devices were released in, also when the
    # schedules no longer give them; such a window takes no new devices.
    windows: list[(str, int, int)]
    index: dict[(str, int, int), int]
    # The devices as configure() took them, in the order they start, and
    # their estimates and schedules.
    devices: list[(str, int, str)]
    order: list[str]
    est: dict[str, int]
    schedule_of: dict[str, str]
    # The windows the schedules give.
    current: list[(str, int, int)]
    # The redundancy groups: each group's members, campaign or not; each
    # device's priority; and per group whether it spreads and its
    # min-separation in seconds.
    groups: dict[str, list[str]]
    priority: dict[str, int]
    separation: dict[str, (bool, int)]
    # The groups whose members wait for an operator while a member is
    # failed.
    hold_failed: set[str]
    # Per campaign device: the member right before it in each of its
    # groups, with the group. Per device: its groups of two or more
    # members. Whether any group of two or more campaign devices spreads.
    before: dict[str, list[(str, str)]]
    groups_of: dict[str, list[str]]
    spreads: bool
    target: int
    maxc: int
    # True when every device must start in a window: a deadline that the
    # windows show in full.
    must_place: bool
    debounce: int
    # The campaign's estimated duration: the scale of observed_s.
    estimate_s: int
    # How much of its slow time a device must have left before a window
    # closes to start there, in percent.
    close_margin: int
    # The time over which as many devices as the concurrency start, in
    # percent of the expected upgrade time; 0 starts them at once.
    stagger: int
    # Whether the members may prepare their image before their window,
    # each member's expected prepare time, in seconds, and the longest of
    # them, and the size of each member's image, in bytes.
    prepare: bool
    prepare_est: dict[str, int]
    prepare_longest: int
    prepare_size: dict[str, int]
    # When the members may prepare: before the first window, between
    # windows (None for automatic) and during windows; and the cap of the
    # bandwidth of the prepares, in bits per second, or -1 for none.
    prepare_first: bool
    prepare_between: ?bool
    prepare_during: bool
    prepare_cap: int
    # The most members that may fail, or -1 for no limit.
    failure_budget: int

    # Each device that the controller has state for has a number: the
    # place of its state in the lists below. size is how many devices
    # those lists hold. A copy shares the numbers. Per number, the
    # device's rank by name among the devices with a number; per rank, the
    # number. A device numbered after the last ranking has no rank yet.
    names: Names
    size: int
    rank: list[int]
    by_rank: list[int]
    # -1 per device number, to copy.
    unset: list[int]

    # Derived from the configuration and the state by rebuild().
    # Per device number: whether the device is in the campaign; its
    # estimate, or the campaign's estimate when it is not; the windows it
    # can start in, by start; and whether it is in a redundancy group of
    # two or more devices. A number beyond these lists is a device that is
    # not in the campaign. The numbers of the campaign's devices, in order.
    member: list[bool]
    est_of: list[int]
    wins: list[list[int]]
    grouped: list[bool]
    order_n: list[int]
    # Per window: the devices that can start in it, in order and by
    # estimate; the devices promised to it, in the order of the promises;
    # and each with the place where the devices not looked at yet begin. A
    # device that did not fit is looked at again when the slow time falls.
    queue: list[list[int]]
    by_est: list[list[int]]
    pqueue: list[list[int]]
    qcur: list[int]
    ecur: list[int]
    pcur: list[int]
    # Per window: the place of its schedule in waiting and waiting_est, or
    # -1 when the schedules do not give it. Per schedule with a window: how
    # many of its devices wait (waits()), and their estimates in total. The
    # windows of a schedule have the same waiting devices.
    sched_at: list[int]
    waiting: list[int]
    waiting_est: list[int]
    # Per window: the place of its schedule among the schedules of the
    # windows; whether the schedules give it; and whether its promises
    # have moved on since it closed or the schedules stopped giving it.
    wsched: list[int]
    is_current: list[bool]
    moved: list[bool]
    # The devices a window passed while they waited for their groups; per
    # window the devices to look at again, each once, and those pairs as
    # retry_key(); and the devices that wait for their min-separation to
    # pass, by the time it passes, as entry(): by time, then by name.
    parked: set[int]
    retry: list[list[int]]
    retrying: set[int]
    timed: list[int]
    # How many devices of the campaign are done, also without a release.
    devices_done: int

    # State.
    running: bool
    # Per device number: the time of its final report, NO_TIME without
    # one, and that report's final status, "" without one.
    final_at: list[int]
    final_status: list[str]
    # Per device number: whether its latest report answers the campaign's
    # target.
    answered: list[bool]
    # Per device number: whether its latest report is a failure, or its
    # latest final report is a failed rollback (lost_n()). How many devices
    # of the campaign have one.
    failing: list[bool]
    failures: int
    # The latest prepare state each member reports for the campaign's
    # target: running, done, retrying or failed. It outlives a pause, as
    # final_at does.
    prepare_state: dict[str, str]
    # The members let prepare, with the second they were first let; the
    # members let again while they reported no prepare, with the second
    # they were let again, or with the second their prepare ran again after
    # it was retrying; and the members let prepare now.
    prepare_at: dict[str, int]
    prepare_from: dict[str, int]
    allowed: set[str]
    # The members that an operator asked to prepare again, with the second
    # of the first ask, until they are let (retry_prepare()).
    prepare_now: dict[str, int]
    # The opening of the campaign's first window, in seconds, once the run
    # took it (keep_first()), or -1.
    first_at: int
    # The latest turn of a member let prepare, in microseconds; -1 when no
    # member was let since the turns last ran out. A hold of the failure
    # budget keeps it.
    prep_last: int
    # Per device number: the turn to prepare that the last decision gave
    # it while it waited to prepare, in microseconds, or -1.
    prep_turn: list[int]
    # Per device number: the time the first of its latest in-progress
    # reports came, NO_TIME when its latest report is not in-progress.
    progress: list[int]
    # Per device number: whether it is a released device that still
    # upgraded from before a pause or a restart, or whose run waited to
    # prepare again past its last start (stop_waiting_runs()), which the
    # run keeps holding.
    resumed: list[bool]
    # Per device number whose run waited to try its prepare again since
    # its latest release: NO_TIME while it waits, and else the time of the
    # report that it tried again after its latest wait. Such a device
    # gives no pace sample.
    run_waits: dict[int, int]
    # Per device number: whether it is done and its upgrade failed or
    # rolled back; whether its latest final report is a failed rollback,
    # which only a later final report, a new attempt or a removal clears, also
    # when the report is lost or a run starts: the device keeps that
    # report, and stays done (lost_n()); and whether it is known down;
    # downs counts those.
    failed: list[bool]
    rollback_failed: list[bool]
    down: list[bool]
    downs: int
    # Per device number: the holder of a veto of another holder than the
    # campaign that holds its install, or "".
    vetoed: list[str]
    # Per device number: whether it is a released device that is not done
    # and has a final status: a step marks it done once its report counts.
    reported: list[bool]
    # The devices that reported by when their report came, as entry(): by
    # time, then by name. An entry is stale once its device has not
    # reported or its report came at another time.
    reports: list[int]
    # Per device number: whether it is released; when, in which window, as
    # an index into windows, and at which estimate; and when its upgrade is
    # expected to end.
    released: list[bool]
    released_at: list[int]
    released_in: list[int]
    released_est: list[int]
    due: list[int]
    # Per device number: whether it is a device of the campaign in flight;
    # flights counts them. Per schedule, at its place in wsched: how many of
    # them were released in its windows.
    flying: list[bool]
    flights: int
    in_flight: list[int]
    # The devices in flight without a report, by when their upgrade is
    # expected to end: a heap of due_key(). An entry is stale once its
    # device reported, is done, or is due at another time. The devices
    # that left the heap because their report would have counted by now.
    dues: list[int]
    overdue: set[int]
    # Per device number: when it was done, NO_TIME when it is not; and when
    # the last upgrade that it ran in the run ended, if a new attempt made
    # it wait again after that, or it left the campaign since (drop()),
    # else NO_TIME. ran_until is NO_TIME again when drop() comes while the
    # device is still in an upgrade, or when the device, while it is not
    # released, reports in-progress or answers anything but up-to-date that
    # it did not answer before. ran_end keeps that end: the member is not
    # done before it, and the other members of its redundancy groups wait
    # their group's min-separation after it, or after its done time while
    # it is done without a release (separation_start()).
    done_at: list[int]
    ran_until: list[int]
    ran_end: list[int]
    # Per device number: when its device last booted, by the device's
    # clock, as report_last_boot() says, or NO_TIME when it does not tell.
    last_boot: list[int]
    # Per device number: the window promised to it during a run while it
    # waits, as an index into windows, or -1; and the order of the promises,
    # from 1, and 0 for a device that has had none, which goes first. seq
    # is the next promise's.
    promised: list[int]
    promise_seq: list[int]
    seq: int
    # The waiting members whose promised window closed while they were
    # held, until they start.
    lost_promises: set[int]
    # How many promises moved on, or ended with no window left: a run
    # ahead counts its own.
    moves: int
    # The last slow_samples(maxc) upgrades' times, at the scale of the
    # campaign's estimate, the place of the next one, and the sum of the
    # last pace_samples() of them. The observed pace is their mean, and
    # the slow time is taken from all of them.
    took_s: list[int]
    took_at: int
    took_sum: int
    observed_s: int
    slow_s: int
    # How many devices the ramp lets be in flight.
    rung: int
    c: int
    # When the last device started, in microseconds, -1 before the first,
    # and its estimate. The stagger lets the next device start a gap after
    # it. held is true when the last step had slots free and a device that
    # the stagger held.
    last_start: int
    last_est: int
    held: bool
    # The last plan when a decision can take it again: made during a run,
    # with its promises settled and no alarm other than for held devices.
    # From the step at quiet_from until quiet_until the run ahead only
    # starts devices; anything that comes in ends that time.
    last_plan: ?Plan
    quiet_from: int
    quiet_until: int
    # The members in flight without a report that are down, by the first
    # second in which they are past their expected end, as due_key() is by
    # the due time. An entry is stale once its device is up, has reported
    # or is done. The wake of the last decision, -1 for none.
    down_ends: list[int]
    wake_at: int

    pure def __init__(self):
        self.windows = []
        self.index = {}
        self.devices = []
        self.order = []
        self.est = {}
        self.schedule_of = {}
        self.current = []
        self.groups = {}
        self.priority = {}
        self.separation = {}
        self.hold_failed = set()
        self.before = {}
        self.groups_of = {}
        self.spreads = False
        self.target = 1
        self.maxc = 1
        self.must_place = False
        self.debounce = 0
        self.close_margin = CLOSE_MARGIN
        self.stagger = 0
        self.prepare = False
        self.prepare_est = {}
        self.prepare_longest = 1
        self.prepare_size = {}
        self.prepare_first = True
        self.prepare_between = None
        self.prepare_during = False
        self.prepare_cap = -1
        self.failure_budget = -1
        self.estimate_s = 1
        self.names = Names()
        self.size = 0
        self.rank = []
        self.by_rank = []
        self.unset = []
        self.member = []
        self.est_of = []
        self.wins = []
        self.grouped = []
        self.order_n = []
        self.queue = []
        self.by_est = []
        self.pqueue = []
        self.qcur = []
        self.ecur = []
        self.pcur = []
        self.sched_at = []
        self.waiting = []
        self.waiting_est = []
        self.wsched = []
        self.is_current = []
        self.moved = []
        self.parked = set()
        self.retry = []
        self.retrying = set()
        self.timed = []
        self.devices_done = 0
        self.running = False
        self.final_at = []
        self.final_status = []
        self.answered = []
        self.failing = []
        self.failures = 0
        self.prepare_state = {}
        self.prepare_at = {}
        self.prepare_from = {}
        self.allowed = set()
        self.prepare_now = {}
        self.first_at = -1
        self.prep_last = -1
        self.prep_turn = []
        self.progress = []
        self.resumed = []
        self.run_waits = {}
        self.failed = []
        self.rollback_failed = []
        self.vetoed = []
        self.down = []
        self.downs = 0
        self.reported = []
        self.reports = []
        self.released = []
        self.released_at = []
        self.released_in = []
        self.released_est = []
        self.due = []
        self.flying = []
        self.flights = 0
        self.in_flight = []
        self.dues = []
        self.overdue = set()
        self.done_at = []
        self.ran_until = []
        self.ran_end = []
        self.last_boot = []
        self.promised = []
        self.promise_seq = []
        self.seq = 1
        self.lost_promises = set()
        self.moves = 0
        self.observed_s = 1
        self.took_s = [1]
        self.took_at = 0
        self.took_sum = 1
        self.slow_s = 1
        self.rung = 1
        self.c = 1
        self.last_start = -1
        self.last_est = 0
        self.held = False
        self.last_plan = None
        self.quiet_from = 0
        self.quiet_until = 0
        self.down_ends = []
        self.wake_at = -1

    def grow(self, n: int) -> None:
        """Make room in the per-device state lists for the devices with a
        number below n, each with no state."""
        while self.size < n:
            self.final_at.append(NO_TIME)
            self.final_status.append("")
            self.answered.append(False)
            self.failing.append(False)
            self.progress.append(NO_TIME)
            self.resumed.append(False)
            self.failed.append(False)
            self.rollback_failed.append(False)
            self.vetoed.append("")
            self.down.append(False)
            self.reported.append(False)
            self.released.append(False)
            self.released_at.append(0)
            self.released_in.append(-1)
            self.released_est.append(0)
            self.due.append(0)
            self.flying.append(False)
            self.done_at.append(NO_TIME)
            self.ran_until.append(NO_TIME)
            self.ran_end.append(NO_TIME)
            self.last_boot.append(NO_TIME)
            self.promised.append(-1)
            self.promise_seq.append(0)
            self.prep_turn.append(-1)
            self.unset.append(-1)
            self.size += 1

    def number(self, name: str) -> int:
        """The number of a device, with room for its state."""
        k = self.names.number(name)
        if k >= self.size:
            self.grow(k + 1)
        return k

    def known(self, name: str) -> int:
        """The number of a device that the controller may have state for,
        or -1 when it has none."""
        k = self.names.num.get(name)
        if k is not None and k < self.size:
            return k
        return -1

    def entry(self, at: int, k: int) -> int:
        """The heap entry of the device with number k at time at, which
        orders by time, then by name."""
        if k >= len(self.rank):
            self.rerank()
        return at * SCALE + self.rank[k]

    def entry_device(self, e: int) -> int:
        """The number of the device of the heap entry e."""
        return self.by_rank[e % SCALE]

    def rerank(self) -> None:
        """Rank every device with a number by name, and give the entries in
        reports and timed the new ranks."""
        old = self.by_rank
        order = sorted([(self.name_of(k), k) for k in range(self.size)])
        by_rank = [e.1 for e in order]
        rank = [0 for _k in range(self.size)]
        for r in range(len(by_rank)):
            rank[by_rank[r]] = r
        # A sorted list is a heap.
        self.reports = sorted([e // SCALE * SCALE + rank[old[e % SCALE]] for e in self.reports])
        self.timed = sorted([e // SCALE * SCALE + rank[old[e % SCALE]] for e in self.timed])
        self.rank = rank
        self.by_rank = by_rank

    def name_of(self, k: int) -> str:
        """The name of the device with number k."""
        return self.names.names[k]

    def is_member(self, k: int) -> bool:
        """True when the device with number k is in the campaign."""
        return k >= 0 and k < len(self.member) and self.member[k]

    def est_n(self, k: int) -> int:
        """The estimate of the device with number k: the campaign's
        estimate when it is not in the campaign."""
        if k >= 0 and k < len(self.est_of):
            return self.est_of[k]
        return self.estimate_s

    def wins_of(self, k: int) -> list[int]:
        """The windows the device with number k can start in, by start; none
        for -1."""
        if k >= 0 and k < len(self.wins):
            return self.wins[k]
        return []

    def in_group(self, k: int) -> bool:
        """True when the device with number k is in a redundancy group of
        two or more devices."""
        if k < len(self.grouped):
            return self.grouped[k]
        return self.name_of(k) in self.groups_of

    def waits(self, k: int) -> bool:
        """True when the device with number k is a member that waits: not
        released, and without a final status."""
        return self.final_at[k] == NO_TIME and not self.released[k] and self.is_member(k)

    def done_unreleased(self, k: int) -> bool:
        """True when the device with number k is a member that is done
        without a release: not released, and with a final status."""
        return self.final_at[k] != NO_TIME and not self.released[k] and self.is_member(k)

    def failed_unreleased(self, k: int) -> bool:
        """True when the device with number k is done without a release, and
        its final status is a failure."""
        return self.done_unreleased(k) and is_failure(self.final_status[k])

    def configure(self, windows: list[(str, int, int)], devices: list[(str, int, str)],
                  target: int, maxc: int, must_place: bool, debounce: int,
                  estimate_s: int, groups: dict[str, list[str]]={},
                  priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
                  close_margin: int=CLOSE_MARGIN, stagger: int=0, prepare: bool=False,
                  prepare_est: dict[str, int]={}, failure_budget: int=-1,
                  hold_failed: ?set[str]=None, prepare_size: dict[str, int]={},
                  prepare_first: bool=True, prepare_between: ?bool=None,
                  prepare_during: bool=False, prepare_cap: int=-1) -> None:
        """Take the windows the schedules give, the devices as (name,
        estimated duration, schedule) in the order they start, the target
        and the max concurrency, whether every device must start in a
        window, the debounce in seconds, the campaign's estimated
        duration, the redundancy groups of the devices as their members,
        the priority of each device, per group whether it spreads and its
        min-separation in seconds, the close margin in percent of the slow
        time, the stagger in percent of the expected upgrade time, whether
        the members may prepare, each member's expected prepare time in
        seconds, the most members that may fail, below 0 for no limit, the
        groups that hold on a failure, none when None, the size of each
        member's image in bytes, whether the members may prepare before the
        first window, between windows (None for automatic) and during
        windows, and the cap of the bandwidth of the prepares in bits per
        second, below 0 for none. A group without a separation packs with
        none. A lower target starts the concurrency over at the target, and
        the ramp at most at the target. Other new limits keep the
        concurrency: the next plan keeps it between the target and the max
        concurrency. New limits keep the last upgrade times, and the pace
        and the slow time are taken from them again. Prepare and the
        prepare settings change no release decision. When prepare goes off,
        no member is let prepare any more, and the turns go. When the
        settings of when the members may prepare or the cap change, the
        turns go, and the next decision gives the members that wait to
        prepare new turns from the last turn let."""
        self.prepare_est = prepare_est
        longest = 1
        for v in prepare_est.values():
            longest = imax(longest, v)
        self.prepare_longest = longest
        self.prepare_size = prepare_size
        if prepare != self.prepare:
            self.prepare = prepare
            if not prepare:
                self.allowed = set()
                self.prep_last = -1
                self.clear_turns()
        cap = imax(-1, prepare_cap)
        if prepare_first != self.prepare_first or prepare_between != self.prepare_between \
           or prepare_during != self.prepare_during or cap != self.prepare_cap:
            self.prepare_first = prepare_first
            self.prepare_between = prepare_between
            self.prepare_during = prepare_during
            self.prepare_cap = cap
            self.clear_turns()
        m = imax(target, maxc)
        e = imax(1, estimate_s)
        margin = imax(100, close_margin)
        st = imax(0, stagger)
        budget = imax(-1, failure_budget)
        hold: set[str] = hold_failed if hold_failed is not None else set()
        same_groups = False
        if groups == self.groups and priority == self.priority and separation == self.separation \
           and hold == self.hold_failed:
            same_groups = True
        if windows == self.current and devices == self.devices and target == self.target \
           and m == self.maxc and must_place == self.must_place \
           and debounce == self.debounce and e == self.estimate_s and same_groups \
           and margin == self.close_margin and st == self.stagger \
           and budget == self.failure_budget:
            return
        self.quiet_until = 0
        self.failure_budget = budget
        retarget = target != self.target
        if target < self.target:
            self.c = target
            self.rung = imin(self.rung, target)
        if e != self.estimate_s:
            # Keep the observed pace at the scale of the new estimate.
            for k in range(len(self.took_s)):
                self.took_s[k] = imax(1, self.took_s[k] * e // self.estimate_s)
            self.took_sum = self.pace_sum()
            self.observed_s = imax(1, self.took_sum // self.pace_count())
            self.take_slow()
            self.estimate_s = e
        self.stagger = st
        self.current = windows
        self.devices = devices
        self.order = [d.0 for d in devices]
        est: dict[str, int] = {}
        schedule_of: dict[str, str] = {}
        for d in devices:
            est[d.0] = imax(1, d.1)
            schedule_of[d.0] = d.2
            self.number(d.0)
        self.est = est
        self.schedule_of = schedule_of
        self.groups = groups
        self.priority = priority
        self.separation = separation
        self.hold_failed = hold
        self.target = target
        self.maxc = m
        self.must_place = must_place
        self.debounce = debounce
        self.close_margin = margin
        if retarget or len(self.took_s) != slow_samples(m):
            self.keep_times(slow_samples(m))
        self.rebuild()

    def start(self, rung: ?int=None, observed_s: ?int=None) -> None:
        """Run, and after a pause (stop()) carry the run on from where it
        was. The released devices keep their release, the ones that are
        done their done time and their failure, the waiting ones their
        promises in their order, and the pace, the slow time, the ramp, the
        concurrency, the last start of the stagger and the prepares stay.
        The ramp is set to rung devices, and the observed pace and the slow
        time to observed_s, when they are given; on a new controller they
        are one device and the campaign's estimate.

        A released device that is not done keeps its slot while its final
        report has not counted yet: the next step counts it at the time it
        came. While it reports in-progress, it still upgrades, and the run
        keeps holding it (resumed). A released device that does neither did
        not start its run: it waits again, promised the window it was
        released in (take_back). The run takes in flight each waiting
        device that reports in-progress (take_running). The members let
        prepare in the run keep the time they were let, and the members that
        wait to prepare keep their turns. The callers stop letting prepare
        the members that may no longer prepare (revoke_prepares), and let
        again the ones that may (let_again)."""
        self.running = True
        self.held = False
        self.quiet_until = 0
        if observed_s is not None:
            self.set_pace(imax(1, observed_s))
        if rung is not None:
            self.rung = rung
        for k in range(self.size):
            if self.released[k] and self.done_at[k] == NO_TIME and not self.reported[k]:
                if self.progress[k] != NO_TIME:
                    self.resumed[k] = True
                else:
                    self.unrelease(k)
        self.rebuild()
        for k in self.order_n:
            at = self.progress[k]
            if at != NO_TIME:
                self.take_running(k, at)

    def carried_on(self, t: int) -> Controller:
        """A copy of this controller that runs from time t, as a campaign
        that goes to run at t runs it: started, no longer letting prepare
        the members that may no longer prepare at t, and letting again the
        members let before that may prepare at t. Its plan at t is what the
        run does: before the first run, a run that starts at t; in a pause,
        the run that carries on."""
        c = self.copy()
        c.start()
        c.keep_first(t)
        c.revoke_prepares(t)
        c.let_again(t)
        return c

    def set_pace(self, pace: int) -> None:
        """Set the observed pace and the slow time to pace, as if each of
        the last upgrades took that time."""
        self.took_s = [pace for _k in range(slow_samples(self.maxc))]
        self.took_at = 0
        self.took_sum = pace * self.pace_count()
        self.observed_s = pace
        self.slow_s = pace

    def keep_times(self, n: int) -> None:
        """Keep the newest n upgrade times, older places taking the pace
        when fewer are kept, and take the pace and the slow time from them
        again."""
        m = len(self.took_s)
        # Oldest first: the next place to write holds the oldest time.
        times = [self.took_s[(self.took_at + j) % m] for j in range(m)]
        if n <= m:
            self.took_s = times[m - n:]
        else:
            self.took_s = [self.observed_s for _k in range(n - m)] + times
        self.took_at = 0
        self.took_sum = self.pace_sum()
        self.observed_s = imax(1, self.took_sum // self.pace_count())
        self.take_slow()

    def take_slow(self) -> None:
        """Take the slow time from the kept upgrade times."""
        self.slow_s = slow_time(self.took_s, self.observed_s)

    def pace_count(self) -> int:
        """How many of the kept upgrade times the pace is the mean of."""
        return imin(len(self.took_s), pace_samples(self.target))

    def pace_sum(self) -> int:
        """The sum of the last pace_count() upgrade times."""
        n = len(self.took_s)
        total = 0
        for j in range(self.pace_count()):
            total += self.took_s[(self.took_at - 1 - j + n) % n]
        return total

    def stop(self) -> None:
        """Pause the run: no member is let prepare. All that the run knows
        stays, the promises and their order included, so that start()
        carries the run on. A plan made in the pause gives no promises and
        runs at the target concurrency; the plan of a copy that runs
        (carried_on) is what the run does when it goes on."""
        self.running = False
        self.allowed = set()
        self.quiet_until = 0

    def resume(self, name: str, at: int, win: (str, int, int)) -> None:
        """Take a device that was released at time at, in the window win,
        before the first step of the run. It holds its slot until it is
        done."""
        i = self.index.get(win)
        if i is not None:
            k = self.number(name)
            self.release(k, at, i)
            self.lost_promises.discard(k)
            self.quiet_until = 0

    def take_running(self, k: int, at: int) -> None:
        """Take in flight the waiting device with number k, which reported
        in-progress at time at: it still upgrades from before a restart, or
        it was taken back and its report came late. It is
        released at at in the first window of its schedule that had not
        closed then, and holds its slot and its redundancy groups until it
        is done. A device whose schedule has no such window stays held. A
        released device stays as it is."""
        if self.released[k]:
            return
        for j in self.wins_of(k):
            if at < self.windows[j].2:
                self.release(k, at, j)
                self.resumed[k] = True
                self.lost_promises.discard(k)
                self.quiet_until = 0
                return

    def take_back(self, k: int) -> None:
        """The released device with number k stopped before its install, or
        has a veto of another holder and has not started its run: it waits
        again, as if it had not been released, promised the window it was
        released in (unrelease)."""
        self.unrelease(k)
        self.quiet_until = 0
        self.rebuild()

    def unrelease(self, k: int) -> None:
        """Make the released device with number k wait again, promised the
        window it was released in, with its place in the order of the
        promises: before the devices promised that window after it, and
        first when it had no promise. When that window has closed, the
        promise moves on to the next window of its schedule, and keeps its
        place in the order of the promises there: before the devices
        promised that window after it (move_promises). The counts and queues
        are stale until the next rebuild()."""
        self.promised[k] = self.released_in[k]
        self.resumed[k] = False
        self.released[k] = False
        self.released_at[k] = 0
        self.released_in[k] = -1
        self.released_est[k] = 0
        self.due[k] = 0
        self.reported[k] = False

    def retarget(self, names: set[str]) -> None:
        """Take a new target release for the members in names, such as a new
        version of their image, or none for a member that leaves the fleet.
        The campaign gives a new version only to a member that it has not let
        prepare or released, or that it let prepare or released in a decision
        that an edit overtook. Each forgets its prepare state, that it was let
        prepare, an ask to prepare again and its turn to prepare: a prepare
        of the old target is no prepare of the new one. A member released for
        the old target that has no final report waits again, promised the
        window it was released in (unrelease()). A waiting member keeps its
        promise. A member with a final status waits again when that status
        goes, as the reports for the new target say."""
        if len(names) == 0:
            return
        for name in names:
            self.prepare_state.pop(name)
            self.prepare_at.pop(name)
            self.prepare_from.pop(name)
            self.prepare_now.pop(name)
            self.allowed.discard(name)
            k = self.known(name)
            if k < 0:
                continue
            self.prep_turn[k] = -1
            if self.released[k] and self.done_at[k] == NO_TIME and not self.reported[k]:
                self.unrelease(k)
        self.quiet_until = 0
        self.rebuild()

    def drop(self, names: set[str]) -> None:
        """Forget all that the run knows of the devices in names, which left
        the campaign or have a new attempt: their release, their reports
        and answers, their prepares, asks to prepare again and turns to
        prepare, and whether they are done or failed.
        configure() alone keeps this for a device that leaves, so that its
        report still counts. A device that joins the campaign again, or that
        has a new attempt, is then a new member: it waits until it answers,
        and starts in a window. Each keeps the end of the last upgrade that
        it ran in the run (ran_until, ran_end): for a released device, when
        it was done, or when its final report came if that report has not
        counted yet. So when its device answers that it is up to date, the
        min-separation of its groups counts from the end of that upgrade,
        not from the answer, and it never counts from before then.
        A released device without a final report is still in its upgrade,
        and the end of that upgrade is not known: it keeps no new end, and
        its done time is that of a member without the end of an upgrade
        (done_time_of())."""
        if len(names) == 0:
            return
        for name in names:
            self.prepare_state.pop(name)
            self.prepare_at.pop(name)
            self.prepare_from.pop(name)
            self.prepare_now.pop(name)
            self.allowed.discard(name)
            k = self.known(name)
            if k < 0:
                continue
            self.prep_turn[k] = -1
            self.run_waits.pop(k)
            if self.released[k]:
                end = self.done_at[k]
                if end == NO_TIME and self.reported[k]:
                    end = self.final_at[k]
                if end == NO_TIME:
                    # Still in its upgrade.
                    self.ran_until[k] = NO_TIME
                else:
                    self.ran_until[k] = imax(self.ran_until[k], end)
                    self.ran_end[k] = imax(self.ran_end[k], end)
            self.released[k] = False
            self.released_at[k] = 0
            self.released_in[k] = -1
            self.released_est[k] = 0
            self.due[k] = 0
            self.done_at[k] = NO_TIME
            self.final_at[k] = NO_TIME
            self.final_status[k] = ""
            self.progress[k] = NO_TIME
            self.promised[k] = -1
            self.promise_seq[k] = 0
            self.lost_promises.discard(k)
            self.answered[k] = False
            self.failing[k] = False
            self.resumed[k] = False
            self.failed[k] = False
            self.rollback_failed[k] = False
            self.reported[k] = False
            self.overdue.discard(k)
        self.quiet_until = 0
        self.rebuild()

    def rebuild(self) -> None:
        """Derive the windows, queues and counts from the configuration
        and the state."""
        if len(self.rank) < self.size:
            self.rerank()
        old = self.windows
        current: set[(str, int, int)] = set()
        keys: set[(str, int, int)] = set()
        for w in self.current:
            current.add(w)
            keys.add(w)
        for k in range(self.size):
            if self.released[k]:
                keys.add(old[self.released_in[k]])
        for k in range(self.size):
            p = self.promised[k]
            if p >= 0 and not self.released[k] and self.final_at[k] == NO_TIME:
                w = old[p]
                if w not in current and w.0 == self.schedule_of.get_def(self.name_of(k), ""):
                    keys.add(w)
        windows = [(k.1, k.0, k.2) for k in sorted([(w.1, w.0, w.2) for w in keys])]
        index: dict[(str, int, int), int] = {}
        queue: list[list[int]] = []
        sched_at: list[int] = []
        waiting: list[int] = []
        waiting_est: list[int] = []
        by_schedule: dict[str, list[int]] = {}
        place: dict[str, int] = {}
        for i in range(len(windows)):
            w = windows[i]
            index[w] = i
            queue.append([])
            if w in current:
                if w.0 not in by_schedule:
                    by_schedule[w.0] = []
                    place[w.0] = len(waiting)
                    waiting.append(0)
                    waiting_est.append(0)
                by_schedule[w.0].append(i)
                sched_at.append(place[w.0])
            else:
                sched_at.append(-1)
        # Each released device keeps its window, at its new index.
        for k in range(self.size):
            if self.released[k]:
                self.released_in[k] = index[old[self.released_in[k]]]
        n = self.size
        member = [False for _k in range(n)]
        est_of = [self.estimate_s for _k in range(n)]
        wins: list[list[int]] = [[] for _k in range(n)]
        grouped = [False for _k in range(n)]
        order_n: list[int] = []
        promised = [-1 for _k in range(n)]
        by_promise: list[list[(int, str, int)]] = [[] for _w in windows]
        for name in self.order:
            k = self.names.num[name]
            order_n.append(k)
            member[k] = True
            est_of[k] = self.est[name]
            ws = by_schedule.get_def(self.schedule_of[name], [])
            wins[k] = ws
            if len(ws) > 0:
                # The windows of a schedule share one queue.
                queue[ws[0]].append(k)
            pending = not self.released[k] and self.final_at[k] == NO_TIME
            if len(ws) > 0 and pending:
                q = sched_at[ws[0]]
                waiting[q] += 1
                waiting_est[q] += self.est[name]
            # A promise holds to a window of the device's schedule; one to
            # a window the schedules no longer give moves on at the next
            # step.
            p = self.promised[k]
            if p >= 0 and pending and old[p].0 == self.schedule_of[name]:
                i = index[old[p]]
                promised[k] = i
                by_promise[i].append((self.promise_seq[k], name, k))
        # Each group's campaign devices in order: priority, then name.
        before: dict[str, list[(str, str)]] = {}
        groups_of: dict[str, list[str]] = {}
        spreads = False
        for g, members in self.groups.items():
            ordered = sorted([(self.priority.get_def(m, 0), m) for m in members if m in self.est])
            if self.separation.get_def(g, (False, 0)).0 and len(ordered) > 1:
                spreads = True
            for j in range(1, len(ordered)):
                name = ordered[j].1
                if name not in before:
                    before[name] = []
                before[name].append((ordered[j - 1].1, g))
            if len(members) > 1:
                for m in members:
                    if m not in groups_of:
                        groups_of[m] = []
                    groups_of[m].append(g)
        for name in groups_of.keys():
            k = self.known(name)
            if k >= 0:
                grouped[k] = True
        scheds: dict[str, int] = {}
        wsched: list[int] = []
        for w in windows:
            if w.0 not in scheds:
                scheds[w.0] = len(scheds)
            wsched.append(scheds[w.0])
        flying = [False for _k in range(n)]
        flights = 0
        in_flight = [0 for _s in scheds]
        devices_done = 0
        failures = 0
        for k in range(n):
            if member[k] and self.failing[k]:
                failures += 1
            if self.released[k] and member[k]:
                if self.done_at[k] != NO_TIME:
                    devices_done += 1
                else:
                    flying[k] = True
                    flights += 1
                    in_flight[wsched[self.released_in[k]]] += 1
            elif member[k] and self.final_at[k] != NO_TIME:
                # Done without a release.
                devices_done += 1
        self.windows = windows
        self.index = index
        self.member = member
        self.est_of = est_of
        self.wins = wins
        self.grouped = grouped
        self.order_n = order_n
        self.queue = queue
        by_est: list[list[int]] = [[] for _w in windows]
        for ws in by_schedule.values():
            q = queue[ws[0]]
            e_q = [e.2 for e in sorted([(est_of[k], self.name_of(k), k) for k in q])]
            for i in ws:
                queue[i] = q
                by_est[i] = e_q
        self.by_est = by_est
        self.pqueue = [[e.2 for e in sorted(b)] for b in by_promise]
        self.qcur = [0 for _w in windows]
        self.ecur = [0 for _w in windows]
        self.pcur = [0 for _w in windows]
        self.sched_at = sched_at
        self.waiting = waiting
        self.waiting_est = waiting_est
        self.wsched = wsched
        self.is_current = [w in current for w in windows]
        self.moved = [False for _w in windows]
        self.parked = set()
        self.retry = [[] for _w in windows]
        self.retrying = set()
        self.timed = []
        self.before = before
        self.groups_of = groups_of
        self.spreads = spreads
        self.promised = promised
        self.flying = flying
        self.flights = flights
        self.in_flight = in_flight
        self.dues = sorted([self.due_key(k) for k in range(n)
                            if flying[k] and not self.reported[k]])
        self.overdue = set()
        self.devices_done = devices_done
        self.failures = failures

    def report(self, name: str, status: ?str, at: int, rollback_failed: bool=False) -> None:
        """Take the latest status of a device, which came at time at, and
        whether a failed status ended in a failed rollback. A final report
        after another final report keeps the time of the first. A failed
        device that reports a success is done again at that time, and no
        longer holds the other members of its groups. A device that is not
        released and reports a new final status that is not a failure is
        done at that report too. The device has answered the campaign's
        target while its latest status is an answer. A waiting device that
        reports in-progress during a run still upgrades, and the run takes
        it in flight (take_running). If it reports upgrade-needed before it
        is done, it stopped before its install, and it waits again
        (take_back). So does a released device with a veto of another
        holder that reports upgrade-needed."""
        k = self.known(name)
        if k < 0:
            if status is None or not (is_final(status) or is_answer(status)
                                      or status == "in-progress"):
                # No state to keep.
                return
            k = self.number(name)
        self.report_n(k, status, at, rollback_failed)

    def report_n(self, k: int, status: ?str, at: int, rollback_failed: bool=False) -> None:
        """report() for the device with number k."""
        if not self.released[k] and status != "up-to-date" \
           and status != self.final_status[k] \
           and (status == "in-progress" or is_answer(status)):
            # The device was not done at the end of an earlier upgrade:
            # its done time counts from its answer or its boot
            # (done_time_of()). A report of the final status that it had,
            # as the campaign gives after a pause, does not say so.
            self.ran_until[k] = NO_TIME
        if status is not None and is_final(status):
            self.take_failing(k, is_failure(status))
            stuck = rollback_failed and status == "failed"
            if stuck != self.rollback_failed[k]:
                self.rollback_failed[k] = stuck
                self.quiet_until = 0
                if not stuck:
                    self.wake_members(k)
            if self.final_at[k] == NO_TIME:
                waited = self.waits(k)
                self.final_at[k] = at
                self.final_status[k] = status
                if self.released[k] and self.done_at[k] == NO_TIME:
                    self.reported[k] = True
                    heap_push(self.reports, self.entry(at, k))
                elif waited:
                    self.take_done(k, True)
                self.quiet_until = 0
            elif not is_failure(status) and self.final_status[k] != status:
                self.final_status[k] = status
                if not self.released[k]:
                    # Done at its latest answer. It no longer holds the
                    # other members of its groups after a failure, and the
                    # time from which they wait the min-separation after it
                    # can change (separation_start()).
                    self.final_at[k] = imax(self.final_at[k], at)
                    self.wake_waiting(k)
                self.quiet_until = 0
            if self.failed[k] and not is_failure(status):
                self.failed[k] = False
                # The min-separation of its groups counts from the success.
                self.done_at[k] = imax(self.done_at[k], at)
                self.wake_members(k)
                self.quiet_until = 0
        elif self.final_at[k] != NO_TIME:
            self.lost_n(k)
        if status == "in-progress":
            if self.progress[k] == NO_TIME:
                self.progress[k] = at
        elif self.progress[k] != NO_TIME:
            self.progress[k] = NO_TIME
        if status == "upgrade-needed" and self.released[k] and self.done_at[k] == NO_TIME \
           and (self.resumed[k] or self.vetoed[k] != ""):
            self.take_back(k)
        self.take_answer(k, is_answer(status))
        if status == "in-progress" and self.running and self.is_member(k) \
           and not self.released[k]:
            self.take_running(k, self.progress[k])

    def take_answer(self, k: int, answers: bool) -> None:
        """Take whether the latest status of the device with number k
        answers the campaign's target. A waiting device that starts to
        answer is looked at again, once its groups let it start. A change of
        answer of a waiting device ends the quiet time; a released device's
        answer counts for nothing, so its change does not."""
        if answers == self.answered[k]:
            return
        if answers:
            self.answered[k] = True
            if k in self.parked and self.gate(k) >= 0:
                self.parked.discard(k)
                self.look_again(k)
        else:
            self.answered[k] = False
        if self.is_member(k) and not self.released[k]:
            self.quiet_until = 0

    def take_failing(self, k: int, failing: bool) -> None:
        """Take whether the device with number k has failed: its latest
        report is a failure, or its latest final report is a failed
        rollback, also when that report is lost (lost_n()). Count the
        members that have failed. A new count ends the quiet time when more
        members have failed than the failure budget before it or after it:
        the starts stop or go on, or the plan's alarm gives the new
        count."""
        if failing == self.failing[k]:
            return
        over = self.over_budget()
        self.failing[k] = failing
        if self.is_member(k):
            if failing:
                self.failures += 1
            else:
                self.failures -= 1
            if over or self.over_budget():
                self.quiet_until = 0

    def over_budget(self) -> bool:
        """True when more members have failed than the failure budget:
        their latest report is a failure, or their latest final report is
        a failed rollback (take_failing())."""
        return self.failure_budget >= 0 and self.failures > self.failure_budget

    def report_prepare(self, name: str, state: ?str, at: int=-1) -> None:
        """Take the latest prepare state of a member for the campaign's
        target: running, done, retrying or failed, or None when it reports
        none. A retrying prepare failed for a transient reason, and its
        device tries it again. When a retrying prepare reports running at
        the second at, 0 or later, it counts from then (prepare_from). It
        changes no release decision, so the quiet time stays."""
        if state is not None:
            if at >= 0 and state == "running" and self.prepare_state.get(name) == "retrying":
                self.prepare_from[name] = at
            self.prepare_state[name] = state
        else:
            self.prepare_state.pop(name)

    def retry_prepare(self, name: str, t: int) -> None:
        """Take that an operator asked the member name at the second t to
        prepare again. let_again() lets it at once, as soon as the cap lets
        it and outside the times without prepares, also after its deadline,
        and it keeps the second it was first let. The first ask counts until
        it is let, and its turn goes. The caller reports the prepare of the
        new ask first, so a prepare of an earlier one no longer counts."""
        k = self.known(name)
        if k < 0:
            return
        if name not in self.prepare_now:
            self.prepare_now[name] = t
        self.prep_turn[k] = -1

    def report_prepare_wait(self, name: str, waits: bool, at: int) -> None:
        """Take whether the latest report of the device name, which came at
        time at, says that its run waits: to try its prepare again, after the
        prepare failed for a transient reason, or for its device, which could
        not be read. The run waits until a report in-progress says that it
        tried again, at the time of that report. A report of another status,
        or none, does not end the wait: the device can still start the run
        once it can. A decision holds the run again when it waits, or tried
        again, past the last second at which a try fits its window
        (stop_waiting_runs()). A device whose run waited in its flight gives
        no pace sample for that flight."""
        k = self.known(name)
        if k < 0:
            return
        if waits:
            self.run_waits[k] = NO_TIME
        elif self.progress[k] != NO_TIME and k in self.run_waits \
             and self.run_waits[k] == NO_TIME:
            self.run_waits[k] = at

    def report_last_boot(self, name: str, at: ?int) -> None:
        """Take when the device name last booted, by its clock, or None when
        it does not tell. A boot before 0 counts as 0, as the controller has
        no earlier times. Only a device that the controller knows keeps it:
        configure() knows every member. The done time of a member done
        without a release can follow the boot (done_time_of()). So when its
        boot changes, the waiting members of its groups are looked at again,
        also the ones that wait for the min-separation from its old done
        time, and the quiet time ends."""
        k = self.known(name)
        if k < 0:
            return
        boot = NO_TIME
        if at is not None:
            boot = imax(0, at)
        if boot == self.last_boot[k]:
            return
        self.last_boot[k] = boot
        if self.done_unreleased(k) and self.in_group(k):
            self.wake_waiting(k)
            self.quiet_until = 0

    def lost(self, name: str) -> None:
        """Forget the status of a device."""
        k = self.known(name)
        if k >= 0:
            self.lost_n(k)

    def lost_n(self, k: int) -> None:
        """lost() for the device with number k. A device whose rollback
        failed keeps its final status: it is in an unknown state, so it
        stays done and failed, also without a release, and holds its
        groups until a later final report, a new attempt or a removal. It
        counts against the failure budget until then too."""
        self.take_answer(k, False)
        if not self.rollback_failed[k]:
            self.take_failing(k, False)
        self.progress[k] = NO_TIME
        if self.final_at[k] != NO_TIME and not self.rollback_failed[k]:
            done = self.done_unreleased(k)
            self.final_at[k] = NO_TIME
            self.final_status[k] = ""
            self.reported[k] = False
            if self.flying[k]:
                heap_push(self.dues, self.due_key(k))
            if done:
                self.take_done(k, False)
            self.quiet_until = 0

    def take_done(self, k: int, done: bool) -> None:
        """Take whether the member with number k, which is not released, is
        done: its status became final, or, when done is false, its final
        status went and it waits again. A member that is done counts in no
        window and gives up its promise. A member that waits again is looked
        at again once it answers and its groups let it start. The other
        members of its groups are looked at again too: a member that is done
        without a release holds no one unless it failed, and when it waits
        again, the others may wait less for it (separation_start())."""
        wins = self.wins_of(k)
        n = 1 if done else -1
        if len(wins) > 0:
            q = self.sched_at[wins[0]]
            self.waiting[q] -= n
            self.waiting_est[q] -= n * self.est_n(k)
        self.devices_done += n
        if done:
            i = self.promised[k]
            if i >= 0:
                self.unqueue(k, i)
            self.promised[k] = -1
            self.lost_promises.discard(k)
            self.wake_members(k)
        else:
            self.parked.add(k)
            self.wake_waiting(k)

    def unqueue(self, k: int, i: int) -> None:
        """Take the device with number k out of the promises of window i. A
        device promised the window again later gets a new place at the end,
        so its old place must go. The walk through the promises keeps its
        place."""
        q = self.pqueue[i]
        for j in range(len(q)):
            if q[j] == k:
                self.pqueue[i] = q[:j] + q[j + 1:]
                if j < self.pcur[i]:
                    self.pcur[i] -= 1
                return

    def lost_all(self) -> None:
        """Forget the status and the prepare state of every device. A member
        that was done without a release waits again. A device whose
        rollback failed keeps its final status, and a member whose rollback
        failed still counts against the failure budget (lost_n()). A run
        that waits to try its prepare again still waits
        (report_prepare_wait())."""
        n = self.size
        for k in range(n):
            if not self.rollback_failed[k]:
                self.final_at[k] = NO_TIME
                self.final_status[k] = ""
                self.reported[k] = False
        self.answered = [False for _k in range(n)]
        self.failing = [self.rollback_failed[k] for k in range(n)]
        self.failures = len([k for k in range(n) if self.failing[k] and self.is_member(k)])
        self.prepare_state = {}
        self.progress = [NO_TIME for _k in range(n)]
        # A sorted list is a heap.
        self.reports = sorted([e for e in self.reports if self.in_reports(e)])
        self.quiet_until = 0
        self.rebuild()

    def set_live(self, name: str, live: bool) -> bool:
        """Take whether a device is up. A device that comes back up is
        looked at again, and so are the members of its groups, once their
        groups let them start. A change ends the quiet time for a member
        that waits and for a device in a redundancy group, but not for a
        member in flight without a report. Its change ends the quiet time
        only when it was past its expected end at the last step.
        Return True when the campaign must decide before the wake of the
        last decision: the quiet time ends, or a member in flight goes down
        and is past its expected end more than a debounce before that
        wake."""
        k = self.known(name)
        if live:
            if k < 0 or not self.down[k]:
                return False
            self.down[k] = False
            self.downs -= 1
            if k in self.parked and self.gate(k) >= 0:
                self.parked.discard(k)
                self.look_again(k)
            self.wake_members(k)
        else:
            if k < 0:
                k = self.number(name)
            if self.down[k]:
                return False
            self.down[k] = True
            self.downs += 1
        if self.flying[k] and not self.reported[k]:
            # It holds no one, and the plan expects it back up when its
            # upgrade ends.
            end = self.expected_end(k)
            if end < self.quiet_from:
                self.quiet_until = 0
                return True
            if live:
                return False
            heap_push(self.down_ends, (end + 1) * SCALE + k)
            return self.wake_at < 0 or end + 1 + self.debounce < self.wake_at
        if self.waits(k) or self.in_group(k):
            self.quiet_until = 0
            return True
        return False

    def set_vetoed(self, name: str, holder: str) -> bool:
        """Take the holder of a veto of another holder than the campaign
        that the device name has, or "" for none. A waiting device with
        such a veto is held, and is looked at again when the veto goes. A
        released device that has not started its run waits again: its
        device does not install while the veto holds. Return True when the
        campaign must decide."""
        k = self.known(name)
        if k < 0:
            if holder == "":
                return False
            k = self.number(name)
        if holder == self.vetoed[k]:
            return False
        self.vetoed[k] = holder
        if holder == "":
            if k in self.parked and self.gate(k) >= 0:
                self.parked.discard(k)
                self.look_again(k)
        elif self.released[k] and self.done_at[k] == NO_TIME \
             and self.final_at[k] == NO_TIME and self.progress[k] == NO_TIME:
            self.take_back(k)
        if self.is_member(k):
            self.quiet_until = 0
            return True
        return False

    def separation_of(self, g: str) -> int:
        """The min-separation of group g: the time from when one member is
        done until the next may start."""
        return self.separation.get_def(g, (False, 0)).1

    def failure_holds(self, k: int, g: str) -> bool:
        """True when a failure of the device with number k holds the other
        members of group g: g holds on a failure, or the rollback of the
        device failed, which leaves it in an unknown state."""
        return g in self.hold_failed or self.rollback_failed[k]

    def holds(self, name: str, g: str) -> bool:
        """True when the device name holds the other members of group g: it
        is in flight or down, or it failed, also without a release, and its
        failure holds g."""
        k = self.known(name)
        return k >= 0 and (self.flying[k] or self.down[k]
                           or ((self.failed[k] or self.failed_unreleased(k))
                               and self.failure_holds(k, g)))

    def done_time_of(self, name: str) -> int:
        """When the device name was done, or -1 when it is not. A member done
        without a release that is up to date was done at the end of the
        upgrade that it ran in the run (ran_until). One with another final
        status was done at its final report, and not before the end of that
        upgrade. When the device tells when it last booted
        (report_last_boot()), the member was done at the boot if that came
        later. Without the end of an upgrade, as when an answer of its device
        took that end away (ran_until), it was done at the boot, or without a
        boot at its answer or its final report. A member that upgraded in the
        run was not done before the end of that upgrade (ran_end), also when
        its device booted before then."""
        k = self.known(name)
        if k >= 0 and self.done_at[k] != NO_TIME:
            return self.done_at[k]
        if k >= 0 and self.done_unreleased(k):
            boot = self.last_boot[k]
            if self.ran_until[k] == NO_TIME:
                done = boot if boot != NO_TIME else self.final_at[k]
                return imax(done, self.ran_end[k])
            end = self.ran_until[k]
            if self.final_status[k] != "up-to-date":
                end = imax(self.final_at[k], end)
            return imax(end, boot)
        return -1

    def prior(self, name: str) -> list[(str, str)]:
        """The members that the campaign device name waits for in each of
        its groups, with the group: the member right before it, and, while
        that member is done without a release, the member before that one,
        and so on, up to the first member that is not. The device waits the
        group's min-separation from the done time of each (done_time_of())."""
        out: list[(str, str)] = []
        for b in self.before.get_def(name, []):
            m = b.0
            while m != "":
                k = self.names.num[m]
                out.append((m, b.1))
                if not self.done_unreleased(k):
                    break
                nxt = ""
                for x in self.before.get_def(m, []):
                    if x.1 == b.1:
                        nxt = x.0
                m = nxt
        return out

    def gate(self, k: int) -> int:
        """The time from which the waiting device with number k may start,
        or -1 while it must wait: while it has not answered the campaign's
        target, while it is down or vetoed, or while its redundancy groups
        hold it. A group holds it while the member before it in the group is not
        done, or another member of the group is in flight or down, or
        failed and its failure holds the group.
        The time is when the members before it were done (prior()), and the
        group's min-separation after that. It is also not before the
        group's min-separation after each other member of the group, before
        or after it in the group, that ran an upgrade in the run, or that
        is done without a release with a final status other than
        up-to-date: after its done time, or, while that member is not done,
        after the end of that upgrade (separation_start())."""
        if not self.answered[k] or self.down[k] or self.vetoed[k] != "":
            return -1
        if not self.in_group(k):
            return 0
        name = self.name_of(k)
        gs = self.groups_of[name]
        at = 0
        for b in self.prior(name):
            done = self.done_time_of(b.0)
            if done < 0:
                return -1
            at = imax(at, done + self.separation_of(b.1))
        for g in gs:
            sep = self.separation_of(g)
            for q in self.groups[g]:
                if self.holds(q, g):
                    return -1
                j = self.known(q)
                if j >= 0 and j != k:
                    end = self.separation_start(j)
                    if end != NO_TIME:
                        at = imax(at, end + sep)
        return at

    def separation_start(self, k: int) -> int:
        """The time from which the other waiting members of the groups of
        the device with number k wait their group's min-separation after it
        in gate(), whether they come before or after it in the group, or
        NO_TIME when they do not wait for it. It is when the device was
        done, while it keeps its release. While it is done without a
        release, it is its done time (done_time_of()) when it ran an upgrade
        in the run, or when its final status is not up-to-date: it succeeded
        or failed, for example before a restart. Else it is the end of the
        last upgrade that it ran in the run, which it keeps after it waits
        again or leaves (ran_end), or NO_TIME when it ran none. So the
        others do not wait for a member that is up to date and ran no
        upgrade in the run."""
        if self.done_at[k] != NO_TIME:
            return self.done_at[k]
        if self.done_unreleased(k) \
           and (self.ran_end[k] != NO_TIME or self.final_status[k] != "up-to-date"):
            return self.done_time_of(self.name_of(k))
        return self.ran_end[k]

    def wake_members(self, k: int) -> None:
        """Look again at the devices of the groups of the device with
        number k, itself included, that a window passed while they waited
        for their groups, once their groups let them start."""
        if not self.in_group(k):
            return
        for g in self.groups_of[self.name_of(k)]:
            for d in self.groups[g]:
                j = self.known(d)
                if j >= 0 and j in self.parked and self.gate(j) >= 0:
                    self.parked.discard(j)
                    self.look_again(j)

    def wake_waiting(self, k: int) -> None:
        """Look again at each other waiting member of the groups of the
        device with number k, also the ones that wait for a time that has
        not come: the time from which they wait the min-separation after it
        can have changed (separation_start(), done_time_of())."""
        if not self.in_group(k):
            return
        for g in self.groups_of[self.name_of(k)]:
            for d in self.groups[g]:
                j = self.known(d)
                if j >= 0 and j != k and self.waits(j):
                    self.parked.discard(j)
                    self.look_again(j)

    def look_again(self, k: int) -> None:
        """Look at the waiting device with number k again in each of its
        windows."""
        if not self.released[k]:
            for j in self.wins_of(k):
                self.retry_in(j, k)

    def retry_key(self, i: int, k: int) -> int:
        """The entry in retrying of the device with number k in window i."""
        return i * SCALE + k

    def retry_in(self, i: int, k: int) -> None:
        """Look at the device with number k again in window i, unless it is
        already to be looked at again there."""
        e = self.retry_key(i, k)
        if e not in self.retrying:
            self.retrying.add(e)
            self.retry[i].append(k)

    def is_waiting(self, name: str) -> bool:
        """True when the device name is a member that waits (waits())."""
        k = self.known(name)
        return k >= 0 and self.waits(k)

    def waiting_members(self, devs: list[str], failures: bool=False) -> list[(str, str)]:
        """The waiting campaign devices that the devices devs hold, each
        as (device, holder), in the order of devs: each device of devs that
        waits itself, then the other waiting campaign devices of its
        groups. When failures is true, the devices devs failed, and a
        device holds only the groups that its failure holds."""
        out: list[(str, str)] = []
        for x in devs:
            if self.is_waiting(x):
                out.append((x, x))
            for g in self.groups_of.get_def(x, []):
                if failures and not self.failure_holds(self.names.num[x], g):
                    continue
                for d in self.groups[g]:
                    if d != x and self.is_waiting(d):
                        out.append((d, x))
        return out

    def stuck(self) -> (list[(int, str, str)], set[int]):
        """The held devices, in the campaign's order, each as (number,
        reason, holder): the device that holds it, the holder of its veto,
        or "" for neither; and the ones among them that wait for a device that failed or
        is down. A device held in its groups holds the members after it in
        its other groups, for the same reason and holder. A device that has
        not answered, or that has a veto of another holder, holds only the
        members after it in its groups. A failure report holds the other
        members of the groups that the failure holds at once, before a step
        marks the device done. A member that is down while it upgrades holds
        no one until it reports. A member done without a release is not
        held, and holds the others only when it is down, or failed and its
        failure holds the group."""
        later: dict[str, list[str]] = {}
        for name in self.before.keys():
            if self.waits(self.names.num[name]):
                for b in self.prior(name):
                    if b.0 not in later:
                        later[b.0] = []
                    later[b.0].append(name)
        failed: list[str] = []
        down: list[str] = []
        for k in range(self.size):
            if self.failed[k] or (self.reported[k] and is_failure(self.final_status[k])) \
               or self.failed_unreleased(k):
                failed.append(self.name_of(k))
            if self.down[k] and (not self.flying[k] or self.reported[k]):
                down.append(self.name_of(k))
        unanswered: list[(str, str)] = []
        vetoed: list[(str, str)] = []
        for k in self.order_n:
            if not self.released[k] and not self.answered[k]:
                unanswered.append((self.name_of(k), self.name_of(k)))
            elif self.waits(k) and self.vetoed[k] != "":
                vetoed.append((self.name_of(k), self.name_of(k)))
        behind_failed = follow(self.waiting_members(failed, True), later)
        behind_down = follow(self.waiting_members(down), later)
        behind_unanswered = follow(unanswered, later)
        behind_vetoed = follow(vetoed, later)
        over = self.over_budget()
        out: list[(int, str, str)] = []
        park: set[int] = set()
        for k in self.order_n:
            if not self.waits(k):
                continue
            name = self.name_of(k)
            reason = ""
            holder = ""
            if self.down[k]:
                reason = "down"
            elif not self.answered[k]:
                reason = "not-answered"
            elif self.vetoed[k] != "":
                reason = "vetoed"
                holder = self.vetoed[k]
            elif name in behind_failed:
                reason = "group-failed"
                holder = behind_failed[name]
            elif name in behind_down:
                reason = "group-down"
                holder = behind_down[name]
            elif name in behind_unanswered:
                reason = "group-not-answered"
                holder = behind_unanswered[name]
            elif name in behind_vetoed:
                reason = "group-vetoed"
                holder = behind_vetoed[name]
            elif over:
                reason = "failure-budget"
            if reason != "":
                out.append((k, reason, holder))
            if name in behind_failed or name in behind_down:
                park.add(k)
        return (out, park)

    def duration(self, k: int) -> int:
        """The expected duration of the upgrade of the device with number k
        at the observed pace."""
        return imax(1, self.est_n(k) * self.observed_s // self.estimate_s)

    def slow(self, k: int) -> int:
        """The slow time of the upgrade of the device with number k: its
        estimate at the slow time of the last upgrades."""
        return imax(1, self.est_n(k) * self.slow_s // self.estimate_s)

    def fits(self, k: int, t: int, end: int) -> bool:
        """True when the device with number k, started at t, has its close
        margin left before end: its slow time times close_margin percent."""
        return end == OPEN_END or (end - t) * 100 >= self.slow(k) * self.close_margin

    def last_fit(self, k: int, end: int) -> int:
        """The last second at which the device with number k, started then,
        fits before end (fits()); OPEN_END when end is OPEN_END."""
        if end == OPEN_END:
            return OPEN_END
        return end - (self.slow(k) * self.close_margin + 99) // 100

    def late_at(self, k: int) -> int:
        """The time after which the released device with number k is late
        when it has no final report: a fifth of its upgrade after its
        upgrade was expected to end, and not before its report could have
        counted."""
        return self.due[k] + imax(self.debounce, self.duration(k) // 5)

    def expected_end(self, k: int) -> int:
        """When the upgrade of the released device with number k is
        expected to end: its release and its expected duration after
        that."""
        return self.released_at[k] + self.duration(k)

    def promise(self, k: int, t: int) -> int:
        """The window promised to the device with number k, as an index,
        while that window is open or yet to open; -1 without one."""
        i = self.promised[k]
        if i >= 0 and t < self.windows[i].2:
            return i
        return -1

    def release(self, k: int, t: int, i: int) -> None:
        """Release the device with number k at time t in window i: it waits
        in no window any more and holds a slot until it is done. Only
        resume() releases a device with a final status: a member that was
        done without a release is done again when its report counts."""
        self.released[k] = True
        self.released_at[k] = t
        self.released_in[k] = i
        self.released_est[k] = self.est_n(k)
        self.due[k] = t + self.duration(k)
        self.run_waits.pop(k)
        member = self.is_member(k)
        if member:
            if not self.flying[k]:
                self.flying[k] = True
                self.flights += 1
            self.in_flight[self.wsched[i]] += 1
        if self.final_at[k] != NO_TIME:
            if member:
                self.devices_done -= 1
            self.reported[k] = True
            heap_push(self.reports, self.entry(self.final_at[k], k))
            return
        wins = self.wins_of(k)
        if len(wins) > 0:
            q = self.sched_at[wins[0]]
            self.waiting[q] -= 1
            self.waiting_est[q] -= self.est_n(k)
        if member:
            heap_push(self.dues, self.due_key(k))

    def waiting_in(self, i: int) -> int:
        """How many devices that can start in window i wait."""
        q = self.sched_at[i]
        return self.waiting[q] if q >= 0 else 0

    def move_promises(self, t: int) -> list[int]:
        """Move the promises of the devices still waiting for a window that
        has closed, or that the schedules no longer give, in the same place
        in the order of the promises. A window that has closed gives its
        promises the next window of their schedule. A window that has not
        closed, which an edit of the schedule, the notice or the deadline
        took away, gives each promise the window of its schedule that has
        not closed and whose opening is nearest its own, the later one of
        two as near: a window moved by less than half a day that closes
        after the edit keeps its promises on their day. Return the devices
        whose promised window closed while they waited, as numbers."""
        moved: list[int] = []
        moves: dict[int, list[(int, str, int)]] = {}
        for i in range(len(self.windows)):
            win = self.windows[i]
            if self.moved[i] or (t < win.2 and self.is_current[i]):
                continue
            self.moved[i] = True
            closed = win.2 <= t
            for k in self.pqueue[i]:
                if not self.released[k] and self.promised[k] == i:
                    nxt = -1
                    # The windows go by opening, so <= takes the later of
                    # two as near.
                    for j in self.wins_of(k):
                        w = self.windows[j]
                        if j != i and t < w.2 and (nxt < 0 or (
                                not closed
                                and abs(w.1 - win.1) <= abs(self.windows[nxt].1 - win.1))):
                            nxt = j
                    self.promised[k] = nxt
                    if nxt >= 0:
                        if nxt not in moves:
                            moves[nxt] = []
                        moves[nxt].append((self.promise_seq[k], self.name_of(k), k))
                    self.moves += 1
                    if closed:
                        moved.append(k)
        for j, ms in moves.items():
            # Both lists are in the order of the promises.
            q = self.pqueue[j]
            merged: list[int] = []
            first = -1
            a = 0
            for m in sorted(ms):
                while a < len(q) and self.promise_seq[q[a]] < m.0:
                    merged.append(q[a])
                    a += 1
                if first < 0:
                    first = len(merged)
                merged.append(m.2)
            while a < len(q):
                merged.append(q[a])
                a += 1
            self.pqueue[j] = merged
            self.pcur[j] = imin(self.pcur[j], first)
        return moved

    def fill(self, i: int, t: int, slots: int, started: list[int], c: int) -> int:
        """Start devices in the open window i at time t, at most slots of
        them, at concurrency c: first the devices promised to it, in the
        order of the promises, then the ones promised no window, the ones
        looked at again first. Return the slots left, 0 when the stagger
        holds the next device. A device that does not fit is
        not looked at again in this window until the slow time falls; one
        that waits for its groups is looked at again when they let it
        start."""
        end = self.windows[i].2
        # Nothing fits when the shortest waiting device does not.
        q = self.by_est[i]
        k = self.ecur[i]
        while k < len(q) and self.released[q[k]]:
            k += 1
        self.ecur[i] = k
        if k >= len(q) or not self.fits(q[k], t, end):
            return slots
        again = self.retry[i]
        self.retry[i] = []
        for d in again:
            self.retrying.discard(self.retry_key(i, d))
        n = slots
        # The devices looked at again that are promised this window, in
        # the order of the promises, merged with the ones not looked at yet.
        mine = sorted([(self.promise_seq[d], self.name_of(d), d) for d in again
                       if self.promise(d, t) == i])
        a = 0
        q = self.pqueue[i]
        k = self.pcur[i]
        while a < len(mine) or (n > 0 and k < len(q)):
            if a < len(mine) and (n == 0 or k >= len(q)
                                  or mine[a].0 < self.promise_seq[q[k]]):
                n = self.try_start(mine[a].2, i, t, end, n, started, c)
                a += 1
            else:
                d = q[k]
                k += 1
                if self.promise(d, t) == i:
                    n = self.try_start(d, i, t, end, n, started, c)
        self.pcur[i] = k
        for d in again:
            if self.promise(d, t) < 0:
                n = self.try_start(d, i, t, end, n, started, c)
        q = self.queue[i]
        k = self.qcur[i]
        while n > 0 and k < len(q):
            d = q[k]
            k += 1
            if self.promise(d, t) < 0:
                n = self.try_start(d, i, t, end, n, started, c)
        self.qcur[i] = k
        return n

    def try_start(self, k: int, i: int, t: int, end: int, n: int,
                  started: list[int], c: int) -> int:
        """Start the device with number k in window i at t if it waits,
        gate() lets it start, it fits and the stagger at concurrency c lets
        it start. Park it while it must wait for its answer or its groups,
        and keep it until its separation has passed. Return the slots left,
        0 when the stagger holds it."""
        if self.released[k] or self.final_at[k] != NO_TIME:
            # Released, or done without a release.
            return n
        if n == 0:
            # No slot left: look at it again in a later step.
            self.retry_in(i, k)
            return n
        at = self.gate(k)
        if at < 0:
            self.parked.add(k)
            return n
        if at > t:
            heap_push(self.timed, self.entry(at, k))
            return n
        if self.fits(k, t, end):
            if self.stagger > 0:
                first = self.first_start(t, c)
                if first >= (t + 1) * MICRO:
                    # Look at it again when the stagger lets it start.
                    self.retry_in(i, k)
                    return 0
                self.last_start = first
                self.last_est = self.est_n(k)
            self.release(k, t, i)
            started.append(k)
            return n - 1
        return n

    def count(self, t: int) -> int:
        """Take the reports that count by time t: mark the devices that
        are done, take the pace and the slow time again, and look again at
        the devices that waited for t. Returns how many devices are done
        without a failure."""
        slow = self.slow_s
        sampled = False
        succeeded = 0
        # The reports that count by now, in the order they came.
        while len(self.reports) > 0:
            fr = self.reports[0]
            if not self.in_reports(fr):
                heap_pop(self.reports)
                continue
            end = fr // SCALE
            if end + self.debounce > t:
                break
            heap_pop(self.reports)
            k = self.entry_device(fr)
            self.reported[k] = False
            at = self.released_at[k]
            self.done_at[k] = end
            if is_failure(self.final_status[k]):
                self.failed[k] = True
            # At the scale of the campaign's estimate; an upgrade that
            # ends when it was expected to leaves the pace as it is. An
            # upgrade that ran through a pause or from before a restart
            # (resumed) is no fair sample of the pace: the campaign's veto
            # came back, and it may have stopped and started again. Neither
            # is one that waited to prepare again: its time is the wait's.
            if not self.resumed[k] and k not in self.run_waits \
               and (not self.released[k] or end != self.due[k]):
                est = self.released_est[k] if self.released[k] else self.estimate_s
                took = imax(1, imax(1, end - at) * self.estimate_s // est)
                n = len(self.took_s)
                p = self.pace_count()
                self.took_sum += took - self.took_s[(self.took_at - p + n) % n]
                self.took_s[self.took_at] = took
                self.took_at = (self.took_at + 1) % n
                self.observed_s = imax(1, self.took_sum // p)
                sampled = True
            if self.flying[k]:
                self.flying[k] = False
                self.flights -= 1
                self.in_flight[self.wsched[self.released_in[k]]] -= 1
                self.devices_done += 1
                if not is_failure(self.final_status[k]):
                    succeeded += 1
            self.wake_members(k)

        while len(self.timed) > 0 and self.timed[0] // SCALE <= t:
            self.look_again(self.entry_device(heap_pop(self.timed)))

        if sampled:
            self.take_slow()
        if self.slow_s < slow:
            # Devices that did not fit may fit now.
            self.qcur = [0 for _w in self.windows]
            self.ecur = [0 for _w in self.windows]
            self.pcur = [0 for _w in self.windows]
        return succeeded

    def start_gap(self, est: int, c: int) -> int:
        """The time from the start of a device with estimate est to the
        next start at concurrency c, in microseconds: the stagger's part of
        the device's expected upgrade time, divided by c."""
        expected = imax(1, est * self.observed_s // self.estimate_s)
        return self.stagger * expected * (MICRO // 100) // imax(1, c)

    def first_start(self, t: int, c: int) -> int:
        """The time from which the stagger at concurrency c lets a device
        start at the second t, in microseconds: a gap after the last start,
        and not before t. When the last step held a device, a step that
        comes later than its turn starts it as of its turn, so the devices
        whose turn has passed all start at t."""
        if self.last_start < 0:
            return t * MICRO
        nxt = self.last_start + self.start_gap(self.last_est, c)
        if self.held:
            return nxt
        return imax(t * MICRO, nxt)

    def step(self, t: int, c: int) -> (list[str], int, bool):
        """Decide at time t at concurrency c: take the reports that count,
        grow the ramp, start what fits, unless more members have failed
        than the failure budget, and say when to decide next. Returns the
        started devices, the wake and whether every device is done."""
        started, wake, finished = self.step_n(t, c)
        return ([self.name_of(k) for k in started], wake, finished)

    def step_n(self, t: int, c: int) -> (list[int], int, bool):
        """step() with the started devices as numbers."""
        succeeded = self.count(t)
        if self.rung < c:
            self.rung = imin(c, self.rung + 3 * succeeded)

        self.move_promises(t)
        started: list[int] = []
        n = imin(self.rung, c) - self.flights
        if self.over_budget():
            n = 0
        # True when the stagger holds back devices that wait in an open
        # window while slots are left.
        held_back = False
        wake = -1
        # The schedules with an open window that has devices waiting, in the
        # order their first such window opens, each with those windows in
        # the order they open.
        turns: list[str] = []
        open_of: dict[str, list[int]] = {}
        for i in range(len(self.windows)):
            win = self.windows[i]
            if self.waiting_in(i) > 0 and win.1 <= t and t < win.2:
                if win.0 not in open_of:
                    turns.append(win.0)
                    open_of[win.0] = []
                open_of[win.0].append(i)
        if n > 0 and len(turns) > 0 and self.stagger > 0 and self.held \
           and self.first_start(t, c) >= (t + 1) * MICRO:
            # The last step held a start: nothing starts before its turn.
            held_back = True
        # Share the free slots, then start each schedule's share in its open
        # windows, the schedule that takes the first slot first. A schedule
        # that cannot use all of its share starts nothing more now; the
        # slots it leaves are shared again between the others.
        while n > 0 and len(turns) > 0 and not held_back:
            share = [n]
            order = [(0, 0)]
            if len(turns) > 1:
                # One schedule takes every free slot; more share them.
                levels = [self.in_flight[self.wsched[open_of[name][0]]] for name in turns]
                weights = self.need_weights(turns, open_of, t, c)
                # The schedules that need a slot share them; the others wait
                # for the slots those leave.
                needy = [k for k in range(len(turns)) if weights[k] < NO_SHARE]
                share = [0 for _k in turns]
                some = shares([levels[k] for k in needy], [weights[k] for k in needy], n)
                for q in range(len(needy)):
                    share[needy[q]] = some[q]
                order = sorted([((2 * levels[k] + 1) * weights[k], k)
                                for k in range(len(turns))])
            keep: list[str] = []
            for e in order:
                k = e.1
                left = share[k]
                if not held_back:
                    for i in open_of[turns[k]]:
                        if left > 0 and not held_back:
                            before = len(started)
                            rest = self.fill(i, t, left, started, c)
                            took = len(started) - before
                            n -= took
                            left -= took
                            if rest == 0 and left > 0:
                                # The stagger holds the next start.
                                held_back = True
                if held_back or left == 0:
                    keep.append(turns[k])
            if len(keep) == len(turns):
                break
            turns = [name for name in turns if name in keep]
        for i in range(len(self.windows)):
            if self.waiting_in(i) == 0:
                continue
            win = self.windows[i]
            if win.1 > t:
                if wake < 0 or win.1 < wake:
                    wake = win.1
            elif t < win.2 and win.2 != OPEN_END:
                if wake < 0 or win.2 < wake:
                    wake = win.2
        if len(self.timed) > 0 and (wake < 0 or self.timed[0] // SCALE < wake):
            wake = self.timed[0] // SCALE
        # Until quiet the run ahead only starts devices: no report counts,
        # no device is due, and no window opens or closes.
        quiet = wake
        fl = self.flying_times(t)
        wake = earliest(wake, fl.0)
        quiet = earliest(quiet, fl.1)
        self.held = held_back
        if held_back:
            # The second in which the next device may start. A decision
            # after it starts that device later than the run ahead did.
            w = self.first_start(t, c) // MICRO
            wake = earliest(wake, w)
            quiet = earliest(quiet, w + 1)
        self.quiet_from = t
        self.quiet_until = quiet if quiet >= 0 else OPEN_END
        if len(self.lost_promises) > 0:
            # A member that lost its promised window leaves the plan's
            # alarm when it starts.
            for k in started:
                if k in self.lost_promises:
                    self.lost_promises.discard(k)
                    self.quiet_until = 0
        return (started, wake, self.devices_done >= len(self.est))

    def need_weights(self, turns: list[str], open_of: dict[str, list[int]], t: int,
                     c: int) -> list[int]:
        """The weight of each schedule in turns, whose open windows open_of
        gives, at time t and concurrency c, for shares(): a thousand times
        the total of what the schedules need, divided by its own need. When
        none needs anything before the first last start, their waiting
        upgrade time takes the place of the needs. A schedule that needs
        nothing gets NO_SHARE. A schedule's last start is the close of its
        last open window less the close margin of its mean waiting device;
        a window that never closes has none."""
        work: list[int] = []
        ends: list[int] = []
        for name in turns:
            # Each open window of a schedule has the same waiting devices.
            wins = open_of[name]
            k = self.sched_at[wins[0]]
            work.append(imax(1, self.waiting_est[k] * self.observed_s // self.estimate_s))
            mean = self.waiting_est[k] // imax(1, self.waiting[k])
            margin = mean * self.slow_s // self.estimate_s * self.close_margin // 100
            end = 0
            for j in wins:
                close = self.windows[j].2
                end = imax(end, OPEN_END if close == OPEN_END else close - margin)
            ends.append(end)
        part = window_needs(work, ends, t, c)
        total = 0
        for x in part:
            total += x
        if total == 0:
            part = work
            for x in part:
                total += x
        return [NO_SHARE if x == 0 else imin(NO_SHARE - 1, imax(1, total * 1000 // x))
                for x in part]

    def flying_times(self, t: int) -> (int, int):
        """For the devices in flight at time t: the next time to decide for
        them, and the time until which the run ahead takes no report from
        them; -1 for none. A device that is late is expected to take one
        more upgrade from t."""
        w = -1
        q = -1
        # A report counts one debounce after it came. The report of a device
        # no longer in the campaign counts too: it takes the pace. The first
        # report gives q, and the first of a device in flight gives w.
        aside: list[int] = []
        while len(self.reports) > 0:
            e = self.reports[0]
            if not self.in_reports(e):
                heap_pop(self.reports)
                continue
            r = imax(e // SCALE + self.debounce, t + 1)
            q = earliest(q, r)
            if self.flying[self.entry_device(e)]:
                w = r
                break
            aside.append(heap_pop(self.reports))
        for e in aside:
            heap_push(self.reports, e)
        # The devices whose report would have counted by now leave the heap.
        while len(self.dues) > 0:
            e = self.dues[0]
            if not self.in_dues(e):
                heap_pop(self.dues)
            elif e // SCALE + self.debounce <= t:
                heap_pop(self.dues)
                self.overdue.add(e % SCALE)
            else:
                break
        for k in list(self.overdue):
            if not self.flying[k] or self.reported[k]:
                self.overdue.discard(k)
            elif self.late_at(k) < t:
                # Late: one more upgrade from now.
                self.due[k] = t + self.duration(k)
                heap_push(self.dues, self.due_key(k))
                self.overdue.discard(k)
            else:
                # Its report could have counted: decide when it is late.
                w = earliest(w, self.late_at(k) + 1)
                q = earliest(q, self.due[k])
        if len(self.dues) > 0:
            # When its report counts if it comes when expected.
            w = earliest(w, self.dues[0] // SCALE + self.debounce)
            q = earliest(q, self.dues[0] // SCALE)
        return (w, q)

    def in_reports(self, e: int) -> bool:
        """True when e is the entry in reports of a device that reported."""
        k = self.entry_device(e)
        return self.reported[k] and self.final_at[k] == e // SCALE

    def due_key(self, k: int) -> int:
        """The entry in dues of the device with number k: its due time and
        its number as one number, which orders by due time first."""
        return self.due[k] * SCALE + k

    def in_dues(self, e: int) -> bool:
        """True when e is the entry in dues of a device in flight without a
        report."""
        k = e % SCALE
        return self.flying[k] and not self.reported[k] and self.due[k] == e // SCALE

    def take_due(self, now: int) -> list[int]:
        """Take from dues the devices in flight without a report whose
        upgrade is expected to have ended by now, as numbers."""
        out: list[int] = []
        for k in self.overdue:
            if self.flying[k] and not self.reported[k]:
                out.append(k)
        while len(self.dues) > 0 and self.dues[0] // SCALE <= now:
            e = heap_pop(self.dues)
            if self.in_dues(e):
                out.append(e % SCALE)
        return out

    def copy(self) -> Controller:
        """A controller with this one's configuration and a copy of its
        state, to run ahead without changing this one."""
        c = Controller()
        c.windows = self.windows
        c.index = self.index
        c.devices = self.devices
        c.order = self.order
        c.est = self.est
        c.schedule_of = self.schedule_of
        c.current = self.current
        c.groups = self.groups
        c.priority = self.priority
        c.separation = self.separation
        c.hold_failed = self.hold_failed
        c.before = self.before
        c.groups_of = self.groups_of
        c.spreads = self.spreads
        c.target = self.target
        c.maxc = self.maxc
        c.must_place = self.must_place
        c.debounce = self.debounce
        c.estimate_s = self.estimate_s
        c.close_margin = self.close_margin
        c.stagger = self.stagger
        c.prepare = self.prepare
        c.prepare_est = self.prepare_est
        c.prepare_longest = self.prepare_longest
        c.prepare_size = self.prepare_size
        c.prepare_first = self.prepare_first
        c.prepare_between = self.prepare_between
        c.prepare_during = self.prepare_during
        c.prepare_cap = self.prepare_cap
        c.failure_budget = self.failure_budget
        c.names = self.names
        c.size = self.size
        c.rank = self.rank
        c.by_rank = self.by_rank
        c.unset = self.unset
        c.member = self.member
        c.est_of = self.est_of
        c.wins = self.wins
        c.grouped = self.grouped
        c.order_n = self.order_n
        c.queue = self.queue
        c.by_est = self.by_est
        c.pqueue = [q.copy() for q in self.pqueue]
        c.qcur = self.qcur.copy()
        c.ecur = self.ecur.copy()
        c.pcur = self.pcur.copy()
        c.sched_at = self.sched_at
        c.waiting = self.waiting.copy()
        c.waiting_est = self.waiting_est.copy()
        c.parked = copy_set(self.parked)
        c.retry = [r.copy() for r in self.retry]
        c.retrying = copy_set(self.retrying)
        c.timed = self.timed.copy()
        c.wsched = self.wsched
        c.is_current = self.is_current
        c.moved = self.moved.copy()
        c.devices_done = self.devices_done
        c.running = self.running
        c.final_at = self.final_at.copy()
        c.final_status = self.final_status.copy()
        # The run ahead reports into its copy.
        c.answered = self.answered.copy()
        c.failing = self.failing.copy()
        c.failures = self.failures
        c.prepare_state = {k: v for k, v in self.prepare_state.items()}
        c.prepare_at = {k: v for k, v in self.prepare_at.items()}
        c.prepare_from = {k: v for k, v in self.prepare_from.items()}
        c.allowed = copy_set(self.allowed)
        c.prepare_now = {k: v for k, v in self.prepare_now.items()}
        c.first_at = self.first_at
        c.prep_last = self.prep_last
        c.prep_turn = self.prep_turn.copy()
        c.progress = self.progress.copy()
        c.resumed = self.resumed.copy()
        c.run_waits = {k: v for k, v in self.run_waits.items()}
        c.failed = self.failed.copy()
        c.rollback_failed = self.rollback_failed.copy()
        c.vetoed = self.vetoed.copy()
        c.down = self.down.copy()
        c.downs = self.downs
        c.reported = self.reported.copy()
        c.reports = self.reports.copy()
        c.released = self.released.copy()
        c.released_at = self.released_at.copy()
        c.released_in = self.released_in.copy()
        c.released_est = self.released_est.copy()
        c.due = self.due.copy()
        c.flying = self.flying.copy()
        c.flights = self.flights
        c.in_flight = self.in_flight.copy()
        c.dues = self.dues.copy()
        c.overdue = copy_set(self.overdue)
        c.done_at = self.done_at.copy()
        c.ran_until = self.ran_until.copy()
        c.ran_end = self.ran_end.copy()
        c.last_boot = self.last_boot.copy()
        c.promised = self.promised.copy()
        c.promise_seq = self.promise_seq.copy()
        c.seq = self.seq
        c.lost_promises = copy_set(self.lost_promises)
        c.moves = self.moves
        c.observed_s = self.observed_s
        c.took_s = self.took_s.copy()
        c.took_at = self.took_at
        c.took_sum = self.took_sum
        c.slow_s = self.slow_s
        c.rung = self.rung
        c.c = self.c
        c.last_start = self.last_start
        c.last_est = self.last_est
        c.held = self.held
        return c

    def project(self, t: int, c: int, skip: set[int]) -> Run:
        """Run ahead from time t at concurrency c, every upgrade ending
        when it is expected to. The devices in skip keep no promise in the
        run, so their promises do not move in it. Return where and when
        each device that the run starts starts, and how many promises move
        on in the run."""
        s = self.copy()
        s.moves = 0
        for k in skip:
            s.promised[k] = -1
        run = Run(self.unset.copy(), self.unset.copy())
        now = t
        while True:
            started, wake, finished = s.step_n(now, c)
            for k in started:
                run.win[k] = s.released_in[k]
                run.at[k] = now
            if wake < 0 or finished:
                break
            now = wake
            for k in s.take_due(now):
                # A member that is down while it upgrades comes back up.
                if s.downs > 0 and s.down[k]:
                    s.down[k] = False
                    s.downs -= 1
                s.report_n(k, "succeeded", s.due[k])
        run.moves = s.moves
        return run

    def breaks(self, run: Run, t: int, skip: set[int]) -> (list[str], list[str], int):
        """The promises a run breaks: the waiting devices not in skip that
        do not start in their promised window, the ones that start in no
        window, and how many times promises move on in the run: once for
        each window a device misses."""
        missed: list[str] = []
        unplaced: list[str] = []
        for k in self.order_n:
            if self.waits(k) and k not in skip:
                s = run.win[k]
                p = self.promise(k, t)
                if s >= 0:
                    if p >= 0 and s != p:
                        missed.append(self.name_of(k))
                else:
                    unplaced.append(self.name_of(k))
                    if p >= 0:
                        missed.append(self.name_of(k))
        return (missed, unplaced, run.moves)

    def worse(self, a: (list[str], list[str], int), b: (list[str], list[str], int)) -> bool:
        """True when the run with breaks a breaks more promises than the
        run with breaks b."""
        if a.2 > b.2:
            return True
        return self.must_place and len(a.1) > len(b.1)

    def choose(self, t: int, skip: set[int]) -> (int, Run, (list[str], list[str], int)):
        """The run ahead at the concurrency the plan uses: the current
        one, or else the smallest up to max-concurrency that breaks no
        more promises than max-concurrency does. The search assumes that
        a run at a higher concurrency breaks no more promises. The devices
        in skip break no promise."""
        none: (list[str], list[str], int) = ([], [], 0)
        c = self.target
        if self.running:
            c = imin(imax(self.c, self.target), self.maxc)
        run = self.project(t, c, skip)
        b = self.breaks(run, t, skip)
        if self.worse(b, none) and self.maxc > c:
            top_run = self.project(t, self.maxc, skip)
            top = self.breaks(top_run, t, skip)
            if self.worse(b, top):
                lo = c + 1
                hi = self.maxc
                while lo < hi:
                    mid = (lo + hi) // 2
                    if self.worse(self.breaks(self.project(t, mid, skip), t, skip), top):
                        lo = mid + 1
                    else:
                        hi = mid
                c = lo
                run = top_run if c == self.maxc else self.project(t, c, skip)
                b = self.breaks(run, t, skip)
        return (c, run, b)

    def held_windows(self, names: list[str], t: int) -> dict[str, (int, int)]:
        """The window to show each held device in names in: the one
        promised to it, or else the first window of its schedule that has
        not closed, which stays free for other devices. Return each window
        and the earliest time the device could start there."""
        held: dict[str, (int, int)] = {}
        for name in names:
            k = self.known(name)
            i = -1
            if k >= 0:
                i = self.promise(k, t)
                if i < 0:
                    for j in self.wins_of(k):
                        if i < 0 and t < self.windows[j].2:
                            i = j
            if i >= 0:
                held[name] = (i, imax(t, self.windows[i].1))
        return held

    def promise_starts(self, run: Run, t: int) -> list[int]:
        """Promise each waiting device without a promise the window that
        the run starts it in, in the order the run starts them, and return
        the devices it promises."""
        # By start, and at one time in the order of the devices.
        new: list[(int, int, int)] = []
        for p in range(len(self.order_n)):
            k = self.order_n[p]
            if not self.released[k] and self.promise(k, t) < 0 and run.win[k] >= 0:
                new.append((run.at[k], p, k))
        fresh: list[int] = []
        for e in sorted(new):
            k = e.2
            i = run.win[k]
            self.promised[k] = i
            self.promise_seq[k] = self.seq
            self.seq += 1
            self.pqueue[i].append(k)
            fresh.append(k)
        return fresh

    def window_of(self, k: int, t: int) -> int:
        """The window the device with number k was released in, or else the
        one promised to it, as an index; -1 without one."""
        if self.released[k]:
            return self.released_in[k]
        return self.promise(k, t)

    def ends_by(self, k: int, t: int) -> int:
        """When the device with number k is done at the latest, as far as
        the plan knows: when it was done, also without a release
        (done_time_of()), when its upgrade is expected to end, or else when
        the window promised to it closes; -1 without one."""
        if self.done_at[k] != NO_TIME:
            return self.done_at[k]
        if self.done_unreleased(k):
            return self.done_time_of(self.name_of(k))
        if self.released[k]:
            return self.due[k]
        i = self.promise(k, t)
        if i >= 0:
            return self.windows[i].2
        return -1

    def swap_promises(self, a: int, b: int, at: dict[int, int]) -> None:
        """Give the waiting devices with numbers a and b each other's
        promise and place in the order of the promises. at gives the place
        of each in the promises of its window."""
        i = self.promised[a]
        j = self.promised[b]
        self.promised[a] = j
        self.promised[b] = i
        sa = self.promise_seq[a]
        self.promise_seq[a] = self.promise_seq[b]
        self.promise_seq[b] = sa
        ka = at[a]
        kb = at[b]
        self.pqueue[i][ka] = b
        self.pqueue[j][kb] = a
        at[a] = kb
        at[b] = ka

    def spread_out(self, fresh: list[int], t: int, c: int, run: Run,
                   b: (list[str], list[str], int), skip: set[int]) -> None:
        """Move the members of spread groups among the devices in fresh,
        which the run ahead run at concurrency c just gave their promises,
        to later windows, as far apart as the windows the run uses allow.
        A member moves only to a window that opens after the members before
        it in its group end, at the latest, and the group's min-separation
        has passed. When a member that moved does not end, with the
        min-separation, before the window of each member after it opens, or
        its window opens too soon after a member before it ends, in any
        group, no member of its group moves. Undo every move when the run
        ahead with the moves breaks more promises or leaves more devices
        without a start than run, whose breaks are b."""
        is_fresh: set[int] = set(fresh)
        # The place of each device in fresh in the promises of its window.
        at: dict[int, int] = {}
        for i in range(len(self.pqueue)):
            q = self.pqueue[i]
            for j in range(len(q)):
                if q[j] in is_fresh and self.promise(q[j], t) == i:
                    at[q[j]] = j
        # Per schedule, the last window the run starts a device in.
        last: dict[str, int] = {}
        for k in self.order_n:
            w = run.win[k]
            if w >= 0:
                sched = self.windows[w].0
                if w > last.get_def(sched, -1):
                    last[sched] = w
        # The members right after each device, in any group, past the ones
        # done without a release.
        later: dict[str, list[(str, str)]] = {}
        for name in self.before.keys():
            for bf in self.prior(name):
                if bf.0 not in later:
                    later[bf.0] = []
                later[bf.0].append((name, bf.1))
        # The devices that can give a member their promise, by window and
        # estimate, the latest promise last.
        spare: dict[(int, int), list[int]] = {}
        for k in fresh:
            if not self.in_group(k) and k not in skip:
                key = (self.promise(k, t), self.est_n(k))
                if key not in spare:
                    spare[key] = []
                spare[key].append(k)
        swaps: list[(int, int)] = []
        for g in sorted(self.groups.keys()):
            if not self.separation.get_def(g, (False, 0)).0:
                continue
            # The members done without a release are not there.
            members = [self.names.num[m.1] for m in sorted([(self.priority.get_def(m, 0), m)
                                                            for m in self.groups[g]
                                                            if m in self.est])
                       if not self.done_unreleased(self.names.num[m.1])]
            n = len(members)
            if n < 2:
                continue
            a = self.window_of(members[0], t)
            if a < 0:
                continue
            sep = self.separation_of(g)
            # When the members placed so far are done, and the
            # min-separation has passed.
            ready = self.ends_by(members[0], t) + sep
            moved: list[(int, int)] = []
            for j in range(1, n):
                m = members[j]
                w = self.window_of(m, t)
                if m in is_fresh and m not in skip and w >= 0:
                    # The windows of m's schedule from the first member's
                    # window to the last one the run uses.
                    span = [x for x in self.wins_of(m)
                            if self.windows[x].1 >= self.windows[a].1
                            and x <= last.get_def(self.schedule_of[self.name_of(m)], -1)]
                    if len(span) > 1:
                        top = (j * (len(span) - 1) + (n - 1) // 2) // (n - 1)
                        pos = top
                        while pos >= 0 and span[pos] > w and self.windows[span[pos]].1 >= ready:
                            pool = spare.get_def((span[pos], self.est_n(m)), [])
                            if len(pool) > 0:
                                partner = pool.pop()
                                self.swap_promises(m, partner, at)
                                moved.append((m, partner))
                                break
                            pos -= 1
                e = self.ends_by(m, t)
                if e >= 0:
                    ready = imax(ready, e + sep)
            # Each moved member must keep its order with the devices before
            # and after it in every group.
            fine = True
            for mv in moved:
                wm = self.windows[self.promise(mv.0, t)]
                for bf in self.prior(self.name_of(mv.0)):
                    kb = self.known(bf.0)
                    e = self.ends_by(kb, t) if kb >= 0 else -1
                    if e < 0 or e + self.separation_of(bf.1) > wm.1:
                        fine = False
                for y in later.get_def(self.name_of(mv.0), []):
                    ky = self.known(y.0)
                    if ky >= 0 and not self.released[ky]:
                        wy = self.promise(ky, t)
                        if wy >= 0 and wm.2 + self.separation_of(y.1) > self.windows[wy].1:
                            fine = False
            if fine:
                swaps.extend(moved)
            else:
                for mv in reversed(moved):
                    self.swap_promises(mv.0, mv.1, at)
                    spare[(self.promise(mv.1, t), self.est_n(mv.1))].append(mv.1)
        if len(swaps) > 0:
            r = self.project(t, c, skip)
            rb = self.breaks(r, t, skip)
            if self.worse(rb, b) or len(rb.1) > len(b.1):
                for mv in reversed(swaps):
                    self.swap_promises(mv.0, mv.1, at)

    def plan(self, t: int) -> Plan:
        """Plan from time t: the run ahead, at the concurrency choose()
        gives, with the promises the plan makes. It runs ahead again until
        its promises stop changing. During a run the controller keeps the
        promises and the concurrency."""
        moved = self.move_promises(t)
        # The devices that no concurrency can start keep their windows, but
        # break no promise. The ones that wait for a device that failed or
        # is down are looked at again when it lets them start. The others
        # are not parked here: parked, they would be looked at again in the
        # order they answer, not in the campaign's order.
        held_list, park = self.stuck()
        skip: set[int] = set()
        why: dict[str, (str, str)] = {}
        held_names: list[str] = []
        by_reason: dict[str, list[str]] = {}
        for e in held_list:
            name = self.name_of(e.0)
            skip.add(e.0)
            why[name] = (e.1, e.2)
            held_names.append(name)
            if e.1 not in by_reason:
                by_reason[e.1] = []
            by_reason[e.1].append(name)
        for k in park:
            self.parked.add(k)
        for k in moved:
            if k in skip:
                self.lost_promises.add(k)
        over = self.over_budget()
        s = self.copy()
        held = s.held_windows(held_names, t)
        c, run, b = s.choose(t, skip)
        settled = False
        for _round in range(PLAN_ROUNDS):
            fresh = s.promise_starts(run, t)
            if len(fresh) == 0:
                settled = True
                break
            if s.spreads:
                s.spread_out(fresh, t, c, run, b, skip)
            c, run, b = s.choose(t, skip)
        # The reports that count by now, as the run ahead had them, and the
        # pace and the slow time after them, as the step at t has them.
        s.count(t)
        starts: dict[str, (int, int)] = {}
        lost: list[str] = []
        gone: list[str] = []
        down_ends: list[int] = []
        for k in self.order_n:
            if run.win[k] >= 0:
                starts[self.name_of(k)] = (run.win[k], run.at[k])
            if s.flying[k] and s.down[k] and not s.reported[k]:
                end = s.expected_end(k)
                if end < t:
                    gone.append(self.name_of(k))
                else:
                    down_ends.append((end + 1) * SCALE + k)
            elif s.waits(k) and k in s.lost_promises:
                lost.append(self.name_of(k))
        self.down_ends = sorted(down_ends)
        if self.running:
            self.promised = s.promised
            self.promise_seq = s.promise_seq
            self.seq = s.seq
            self.pqueue = s.pqueue
            self.c = c

        alarms: list[str] = []
        if over:
            alarms.append("{self.failures} device(s) failed, more than the failure budget of "
                          + "{self.failure_budget}: no more devices start")
        texts: list[(str, str)] = [
            ("group-failed", "wait behind a failed redundancy group member"),
            ("down", "are down"),
            ("group-down", "wait while a redundancy group member is down"),
            ("not-answered", "have not answered the campaign's target"),
            ("vetoed", "are held by a veto of another holder"),
            ("group-vetoed", "wait behind a redundancy group member that is held by a veto"),
            ("group-not-answered", "wait behind a redundancy group member that has not answered"),
        ]
        for r in texts:
            ns = by_reason.get_def(r.0, [])
            if len(ns) > 0:
                alarms.append("{len(ns)} device(s) {r.1}: {names_text(ns)}")
        if len(lost) > 0:
            alarms.append("{len(lost)} device(s) lost their promised window while held: "
                          + names_text(lost))
        if len(gone) > 0:
            alarms.append("{len(gone)} device(s) in flight are down past their expected end: "
                          + names_text(gone))
        # A plan whose only alarms are for held devices, for devices in
        # flight that are down, and for lost windows can be taken again.
        n_hold = len(alarms)
        at_max = " even at max-concurrency {self.maxc}" if c >= self.maxc else ""
        missed = b.0
        if len(missed) > 0:
            alarms.append("{len(missed)} device(s) will miss the window they were "
                          + "promised{at_max}: {names_text(missed)}")
        # The devices with no promise that start in no window. One with a
        # promise stays in the window promised to it.
        unplaced: list[str] = []
        for name in b.1:
            i = s.promise(s.names.num[name], t)
            if i < 0:
                unplaced.append(name)
            else:
                held[name] = (i, imax(t, s.windows[i].1))
        if len(unplaced) > 0:
            if self.must_place:
                alarms.append("{len(unplaced)} device(s) cannot start before the deadline"
                              + "{at_max}: {names_text(unplaced)}")
            else:
                alarms.append("{len(unplaced)} device(s) are in no window yet: "
                              + names_text(unplaced))
        # Why devices start in no window, at the slow time after the reports
        # that count by now.
        short = s.windows_too_short(missed + unplaced, t)
        if len(short) > 0:
            alarms.append("{len(short)} device(s) fit in no window: {self.close_margin} percent "
                          + "of their slow time, {s.slow_s} s at the campaign's estimate, is "
                          + "longer than the time left in every window of their schedule: "
                          + names_text(short))
        p = Plan(c, starts, held, why, alarms)
        self.last_plan = p if self.running and settled and len(alarms) == n_hold else None
        return p

    def windows_too_short(self, names: list[str], t: int) -> list[str]:
        """The devices in names whose close margin is longer than the time
        left from t in every window of their schedule that has not closed,
        when such a window is left and none of them stays open. They start
        in no window until the slow time falls, which only upgrades of
        other devices can bring about, or until the windows or the close
        margin change."""
        # Per schedule, the most time left in one of its windows, or -1
        # when none is left.
        most: dict[str, int] = {}
        out: list[str] = []
        for name in names:
            k = self.names.num[name]
            sched = self.schedule_of.get_def(name, "")
            left = most.get_def(sched, -2)
            if left == -2:
                left = -1
                for j in self.wins_of(k):
                    w = self.windows[j]
                    if w.2 == OPEN_END:
                        left = OPEN_END
                    elif w.2 > t:
                        left = imax(left, w.2 - imax(w.1, t))
                most[sched] = left
            if left >= 0 and left != OPEN_END \
               and left * 100 < self.slow(k) * self.close_margin:
                out.append(name)
        return out

    def decide(self, t: int) -> Step:
        """Plan at time t and take the plan's first step. The last plan
        holds when its only alarms are for held devices, for lost windows
        and for members in flight that are down, nothing came in since the
        last step, no member that lost its window started, and from that
        step until t the run ahead only starts devices: no report counts,
        no device is due, no window opens or closes, and no member in
        flight that is down passes its expected end. A status of a device
        in flight that is not final, such as in-progress, brings in
        nothing, and neither does a member in flight without a report that
        goes down or comes back up before its expected end. Then the
        decision takes that plan again, without the devices that started
        since, with the held devices at the earliest times they could start
        from t, and only starts the devices it starts now. Then it lets
        members prepare whose turn has come (take_prepares). The decision
        also wakes when a member in flight that is down passes its expected
        end. After the step, it holds again the runs that wait to prepare
        again and no longer fit their window, by the slow time after the
        reports that count now (stop_waiting_runs()), and it wakes when the
        next one no longer fits. That changes no plan."""
        last = self.last_plan
        down = self.down_end()
        if last is not None and self.quiet_from <= t and t < self.quiet_until \
           and (down < 0 or t < down):
            p = Plan(last.c, {name: s for name, s in last.starts.items()
                              if not self.released[self.names.num[name]]},
                     self.held_windows(list(last.held.keys()), t), last.why, last.alarms)
            self.last_plan = p
        else:
            p = self.plan(t)
        started, wake, finished = self.step(t, p.c)
        wake = earliest(wake, self.stop_waiting_runs(t))
        taken = self.take_turns(t)
        wake = earliest(wake, taken.0)
        wake = earliest(wake, self.down_end())
        self.wake_at = wake
        return Step(started, wake, finished, p, self.prepares_of(t, taken.1))

    def stop_waiting_runs(self, t: int) -> int:
        """Hold again each device in flight whose run waits to try its
        prepare again at time t, or tried it again after its latest wait,
        past the last second at which a try fits before its window closes
        (last_fit()). It is then resumed, so the campaign puts its veto
        back, and its device stops the run before the install. When it
        reports upgrade-needed, it waits again (take_back). Return the
        first second at which a waiting run no longer fits, -1 for none."""
        wake = -1
        for k, tried in self.run_waits.items():
            if not self.flying[k] or self.resumed[k] or self.reported[k]:
                continue
            last = self.last_fit(k, self.windows[self.released_in[k]].2)
            if last == OPEN_END:
                continue
            start = tried
            if tried == NO_TIME:
                start = t
            if start > last:
                self.resumed[k] = True
            elif tried == NO_TIME:
                wake = earliest(wake, last + 1)
        return wake

    def down_end(self) -> int:
        """The first second in which a member in flight without a report
        that is down is past its expected end, -1 for none."""
        while len(self.down_ends) > 0:
            e = self.down_ends[0]
            k = e % SCALE
            if self.flying[k] and self.down[k] and not self.reported[k]:
                return e // SCALE
            heap_pop(self.down_ends)
        return -1

    def slot(self, s: int) -> int:
        """The start of the debounce slot of the second s, in seconds."""
        q = imax(1, self.debounce)
        return s // q * q

    def in_window(self, name: str, t: int) -> bool:
        """True when the first window of the device's schedule that has not
        closed at t is open at t."""
        for j in self.wins_of(self.known(name)):
            w = self.windows[j]
            if t < w.2:
                return w.1 <= t
        return False

    def prepare_bw(self, name: str) -> int:
        """The bandwidth of the prepare of the member name, in bits per
        second: the size of its image divided by its expected prepare time,
        rounded up. 0 when its image has no size."""
        est = imax(1, self.prepare_est.get_def(name, 1))
        return (self.prepare_size.get_def(name, 0) * 8 + est - 1) // est

    def first_open(self) -> int:
        """The opening of the campaign's first window, in seconds: the one
        that the run took (keep_first()), or else the first of the windows.
        OPEN_END when there is none."""
        if self.first_at >= 0:
            return self.first_at
        if len(self.windows) > 0:
            return self.windows[0].1
        return OPEN_END

    def keep_first(self, t: int) -> None:
        """While the run is on, take the opening of the first of the
        windows as the campaign's first window at t, until it has opened:
        from then on the run keeps it, also when that window closes and the
        schedules no longer give it."""
        if not self.running:
            return
        if self.first_at < 0 or t < self.first_at:
            self.first_at = self.windows[0].1 if len(self.windows) > 0 else -1

    def prepare_deadlines(self, k: int, t: int) -> (bool, int, int):
        """The deadlines to prepare of the member with number k at t, as
        (whether it has them, the latest time it may start to prepare
        before the first window, the latest time it may start at all), in
        microseconds. The first is NO_TIME without prepare_first. Each is
        the opening of a window less the close margin of its expected
        prepare time: the campaign's first window, and, when the members
        may prepare between or during windows, the window promised to it.
        It has none when it has no promise, or while the window promised to
        it is open."""
        i = self.promise(k, t)
        if i < 0 or self.windows[i].1 <= t:
            return (False, NO_TIME, NO_TIME)
        lead = self.prepare_est.get_def(self.name_of(k), 1) * self.close_margin * (MICRO // 100)
        first = NO_TIME
        if self.prepare_first:
            first = self.first_open() * MICRO - lead
        last = first
        pb = self.prepare_between
        if pb is None or pb or self.prepare_during:
            last = imax(first, self.windows[i].1 * MICRO - lead)
        return (True, first, last)

    def prepare_deadline(self, name: str, t: int) -> ?int:
        """The time by which the member name must start to prepare at t, in
        microseconds: the latest of its deadlines (prepare_deadlines). None
        when it has none."""
        k = self.known(name)
        if k < 0:
            return None
        dl = self.prepare_deadlines(k, t)
        if dl.0:
            return dl.2
        return None

    def late_from(self, name: str, deadline: int) -> int:
        """The first second at which the member name, let prepare, is late
        for its latest deadline, given in microseconds: the second after
        the deadline when it reports its prepare retrying, and when it
        reports no prepare, also no sooner than a debounce after it was let
        (prepare_from, or else prepare_at)."""
        first = deadline // MICRO + 1
        if self.prepare_state.get(name) == "retrying":
            return first
        let = self.prepare_from.get_def(name, self.prepare_at.get_def(name, 0))
        return imax(first, let + imax(1, self.debounce))

    def prepare_gate(self) -> bool:
        """True when members may be let prepare: the run is on, prepare is
        on, and no more members have failed than the failure budget."""
        return self.running and self.prepare and not self.over_budget()

    def clear_turns(self) -> None:
        """Forget every turn to prepare."""
        for k in range(len(self.prep_turn)):
            self.prep_turn[k] = -1

    def prepare_windows(self, t: int) -> list[(int, int)]:
        """The windows that keep the members from preparing, as (opening,
        close): every window the schedules give, and every window that has
        not closed at t and holds a member in flight."""
        out: list[(int, int)] = []
        extra = False
        for i in range(len(self.windows)):
            w = self.windows[i]
            if self.is_current[i]:
                out.append((w.1, w.2))
            elif t < w.2:
                extra = True
        if extra:
            seen: set[int] = set()
            for k in range(len(self.flying)):
                if self.flying[k]:
                    i = self.released_in[k]
                    if not self.is_current[i] and t < self.windows[i].2 and i not in seen:
                        seen.add(i)
                        out.append((self.windows[i].1, self.windows[i].2))
        return out

    def prepare_blackouts(self, t: int) -> list[(int, int)]:
        """The times in which no member is let prepare, in microseconds:
        without prepare_first, the time before the campaign's first window
        opens; with prepare_between False, the time after it opens outside
        the windows of prepare_windows(t), from the close of each less the
        close margin of the longest expected prepare time (the tail); and
        without prepare_during, each of those windows, from its opening
        less the tail, to its close."""
        first = self.first_open() * MICRO
        tail = self.prepare_longest * self.close_margin * (MICRO // 100)
        spans = merge_spans([(w.0 * MICRO, w.1 * MICRO) for w in self.prepare_windows(t)])
        out: list[(int, int)] = []
        if not self.prepare_during:
            for s in spans:
                out.append((s.0 - tail, s.1))
        pb = self.prepare_between
        if pb is not None and not pb:
            at = first
            for s in spans:
                if s.1 <= at:
                    continue
                if s.0 > at:
                    out.append((at, s.0))
                at = imax(imax(at, s.0), s.1 - tail)
            out.append((at, OPEN_END * MICRO))
        if not self.prepare_first:
            out.append((NO_TIME, first))
        return out

    def window_open(self, t: int) -> bool:
        """True when a window of prepare_windows(t) is open at t."""
        for w in self.prepare_windows(t):
            if w.0 <= t and t < w.1:
                return True
        return False

    def stops_all(self, t: int) -> bool:
        """True when t stops every member let prepare: without
        prepare_during, a window of prepare_windows(t) is open; with
        prepare_between False, the campaign's first window has opened and
        no such window is open."""
        open_now = self.window_open(t)
        if open_now and not self.prepare_during:
            return True
        pb = self.prepare_between
        return pb is not None and not pb and not open_now and t >= self.first_open()

    def blackout_end(self, t: int) -> int:
        """The first second after the end of the time without prepares that
        the second t lies inside, after its start and before its end; -1
        when t lies inside none."""
        end = FreeTime(self.prepare_blackouts(t), t * MICRO).inside(t * MICRO)
        if end < 0:
            return -1
        return (end + MICRO - 1) // MICRO

    def free_at(self, t: int, x: int) -> bool:
        """True when the time x, in microseconds, is free to prepare as the
        windows are at the second t: outside the times without prepares,
        or at the start or the end of one."""
        return FreeTime(self.prepare_blackouts(t), x).is_free(x)

    def may_keep(self, name: str, t: int, stopped: bool) -> bool:
        """True when the member name may stay let prepare at t: it is in the
        campaign and not released, its latest report says that it needs
        the upgrade, its prepare is not done or failed (a retrying prepare
        keeps it), t does not stop every member (stopped, as stops_all()
        says), and the window promised to it has not opened, or without a
        promise the first window of its schedule that has not closed is not
        open."""
        k = self.known(name)
        if k < 0 or name not in self.est:
            return False
        if self.released[k] or not self.answered[k] or self.final_at[k] != NO_TIME:
            return False
        st = self.prepare_state.get(name)
        if st == "done" or st == "failed" or stopped:
            return False
        i = self.promise(k, t)
        if i >= 0:
            return self.windows[i].1 > t
        return not self.in_window(name, t)

    def running_from(self, t: int) -> dict[str, int]:
        """The second from which each prepare that runs at t counts, by
        member: the members let prepare now, and the members not released
        that report their prepare running, each from the latest second it
        was let while it reported no prepare (prepare_from, or else
        prepare_at), or else from t, for its expected prepare time. A member
        let prepare that reports no prepare yet, or its prepare retrying,
        counts from then and not before t: its prepare has not begun, or
        has to run again. A prepare whose expected prepare time has passed
        at t is left out."""
        now = copy_set(self.allowed)
        for name, st in self.prepare_state.items():
            if st == "running" and not self.is_released(name):
                now.add(name)
        out: dict[str, int] = {}
        for name in now:
            let = self.prepare_from.get_def(name, self.prepare_at.get_def(name, t))
            st = self.prepare_state.get(name)
            if st is None or st == "retrying":
                let = imax(let, t)
            if let + self.prepare_est.get_def(name, 1) > t:
                out[name] = let
        return out

    def running_spans(self, t: int) -> list[(int, int, int)]:
        """The prepares that run at t (running_from), as (start, end,
        bandwidth), in microseconds and bits per second."""
        out: list[(int, int, int)] = []
        for name, let in self.running_from(t).items():
            out.append((let * MICRO, (let + self.prepare_est.get_def(name, 1)) * MICRO,
                        self.prepare_bw(name)))
        return out

    def let_at(self, turn: int, t: int, free: FreeTime, blocked: int) -> int:
        """The second at which a member is let for its turn turn, in
        microseconds: the start of the debounce slot of the turn, and not
        inside a time without prepares of free: at its end. blocked is the
        end of the time without prepares that t lies inside, -1 for none,
        so when t lies inside one, a member whose slot started before t is
        let at that time's end."""
        let = self.slot(turn // MICRO)
        end = free.inside(let * MICRO)
        if end < 0 and let <= t:
            end = blocked
        if end >= 0:
            let = (end + MICRO - 1) // MICRO
        return let

    def let_second(self, turn: int, t: int, free: FreeTime) -> int:
        """The second at which the prepare of a member with the turn turn
        starts: when it is let (let_at), and not before t."""
        return imax(t, self.let_at(turn, t, free, free.inside(t * MICRO)))

    def cap_turn(self, y: int, t: int, free: FreeTime, sweep: Sweep, name: str,
                 deadline: int) -> int:
        """The turn of the member name from y on, in microseconds, at which
        its prepare keeps the bandwidth at or under the cap (sweep): y, or
        the start of the first debounce slot that is free and starts at or
        after the end of a prepare that frees enough of it. A turn after
        deadline is not looked at further, and the sweep is as before."""
        if self.prepare_cap < 0:
            return y
        bw = self.prepare_bw(name)
        q = imax(1, self.debounce) * MICRO
        blocked = free.inside(t * MICRO)
        sweep.mark()
        while y <= deadline:
            s = imax(t, self.let_at(y, t, free, blocked)) * MICRO
            if sweep.fits(s, bw):
                sweep.keep()
                return y
            e = sweep.next_end()
            z = (e + q - 1) // q * q
            y = imax(y + 1, free.instant(free.before(z), z))
        sweep.undo()
        return y

    def spread(self, t: int, free: FreeTime, sweep: Sweep, cands: list[(int, str)],
               last: int) -> (list[(int, str, int)], list[int], int):
        """Give turns to the members cands, each as (deadline in
        microseconds, name) and in order of deadlines, on the free time of
        free. The first turn is one gap after the free value last, or, when
        last is below 0, t, or one gap after the last turn let (prep_last)
        unless that is before the start of t's debounce slot. Each next turn
        is one gap after the turn before it (prepare_gap), and at least the
        cap_gap() of the member before it, so the turns keep an even spread
        also where the cap holds them. A turn comes later still when the cap
        holds it (cap_turn). A member whose turn would come after
        its deadline takes none, and the next member goes after the turn
        before it. Return the turns as (turn, name, the second it is let
        (let_at)), the places in cands of the members without a turn, and
        the free value of the last turn, last when no member took one."""
        tm = t * MICRO
        start = self.slot(t) * MICRO
        now_c = free.before(tm)
        blocked = free.inside(tm)
        # Each deadline once, as a free value, with how many members have
        # it or an earlier one.
        deadlines: list[int] = []
        upto: list[int] = []
        for j in range(len(cands)):
            d = free.before(cands[j].0)
            if len(deadlines) > 0 and deadlines[-1] == d:
                upto[-1] = j + 1
            else:
                deadlines.append(d)
                upto.append(j + 1)
        first = now_c
        if last < 0 and self.prep_last >= 0:
            lc = free.before(self.prep_last)
            first = lc + prepare_gap(deadlines, upto, 0, 0, lc)
            if free.instant(first, NO_TIME) < start:
                # Behind: one member now, and the rest spread from now.
                first = now_c
        out: list[(int, str, int)] = []
        missed: list[int] = []
        cur = last
        step = 0
        lo = 0
        for j in range(len(cands)):
            while upto[lo] <= j:
                lo += 1
            turn = first
            if cur >= 0:
                turn = cur + imax(step, prepare_gap(deadlines, upto, lo, j, cur))
            # A turn before now lies in t's debounce slot.
            y = free.instant(turn, tm if turn >= now_c else NO_TIME)
            name = cands[j].1
            y = self.cap_turn(y, t, free, sweep, name, cands[j].0)
            if y > cands[j].0:
                missed.append(j)
                continue
            let = self.let_at(y, t, free, blocked)
            s = imax(t, let) * MICRO
            sweep.add(s + self.prepare_est.get_def(name, 1) * MICRO, self.prepare_bw(name))
            out.append((y, name, let))
            cur = free.before(y)
            step = self.cap_gap(name)
        return (out, missed, cur)

    def cap_gap(self, name: str) -> int:
        """The time from the turn of the member name to the next turn at
        which the cap holds no turn when every member is like it, in
        microseconds: its expected prepare time divided by how many of its
        prepares fit under the cap at once, at least one, rounded up. 0
        without a cap, or when its image has no size."""
        bw = self.prepare_bw(name)
        if self.prepare_cap < 0 or bw <= 0:
            return 0
        n = imax(1, self.prepare_cap // bw)
        return (self.prepare_est.get_def(name, 1) * MICRO + n - 1) // n

    def turns(self, t: int) -> (list[(int, str, int)], list[str], list[(int, str)]):
        """The turns to prepare of the members that wait to prepare at t,
        by turn, as (turn in microseconds, name, the second it is let); the
        members that cannot prepare before their window opens, in the
        campaign's order; and the members that wait to be let again, as
        (the second let_again() lets each, name). A member waits to prepare while the run is on,
        prepare is on, no more members have failed than the failure budget,
        it is not released, it is up, its latest report says that it needs
        the upgrade, it has a promise, it was not let prepare before, it
        reports no prepare or its prepare retrying, and it has deadlines
        (prepare_deadlines).

        The turns lie on free time (FreeTime): the time outside the times
        without prepares (prepare_blackouts), where an automatic
        prepare_between counts as on. A deadline inside a time without
        prepares counts from that time's start. Each prepare runs from the
        second it is let for its expected prepare time, and the prepares
        keep the bandwidth at or under the cap: a turn that the cap holds
        comes later. A member cannot prepare in time when the first free
        instant from t is after its latest deadline, or when the cap leaves
        it no turn by that deadline.

        A member keeps the turn that the last decision gave it (prep_turn)
        while that turn is at or after the start of t's debounce slot, at or
        before its latest deadline, free, and under the cap with the
        prepares that run and the turns kept before it. When no member keeps
        a turn, the turns are new (spread): first the members whose deadline
        before the first window is not past, by that deadline on free time,
        then by the opening of the window promised to them, the order of
        their promises and the campaign's order; then, after the last of
        them, the members that do not fit before the first window, by their
        latest deadline. Each member without a turn then takes its place
        among the turns (place_turns), where the cap lets it: if it can,
        before the first window, and else by its latest deadline. It is due
        when a decision passed its turn without letting it, and new
        otherwise. A member is let at the second that let_at() gives for its
        turn.

        A member let prepare before that is no longer let and reports no
        prepare or its prepare retrying waits to be let again. So does a
        member that is up, that an operator asked to prepare again
        (prepare_now), and that does not report the prepare of the ask done
        or failed, first, by the second it asked. let_again() lets each
        at the first free second from t at which its prepare keeps the
        bandwidth at or under the cap, after the members let before it; its
        prepare counts from then, before the turns. It cannot prepare in
        time when that second is after its latest deadline, or for a member
        that was asked, at or after the opening of the window promised to
        it: let_again no longer lets it. A member let prepare that is late
        (late_from()) cannot prepare in time either."""
        late: list[(int, str)] = []
        out: list[(int, str, int)] = []
        if not self.prepare_gate():
            return (out, [], [])
        tm = t * MICRO
        start = self.slot(t) * MICRO
        origin = start
        if self.prep_last >= 0 and self.prep_last < origin:
            origin = self.prep_last
        free = FreeTime(self.prepare_blackouts(t), origin)
        now_c = free.before(tm)
        first = free.instant(now_c, tm)
        # (deadline before the first window, opening of the promised
        # window, promise order, place, latest deadline, name, number)
        members: list[(int, int, int, int, int, str, int)] = []
        # The members that wait to be let again, as (when first let, name,
        # latest deadline, place), and the members that an operator asked to
        # prepare again, as (when first asked, name, the last microsecond
        # before the window promised to it opens, place).
        relets: list[(int, str, int, int)] = []
        asked: list[(int, str, int, int)] = []
        for p in range(len(self.order_n)):
            k = self.order_n[p]
            if self.released[k] or not self.answered[k] or self.final_at[k] != NO_TIME \
               or self.promise(k, t) < 0:
                continue
            name = self.name_of(k)
            st = self.prepare_state.get(name)
            waiting = True
            if st is not None and st != "retrying":
                waiting = False
            dl = self.prepare_deadlines(k, t)
            if name in self.allowed:
                if waiting and dl.0 and t >= self.late_from(name, dl.2):
                    late.append((p, name))
                continue
            if name in self.prepare_now:
                if not self.down[k] and dl.0 and st != "done" and st != "failed":
                    asked.append((self.prepare_now[name], name,
                                  self.windows[self.promised[k]].1 * MICRO - 1, p))
                continue
            if self.down[k]:
                continue
            if name in self.prepare_at:
                if waiting and dl.0:
                    relets.append((self.prepare_at[name], name, dl.2, p))
                continue
            if not waiting or not dl.0:
                continue
            if first > dl.2:
                late.append((p, name))
                continue
            members.append((dl.1, self.windows[self.promised[k]].1, self.promise_seq[k], p, dl.2,
                            name, k))
        running = self.running_spans(t)
        # Each member that waits to be let again, in the order let_again()
        # takes them, at the first free second, from the second the one
        # before it is let again, at which the cap lets it.
        again: list[(int, str)] = []
        if len(relets) > 0 or len(asked) > 0:
            sweep = Sweep(self.prepare_cap, running)
            at = (first + MICRO - 1) // MICRO
            for e in sorted(asked) + sorted(relets):
                name = e.1
                est = self.prepare_est.get_def(name, 1)
                bw = self.prepare_bw(name)
                s = at
                sweep.mark()
                while s * MICRO <= e.2:
                    s = (free.instant(free.before(s * MICRO), s * MICRO) + MICRO - 1) // MICRO
                    if s * MICRO > e.2 or sweep.fits(s * MICRO, bw):
                        break
                    s = imax(s + 1, (sweep.next_end() + MICRO - 1) // MICRO)
                if s * MICRO > e.2:
                    sweep.undo()
                    late.append((e.3, name))
                    continue
                sweep.keep()
                sweep.add((s + est) * MICRO, bw)
                running.append((s * MICRO, (s + est) * MICRO, bw))
                again.append((s, name))
                at = s
        if len(members) == 0:
            return (out, [e.1 for e in sorted(late)], again)
        blocked = free.inside(tm)
        # The members that keep their turn, as (turn, place in members),
        # under the cap.
        kept: list[(int, int)] = []
        candidates: list[(int, int)] = []
        for j in range(len(members)):
            pt = self.prep_turn[members[j].6]
            if pt >= start and pt <= members[j].4 and free.is_free(pt):
                candidates.append((pt, j))
        sweep = Sweep(self.prepare_cap, running)
        kept_spans: list[(int, int, int)] = []
        turn_of: dict[int, int] = {}
        for e in sorted(candidates):
            name = members[e.1].5
            let = self.let_at(e.0, t, free, blocked)
            s = imax(t, let) * MICRO
            bw = self.prepare_bw(name)
            if sweep.fits(s, bw):
                end = s + self.prepare_est.get_def(name, 1) * MICRO
                sweep.add(end, bw)
                kept_spans.append((s, end, bw))
                kept.append(e)
                turn_of[e.1] = e.0
                out.append((e.0, name, let))
        if len(kept) == 0:
            sweep = Sweep(self.prepare_cap, running)
            ahead = sorted([(free.before(members[j].0), members[j].1, members[j].2,
                             members[j].3, j)
                            for j in range(len(members)) if members[j].0 >= first])
            r1 = self.spread(t, free, sweep, [(members[e.4].0, members[e.4].5) for e in ahead], -1)
            rest = [members[ahead[m].4] for m in r1.1] + [e for e in members if e.0 < first]
            later = sorted([(e.4, e.2, e.3, e.5) for e in rest if e.4 > e.0])
            r2 = self.spread(t, free, sweep, [(e.0, e.3) for e in later], r1.2)
            # The turns spread count as kept, and the members left take
            # their places among them.
            place: dict[str, int] = {members[j].5: j for j in range(len(members))}
            for e in r1.0 + r2.0:
                j = place[e.1]
                turn_of[j] = e.0
                kept.append((e.0, j))
                begin = imax(t, e.2) * MICRO
                kept_spans.append((begin, begin + self.prepare_est.get_def(e.1, 1) * MICRO,
                                   self.prepare_bw(e.1)))
                out.append(e)
        if len(kept) == len(members):
            return (sorted(out), [e.1 for e in sorted(late)], again)
        load = Load(self.prepare_cap, running + kept_spans)
        points = [free.before(e.0) for e in kept]
        anchor = now_c
        if self.prep_last >= 0:
            anchor = free.before(self.prep_last)
        # The members without a turn: first before the first window, then
        # by their latest deadline.
        ahead2 = sorted([(free.before(members[j].0), members[j].1, members[j].2,
                          members[j].3, j)
                         for j in range(len(members))
                         if j not in turn_of and members[j].0 >= first])
        nums = [members[e.4].6 for e in ahead2]
        pos: list[int] = []
        if len(ahead2) > 0:
            pos = place_turns(points, anchor, now_c,
                              [(e.0, self.is_due(members[e.4].6, start)) for e in ahead2],
                              CapFit(self, t, free, load, nums))
        rest2: list[int] = []
        for m in range(len(ahead2)):
            if pos[m] >= 0:
                points.append(pos[m])
                turn_of[ahead2[m].4] = free.instant(pos[m], tm if pos[m] >= now_c else origin)
            else:
                rest2.append(ahead2[m].4)
        for j in range(len(members)):
            if j not in turn_of and members[j].0 < first:
                rest2.append(j)
        later2: list[(int, int, int, int)] = []
        for j in rest2:
            e = members[j]
            if e.4 > e.0:
                later2.append((e.4, e.2, e.3, j))
            else:
                late.append((e.3, e.5))
        later2 = sorted(later2)
        nums2 = [members[e.3].6 for e in later2]
        pos2: list[int] = []
        if len(later2) > 0:
            pos2 = place_turns(points, anchor, now_c,
                               [(free.before(e.0), self.is_due(members[e.3].6, start))
                                for e in later2], CapFit(self, t, free, load, nums2))
        for m in range(len(later2)):
            j = later2[m].3
            if pos2[m] >= 0:
                turn_of[j] = free.instant(pos2[m], tm if pos2[m] >= now_c else origin)
            else:
                late.append((members[j].3, members[j].5))
        kept_js = {e.1 for e in kept}
        for j, turn in turn_of.items():
            if j not in kept_js:
                out.append((turn, members[j].5, self.let_at(turn, t, free, blocked)))
        return (sorted(out), [e.1 for e in sorted(late)], again)

    def is_due(self, k: int, start: int) -> bool:
        """True when a decision passed the turn of the member with number k
        without letting it: its turn is before start, the start of the
        debounce slot of the decision, in microseconds."""
        pt = self.prep_turn[k]
        return pt >= 0 and pt < start

    def prepares(self, t: int) -> Prepares:
        """The prepares at t, as turns() gives them and without changing
        anything. The members let prepare start when they were first let,
        and each waiting member at the second its turn lets it, and not
        before t. Each waiting member counts from that start for its
        expected prepare time, with the prepares that run now (running_from)
        and those of the members that wait to be let again, each from the
        second let_again() lets it: the most of them at once, and the
        bandwidth over time and its peak, the sum of the bandwidths of the
        prepares that run. Each member let prepare that does not count from
        its start has in runs the second it counts from, or -1 when its
        prepare does not count. A member that an operator asked to prepare
        again and that was never let starts at the second let_again() lets
        it. The members may prepare between windows when prepare_between is
        True, or, when it is None (automatic), when a member was let
        prepare, or let again while it reported no prepare, or waits to be
        let again or has a turn, at a second after the campaign's first
        window opens and outside every window. The failed prepares are those
        of the members that wait for their release: not released, and their
        latest report says that they need the upgrade."""
        return self.prepares_of(t, self.turns(t))

    def prepares_of(self, t: int,
                    tr: (list[(int, str, int)], list[str], list[(int, str)])) -> Prepares:
        """The prepares at t with the turns tr, as turns(t) gives them
        (prepares)."""
        starts: dict[str, int] = {}
        for name, at in self.prepare_at.items():
            starts[name] = at
        for e in tr.0:
            starts[e.1] = imax(t, e.2)
        for e in tr.2:
            if e.1 not in starts:
                starts[e.1] = e.0
        # The second from which each prepare that runs now, or that waits to
        # be let again, counts, by member.
        counted = self.running_from(t)
        for e in tr.2:
            counted[e.1] = e.0
        runs: dict[str, int] = {}
        for name, at in self.prepare_at.items():
            x = counted.get_def(name, -1)
            st = self.prepare_state.get(name)
            if x != at and (x >= 0 or st is None or st == "retrying"):
                runs[name] = x
        # Each prepare as (start, end, bandwidth), in microseconds.
        spans: list[(int, int, int)] = []
        for name, at in counted.items():
            spans.append((at * MICRO, (at + self.prepare_est.get_def(name, 1)) * MICRO,
                          self.prepare_bw(name)))
        for e in tr.0:
            begin = starts[e.1] * MICRO
            spans.append((begin, begin + self.prepare_est.get_def(e.1, 1) * MICRO,
                           self.prepare_bw(e.1)))
        # The starts and the ends of the prepares as (time, 1 for a start
        # or 0 for an end, bandwidth): at one time, the ends come first.
        events: list[(int, int, int)] = []
        for sp in spans:
            events.append((sp.0, 1, sp.2))
            events.append((sp.1, 0, sp.2))
        c = 0
        running = 0
        steps: list[(int, int)] = []
        peak = 0
        level = 0
        for ev in sorted(events):
            if ev.1 == 1:
                running += 1
                level += ev.2
            else:
                running -= 1
                level -= ev.2
            c = imax(c, running)
            at = ev.0 // MICRO
            if len(steps) > 0 and steps[-1].0 == at:
                steps[-1] = (at, level)
            else:
                steps.append((at, level))
            if len(steps) > 1 and steps[-1].1 == steps[-2].1:
                steps.pop()
            peak = imax(peak, level)
        if peak == 0:
            steps = []
        between = False
        pb = self.prepare_between
        if pb is not None:
            between = pb
        else:
            between = self.between_used(list(starts.values()) + list(counted.values())
                                        + list(self.prepare_from.values()))
        alarms: list[str] = []
        if len(tr.1) > 0:
            alarms.append("{len(tr.1)} device(s) cannot prepare before their window opens: "
                          + names_text(tr.1))
        failed: list[str] = []
        for k in self.order_n:
            if not self.released[k] and self.answered[k] and self.final_at[k] == NO_TIME:
                name = self.name_of(k)
                if self.prepare_state.get(name) == "failed":
                    failed.append(name)
        if len(failed) > 0:
            alarms.append("{len(failed)} device(s) failed to prepare and copy the image in "
                          + "their window: {names_text(failed)}")
        return Prepares(starts, c, alarms, steps, peak, between, runs)

    def between_used(self, times: list[int]) -> bool:
        """True when one of the times lies at or after the campaign's first
        window opens and outside every window."""
        first = self.first_open()
        spans = merge_spans([(w.1, w.2) for w in self.windows])
        for at in times:
            if at < first:
                continue
            lo = 0
            hi = len(spans)
            while lo < hi:
                mid = (lo + hi) // 2
                if spans[mid].0 <= at:
                    lo = mid + 1
                else:
                    hi = mid
            if lo == 0 or at >= spans[lo - 1].1:
                return True
        return False

    def revoke_prepares(self, t: int) -> None:
        """Stop letting prepare each member that may no longer prepare at
        t: all of them when the run is off, prepare is off, or more members
        have failed than the failure budget, and each one that may not stay
        let (may_keep)."""
        if len(self.allowed) == 0:
            return
        if not self.prepare_gate():
            self.allowed = set()
            return
        stopped = self.stops_all(t)
        keep: set[str] = set()
        for name in self.allowed:
            if self.may_keep(name, t, stopped):
                keep.add(name)
        self.allowed = keep

    def let_again(self, t: int) -> int:
        """Let prepare each member that an operator asked to prepare again
        (retry_prepare()), and let prepare again each member let prepare in
        the run that is no longer let, and that reports no prepare, its
        prepare running or its prepare retrying, when it could be let at a
        turn at t: the run is on, prepare is on, no more members have failed
        than the failure budget, it may stay let (may_keep), t is at or
        before its latest deadline, t lies inside no time without prepares,
        and a member that reports no prepare or its prepare retrying keeps
        the bandwidth at or under the cap with the prepares that run.

        First, a member that was asked is no longer asked when it is let
        already, is released, has a final status, or reports the prepare of
        the ask done or failed, also when no member may be let: its device
        prepares once for each prepare attempt. The members that were asked
        go first, by the second they asked, and also after their deadline,
        but not while they are down. Each counts from t (prepare_from),
        keeps the second it was first let, or is let first at t, and is no
        longer asked. Then the members let before go in the order they were
        first let, and each keeps that time; a member that reports no
        prepare or its prepare retrying counts from t. So a member whose
        device had not begun its prepare, or tries it again, when a window
        opened or closed, the run paused or a hold of the failure budget
        began, or whose answer or prepare report went and came back,
        prepares when it may again. Return the first end of a prepare that
        runs while the cap holds such a member, or -1."""
        for name in list(self.prepare_now.keys()):
            k = self.known(name)
            st = self.prepare_state.get(name)
            if k < 0 or self.released[k] or self.final_at[k] != NO_TIME or name in self.allowed \
               or st == "done" or st == "failed":
                self.prepare_now.pop(name)
        if (len(self.prepare_at) == 0 and len(self.prepare_now) == 0) \
           or not self.prepare_gate() or self.blackout_end(t) >= 0:
            return -1
        stopped = self.stops_all(t)
        sweep = Sweep(self.prepare_cap, self.running_spans(t))
        wake = -1
        for e in sorted([(at, name) for name, at in self.prepare_now.items()]):
            name = e.1
            k = self.known(name)
            if self.down[k] or not self.may_keep(name, t, stopped):
                continue
            bw = self.prepare_bw(name)
            if not sweep.fits(t * MICRO, bw):
                wake = earliest(wake, (sweep.next_end() + MICRO - 1) // MICRO)
                continue
            sweep.add((t + self.prepare_est.get_def(name, 1)) * MICRO, bw)
            self.allowed.add(name)
            if name not in self.prepare_at:
                self.prepare_at[name] = t
            self.prepare_from[name] = t
            self.prepare_now.pop(name)
        for e in sorted([(at, name) for name, at in self.prepare_at.items()]):
            name = e.1
            if name in self.allowed or name in self.prepare_now:
                continue
            st = self.prepare_state.get(name)
            if st == "done" or st == "failed":
                continue
            if not self.may_keep(name, t, stopped):
                continue
            k = self.known(name)
            dl = self.prepare_deadlines(k, t)
            if not dl.0 or t * MICRO > dl.2:
                continue
            if st is None or st == "retrying":
                bw = self.prepare_bw(name)
                if not sweep.fits(t * MICRO, bw):
                    wake = earliest(wake, (sweep.next_end() + MICRO - 1) // MICRO)
                    continue
                sweep.add((t + self.prepare_est.get_def(name, 1)) * MICRO, bw)
                self.prepare_from[name] = t
            self.allowed.add(name)
        return wake

    def take_prepares(self, t: int) -> int:
        """Let prepare the members whose turn has come, as take_turns()
        does, and return when to decide again."""
        return self.take_turns(t).0

    def take_turns(self, t: int) -> (int, (list[(int, str, int)], list[str], list[(int, str)])):
        """Stop letting prepare the members that may no longer prepare
        (revoke_prepares), let again the ones let before that may
        (let_again), and let prepare each member whose turn lets it at or
        before t. The turns of the members left are kept for the next
        decision; while members may not be let, as in a hold of the failure
        budget, the turns stay as they were. With no turn left, the next
        member that comes to wait goes at once. While more members have
        failed than the failure budget, no turn is left, but the last turn
        stays: when the hold ends, the turns go on as they were.

        Return when to decide again, and the turns left with the members
        that cannot prepare in time and the members that wait to be let
        again, as turns(t) gives them now. The time to decide again is the
        second that the next turn lets its member, or -1 when no turn is
        left; while a member is let, also the next opening of a window of
        prepare_windows() without prepare_during, and its next close with
        prepare_between False; the end of the time without prepares that t
        lies inside while a member waits to be let again or an operator
        asked a member to prepare again; the first end of a prepare while
        the cap holds such a member; and the first second at which a member
        let prepare is late (late_from()). It first keeps the campaign's
        first window (keep_first())."""
        self.keep_first(t)
        self.revoke_prepares(t)
        wake = self.let_again(t)
        tr = self.turns(t)
        if self.prepare_gate():
            self.clear_turns()
            for e in tr.0:
                self.prep_turn[self.names.num[e.1]] = e.0
        next_turn = -1
        left: list[(int, str, int)] = []
        for e in tr.0:
            if e.2 <= t:
                self.allowed.add(e.1)
                self.prepare_at[e.1] = t
                self.prep_last = imax(self.prep_last, e.0)
                self.prep_turn[self.names.num[e.1]] = -1
            else:
                left.append(e)
                if next_turn < 0 or e.2 < next_turn:
                    next_turn = e.2
        wake = earliest(wake, next_turn)
        if self.prepare_gate():
            if len(self.allowed) > 0:
                pb = self.prepare_between
                for w in self.prepare_windows(t):
                    if t < w.0 and not self.prepare_during:
                        wake = earliest(wake, w.0)
                    if t < w.1 and pb is not None and not pb:
                        wake = earliest(wake, w.1)
            blocked = self.blackout_end(t)
            if blocked >= 0:
                for name in list(self.prepare_at.keys()) + list(self.prepare_now.keys()):
                    k = self.known(name)
                    st = self.prepare_state.get(name)
                    if name not in self.allowed and k >= 0 and self.waits(k) \
                       and self.answered[k] \
                       and (name in self.prepare_now or (st != "done" and st != "failed")):
                        wake = earliest(wake, blocked)
                        break
            for name in self.allowed:
                k = self.known(name)
                st = self.prepare_state.get(name)
                if k >= 0 and (st is None or st == "retrying"):
                    dl = self.prepare_deadlines(k, t)
                    if dl.0:
                        late = self.late_from(name, dl.2)
                        if late > t:
                            wake = earliest(wake, late)
        if next_turn < 0 and not self.over_budget():
            self.prep_last = -1
        return (wake, (left, tr.1, tr.2))

    def layout(self, p: Plan) -> list[(str, int, int, list[(str, int, int)])]:
        """The windows with their devices, by start: one (schedule, start,
        end, devices) entry per window that has devices, each device as
        (name, start, estimated duration), with its real start when it was
        released, the plan's start when it waits, and, when it is held or
        the run does not start it, the earliest start in the window that
        the plan's held gives it."""
        released: list[list[(int, str, int)]] = [[] for _w in self.windows]
        planned: list[list[(int, str)]] = [[] for _w in self.windows]
        for k in range(self.size):
            if self.released[k]:
                released[self.released_in[k]].append((self.released_at[k], self.name_of(k), k))
        for name, s in p.starts.items():
            if not self.is_released(name):
                planned[s.0].append((s.1, name))
        for name, h in p.held.items():
            if not self.is_released(name) and name not in p.starts:
                planned[h.0].append((h.1, name))
        out: list[(str, int, int, list[(str, int, int)])] = []
        for i in range(len(self.windows)):
            entries: list[(str, int, int)] = []
            for d in sorted(released[i]):
                entries.append((d.1, d.0, self.released_est[d.2]))
            for d in sorted(planned[i]):
                entries.append((d.1, d.0, self.est.get_def(d.1, self.estimate_s)))
            if len(entries) > 0:
                w = self.windows[i]
                out.append((w.0, w.1, w.2, entries))
        return out

    # The state of the devices by name, for the campaign and for tests.

    def is_released(self, name: str) -> bool:
        """True when the device name is released."""
        k = self.known(name)
        return k >= 0 and self.released[k]

    def has_answered(self, name: str) -> bool:
        """True when the latest report of the device name answers the
        campaign's target."""
        k = self.known(name)
        return k >= 0 and self.answered[k]

    def has_final(self, name: str) -> bool:
        """True when the device name has a final report."""
        k = self.known(name)
        return k >= 0 and self.final_at[k] != NO_TIME

    def release_time(self, name: str) -> ?int:
        """When the device name was released, or None."""
        k = self.known(name)
        if k >= 0 and self.released[k]:
            return self.released_at[k]
        return None

    def done_time(self, name: str) -> ?int:
        """When the device name was done, or None."""
        k = self.known(name)
        if k >= 0 and self.done_at[k] != NO_TIME:
            return self.done_at[k]
        return None

    def due_time(self, name: str) -> ?int:
        """When the upgrade of the released device name is expected to end,
        or None."""
        k = self.known(name)
        if k >= 0 and self.released[k]:
            return self.due[k]
        return None

    def promised_window(self, name: str) -> ?(str, int, int):
        """The window promised to the device name, or None."""
        k = self.known(name)
        if k >= 0 and self.promised[k] >= 0:
            return self.windows[self.promised[k]]
        return None

    def done_count(self) -> int:
        """How many devices are done, also without a release."""
        n = 0
        for k in range(self.size):
            if self.done_at[k] != NO_TIME or self.done_unreleased(k):
                n += 1
        return n

    def is_done(self, name: str) -> bool:
        """True when the device name is done, also without a release."""
        k = self.known(name)
        return k >= 0 and (self.done_at[k] != NO_TIME or self.done_unreleased(k))

    def released_devices(self) -> set[str]:
        """The released devices."""
        return {self.name_of(k) for k in range(self.size) if self.released[k]}

    def release_times(self) -> dict[str, int]:
        """When each released device was released."""
        return {self.name_of(k): self.released_at[k] for k in range(self.size)
                if self.released[k]}

    def release_windows(self) -> dict[str, (str, int, int)]:
        """The window each released device was released in."""
        return {self.name_of(k): self.windows[self.released_in[k]] for k in range(self.size)
                if self.released[k]}

    def done_times(self) -> dict[str, int]:
        """When each released device that is done was done."""
        return {self.name_of(k): self.done_at[k] for k in range(self.size)
                if self.done_at[k] != NO_TIME}

    def flying_devices(self) -> set[str]:
        """The devices of the campaign in flight."""
        return {self.name_of(k) for k in range(self.size) if self.flying[k]}

    def failed_devices(self) -> set[str]:
        """The devices done whose upgrade failed or rolled back, also
        without a release."""
        return {self.name_of(k) for k in range(self.size)
                if self.failed[k] or self.failed_unreleased(k)}

    def resumed_devices(self) -> set[str]:
        """The released devices that still upgraded from before a pause or
        a restart, or whose run waited to prepare again past its last
        start, which the run keeps holding."""
        return {self.name_of(k) for k in range(self.size) if self.resumed[k]}

    def upgrading(self) -> set[str]:
        """The devices in flight that run an upgrade: not the ones that
        still upgrade from before a pause or a restart, not the ones whose
        run waited to prepare again past its last start, and not the ones
        whose final report has not counted yet."""
        return {self.name_of(k) for k in range(self.size)
                if self.flying[k] and not self.resumed[k] and not self.reported[k]}


class CapFit(Fit):
    """Whether a member of place_turns() may take a place under the cap:
    its prepare from the second it would be let (Controller.let_second)
    for its expected prepare time keeps the bandwidth at or under the cap
    (Load). The members are given by device number."""
    ctl: Controller
    t: int
    free: FreeTime
    load: Load
    nums: list[int]

    def __init__(self, ctl: Controller, t: int, free: FreeTime, load: Load, nums: list[int]):
        self.ctl = ctl
        self.t = t
        self.free = free
        self.load = load
        self.nums = nums

    def span(self, j: int, pos: int) -> (int, int, int):
        """The prepare of member j at the free value pos, as (start, end,
        bandwidth) in microseconds."""
        name = self.ctl.name_of(self.nums[j])
        s = self.ctl.let_second(self.free.instant(pos, self.t * MICRO), self.t, self.free) * MICRO
        return (s, s + self.ctl.prepare_est.get_def(name, 1) * MICRO, self.ctl.prepare_bw(name))

    mut def fits(self, j: int, pos: int) -> bool:
        sp = self.span(j, pos)
        return self.load.fits(sp.0, sp.1, sp.2)

    mut def take(self, j: int, pos: int) -> None:
        sp = self.span(j, pos)
        self.load.add(sp.0, sp.1, sp.2)

    mut def no_easier(self, j: int, i: int) -> bool:
        a = self.ctl.name_of(self.nums[j])
        b = self.ctl.name_of(self.nums[i])
        return self.ctl.prepare_bw(a) >= self.ctl.prepare_bw(b) \
            and self.ctl.prepare_est.get_def(a, 1) >= self.ctl.prepare_est.get_def(b, 1)
