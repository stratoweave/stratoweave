import file
import http
import http_router
import json
import logging
import testing

import image_dir as swimg
import image_file_api as swimgapi


def _files(method: str, reply: dict[str, ?value]) -> list[(str, int)]:
    """The name and size of each file in a reply: the saved file for a PUT,
    the folder for a GET. Each file must have a modified time."""
    entries: list[?value] = [reply]
    if method == "GET":
        listed = reply["files"]
        if isinstance(listed, list):
            entries = listed
    files = []
    for entry in entries:
        if isinstance(entry, dict):
            name = entry.get("name")
            size = entry.get("size")
            modified = entry.get("modified")
            if isinstance(name, str) and isinstance(size, int) and isinstance(modified, float) and modified > 0.0:
                files.append((name, size))
                continue
        raise ValueError("Not a file: {entry}")
    return files


def _folders(reply: dict[str, ?value]) -> list[str]:
    """The name of each folder a GET reply lists."""
    folders = []
    listed = reply["folders"]
    if isinstance(listed, list):
        for entry in listed:
            if isinstance(entry, dict):
                name = entry.get("name")
                if isinstance(name, str):
                    folders.append(name)
                    continue
            raise ValueError("Not a folder: {entry}")
    return folders


actor _test_image_file_requests(t: testing.EnvT):
    """Each request, in order, gets its status and reply."""
    fc = file.FileCap(t.env.cap)
    fs = file.FS(fc)
    directory = fs.mktmpdir("test_image_file_api_")
    router = http_router.Router()
    swimgapi.install(router, swimgapi.ImageFileApi(swimg.ImageDir(fc, directory), logging.Logger(t.log_handler)))
    # files: the name and size of each file that a GET or a file PUT
    # answers with. folders: the folders that a GET lists. text: a part of
    # the error in a 4xx reply, or the kind a move answers with.
    steps: list[(method: str, path: str, body: bytes, status: int, files: list[(str, int)], folders: list[str], text: str)] = [
        (method="PUT", path="/image-file/.x", body=b"ab", status=400, files=[], folders=[], text="Invalid image path"),
        (method="PUT", path="/image-file/a.bin", body=b"", status=400, files=[], folders=[], text="no body"),
        (method="PUT", path="/image-file/a.bin", body=b"\x00\xff\r\n", status=200, files=[("a.bin", 4)], folders=[], text=""),
        (method="PUT", path="/image-file/iosxe/17.18/c.bin", body=b"cc", status=200, files=[("iosxe/17.18/c.bin", 2)], folders=[], text=""),
        (method="PUT", path="/image-folder/empty", body=b"", status=201, files=[], folders=[], text=""),
        (method="PUT", path="/image-folder/empty", body=b"", status=200, files=[], folders=[], text=""),
        (method="PUT", path="/image-folder/a.bin", body=b"", status=409, files=[], folders=[], text="a.bin is a file"),
        (method="GET", path="/image-file", body=b"", status=200, files=[("a.bin", 4), ("iosxe/17.18/c.bin", 2)], folders=["empty", "iosxe", "iosxe/17.18"], text=""),
        (method="POST", path="/image-move", body=b'{"from": "a.bin", "to": "iosxe/a.bin"}', status=200, files=[], folders=[], text="file"),
        (method="POST", path="/image-move", body=b'{"from": "iosxe", "to": "empty/iosxe"}', status=200, files=[], folders=[], text="folder"),
        (method="POST", path="/image-move", body=b'{"from": "missing", "to": "x"}', status=404, files=[], folders=[], text="No file or folder named missing"),
        (method="POST", path="/image-move", body=b'{"from": "empty", "to": "empty/x"}', status=400, files=[], folders=[], text="into itself"),
        (method="POST", path="/image-move", body=b"a.bin", status=400, files=[], folders=[], text="Send the move as JSON"),
        (method="GET", path="/image-file", body=b"", status=200, files=[("empty/iosxe/17.18/c.bin", 2), ("empty/iosxe/a.bin", 4)], folders=["empty", "empty/iosxe", "empty/iosxe/17.18"], text=""),
        (method="DELETE", path="/image-file/empty", body=b"", status=400, files=[], folders=[], text="is a folder"),
        # Not the image folder itself
        (method="DELETE", path="/image-folder", body=b"", status=400, files=[], folders=[], text="Invalid image path"),
        (method="DELETE", path="/image-folder/empty", body=b"", status=204, files=[], folders=[], text=""),
        (method="DELETE", path="/image-folder/empty", body=b"", status=404, files=[], folders=[], text="No image folder named empty"),
        (method="GET", path="/image-file", body=b"", status=200, files=[], folders=[], text=""),
        (method="PUT", path="/image-file/a.bin", body=b"a", status=200, files=[("a.bin", 1)], folders=[], text=""),
        (method="DELETE", path="/image-file/a.bin", body=b"", status=204, files=[], folders=[], text=""),
        (method="DELETE", path="/image-file/a.bin", body=b"", status=404, files=[], folders=[], text="No image file named a.bin"),
    ]
    var current = 0

    def _done(error: ?Exception):
        await async fs.rmtree(directory)
        await async fs.rmdir(directory)
        if error is not None:
            t.failure(error)
        else:
            t.success()

    def _send():
        step = steps[current]
        router.serve(http.Request(step.method, step.path, b"1.1", {}, step.body), _on_response)

    # Runs in the ImageFileApi actor's turn: check and send the next request.
    def _on_response(status: int, headers: dict[str, str], body: str):
        step = steps[current]
        try:
            testing.assertEqual(status, step.status)
            if status >= 400:
                testing.assertIn(step.text, str(json.decode(body)["error"]))
            elif step.method == "GET":
                reply = json.decode(body)
                testing.assertEqual(_files(step.method, reply), step.files)
                testing.assertEqual(_folders(reply), step.folders)
            elif step.method == "PUT" and step.path.startswith("/image-file/"):
                testing.assertEqual(_files(step.method, json.decode(body)), step.files)
            elif step.method == "POST":
                testing.assertEqual(str(json.decode(body)["kind"]), step.text)
        except Exception as e:
            _done(ValueError("{step.method} {step.path} returned {status}: {body}: {e}"))
            return
        current += 1
        if current < len(steps):
            _send()
        else:
            _done(None)

    _send()


actor _test_image_file_unreadable_folder(t: testing.EnvT):
    """A folder that cannot be read is a server error."""
    fc = file.FileCap(t.env.cap)
    fs = file.FS(fc)
    directory = fs.mktmpdir("test_image_file_api_missing_")
    router = http_router.Router()
    swimgapi.install(router, swimgapi.ImageFileApi(swimg.ImageDir(fc, directory + "/missing"), logging.Logger(t.log_handler)))

    def _on_response(status: int, headers: dict[str, str], body: str):
        await async fs.rmdir(directory)
        if status == 500 and "Cannot read image folder" in body:
            t.success()
        else:
            t.failure(ValueError("GET /image-file returned {status}: {body}"))

    router.serve(http.Request("GET", "/image-file", b"1.1", {}, b""), _on_response)
