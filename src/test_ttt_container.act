actor spurious_config(t: testing.AsyncT):
    container = ttt.Container({
        q('left'): ttt.Transform(ttt.PassThrough),
        q('right'): ttt.Transform(ttt.PassThrough)
    }) (ttt.PathRoot("0:"), None)
    t1 = container.newtrans()
    t2 = container.newtrans()

    t1.configure("1", {'srcA': tree1}, None)
    t2.configure("2", {'srcB': tree2}, None)

    def cont1(_r: value):
        t2.configure("2", {'srcB': tree3}, None)
        t2.commit("2", True)

        t1.commit("1", True)
        r = t1.get()
        testing.assertEqual(r, tree1)
        t.success()

    t1.lock("1", None, cont1)


########################

# A transaction can configure the same node several times before locking:
# late transform output — resolved links, a rebase under lock after a
# competing commit — makes the Session re-apply, so a container configured
# by source A earlier in the transaction can see a later reconfigure arrive
# with nothing for it: an empty diff. All transforms now treat an empty diff
# as a request to recompute its output, which in the list and container case
# means the output of its complete transform subtree.
actor empty_refresh(t: testing.AsyncT):
    container = ttt.Container({
        q('left'): ttt.Transform(ttt.PassThrough)
    })(ttt.PathRoot("0:"), None)
    t1 = container.newtrans()

    r1 = t1.configure("1", {'srcA': gdata.Container({q('left'): gdata.Leaf(1)})}, None)
    testing.assertEqual(r1.empty, False, "configured container must not be empty")

    # A later reconfigure has nothing for this container. Its configuration
    # is still what the earlier configure made it: non-empty.
    r2 = t1.configure("1", {}, None)
    testing.assertEqual(r2.empty, False, "empty refresh must report the accumulated state")

    # The mirror case: srcA explicitly clears its config. A refresh must now
    # keep reporting empty=True — the configuration really is gone.
    r3 = t1.configure("1", {'srcA': gdata.Absent({})}, None)
    testing.assertEqual(r3.empty, True, "explicitly cleared container must be empty")
    r4 = t1.configure("1", {}, None)
    testing.assertEqual(r4.empty, True, "empty refresh must report accumulated emptiness too")
    t.success()


actor multiple_source_delete_recreate(t: testing.AsyncT):
    """Remove two complete contributions together, then reuse their keys."""
    def state(entries: list[(str, int)]) -> gdata.Node:
        return gdata.Container({
            q("left"): gdata.List([q("name")], [
                gdata.Container({q("name"): gdata.Leaf(row.0), q("x"): gdata.Leaf(row.1)})
                for row in entries
            ]),
        })

    container = ttt.Container({
        q("left"): ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]),
    })(ttt.PathRoot("0:"), None)
    tx = container.newtrans()

    def recreated(result: ttt.CfgResult):
        try:
            testing.assertEqual(len(result.errors), 0)
            tx.commit("3", True)
            testing.assertEqual(tx.get(), state([("a", 11), ("b", 22), ("keep", 3)]))
            t.success()
        except Exception as error:
            t.failure(error)

    def deleted(result: ttt.CfgResult):
        try:
            testing.assertEqual(len(result.errors), 0)
            tx.commit("2", True)
            testing.assertEqual(tx.get(), state([("keep", 3)]))
            # A recreated transform has a new source identity. Stale contributions
            # must not survive to conflict with these changed values.
            res = tx.configure("3", {
                "newA": state([("a", 11)]),
                "newB": state([("b", 22)]),
            }, None)
            testing.assertEqual(len(res.errors), 0)
            tx.lock("3", None, recreated)
        except Exception as error:
            t.failure(error)

    def created(result: ttt.CfgResult):
        try:
            testing.assertEqual(len(result.errors), 0)
            tx.commit("1", True)
            testing.assertEqual(tx.get(), state([("a", 1), ("b", 2), ("keep", 3)]))
            # Both container and list transposition must preserve both removals.
            res = tx.configure("2", {"srcA": gdata.Absent(), "srcB": gdata.Absent()}, None)
            testing.assertEqual(len(res.errors), 0)
            tx.lock("2", None, deleted)
        except Exception as error:
            t.failure(error)

    res = tx.configure("1", {
        "srcA": state([("a", 1)]),
        "srcB": state([("b", 2)]),
        "keeper": state([("keep", 3)]),
    }, None)
    testing.assertEqual(len(res.errors), 0)
    tx.lock("1", None, created)
