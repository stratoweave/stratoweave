import testing


class Buffer(object):
    """A rewindable byte stream backed by immutable transport chunks.

    Reads and skips move a speculative cursor. consume() commits that cursor;
    rewind() restores it to the last commit. Consumed storage is compacted only
    after at least half of the retained list or first chunk is dead, keeping
    repeated consume operations amortized linear rather than quadratic.
    """

    parts: list[bytes]
    start_part: int
    start_offset: int
    cursor_part: int
    cursor_offset: int
    total_bytes: int
    unread_bytes: int
    _cached_pattern: ?bytes
    _cached_first: bytes
    _cached_search_part: int
    _cached_search_offset: int
    _cached_search_index: int

    def __init__(self):
        self.parts = []
        self.start_part = 0
        self.start_offset = 0
        self.cursor_part = 0
        self.cursor_offset = 0
        self.total_bytes = 0
        self.unread_bytes = 0
        self._cached_pattern = None
        self._cached_first = b""
        self._cached_search_part = 0
        self._cached_search_offset = 0
        self._cached_search_index = 0

    def _invalidate_search(self) -> None:
        self._cached_pattern = None

    def write_bytes(self, data: bytes) -> None:
        l = len(data)
        if l == 0:
            return
        self.parts.append(data)
        self.total_bytes += l
        self.unread_bytes += l

    def write_str(self, data: str) -> None:
        self.write_bytes(data.encode())

    def consume(self) -> None:
        """Commit bytes passed by the speculative cursor.

        Storage is cleared when empty. Otherwise dead storage is reclaimed
        geometrically, so a stream containing many messages does not copy the
        complete unread suffix after every message.
        """
        self.start_part = self.cursor_part
        self.start_offset = self.cursor_offset
        self.total_bytes = self.unread_bytes
        self._invalidate_search()

        if self.total_bytes == 0:
            self.parts = []
            self.start_part = 0
            self.start_offset = 0
            self.cursor_part = 0
            self.cursor_offset = 0
            return

        # Drop complete chunks only when at least half the retained list is
        # dead. Repeated compactions therefore copy O(n) chunk references in
        # total, not O(n^2).
        if self.start_part > 0 and self.start_part * 2 >= len(self.parts):
            dropped = self.start_part
            self.parts = self.parts[dropped:]
            self.start_part = 0
            self.cursor_part -= dropped

        # Apply the same geometric rule inside a partially consumed chunk.
        # This bounds retained byte storage without copying on every commit.
        if self.start_offset > 0:
            parts: list[bytes] = self.parts
            part = parts[self.start_part]
            if self.start_offset * 2 >= len(part):
                parts[self.start_part] = part[self.start_offset:]
                self.start_offset = 0
                self.cursor_offset = 0

    def rewind(self) -> None:
        self.cursor_part = self.start_part
        self.cursor_offset = self.start_offset
        self.unread_bytes = self.total_bytes
        self._invalidate_search()

    def read_bytes_count(self) -> int:
        return self.total_bytes - self.unread_bytes

    def has_unread_bytes(self) -> bool:
        return self.unread_bytes > 0

    def read_bytes(self, count: int) -> ?bytes:
        if count < 0:
            raise ValueError("Buffer read count cannot be negative")
        if count > self.unread_bytes:
            return None
        if count == 0:
            return b""

        parts: list[bytes] = self.parts
        part = parts[self.cursor_part]
        part_remaining = len(part) - self.cursor_offset

        # The common case needs one slice at most, and an aligned whole-chunk
        # read can return the immutable bytes object directly.
        if count <= part_remaining:
            start = self.cursor_offset
            end = start + count
            if start == 0 and end == len(part):
                result = part
            else:
                result = part[start:end]
            if end == len(part):
                self.cursor_part += 1
                self.cursor_offset = 0
            else:
                self.cursor_offset = end
            self.unread_bytes -= count
            self._invalidate_search()
            return result

        remaining = count
        acc: list[bytes] = []
        while remaining > 0:
            part = parts[self.cursor_part]
            part_remaining = len(part) - self.cursor_offset
            if remaining < part_remaining:
                acc.append(part[self.cursor_offset:self.cursor_offset + remaining])
                self.cursor_offset += remaining
                remaining = 0
            else:
                acc.append(part if self.cursor_offset == 0 else part[self.cursor_offset:])
                remaining -= part_remaining
                self.cursor_part += 1
                self.cursor_offset = 0
        self.unread_bytes -= count
        self._invalidate_search()
        return b"".join(acc)

    def read_all_bytes(self) -> bytes:
        b = self.read_bytes(self.unread_bytes)
        if b is not None:
            return b
        else:
            return b""

    def skip_bytes(self, count: int) -> ?bool:
        if count < 0:
            raise ValueError("Buffer skip count cannot be negative")
        if count > self.unread_bytes:
            return None
        remaining = count
        parts: list[bytes] = self.parts
        while remaining > 0:
            part = parts[self.cursor_part]
            part_remaining = len(part) - self.cursor_offset
            if remaining < part_remaining:
                self.cursor_offset += remaining
                remaining = 0
                break
            remaining -= part_remaining
            self.cursor_part += 1
            self.cursor_offset = 0
        self.unread_bytes -= count
        self._invalidate_search()
        return True

    def _matches_at(self, pattern: bytes,
                    part_index: int,
                    part_offset: int) -> bool:
        """Return whether pattern starts at a known readable position."""
        pattern_len = len(pattern)
        part = self.parts[part_index]
        if part_offset + pattern_len <= len(part):
            return part.find(pattern,
                             part_offset,
                             part_offset + pattern_len) == part_offset

        scan_part = part_index
        scan_offset = part_offset
        for pattern_index in range(pattern_len):
            if scan_offset == len(self.parts[scan_part]):
                scan_part += 1
                scan_offset = 0
            if self.parts[scan_part][scan_offset] != pattern[pattern_index]:
                return False
            scan_offset += 1
        return True

    def find_bytes(self, pattern: bytes) -> ?int:
        pattern_len = len(pattern)
        if pattern_len == 0:
            return 0
        elif pattern_len > self.unread_bytes:
            return None

        if self._cached_pattern == pattern:
            index = self._cached_search_index
            search_part = self._cached_search_part
            search_offset = self._cached_search_offset
            first = self._cached_first
        else:
            index = 0   # tracks absolute position in buffer
            search_part = self.cursor_part
            search_offset = self.cursor_offset
            self._cached_pattern = pattern
            first = pattern[:1]
            self._cached_first = first

        last_start = self.unread_bytes - pattern_len
        while index <= last_start:
            part = self.parts[search_part]
            pos = part.find(first, search_offset)

            if pos >= 0:
                index += pos - search_offset
                search_offset = pos
                # Keep the first possible delimiter prefix in the incomplete
                # suffix. A later write may turn it into a full match.
                if index > last_start:
                    break
                if self._matches_at(pattern, search_part, pos):
                    self._invalidate_search()
                    return index
                search_offset += 1
                index += 1
            else:
                index += len(part) - search_offset
                search_offset = len(part)

            if search_offset == len(part):
                search_part += 1
                search_offset = 0

        # Cache either the end of scanned data or the first delimiter prefix
        # in the incomplete suffix. Both positions are safe to resume after a
        # write, so repeated searches stay linear without missing split data.
        self._cached_search_part = search_part
        self._cached_search_offset = search_offset
        self._cached_search_index = index

        return None

    def match_bytes(self, pattern: bytes) -> ?bool:
        pattern_len = len(pattern)
        if pattern_len > self.unread_bytes:
            return None
        if pattern_len == 0:
            return True
        matches = self._matches_at(pattern,
                                   self.cursor_part,
                                   self.cursor_offset)
        self.skip_bytes(pattern_len)
        return matches

def _test_buffer_find_bytes_start():
    """Test finding 'hello' at beginning of buffer"""
    buf = Buffer()
    buf.write_str("hello world, this is bob")
    result = buf.find_bytes("hello".encode())
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 0, "Should find 'hello' at position 0")


def _test_buffer_find_bytes_mid():
    """Test finding 'world' in middle of buffer"""
    buf = Buffer()
    buf.write_str("hello world, this is bob")
    result = buf.find_bytes("world".encode())
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 6, "Should find 'world' at position 6")


def _test_buffer_find_bytes_end():
    """Test finding 'world' in middle of buffer"""
    buf = Buffer()
    buf.write_str("hello world, this is bob")
    result = buf.find_bytes("bob".encode())
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 21, "Should find 'bob' at position 21")


def _test_buffer_find_bytes_one():
    """Test finding space character in buffer"""
    buf = Buffer()
    buf.write_str("hello world")
    result = buf.find_bytes(" ".encode())
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 5, "Should find space at position 5")


def _test_buffer_find_bytes_not_found():
    """Test pattern not found returns None"""
    buf = Buffer()
    buf.write_str("hello world")
    result = buf.find_bytes("xyz".encode())
    testing.assertTrue(result is None, "Should return None for non-existent pattern")


# Test overlapping patterns

def _test_buffer_find_bytes_separator_single_bracket():
    """Test finding NETCONF separator preceded by single ]"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("]]]>]]>")
    result = buf.find_bytes(separator)
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 1, "Should find separator at position 1 after single ]")


def _test_buffer_find_bytes_separator_double_bracket():
    """Test finding NETCONF separator preceded by double ]]"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("]]]]>]]>")
    result = buf.find_bytes(separator)
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 2, "Should find separator at position 2 after double ]]")


def _test_buffer_find_bytes_separator_mixed_prefix():
    """Test finding NETCONF separator preceded by ]>]"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("]>]]]>]]>")
    result = buf.find_bytes(separator)
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 3, "Should find separator at position 3 after ]>]")


def _test_buffer_find_bytes_split_across_two_parts():
    """Test finding pattern split across two buffer parts"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("data]]")
    buf.write_str(">]]>more")
    result = buf.find_bytes(separator)
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 4, "Should find separator split across parts")


def _test_buffer_find_bytes_split_with_overlap():
    """Test finding pattern with overlapping character before split"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("data]")
    buf.write_str("]]>]]>more")
    result = buf.find_bytes(separator)
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 5, "Should find separator with ] before split")


def _test_buffer_find_bytes_across_three_parts():
    """Test finding pattern split across 3 buffer parts"""
    buf = Buffer()
    buf.write_str("ab")
    buf.write_str("cd")
    buf.write_str("ef")
    result = buf.find_bytes("cde".encode())
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 2, "Should find pattern across 3 parts")


def _test_buffer_find_bytes_separator_four_parts():
    """Test finding NETCONF separator split across 4 parts"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("]")
    buf.write_str("]>")
    buf.write_str("]")
    buf.write_str("]>")
    result = buf.find_bytes(separator)
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 0, "Should find separator split across 4 parts")


def _test_buffer_find_bytes_empty_pattern():
    """Test finding empty pattern returns 0"""
    buf = Buffer()
    buf.write_str("test")
    result = buf.find_bytes("".encode())
    testing.assertTrue(result is not None, "Should return int for empty pattern")
    if result is not None:
        testing.assertEqual(result, 0, "Empty pattern should return 0")


def _test_buffer_match_bytes_short_pattern_returns_none():
    buf = Buffer()
    buf.write_str("#")
    result = buf.match_bytes("##".encode())
    testing.assertNone(result, "Short buffer should return None")
    testing.assertEqual(buf.unread_bytes, 1, "Incomplete match should not consume buffered data")


def _test_buffer_find_bytes_pattern_too_long():
    """Test pattern longer than buffer returns None"""
    buf = Buffer()
    buf.write_str("short")
    result = buf.find_bytes("very long pattern".encode())
    testing.assertTrue(result is None, "Pattern longer than buffer should return None")


def _test_buffer_find_bytes_pattern_at_end():
    """Test finding pattern at the very end of buffer"""
    buf = Buffer()
    buf.write_str("data]]>]]>")
    result = buf.find_bytes("]]>]]>".encode())
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, 4, "Should find pattern at end of buffer")


def _test_buffer_find_bytes_first_separator():
    """Test finding first separator in buffer"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("first]]>]]>second]]>]]>third")
    pos = buf.find_bytes(separator)
    testing.assertTrue(pos is not None, "Should return int for found pattern")
    if pos is not None:
        testing.assertEqual(pos, 5, "Should find first separator at position 5")


def _test_buffer_find_bytes_after_consume():
    """Test finding separator after consume operation"""
    buf = Buffer()
    separator = "]]>]]>".encode()
    buf.write_str("first]]>]]>second]]>]]>third")

    # Find and skip past first separator
    pos = buf.find_bytes(separator)
    if pos is not None:
        skip_result = buf.skip_bytes(pos + len(separator))
        if skip_result is not None:
            buf.consume()

            # Find second separator
            pos2 = buf.find_bytes(separator)
            testing.assertTrue(pos2 is not None, "Should return int for found pattern")
            if pos2 is not None:
                testing.assertEqual(pos2, 6, "Should find second separator at position 6 after consume")


def _test_buffer_find_bytes_after_partial_match():
    """A failed search must reconsider a partial separator after more data arrives."""
    separator = b"]]>]]>"
    for split in range(1, len(separator)):
        buf = Buffer()
        buf.write_bytes(b"prefix" + separator[:split])
        testing.assertNone(buf.find_bytes(separator))
        buf.write_bytes(separator[split:])
        testing.assertEqual(buf.find_bytes(separator), 6)


def _test_buffer_read_rewind_and_consume():
    """Speculative reads rewind, while consumed reads stay discarded."""
    buf = Buffer()
    buf.write_bytes(b"ab")
    buf.write_bytes(b"")
    buf.write_bytes(b"cdef")

    testing.assertEqual(buf.total_bytes, 6)
    testing.assertEqual(buf.unread_bytes, 6)
    testing.assertEqual(buf.read_bytes(3), b"abc")
    testing.assertEqual(buf.read_bytes_count(), 3)
    testing.assertNone(buf.read_bytes(4))
    testing.assertEqual(buf.unread_bytes, 3, "Incomplete read must not move the cursor")

    buf.rewind()
    testing.assertEqual(buf.read_bytes(2), b"ab")
    buf.consume()
    testing.assertEqual(buf.total_bytes, 4)
    testing.assertEqual(buf.read_bytes_count(), 0)

    testing.assertEqual(buf.read_bytes(2), b"cd")
    buf.rewind()
    testing.assertEqual(buf.read_all_bytes(), b"cdef")
    buf.consume()
    testing.assertEqual(buf.total_bytes, 0)
    testing.assertEqual(len(buf.parts), 0)

    buf.write_bytes(b"reused")
    testing.assertEqual(buf.read_all_bytes(), b"reused")


def _test_buffer_fragmented_read_and_skip():
    """Reads and skips work at every chunk boundary."""
    buf = Buffer()
    for part in [b"a", b"bc", b"def", b"ghij"]:
        buf.write_bytes(part)

    testing.assertEqual(buf.read_bytes(4), b"abcd")
    testing.assertEqual(buf.skip_bytes(3), True)
    testing.assertEqual(buf.read_all_bytes(), b"hij")
    testing.assertEqual(buf.unread_bytes, 0)


def _test_buffer_match_bytes_contract():
    """Incomplete matches do not move; complete matches always consume."""
    buf = Buffer()
    buf.write_bytes(b"\n")
    testing.assertNone(buf.match_bytes(b"\n#"))
    testing.assertEqual(buf.unread_bytes, 1)
    buf.write_bytes(b"#tail")
    testing.assertEqual(buf.match_bytes(b"\n#"), True)
    buf.consume()
    testing.assertEqual(buf.match_bytes(b"no"), False)
    testing.assertEqual(buf.read_all_bytes(), b"il")


def _test_buffer_rejects_negative_counts():
    """Invalid counts fail without corrupting buffer accounting."""
    buf = Buffer()
    buf.write_bytes(b"abc")
    try:
        buf.read_bytes(-1)
        raise AssertionError("Negative read did not raise")
    except ValueError:
        pass
    try:
        buf.skip_bytes(-1)
        raise AssertionError("Negative skip did not raise")
    except ValueError:
        pass
    testing.assertEqual(buf.total_bytes, 3)
    testing.assertEqual(buf.unread_bytes, 3)
    testing.assertEqual(buf.read_all_bytes(), b"abc")


def _test_buffer_find_bytes_matches_contiguous_search():
    """Fragmentation and speculative cursor position do not change find()."""
    data = b"aba-x-ababa-]]>]]>-tail"
    patterns = [b"", b"a", b"aba", b"ababa", b"]]>]]>", b"tail", b"missing"]
    for chunk_size in range(1, 8):
        for offset in range(len(data) + 1):
            for pattern in patterns:
                buf = Buffer()
                for start in range(0, len(data), chunk_size):
                    buf.write_bytes(data[start:start + chunk_size])
                buf.skip_bytes(offset)
                expected = data.find(pattern, offset)
                actual = buf.find_bytes(pattern)
                if expected < 0:
                    testing.assertNone(actual)
                else:
                    testing.assertEqual(actual, expected - offset)


def _test_buffer_consume_many_messages():
    """Repeated commits remain correct across geometric compactions."""
    separator = b"]]>]]>"
    messages = 257
    buf = Buffer()
    buf.write_bytes(b"x]]>]]>" * messages)
    for i in range(messages):
        testing.assertEqual(buf.find_bytes(separator), 1)
        testing.assertEqual(buf.read_bytes(1), b"x")
        testing.assertEqual(buf.skip_bytes(len(separator)), True)
        buf.consume()
    testing.assertEqual(buf.total_bytes, 0)
    testing.assertEqual(buf.unread_bytes, 0)
    testing.assertEqual(len(buf.parts), 0)


def _test_buffer_consume_many_parts():
    """Complete dead chunks can be compacted without changing the cursor."""
    separator = b"]]>]]>"
    messages = 64
    buf = Buffer()
    for i in range(messages):
        buf.write_bytes(b"x]]>]]>")
    for i in range(messages):
        testing.assertEqual(buf.find_bytes(separator), 1)
        testing.assertEqual(buf.skip_bytes(1 + len(separator)), True)
        buf.consume()
    testing.assertEqual(buf.total_bytes, 0)
    testing.assertEqual(len(buf.parts), 0)


def _test_buffer_find_bytes_performance():
    """Test performance of finding pattern at end of large buffer with 64k chunks"""

    buf = Buffer()
    pattern = "]]>]]>".encode()
    chunk_size = 64 * 1024  # 64KB chunks
    total_size = 2 * 1024 * 1024  # 2MB total

    # Create a chunk of data that doesn't contain the pattern
    chunk_data = ("x" * chunk_size).encode()

    # Write chunks to buffer (2MB total) and search after each chunk
    num_chunks = total_size // chunk_size
    for i in range(num_chunks):
        buf.write_bytes(chunk_data)
        # Search for pattern after each chunk (should not be found)
        result = buf.find_bytes(pattern)
        testing.assertTrue(result is None, f"Should not find pattern after chunk {i+1}")

    # Add pattern at the very end
    buf.write_str("]]>]]>")

    # Now search for pattern (should be found at end)
    result = buf.find_bytes(pattern)

    # Verify pattern was found at correct position
    testing.assertTrue(result is not None, "Should return int for found pattern")
    if result is not None:
        testing.assertEqual(result, total_size, "Should find pattern at position 2MB")
