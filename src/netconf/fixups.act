"""Built-in NETCONF fixups."""

from netconf.fixups.base import Fixup
from netconf.fixups.duplicate_attributes import DuplicateAttributesFixup
from netconf.fixups.openconfig_list_keys import OpenConfigListKeyFixup

# Ordered default fixup constructors used by netconf.Client. Messages from the
# server go through them from the last to the first, so text fixups go last.
FIXUPS: list[proc() -> Fixup] = [
    OpenConfigListKeyFixup,
    DuplicateAttributesFixup,
]
