import file
import testing

import image_dir


def _write(fc: file.FileCap, path: str, data: bytes):
    f = file.WriteFile(file.WriteFileCap(fc), path)
    await async f.write(data)
    await async f.close()


def _check_list(fc: file.FileCap):
    fs = file.FS(fc)
    directory = fs.mktmpdir("test_image_dir_")
    try:
        _write(fc, directory + "/b.bin", b"bb")
        _write(fc, directory + "/a.bin", b"a")
        _write(fc, directory + "/.a.bin.part", b"partial")
        await async fs.mkdir(directory + "/sub")
        _write(fc, directory + "/sub/x.bin", b"x")
        files = image_dir.ImageDir(fc, directory).list()
        testing.assertEqual([f.name for f in files], ["a.bin", "b.bin"])
        testing.assertEqual([f.size for f in files], [1, 2])
        for f in files:
            testing.assertTrue(f.modified > 0.0, "modified time of {f.name}")
    finally:
        await async fs.rmtree(directory)
        await async fs.rmdir(directory)


def _check_empty_and_errors(fc: file.FileCap):
    fs = file.FS(fc)
    directory = fs.mktmpdir("test_image_dir_errors_")
    try:
        testing.assertEqual(len(image_dir.ImageDir(fc, directory).list()), 0)

        # A missing folder, and a file where the folder should be
        _write(fc, directory + "/a.bin", b"a")
        for path in [directory + "/missing", directory + "/a.bin"]:
            d = image_dir.ImageDir(fc, path)
            try:
                await async d.list()
                testing.error("Listed {path}")
            except OSError as e:
                testing.assertIn(path, e.error_message)
    finally:
        await async fs.rmtree(directory)
        await async fs.rmdir(directory)


actor _test_image_dir_list(t: testing.EnvT):
    _check_list(file.FileCap(t.env.cap))
    t.success()


actor _test_image_dir_empty_and_errors(t: testing.EnvT):
    _check_empty_and_errors(file.FileCap(t.env.cap))
    t.success()
