"""Snapshot tests of the plan timeline. The first tests draw small layouts
that are made by hand, one rule of the drawing in each. The other tests
draw the plan of the real controller in a set of scenarios, so that the
snapshots show how the controller shares the slots between windows."""

import testing

import fleet_ctl
import plan_timeline

HOUR = 3600
DAY = 86400

# Tuesday 2026-11-17 00:00 UTC.
NOV17 = 1794873600


def rounds(prefix: str, first: int, every: int, per: int, n: int,
           est: int) -> list[(str, int, int)]:
    """Return n layout devices with the estimate est, in rounds of per
    devices: the first round starts at first, and each next round every
    seconds after the round before it."""
    return [("{prefix}{i}", first + (i // per) * every, est) for i in range(n)]


def draw(layout: list[(str, int, int, list[(str, int, int)])], now: int) -> str:
    """Return the drawing of the layout on the UTC clock."""
    return plan_timeline.render(layout, 0, now)


#############################################################################
# The rules of the drawing, on layouts made by hand
#############################################################################

def _test_draw_one_window() -> str:
    """One window from 01:00 to 05:00 with 32 devices: 8 start every ten
    minutes from 01:00. Each round is a column of 8 dots, two text rows,
    in the dot column of its start. The scale is 16 dot columns per hour,
    so a dot column is 225 s and an hour is 8 characters. ▼ is now, at
    01:00."""
    layout = [("night", NOV17 + HOUR, NOV17 + 5 * HOUR,
               rounds("d", NOV17 + HOUR, 600, 8, 32, 540))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_two_lanes() -> str:
    """Two windows that overlap, a from 01:00 to 05:00 and b from 03:00 to
    07:00, go in two lanes. Each has 16 devices, 4 every 15 minutes from
    its opening."""
    layout = [("a", NOV17 + HOUR, NOV17 + 5 * HOUR,
               rounds("a", NOV17 + HOUR, 900, 4, 16, 600)),
              ("b", NOV17 + 3 * HOUR, NOV17 + 7 * HOUR,
               rounds("b", NOV17 + 3 * HOUR, 900, 4, 16, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_break() -> str:
    """Three windows with 8 devices each: a from 01:00 to 03:00, b from
    04:00 to 05:00 and c from 20:00 to 22:00. The gap of one hour between
    a and b is 16 dot columns, not more than 21, so it stays at the true
    scale, and a and b share a lane. The gap of 15 hours between b and c
    becomes a break of 7 characters with the label 15h. The tick labels
    05:00 and 20:00 next to the break stay on their side of it."""
    layout = [("a", NOV17 + HOUR, NOV17 + 3 * HOUR,
               rounds("a", NOV17 + HOUR, 600, 2, 8, 600)),
              ("b", NOV17 + 4 * HOUR, NOV17 + 5 * HOUR,
               rounds("b", NOV17 + 4 * HOUR, 600, 2, 8, 600)),
              ("c", NOV17 + 20 * HOUR, NOV17 + 22 * HOUR,
               rounds("c", NOV17 + 20 * HOUR, 600, 2, 8, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_spill() -> str:
    """30 devices start at 01:00 in a window from 01:00 to 03:00. At each
    scale they share one dot column, so the scale is the least, 16. The
    column holds 24 dots, 6 text rows, and the other 6 devices spill into
    the next dot column."""
    layout = [("w", NOV17 + HOUR, NOV17 + 3 * HOUR, rounds("d", NOV17 + HOUR, 0, 30, 30, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_grow_at_end() -> str:
    """A window from 01:00 to 02:00: 8 devices start at 01:00 and 40 at
    01:59, in the last dot column of the window. A spill would go past the
    end of the window, so the columns grow to 40 dots, 10 text rows,
    instead."""
    layout = [("w", NOV17 + HOUR, NOV17 + 2 * HOUR,
               rounds("a", NOV17 + HOUR, 0, 8, 8, 600)
               + rounds("b", NOV17 + 2 * HOUR - 60, 0, 40, 40, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_never_closes() -> str:
    """The window of a campaign without schedules: it opens at launch
    (start 0) and never closes (end OPEN_END). 50 devices start, 5 every
    half hour from 01:00, and the last ends at 05:40. The window starts on
    the axis a margin before the first start, 5 percent of the 4 h 40 min
    from the first start to the last end: at 00:46. It ends 5 percent of
    the time from 00:46 to the last end after the last end, at 05:54:42.
    The band says "always open", and
    the window line says "launch → open"."""
    layout = [("default", 0, fleet_ctl.OPEN_END, rounds("d", NOV17 + HOUR, 1800, 5, 50, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_narrow_bands() -> str:
    """Four windows of schedule night on four days, 6 h, 3 h, 90 min and
    30 min long, each with 4 devices at its opening. A band too narrow for
    its label drops the times first, then the device count, then the
    name. The plan covers four days, so the day row shows them."""
    layout = [("night", NOV17 + HOUR, NOV17 + 7 * HOUR,
               rounds("a", NOV17 + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + DAY + HOUR, NOV17 + DAY + 4 * HOUR,
               rounds("b", NOV17 + DAY + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + 2 * DAY + HOUR, NOV17 + 2 * DAY + HOUR + 5400,
               rounds("c", NOV17 + 2 * DAY + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + 3 * DAY + HOUR, NOV17 + 3 * DAY + HOUR + 1800,
               rounds("d", NOV17 + 3 * DAY + HOUR, 0, 4, 4, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_nights_across_midnight() -> str:
    """Two windows of schedule night, from 23:30 to 05:30, on Tue 17 and
    Wed 18, each with 4 devices at its opening. A day label is above the
    first tick of its day: Wed 18 above 00:00 of the first night, and Thu
    19 above 00:00 of the second. No tick of Tue 17 is on the axis, so it
    has no label, as on the web."""
    layout = [("night", NOV17 + 23 * HOUR + 1800, NOV17 + DAY + 5 * HOUR + 1800,
               rounds("a", NOV17 + 23 * HOUR + 1800, 0, 4, 4, 600)),
              ("night", NOV17 + DAY + 23 * HOUR + 1800, NOV17 + 2 * DAY + 5 * HOUR + 1800,
               rounds("b", NOV17 + DAY + 23 * HOUR + 1800, 0, 4, 4, 600))]
    return draw(layout, NOV17 + 23 * HOUR + 1800)


#############################################################################
# The plan of the controller
#############################################################################

def devices(prefix: str, n: int, est: int, schedule: str) -> list[(str, int, str)]:
    """Return n controller devices of the schedule, each with the
    estimate est."""
    return [("{prefix}{i}", est, schedule) for i in range(n)]


def daily(schedule: str, start: int, length: int, days: int) -> list[(str, int, int)]:
    """Return the windows of the schedule on days days, from start, each
    length seconds long."""
    return [(schedule, d * DAY + start, d * DAY + start + length) for d in range(days)]


def demo_devices(n: int, est: int) -> list[(str, int, str)]:
    """Return the n devices of the fleetmgr demo with the estimate est, as
    the gen-demo-fleet recipe binds them: cpe-i for i from 1 to n, on
    americas when i % 10 is 7, 8 or 9, on asia when it is 0, else on
    europe."""
    out: list[(str, int, str)] = []
    for i in range(1, n + 1):
        r = i % 10
        s = "europe"
        if r == 7 or r == 8 or r == 9:
            s = "americas"
        elif r == 0:
            s = "asia"
        out.append(("cpe-{i}", est, s))
    return out


def demo_windows(eu: int, am: int, asia: int) -> list[(str, int, int)]:
    """Return the windows of the demo: europe, americas and asia open at
    eu, am and asia, each an hour long."""
    return [("europe", eu, eu + HOUR), ("americas", am, am + HOUR), ("asia", asia, asia + HOUR)]


def make(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int, maxc: int,
         debounce: int, estimate: int, stagger: int, rung: int) -> fleet_ctl.Controller:
    """Return a controller of the windows and devices that runs, as the
    slot-sharing audit configured it. The times of the windows count from
    NOV17: a window at 0 opens at midnight, not at launch. Every device
    answers that it needs the upgrade, and the run starts with the ramp at
    rung. There are no redundancy groups, the close margin is the default,
    and no member prepares."""
    c = fleet_ctl.Controller()
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in windows], devs, target, maxc, False,
                debounce, estimate, {}, {}, {}, fleet_ctl.CLOSE_MARGIN, stagger, False,
                {d.0: 100 for d in devs}, -1, None)
    for d in devs:
        c.report(d.0, "upgrade-needed", 0)
    c.start(rung)
    return c


def picture(c: fleet_ctl.Controller, t0: int, off: int) -> str:
    """Return the drawing of the plan of the controller at t0, with now at
    t0, on the clock at UTC offset off."""
    return plan_timeline.render(c.layout(c.plan(t0)), off, t0)


def _test_plan_equal_closes() -> str:
    """Windows a and b both from 00:00 to 04:00. a has 60 devices and b
    has 20, all of 600 s, at a concurrency of 8. The two lanes run side by
    side: every ten minutes from 00:00 to 01:30, 6 devices of a and 2 of b
    start, as the audit measured."""
    wins = [("a", 0, 4 * HOUR), ("b", 0, 4 * HOUR)]
    devs = devices("a", 60, 600, "a") + devices("b", 20, 600, "b")
    return picture(make(wins, devs, 8, 8, 0, 600, 0, 8), NOV17, 0)


def _test_plan_three_open_together() -> str:
    """The demo shape with the three windows open together: europe,
    americas and asia all from 00:00:30 to 01:00:30, 100 devices of 8 s
    (60, 30 and 10), target 8, max 16, stagger 25, the ramp from 1, the
    run from 00:03:20. The scale is 96 dot columns per hour, 37.5 s for
    each dot column. The three lanes run side by side: their columns are
    in the same characters, the europe columns the tallest and the asia
    columns the shortest. The first starts are at 00:03:20, 00:03:29 and
    00:03:39, the last starts at 00:05:18, 00:05:18 and 00:05:09. The
    audit measured about 4 devices of europe, 3 of americas and 1 of asia
    in flight."""
    wins = demo_windows(30, 30, 30)
    return picture(make(wins, demo_devices(100, 8), 8, 16, 1, 8, 25, 1), NOV17 + 200, 0)


def _test_plan_demo_1000() -> str:
    """The demo at a thousand devices: europe opens at 00:00:30, americas
    at 00:01:30 and asia at 00:02:30, each for an hour, 600, 300 and 100
    devices of 8 s, target 8, max 16, stagger 25, the ramp from 1, the run
    from 00:03:20. Europe and americas run side by side from 00:03:20
    until europe's last start at 00:19:59. The europe columns are about
    three times as tall as the americas columns at first, and about twice
    as tall later: the audit measured 6 of europe and 2 of americas in
    flight from 00:04:10 to 00:08:20, and about 5 and 3 after that. Asia
    starts one or two devices in each dot column from 00:10:32, and most
    of its devices after europe's last start."""
    wins = demo_windows(30, 90, 150)
    return picture(make(wins, demo_devices(1000, 8), 8, 16, 1, 8, 25, 1), NOV17 + 200, 0)


def _test_plan_overload() -> str:
    """More work than the windows hold: B from 00:00 to 01:00 with 30
    devices, C from 00:00 to 01:30 with 30, A from 00:00 to 01:40 with
    100, all of 600 s, at a concurrency of 10. The three lanes run side
    by side: every ten minutes from 00:00 to 00:40, 6 of A, 2 of B and 2 of
    C start, or 5, 3 and 2, in turn, as the audit measured. After the last
    start of B at 00:40, A takes the slots of B."""
    wins = [("B", 0, HOUR), ("C", 0, 5400), ("A", 0, 6000)]
    devs = devices("b", 30, 600, "B") + devices("c", 30, 600, "C") + devices("a", 100, 600, "A")
    return picture(make(wins, devs, 10, 10, 0, 600, 0, 10), NOV17, 0)


def _test_plan_demo() -> str:
    """The demo at 100 devices: europe opens at 00:00:30, americas at
    00:01:30 and asia at 00:02:30, each for an hour, 60, 30 and 10 devices
    of 8 s, target 8, max 16, stagger 25, the ramp from 1. The run starts
    at 00:03:20, when the three windows are open. Today the slots go to
    one region after the other, and the columns of the three lanes follow
    each other: europe starts from 00:03:20 to 00:04:33, americas from
    00:04:33 to 00:05:09, and asia from 00:05:09 to 00:05:18, as the audit
    measured."""
    wins = demo_windows(30, 90, 150)
    return picture(make(wins, demo_devices(100, 8), 8, 16, 1, 8, 25, 1), NOV17 + 200, 0)


def _test_plan_opens_later_closes_first() -> str:
    """b from 00:00 to 04:00 with 10 devices, a from 00:10 to 02:00 with
    12, all of 600 s, at a concurrency of 4. Today b starts 4 devices at
    00:00. From 00:10, a takes every slot: 4 devices at 00:10, 00:20 and
    00:30. b starts its other 6 devices after a, at 00:40 and 00:50, as
    the audit measured."""
    wins = [("b", 0, 4 * HOUR), ("a", 600, 2 * HOUR)]
    devs = devices("b", 10, 600, "b") + devices("a", 12, 600, "a")
    return picture(make(wins, devs, 4, 4, 0, 600, 0, 4), NOV17, 0)


def _test_plan_later_window_counts_now() -> str:
    """A has a window every day from 00:00 to 01:00 and 100 devices; B has
    a window on day 0 and on day 7 at the same time and 10 devices; all
    of 600 s, at a concurrency of 10. A's work in its later windows counts
    now, so B gets one slot of ten on Tuesday 17: every ten minutes from
    00:00 to 00:40, 9 of A and 1 of B start. 5 of B start on Tuesday 17,
    and the other 5 wait a week, to Tuesday 24. A starts 45 devices on
    Tuesday, 50 on Wednesday and 5 on Thursday, as the audit measured."""
    wins = daily("A", 0, HOUR, 9) + [("B", 0, HOUR), ("B", 7 * DAY, 7 * DAY + HOUR)]
    devs = devices("a", 100, 600, "A") + devices("b", 10, 600, "B")
    return picture(make(wins, devs, 10, 10, 0, 600, 0, 10), NOV17, 0)


# demo-big on Tuesday 2026-11-17, on central European time (UTC+1).
CET = 3600

# 06:00 CET: midnight at UTC-5, when the americas windows open.
AMERICAS = NOV17 + 5 * HOUR

# 09:36 CET: the europe windows open here, pulled forward to the start of
# the demo.
EUROPE = NOV17 + 8 * HOUR + 36 * 60

# 17:00 CET: midnight at UTC+8, when the asia windows open.
ASIA = NOV17 + 16 * HOUR

# 09:36:30 CET: the run starts.
RUN = EUROPE + 30


def big_estimate(i: int) -> int:
    """Return the upgrade time of device i of demo-big, from 120 to 150 s,
    as gen-demo-fleet spreads the duration 120-150."""
    return 120 + (i * 7) % 31


def big_name(i: int) -> str:
    """Return the name of device i of demo-big, cpe-0001 to cpe-1000."""
    return "cpe-" + str(i).zfill(4)


def big_controller() -> fleet_ctl.Controller:
    """Return the controller of `just demo-big` as fleetmgr configures it
    at RUN, running from RUN.

    The fleet is 1000 devices: americas when i % 10 is 7, 8 or 9 (300),
    asia when it is 0 (100), else europe (600). Each window is 4 hours.
    The schedules give a window for each day of the horizon of 9 days
    that is open at RUN or opens later: europe and americas from today,
    asia from 17:00 today. Devices i and i + 1 are in the redundancy group
    site-i when i % 30 is 1, and these groups spread. cpe-0003 to cpe-0005
    are in the group hub, which packs with a min-separation of 60 s, and
    cpe-0005 has the priority 50. The others have the default 100. Target
    10, max 20, the debounce 1 s for 1000 devices, the estimate the mean
    of the device estimates rounded up, the default close margin 150,
    stagger 25, no prepare, no failure budget, no group holds on a failure,
    and no deadline. Each device answers that it needs the upgrade, and
    the run starts with the ramp at 1, as the campaign starts it."""
    n = 1000
    devs: list[(str, int, str)] = []
    groups: dict[str, list[str]] = {}
    priority: dict[str, int] = {}
    separation: dict[str, (bool, int)] = {}
    prepare_est: dict[str, int] = {}
    total = 0
    for i in range(1, n + 1):
        name = big_name(i)
        r = i % 10
        s = "europe"
        if r == 7 or r == 8 or r == 9:
            s = "americas"
        elif r == 0:
            s = "asia"
        est = big_estimate(i)
        total += est
        devs.append((name, est, s))
        priority[name] = 50 if i == 5 else 100
        prepare_est[name] = fleet_ctl.imax(1, est * 130 // 395)
        site = ""
        if i % 30 == 1 and i < n:
            site = "site-" + str(i).zfill(4)
        elif i % 30 == 2:
            site = "site-" + str(i - 1).zfill(4)
        if site != "":
            if site not in groups:
                groups[site] = []
                separation[site] = (True, 0)
            groups[site].append(name)
        if i >= 3 and i <= 5:
            if "hub" not in groups:
                groups["hub"] = []
                separation["hub"] = (False, 60)
            groups["hub"].append(name)
    wins = daily("europe", EUROPE, 4 * HOUR, 9) + daily("americas", AMERICAS, 4 * HOUR, 9) \
        + daily("asia", ASIA, 4 * HOUR, 8)
    c = fleet_ctl.Controller()
    c.configure(wins, devs, 10, 20, False, 1, (total + n - 1) // n, groups, priority, separation,
                fleet_ctl.CLOSE_MARGIN, 25, False, prepare_est, -1, set())
    for d in devs:
        c.report(d.0, "upgrade-needed", RUN)
    c.start(1)
    return c


def _test_plan_demo_big_0936() -> str:
    """`just demo-big` as in the screenshot: the plan at 09:36:30 CET on
    Tuesday 2026-11-17, when the run starts. The americas window is open
    from 06:00 to 10:00, europe opens at 09:36 until 13:36, and asia opens
    at 17:00 until 21:00. Today the slots go to one window after the
    other. Americas starts 78 devices from 09:36:30 to 09:56:54, and its
    other 222 devices wait for its window on Wednesday 18 at 06:00. Europe
    waits for americas and starts its 600 devices from 09:57:08 to
    12:14:10. Asia starts its 100 devices from 17:00:00 to 17:21:22."""
    return picture(big_controller(), RUN, CET)
