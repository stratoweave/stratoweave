"""Snapshot tests of the plan timeline. The first tests draw small layouts
that are made by hand, one rule of the drawing in each. The other tests
draw the plan of the real controller in a set of scenarios, so that the
snapshots show how the controller shares the slots between windows, how
its plan changes through a pause or an edit of a run, and when the
members prepare."""

import testing

import fleet_ctl
import plan_timeline

HOUR = 3600
DAY = 86400

# Tuesday 2026-11-17 00:00 UTC.
NOV17 = 1794873600

# An image of 1 GB, in bytes.
GB = 1000000000

# The cap of the bandwidth of the prepares that a campaign gets by default,
# 1 Gbit/s, in bits per second.
GBIT = 1000000000


def rounds(prefix: str, first: int, every: int, per: int, n: int,
           est: int) -> list[(str, int, int)]:
    """Return n layout devices with the estimate est, in rounds of per
    devices: the first round starts at first, and each next round every
    seconds after the round before it."""
    return [("{prefix}{i}", first + (i // per) * every, est) for i in range(n)]


def draw(layout: list[(str, int, int, list[(str, int, int)])], now: int) -> str:
    """Return the drawing of the layout on the UTC clock."""
    return plan_timeline.render(layout, 0, now)


#############################################################################
# The rules of the drawing, on layouts made by hand
#############################################################################

def _test_draw_one_window() -> str:
    """One window from 01:00 to 05:00 with 32 devices: 8 start every ten
    minutes from 01:00. Each round is a column of 8 dots, two text rows,
    in the dot column of its start. The scale is 16 dot columns per hour,
    so a dot column is 225 s and an hour is 8 characters. ▼ is now, at
    01:00."""
    layout = [("night", NOV17 + HOUR, NOV17 + 5 * HOUR,
               rounds("d", NOV17 + HOUR, 600, 8, 32, 540))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_two_lanes() -> str:
    """Two windows that overlap, a from 01:00 to 05:00 and b from 03:00 to
    07:00, go in two lanes. Each has 16 devices, 4 every 15 minutes from
    its opening."""
    layout = [("a", NOV17 + HOUR, NOV17 + 5 * HOUR,
               rounds("a", NOV17 + HOUR, 900, 4, 16, 600)),
              ("b", NOV17 + 3 * HOUR, NOV17 + 7 * HOUR,
               rounds("b", NOV17 + 3 * HOUR, 900, 4, 16, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_break() -> str:
    """Three windows with 8 devices each: a from 01:00 to 03:00, b from
    04:00 to 05:00 and c from 20:00 to 22:00. The gap of one hour between
    a and b is 16 dot columns, not more than 21, so it stays at the true
    scale, and a and b share a lane. The gap of 15 hours between b and c
    becomes a break of 7 characters with the label 15h. The tick labels
    05:00 and 20:00 next to the break stay on their side of it."""
    layout = [("a", NOV17 + HOUR, NOV17 + 3 * HOUR,
               rounds("a", NOV17 + HOUR, 600, 2, 8, 600)),
              ("b", NOV17 + 4 * HOUR, NOV17 + 5 * HOUR,
               rounds("b", NOV17 + 4 * HOUR, 600, 2, 8, 600)),
              ("c", NOV17 + 20 * HOUR, NOV17 + 22 * HOUR,
               rounds("c", NOV17 + 20 * HOUR, 600, 2, 8, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_spill() -> str:
    """30 devices start at 01:00 in a window from 01:00 to 03:00. At each
    scale they share one dot column, so the scale is the least, 16. The
    column holds 24 dots, 6 text rows, and the other 6 devices spill into
    the next dot column."""
    layout = [("w", NOV17 + HOUR, NOV17 + 3 * HOUR, rounds("d", NOV17 + HOUR, 0, 30, 30, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_grow_at_end() -> str:
    """A window from 01:00 to 02:00: 8 devices start at 01:00 and 40 at
    01:59, in the last dot column of the window. A spill would go past the
    end of the window, so the columns grow to 40 dots, 10 text rows,
    instead."""
    layout = [("w", NOV17 + HOUR, NOV17 + 2 * HOUR,
               rounds("a", NOV17 + HOUR, 0, 8, 8, 600)
               + rounds("b", NOV17 + 2 * HOUR - 60, 0, 40, 40, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_never_closes() -> str:
    """The window of a campaign without schedules: it opens at launch
    (start 0) and never closes (end OPEN_END). 50 devices start, 5 every
    half hour from 01:00, and the last ends at 05:40. The window starts on
    the axis a margin before the first start, 5 percent of the 4 h 40 min
    from the first start to the last end: at 00:46. It ends 5 percent of
    the time from 00:46 to the last end after the last end, at 05:54:42.
    The band says "always open", and
    the window line says "launch → open"."""
    layout = [("default", 0, fleet_ctl.OPEN_END, rounds("d", NOV17 + HOUR, 1800, 5, 50, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_narrow_bands() -> str:
    """Four windows of schedule night on four days, 6 h, 3 h, 90 min and
    30 min long, each with 4 devices at its opening. A band too narrow for
    its label drops the times first, then the device count, then the
    name. The plan covers four days, so the day row shows them."""
    layout = [("night", NOV17 + HOUR, NOV17 + 7 * HOUR,
               rounds("a", NOV17 + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + DAY + HOUR, NOV17 + DAY + 4 * HOUR,
               rounds("b", NOV17 + DAY + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + 2 * DAY + HOUR, NOV17 + 2 * DAY + HOUR + 5400,
               rounds("c", NOV17 + 2 * DAY + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + 3 * DAY + HOUR, NOV17 + 3 * DAY + HOUR + 1800,
               rounds("d", NOV17 + 3 * DAY + HOUR, 0, 4, 4, 600))]
    return draw(layout, NOV17 + HOUR)


def _test_draw_nights_across_midnight() -> str:
    """Two windows of schedule night, from 23:30 to 05:30, on Tue 17 and
    Wed 18, each with 4 devices at its opening. A day label is above the
    first tick of its day: Wed 18 above 00:00 of the first night, and Thu
    19 above 00:00 of the second. No tick of Tue 17 is on the axis, so it
    has no label, as on the web."""
    layout = [("night", NOV17 + 23 * HOUR + 1800, NOV17 + DAY + 5 * HOUR + 1800,
               rounds("a", NOV17 + 23 * HOUR + 1800, 0, 4, 4, 600)),
              ("night", NOV17 + DAY + 23 * HOUR + 1800, NOV17 + 2 * DAY + 5 * HOUR + 1800,
               rounds("b", NOV17 + DAY + 23 * HOUR + 1800, 0, 4, 4, 600))]
    return draw(layout, NOV17 + 23 * HOUR + 1800)


def _test_draw_prepares() -> str:
    """A window from 01:00 to 03:00 on Tue 17 with 8 devices, 4 at 01:00
    and 4 at 01:10, and their prepares before it. Each device prepares
    for 30 minutes, one every 15 minutes from 22:00 on Mon 16, so that two
    prepares run at a time. d0 to d3 copy an image of 1 GB, 4.4 Mbit/s for
    30 minutes, and d4 to d7 an image of 2 GB, 8.9 Mbit/s. The axis
    starts at the first prepare-start, and the gap of 45 minutes from the
    end of the last prepare to the window stays at the true scale. The
    prepare lane has one dot for each device, at 22:00, 22:15 and so on to
    23:45. Above it, the bandwidth line goes up in steps of a quarter of
    the peak: 4.4 Mbit/s from 22:00, 8.9 from 22:15, 13 from 23:00, when
    d3 and d4 run, and the peak of 18 Mbit/s from 23:15 to 00:00, when two
    prepares of 2 GB run. It goes down to 8.9 Mbit/s until the last
    prepare ends at 00:15 on Tue 17. The prepare line under the drawing
    gives these times."""
    layout = [("night", NOV17 + HOUR, NOV17 + 3 * HOUR,
               rounds("d", NOV17 + HOUR, 600, 4, 8, 600))]
    prepares = [("d{i}", NOV17 - 2 * HOUR + i * 900, 1800) for i in range(8)]
    sizes = {"d{i}": GB if i < 4 else 2 * GB for i in range(8)}
    return plan_timeline.render(layout, 0, NOV17 - 2 * HOUR, prepares, sizes)


def _test_draw_prepares_between_windows() -> str:
    """Windows from 01:00 to 03:00 on Tue 17 and on Wed 18, each with 4
    devices at its opening. The devices of Wed 18 prepare between the
    windows, each for 30 minutes and with an image of 1 GB: b0 at 12:00,
    b1 at 12:15 and b2 at 12:30, and b3 at 20:00. The axis covers the
    prepares, from 12:00 to 13:00 and from 20:00 to 20:30, at the true
    scale. The gaps with neither prepares nor windows become breaks: 9h
    from 03:00 to 12:00, 7h from 13:00 to 20:00, and 4h30m from 20:30 to
    01:00. The bandwidth is 4.4 Mbit/s with one prepare and the peak, 8.9
    Mbit/s, with two."""
    layout = [("night", NOV17 + HOUR, NOV17 + 3 * HOUR, rounds("a", NOV17 + HOUR, 0, 4, 4, 600)),
              ("night", NOV17 + DAY + HOUR, NOV17 + DAY + 3 * HOUR,
               rounds("b", NOV17 + DAY + HOUR, 0, 4, 4, 600))]
    prepares = [("b0", NOV17 + 12 * HOUR, 1800), ("b1", NOV17 + 12 * HOUR + 900, 1800),
                ("b2", NOV17 + 12 * HOUR + 1800, 1800), ("b3", NOV17 + 20 * HOUR, 1800)]
    sizes = {"b{i}": GB for i in range(4)}
    return plan_timeline.render(layout, 0, NOV17 + 12 * HOUR, prepares, sizes)


def _test_draw_prepares_that_run_later() -> str:
    """A window from 01:00 to 03:00 on Tue 17 with 4 devices at 01:00, and
    their prepares before it, each for 30 minutes with an image of 1 GB,
    4.4 Mbit/s. d0 and d1 have the prepare-start 22:00 on Mon 16, and d2
    and d3 22:15. d0 and d2 run from their prepare-starts, d1 from 23:00,
    and d3 does not run. The prepare lane has the dots at the
    prepare-starts, two at 22:00 and two at 22:15. The bandwidth line has
    the peak of 8.9 Mbit/s from 22:15, when d2 begins, to 22:30, when d0
    ends, and 4.4 Mbit/s until d2 ends at 22:45, and again from 23:00 to
    23:30, while d1 runs. The prepares end at 23:30."""
    layout = [("night", NOV17 + HOUR, NOV17 + 3 * HOUR, rounds("d", NOV17 + HOUR, 0, 4, 4, 600))]
    prepares = [("d0", NOV17 - 2 * HOUR, 1800), ("d1", NOV17 - 2 * HOUR, 1800),
                ("d2", NOV17 - 105 * 60, 1800), ("d3", NOV17 - 105 * 60, 1800)]
    sizes = {"d{i}": GB for i in range(4)}
    runs = {"d1": NOV17 - HOUR, "d3": -1}
    return plan_timeline.render(layout, 0, NOV17 - 2 * HOUR, prepares, sizes, runs)


#############################################################################
# The plan of the controller
#############################################################################

def devices(prefix: str, n: int, est: int, schedule: str) -> list[(str, int, str)]:
    """Return n controller devices of the schedule, each with the
    estimate est."""
    return [("{prefix}{i}", est, schedule) for i in range(n)]


def daily(schedule: str, start: int, length: int, days: int) -> list[(str, int, int)]:
    """Return the windows of the schedule on days days, from start, each
    length seconds long."""
    return [(schedule, d * DAY + start, d * DAY + start + length) for d in range(days)]


def demo_devices(n: int, est: int) -> list[(str, int, str)]:
    """Return the n devices of the fleetmgr demo with the estimate est, as
    the gen-demo-fleet recipe binds them: cpe-i for i from 1 to n, on
    americas when i % 10 is 7, 8 or 9, on asia when it is 0, else on
    europe."""
    out: list[(str, int, str)] = []
    for i in range(1, n + 1):
        r = i % 10
        s = "europe"
        if r == 7 or r == 8 or r == 9:
            s = "americas"
        elif r == 0:
            s = "asia"
        out.append(("cpe-{i}", est, s))
    return out


def demo_windows(eu: int, am: int, asia: int) -> list[(str, int, int)]:
    """Return the windows of the demo: europe, americas and asia open at
    eu, am and asia, each an hour long."""
    return [("europe", eu, eu + HOUR), ("americas", am, am + HOUR), ("asia", asia, asia + HOUR)]


def make(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int, maxc: int,
         debounce: int, estimate: int, stagger: int, rung: int) -> fleet_ctl.Controller:
    """Return a controller of the windows and devices that runs, as the
    slot-sharing audit configured it. The times of the windows count from
    NOV17: a window at 0 opens at midnight, not at launch. Every device
    answers that it needs the upgrade, and the run starts with the ramp at
    rung. There are no redundancy groups, the close margin is the default,
    and no member prepares."""
    c = fleet_ctl.Controller()
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in windows], devs, target, maxc, False,
                debounce, estimate, {}, {}, {}, fleet_ctl.CLOSE_MARGIN, stagger, False,
                {d.0: 100 for d in devs}, -1, None)
    for d in devs:
        c.report(d.0, "upgrade-needed", 0)
    c.start(rung)
    return c


def picture(c: fleet_ctl.Controller, t0: int, off: int) -> str:
    """Return the drawing of the plan of the controller at t0, with now at
    t0, on the clock at UTC offset off."""
    return plan_timeline.render(c.layout(c.plan(t0)), off, t0)


def _test_plan_equal_closes() -> str:
    """Windows a and b both from 00:00 to 04:00. a has 60 devices and b
    has 20, all of 600 s, at a concurrency of 8. The two lanes run side by
    side: every ten minutes from 00:00 to 01:30, 6 devices of a and 2 of b
    start, as the audit measured."""
    wins = [("a", 0, 4 * HOUR), ("b", 0, 4 * HOUR)]
    devs = devices("a", 60, 600, "a") + devices("b", 20, 600, "b")
    return picture(make(wins, devs, 8, 8, 0, 600, 0, 8), NOV17, 0)


def _test_plan_three_open_together() -> str:
    """The demo shape with the three windows open together: europe,
    americas and asia all from 00:00:30 to 01:00:30, 100 devices of 8 s
    (60, 30 and 10), target 8, max 16, stagger 25, the ramp from 1, the
    run from 00:03:20. The scale is 96 dot columns per hour, 37.5 s for
    each dot column. The three lanes run side by side: their columns are
    in the same characters, the europe columns the tallest and the asia
    columns the shortest. The first starts are at 00:03:20, 00:03:29 and
    00:03:39, the last starts at 00:05:18, 00:05:18 and 00:05:09. The
    audit measured about 4 devices of europe, 3 of americas and 1 of asia
    in flight."""
    wins = demo_windows(30, 30, 30)
    return picture(make(wins, demo_devices(100, 8), 8, 16, 1, 8, 25, 1), NOV17 + 200, 0)


def _test_plan_demo_1000() -> str:
    """The demo at a thousand devices: europe opens at 00:00:30, americas
    at 00:01:30 and asia at 00:02:30, each for an hour, 600, 300 and 100
    devices of 8 s, target 8, max 16, stagger 25, the ramp from 1, the run
    from 00:03:20. Europe and americas run side by side from 00:03:20
    until europe's last start at 00:19:59. The europe columns are about
    three times as tall as the americas columns at first, and about twice
    as tall later: the audit measured 6 of europe and 2 of americas in
    flight from 00:04:10 to 00:08:20, and about 5 and 3 after that. Asia
    starts one or two devices in each dot column from 00:10:32, and most
    of its devices after europe's last start."""
    wins = demo_windows(30, 90, 150)
    return picture(make(wins, demo_devices(1000, 8), 8, 16, 1, 8, 25, 1), NOV17 + 200, 0)


def _test_plan_overload() -> str:
    """More work than the windows hold: B from 00:00 to 01:00 with 30
    devices, C from 00:00 to 01:30 with 30, A from 00:00 to 01:40 with
    100, all of 600 s, at a concurrency of 10. The three lanes run side
    by side: every ten minutes from 00:00 to 00:40, 6 of A, 2 of B and 2 of
    C start, or 5, 3 and 2, in turn, as the audit measured. After the last
    start of B at 00:40, A takes the slots of B."""
    wins = [("B", 0, HOUR), ("C", 0, 5400), ("A", 0, 6000)]
    devs = devices("b", 30, 600, "B") + devices("c", 30, 600, "C") + devices("a", 100, 600, "A")
    return picture(make(wins, devs, 10, 10, 0, 600, 0, 10), NOV17, 0)


def _test_plan_demo() -> str:
    """The demo at 100 devices: europe opens at 00:00:30, americas at
    00:01:30 and asia at 00:02:30, each for an hour, 60, 30 and 10 devices
    of 8 s, target 8, max 16, stagger 25, the ramp from 1. The run starts
    at 00:03:20, when the three windows are open. Today the slots go to
    one region after the other, and the columns of the three lanes follow
    each other: europe starts from 00:03:20 to 00:04:33, americas from
    00:04:33 to 00:05:09, and asia from 00:05:09 to 00:05:18, as the audit
    measured."""
    wins = demo_windows(30, 90, 150)
    return picture(make(wins, demo_devices(100, 8), 8, 16, 1, 8, 25, 1), NOV17 + 200, 0)


def _test_plan_opens_later_closes_first() -> str:
    """b from 00:00 to 04:00 with 10 devices, a from 00:10 to 02:00 with
    12, all of 600 s, at a concurrency of 4. Today b starts 4 devices at
    00:00. From 00:10, a takes every slot: 4 devices at 00:10, 00:20 and
    00:30. b starts its other 6 devices after a, at 00:40 and 00:50, as
    the audit measured."""
    wins = [("b", 0, 4 * HOUR), ("a", 600, 2 * HOUR)]
    devs = devices("b", 10, 600, "b") + devices("a", 12, 600, "a")
    return picture(make(wins, devs, 4, 4, 0, 600, 0, 4), NOV17, 0)


def _test_plan_later_window_counts_now() -> str:
    """A has a window every day from 00:00 to 01:00 and 100 devices; B has
    a window on day 0 and on day 7 at the same time and 10 devices; all
    of 600 s, at a concurrency of 10. A's work in its later windows counts
    now, so B gets one slot of ten on Tuesday 17: every ten minutes from
    00:00 to 00:40, 9 of A and 1 of B start. 5 of B start on Tuesday 17,
    and the other 5 wait a week, to Tuesday 24. A starts 45 devices on
    Tuesday, 50 on Wednesday and 5 on Thursday, as the audit measured."""
    wins = daily("A", 0, HOUR, 9) + [("B", 0, HOUR), ("B", 7 * DAY, 7 * DAY + HOUR)]
    devs = devices("a", 100, 600, "A") + devices("b", 10, 600, "B")
    return picture(make(wins, devs, 10, 10, 0, 600, 0, 10), NOV17, 0)


# demo-big on Tuesday 2026-11-17, on central European time (UTC+1).
CET = 3600

# 06:00 CET: midnight at UTC-5, when the americas windows open.
AMERICAS = NOV17 + 5 * HOUR

# 09:36 CET: the europe windows open here, pulled forward to the start of
# the demo.
EUROPE = NOV17 + 8 * HOUR + 36 * 60

# 17:00 CET: midnight at UTC+8, when the asia windows open.
ASIA = NOV17 + 16 * HOUR

# 09:36:30 CET: the run starts.
RUN = EUROPE + 30


def big_estimate(i: int) -> int:
    """Return the upgrade time of device i of demo-big, from 120 to 150 s,
    as gen-demo-fleet spreads the duration 120-150."""
    return 120 + (i * 7) % 31


def big_name(i: int) -> str:
    """Return the name of device i of demo-big, cpe-0001 to cpe-1000."""
    return "cpe-" + str(i).zfill(4)


def big_controller() -> fleet_ctl.Controller:
    """Return the controller of `just demo-big` as fleetmgr configures it
    at RUN, running from RUN.

    The fleet is 1000 devices: americas when i % 10 is 7, 8 or 9 (300),
    asia when it is 0 (100), else europe (600). Each window is 4 hours.
    The schedules give a window for each day of the horizon of 9 days
    that is open at RUN or opens later: europe and americas from today,
    asia from 17:00 today. Devices i and i + 1 are in the redundancy group
    site-i when i % 30 is 1, and these groups spread. cpe-0003 to cpe-0005
    are in the group hub, which packs with a min-separation of 60 s, and
    cpe-0005 has the priority 50. The others have the default 100. Target
    10, max 20, the debounce 1 s for 1000 devices, the estimate the mean
    of the device estimates rounded up, the default close margin 150,
    stagger 25, no prepare, no failure budget, no group holds on a failure,
    and no deadline. Each device answers that it needs the upgrade, and
    the run starts with the ramp at 1, as the campaign starts it."""
    n = 1000
    devs: list[(str, int, str)] = []
    groups: dict[str, list[str]] = {}
    priority: dict[str, int] = {}
    separation: dict[str, (bool, int)] = {}
    prepare_est: dict[str, int] = {}
    total = 0
    for i in range(1, n + 1):
        name = big_name(i)
        r = i % 10
        s = "europe"
        if r == 7 or r == 8 or r == 9:
            s = "americas"
        elif r == 0:
            s = "asia"
        est = big_estimate(i)
        total += est
        devs.append((name, est, s))
        priority[name] = 50 if i == 5 else 100
        prepare_est[name] = fleet_ctl.imax(1, est * 130 // 395)
        site = ""
        if i % 30 == 1 and i < n:
            site = "site-" + str(i).zfill(4)
        elif i % 30 == 2:
            site = "site-" + str(i - 1).zfill(4)
        if site != "":
            if site not in groups:
                groups[site] = []
                separation[site] = (True, 0)
            groups[site].append(name)
        if i >= 3 and i <= 5:
            if "hub" not in groups:
                groups["hub"] = []
                separation["hub"] = (False, 60)
            groups["hub"].append(name)
    wins = daily("europe", EUROPE, 4 * HOUR, 9) + daily("americas", AMERICAS, 4 * HOUR, 9) \
        + daily("asia", ASIA, 4 * HOUR, 8)
    c = fleet_ctl.Controller()
    c.configure(wins, devs, 10, 20, False, 1, (total + n - 1) // n, groups, priority, separation,
                fleet_ctl.CLOSE_MARGIN, 25, False, prepare_est, -1, set())
    for d in devs:
        c.report(d.0, "upgrade-needed", RUN)
    c.start(1)
    return c


def _test_plan_demo_big_0936() -> str:
    """`just demo-big` as in the screenshot: the plan at 09:36:30 CET on
    Tuesday 2026-11-17, when the run starts. The americas window is open
    from 06:00 to 10:00, europe opens at 09:36 until 13:36, and asia opens
    at 17:00 until 21:00. Today the slots go to one window after the
    other. Americas starts 78 devices from 09:36:30 to 09:56:54, and its
    other 222 devices wait for its window on Wednesday 18 at 06:00. Europe
    waits for americas and starts its 600 devices from 09:57:08 to
    12:14:10. Asia starts its 100 devices from 17:00:00 to 17:21:22."""
    return picture(big_controller(), RUN, CET)


#############################################################################
# Members that already run the target
#############################################################################

def panel(label: str, c: fleet_ctl.Controller, t: int) -> str:
    """Return a panel of the plan of c at t: the label with the
    concurrency of the plan, the drawing of the plan with now at t on the
    UTC clock, and the alarms of the plan. The plan is made on a copy of
    c, so c does not change."""
    x = c.copy()
    p = x.plan(t)
    out = "{label}: the plan runs at concurrency {p.c}\n\n" \
        + plan_timeline.render(x.layout(p), 0, t)
    for a in p.alarms:
        out += "alarm: {a}\n"
    return out


def up_to_date(c: fleet_ctl.Controller, names: list[str], at: int) -> None:
    """Make each device in names answer at the second at that it runs the
    target already."""
    for name in names:
        c.report(name, "up-to-date", at)


def _test_up_to_date_members() -> str:
    """Members that run the target already. The schedule night has a
    window from 01:00 to 03:00 on Tue 17 and on Wed 18, and 60 devices of
    600 s. Target 4, max 8, the ramp from 1, and the run starts at 01:00.
    The 30 devices with an even number, d0, d2 and so on, answer at 00:50
    that they run the target already. They are done at once: they take no
    window and no slot, so the drawing does not show them, and they add
    nothing to the ramp. The 30 devices that need the upgrade start in Tue
    17: 1 at 01:00, 4 every ten minutes from 01:10 to 02:10, and 1 at
    02:20."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("d", 60, 600, "night")
    c = make(wins, devs, 4, 8, 0, 600, 0, 1)
    up_to_date(c, ["d{i}" for i in range(0, 60, 2)], NOV17 + 50 * 60)
    return panel("01:00, the run starts", c, NOV17 + HOUR)


def _test_up_to_date_in_redundancy_groups() -> str:
    """Members that run the target already, in redundancy groups. The
    schedule night has a window from 01:00 to 03:00 on Tue 17 and on Wed
    18. For each N from 0 to 9, the group gN has aN and then bN, with a
    min-separation of 30 minutes. All 20 devices take 600 s. Target 4,
    max 8, the ramp from 1, and the run starts at 01:00. Each aN answers
    at 00:50 that it runs the target already. The a devices are done at
    once, at their answer, and take no window, so the drawing does not
    show them. Each bN waits the min-separation from the answer of its aN,
    to 01:20: 1 b device starts at 01:20, 4 at 01:30, 4 at 01:40 and 1 at
    01:50."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("a", 10, 600, "night") + devices("b", 10, 600, "night")
    groups = {"g{i}": ["a{i}", "b{i}"] for i in range(10)}
    priority: dict[str, int] = {}
    for i in range(10):
        priority["a{i}"] = 1
        priority["b{i}"] = 2
    c = fleet_ctl.Controller()
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in wins], devs, 4, 8, False, 0, 600,
                groups, priority, {"g{i}": (False, 1800) for i in range(10)},
                fleet_ctl.CLOSE_MARGIN, 0, False, {d.0: 100 for d in devs}, -1, None)
    for d in devs:
        c.report(d.0, "upgrade-needed", 0)
    c.start(1)
    up_to_date(c, ["a{i}" for i in range(10)], NOV17 + 50 * 60)
    return panel("01:00, the run starts", c, NOV17 + HOUR)


def _test_new_attempt_after_an_upgrade_in_a_group() -> str:
    """A new attempt for members that upgraded in the run, in redundancy
    groups. The schedule night has a window from 01:00 to 03:00 on Tue 17
    and on Wed 18. For each N from 0 to 3, the group gN has rN and then
    sN, with a min-separation of 30 minutes. All 8 devices take 600 s.
    Target 4, max 4, the ramp at 4, and the run starts at 01:00. r0 to r3
    start at 01:00 and succeed at 01:10, so s0 to s3 wait the
    min-separation, to 01:40. At 01:15 each rN gets a new attempt, and its
    device reads again and answers that it runs the target. The r devices
    are done at once, without a window, so the drawing does not show them.
    Each upgraded in the run, so the s devices wait the min-separation
    from the end of that upgrade, not from the answer, and start at
    01:40."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("r", 4, 600, "night") + devices("s", 4, 600, "night")
    groups = {"g{i}": ["r{i}", "s{i}"] for i in range(4)}
    priority: dict[str, int] = {}
    for i in range(4):
        priority["r{i}"] = 1
        priority["s{i}"] = 2
    c = fleet_ctl.Controller()
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in wins], devs, 4, 4, False, 0, 600,
                groups, priority, {"g{i}": (False, 1800) for i in range(4)},
                fleet_ctl.CLOSE_MARGIN, 0, False, {d.0: 100 for d in devs}, -1, None)
    for d in devs:
        c.report(d.0, "upgrade-needed", 0)
    c.start(4)
    t0 = NOV17 + HOUR
    for name in c.decide(t0).started:
        c.report(name, "in-progress", t0)
    for i in range(4):
        c.report("r{i}", "succeeded", t0 + 600)
    c.decide(t0 + 600)
    before = panel("01:10, the r devices are done", c, t0 + 600)
    t = t0 + 900
    again = {"r{i}" for i in range(4)}
    c.drop(again)
    for i in range(4):
        c.report("r{i}", "up-to-date", t)
    return before + "\n" + panel("01:15, the r devices have a new attempt and are up to date",
                                 c, t)


def pairs(n: int) -> fleet_ctl.Controller:
    """Return a controller of the schedule night, with a window from 01:00
    to 03:00 on Tue 17 and on Wed 18, and n redundancy groups: for each N,
    the group gN has rN and then sN, with a min-separation of 30 minutes.
    All devices take 600 s. Target n and max n. No device has answered
    yet, and the run has not started."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("r", n, 600, "night") + devices("s", n, 600, "night")
    groups = {"g{i}": ["r{i}", "s{i}"] for i in range(n)}
    priority: dict[str, int] = {}
    for i in range(n):
        priority["r{i}"] = 1
        priority["s{i}"] = 2
    c = fleet_ctl.Controller()
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in wins], devs, n, n, False, 0, 600,
                groups, priority, {"g{i}": (False, 1800) for i in range(n)},
                fleet_ctl.CLOSE_MARGIN, 0, False, {d.0: 100 for d in devs}, -1, None)
    return c


def _test_up_to_date_after_a_restart() -> str:
    """A restart of fleetmgr in the middle of a run, in redundancy groups.
    The schedule night has a window from 01:00 to 03:00 on Tue 17 and on
    Wed 18. For each N from 0 to 3, the group gN has rN and then sN, with
    a min-separation of 30 minutes. All 8 devices take 600 s. Target 4 and
    max 4. Before the restart, r0 to r3 upgraded from 01:00 to 01:10.
    After the restart the run starts again at 01:15, with a new controller
    that does not know of these upgrades: each rN answers that it runs the
    target, and each sN that it needs the upgrade. The r devices are done
    at once, at their answer, and take no window, so the drawing does not
    show them. The s devices wait the min-separation from the answer of
    the r devices, and start at 01:45."""
    c = pairs(4)
    t = NOV17 + HOUR + 15 * 60
    for i in range(4):
        c.report("s{i}", "upgrade-needed", t)
    up_to_date(c, ["r{i}" for i in range(4)], t)
    c.start(4)
    return panel("01:15, the run starts again after a restart", c, t)


#############################################################################
# Members whose devices tell when they last booted
#############################################################################

# Friday 2026-09-18 00:00 UTC, two months before the run.
SEP18 = NOV17 - 60 * DAY


def booted(c: fleet_ctl.Controller, names: list[str], at: int) -> None:
    """Tell c that the device of each member in names last booted at the
    second at."""
    for name in names:
        c.report_last_boot(name, at)


def _test_up_to_date_booted_long_ago() -> str:
    """A restart of fleetmgr in the middle of a run, in redundancy groups,
    with members whose devices booted long ago. The schedule night has a
    window from 01:00 to 03:00 on Tue 17 and on Wed 18. For each N from 0
    to 3, the group gN has rN and then sN, with a min-separation of 30
    minutes. All 8 devices take 600 s. Target 4 and max 4. The run starts
    again at 01:15 after a restart: each rN answers that it runs the
    target, and each sN that it needs the upgrade. The devices of the r
    devices last booted on Fri 18 Sep, and the r devices are done then, so
    the s devices need not wait: they start at 01:15."""
    c = pairs(4)
    t = NOV17 + HOUR + 15 * 60
    for i in range(4):
        c.report("s{i}", "upgrade-needed", t)
    booted(c, ["r{i}" for i in range(4)], SEP18)
    up_to_date(c, ["r{i}" for i in range(4)], t)
    c.start(4)
    return panel("01:15, the run starts again after a restart", c, t)


def _test_up_to_date_booted_before_a_restart() -> str:
    """A restart of fleetmgr in the middle of a run, in redundancy groups,
    with members whose devices booted just before it. The schedule night
    has a window from 01:00 to 03:00 on Tue 17 and on Wed 18. For each N
    from 0 to 3, the group gN has rN and then sN, with a min-separation of
    30 minutes. All 8 devices take 600 s. Target 4 and max 4. Before the
    restart, r0 to r3 upgraded from 01:00 to 01:10, and their devices
    booted at 01:05 in that upgrade. The run starts again at 01:15: each
    rN answers that it runs the target, and each sN that it needs the
    upgrade. After the restart, the campaign has not seen the upgrade end,
    so the r devices are done when their devices booted, and the s devices
    wait the min-separation from 01:05, and start at 01:35."""
    c = pairs(4)
    t = NOV17 + HOUR + 15 * 60
    for i in range(4):
        c.report("s{i}", "upgrade-needed", t)
    booted(c, ["r{i}" for i in range(4)], NOV17 + HOUR + 5 * 60)
    up_to_date(c, ["r{i}" for i in range(4)], t)
    c.start(4)
    return panel("01:15, the run starts again after a restart", c, t)


def tried_again(boot: int) -> fleet_ctl.Controller:
    """Return pairs(4) at 01:15 in a run that started at 01:00: r0 to r3
    started at 01:00 and succeeded at 01:10, their devices last booted at
    boot, and at 01:15 each rN got a new attempt and answered that it runs
    the target."""
    c = pairs(4)
    for i in range(4):
        c.report("r{i}", "upgrade-needed", 0)
        c.report("s{i}", "upgrade-needed", 0)
    c.start(4)
    t0 = NOV17 + HOUR
    for name in c.decide(t0).started:
        c.report(name, "in-progress", t0)
    for i in range(4):
        c.report("r{i}", "succeeded", t0 + 600)
    c.decide(t0 + 600)
    booted(c, ["r{i}" for i in range(4)], boot)
    c.drop({"r{i}" for i in range(4)})
    up_to_date(c, ["r{i}" for i in range(4)], t0 + 900)
    return c


def _test_new_attempt_booted_in_the_upgrade() -> str:
    """A new attempt for members that upgraded in the run, in redundancy
    groups, with devices that booted in that upgrade. The schedule night
    has a window from 01:00 to 03:00 on Tue 17 and on Wed 18. For each N
    from 0 to 3, the group gN has rN and then sN, with a min-separation of
    30 minutes. All 8 devices take 600 s. Target 4, max 4, the ramp at 4,
    and the run starts at 01:00. r0 to r3 start at 01:00, their devices
    boot at 01:05, and they succeed at 01:10. At 01:15 each rN gets a new
    attempt and answers that it runs the target. The campaign saw the
    upgrade end after the boot, so the s devices wait the min-separation
    from the end of the upgrade, and start at 01:40."""
    c = tried_again(NOV17 + HOUR + 5 * 60)
    return panel("01:15, the r devices have a new attempt and are up to date", c,
                 NOV17 + HOUR + 15 * 60)


def _test_new_attempt_rebooted_after_the_upgrade() -> str:
    """A new attempt for members that upgraded in the run, in redundancy
    groups, with devices that booted again after that upgrade. The
    schedule night has a window from 01:00 to 03:00 on Tue 17 and on Wed
    18. For each N from 0 to 3, the group gN has rN and then sN, with a
    min-separation of 30 minutes. All 8 devices take 600 s. Target 4, max
    4, the ramp at 4, and the run starts at 01:00. r0 to r3 start at 01:00
    and succeed at 01:10, and their devices boot again at 01:12. At 01:15
    each rN gets a new attempt and answers that it runs the target. The
    boot is later than the end of the upgrade, so the s devices wait the
    min-separation from the boot, and start at 01:42."""
    c = tried_again(NOV17 + HOUR + 12 * 60)
    return panel("01:15, the r devices have a new attempt and are up to date", c,
                 NOV17 + HOUR + 15 * 60)


#############################################################################
# The plan through a pause and an edit
#############################################################################

def run(c: fleet_ctl.Controller, t0: int, until: int, took: dict[str, int],
        flying: list[(int, str)]) -> list[(int, str)]:
    """Run the controller c as the campaign runs it, from the second t0 to
    the last decision before the second until. A decision comes at t0, at
    each wake, and one debounce after an upgrade ends. Each device that
    starts reports in-progress at its start, and succeeded at its end: the
    time in took after its start, or else its estimate. flying holds the
    devices in flight at t0, as (end, name). Return the devices in flight
    after the last decision."""
    left = flying
    t = t0
    while t < until:
        still: list[(int, str)] = []
        for f in left:
            if f.0 <= t:
                c.report(f.1, "succeeded", f.0)
            else:
                still.append(f)
        left = still
        s = c.decide(t)
        for name in s.started:
            c.report(name, "in-progress", t)
            left.append((t + took.get_def(name, c.est[name]), name))
        if s.finished:
            break
        nxt = s.wake
        for f in left:
            if nxt < 0 or f.0 + c.debounce < nxt:
                nxt = f.0 + c.debounce
        if nxt < 0:
            break
        t = nxt
    return left


def pause(c: fleet_ctl.Controller, flying: list[(int, str)], at: int, until: int,
          stopped: list[str]) -> list[(int, str)]:
    """Pause the run of c at the second at, and run again at the second
    until. flying holds the devices in flight at at, as (end, name). The
    devices in stopped stop before their install one minute after at, and
    report upgrade-needed. The others report succeeded at their end when it
    is not after until. Return the devices in flight at until."""
    c.stop()
    left: list[(int, str)] = []
    for f in flying:
        if f.1 in stopped:
            c.report(f.1, "upgrade-needed", at + 60)
        elif f.0 <= until:
            c.report(f.1, "succeeded", f.0)
        else:
            left.append(f)
    c.start()
    return left


def edit(c: fleet_ctl.Controller, windows: list[(str, int, int)], devs: list[(str, int, str)],
         target: int, maxc: int, debounce: int, estimate: int, stagger: int) -> None:
    """Configure c again with the windows, the devices and the limits, as
    make() configures it."""
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in windows], devs, target, maxc, False,
                debounce, estimate, {}, {}, {}, fleet_ctl.CLOSE_MARGIN, stagger, False,
                {d.0: 100 for d in devs}, -1, None)


def _test_pause_in_window() -> str:
    """A pause inside a window. The schedule night has a window from 01:00
    to 03:00 on Tue 17 and on Wed 18, and 50 devices of 600 s. Target 4,
    max 8, the ramp from 1, and the run starts at 01:00. At 01:25 the plan
    runs at concurrency 4. It promises Tue 17 to 41 devices and Wed 18 to
    9, and the 4 devices that started at 01:20 are in flight. Then the run
    pauses. d5 stops before its install and reports upgrade-needed, and
    the other 3 end at 01:30. At 01:45 the run goes on. The 8 devices that
    are done keep their starts: 1 at 01:00, 4 at 01:10 and 3 at 01:20. d5
    waits again, first in Tue 17, and starts at 01:45 with 4 more devices:
    the ramp does not start again from 1. The waiting devices keep their
    windows: Tue 17 has 41 devices and Wed 18 has 9. To start the other 33
    of Tue 17 in the time that is left, the concurrency goes from 4 to 5:
    5 devices start every ten minutes from 01:45 to 02:35, and 3 at
    02:45."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    c = make(wins, devices("d", 50, 600, "night"), 4, 8, 0, 600, 0, 1)
    flying = run(c, NOV17 + HOUR, NOV17 + HOUR + 25 * 60, {}, [])
    before = panel("01:25, before the pause", c, NOV17 + HOUR + 25 * 60)
    pause(c, flying, NOV17 + HOUR + 25 * 60, NOV17 + HOUR + 45 * 60, ["d5"])
    return before + "\n" + panel("01:45, after the pause", c, NOV17 + HOUR + 45 * 60)


def _test_pause_across_close() -> str:
    """A long pause in which a window closes. The schedule night has a
    window from 01:00 to 03:00 on Tue 17, Wed 18 and Thu 19, and 60 devices
    of 600 s. Target 4, max 8, the ramp from 1, and the run starts at 01:00
    on Tue 17. At 01:25 the plan runs at concurrency 4, and promises Tue 17
    to 41 devices and Wed 18 to 19. Then the run pauses until 00:30 on Wed
    18. The 4 devices in flight end at 01:30, and the window of Tue 17
    closes at 03:00. When the run goes on, Tue 17 shows the 9 devices that
    are done at their starts: 1 at 01:00, 4 at 01:10 and 4 at 01:20. The
    32 devices that Tue 17 did not start go first in Wed 18, from 01:00 to
    02:00, and the 19 devices promised Wed 18 go after them. To start the
    51 devices in Wed 18, the concurrency goes from 4 to 5: 5 devices start
    every ten minutes from 01:00 to 02:30, and 1 at 02:40. Thu 19 has no
    devices."""
    wins = daily("night", HOUR, 2 * HOUR, 3)
    c = make(wins, devices("d", 60, 600, "night"), 4, 8, 0, 600, 0, 1)
    flying = run(c, NOV17 + HOUR, NOV17 + HOUR + 25 * 60, {}, [])
    before = panel("Tue 01:25, before the pause", c, NOV17 + HOUR + 25 * 60)
    pause(c, flying, NOV17 + HOUR + 25 * 60, NOV17 + DAY + 30 * 60, [])
    return before + "\n" + panel("Wed 00:30, after the pause", c, NOV17 + DAY + 30 * 60)


def _test_pause_in_groups_after_a_boot() -> str:
    """A pause in redundancy groups, with devices that booted again after
    their upgrade. The schedule night has a window from 01:00 to 03:00 on
    Tue 17 and on Wed 18. For each N from 0 to 3, the group gN has rN and
    then sN, with a min-separation of 30 minutes. All 8 devices take 600 s.
    Target 4, max 4, the ramp at 4, and the run starts at 01:00. r0 to r3
    start at 01:00 and succeed at 01:10, and their devices boot again at
    01:12. The run pauses at 01:13 and goes on at 01:15, and each rN
    reports succeeded again, as the campaign gives it then. Or each rN gets
    a new attempt in the pause, and answers at 01:15 that it runs the
    target. After the pause alone, the run goes on: the r devices keep
    their release, so the drawing shows them at 01:00, and they stay done
    at 01:10, the end of their upgrade, as in a run without a pause. The
    later boot does not move that time, and the s devices start at 01:40.
    With the new attempt, the r devices are done without a release, so the
    drawing does not show them. The boot is later than the end of their
    upgrade, so the s devices wait the min-separation from the boot, and
    start at 01:42."""
    t0 = NOV17 + HOUR
    t = t0 + 15 * 60
    out: list[str] = []
    for again in [False, True]:
        c = pairs(4)
        for i in range(4):
            c.report("r{i}", "upgrade-needed", 0)
            c.report("s{i}", "upgrade-needed", 0)
        c.start(4)
        for name in c.decide(t0).started:
            c.report(name, "in-progress", t0)
        for i in range(4):
            c.report("r{i}", "succeeded", t0 + 600)
        c.decide(t0 + 600)
        booted(c, ["r{i}" for i in range(4)], t0 + 12 * 60)
        c.stop()
        if again:
            c.drop({"r{i}" for i in range(4)})
        c.start(4)
        for i in range(4):
            c.report("r{i}", "up-to-date" if again else "succeeded", t)
        label = "01:15, the run goes on after a pause"
        if again:
            label = "01:15, the r devices got a new attempt in the pause and are up to date"
        out.append(panel(label, c, t))
    return "\n".join(out)


def _test_restart_in_groups_after_an_upgrade() -> str:
    """A restart of fleetmgr in redundancy groups, after the second member
    of each group upgraded. The schedule night has a window from 01:00 to
    03:00 on Tue 17 and on Wed 18. For each N from 0 to 3, the group gN
    has rN and then sN, with a min-separation of 30 minutes. All 8 devices
    take 600 s. Target 4, max 4, and the ramp at 4. Before the restart, s0
    to s3 upgraded and succeeded, and each rN got a new attempt. The run
    starts again at 01:15, with a new controller that does not know of
    these upgrades: each sN reports that it succeeded, and each rN answers
    that it needs the upgrade. In the first panel, the s devices tell
    that they last booted at 01:08; in the second, they tell
    no boot. The s devices are done without a release, so the drawing
    does not show them. Each sN succeeded, so rN waits the min-separation
    from the done time of sN, although sN comes after it in the group:
    in the first panel from the boot at 01:08, and the r devices start at
    01:38; in the second from the report of sN at 01:15, and they start
    at 01:45."""
    t = NOV17 + HOUR + 15 * 60
    out: list[str] = []
    for boot in [True, False]:
        c = pairs(4)
        for i in range(4):
            c.report("r{i}", "upgrade-needed", t)
        if boot:
            booted(c, ["s{i}" for i in range(4)], NOV17 + HOUR + 8 * 60)
        for i in range(4):
            c.report("s{i}", "succeeded", t)
        c.start(4)
        label = "01:15, after a restart, the s devices booted at 01:08"
        if not boot:
            label = "01:15, after a restart, the s devices tell no boot"
        out.append(panel(label, c, t))
    return "\n".join(out)


def _test_edit_higher_limits() -> str:
    """A higher target-concurrency or max-concurrency in the middle of a
    run. The schedule night has a window from 01:00 to 03:00 on Tue 17 and
    on Wed 18, and 60 devices of 600 s. Target 4, max 8, the ramp from 1,
    and the run starts at 01:00. d0 takes 1200 s, two times its estimate.
    The ramp waits for it until 01:20, and the run goes to concurrency 6 to
    keep its promises. Tue 17 starts 1 device at 01:00, 4 at 01:20, and 6
    every ten minutes from 01:30 to 02:20: 41 devices. Wed 18 starts 6
    devices at 01:00, 01:10 and 01:20, and 1 at 01:30. At 02:05 the
    target-concurrency goes from 4 to 5, or the max-concurrency goes from 8
    to 10. In each case the concurrency stays at 6, and the plan does not
    change."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("d", 60, 600, "night")
    c = make(wins, devs, 4, 8, 0, 600, 0, 1)
    t = NOV17 + 2 * HOUR + 5 * 60
    run(c, NOV17 + HOUR, t, {"d0": 1200}, [])
    higher = c.copy()
    edit(higher, wins, devs, 5, 8, 0, 600, 0)
    wider = c.copy()
    edit(wider, wins, devs, 4, 10, 0, 600, 0)
    return panel("02:05, before the edit", c, t) + "\n" \
        + panel("02:05, after the target-concurrency goes from 4 to 5", higher, t) + "\n" \
        + panel("02:05, after the max-concurrency goes from 8 to 10", wider, t)


def _test_edit_window_moved() -> str:
    """Windows that an edit moves while devices are promised to them. The
    schedule night has a window from 01:00 to 03:00 on Tue 17, Wed 18 and
    Thu 19, and 100 devices of 600 s. Target 4, max 8, the ramp from 1,
    and the run starts at 00:00. At 00:30 the plan runs at concurrency 4,
    and promises Tue 17 to 41 devices, Wed 18 to 44 and Thu 19 to 15. Then
    each window moves an hour later, to 02:00 to 04:00, as a new
    utc-offset of the schedule does. Each promise goes to the window whose
    opening is nearest: the window of the same day. So the plan stays at
    concurrency 4, and each day keeps its devices, 41, 44 and 15. Each
    device starts an hour later than before."""
    wins = daily("night", HOUR, 2 * HOUR, 3)
    devs = devices("d", 100, 600, "night")
    c = make(wins, devs, 4, 8, 0, 600, 0, 1)
    run(c, NOV17, NOV17 + 30 * 60, {}, [])
    before = panel("00:30, before the edit", c, NOV17 + 30 * 60)
    edit(c, daily("night", 2 * HOUR, 2 * HOUR, 3), devs, 4, 8, 0, 600, 0)
    return before + "\n" + panel("00:30, after the windows move an hour later", c,
                                 NOV17 + 30 * 60)


def _test_edit_promised_nowhere() -> str:
    """Devices that the plan can start in no window. The schedule night has
    a window from 01:00 to 03:00 on Tue 17 and on Wed 18, and 50 devices of
    600 s. Target 4 and max 4, the ramp from 1, and the run starts at
    00:00. At 00:30 the plan promises Tue 17 to 41 devices and Wed 18 to 9,
    d41 to d49. Then an edit takes away the window of Wed 18. Its promises
    go to the nearest window of the schedule, Tue 17. At max 4, Tue 17 has
    room only for the 41 devices promised to it before. So the plan starts
    d41 to d49 in no window, and gives an alarm for them. They stay in Tue
    17, at its opening: the column at 01:00 has 10 dots, d0 and these 9.
    The window line counts 50 devices."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("d", 50, 600, "night")
    c = make(wins, devs, 4, 4, 0, 600, 0, 1)
    run(c, NOV17, NOV17 + 30 * 60, {}, [])
    before = panel("00:30, before the edit", c, NOV17 + 30 * 60)
    edit(c, daily("night", HOUR, 2 * HOUR, 1), devs, 4, 4, 0, 600, 0)
    return before + "\n" + panel("00:30, after the edit takes away the window of Wed 18", c,
                                 NOV17 + 30 * 60)


#############################################################################
# Members that prepare
#############################################################################

def stage(c: fleet_ctl.Controller, windows: list[(str, int, int)], devs: list[(str, int, str)],
          target: int, maxc: int, prep: int, budget: int, image: int=GB,
          between: ?bool=None, during: bool=False) -> None:
    """Configure c with the windows and devices, with prepare on. The
    times of the windows count from NOV17. Each device takes 600 s, its
    expected prepare time is prep seconds, and it copies an image of image
    bytes. The debounce is 0 s, there are no redundancy groups, the close
    margin is the default, there is no stagger, and the failure budget is
    budget, below 0 for none. The members may prepare before the first
    window, between windows as between says, None for automatic, and
    during windows as during says, and the cap of their bandwidth is the
    default of a campaign, 1 Gbit/s."""
    c.configure([(w.0, NOV17 + w.1, NOV17 + w.2) for w in windows], devs, target, maxc, False,
                0, 600, {}, {}, {}, fleet_ctl.CLOSE_MARGIN, 0, True, {d.0: prep for d in devs},
                budget, None, {d.0: image for d in devs}, True, between, during, GBIT)


def staging(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
            maxc: int, prep: int, image: int=GB, between: ?bool=None,
            during: bool=False) -> fleet_ctl.Controller:
    """Return a controller of the windows and devices with prepare on, as
    stage() configures it, without a failure budget. Every device answers
    that it needs the upgrade, and the run starts with the ramp at 1."""
    c = fleet_ctl.Controller()
    stage(c, windows, devs, target, maxc, prep, -1, image, between, during)
    for d in devs:
        c.report(d.0, "upgrade-needed", 0)
    c.start(1)
    return c


def staged(label: str, c: fleet_ctl.Controller, t: int) -> str:
    """Return a panel of the plan of c at t, as panel() does, with the
    prepares of the plan at t. The label gives the concurrency of the
    plan and the concurrency of the prepares, the most devices that
    prepare at once, and when the members may prepare between windows, that
    they do. The drawing has the prepares, each with the size of its
    image, from the second the plan counts it from. Under it are the
    alarms of the plan and of the prepares. The
    plan is made on a copy of c, so c does not change."""
    x = c.copy()
    p = x.plan(t)
    q = x.prepares(t)
    prepares = [(name, at, x.prepare_est.get_def(name, 1)) for name, at in q.starts.items()]
    between = ", between windows" if q.between else ""
    out = "{label}: the plan runs at concurrency {p.c}, and the prepares at concurrency " \
        + "{q.c}{between}\n\n" + plan_timeline.render(x.layout(p), 0, t, prepares, x.prepare_size,
                                                        q.runs)
    for a in p.alarms + q.alarms:
        out += "alarm: {a}\n"
    return out


def _test_prepare_before_the_first_window() -> str:
    """A run that starts before the first window, with prepare on. The
    schedule night has a window from 01:00 to 03:00 on Tue 17 and on Wed
    18, and 50 devices of 600 s. Target 4, max 8, and the ramp from 1. Each
    device prepares for 400 s and copies an image of 1 GB, 20 Mbit/s. The
    run starts at 22:00 on Mon 16. The plan promises Tue 17 to 41 devices
    and Wed 18 to 9. Every device prepares before the first window of the
    campaign, as all fit there under the cap of 1 Gbit/s, so the 9 devices
    of Wed 18 also prepare before Tue 17. Each device has the same
    deadline, 00:50: the opening of Tue 17 less 150 percent of 400 s. The
    turns are spread evenly from 22:00 to the deadline, one every 208 s,
    and the last turn is at the deadline. Up to two prepares run at a
    time, and in each dot column but the last the bandwidth gets to its
    peak, 40 Mbit/s. The last prepare ends at 00:56:40."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    c = staging(wins, devices("d", 50, 600, "night"), 4, 8, 400)
    return staged("Mon 22:00, the run starts", c, NOV17 - 2 * HOUR)


def _test_prepare_after_a_late_start() -> str:
    """A run that starts too late for the devices to prepare before the
    first window. The schedule night has a window from 01:00 to 03:00 on
    Tue 17 and on Wed 18, and 50 devices of 600 s. Target 4, max 8, and
    the ramp from 1. Each device prepares for 400 s and copies an image of
    1 GB, 20 Mbit/s. The run starts at 00:55 on Tue 17, after the
    deadline of 00:50, so no device fits before the first window, and the
    plan turns prepare between windows on. The 41 devices of Tue 17 cannot
    prepare before their window, and the prepares give an alarm for them.
    The 9 devices promised Wed 18 prepare between the windows, by 00:50
    on Wed 18. No device prepares while the window of Tue 17 is open, so
    the first turn is at its close, 03:00, and the turns of the other 8
    are spread evenly from there, one every 2h44m, and the last turn is at
    the deadline. Each prepare runs alone, at 20 Mbit/s, and each gap of
    2h37m between two prepares becomes a break. The decision at 03:00 lets
    the first of them prepare. At 03:05 its device has not begun, so the
    plan counts its prepare from then, and the other turns stay."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    c = staging(wins, devices("d", 50, 600, "night"), 4, 8, 400)
    t0 = NOV17 + 55 * 60
    before = staged("00:55, the run starts", c, t0)
    t = NOV17 + 3 * HOUR + 5 * 60
    run(c, t0, t, {}, [])
    return before + "\n" + staged("03:05, after the window of Tue 17", c, t)


def _test_prepare_in_another_window() -> str:
    """Devices of two schedules that prepare before the first window of the
    campaign. The schedule early has a window from 01:00 to 03:00 on Tue
    17 and on Wed 18, and the schedule late from 05:00 to 07:00. Each has
    20 devices of 600 s. Target 4, max 8, and the ramp from 1. Each device
    prepares for 400 s and copies an image of 1 GB, 20 Mbit/s. The run
    starts at 00:00 on Tue 17. Every device prepares before the first
    window of the campaign, the window of early at 01:00, so no device of
    late prepares while the window of early is open. Each device has the
    deadline 00:50, and the turns go by the window promised to each
    device: the 20 devices of early first. The turns are spread evenly
    from 00:00 to the deadline, one every 77 s, and up to six prepares run
    at a time: the peak is 120 Mbit/s, under the cap of 1 Gbit/s."""
    wins = daily("early", HOUR, 2 * HOUR, 2) + daily("late", 5 * HOUR, 2 * HOUR, 2)
    devs = devices("e", 20, 600, "early") + devices("l", 20, 600, "late")
    c = staging(wins, devs, 4, 8, 400)
    return staged("00:00, the run starts", c, NOV17)


#############################################################################
# The prepares through a run
#############################################################################

def prepared(c: fleet_ctl.Controller, ends: list[(int, str)], t: int) -> list[(int, str)]:
    """Make each member in ends whose prepare ends at the second t or
    before report its prepare done. ends holds the prepares that run, as
    (end, name). Return the prepares that still run at t."""
    left: list[(int, str)] = []
    for e in ends:
        if e.0 <= t:
            c.report_prepare(e.1, "done")
        else:
            left.append(e)
    return left


def let_prepare(c: fleet_ctl.Controller, t0: int, until: int, idle: list[str]) -> None:
    """Run the prepares of c as the campaign runs them, from the second t0
    to the last decision before the second until, in a time in which no
    window is open. A decision comes at t0 and at each wake. Each member
    that a decision lets prepare reports its prepare running then. Its
    prepare ends after its expected prepare time, and it reports its
    prepare done at the first decision from that end, or at until. The
    members in idle report no prepare."""
    ends: list[(int, str)] = []
    t = t0
    while t < until:
        ends = prepared(c, ends, t)
        s = c.decide(t)
        for name in c.order:
            if name in c.allowed and name not in c.prepare_state and name not in idle:
                c.report_prepare(name, "running")
                ends.append((t + c.prepare_est[name], name))
        if s.wake < 0:
            break
        t = s.wake
    prepared(c, ends, until)


def let_now(c: fleet_ctl.Controller) -> str:
    """Return a line with the members that c lets prepare now, in the
    campaign's order."""
    names = [name for name in c.order if name in c.allowed]
    if len(names) == 0:
        return "let prepare now: no member\n"
    return "let prepare now: {', '.join(names)}\n"


def waiting_line(c: fleet_ctl.Controller, t: int) -> str:
    """Return a line with the prepare-start of each member that waits to
    prepare at t, by time. The plan is made on a copy of c, so c does not
    change."""
    x = c.copy()
    x.plan(t)
    q = x.prepares(t)
    turns = sorted([(at, name) for name, at in q.starts.items() if name not in x.prepare_at])
    return "waiting: " + ", ".join(["{e.1} {plan_timeline.clock(e.0, 0, True)}" for e in turns]) \
        + "\n"


def _test_prepare_over_several_nights() -> str:
    """A campaign over several nights, with prepare on. The schedule night
    has a window from 01:00 to 03:00 on Tue 17, Wed 18, Thu 19 and Fri 20,
    and 160 devices of 600 s. Target 4, max 4, and the ramp from 1. Each
    device prepares for 400 s and copies an image of 4 GB, 80 Mbit/s. The
    run starts at 00:00 on Tue 17. The plan promises Tue 17 to 41 devices,
    Wed 18 and Thu 19 to 44 each, and Fri 20 to 31. Before the first
    window, each device has the deadline 00:50, but the cap of 1 Gbit/s
    lets only 12 prepares run at once: one turn every 33 s, so 90 devices
    fit before Tue 17, the devices of Tue 17 and Wed 18, and 5 of Thu 19.
    Up to 12 prepares run at once, and the bandwidth gets to 960 Mbit/s.
    The plan turns prepare between windows on, and the other 70 devices
    prepare between the nights, each by the opening of its own night less
    150 percent of 400 s. Their turns are spread evenly from 03:55 on Tue
    17 to 00:50 on Fri 20, about one every 56 minutes, outside the
    windows and the 10 minutes before each opening. Each of them runs
    alone, at 80 Mbit/s. The last prepare ends at 00:56:40 on Fri 20."""
    wins = daily("night", HOUR, 2 * HOUR, 4)
    c = staging(wins, devices("d", 160, 600, "night"), 4, 4, 400, 4 * GB)
    return staged("00:00, the run starts", c, NOV17)


def _test_prepare_over_several_nights_not_between_windows() -> str:
    """The campaign over several nights of prepare_over_several_nights,
    with prepare between windows off. The cap of 1 Gbit/s lets only 12
    prepares run at once, so 90 devices fit before Tue 17: the devices of
    Tue 17 and Wed 18, and 5 of Thu 19. The other 70 may not prepare
    between the nights, so they cannot prepare in time, and the prepares
    give an alarm for them."""
    wins = daily("night", HOUR, 2 * HOUR, 4)
    c = staging(wins, devices("d", 160, 600, "night"), 4, 4, 400, 4 * GB, False)
    return staged("00:00, the run starts", c, NOV17)


def _test_prepare_over_several_nights_during_windows() -> str:
    """The campaign over several nights of prepare_over_several_nights,
    with prepare between windows off and prepare during windows on. With
    prepare during windows, no time before an opening is a time without
    prepares, so two more turns fit before Tue 17 opens, at 00:54:18 and
    00:59:10, and their prepares run into the window: 92 devices prepare
    before it. The other 68 prepare while the windows of the nights before
    their own are open, about one turn every 5 minutes: 22 devices in the
    window of Tue 17, and 23 in each of Wed 18 and Thu 19. No device
    prepares between the nights, nor in the 10 minutes before each window
    closes, so the deadline of the devices of Fri 20, 00:50 on Fri 20,
    counts from 02:50 on Thu 19, and the last turn is then: its prepare is
    done before the window closes."""
    wins = daily("night", HOUR, 2 * HOUR, 4)
    c = staging(wins, devices("d", 160, 600, "night"), 4, 4, 400, 4 * GB, False, True)
    return staged("00:00, the run starts", c, NOV17)


def _test_prepare_after_a_change() -> str:
    """Changes of one member while the others wait to prepare. The
    schedule night has a window from 01:00 to 03:00 on Tue 17 and on Wed
    18, and 8 devices of 600 s, d0 to d7. Target 4, max 4, and the ramp
    from 1. Each device prepares for 400 s and copies an image of 1 GB,
    20 Mbit/s. d7 has not answered. The run starts at 19:00 on Mon 16, and
    the plan promises Tue 17 to the 7 devices that answered. Each has the
    deadline 00:50, and the turns are spread evenly from 19:00 to it, one
    every 58m20s, so each prepare runs alone. At 20:30 d0 and d1 have
    prepared, and d2 to d6 wait. In each panel after the first, one member
    changes at 20:30: d8 joins and answers that it needs the upgrade, d3
    leaves, or d7 answers that it needs the upgrade. Each waiting member
    keeps its turn. A new member takes the middle of the widest time
    between two turns, the latest of two as wide: 00:20:50, between d5 and
    d6. After d3 leaves, the time from d2 to d4 is long enough to become a
    break. The line under each panel gives the prepare-start of each
    member that waits."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("d", 8, 600, "night")
    c = fleet_ctl.Controller()
    stage(c, wins, devs, 4, 4, 400, -1)
    for d in devs[:7]:
        c.report(d.0, "upgrade-needed", 0)
    c.start(1)
    t = NOV17 - 3 * HOUR - 30 * 60
    let_prepare(c, NOV17 - 5 * HOUR, t, [])
    joined = c.copy()
    stage(joined, wins, devs + [("d8", 600, "night")], 4, 4, 400, -1)
    joined.report("d8", "upgrade-needed", t)
    joined.decide(t)
    left = c.copy()
    stage(left, wins, [d for d in devs if d.0 != "d3"], 4, 4, 400, -1)
    left.decide(t)
    answered = c.copy()
    answered.report("d7", "upgrade-needed", t)
    answered.decide(t)
    return staged("20:30, before the change", c, t) + waiting_line(c, t) + "\n" \
        + staged("20:30, after d8 joins", joined, t) + waiting_line(joined, t) + "\n" \
        + staged("20:30, after d3 leaves", left, t) + waiting_line(left, t) + "\n" \
        + staged("20:30, after d7 answers that it needs the upgrade", answered, t) \
        + waiting_line(answered, t)


def _test_prepare_not_begun_when_the_window_opens() -> str:
    """A member that is let prepare and has not begun when a window of its
    schedule opens. The schedule night has a window from 01:00 to 03:00 on
    Tue 17 and on Wed 18, and 23 devices of 600 s. Target 2, max 2, and
    the ramp from 1. Each device prepares for 400 s and copies an image of
    1 GB, 20 Mbit/s. The run starts at 22:00 on Mon 16. The plan promises
    Tue 17 to d0 to d20, and Wed 18 to d21 and d22. Each device has the
    deadline 00:50, and the turns are spread evenly from 22:00 to it, one
    every 7m44s, so each prepare runs alone. Each device prepares when it
    is let, but d22, let at 00:50, does not begin: its device reports no
    prepare. At 00:55 the run still lets d22 prepare. The window of Tue 17
    opens at 01:00, and the run stops letting d22 prepare. At 03:05, after
    the window closes, d22 waits for Wed 18, and its deadline is 00:50 on
    Wed 18. The run lets d22 prepare again, between the windows, so the
    prepares run at concurrency 1, and the plan says that the members
    prepare between windows. d22 keeps the prepare-start it was first let
    at, and the drawing has its dot at 00:50 on Tue 17. As its device has
    not begun, its prepare counts from the time of each panel: from 00:55,
    and from 03:05."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    c = staging(wins, devices("d", 23, 600, "night"), 2, 2, 400)
    t = NOV17 + 55 * 60
    let_prepare(c, NOV17 - 2 * HOUR, t, ["d22"])
    before = staged("00:55, before the window opens", c, t) + let_now(c)
    t2 = NOV17 + 3 * HOUR + 5 * 60
    run(c, NOV17 + HOUR, t2, {}, [])
    return before + "\n" + staged("03:05, after the window of Tue 17", c, t2) + let_now(c)


def _test_prepare_not_begun_when_a_hold_begins() -> str:
    """A member that is let prepare and has not begun when a hold of the
    failure budget begins. The schedule night has a window from 01:00 to
    03:00 on Tue 17 and on Wed 18, and 23 devices of 600 s. Target 2, max
    2, the ramp from 1, and the failure budget 0. Each device prepares for
    400 s and copies an image of 1 GB, 20 Mbit/s. The run starts at 01:00
    on Tue 17, when the window opens, so no device prepares before it, and
    the members prepare between windows. Tue 17 starts d0 to d20, d19 and
    d20 last at 02:40, and d20 takes 40 minutes. Wed 18 is promised to d21
    and d22, and after the window closes they wait to prepare by 00:50 on
    Wed 18: the decision at 03:00 lets d21 prepare, and d22 has its turn at
    00:50 on Wed 18. d21 does not begin: its device reports no prepare. At
    03:20 d20 fails, more than the failure budget, and the run holds: no
    device starts, no member is let prepare and no member waits to
    prepare, so the drawing has only the prepare-start of d21, and no
    prepare runs. At 04:00 the failure budget goes from 0 to 1, the hold
    ends, and d22 has its turn at 00:50 on Wed 18 again. The run lets d21
    prepare again: the drawing has its dot at its first prepare-start,
    03:00, and its prepare from 04:00, as at 03:05 from 03:05."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    devs = devices("d", 23, 600, "night")
    c = fleet_ctl.Controller()
    stage(c, wins, devs, 2, 2, 400, 0)
    for d in devs:
        c.report(d.0, "upgrade-needed", 0)
    c.start(1)
    t1 = NOV17 + 3 * HOUR + 5 * 60
    run(c, NOV17 + HOUR, t1, {"d20": 2400}, [])
    before = staged("03:05, before the hold", c, t1) + let_now(c)
    t2 = NOV17 + 3 * HOUR + 20 * 60
    c.report("d20", "failed", t2)
    c.decide(t2)
    held = staged("03:20, d20 failed, and the failure budget holds the run", c, t2) + let_now(c)
    t3 = NOV17 + 4 * HOUR
    stage(c, wins, devs, 2, 2, 400, 1)
    c.decide(t3)
    return before + "\n" + held + "\n" \
        + staged("04:00, after the failure budget goes from 0 to 1", c, t3) + let_now(c)


def _test_prepare_that_fails() -> str:
    """A member whose prepare fails, and a member whose prepare is
    retrying: it failed for a transient reason, and its device tries it
    again. The schedule night has a window from 01:00 to 03:00 on Tue 17
    and on Wed 18, and 8 devices of 600 s. Target 4, max 4, and the ramp
    from 1. Each device prepares for 400 s and copies an image of 1 GB, 20
    Mbit/s. The members may prepare during windows, so no time before a
    window is a time without prepares. The run starts at 19:00 on Mon 16,
    and the plan promises Tue 17 to every device. Each device has the
    deadline 00:50, and the turns are spread evenly from 19:00 to it, one
    every 50 minutes. d0 is let at 19:00, and its prepare fails at 19:05:
    the prepares name it in an alarm. d1 is let at 19:50, and its prepare
    is retrying from 19:55. It stays let, and the plan counts its prepare
    from 19:50, also after it reports its prepare running again at 20:10.
    From 20:15 it is retrying again, and at 00:55, after its deadline, it
    is still let and no alarm names it. At 00:56 an operator asks d0 to
    prepare again, and d0 reports no prepare. Its deadline has passed, so
    it is not let, and the prepares name it with the members that cannot
    prepare before their window opens."""
    wins = daily("night", HOUR, 2 * HOUR, 2)
    c = staging(wins, devices("d", 8, 600, "night"), 4, 4, 400, GB, None, True)
    t0 = NOV17 - 5 * HOUR
    let_prepare(c, t0, t0 + 5 * 60, [])
    c.report_prepare("d0", "failed")
    let_prepare(c, t0 + 5 * 60, t0 + 55 * 60, [])
    c.report_prepare("d1", "retrying")
    t1 = t0 + HOUR
    let_prepare(c, t0 + 55 * 60, t1, [])
    a = staged("20:00, d0 failed at 19:05, and d1 tries again since 19:55", c, t1) + let_now(c)
    t2 = t1 + 10 * 60
    c.report_prepare("d1", "running")
    let_prepare(c, t2, t2 + 5 * 60, [])
    b = staged("20:10, d1 reports its prepare running again", c, t2) + let_now(c)
    c.report_prepare("d1", "retrying")
    t3 = NOV17 + 55 * 60
    let_prepare(c, t2 + 5 * 60, t3, [])
    d = staged("00:55, d1 tries again since 20:15", c, t3) + let_now(c)
    t4 = t3 + 60
    c.report_prepare("d0", None)
    c.decide(t4)
    e = staged("00:56, an operator asks d0 to prepare again", c, t4) + let_now(c)
    return a + "\n" + b + "\n" + d + "\n" + e
