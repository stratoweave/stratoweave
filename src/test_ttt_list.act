proc def _test_partial_delete(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    t1 = tlist.newtrans()
    _partial_deleteBody(t=t, t1=t1)


actor _partial_deleteBody(t: testing.AsyncT, t1):
    def __startup__():
        inA = gdata.List([q("name")], [
                gdata.Container({
                    q("name"): gdata.Leaf("k1"),
                    q("x"): gdata.Leaf(1)
                }),
                gdata.Container({
                    q("name"): gdata.Leaf("k2"),
                    q("x"): gdata.Leaf(2)
                })
            ])
        inB = gdata.List([q("name")], [
                gdata.Container({
                    q("name"): gdata.Leaf("k2"),
                    q("x"): gdata.Leaf(2)
                }),
                gdata.Container({
                    q("name"): gdata.Leaf("k3"),
                    q("x"): gdata.Leaf(3)
                }),
            ])

        def cont1(r):
            t1.commit("1", True)
            out1 = t1.get()
            exp1 = gdata.List([q("name")], [
                    gdata.Container({
                        q("name"): gdata.Leaf("k1"),
                        q("x"): gdata.Leaf(1)
                    }),
                    gdata.Container({
                        q("name"): gdata.Leaf("k2"),
                        q("x"): gdata.Leaf(2)
                    }),
                    gdata.Container({
                        q("name"): gdata.Leaf("k3"),
                        q("x"): gdata.Leaf(3)
                    }),
                ])
            testing.assertEqual(out1, exp1)
            t1.configure("1", {"srcA": gdata.Absent()}, None, differential=True)

            def cont2(r):
                t1.commit("1", True)
                out2 = t1.get()
                testing.assertEqual(out2, inB)
                t.success()

            t1.lock("1", None, cont2)

        t1.configure("1", {"srcA": inA, "srcB": inB}, None)

        t1.lock("1", None, cont1)



