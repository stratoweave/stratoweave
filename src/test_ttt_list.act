import yang.gdata as gdata

TEST_NS = "urn:test"

def q(n: str) -> gdata.Id:
    return gdata.Id(TEST_NS, n)


tree1 = gdata.List([q("name")], [
    gdata.Container({
        q("name"): gdata.Leaf("k1"),
        q("n1"): gdata.Leaf(1),
        q("n2"): gdata.Leaf(2)
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k4"),
        q("n4"): gdata.Leaf(4)
    })
])

tree1diff = gdata.List([q("name")], [
    gdata.Absent({
        q("name"): gdata.Leaf("k1")
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k4"),
        q("n4"): gdata.Leaf(0)
    })
])

tree1pruned = gdata.List([q("name")], [
    gdata.Container({
        q("name"): gdata.Leaf("k4"),
        q("n4"): gdata.Leaf(0)
    })
])

tree2 = gdata.List([q("name")], [
    gdata.Container({
        q("name"): gdata.Leaf("k1"),
        q("n2"): gdata.Leaf(2)
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k2"),
        q("n1"): gdata.Leaf(1),
        q("n3"): gdata.Leaf(3)
    })
])

merge_1_2 = gdata.List([q("name")], [
    gdata.Container({
        q("name"): gdata.Leaf("k1"),
        q("n1"): gdata.Leaf(1),
        q("n2"): gdata.Leaf(2)
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k2"),
        q("n1"): gdata.Leaf(1),
        q("n3"): gdata.Leaf(3)
    }),
    gdata.Container({
        q("name"): gdata.Leaf("k4"),
        q("n4"): gdata.Leaf(4)
    })
])


