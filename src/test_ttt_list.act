proc def _test_simultaneous_create(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    t1 = tlist.newtrans()
    t2 = tlist.newtrans()
    _simultaneous_createBody(t=t, t1=t1, t2=t2)


actor _simultaneous_createBody(t: testing.AsyncT, t1, t2):
    def __startup__():
        def cont1(_r: value):
            t2.lock("2", None, cont2)
            t1.commit("1", True)

        def cont2(_r: value):
            t2.commit("2", True)
            r = t2.get()
            testing.assertEqual(r, list1)
            t.success()

        t1.configure("1", {'srcA': list1a}, None)
        t2.configure("2", {'srcB': list1b}, None)
        t1.lock("1", None, cont1)



