proc def _test_basic_commit(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    t1 = tlist.newtrans()
    _basic_commitBody(t=t, t1=t1)


actor _basic_commitBody(t: testing.AsyncT, t1):
    def __startup__():
        def cont1(_r: value):
            t1.commit("1", True)
            r = t1.get()
            testing.assertEqual(r, tree1)
            t.success()

        t1.configure("1", {'srcA': tree1}, None)

        t1.lock("1", None, cont1)



########################

proc def _test_empty_lock(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    tx = tlist.newtrans()
    _empty_lockBody(t=t, tx=tx)


actor _empty_lockBody(t: testing.AsyncT, tx):
    def __startup__():
        def committed(_r: value):
            try:
                tx.commit("1", True)
                testing.assertEqual(tx.get(), gdata.List([q("name")], []))
                t.success()
            except Exception as error:
                t.failure(error)

        # No configure or linkage has registered this transaction with ListState.
        tx.lock("1", None, committed)



########################

actor LockReplies():
    var granted: list[str] = []

    def a(keys_by_src: dict[str, set[str]], nodes: dict[str, ttt.Node]):
        granted.append("A")

    def b(keys_by_src: dict[str, set[str]], nodes: dict[str, ttt.Node]):
        granted.append("B")

    def c(keys_by_src: dict[str, set[str]], nodes: dict[str, ttt.Node]):
        granted.append("C")

    def get():
        return list(granted)


proc def _test_lock_ownership(t: testing.AsyncT):
    state = ttt.ListState(ttt.PathRoot("0:"), ttt.Transform(ttt.PassThrough), None)
    _lock_ownershipBody(t=t, state=state)


actor _lock_ownershipBody(t: testing.AsyncT, state):
    replies = LockReplies()

    def __startup__():
        for tid in ["A", "B", "C"]:
            state.acquire(tid, {"src": set()}, {"src"}, {}, {})
        state.acquire_deletes("A", replies.a)
        # Reacquisition by the owner succeeds, while another transaction waits.
        state.acquire_deletes("A", replies.a)
        state.acquire_deletes("B", replies.b)
        # An externally invoked abort cancels B without releasing A's lock.
        state.release("B", False, set())
        state.acquire_deletes("C", replies.c)
        # Await a value from ListState before reading callbacks from another actor.
        nodes = state.all()
        testing.assertEqual(replies.get(), ["A", "A"])
        state.release("A", False, set())
        nodes = state.all()
        testing.assertEqual(replies.get(), ["A", "A", "C"])
        state.release("C", False, set())
        t.success()



########################

proc def _test_committed_configs(t: testing.AsyncT):
    state: ttt.ListState = ttt.ListState(ttt.PathRoot("0:"), ttt.Transform(ttt.PassThrough), None)
    _committed_configsBody(t=t, state=state)


actor _committed_configsBody(t: testing.AsyncT, state: ttt.ListState ):
    first = gdata.List([q("name")], [])
    second = gdata.List([q("name")], [])
    absent = gdata.Absent()

    def __startup__():
        testing.assertEqual(state.get_configs(), {})

        state.acquire("A", {"srcA": set()}, {"srcA"}, {}, {"srcA": first})
        state.acquire("B", {"srcA": set()}, {"srcA"}, {}, {"srcA": second})
        testing.assertEqual(state.get_configs(), {})
        state.release("A", True, set())
        snapshot = state.get_configs()
        testing.assertTrue(ttt.same_node(snapshot["srcA"], first))

        # An abort leaves the committed baseline intact, despite newer input.
        state.release("B", False, set())
        testing.assertTrue(ttt.same_node(state.get_configs()["srcA"], first))

        # Reuse a transaction id: replace supplied sources and retain the others.
        state.acquire("A", {"srcB": set()}, {"srcB"}, {}, {"srcB": first})
        state.acquire("A", {"srcB": set()}, {"srcB"}, {}, {"srcB": second})
        state.acquire("A", {"srcA": set()}, {"srcA"}, {}, {"srcA": absent})
        state.release("A", True, set())
        current = state.get_configs()
        testing.assertTrue(ttt.same_node(current["srcA"], absent))
        testing.assertTrue(ttt.same_node(current["srcB"], second))
        testing.assertTrue(ttt.same_node(snapshot["srcA"], first))
        testing.assertEqual(set(snapshot.keys()), {"srcA"})

        # Mutating the snapshot and committing linkage-only work cannot alter it.
        del current["srcA"]
        state.acquire_existing("A", set())
        state.release("A", True, set())
        testing.assertEqual(set(state.get_configs().keys()), {"srcA", "srcB"})
        t.success()



