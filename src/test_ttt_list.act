proc def _test_basic_delete(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    t1 = tlist.newtrans()
    _basic_deleteBody(t=t, t1=t1)


actor _basic_deleteBody(t: testing.AsyncT, t1):
    def __startup__():
        def cont2(_r: value):
            t1.commit("1", True)
            r = t1.get()
            testing.assertEqual(r, tree1pruned)
            t.success()

        def cont1(_r: value):
            t1.commit("1", True)
            r = t1.get()
            testing.assertEqual(r, tree1)
            t1.configure("1", {'srcA': tree1diff}, None, differential=True)
            t1.lock("1", None, cont2)

        t1.configure("1", {'srcA': tree1}, None)
        t1.lock("1", None, cont1)



