proc def _test_aborted_create2(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    t1 = tlist.newtrans()
    t2 = tlist.newtrans()
    _aborted_create2Body(t=t, t1=t1, t2=t2)


actor _aborted_create2Body(t: testing.AsyncT, t1, t2):
    def __startup__():
        def cont1(_r: value):
            t2.lock("2", None, cont2)
            t1.commit("1", False)

        def cont2(_r: value):
            t2.commit("2", True)
            r = t2.get()
            if r != y2:
                testing.assertEqual(r.prsrc(), y2.prsrc())
            t.success()

        t1.configure("1", {'srcA': y1}, None)
        t2.configure("2", {'srcB': y2}, None)
        t1.lock("1", None, cont1)



proc def _test_consecutive_configure(t: testing.AsyncT):
    tlist = ttt.List(ttt.Transform(ttt.PassThrough), [q("name")]) (ttt.PathRoot("0:"), None)
    t2 = tlist.newtrans()
    _consecutive_configureBody(t=t, t2=t2)


actor _consecutive_configureBody(t: testing.AsyncT, t2):
    def __startup__():
        x = gdata.List([q("name")], [
            gdata.Container({
                q("name"): gdata.Leaf("k1"),
                q("a"): gdata.Leaf(1),
                q("b"): gdata.Leaf(2)
            }),
            gdata.Container({
                q("name"): gdata.Leaf("k2"),
                q("a"): gdata.Leaf(1)
            })
        ])
        y = gdata.List([q("name")], [
            gdata.Container({
                q("name"): gdata.Leaf("k1"),
                q("b"): gdata.Leaf(1)
            })
        ])

        def cont2(_r: value):
            t2.configure("2", {'srcB': y}, None)
            t2.commit("2", True)
            r = t2.get()
            if r != y:
                testing.assertEqual(r.prsrc(), y.prsrc())
            t.success()

        t2.configure("2", {'srcB': x}, None)
        t2.lock("2", None, cont2)



