proc def _test_nested_delete(t: testing.AsyncT):
    tlist = ttt.List(
                ttt.Container({
                    q("left"): ttt.Transform(ttt.PassThrough),
                    q("right"): ttt.Transform(ttt.PassThrough)
                }), [q("name")]
            ) (ttt.PathRoot("0:"), None)
    t1 = tlist.newtrans()
    _nested_deleteBody(t=t, t1=t1)


actor _nested_deleteBody(t: testing.AsyncT, t1):
    def __startup__():
        in1 = gdata.List([q("name")], [
                gdata.Container({
                    q("name"): gdata.Leaf("k1"),
                    q("left"): gdata.Container({
                        q("x"): gdata.Leaf(1)
                    }),
                    q("right"): gdata.Container({
                        q("y"): gdata.Leaf(1)
                    }),
                }),
                gdata.Container({
                    q("name"): gdata.Leaf("k2"),
                    q("left"): gdata.Container({
                        q("x"): gdata.Leaf(2)
                    }),
                    q("right"): gdata.Container({
                        q("y"): gdata.Leaf(2)
                    }),
                }),
            ])

        def cont1(r):
            t1.commit("1", True)
            out1 = t1.get()
            testing.assertEqual(out1, in1)
            t1.configure("1", {"srcA": gdata.Absent()}, None, differential=True)

            def cont2(r):
                if isinstance(r, str):
                    testing.assertEqual(r, "Empty")
                t1.commit("1", True)
                out2 = t1.get()
                exp2 = gdata.List([q("name")], [])
                testing.assertEqual(out2, exp2)
                t.success()

            t1.lock("1", None, cont2)

        t1.configure("1", {"srcA": in1}, None)

        t1.lock("1", None, cont1)



