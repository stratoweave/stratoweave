IETF_SYSTEM_NS = "urn:ietf:params:xml:ns:yang:ietf-system"
IETF_SYSTEM_MODULE = "ietf-system"

IETF_SYSTEM_YANG = r"""module ietf-system {
  yang-version "1.1";
  namespace "urn:ietf:params:xml:ns:yang:ietf-system";
  prefix sys;
  container system {
    leaf hostname {
      type string;
    }
  }
  container system-state {
    config false;
    container clock {
      leaf current-datetime {
        type string;
      }
      leaf boot-datetime {
        type string;
      }
    }
  }
  rpc set-clock {
    input {
      leaf new-datetime {
        type string;
      }
    }
    output {
      leaf old-datetime {
        type string;
      }
    }
  }
  rpc set-current-datetime {
    input {
      leaf current-datetime {
        type string;
      }
    }
  }
  rpc get-current-datetime {
    output {
      leaf current-datetime {
        type string;
      }
    }
  }
}"""

LIMITS_NS = "urn:example:limits"

LIMITS_YANG = r"""module limits {
  yang-version "1.1";
  namespace "urn:example:limits";
  prefix lim;
  container limits {
    leaf mtu {
      type uint16 {
        range "68..9000";
      }
    }
  }
}"""

def _q(name: str) -> ygdata.Id:
    return ygdata.Id(IETF_SYSTEM_NS, name)

def _config_reply(children: list[xml.Node]) -> list[xml.Node]:
    """The children of a <get-config> reply with this configuration."""
    return [xml.Node("data", nsdefs=[(None, swna.NS_NC_1_0)], children=children)]

def _undecodable_config() -> list[xml.Node]:
    """A configuration whose mtu is outside the range of the schema."""
    return _config_reply([
        xml.Node("limits", nsdefs=[(None, LIMITS_NS)], children=[xml.Node("mtu", text="1")])
    ])

def _mock_oper_ds(current_datetime: str, boot_datetime: str) -> ygdata.Node:
    """Mock data for the operational datastore of the mock NETCONF server."""
    return ygdata.Container({
        _q("system-state"): ygdata.Container({
            _q("clock"): ygdata.Container({
                _q("current-datetime"): ygdata.Leaf(current_datetime, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE),
                _q("boot-datetime"): ygdata.Leaf(boot_datetime, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
            }, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
        }, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
    })

def system_config(hostname: str) -> ygdata.Node:
    return ygdata.Container({
        _q("system"): ygdata.Container({
            _q("hostname"): ygdata.Leaf(hostname, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
        }, ns=IETF_SYSTEM_NS, module=IETF_SYSTEM_MODULE)
    })

def _current_datetime_filter() -> ygdata.FNode:
    """Filter matching only system-state/clock/current-datetime."""
    return ygdata.FNode(None, None, [
        ygdata.FNode(_q("system-state"), children=[
            ygdata.FNode(_q("clock"), children=[
                ygdata.FNode(_q("current-datetime"))
            ])
        ])
    ])

def _boot_datetime_filter() -> ygdata.FNode:
    """Filter matching only system-state/clock/boot-datetime."""
    return ygdata.FNode(None, None, [
        ygdata.FNode(_q("system-state"), children=[
            ygdata.FNode(_q("clock"), children=[
                ygdata.FNode(_q("boot-datetime"))
            ])
        ])
    ])

def _current_datetime_from_tree(n: ?ygdata.Node) -> ?str:
    if n is not None and isinstance(n, ygdata.Container):
        sys_state = n.get_opt_cnt(_q("system-state"))
        if sys_state is not None:
            clock = sys_state.get_opt_cnt(_q("clock"))
            if clock is not None:
                leaf = clock.get_opt_leaf(_q("current-datetime"))
                if leaf is not None:
                    val = leaf.val
                    if isinstance(val, str):
                        return val
    return None

def _has_boot_datetime(n: ?ygdata.Node) -> bool:
    if n is not None and isinstance(n, ygdata.Container):
        sys_state = n.get_opt_cnt(_q("system-state"))
        if sys_state is not None:
            clock = sys_state.get_opt_cnt(_q("clock"))
            if clock is not None:
                return clock.get_opt_leaf(_q("boot-datetime")) is not None
    return False

def make_netconf_mock_dmc(name: str, sync_check: bool=True, telemetry: ?str=None) -> DeviceMetaConfig:
    return DeviceMetaConfig(
        name=name,
        credentials=Credentials("admin", "admin"),
        type="netconf",
        address=[Address(name="primary", address="127.0.0.1", port=u64(830))],
        sync_check=sync_check,
        telemetry=telemetry,
        mock=Mock(enabled=True)
    )

def _netconf_mock_device_types(extra_models: list[str]=[]) -> dict[str, swdev.DeviceType]:
    schema = yang.compile([IETF_SYSTEM_YANG] + extra_models)
    dev_types = {
        "netconf": swdev.DeviceType(
            name="netconf",
            adapter_type=swna.NetconfAdapter,
            src_dnode=schema
        )
    }
    return dev_types


def new_netconf_mock_device_mgr(t: testing.EnvT, name: str, on_reconf: action(str) -> None, extra_models: list[str]=[], sync_check: bool=True, telemetry: ?str=None, track_config: bool=False) -> swdev.DeviceMgr:
    dev_types = _netconf_mock_device_types(extra_models)

    schema_registry = swdev.SchemaRegistry()
    dev = swdev.DeviceMgr(dev_types, t.env, name, t.log_handler, on_reconf, schema_registry, track_config=track_config)
    dev.set_dmc(make_netconf_mock_dmc(name, sync_check=sync_check, telemetry=telemetry))
    return dev

def _is_get(rpc: str) -> bool:
    """Return True if rpc, as the mock server records it, is a get."""
    return rpc.startswith("<get>") or rpc.startswith("<get ") or rpc.startswith("<get/")

#################################################################################
## Tests
#################################################################################
proc def _test_configure_without_sync_check_skips_config_reads_wrapper(t: testing.EnvT):
    compiled_types = _netconf_mock_device_types([])
    _test_configure_without_sync_check_skips_config_reads(t, compiled_types)


actor _test_configure_without_sync_check_skips_config_reads(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """Unchecked configuration uses the normal datastore transaction without
    reading configuration before or after it."""
    def noop_on_reconf(name: str):
        pass

    dev: swdev.DeviceMgr = swdev.DeviceMgr(compiled_types, t.env, "dev-unchecked-config", t.log_handler, noop_on_reconf, swdev.SchemaRegistry(), track_config=True)
    var done = False
    var mock_server: ?swna.NetconfMockServer = None

    def fail(msg: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(msg))

    def on_configured(result: value) -> None:
        if done:
            return
        if isinstance(result, Exception):
            fail("Unchecked configuration failed: {result}")
            return
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        history = ms!.get_rpc_history()
        if len(history) != 1:
            fail("Expected one NETCONF RPC, got {history}")
        elif "edit-config" not in history[0] or "<running" not in history[0]:
            fail("Expected edit-config to running, got {history[0]}")
        else:
            running = dev.get_running_conf()
            if running != system_config("edge-1"):
                fail("Unchecked configuration did not advance the cached running config")
            else:
                done = True
                t.success()

    def start() -> None:
        if done:
            return
        modules, modset_id = dev.get_modules()
        if IETF_SYSTEM_MODULE not in modules or modset_id is None or dev.get_running_conf() is None:
            after 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            mock_server = ms
            ms!.clear_rpc_history()
            dev.configure(system_config("edge-1"), modset_id, "unchecked")
            dev.wait_complete("unchecked", on_configured)
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc("dev-unchecked-config", sync_check=False))
        start()
        after 2.0: fail("Timed out applying unchecked configuration")



proc def _test_reenabling_sync_check_resyncs_before_edit_wrapper(t: testing.EnvT):
    compiled_types = _netconf_mock_device_types([])
    _test_reenabling_sync_check_resyncs_before_edit(t, compiled_types)


actor _test_reenabling_sync_check_resyncs_before_edit(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """A checked edit after an unchecked one rebuilds the verified baseline
    before applying the next DeviceMgr-computed diff."""
    def noop_on_reconf(name: str):
        pass

    dev: swdev.DeviceMgr = swdev.DeviceMgr(compiled_types, t.env, "dev-reenable-sync-check", t.log_handler, noop_on_reconf, swdev.SchemaRegistry(), track_config=True)
    var done = False
    var mock_server: ?swna.NetconfMockServer = None

    def fail(msg: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(msg))

    def on_checked(result: value) -> None:
        if done:
            return
        if isinstance(result, Exception):
            fail("Checked configuration failed after resync: {result}")
            return
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        history = ms!.get_rpc_history()
        edit_index = -1
        for i in range(len(history)):
            if "edit-config" in history[i]:
                edit_index = i
                break
        if edit_index <= 0:
            fail("Expected a configuration read before the checked edit, got {history}")
        elif "get-config" not in history[0]:
            fail("Expected resync before the checked edit, got {history}")
        elif ygdata.diff(dev.get_running_conf(), system_config("edge-2")) is not None:
            fail("Checked configuration did not reach the target")
        else:
            done = True
            t.success()

    def on_unchecked(result: value) -> None:
        if done:
            return
        if isinstance(result, Exception):
            fail("Initial unchecked configuration failed: {result}")
            return
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        dev.set_dmc(make_netconf_mock_dmc("dev-reenable-sync-check", sync_check=True))
        ms!.clear_rpc_history()
        modules, modset_id = dev.get_modules()
        if modset_id is None:
            fail("Missing module-set id")
            return
        dev.configure(system_config("edge-2"), modset_id, "checked")
        dev.wait_complete("checked", on_checked)

    def start() -> None:
        if done:
            return
        modules, modset_id = dev.get_modules()
        if IETF_SYSTEM_MODULE not in modules or modset_id is None or dev.get_running_conf() is None:
            after 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            mock_server = ms
            dev.configure(system_config("edge-1"), modset_id, "unchecked")
            dev.wait_complete("unchecked", on_unchecked)
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc("dev-reenable-sync-check", sync_check=False))
        start()
        after 3.0: fail("Timed out re-enabling sync checks")


proc def _test_fetch_config_decode_error(t: testing.EnvT):
    """A device configuration that does not match the schema fails the fetch
    with PermanentError, and the driver drops its copy of the running
    configuration."""
    def noop_on_reconf(name: str):
        pass

    dev: swdev.DeviceMgr = new_netconf_mock_device_mgr(
        t,
        "dev-fetch-decode-error",
        noop_on_reconf,
        extra_models=[LIMITS_YANG],
        track_config=True,
    )
    _test_fetch_config_decode_errorActor(t, dev)


actor _test_fetch_config_decode_errorActor(t: testing.EnvT, dev: swdev.DeviceMgr):
    var done = False

    def fail(msg: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(msg))

    def undecodable(request: xml.Node, reply: action(?list[xml.Node], ?str, ?str) -> None) -> None:
        reply(_undecodable_config(), None, None)

    def on_fetched(conf: ?ygdata.Node, err: ?Exception) -> None:
        if done:
            return
        if conf is not None:
            fail("Fetch returned a configuration: {conf}")
        elif not isinstance(err, swadapt.PermanentError):
            fail("Expected PermanentError, got {err}")
        elif dev.get_adapter().get_config() is not None:
            fail("The driver kept its running configuration")
        else:
            done = True
            t.success()

    def start() -> None:
        if done:
            return
        if dev.get_running_conf() is None:
            after 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            ms!.set_rpc_cb(undecodable, overrides={"get-config"})
            dev.fetch_config(on_fetched)
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        start()
        after 2.0: fail("Timed out waiting for the configuration fetch")



proc def _test_checked_configure_decode_error(t: testing.EnvT):
    """A checked edit fails with PermanentError, and does not edit the
    device, when the device configuration does not match the schema."""
    def noop_on_reconf(name: str):
        pass

    dev: swdev.DeviceMgr = new_netconf_mock_device_mgr(
        t,
        "dev-checked-decode-error",
        noop_on_reconf,
        extra_models=[LIMITS_YANG],
        track_config=True,
    )
    _test_checked_configure_decode_errorActor(t, dev)


actor _test_checked_configure_decode_errorActor(t: testing.EnvT, dev: swdev.DeviceMgr):
    var done = False
    var mock_server: ?swna.NetconfMockServer = None

    def fail(msg: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(msg))

    def undecodable(request: xml.Node, reply: action(?list[xml.Node], ?str, ?str) -> None) -> None:
        reply(_undecodable_config(), None, None)

    def on_configured(result: value) -> None:
        if done:
            return
        if not isinstance(result, swadapt.PermanentError):
            fail("Expected PermanentError, got {result}")
            return
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        history = ms!.get_rpc_history()
        for rpc in history:
            if "edit-config" in rpc:
                fail("Edited the device after a failed sync check: {history}")
                return
        done = True
        t.success()

    def start() -> None:
        if done:
            return
        modules, modset_id = dev.get_modules()
        if IETF_SYSTEM_MODULE not in modules or modset_id is None or dev.get_running_conf() is None:
            after 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            mock_server = ms
            ms!.set_rpc_cb(undecodable, overrides={"get-config"})
            ms!.clear_rpc_history()
            dev.configure(system_config("edge-1"), modset_id, "checked")
            dev.wait_complete("checked", on_configured)
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        start()
        after 2.0: fail("Timed out waiting for the checked edit")



proc def _test_commit_result_decode_error(t: testing.EnvT):
    """When the configuration after a commit does not match the schema, the
    edit succeeds, and the next checked edit fetches the device configuration
    before it edits."""
    def noop_on_reconf(name: str):
        pass

    dev: swdev.DeviceMgr = new_netconf_mock_device_mgr(
        t,
        "dev-commit-decode-error",
        noop_on_reconf,
        extra_models=[LIMITS_YANG],
        track_config=True,
    )
    _test_commit_result_decode_errorActor(t, dev)


actor _test_commit_result_decode_errorActor(t: testing.EnvT, dev: swdev.DeviceMgr):
    var done = False
    var mock_server: ?swna.NetconfMockServer = None
    var get_configs = 0

    def fail(msg: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(msg))

    def reads(request: xml.Node, reply: action(?list[xml.Node], ?str, ?str) -> None) -> None:
        # The read before the first edit gets the empty configuration of the
        # first resync. The read after its commit does not decode.
        get_configs += 1
        if get_configs == 1:
            reply(_config_reply([]), None, None)
        else:
            reply(_undecodable_config(), None, None)

    def on_second(result: value) -> None:
        if done:
            return
        if isinstance(result, Exception):
            fail("Second edit failed: {result}")
            return
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        history = ms!.get_rpc_history()
        edit_index = -1
        for i in range(len(history)):
            if "edit-config" in history[i]:
                edit_index = i
                break
        if edit_index <= 0:
            fail("Expected a configuration read before the second edit, got {history}")
        elif "get-config" not in history[0]:
            fail("Expected a resync before the second edit, got {history}")
        elif ygdata.diff(dev.get_running_conf(), system_config("edge-2")) is not None:
            fail("The second edit did not reach the target")
        else:
            done = True
            t.success()

    def on_first(result: value) -> None:
        if done:
            return
        if isinstance(result, Exception):
            fail("First edit failed: {result}")
            return
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        modules, modset_id = dev.get_modules()
        if modset_id is None:
            fail("Missing module-set id")
            return
        # From here the mock answers get-config from its datastore.
        ms!.set_rpc_cb(reads, overrides=set())
        ms!.clear_rpc_history()
        dev.configure(system_config("edge-2"), modset_id, "second")
        dev.wait_complete("second", on_second)

    def start() -> None:
        if done:
            return
        modules, modset_id = dev.get_modules()
        if IETF_SYSTEM_MODULE not in modules or modset_id is None or dev.get_running_conf() is None:
            after 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            mock_server = ms
            ms!.set_rpc_cb(reads, overrides={"get-config"})
            dev.configure(system_config("edge-1"), modset_id, "first")
            dev.wait_complete("first", on_first)
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    def timed_out() -> None:
        fail("Timed out after {get_configs} get-config replies")

    proc def __startup__():
        start()
        after 3.0: timed_out()




proc def _test_software_dmc_preserves_system_mock_adapter(t: testing.EnvT):
    """Software intent must not replace the device transport adapter."""
    schema = yang.compile([IETF_SYSTEM_YANG])
    _test_software_dmc_preserves_system_mock_adapterActor(t=t, schema=schema)


actor _test_software_dmc_preserves_system_mock_adapterActor(t: testing.EnvT, schema: yschema.DRoot):
    old_datetime = "2026-02-21T10:11:12Z"

    def noop_on_reconf(name: str):
        pass
    dev_types = {
        "netconf": swdev.DeviceType(
            name="netconf",
            adapter_type=swna.NetconfAdapter,
            src_dnode=schema,
        )
    }
    dev: swdev.DeviceMgr = swdev.DeviceMgr(
        dev_types,
        None,
        "dev-software-dmc",
        t.log_handler,
        noop_on_reconf,
        swdev.SchemaRegistry(),
    )
    var done = False

    def fail(msg: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(msg))

    def on_reply(root: ?ygdata.Node, error: ?Exception) -> None:
        if error is not None:
            fail("software-only DMC update lost the NETCONF mock RPC handler: {error}")
        elif root is None or root!.get_opt_str(_q("old-datetime")) != old_datetime:
            fail("software-only DMC update replaced the NETCONF adapter")
        elif not done:
            done = True
            t.success()

    def update_software() -> None:
        updated = make_netconf_mock_dmc("dev-software-dmc")
        updated.software.upgrade_campaign = "xe-upgrade"
        updated.software.target_release = "17.18.03a"
        dev.set_dmc(updated)
        def invoke_rpc() -> None:
            dev.rpc(on_reply, ygdata.Container({
                _q("set-clock"): ygdata.Container({
                    _q("new-datetime"): ygdata.Leaf("2026-03-01T00:00:00Z")
                })
            }))
        after 0.05: invoke_rpc()

    def start() -> None:
        if IETF_SYSTEM_MODULE not in dev.get_modules().0:
            after 0.01: start()
            return
        msg = async dev.get_adapter()
        adapter = await msg
        if isinstance(adapter, swna.NetconfAdapter):
            mock_server = adapter.get_mock_server()
            if mock_server is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return

            def on_rpc(request: xml.Node,
                       respond: action(children: ?list[xml.Node], tag: ?str, message: ?str) -> None) -> None:
                if request.tag == "set-clock":
                    out = ygdata.Container({
                        _q("old-datetime"): ygdata.Leaf(
                            old_datetime,
                            ns=IETF_SYSTEM_NS,
                            module=IETF_SYSTEM_MODULE,
                        )
                    })
                    respond(out.to_xml(deterministic=True), None, None)
                else:
                    respond(None, "operation-not-supported",
                            "mock does not do {request.tag}")

            mock_server!.set_rpc_cb(on_rpc)
            update_software()
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc("dev-software-dmc"))
        start()
        after 2.0: fail("Timed out checking adapter preservation")



proc def _failing_prepare(dev: swdev.DeviceMgr, dmc: DeviceMetaConfig,
                          log_handler: logging.Handler, env: ?Env) -> swdev.SoftwareAdapter:
    """A software adapter whose first prepare fails for a reason that is
    not transient."""
    return swmock.MockSoftwareAdapter(log_handler, "17.15.01a", "prepare", fail_times=1)


proc def _test_software_dmc_gives_the_prepare_attempt(t: testing.EnvT):
    """The software config of a DMC gives its prepare attempt to the
    software manager. Under a veto with allow-staging, the first prepare
    ahead fails for a reason that is not transient. A DMC with
    prepare-attempt 1 then prepares again, and the job says that it ran
    for 1."""
    t.timeout(10.0)
    schema = yang.compile([IETF_SYSTEM_YANG])
    _SoftwareDmcPrepareAttemptActor(t=t, schema=schema)


actor _SoftwareDmcPrepareAttemptActor(t: testing.EnvT, schema: yschema.DRoot):
    var asked = False
    var done = False

    def noop_on_reconf(name: str):
        pass

    dev_types = {
        "netconf": swdev.DeviceType(name="netconf", adapter_type=swna.NetconfAdapter,
                                    src_dnode=schema, software_adapter_type=_failing_prepare)
    }
    dev = swdev.DeviceMgr(dev_types, None, "dev-prepare-attempt", t.log_handler, noop_on_reconf,
                          swdev.SchemaRegistry())

    def dmc(prepare_attempt: int) -> DeviceMetaConfig:
        d = make_netconf_mock_dmc("dev-prepare-attempt")
        d.software.upgrade_campaign = "camp-1"
        d.software.target_release = "17.18.03a"
        d.software.allow_staging = True
        d.software.prepare_attempt = u64(prepare_attempt)
        d.software.veto.create("camp-1", reason="waiting for its window")
        return d

    def on_state(oper: ?ygdata.Node) -> None:
        if done or oper is None:
            return
        for e in swdevoper.stratoweave_rfs__device_entry.from_gdata(oper!).software.state.attempt:
            job = e.job.get("prepare")
            if job is not None:
                if job.state == "failed" and not asked:
                    asked = True
                    dev.set_dmc(dmc(1))
                elif job.state == "done" and job.prepare_attempt == u64(1):
                    done = True
                    t.success()

    proc def __startup__():
        dev.set_update_oper(on_state)
        dev.set_dmc(dmc(0))


