    def close_subs():
        if subs is not None:
            subs.close()

    def fail(msg: str):
        if done:
            return
        done = True
        close_subs()
        t.failure(ValueError(msg))

    def succeed():
        if done:
            return
        done = True
        close_subs()
        t.success()

    def on_update(n: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Subscription manager update error: {err}")
            return

        updates += 1
        if updates > 1:
            fail("Unexpected extra subscription update: {updates}")
            return

        dt = _current_datetime_from_tree(n)
        has_boot = _has_boot_datetime(n)
        if dt != mock_current_datetime:
            fail("Unexpected current datetime: {dt}")
            return
        if has_boot:
            fail("Unexpected boot datetime in filtered update")
            return

        declare_current_only()
        after 0.15: succeed()

    def declare_current_only():
        want = {
            dst!.deliver({
                ygdata.SubscriptionSpec(_current_datetime_filter(), period=0.5)
            })
        }
        subs!.declare(want)

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms0 = adapter.get_mock_server()
            if ms0 is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            ms = ms0!
            ms.set_oper_ds(_mock_oper_ds(mock_current_datetime, mock_boot_datetime))
            dst = ygdata.Dst(on_update)
            subs = ygdata.SubscriptionManager(dev.tree_provider(), "test-subscription-manager-idempotent")
            declare_current_only()
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc("dev-subs-idempotent", sync_check=True))
        start()

        after 2.0: fail("Timed out waiting for idempotent subscription manager test")



proc def _test_device_rejects_mixed_rooted_periods_wrapper(t: testing.EnvT):
    compiled_types = _netconf_mock_device_types([])
    _test_device_rejects_mixed_rooted_periods(t, compiled_types)


actor _test_device_rejects_mixed_rooted_periods(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """A rooted destination with two periods gets no data and one
    ValueError: a rooted destination is read on one period or served
    on-change."""
    var done = False
    var errors = 0
    var subs: ?ygdata.SubscriptionManager = None

    def noop_on_reconf(name: str):
        pass
    dev = swdev.DeviceMgr(compiled_types, t.env, "dev-rooted-cadence", t.log_handler, noop_on_reconf, swdev.SchemaRegistry())

    def close_subs():
        if subs is not None:
            subs.close()

    def fail(msg: str):
        if done:
            return
        done = True
        close_subs()
        t.failure(ValueError(msg))

    def finish():
        if done:
            return
        done = True
        close_subs()
        if errors == 1:
            t.success()
        else:
            t.failure(ValueError("errors={errors}"))

    def on_rooted(n: ?ygdata.Node, err: ?Exception):
        if isinstance(err, ValueError) and err.error_message == "a rooted destination is read on one period or served on-change":
            errors += 1
            after 0.3: finish()                     # no data may follow
        elif err is not None:
            fail("mixed rooted periods failed with {err}")
        else:
            fail("data delivered for mixed rooted periods")

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms0 = adapter.get_mock_server()
            if ms0 is None:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
            ms0!.set_oper_ds(_mock_oper_ds("2026-02-21T10:11:12Z", "2025-12-31T00:00:00Z"))
            subs = ygdata.SubscriptionManager(dev.tree_provider(), "rooted-cadence")
            root = ygdata.FNode(ygdata.Id("urn:ietf:params:xml:ns:yang:ietf-system", "system-state"))
            subs!.declare({ygdata.Dst(on_rooted, root=root).deliver({
                ygdata.SubscriptionSpec(None, period=0.05),
                ygdata.SubscriptionSpec(None, period=0.1),
            })})
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc("dev-rooted-cadence", sync_check=True))
        start()



# A key pair made for the key login test only.
TEST_PRIVATE_KEY = """-----BEGIN OPENSSH PRIVATE KEY-----
b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
QyNTUxOQAAACDgjfQUrEMlqNGp0I3jrLdNQjVSXkfQ1229bCdIwRg6HQAAAIgXM1oGFzNa
BgAAAAtzc2gtZWQyNTUxOQAAACDgjfQUrEMlqNGp0I3jrLdNQjVSXkfQ1229bCdIwRg6HQ
AAAECr9T5H5jEjsuF8usTgKrjTrGUFz2azFXpmhXBZBms47+CN9BSsQyWo0anQjeOst01C
NVJeR9DXbb1sJ0jBGDodAAAAAAECAwQF
-----END OPENSSH PRIVATE KEY-----
"""
TEST_PUBLIC_KEY = b"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOCN9BSsQyWo0anQjeOst01CNVJeR9DXbb1sJ0jBGDod"


actor _test_key_login(t: testing.EnvT):
    """A device whose credentials have a private key and no password logs in
    with the key.

    The NETCONF server on loopback SSH accepts only TEST_PUBLIC_KEY. The device
    connects when its module set arrives from the hello.
    """
    var done = False
    var listener: ?sshpipe.SshPipeListener = None
    var sessions: list[netconf.Server] = []

    def finish(err: ?Exception):
        if done:
            return
        done = True
        l = listener
        if l is not None:
            l.close()
        if err is not None:
            t.failure(err)
        else:
            t.success()

    def auth(user: str, password: ?str, pubkey: ?bytes, respond: action(bool) -> None):
        if user == "admin" and password is None and pubkey is not None and pubkey == TEST_PUBLIC_KEY:
            respond(True)
        else:
            respond(False)

    def on_rpc(s: netconf.Server, message_id: str, op: xml.Node):
        s.send_error(message_id, "operation-not-supported", "Unsupported RPC operation: " + op.tag)

    def on_accept(l: sshpipe.SshPipeListener, p: sshpipe.SshListenPipe):
        caps = [netconf.CAP_NC_1_0, netconf.CAP_NC_1_1, IETF_SYSTEM_NS + "?module=" + IETF_SYSTEM_MODULE]
        sessions.append(netconf.Server(pipe=p, on_rpc=on_rpc, capabilities=caps, log_handler=t.log_handler))

    def on_reconf(name: str):
        finish(None)

    def on_listen(l: sshpipe.SshPipeListener, err: ?Exception):
        if err is not None:
            finish(err)
            return
        dev_types = {
            "netconf": swdev.DeviceType(name="netconf", adapter_type=swna.NetconfAdapter,
                                        src_dnode=yang.compile([IETF_SYSTEM_YANG]))
        }
        dev = swdev.DeviceMgr(dev_types, t.env, "keyed", t.log_handler, on_reconf, swdev.SchemaRegistry())
        creds = Credentials("admin", key=[CredentialsKey("test", TEST_PRIVATE_KEY)])
        dmc = DeviceMetaConfig(name="keyed", credentials=creds, type="netconf",
                               address=[Address(name="primary", address="127.0.0.1", port=u64(l.bound_port()))])
        dev.set_dmc(dmc)


    proc def __startup__():
        listener = sshpipe.SshPipeListener(net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap))),
                                           address="127.0.0.1", port=0,
                                           on_listen=on_listen, on_accept=on_accept, auth_check=auth,
                                           subsystem="netconf", log_handler=t.log_handler)
        after 2.0: finish(ValueError("the device did not log in with its key"))
