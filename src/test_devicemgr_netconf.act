proc def _test_subscribe_telemetry_setting(t: testing.EnvT):
    compiled_types = _netconf_mock_device_types(YP_CLOSURE)
    _test_subscribe_telemetry_settingActor(t, compiled_types)


actor _test_subscribe_telemetry_settingActor(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """The telemetry setting selects how a periodic subscription reads a
    device that advertises ietf-yang-push. Without the setting the adapter
    uses YANG-push. With the setting poll, the adapter connects again and
    polls with get. The subscription is declared after the device connected,
    so only the reconnect can start the polling."""
    name = "dev-telemetry-setting"
    var done = False
    var switched = False

    def noop_on_reconf(name: str):
        pass
    dev = swdev.DeviceMgr(compiled_types, t.env, name, t.log_handler, noop_on_reconf, swdev.SchemaRegistry())

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def on_update(n: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Subscription update error: {err}")
            return
        method = dev.subscription_status().method
        if not switched:
            if method != swadapt.SUBSCRIPTION_YANG_PUSH:
                fail("Expected yang-push without the setting, got {method}")
                return
            switched = True
            dev.set_dmc(make_netconf_mock_dmc(name, telemetry="poll"))
        elif method == swadapt.SUBSCRIPTION_POLL:
            done = True
            dev.remove_subscriptions("test-telemetry-setting")
            t.success()

    def start():
        if done:
            return
        modules, modset_id = dev.get_modules()
        if modset_id is None:
            after now 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is not None:
                ms.set_oper_ds(_mock_oper_ds("2026-02-21T10:11:12Z", "2025-12-31T00:00:00Z"))
                want = set([ygdata.SubscriptionSpec(None, period=0.05)])
                dev.declare_subscriptions("test-telemetry-setting", on_update, want)
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    def timeout():
        fail("Timed out waiting for polling after telemetry was set to poll (switched={switched})")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc(name))
        start()

        after now 2.5: timeout()



proc def _test_subscribe_telemetry_setting_push(t: testing.EnvT):
    compiled_types = _netconf_mock_device_types(YP_CLOSURE)
    _test_subscribe_telemetry_setting_pushActor(t, compiled_types)


actor _test_subscribe_telemetry_setting_pushActor(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """A device that the adapter polls because of the telemetry setting poll
    stops being polled when the setting changes to push. After the reconnect
    YANG-push delivers the subscription, and the adapter sends no get."""
    name = "dev-telemetry-push"
    var done = False
    var switched = False
    var pushed = 0
    var mock_server: ?swna.NetconfMockServer = None

    def noop_on_reconf(name: str):
        pass
    dev = swdev.DeviceMgr(compiled_types, t.env, name, t.log_handler, noop_on_reconf, swdev.SchemaRegistry())

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def check_no_get():
        ms = mock_server
        if ms is None:
            fail("Missing NETCONF mock server")
            return
        for rpc in ms!.get_rpc_history():
            if _is_get(rpc):
                fail("Expected no get after telemetry was set to push, got {rpc}")
                return
        done = True
        dev.remove_subscriptions("test-telemetry-push")
        t.success()

    def on_update(n: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Subscription update error: {err}")
            return
        method = dev.subscription_status().method
        if not switched:
            if method != swadapt.SUBSCRIPTION_POLL:
                fail("Expected poll with the setting poll, got {method}")
                return
            switched = True
            dev.set_dmc(make_netconf_mock_dmc(name, telemetry="push"))
            return
        if method != swadapt.SUBSCRIPTION_YANG_PUSH:
            return
        pushed += 1
        # A get sent before the reconnect can still answer the first updates.
        # Record the RPCs from the second update on.
        if pushed == 2:
            adapter = dev.get_adapter()
            if isinstance(adapter, swna.NetconfAdapter):
                ms = adapter.get_mock_server()
                if ms is not None:
                    mock_server = ms
                    ms.clear_rpc_history()
        elif pushed == 6:
            check_no_get()

    def start():
        if done:
            return
        modules, modset_id = dev.get_modules()
        if modset_id is None:
            after now 0.01: start()
            return
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            ms = adapter.get_mock_server()
            if ms is not None:
                ms.set_oper_ds(_mock_oper_ds("2026-02-21T10:11:12Z", "2025-12-31T00:00:00Z"))
                want = set([ygdata.SubscriptionSpec(None, period=0.05)])
                dev.declare_subscriptions("test-telemetry-push", on_update, want)
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    def timeout():
        fail("Timed out waiting for yang-push after telemetry was set to push (switched={switched}, pushed={pushed})")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc(name, telemetry="poll"))
        start()

        after now 2.5: timeout()



