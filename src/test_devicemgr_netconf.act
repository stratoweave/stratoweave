    _test_subscribe_on_change(t, compiled_types)


actor _test_subscribe_on_change(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """On-change subscription via the device adapter against a yang-push-capable mock.

    1. DeviceMgr in mock mode whose schema advertises ietf-yang-push, so the adapter
       establishes a real on-change subscription (not poll emulation).
    2. Seed oper data and subscribe on-change; the sync-on-start baseline is update 1.
    3. On the baseline, mutate the oper datastore once; the mock emits a
       push-change-update whose yang-patch the adapter applies onto the subscription
       tree.
    4. On update 2, assert the applied current-datetime, then tear down.
    """
    mock_current_datetime_1 = "2026-02-21T10:11:12Z"
    mock_current_datetime_2 = "2026-02-21T10:11:13Z"
    mock_boot_datetime = "2025-12-31T00:00:00Z"

    var updates = 0
    var done = False
    var mock_server: ?swna.NetconfMockServer = None

    def noop_on_reconf(name: str):
        pass
    dev = swdev.DeviceMgr(compiled_types, t.env, "dev-onchange", t.log_handler, noop_on_reconf, swdev.SchemaRegistry())

    def fail(msg: str):
        if done:
            return
        done = True
        t.failure(ValueError(msg))

    def succeed():
        if done:
            return
        done = True
        t.success()

    def on_update(n: ?ygdata.Node, err: ?Exception):
        if done:
            return
        if err is not None:
            fail("Subscription update error: {err}")
            return
        dt = _current_datetime_from_tree(n)
        if dt is None:
            fail("Subscription update missing current-datetime")
            return

        updates += 1
        if updates == 1:
            if dt != mock_current_datetime_1:
                fail("Unexpected baseline datetime: {dt}")
                return
            ms = mock_server
            if ms is not None:
                ms.set_oper_ds(_mock_oper_ds(mock_current_datetime_2, mock_boot_datetime))
            else:
                fail("Missing mock server for on-change update")
                return
        elif updates == 2:
            if dt != mock_current_datetime_2:
                fail("Unexpected on-change datetime: {dt}")
                return
            dev.remove_subscriptions("test-subscribe-on-change")
            succeed()
        else:
            fail("Unexpected extra subscription update: {updates}")

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, swna.NetconfAdapter):
            mock_server = adapter.get_mock_server()
            ms = mock_server
            if ms is not None:
                ms.set_oper_ds(_mock_oper_ds(mock_current_datetime_1, mock_boot_datetime))
                want = set([ygdata.SubscriptionSpec(None, on_change=True)])
                dev.declare_subscriptions("test-subscribe-on-change", on_update, want)
            else:
                fail("Expected NetconfMockServer from NetconfAdapter")
                return
        else:
            fail("Expected NetconfAdapter from DeviceMgr")

    proc def __startup__():
        dev.set_dmc(make_netconf_mock_dmc("dev-onchange", sync_check=True))
        start()

        after 2.0: fail("Timed out waiting for on-change subscription updates")



proc def _test_mock_restart_ends_subscriptions(t: testing.EnvT):
    """A client restart on the mock's pipe ends the subscriptions of the
    session before it.

    1. Establish a periodic subscription, and restart the client on its
       first push-update.
    2. Establish a periodic subscription in the new session.
    3. From the reply on, every push-update must have the id of the new
       subscription. Both subscriptions push every 50 ms, so a live old
       subscription pushes between the first three updates of the new one.
    """
    pipes = actor_pipe_pair()
    schema = DeviceSchema("restart", yang.compile([IETF_SYSTEM_YANG]))
    mock = swna.NetconfMockServer(pipes.server, t.log_handler, [netconf.CAP_NC_1_0, netconf.CAP_NC_1_1], schema)

    TestMockRestartEndsSubscriptionsActor(t=t, pipes=pipes, mock=mock)


actor TestMockRestartEndsSubscriptionsActor(t: testing.EnvT, pipes, mock):
    var sessions = 0
    var restarted = False
    var old_id: ?int = None
    var new_id: ?int = None
    var new_updates = 0
    var done = False

    def fail(msg: str):
        if not done:
            done = True
            t.failure(ValueError(msg))

    def on_deleted(c: netconf.Client, err: ?netconf.NetconfError):
        if err is not None:
            fail("delete-subscription failed: {err}")
        elif not done:
            done = True
            c.close(None)
            t.success()

    def on_notif(c: netconf.Client, notif: xml.Node):
        if done:
            return
        update = yp.parse_push_update(notif)
        if update is not None:
            sub_id = update.sub_id
            if new_id is None:
                # Before the reply in the new session, push-updates of the
                # old subscription can still arrive.
                if sub_id == old_id and not restarted:
                    restarted = True
                    c.restart()
            elif sub_id == new_id:
                new_updates += 1
                if new_updates == 3:
                    c.delete_subscription(on_deleted, sub_id!)
            else:
                fail("push-update for subscription {sub_id} after the restart, expected {new_id}")
        else:
            fail("Unexpected notification: {notif.encode()}")

    def on_sub(c: netconf.Client, sub_id: ?int, err: ?netconf.NetconfError):
        if err is not None:
            fail("establish-subscription failed: {err}")
        elif sessions == 1:
            old_id = sub_id
        elif sub_id == old_id:
            fail("New session reused subscription id {sub_id}")
        else:
            new_id = sub_id

    def on_connect(c: netconf.Client, err: ?Exception):
        if err is not None:
            fail("Connect failed: {err}")
            return
        sessions += 1
        if sessions <= 2:
            # period is in centiseconds
            c.establish_subscription(on_sub, period=5)
        else:
            fail("Unexpected session {sessions}")

    proc def __startup__():
        mock.set_oper_ds(_mock_oper_ds("2026-02-21T10:11:12Z", "2025-12-31T00:00:00Z"))
        client = netconf.Client(None, "mock", 0, "admin", "admin", None, on_connect,
                                on_notif, True, t.log_handler, pipe=pipes.client)

        after now 2.0: fail("Timed out (sessions={sessions} old={old_id} new={new_id} updates={new_updates})")



