actor _test_subscribe_periodic_yang_push_empty(t: testing.EnvT, compiled_types: dict[str, swdev.DeviceType]):
    """A periodic push whose filter matches nothing carries no contents. That
    is an empty sample, not an error: the callback gets an empty tree on each
    period, and the data once the datastore has some."""
