"""Commands of the CLI.

In operational mode the commands are `configure`, `show configuration [path]
[| display set|xml|json]`, `show <path> [| display xml|json]`, `request <rpc
or path to an action> [input] [| display xml]`, `monitor notifications
[name ...]`, `monitor stop [name ...]`, `monitor list`, `exit` and `quit`.
`show <path>` reads configuration and state from the device, `request` makes
the device run an RPC or action, and `monitor` shows event notifications as
they arrive. In configuration mode they are `set`,
`delete`, `edit`, `up [N]`, `top [command]`, `show [path] [| compare |
display set|xml|json]`, `rollback [0]`, `run <command>` and `exit
[configuration-mode]`. Keywords take a unique prefix, so `sh conf` is `show
configuration`.

One walk over the words serves both parsing and completion. It returns the
command or an error, and what can follow the words.
"""

import std.xml as xml
import yang.schema as yschema
import yang.gdata as ygdata
import yang.xml as yxml

import netconf

import cli.candidate as candidate
import cli.hints as hints
import cli.path as cpath
import cli.render as render


_OP = [
    ("configure", "Enter configuration mode"),
    ("exit", "Exit the CLI"),
    ("monitor", "Show event notifications as they arrive"),
    ("quit", "Exit the CLI"),
    ("request", "Make the device run an RPC or action"),
    ("show", "Show information"),
]

_CONFIG = [
    ("delete", "Delete a statement"),
    ("edit", "Move to a level of the configuration"),
    ("exit", "Return to the level before the last edit, or leave configuration mode at the top"),
    ("quit", "Return to the level before the last edit, or leave configuration mode at the top"),
    ("rollback", "Discard the changes in the candidate configuration"),
    ("run", "Run an operational mode command"),
    ("set", "Set a value"),
    ("show", "Show the candidate configuration"),
    ("top", "Move to the top level, or run a command there"),
    ("up", "Move up one level, or more"),
]

_SHOW = [
    ("configuration", "Show the running configuration"),
]

_MONITOR = [
    ("list", "Show the notifications that the CLI shows"),
    ("notifications", "Show event notifications as they arrive"),
    ("stop", "Stop showing notifications"),
]

_EXIT = [
    ("configuration-mode", "Leave configuration mode"),
]

_ROLLBACK = [
    ("0", "Discard the changes in the candidate configuration"),
]

_PIPE_OP = [
    ("display", "Show the output in another format"),
]

_PIPE_CONFIG = [
    ("compare", "Compare with the running configuration"),
    ("display", "Show the output in another format"),
]

_DISPLAY = [
    ("json", "Show the configuration as JSON"),
    ("set", "Show the configuration as set commands"),
    ("xml", "Show the configuration as XML"),
]

_DISPLAY_DATA = [
    ("json", "Show the data as JSON"),
    ("xml", "Show the data as XML"),
]

_DISPLAY_REPLY = [
    ("xml", "Show the reply as XML"),
]

ENTER = cpath.Completion("<[Enter]>", " ", "Execute this command", insert=False)
PIPE = cpath.Completion("|", " ", "Pipe through a command", insert=False)


class Context(object):
    """What commands work on.

    mode is "op" or "config". data is the configuration that paths complete
    against and that show prints: the running configuration in operational
    mode, the candidate in configuration mode. For show data, it is the data
    that the device sent. base is the running
    configuration the candidate started from, and running is the newest copy
    of the running configuration. All three are trees at the schema root.
    root_path holds the containers above the start node of CLI paths. edit is
    the edit level below the start node; here and here_data are the node and
    the data at that level. back holds the levels that exit returns to, the
    newest last.
    """
    root: yschema.DRoot
    mode: str
    data: ?ygdata.Node
    base: ?ygdata.Node
    running: ?ygdata.Node
    root_path: list[yschema.DNode]
    start: yschema.DNode
    start_data: ?ygdata.Node
    edit: list[cpath.Step]
    here: yschema.DNode
    here_data: ?ygdata.Node
    back: list[list[cpath.Step]]

    def __init__(self, root: yschema.DRoot, data: ?ygdata.Node=None, mode: str="op", edit: list[cpath.Step]=[], base: ?ygdata.Node=None, running: ?ygdata.Node=None, back: list[list[cpath.Step]]=[]):
        self.root = root
        self.mode = mode
        self.data = data
        self.base = base
        self.running = running if running is not None else data
        self.root_path = hints.cli_root(root)
        top = cpath.descend(root, data, [cpath.Step(n) for n in self.root_path])
        self.start = top.node
        self.start_data = top.data
        self.edit = edit
        h = cpath.descend(self.start, self.start_data, edit)
        self.here = h.node
        self.here_data = h.data
        self.back = back

    def at_top(self) -> Context:
        """Return the same context at the top edit level."""
        return Context(self.root, self.data, self.mode, [], self.base, self.running, self.back)

    def op(self) -> Context:
        """Return the operational mode context over the running configuration."""
        return Context(self.root, self.running, "op")


class Command(object):
    """A parsed command.

    name is the command: "configure", "exit", "exit configuration-mode",
    "show configuration", "show data", "request", "monitor notifications",
    "monitor stop", "monitor list", "show", "set", "delete", "edit", "up",
    "top", "rollback", "run", or "" for an empty line. path is
    relative to the edit level edit, and view is the view it was resolved in;
    the paths of show data and request start at the schema root. display is
    the format a `| display` pipe asks for, and compare is True for `|
    compare`. count is the number of levels for up. sub is the command that
    top or run runs. args holds the input paths of a request, each from the
    input of the RPC or action, and the notifications of monitor, each a path
    of one step.
    """
    name: str
    path: ?cpath.PathResult
    edit: list[cpath.Step]
    view: str
    display: str
    compare: bool
    count: int
    sub: ?Command
    args: list[list[cpath.Step]]

    def __init__(self, name: str, path: ?cpath.PathResult=None, edit: list[cpath.Step]=[], count: int=1, sub: ?Command=None, view: str="config", args: list[list[cpath.Step]]=[]):
        self.name = name
        self.path = path
        self.edit = edit
        self.view = view
        self.display = ""
        self.compare = False
        self.count = count
        self.sub = sub
        self.args = args

    def steps(self) -> list[cpath.Step]:
        """Return the path from the start node: the edit level and then the command's path.

        The paths of show data and request start at the schema root.
        """
        p = self.path
        if p is not None:
            return self.edit + p.steps
        return self.edit


class ParseResult(object):
    """A parsed command, or an error at a character position of the line."""
    cmd: ?Command
    error: ?str
    column: int
    matches: list[str]

    def __init__(self, cmd: ?Command, error: ?str=None, column: int=0, matches: list[str]=[]):
        self.cmd = cmd
        self.error = error
        self.column = column
        self.matches = matches


class _Word(object):
    word: ?str
    error: ?str
    matches: list[str]

    def __init__(self, word: ?str, error: ?str=None, matches: list[str]=[]):
        self.word = word
        self.error = error
        self.matches = matches


def _match_word(words: list[(str, str)], t: cpath.Token) -> _Word:
    if t.quoted:
        return _Word(None, "syntax error.")
    found = []
    for w, _ in words:
        if w == t.text:
            return _Word(w)
        if w.startswith(t.text):
            found.append(w)
    if len(found) == 1:
        return _Word(found[0])
    if len(found) > 1:
        return _Word(None, "'{t.text}' is ambiguous.", found)
    return _Word(None, "syntax error.")


def _msg(err: ?str) -> str:
    if err is not None:
        return err
    return "syntax error."


def _column(line: str, toks: list[cpath.Token], i: int) -> int:
    if i < len(toks):
        return toks[i].start
    return len(line)


def _words(words: list[(str, str)]) -> list[cpath.Completion]:
    return [cpath.Completion(w, " ", h, keyword=True) for w, h in words]


class _Walk(object):
    """The result of walking the words of a line.

    cmd is the command when the words make one. Otherwise error is set, at is
    the index of the word it points at, and matches lists the keywords of an
    ambiguous prefix. items are what can follow the words.
    """
    cmd: ?Command
    error: ?str
    at: int
    matches: list[str]
    items: list[cpath.Completion]

    def __init__(self, cmd: ?Command, items: list[cpath.Completion]=[], error: ?str=None, at: int=0, matches: list[str]=[]):
        self.cmd = cmd
        self.items = items
        self.error = error
        self.at = at
        self.matches = matches


def _fail(error: ?str, at: int, matches: list[str]=[], items: list[cpath.Completion]=[]) -> _Walk:
    return _Walk(None, items, _msg(error), at, matches)


def _done(cmd: Command, toks: list[cpath.Token], i: int) -> _Walk:
    """Return the command when no words follow it."""
    if i < len(toks):
        return _fail("syntax error.", i)
    return _Walk(cmd, [ENTER])


def _optional_word(cmd: Command, with_word: str, words: list[(str, str)], toks: list[cpath.Token], i: int) -> _Walk:
    """Return the command, renamed with_word when one of words follows it."""
    if i >= len(toks):
        return _Walk(cmd, [ENTER] + _words(words))
    w = _match_word(words, toks[i])
    if w.word is None:
        return _fail(w.error, i, w.matches)
    cmd.name = with_word
    return _done(cmd, toks, i + 1)


def _sub(name: str, sub: _Walk) -> _Walk:
    c = sub.cmd
    if c is not None:
        return _Walk(Command(name, sub=c), sub.items)
    return sub


def _pipe(cmd: Command, pipes: list[(str, str)], toks: list[cpath.Token], p: int, displays: list[(str, str)]=_DISPLAY) -> _Walk:
    """Parse the pipe that starts at word p, with the formats in displays."""
    if p + 1 >= len(toks):
        return _fail("missing argument.", p + 1, items=_words(pipes))
    w = _match_word(pipes, toks[p + 1])
    if w.word is None:
        return _fail(w.error, p + 1, w.matches)
    if w.word == "compare":
        cmd.compare = True
        return _done(cmd, toks, p + 2)
    if p + 2 >= len(toks):
        return _fail("missing argument.", p + 2, items=_words(displays))
    f = _match_word(displays, toks[p + 2])
    fw = f.word
    if fw is not None:
        cmd.display = fw
        return _done(cmd, toks, p + 3)
    return _fail(f.error, p + 2, f.matches)


def _pipe_at(toks: list[cpath.Token], i: int) -> int:
    """Return the index of the first pipe word from word i, or the number of words."""
    for j in range(i, len(toks)):
        if toks[j].is_pipe():
            return j
    return len(toks)


def _path(ctx: Context, toks: list[cpath.Token], i: int, name: str, node: yschema.DNode, data: ?ygdata.Node, edit: list[cpath.Step], pipes: list[(str, str)], values: bool=False, optional: bool=False, need_path: bool=False, view: str="config", displays: list[(str, str)]=_DISPLAY) -> _Walk:
    """Parse a path in a view from word i, then an optional pipe."""
    p = _pipe_at(toks, i)
    r = cpath.complete(ctx.root, node, data, toks[i:p], values, optional, view)
    res = r.path
    err = res.error
    if need_path and p == i:
        return _fail("missing argument.", i, items=r.items)
    if err is not None:
        return _fail(err, i + res.error_at, res.matches, r.items)
    cmd = Command(name, res, edit, view=view)
    if p == len(toks):
        return _Walk(cmd, [ENTER] + r.items + ([PIPE] if len(pipes) > 0 else []))
    if len(pipes) == 0:
        return _fail("syntax error.", p)
    return _pipe(cmd, pipes, toks, p, displays)


def _monitor(ctx: Context, toks: list[cpath.Token], i: int) -> _Walk:
    """Parse `monitor` from word i: `notifications [name ...]`, `stop [name ...]` or `list`."""
    if i >= len(toks):
        return _fail("missing argument.", i, items=_words(_MONITOR))
    w = _match_word(_MONITOR, toks[i])
    word = w.word
    if word is None:
        return _fail(w.error, i, w.matches)
    if word == "list":
        return _done(Command("monitor list"), toks, i + 1)
    names = []
    j = i + 1
    while j < len(toks):
        r = cpath.complete(ctx.root, ctx.root, None, toks[j:], view="notification", stop=True)
        res = r.path
        if res.error is not None:
            return _fail(res.error, j + res.error_at, res.matches, r.items)
        if res.used == 0:
            return _fail("syntax error.", j)
        names.append(res.steps)
        j += res.used
    items = cpath.complete(ctx.root, ctx.root, None, [], view="notification").items
    return _Walk(Command("monitor stop" if word == "stop" else "monitor notifications", args=names), [ENTER] + items)


def notification(root: yschema.DRoot, name: ygdata.Id) -> ?yschema.DNode:
    """Return the top-level notification with a name, or None when the schema does not have it."""
    for c in root.children:
        if isinstance(c, yschema.DNotification) and c.name == name.name and c.namespace == name.q:
            return c
    return None


def notification_name(root: yschema.DRoot, name: ygdata.Id) -> str:
    """Return a notification name as module:name, or with its namespace when the schema does not have it."""
    n = notification(root, name)
    if n is not None:
        return "{n.module}:{n.name}"
    return "{name.name} ({name.q})"


def event_text(root: yschema.DRoot, name: ygdata.Id, event_time: str, payload: ?ygdata.Node, raw: xml.Node) -> str:
    """Return how the CLI shows an event notification.

    The first line has the event time and the notification name. The data
    follows, indented, in curly-brace format. Elements that the schema does
    not describe as data, such as anyxml or a module the CLI does not have,
    follow as XML.
    """
    parts = []
    extra = raw.children
    n = notification(root, name)
    if n is not None:
        if payload is not None:
            parts.append(render.curly(cpath.Position("inner", n, payload), "data"))
        known = set([c.name for c in cpath.candidates(n, "data")])
        extra = [c for c in raw.children if c.tag not in known]
    if len(extra) > 0:
        parts.append(xml.encode_nodes(extra, True))
    lines = ["{event_time}  {notification_name(root, name)}"]
    for part in parts:
        for l in part.split("\n"):
            # A device that indents its XML leaves white space lines.
            if l.strip() != "":
                lines.append(render.INDENT + l.rstrip())
    return "\n".join(lines)


def _show_op(ctx: Context, toks: list[cpath.Token], i: int) -> _Walk:
    """Parse operational mode show from word i: `configuration [path]`, or a path to configuration and state.

    The word configuration wins over a top-level node of the same name. A
    word that is a prefix of configuration and also of a top-level node is
    ambiguous, unless it names that node exactly.
    """
    if i >= len(toks):
        r = cpath.complete(ctx.root, ctx.root, ctx.data, [], view="data")
        return _fail("missing argument.", i, items=_words(_SHOW) + [c for c in r.items if c.value != "configuration"])
    t = toks[i]
    b = _match_word(_SHOW, t)
    bw = b.word
    if bw is not None and t.text != bw and cpath.is_keyword(ctx.root, t, "data"):
        # A top-level node named exactly wins over a prefix of configuration.
        bw = None
    if bw is not None:
        names = []
        if t.text != bw:
            for c in cpath.candidates(ctx.root, "data"):
                if hints.has_keyword(c) and c.name.startswith(t.text) and c.name != bw:
                    names.append(c.name)
        if len(names) == 0:
            return _path(ctx, toks, i + 1, "show configuration", ctx.start, ctx.start_data, [], _PIPE_OP)
        return _fail("'{t.text}' is ambiguous.", i, sorted([bw] + names))
    return _path(ctx, toks, i, "show data", ctx.root, ctx.data, [], _PIPE_OP, need_path=True, view="data", displays=_DISPLAY_DATA)


def _key(prefix: str, n: yschema.DNode) -> str:
    """Return the schema path of a node below a schema path, as the input checks use it."""
    k = "{n.namespace} {n.name}"
    return prefix + "/" + k if prefix != "" else k


def _given(args: list[list[cpath.Step]]) -> set[str]:
    """Return the schema paths of the input nodes that the input paths give, with the containers and list entries on the way."""
    res = set()
    for a in args:
        k = ""
        for st in a:
            k = _key(k, st.node)
            res.add(k)
    return res


def _missing_input(node: yschema.DNode, prefix: str, given: set[str]) -> bool:
    """Return True when a mandatory leaf below an input node is not given.

    The leaves of a container count when the container has no presence or is
    given. The leaves of a list count when an entry is given.
    """
    for c in cpath.candidates(node, "data"):
        k = _key(prefix, c)
        if isinstance(c, yschema.DLeaf):
            if c.mandatory and k not in given:
                return True
        elif isinstance(c, yschema.DContainer):
            if (not c.presence or k in given) and _missing_input(c, k, given):
                return True
        elif isinstance(c, yschema.DList):
            if k in given and _missing_input(c, k, given):
                return True
    return False


def _levels(steps: list[cpath.Step]) -> list[cpath.Step]:
    """Return the containers and list entries at the start of an input path, without the leaf at its end."""
    res = []
    for s in steps:
        if isinstance(s.node, yschema.DContainer) or s.is_entry():
            res.append(s)
        else:
            break
    return res


def _input_path(root: yschema.DRoot, inp: yschema.DNode, levels: list[cpath.Step], toks: list[cpath.Token]) -> (level: int, res: cpath.CompletionResult):
    """Walk an input path from the deepest of levels that takes its first word.

    A level where the first word is the exact name of a child wins, the
    innermost first. Otherwise the walk tries the innermost level and then
    each level above it, up to the input itself, and takes the first that
    accepts a prefix or a value. level is the number of levels the path
    starts below.
    """
    if len(toks) > 0:
        for e in range(len(levels), -1, -1):
            n = cpath.descend(inp, None, levels[:e]).node
            if cpath.is_keyword(n, toks[0], "data"):
                return (level=e, res=cpath.complete(root, n, None, toks, values=True, view="data", stop=True))
    k = len(levels)
    while k > 0:
        a = cpath.complete(root, cpath.descend(inp, None, levels[:k]).node, None, toks, values=True, view="data", stop=True)
        if a.path.error is None or a.path.error_at > 0:
            return (level=k, res=a)
        k -= 1
    return (level=0, res=cpath.complete(root, inp, None, toks, values=True, view="data", stop=True))


def _input_items(root: yschema.DRoot, inp: yschema.DNode, levels: list[cpath.Step]) -> list[cpath.Completion]:
    """Return what can follow an input path: the children at its innermost level, then at each level above it."""
    res = []
    seen = set()
    for k in range(len(levels), -1, -1):
        for c in cpath.complete(root, cpath.descend(inp, None, levels[:k]).node, None, [], values=True, view="data").items:
            if c.text not in seen:
                seen.add(c.text)
                res.append(c)
    return res


def _request(ctx: Context, toks: list[cpath.Token], i: int) -> _Walk:
    """Parse `request` from word i: an RPC, or a path to an action, then input paths and an optional pipe.

    An input path starts in the container where the one before it ended, or
    in a container above that, up to the input of the RPC or action. So
    `request ping host h options ttl 5 df count 3` gives four input paths.
    """
    p = _pipe_at(toks, i)
    r = cpath.complete(ctx.root, ctx.root, ctx.data, toks[i:p], view="request", stop=True)
    res = r.path
    if res.pos.kind != "call":
        if res.error is not None:
            return _fail(res.error, i + res.error_at, res.matches, r.items)
        return _fail("missing argument.", i + res.used, items=r.items)
    inp = cpath.call_part(res.pos.node, "input")
    args = []
    levels: list[cpath.Step] = []
    j = i + res.used
    while j < p:
        if inp is not None:
            w = _input_path(ctx.root, inp, levels, toks[j:p])
            ar = w.res.path
            if ar.error is not None:
                return _fail(ar.error, j + ar.error_at, ar.matches, w.res.items)
            if ar.used == 0:
                return _fail("syntax error.", j)
            steps = levels[:w.level] + ar.steps
            args.append(steps)
            levels = _levels(steps)
            j += ar.used
        else:
            return _fail("syntax error.", j)
    items = []
    missing = False
    if inp is not None:
        items = _input_items(ctx.root, inp, levels)
        missing = _missing_input(inp, "", _given(args))
    if missing:
        return _fail("missing argument.", p, items=items)
    cmd = Command("request", res, view="request", args=args)
    if p == len(toks):
        return _Walk(cmd, [ENTER] + items + [PIPE])
    return _pipe(cmd, _PIPE_OP, toks, p, _DISPLAY_REPLY)


def _edit(ctx: Context, toks: list[cpath.Token], i: int) -> _Walk:
    """Parse `edit <path>`. The path ends at a container or a list entry."""
    w = _path(ctx, toks, i, "edit", ctx.here, ctx.here_data, ctx.edit, [], need_path=True)
    # Leaves are not levels, so completion leaves them out.
    w.items = [c for c in w.items if not c.keyword or c.marker == ">"]
    c = w.cmd
    if c is not None:
        res = c.path
        if res is not None:
            if res.pos.kind == "keys":
                return _fail("missing argument.", len(toks), items=[it for it in w.items if it.text != "<[Enter]>"])
            if res.pos.kind == "end":
                return _fail("syntax error.", i + res.used - 1)
    return w


def _up(toks: list[cpath.Token], i: int) -> _Walk:
    if i >= len(toks):
        return _Walk(Command("up"), [ENTER, cpath.Completion("<number>", " ", "Number of levels to move up", insert=False)])
    n = 0
    try:
        n = int(toks[i].text)
    except ValueError:
        return _fail("'{toks[i].text}' is not a number.", i)
    if n < 1:
        return _fail("'{toks[i].text}' is not a number of levels.", i)
    return _done(Command("up", count=n), toks, i + 1)


def _walk(ctx: Context, toks: list[cpath.Token], i: int, exclude: set[str]=set()) -> _Walk:
    """Walk the words from word i in the context's mode, without the commands in exclude."""
    words = [(w, h) for w, h in (_CONFIG if ctx.mode == "config" else _OP) if w not in exclude]
    if i >= len(toks):
        return _Walk(Command(""), _words(words))
    w = _match_word(words, toks[i])
    word = w.word
    if word is None:
        return _fail(w.error, i, w.matches)
    if ctx.mode == "op":
        if word == "exit" or word == "quit":
            return _done(Command("exit"), toks, i + 1)
        if word == "configure":
            return _done(Command("configure"), toks, i + 1)
        if word == "request":
            return _request(ctx, toks, i + 1)
        if word == "monitor":
            return _monitor(ctx, toks, i + 1)
        return _show_op(ctx, toks, i + 1)
    if word == "set":
        return _path(ctx, toks, i + 1, "set", ctx.here, ctx.here_data, ctx.edit, [], values=True, need_path=True)
    if word == "delete":
        return _path(ctx, toks, i + 1, "delete", ctx.here, ctx.here_data, ctx.edit, [], values=True, optional=True, need_path=True)
    if word == "edit":
        return _edit(ctx, toks, i + 1)
    if word == "show":
        return _path(ctx, toks, i + 1, "show", ctx.here, ctx.here_data, ctx.edit, _PIPE_CONFIG)
    if word == "up":
        return _up(toks, i + 1)
    if word == "top":
        # top runs one configuration command at the top level, but not top or run.
        no = {"top", "run"}
        if i + 1 >= len(toks):
            return _Walk(Command("top"), [ENTER] + _words([(w, h) for w, h in _CONFIG if w not in no]))
        return _sub("top", _walk(ctx.at_top(), toks, i + 1, no))
    if word == "run":
        # run takes the operational mode commands that do not change the mode.
        no = {"configure", "exit", "quit"}
        if i + 1 >= len(toks):
            return _fail("missing argument.", i + 1, items=_words([(w, h) for w, h in _OP if w not in no]))
        return _sub("run", _walk(ctx.op(), toks, i + 1, no))
    if word == "rollback":
        return _optional_word(Command("rollback"), "rollback", _ROLLBACK, toks, i + 1)
    return _optional_word(Command("exit"), "exit configuration-mode", _EXIT, toks, i + 1)


def parse(ctx: Context, line: str) -> ParseResult:
    """Parse one command line."""
    tk = cpath.tokenize(line)
    toks = tk.items
    if tk.open_quote:
        return ParseResult(None, "missing closing quote.", _column(line, toks, len(toks) - 1))
    w = _walk(ctx, toks, 0)
    e = w.error
    if e is not None:
        return ParseResult(None, e, _column(line, toks, w.at), w.matches)
    return ParseResult(w.cmd)


class Reply(object):
    """Completions for the word under the cursor.

    partial is the start of the word under the cursor, and start is the
    character position where that word begins; items are filtered by it. error
    is set when the words before the cursor do not parse; column is then its
    character position.
    """
    items: list[cpath.Completion]
    partial: str
    start: int
    error: ?str
    column: int
    matches: list[str]

    def __init__(self, items: list[cpath.Completion], partial: str, start: int=0, error: ?str=None, column: int=0, matches: list[str]=[]):
        self.items = items
        self.partial = partial
        self.start = start
        self.error = error
        self.column = column
        self.matches = matches


def _matches(c: cpath.Completion, partial: str) -> bool:
    """Return True when a completion starts with the partial word.

    A keyword also matches by its name without the module prefix.
    """
    if c.value.startswith(partial):
        return True
    if c.keyword:
        return c.value[c.value.find(":") + 1:].startswith(partial)
    return False


def complete(ctx: Context, line: str) -> Reply:
    """Return the completions at the end of a line.

    The line is the text up to the cursor. When it does not end in white space,
    its last word is the partial word to complete.
    """
    tk = cpath.tokenize(line)
    if tk.open_quote:
        return Reply([], "", len(line))
    toks = tk.items
    partial = ""
    start = len(line)
    if not tk.trailing and len(toks) > 0:
        partial = toks[-1].text
        start = toks[-1].start
        toks = toks[:-1]
    w = _walk(ctx, toks, 0)
    e = w.error
    if e is not None and not (e == "missing argument." and w.at >= len(toks)):
        return Reply([], partial, start, e, _column(line, toks, w.at), w.matches)
    items = []
    for c in w.items:
        if c.insert:
            if _matches(c, partial):
                items.append(c)
        elif partial == "" or (c.text != "<[Enter]>" and c.text != "|"):
            items.append(c)
    return Reply(items, partial, start)


def help_text(items: list[cpath.Completion], width: int) -> str:
    """Format completions as the `?` help list for a terminal of a width.

    The descriptions start in one column, one space after the longest name that
    has a description. The column is at least 23, as in Junos, but never more
    than half the width. A name that does not fit before the column has its
    description on the next line. A description is cut to fit in width - 1
    columns, so that the terminal does not wrap the line.
    """
    lines = ["Possible completions:"]
    first = []
    by_text = {}
    last = []
    for c in items:
        if c.text == "|":
            last.append(c)
        elif c.text.startswith("<"):
            first.append(c)
        elif c.text not in by_text:
            by_text[c.text] = c
    middle = [by_text[t] for t in sorted(by_text.keys())]
    entries = first + middle + last
    column = 23
    for c in entries:
        if c.help != "" or c.hint != "":
            column = max([column, len("{c.marker} {c.text} ")])
    column = min([column, width // 2])
    room = width - 1 - column
    for c in entries:
        line = "{c.marker} {c.text}"
        if c.help == "" and c.hint == "":
            lines.append(line)
        elif len(line) < column:
            lines.append(line.ljust(column) + c.describe(room))
        else:
            lines.append(line)
            lines.append(" " * column + c.describe(room))
    return "\n".join(lines)


def output(ctx: Context, cmd: Command) -> str:
    """Return the output of a show configuration, show data or show command.

    In operational mode it shows ctx.data: the running configuration, or for
    show data the data the device sent. In configuration mode it shows the
    candidate, or compares it with base.
    """
    pres = cmd.path
    d = ctx.data
    if pres is not None and d is not None:
        steps = cmd.steps()
        if cmd.view == "data":
            if cmd.display == "xml" or cmd.display == "json":
                sub = render.prune([], steps, d)
                if sub is not None:
                    return sub.to_xmlstr(pretty=True) if cmd.display == "xml" else sub.to_yang_jsonstr(pretty=True)
                return ""
            return render.curly(pres.pos, "data")
        if cmd.compare:
            return "\n".join(_compare(ctx, steps, pres.pos))
        if cmd.display == "set":
            return render.set_lines(ctx.start, steps, pres.pos)
        if cmd.display == "xml" or cmd.display == "json":
            sub = render.prune(ctx.root_path, steps, d)
            if sub is not None:
                return sub.to_xmlstr(pretty=True) if cmd.display == "xml" else sub.to_yang_jsonstr(pretty=True)
            return ""
        return render.curly(pres.pos)
    return ""


class Applied(object):
    """The result of a configuration mode command.

    edit is the new edit level, back the new list of levels that exit returns
    to, text the output to print, and leave is True when the command leaves
    configuration mode.
    """
    edit: list[cpath.Step]
    back: list[list[cpath.Step]]
    text: str
    leave: bool

    def __init__(self, edit: list[cpath.Step], back: list[list[cpath.Step]], text: str="", leave: bool=False):
        self.edit = edit
        self.back = back
        self.text = text
        self.leave = leave


def apply(ctx: Context, cand: candidate.Candidate, cmd: Command) -> Applied:
    """Run a configuration mode command on the candidate at the context's edit level.

    run, configure and show configuration need the device, so the caller runs
    them.
    """
    n = cmd.name
    edit = ctx.edit
    back = ctx.back
    if n == "show":
        return Applied(edit, back, output(ctx, cmd))
    if n == "edit":
        return Applied(cmd.steps(), back + [edit])
    if n == "up":
        return Applied(edit[:len(edit) - cmd.count] if cmd.count < len(edit) else [], back)
    if n == "top":
        sub = cmd.sub
        if sub is not None:
            r = apply(ctx.at_top(), cand, sub)
            # A command run at the top keeps the edit level, unless it moves.
            if sub.name in {"edit", "up", "exit", "exit configuration-mode"}:
                return r
            return Applied(edit, back, r.text, r.leave)
        return Applied([], back)
    if n == "exit":
        if len(back) > 0:
            return Applied(back[-1], back[:-1])
        if len(edit) > 0:
            return Applied([], [])
        return Applied([], [], leave=True)
    if n == "exit configuration-mode":
        return Applied([], [], leave=True)
    if n == "rollback":
        cand.rollback()
        return Applied(edit, back, "load complete")
    steps = [cpath.Step(r) for r in ctx.root_path] + cmd.steps()
    if n == "set":
        cand.set(steps)
    elif n == "delete":
        if not cand.delete(steps):
            return Applied(edit, back, "warning: statement not found")
    return Applied(edit, back)


def refresh(ctx: Context, cmd: Command) -> Command:
    """Return the command with its path resolved again against the context's data."""
    p = cmd.path
    if p is not None:
        start: yschema.DNode = ctx.root
        data = ctx.data
        if cmd.view == "config":
            h = cpath.descend(ctx.start, ctx.start_data, cmd.edit)
            start = h.node
            data = h.data
        words = cpath.path_tokens(start, p.steps, cmd.view)
        res = cpath.resolve(ctx.root, start, data, cpath.tokenize(" ".join(words)).items, view=cmd.view)
        c = Command(cmd.name, res, cmd.edit, cmd.count, cmd.sub, cmd.view, cmd.args)
        c.display = cmd.display
        c.compare = cmd.compare
        return c
    return cmd


def subtree_filter(steps: list[cpath.Step]) -> ygdata.FNode:
    """Return the subtree filter that selects the data at the end of a path from the schema root.

    A list entry on the path matches its key values.
    """
    inner: list[ygdata.FNode] = []
    for k in range(len(steps) - 1, -1, -1):
        s = steps[k]
        n = s.node
        kids = []
        if isinstance(n, yschema.DList) and len(s.keys) > 0:
            kl = hints.key_leaves(n)
            for j in range(len(s.keys)):
                kids.append(ygdata.FNode(ygdata.Id(kl[j].namespace, kl[j].name), value_match=s.keys[j]))
        inner = [ygdata.FNode(ygdata.Id(n.namespace, n.name), children=kids + inner)]
    return ygdata.FNode(children=inner)


def _schema_order(inp: yschema.DNode, steps: list[cpath.Step]) -> list[int]:
    """Return the position of each node of an input path among the schema children of its parent."""
    res = []
    parent = inp
    for st in steps:
        idx = 0
        if isinstance(parent, yschema.DNodeInner):
            for j in range(len(parent.children)):
                c = parent.children[j]
                if c.name == st.node.name and c.namespace == st.node.namespace:
                    idx = j
                    break
        res.append(idx)
        parent = st.node
    return res


def _before(a: list[int], b: list[int]) -> bool:
    """Return True when schema position a comes before b."""
    for j in range(min([len(a), len(b)])):
        if a[j] != b[j]:
            return a[j] < b[j]
    return len(a) < len(b)


def _in_schema_order(inp: yschema.DNode, args: list[list[cpath.Step]]) -> list[list[cpath.Step]]:
    """Return the input paths in schema order, which RFC 7950 asks for in RPC and action input.

    Paths at the same position keep the order the user gave them in.
    """
    keyed = [(_schema_order(inp, a), a) for a in args]
    res = []
    for ka in keyed:
        j = len(res)
        while j > 0 and _before(ka.0, res[j - 1].0):
            j -= 1
        res.insert(j, ka)
    return [a for _, a in res]


def request_xml(root: yschema.DRoot, cmd: Command) -> xml.Node:
    """Return the XML that a request command sends: the RPC element, or the action element around the data path.

    The input shows in schema order.
    """
    res = cmd.path
    if res is not None:
        steps = res.steps
        if len(steps) > 0:
            tree = candidate.with_path(root, ygdata.Container({}), steps)
            args = cmd.args
            inp = cpath.call_part(steps[-1].node, "input")
            if inp is not None:
                args = _in_schema_order(inp, args)
            for a in args:
                tree = candidate.with_path(root, tree, steps + a)
            elems = tree.to_xml()
            if isinstance(steps[-1].node, yschema.DAction):
                return xml.Node("action", nsdefs=[(None, netconf.NS_YANG_ACTION)], children=elems)
            return elems[0]
    raise ValueError("no RPC or action")


def reply_text(root: yschema.DRoot, cmd: Command, reply: xml.Node) -> str:
    """Return what a request command shows for the device's reply.

    With `| display xml` it is the XML inside the reply. Otherwise it is the
    output in curly-brace format, and nothing for an ok reply. Output that the
    output schema does not describe, such as anyxml, shows as the XML inside
    the reply. Raise an exception when the output does not fit the schema.
    """
    if cmd.display != "xml" and netconf.is_ok_reply(reply):
        return ""
    res = cmd.path
    if cmd.display != "xml" and res is not None and len(res.steps) > 0:
        o = cpath.call_part(res.steps[-1].node, "output")
        if o is not None:
            path = ["{s.node.module}:{s.node.name}" for s in res.steps] + ["output"]
            d = yxml.from_xml(root, reply, loose=True, root_path=path)
            text = render.curly(cpath.Position("inner", o, d), "data")
            if text != "":
                return text
    return xml.encode_nodes(reply.children, True)


def _compare(ctx: Context, steps: list[cpath.Step], pos: cpath.Position) -> list[str]:
    base_start = cpath.descend(ctx.root, ctx.base, [cpath.Step(n) for n in ctx.root_path]).data
    old = cpath.descend(ctx.start, base_start, steps).data
    if pos.kind == "inner" and (len(steps) == 0 or (old is not None and pos.data is not None)):
        return candidate.compare(ctx.start, steps, pos.node, old, pos.data)
    # At a list, a leaf, or a node that only one side has, compare that one
    # child of its parent, so an added or removed node shows as a whole.
    last = steps[-1]
    parent_steps = steps[:-1]
    old_parent = cpath.descend(ctx.start, base_start, parent_steps)
    new_parent = cpath.descend(ctx.start, ctx.start_data, parent_steps)
    entry: ?list[value] = last.keys if pos.kind == "inner" and len(last.keys) > 0 else None
    return candidate.compare(ctx.start, parent_steps, old_parent.node, old_parent.data, new_parent.data, last.node, entry)
