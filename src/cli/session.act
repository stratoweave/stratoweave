"""Interactive CLI session for one device.

The session owns the line editor and a DeviceMgr for the device. Key presses
and device replies arrive as messages, and every device request has a timeout,
so a slow device never stops the editor.

`show <path>` reads configuration and state with a NETCONF get, and `request`
sends an RPC, or an action inside an action element. `monitor notifications`
subscribes to event notifications, and each one prints above the prompt as
it arrives. `monitor <path>` subscribes to the data at a path with YANG-push
and shows it in a pane above the CLI, which keeps the rows below the panes.
As a one-shot command, it uses the whole terminal for the data.

`configure` starts a candidate configuration from the running configuration,
if there is none with changes yet. The candidate lives in the session: it
stays when the user leaves configuration mode, and goes when the CLI exits.

Without a terminal on both stdin and stdout, the session reads commands line
by line from stdin and prints only their output. A command script ends with
`exit`, after `exit configuration-mode` when it is in configuration mode. A
command given as arguments runs alone, and the CLI exits after it.
"""

import std.argparse
import std.xml as xml
import file
import logging
import time

import yang.schema as yschema
import yang.gdata as ygdata

import adapters.adapter as swadapter
import adapters.netconf as swna
import device as swdev
import netconf
import yang_dir as local_yang
from device_meta_config import \
    stratoweave_rfs__device_entry as DeviceMetaConfig, \
    stratoweave_rfs__device__credentials as Credentials, \
    stratoweave_rfs__device__ssh as DeviceMetaConfigSsh

import cli.candidate as candidate
import cli.command as command
import cli.lineedit as lineedit
import cli.pane as pane
import cli.path as cpath


# The owner name of the CLI's notification subscriptions on the DeviceMgr.
NOTIF_OWNER = "ncurl-cli"


def pane_owner(number: int) -> str:
    """Return the owner name of the subscription of a pane on the DeviceMgr."""
    return "ncurl-cli-pane-{number}"


def clock() -> str:
    """Return the time of day as hours, minutes and seconds."""
    t = time.now()
    return f"{t.hour:02d}:{t.minute:02d}:{t.second:02d}"


class Monitor(object):
    """A pane that shows the data at a path as the device sends it.

    gen tells the subscriptions of a pane number apart, so an update for a
    pane that was replaced is dropped. title is how often the data comes and
    the path. lines holds the last data shown, and changed the lines that
    differed from the update before.
    """
    number: int
    gen: int
    cmd: command.Command
    title: str
    updates: int
    when: str
    lines: list[str]
    changed: set[int]
    error: ?str

    def __init__(self, number: int, gen: int, cmd: command.Command, title: str):
        self.number = number
        self.gen = gen
        self.cmd = cmd
        self.title = title
        self.updates = 0
        self.when = ""
        self.lines = []
        self.changed = set()
        self.error = None

    def header(self) -> str:
        """Return the header line of the pane: the pane number and state first, then the path, which a narrow terminal cuts."""
        h = " pane {self.number}  "
        if self.updates > 0:
            h += "{self.updates} updates, last {self.when}"
        else:
            h += "waiting for data"
        e = self.error
        if e is not None:
            h += ", error: " + e
        return h + "  " + self.title

# Terminal sequences that turn bracketed paste on and off.
BRACKETED_PASTE_ON = "\x1b[?2004h"
BRACKETED_PASTE_OFF = "\x1b[?2004l"


class EditorSink(logging.Sink):
    """Send log lines to the CLI session, which prints them above the prompt."""
    @property
    on_line: action(str) -> None

    def __init__(self, on_line: action(str) -> None):
        self.formatter = logging.DefaultFormatter()
        self.on_line = on_line

    def handle(self, m: logging.Message):
        text = self.formatter.format(m)
        if text is not None:
            data = m.data
            if data is not None:
                text += " - " + str(data)
            self.on_line(text)


def common_prefix(words: list[str]) -> str:
    """Return the longest common prefix of some words."""
    if len(words) == 0:
        return ""
    res = words[0]
    for w in words[1:]:
        n = 0
        while n < len(res) and n < len(w) and res[n] == w[n]:
            n += 1
        res = res[:n]
    return res


actor CliSession(env: Env, args: std.argparse.Args, log_handler: logging.Handler, credentials: Credentials, ssh: DeviceMetaConfigSsh):
    """Run the CLI against the device that the global options name, with the given credentials and SSH settings."""
    host = args.get_str("host")
    port = args.get_int("port")
    username = args.get_str("username")
    yang_dir = args.get_str("yang-dir")
    modules = args.get_strlist("module")
    module_sets = args.get_strlist("module-set")
    timeout = float(args.get_int("timeout"))
    oneshot = args.get_strlist("command")
    var interactive = False
    op_prompt = "{username}@{host}> "
    config_prompt = "{username}@{host}# "
    editor = lineedit.LineEditor(op_prompt)
    decoder = lineedit.KeyDecoder()

    var local_schema: ?yschema.DRoot = None
    var schema: ?yschema.DRoot = None
    var running: ?ygdata.Node = None
    var cand: ?candidate.Candidate = None
    var mode = "op"
    var edit: list[cpath.Step] = []
    var back: list[list[cpath.Step]] = []
    var confirm = False
    var dev: ?swdev.DeviceMgr = None
    var ready = False
    var busy = False
    var done = False
    var failed = False
    var pending_keys: list[lineedit.Key] = []
    var lines: list[str] = []
    var partial_line = b""
    var esc_gen = 0
    var req_id = 0
    var pending: ?command.Command = None
    var notif_specs: set[swadapter.NotifSpec] = set()
    var notif_warning: ?str = None
    var monitors: list[Monitor] = []
    var monitor_gen = 0
    var screen = False
    var rows = 24
    var cols = 80
    var areas: list[pane.Area] = []
    var size_gen = 0

    def out(text: str):
        print(text, end="", flush=True)

    def say(text: str):
        """Print a message line: on stdout in the interactive CLI, else on stderr."""
        if interactive:
            out(text + "\n")
        else:
            print(text, err=True)

    def finish(code: int):
        if not done:
            done = True
            d = dev
            if d is not None and len(notif_specs) > 0:
                d.remove_notif_subscriptions(NOTIF_OWNER)
            if d is not None:
                for m in monitors:
                    d.remove_subscriptions(pane_owner(m.number))
            if interactive:
                if len(areas) > 0:
                    # The shell gets the whole terminal back, below the panes.
                    out(pane.reset_region() + "\x1b[{rows};1H\n")
                out(BRACKETED_PASTE_OFF)
            env.exit(code)

    def fail(msg: str):
        say("error: " + msg)
        failed = True

    def show_error(line: str, column: int, msg: str, matches: list[str]):
        if interactive:
            out(" " * (len(editor.prompt) + column) + "^\n")
        else:
            print(line, err=True)
            print(" " * column + "^", err=True)
            failed = True
        say(msg)
        if len(matches) > 0:
            say("Possible completions:")
            for m in matches:
                say("  " + m)

    def make_ctx() -> ?command.Context:
        """Return the command context for the current mode and edit level."""
        s = schema
        if s is not None:
            c = cand
            if mode == "config" and c is not None:
                return command.Context(s, c.data, "config", edit, c.base, running, back)
            return command.Context(s, running)
        return None

    def banner() -> str:
        c = make_ctx()
        if c is not None:
            words = cpath.path_tokens(c.start, edit)
            if len(words) > 0:
                return "[edit " + " ".join(words) + "]"
        return "[edit]"

    def prompt():
        """Show the prompt, then handle the keys or lines that wait."""
        if done or busy:
            return
        if interactive:
            if mode == "config" and not confirm:
                out("\n" + banner() + "\n")
            out(editor.render())
            while not busy and not done and len(pending_keys) > 0:
                handle_key(pending_keys.pop(0))
        elif len(lines) > 0:
            execute(lines.pop(0))
        elif len(oneshot) > 0 and len(notif_specs) == 0 and len(monitors) == 0:
            # A one-shot monitor runs until it is interrupted.
            finish(1 if failed else 0)

    def enter_config():
        mode = "config"
        edit = []
        back = []
        editor.set_prompt(config_prompt)
        say("Entering configuration mode")
        c = cand
        if c is not None and c.changed():
            say("The candidate configuration has changes that are not committed")

    def leave_config():
        mode = "op"
        edit = []
        back = []
        editor.set_prompt(op_prompt)
        say("Exiting configuration mode")

    def leave_cli():
        """Exit, after the user confirms when the candidate has changes."""
        c = cand
        if c is not None and c.changed():
            if interactive:
                confirm = True
                editor.set_prompt("Discard uncommitted changes? [yes,no] (no) ")
                return
            say("warning: discarding uncommitted changes")
        finish(1 if failed else 0)

    def execute(line: str):
        if confirm:
            confirm = False
            editor.set_prompt(config_prompt if mode == "config" else op_prompt)
            if line.strip() in {"yes", "y"}:
                finish(1 if failed else 0)
                return
        else:
            c = make_ctx()
            if c is not None:
                r = command.parse(c, line)
                e = r.error
                cmd = r.cmd
                if e is not None:
                    show_error(line, r.column, e, r.matches)
                elif cmd is not None:
                    run_command(c, cmd)
                    return
        prompt()

    def run_command(c: command.Context, cmd: command.Command):
        """Run a parsed command, then show the prompt unless the command waits for the device."""
        n = cmd.name
        ca = cand
        fresh = True
        if ca is not None and n == "configure":
            fresh = not ca.changed()
        if n == "show configuration" or (n == "configure" and fresh):
            pending = cmd
            fetch()
            return
        if n == "show data":
            get(cmd)
            return
        if n == "request":
            call(cmd)
            return
        if n == "monitor notifications":
            monitor_notifications(cmd)
        elif n == "monitor data":
            monitor_data(cmd)
        elif n == "monitor stop":
            monitor_stop(cmd)
        elif n == "monitor stop pane":
            close_pane(cmd.pane, True)
        elif n == "monitor list":
            monitor_list()
        if n == "configure":
            enter_config()
        elif n == "exit" and c.mode == "op":
            leave_cli()
        elif n == "run":
            sub = cmd.sub
            if sub is not None:
                run_command(c.op(), sub)
                return
        elif ca is not None and c.mode == "config":
            r = command.apply(c, ca, cmd)
            edit = r.edit
            back = r.back
            if r.text != "":
                if interactive:
                    out(r.text + "\n")
                else:
                    print(r.text)
            if r.leave:
                leave_config()
        prompt()

    def fetch():
        """Read the running configuration; on_fetch gets the reply."""
        d = dev
        if d is not None:
            busy = True
            req_id += 1
            n = req_id
            d.fetch_config(lambda data, e: self.on_fetch(n, data, e))
            after timeout: fetch_timeout(n)

    def fetch_timeout(n: int):
        if busy and n == req_id:
            busy = False
            req_id += 1
            if not ready:
                fail("no configuration from {host}:{port} within {int(timeout)} seconds")
                finish(1)
                return
            fail("no reply from the device within {int(timeout)} seconds")
            prompt()

    def on_fetch(n: int, data: ?ygdata.Node, e: ?Exception):
        if not busy or n != req_id:
            return
        busy = False
        s = schema
        p = pending
        pending = None
        if e is not None:
            fail("cannot read the configuration: {e}")
            if not ready:
                finish(1)
                return
        elif s is not None:
            running = data
            if ready and p is not None:
                if p.name == "configure":
                    cand = candidate.Candidate(s, data)
                    enter_config()
                else:
                    show_running(command.Context(s, data), p)
            ready = True
        prompt()

    def show_text(text: str):
        """Print the output of a command."""
        if text != "":
            if interactive:
                out(text + "\n")
            else:
                print(text)

    def show_running(c: command.Context, cmd: command.Command):
        """Print a show configuration command against freshly read running configuration."""
        show_text(command.output(c, command.refresh(c, cmd)))

    def get(cmd: command.Command):
        """Read the data at the command's path from the device; on_get gets the reply."""
        d = dev
        res = cmd.path
        if d is not None and res is not None:
            busy = True
            req_id += 1
            n = req_id
            d.get(lambda data, e: self.on_get(n, cmd, data, e), command.subtree_filter(res.steps))
            after timeout: fetch_timeout(n)

    def on_get(n: int, cmd: command.Command, data: ?ygdata.Node, e: ?Exception):
        if not busy or n != req_id:
            return
        busy = False
        s = schema
        if e is not None:
            fail("cannot read the data: {device_error(e)}")
        elif s is not None:
            c = command.Context(s, data)
            show_text(command.output(c, command.refresh(c, cmd)))
        prompt()

    def call(cmd: command.Command):
        """Send the RPC or action of a request command; on_call gets the reply."""
        d = dev
        s = schema
        if d is not None and s is not None:
            try:
                x = command.request_xml(s, cmd)
                busy = True
                req_id += 1
                n = req_id
                d.rpc_xml(lambda r, e: self.on_call(n, cmd, r, e), x)
                after timeout: fetch_timeout(n)
                return
            except Exception as e:
                fail("cannot build the request: {e}")
        prompt()

    def on_call(n: int, cmd: command.Command, r: ?xml.Node, e: ?Exception):
        if not busy or n != req_id:
            return
        busy = False
        s = schema
        if e is not None:
            fail(device_error(e))
        elif r is not None and s is not None:
            try:
                show_text(command.reply_text(s, cmd, r))
            except Exception as x:
                fail("cannot decode the reply: {x}")
                show_text(xml.encode_nodes(r.children, True))
        prompt()

    def show_event(text: str, message: bool=False):
        """Print text that arrives on its own, such as a notification, above the prompt and the line being typed.

        Without a terminal, a message goes to stderr and a notification to
        stdout.
        """
        if interactive and ready and not busy and not done:
            out(editor.hide() + text + "\n" + editor.render())
        elif interactive:
            out(text + "\n")
        else:
            print(text, err=message)

    def declare_notifs():
        """Subscribe to the notifications in notif_specs, or to none when it is empty."""
        d = dev
        if d is not None:
            if len(notif_specs) > 0:
                d.declare_notif_subscriptions(NOTIF_OWNER, on_notif, notif_specs, on_notif_synced)
            else:
                d.remove_notif_subscriptions(NOTIF_OWNER)

    def monitor_notifications(cmd: command.Command):
        """Add the command's notifications, or all notifications, to the ones the CLI shows."""
        specs = set(notif_specs)
        if len(cmd.args) == 0:
            specs.add(swadapter.NotifSpec())
        for a in cmd.args:
            n = a[0].node
            specs.add(swadapter.NotifSpec(ygdata.Id(n.namespace, n.name)))
        notif_specs = specs
        declare_notifs()

    def monitor_stop(cmd: command.Command):
        """Stop showing the command's notifications, or all notifications and close all panes.

        While the CLI shows all notifications, a name does not stop one of
        them, and the CLI says so.
        """
        if len(cmd.args) == 0:
            notif_specs = set()
            for m in list(monitors):
                close_pane(m.number, False)
        else:
            drop = set(["{a[0].node.namespace} {a[0].node.name}" for a in cmd.args])
            specs = set()
            wildcard = False
            for sp in notif_specs:
                nm = sp.name
                if nm is not None:
                    if "{nm.q} {nm.name}" not in drop:
                        specs.add(sp)
                else:
                    wildcard = True
                    specs.add(sp)
            if wildcard:
                say("warning: the CLI shows all notifications; monitor stop without names stops them")
            elif len(specs) == len(notif_specs):
                say("warning: the CLI does not show these notifications")
            if len(specs) == len(notif_specs):
                return
            notif_specs = specs
        declare_notifs()

    def monitor_list():
        """Print the panes, the notifications the CLI shows and the device channels they come on."""
        s = schema
        d = dev
        rows_out = []
        for m in monitors:
            rows_out.append(m.header().strip())
        if len(notif_specs) == 0:
            rows_out.append("No notifications are shown")
            show_text("\n".join(rows_out))
            return
        names = []
        for sp in notif_specs:
            nm = sp.name
            if nm is not None:
                if s is not None:
                    names.append(command.notification_name(s, nm))
            else:
                names.append("all notifications")
        rows_out.extend(sorted(names))
        if d is not None:
            for c in d.notif_status():
                rows_out.append("channel " + c.description())
        show_text("\n".join(rows_out))

    def monitor_data(cmd: command.Command):
        """Show the data at the command's path in a pane, as the device sends it.

        The pane is the one the command names, or the first free one. A pane
        that is open gets the new path.
        """
        s = schema
        d = dev
        res = cmd.path
        if s is not None and d is not None and res is not None:
            number = cmd.pane
            if number == 0:
                used = set([m.number for m in monitors])
                for k in range(1, pane.MAX_PANES + 1):
                    if k not in used:
                        number = k
                        break
            if number == 0:
                fail("every pane is in use; close one with monitor stop pane N")
                return
            monitor_gen += 1
            g = monitor_gen
            how = "on change" if cmd.on_change else "every {cmd.period} s"
            title = how + "  " + " ".join(cpath.path_tokens(s, res.steps, "data"))
            m = Monitor(number, g, cmd, title)
            if find_monitor(number) is not None:
                # A new subscription sends its data again, also for the same path.
                d.remove_subscriptions(pane_owner(number))
            kept = [x for x in monitors if x.number != number]
            kept.append(m)
            monitors = sorted_monitors(kept)
            filt = command.subtree_filter(res.steps)
            spec = ygdata.SubscriptionSpec(filt, on_change=True) if cmd.on_change else ygdata.SubscriptionSpec(filt, period=float(cmd.period))
            d.declare_subscriptions(pane_owner(number), lambda t, e: self.on_pane(number, g, t, e), {spec})
            if interactive:
                relayout(False)
            elif screen:
                draw_screen(m)

    def close_pane(number: int, warn: bool):
        """Stop the subscription of a pane and close it."""
        d = dev
        m = find_monitor(number)
        if m is None:
            if warn:
                say("warning: pane {number} is not open")
            return
        if d is not None:
            d.remove_subscriptions(pane_owner(number))
        monitors = [x for x in monitors if x.number != number]
        if interactive:
            relayout(False)

    def find_monitor(number: int) -> ?Monitor:
        for m in monitors:
            if m.number == number:
                return m
        return None

    def sorted_monitors(ms: list[Monitor]) -> list[Monitor]:
        """Return the monitors in pane number order."""
        res = []
        for k in range(1, pane.MAX_PANES + 1):
            for m in ms:
                if m.number == k:
                    res.append(m)
        return res

    def on_pane(number: int, g: int, tree: ?ygdata.Node, e: ?Exception):
        """Show an update of the data of a pane."""
        m = find_monitor(number)
        s = schema
        if m is not None and s is not None:
            if done or m.gen != g:
                return
            if e is not None:
                m.error = device_error(e).replace("\n", " ")
            elif tree is not None:
                c = command.Context(s, tree)
                text = command.output(c, command.refresh(c, m.cmd))
                new = text.split("\n") if text != "" else []
                m.changed = pane.changed_lines(m.lines, new)
                m.lines = new
                m.updates += 1
                m.when = clock()
                m.error = None
            if interactive:
                draw_pane(m)
            elif screen:
                draw_screen(m)
            elif e is not None:
                print("{clock()}  pane {m.number}  {m.title}  error: {m.error}", err=True)
            elif tree is not None:
                print("{m.when}  pane {m.number}  {m.title}")
                for l in m.lines:
                    print(pane.INDENT_TEXT + l)

    def draw_pane(m: Monitor):
        """Draw a pane in its area, when the panes fit in the terminal."""
        for k in range(len(monitors)):
            if monitors[k].number == m.number and k < len(areas):
                out(pane.frame(areas[k], cols, m.header(), m.lines, m.changed))

    def draw_screen(m: Monitor):
        """Draw the data of a one-shot monitor over the terminal, with the cursor on the last row."""
        r0 = rows
        size_now()
        clear = ""
        if len(areas) == 0 or r0 != rows:
            clear = "\x1b[2J"
        areas = [pane.Area(1, rows - 1)]
        out(clear + pane.frame(areas[0], cols, m.header(), m.lines, m.changed) + "\x1b[{rows};1H")

    def size_now():
        """Read the terminal size, or keep the last one when there is no terminal."""
        sz = env.stdio.term_size()
        if sz is not None:
            cols = sz.columns
            rows = sz.rows

    def relayout(redraw_line: bool):
        """Place the panes above the CLI and limit the CLI's scrolling to the rows below them.

        The terminal is cleared, and the CLI starts again on the last row.
        Without panes, the whole terminal scrolls again.
        """
        size_now()
        had = len(areas) > 0
        areas = pane.layout(rows, len(monitors))
        if len(areas) == 0:
            if had or redraw_line:
                out(pane.reset_region() + "\x1b[2J\x1b[{rows};1H")
            if len(monitors) > 0:
                say("warning: the terminal has too few rows for {len(monitors)} panes")
        else:
            out("\x1b[2J" + pane.scroll_region(pane.cli_top(areas), rows) + "\x1b[{rows};1H")
            for m in monitors:
                draw_pane(m)
        if len(monitors) > 0:
            # The panes come back when a terminal that was too small grows.
            size_gen += 1
            g = size_gen
            after 1.0: check_size(g)
        if redraw_line and ready and not busy and not done:
            out(editor.render())

    def check_size(g: int):
        """Place the panes again when the terminal size changes, once a second while panes are open."""
        if done or g != size_gen or len(monitors) == 0:
            return
        r0 = rows
        c0 = cols
        size_now()
        if rows != r0 or cols != c0:
            relayout(True)
        else:
            after 1.0: check_size(g)

    def on_notif(ev: ?swadapter.NotifEvent, err: ?Exception):
        # An event or warning can still arrive after monitor stop.
        if done or len(notif_specs) == 0:
            return
        if err is not None:
            # A channel that stays down reports the same error at each retry.
            w = str(err)
            if w != notif_warning:
                notif_warning = w
                show_event("warning: {w}; notifications can be missing until the channel recovers", True)
            return
        s = schema
        if ev is not None and s is not None and swadapter.notif_want_matches(notif_specs, ev.name):
            notif_warning = None
            show_event(command.event_text(s, ev.name, ev.event_time, ev.payload, ev.raw))

    def on_notif_synced(owner: str):
        d = dev
        if d is not None and not done and len(notif_specs) > 0:
            notif_warning = None
            show_event("Listening for notifications on " + ", ".join([c.description() for c in d.notif_status()]), True)

    def device_error(e: Exception) -> str:
        """Return the messages of the errors in a device reply, or the exception text."""
        if isinstance(e, netconf.NetconfError):
            errs = e.rpc_error
            if errs is not None and len(errs) > 0:
                msgs = []
                for x in errs:
                    m = x.error_message
                    msgs.append(m.strip() if m is not None else x.error_tag)
                return "; ".join(msgs)
        return str(e)

    def on_reconf(name: str):
        if schema is not None or done:
            return
        d = dev
        if d is not None:
            ls = local_schema
            s = ls if ls is not None else d.get_fetched_schema()
            if s is not None:
                schema = s
                if interactive:
                    # Completion offers the keys in the running configuration.
                    fetch()
                else:
                    # Each show command reads the configuration itself.
                    ready = True
                    prompt()
            else:
                fail("no schema for {host}:{port}; use --yang-dir")
                finish(1)

    def connect_timeout():
        if schema is None:
            fail("cannot connect to {host}:{port} within {int(timeout)} seconds")
            finish(1)

    def log_line(text: str):
        if interactive and ready and not busy and not done:
            out(editor.hide() + text + "\n" + editor.render())
        else:
            print(text, err=True)

    def complete_line(suffix: str="") -> ?command.Reply:
        """Return completions for the text before the cursor, or None inside an open quote.

        suffix is added to the text, so a space completes the next word.
        """
        c = make_ctx()
        if c is not None and not confirm:
            text = editor.line()[:editor.cursor()] + suffix
            if cpath.tokenize(text).open_quote:
                return None
            return command.complete(c, text)
        return None

    def echo_line(line: str):
        """Print the prompt and the whole line, so an error caret below it lines up."""
        out("\r" + editor.prompt + line + "\x1b[0K\n")

    def show_reply_error(reply: command.Reply) -> bool:
        e = reply.error
        if e is not None:
            echo_line(editor.line())
            show_error("", reply.column, e, reply.matches)
            return True
        return False

    def quoted_end() -> bool:
        """Return True when the cursor is right after a closed quoted word."""
        tk = cpath.tokenize(editor.line()[:editor.cursor()])
        return not tk.open_quote and not tk.trailing and len(tk.items) > 0 and tk.items[-1].quoted

    def replace_word(reply: command.Reply, text: str):
        """Replace the word under the cursor with text."""
        line = editor.line()
        editor.set_line(line[:reply.start] + text + line[editor.cursor():], reply.start + len(text))

    def on_help():
        reply = complete_line(" " if quoted_end() else "")
        if reply is not None:
            if not show_reply_error(reply):
                out("\n" + command.help_text(reply.items) + "\n")
        else:
            editor.insert("?")
        out(editor.render())

    def on_complete():
        if quoted_end():
            editor.insert(" ")
            out(editor.render())
            return
        reply = complete_line()
        if reply is not None and not show_reply_error(reply):
            words = []
            for i in reply.items:
                if i.insert and i.text not in words:
                    words.append(i.text)
            if len(words) == 1:
                replace_word(reply, words[0] + " ")
            else:
                p = common_prefix(words)
                if len(p) > len(reply.partial) and p.startswith(reply.partial):
                    replace_word(reply, p)
                elif len(reply.items) > 0:
                    out("\n" + command.help_text(reply.items) + "\n")
        out(editor.render())

    def on_space():
        reply = complete_line()
        if reply is not None and reply.error is None and reply.partial != "" and not quoted_end():
            words = []
            for i in reply.items:
                if i.keyword and i.text not in words:
                    words.append(i.text)
            if len(words) == 1 and words[0] != reply.partial:
                replace_word(reply, words[0] + " ")
                out(editor.render())
                return
        editor.insert(" ")
        out(editor.render())

    def handle_key(k: lineedit.Key):
        r = editor.key(k)
        kind = r.kind
        if kind == "submit":
            echo_line(r.line)
            if not confirm:
                editor.add_history(r.line)
            editor.reset()
            execute(r.line)
        elif kind == "eof":
            out("\n")
            if confirm:
                # Ctrl-D answers no.
                execute("no")
                return
            if mode == "config":
                leave_config()
            else:
                leave_cli()
            prompt()
        elif kind == "interrupt":
            out("\n")
            editor.reset()
            if confirm:
                # Ctrl-C answers no.
                execute("no")
                return
            prompt()
        elif kind == "complete":
            on_complete()
        elif kind == "help":
            on_help()
        elif kind == "space":
            on_space()
        elif kind == "clear":
            if len(monitors) > 0:
                relayout(True)
            else:
                out("\x1b[H\x1b[2J" + editor.render())
        else:
            out(editor.render())

    def interrupt():
        """Stop waiting on Ctrl-C: exit while connecting, else drop the
        request in flight and the keys typed ahead."""
        out("\n")
        if not ready:
            finish(1)
            return
        busy = False
        req_id += 1
        pending = None
        pending_keys = []
        prompt()

    def on_key(k: lineedit.Key):
        if done:
            return
        if not ready or busy:
            if k.name == "ctrl-c":
                interrupt()
            else:
                pending_keys.append(k)
        else:
            handle_key(k)

    def esc_timeout(gen: int):
        if gen == esc_gen and not done:
            for k in decoder.flush():
                on_key(k)

    def on_bytes(data: bytes):
        if done:
            return
        if interactive:
            for k in decoder.feed(data):
                on_key(k)
            if decoder.pending():
                esc_gen += 1
                g = esc_gen
                after 0.05: esc_timeout(g)
        else:
            # TODO: upstream EOF delivery to Acton's Env.
            parts = (partial_line + data).split(b"\n")
            partial_line = parts[-1]
            for p in parts[:-1]:
                try:
                    lines.append(p.decode().rstrip("\r"))
                except ValueError:
                    fail("input is not valid UTF-8")
            if ready and not busy:
                prompt()

    def start():
        # Take stdin before the YANG load, so keys typed during it wait for
        # the prompt.
        if len(oneshot) > 0:
            lines.append(" ".join(oneshot))
        else:
            env.stdio.stdin_install(on_stdin_bytes=on_bytes)
            if interactive:
                env.stdio.set_stdin(raw=True)
                # The terminal marks pasted text, so the line editor inserts
                # it as it is.
                out(BRACKETED_PASTE_ON)
        try:
            if yang_dir != "":
                local_schema = local_yang.load(file.FileCap(env.cap), yang_dir, modules, module_sets)
        except Exception as e:
            fail("cannot load --yang-dir {yang_dir}: {e}")
            finish(1)
            return
        if yang_dir == "" and (len(modules) > 0 or len(module_sets) > 0):
            fail("--module and --module-set need --yang-dir")
            finish(1)
            return
        if interactive:
            out("Connecting to {host}:{port}...\n")
        ls = local_schema
        bundled = ls if ls is not None else yschema.DRoot()
        dev_types = {
            "netconf": swdev.DeviceType(name="netconf", adapter_type=swna.NetconfAdapter, src_dnode=bundled)
        }
        dmc = DeviceMetaConfig(name="ncurl-cli", credentials=credentials, type="netconf")
        dmc.address.create("primary", host, u64(port))
        dmc.ssh = ssh
        dmc.feature_flags.runtime_schema_fetch = ls is None
        device = swdev.DeviceMgr(dev_types, env, "ncurl-cli", log_handler, on_reconf, swdev.SchemaRegistry())
        device.set_dmc(dmc)
        dev = device
        after timeout: connect_timeout()

    proc def __startup__():
        interactive = len(oneshot) == 0 and env.stdio.stdin_is_tty() and env.stdio.stdout_is_tty()
        screen = len(oneshot) > 0 and env.stdio.stdout_is_tty()
        if args.get_bool("verbose"):
            log_handler.set_output_level(logging.TRACE)
            log_handler.add_sink(EditorSink(log_line))
        start()
