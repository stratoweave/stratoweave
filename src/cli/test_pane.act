"""Tests for the pane layout and the terminal output that draws panes."""

import testing

import cli.pane as pane


ESC = "\x1b"


def _test_layout():
    # (name, rows, panes, (top, height) of each pane, first CLI row)
    cases = [
        ("one pane", 30, 1, [(1, 24)], 25),
        ("two panes", 30, 2, [(1, 12), (13, 12)], 25),
        ("rows that do not split evenly", 31, 2, [(1, 13), (14, 12)], 26),
        ("four panes", 24, 4, [(1, 5), (6, 5), (11, 4), (15, 4)], 19),
        ("smallest panes", 12, 3, [(1, 2), (3, 2), (5, 2)], 7),
        ("no room", 11, 3, [], 1),
        ("no panes", 30, 0, [], 1),
    ]
    for name, rows, count, want, top in cases:
        areas = pane.layout(rows, count)
        testing.assertEqual([(a.top, a.height) for a in areas], want, "layout {name}")
        testing.assertEqual(pane.cli_top(areas), top, "CLI top {name}")


def _test_frame():
    # (name, area top, area height, columns, header, lines, changed lines, output)
    cases = [
        ("lines that fit", 3, 4, 10, "pane 1", ["a;", "b;"], set([1]),
         ESC + "7" + ESC + "[?7l" + ESC + "[3;1H" + ESC + "[7mpane 1    " + ESC + "[0m"
         + ESC + "[4;1H" + ESC + "[2Ka;"
         + ESC + "[5;1H" + ESC + "[2K" + ESC + "[1mb;" + ESC + "[0m"
         + ESC + "[6;1H" + ESC + "[2K"
         + ESC + "[?7h" + ESC + "8"),
        ("lines that do not fit", 1, 3, 20, "p", ["a;", "b;", "c;", "d;"], set(),
         ESC + "7" + ESC + "[?7l" + ESC + "[1;1H" + ESC + "[7mp                   " + ESC + "[0m"
         + ESC + "[2;1H" + ESC + "[2Ka;"
         + ESC + "[3;1H" + ESC + "[2K" + ESC + "[2m... 3 more lines" + ESC + "[0m"
         + ESC + "[?7h" + ESC + "8"),
        ("control characters", 1, 2, 8, "h", ["a\tb\nc"], set(),
         ESC + "7" + ESC + "[?7l" + ESC + "[1;1H" + ESC + "[7mh       " + ESC + "[0m"
         + ESC + "[2;1H" + ESC + "[2Ka b c"
         + ESC + "[?7h" + ESC + "8"),
        ("long header and line", 1, 2, 5, "header text", ["abcdefgh"], set(),
         ESC + "7" + ESC + "[?7l" + ESC + "[1;1H" + ESC + "[7mheade" + ESC + "[0m"
         + ESC + "[2;1H" + ESC + "[2Kabcde"
         + ESC + "[?7h" + ESC + "8"),
    ]
    for name, top, height, cols, header, lines, changed, want in cases:
        testing.assertEqual(pane.frame(pane.Area(top, height), cols, header, lines, changed), want, "frame {name}")


def _test_changed_lines():
    # (name, old lines, new lines, changed indexes)
    cases = [
        ("first update", [], ["a", "b"], set()),
        ("same", ["a", "b"], ["a", "b"], set()),
        ("one changed", ["a", "b"], ["a", "c"], set([1])),
        ("more lines", ["a"], ["a", "b", "c"], set([1, 2])),
        ("fewer lines", ["a", "b"], ["x"], set([0])),
    ]
    for name, old, new, want in cases:
        testing.assertEqual(pane.changed_lines(old, new), want, "changed {name}")


def _test_terminal_output():
    testing.assertEqual(pane.scroll_region(25, 30), ESC + "[25;30r", "scroll region")
    testing.assertEqual(pane.reset_region(), ESC + "[r", "reset region")
    testing.assertEqual(pane.clear_rows(2, 3), ESC + "7" + ESC + "[2;1H" + ESC + "[2K" + ESC + "[3;1H" + ESC + "[2K" + ESC + "8", "clear rows")
