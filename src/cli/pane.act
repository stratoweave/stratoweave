"""Panes above the CLI.

A pane shows data that the device keeps sending, such as a YANG-push
subscription, in a fixed area at the top of the terminal. The panes share
the rows above the CLI, top to bottom in pane number order. The CLI keeps
the rows below them as a terminal scroll region, so its output scrolls
there and the panes stay. A pane draws with the cursor saved and restored,
so the line being typed stays as it is.
"""

# The rows that the CLI keeps below the panes, at the least.
CLI_ROWS = 6
# The rows of a pane, at the least: the header and one line.
PANE_ROWS = 2
# The number of panes.
MAX_PANES = 4

ESC = "\x1b"
# The indent of the data lines when they print as text.
INDENT_TEXT = "    "


class Area(object):
    """The rows of one pane: the first row, 1 at the top of the terminal, and the number of rows."""
    top: int
    height: int

    def __init__(self, top: int, height: int):
        self.top = top
        self.height = height


def layout(rows: int, count: int) -> list[Area]:
    """Split the rows above the CLI between count panes, top first.

    The CLI keeps CLI_ROWS rows. The first panes get the rows that do not
    split evenly. Return an empty list when the panes do not fit.
    """
    usable = rows - CLI_ROWS
    if count == 0 or usable < count * PANE_ROWS:
        return []
    each = usable // count
    extra = usable % count
    res = []
    top = 1
    for i in range(count):
        h = each + (1 if i < extra else 0)
        res.append(Area(top, h))
        top += h
    return res


def cli_top(areas: list[Area]) -> int:
    """Return the first row of the CLI below the panes."""
    if len(areas) == 0:
        return 1
    last = areas[-1]
    return last.top + last.height


def scroll_region(top: int, bottom: int) -> str:
    """Return the terminal output that limits scrolling to the rows from top to bottom."""
    return "{ESC}[{top};{bottom}r"


def reset_region() -> str:
    """Return the terminal output that lets the whole terminal scroll again."""
    return "{ESC}[r"


def _fit(text: str, cols: int) -> str:
    """Cut a line to the terminal width, with a space for each control character.

    Each character counts as one column.
    """
    chars = []
    for c in text:
        chars.append(" " if ord(c) < 32 or ord(c) == 127 else c)
        if len(chars) == cols:
            break
    return "".join(chars)


def changed_lines(old: list[str], new: list[str]) -> set[int]:
    """Return the indexes of the lines in new that differ from the line at the same index in old."""
    res = set()
    if len(old) == 0:
        return res
    for i in range(len(new)):
        if i >= len(old) or old[i] != new[i]:
            res.add(i)
    return res


def frame(area: Area, cols: int, header: str, lines: list[str], changed: set[int]) -> str:
    """Return the terminal output that draws a pane in its area.

    The header shows in reverse video on the first row, and the lines follow,
    the changed ones in bold. When the lines do not fit, the last row says
    how many more there are. The output saves the cursor first and restores
    it at the end. It turns line wrap off while it draws, so a line that is
    wider on screen than its length stays in its row.
    """
    out = [ESC + "7" + ESC + "[?7l"]
    out.append("{ESC}[{area.top};1H{ESC}[7m" + _fit(header.ljust(cols), cols) + ESC + "[0m")
    room = area.height - 1
    shown = len(lines)
    if shown > room:
        shown = room - 1
    for r in range(room):
        row = area.top + 1 + r
        text = ""
        if r < shown:
            text = _fit(lines[r], cols)
            if r in changed:
                text = ESC + "[1m" + text + ESC + "[0m"
        elif r == shown and shown < len(lines):
            text = ESC + "[2m" + _fit("... {len(lines) - shown} more lines", cols) + ESC + "[0m"
        out.append("{ESC}[{row};1H{ESC}[2K" + text)
    out.append(ESC + "[?7h" + ESC + "8")
    return "".join(out)


def clear_rows(top: int, bottom: int) -> str:
    """Return the terminal output that clears the rows from top to bottom, with the cursor saved and restored."""
    out = [ESC + "7"]
    for row in range(top, bottom + 1):
        out.append("{ESC}[{row};1H{ESC}[2K")
    out.append(ESC + "8")
    return "".join(out)
