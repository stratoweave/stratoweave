"""CLI hints from YANG extension statements.

The CLI reads the Junos `junos:cli-feature` statement and the Tail-f
`tailf:cli-drop-node-name` and `tailf:cli-no-keyword` statements, and maps
them to one set of hints. Without hints, every node has a keyword.
"""

import yang.schema as yschema


JUNOS_EXT_NS = "http://yang.juniper.net/junos/common/ddl-extensions"
JUNOS_ROOT_NS = "http://yang.juniper.net/junos/conf/root"
TAILF_NS = "http://tail-f.com/yang/common"


class Hints(object):
    """CLI hints for one schema node.

    nokeyword: the node has no keyword. A list entry starts with its first key
    value, and a leaf is its value alone.
    oneliner: the node and its children show on one line.
    oneliner_plus: the node shows on one line when no child has more than one
    value.
    homogeneous: the entries of a list show inside one block under the list
    keyword, and each child of a container shows with the container keyword in
    front, as in `family inet`.
    """
    nokeyword: bool
    oneliner: bool
    oneliner_plus: bool
    homogeneous: bool

    def __init__(self, nokeyword: bool=False, oneliner: bool=False, oneliner_plus: bool=False, homogeneous: bool=False):
        self.nokeyword = nokeyword
        self.oneliner = oneliner
        self.oneliner_plus = oneliner_plus
        self.homogeneous = homogeneous


def hints(node: yschema.DNode) -> Hints:
    """Read the CLI hints of a schema node from its extension statements."""
    nokeyword = False
    oneliner = False
    oneliner_plus = False
    homogeneous = False
    for ext in node.exts:
        if ext.namespace == JUNOS_EXT_NS and ext.name == "cli-feature":
            arg = ext.arg
            if arg == "nokeyword":
                nokeyword = True
            elif arg == "oneliner":
                oneliner = True
            elif arg == "oneliner-plus":
                oneliner_plus = True
            elif arg == "homogeneous":
                homogeneous = True
        elif ext.namespace == TAILF_NS and ext.name in {"cli-drop-node-name", "cli-no-keyword"}:
            nokeyword = True
    return Hints(nokeyword, oneliner, oneliner_plus, homogeneous)


def has_keyword(node: yschema.DNode) -> bool:
    """Return True when the user types the node name to reach the node."""
    if isinstance(node, yschema.DList) or isinstance(node, yschema.DLeaf):
        return not hints(node).nokeyword
    return True


def cli_root(root: yschema.DRoot) -> list[yschema.DNode]:
    """Return the schema path where CLI paths start.

    Junos models put all configuration under the `configuration` container,
    so CLI paths start inside it. Other schemas start at the root.
    """
    for child in root.children:
        if isinstance(child, yschema.DContainer) and child.name == "configuration" and child.namespace == JUNOS_ROOT_NS:
            return [child]
    return []


def config_children(node: yschema.DNode) -> list[yschema.DNode]:
    """Return the configuration data nodes below a schema node."""
    res = []
    if isinstance(node, yschema.DNodeInner):
        for child in node.children:
            if not child.config:
                continue
            if isinstance(child, yschema.DContainer) or isinstance(child, yschema.DList) or isinstance(child, yschema.DLeaf) or isinstance(child, yschema.DLeafList):
                res.append(child)
    return res


def key_leaves(node: yschema.DList) -> list[yschema.DLeaf]:
    """Return the key leaves of a list in key order."""
    res = []
    for name in node.key:
        child = node.get(name)
        if isinstance(child, yschema.DLeaf):
            res.append(child)
        else:
            raise ValueError("List {node.name} key {name} is not a leaf")
    return res


def summary(text: ?str, width: int=56) -> str:
    """Return the first sentence of a description, cut to a width.

    The sentence loses its final period, as in Junos help. Return an empty
    string when there is no description.
    """
    words = []
    if text is not None:
        for w in text.replace("\r", " ").replace("\n", " ").replace("\t", " ").split(" "):
            if w == "":
                continue
            words.append(w)
            if w.endswith("."):
                break
    s = " ".join(words)
    if s.endswith("."):
        s = s[:-1]
    if len(s) > width:
        s = s[:width - 3].rstrip() + "..."
    return s


_QUOTE_CHARS = set([" ", "\t", "\n", "\r", "\"", "\\", ";", "{{", "}}", "#", "[", "]", "|", "'"])


def quote(s: str, force: bool=False) -> str:
    """Quote a value when the CLI tokenizer would split or misread it, or when force is set."""
    need = force or len(s) == 0
    for c in s:
        if c in _QUOTE_CHARS:
            need = True
            break
    if not need:
        return s
    return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
