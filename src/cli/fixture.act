"""Schema and data that the CLI tests share."""

import std.xml as xml
import yang
import yang.xml as yxml

import cli.command as command


EXT = r"""module junos-common-ddl-extensions {
  namespace "http://yang.juniper.net/junos/common/ddl-extensions";
  prefix junos;
  extension cli-feature { argument "feature"; }
}"""

DEMO = r"""module demo {
  namespace "urn:demo";
  prefix d;
  import junos-common-ddl-extensions { prefix junos; }

  identity if-type;
  identity ethernet { base if-type; }
  identity loopback { base if-type; }

  container system {
    description "System parameters";
    leaf host-name { type string; description "Hostname for this router"; }
    leaf weight { type union { type uint8 { range "1..10"; } type string { pattern "<.*>|$.*"; } } }
    leaf-list name-server { type string; ordered-by user; description "DNS name servers"; }
    container services { presence "enable services"; leaf ssh { type empty; } }
    container syslog {
      list file {
        key name;
        leaf name { type string; }
        list contents {
          key name;
          junos:cli-feature "nokeyword";
          junos:cli-feature "oneliner";
          leaf name { type enumeration { enum any; enum authorization; enum daemon; } }
          leaf any { type empty; }
          leaf notice { type empty; }
        }
      }
    }
  }
  container interfaces {
    description "Interface configuration";
    leaf traceoptions { type string; }
    list interface {
      key name;
      junos:cli-feature "nokeyword";
      description "Physical interface";
      leaf name { type string; description "Interface name"; }
      leaf description { type string; description "Text description of interface"; }
      leaf mtu { type uint16 { range "256..9192"; } }
      leaf type { type identityref { base if-type; } }
      leaf enabled { type boolean; }
      leaf speed { type enumeration { enum auto; enum "10m"; enum "100m"; enum "1g"; } }
      list unit {
        key name;
        leaf name { type uint32; }
        leaf vlan-id { type uint16; }
        container family {
          junos:cli-feature "homogeneous";
          container inet {
            presence "enable inet";
            list address { key name; leaf name { type string; } }
          }
          container inet6 { presence "enable inet6"; }
        }
      }
    }
  }
  container routing {
    list route {
      key "prefix next-hop";
      leaf prefix { type string; }
      leaf next-hop { type string; }
      leaf metric { type uint32; }
    }
    list policy {
      key name;
      ordered-by user;
      leaf name { type string; }
      leaf action { type string; }
    }
  }
  container snmp { leaf location { type string; } }
  container state { config false; leaf uptime { type uint32; } }
}"""

EXTRA = r"""module demo-extra {
  namespace "urn:demo-extra";
  prefix x;
  import demo { prefix d; }
  augment "/d:snmp" { leaf location { type string; } }
}"""

OPS = r"""module demo-ops {
  yang-version 1.1;
  namespace "urn:demo-ops";
  prefix o;
  import demo { prefix d; }

  augment "/d:interfaces" {
    leaf lo0-address { config false; type string; }
  }
  augment "/d:interfaces/d:interface" {
    container counters {
      config false;
      leaf in-octets { type uint64; }
      leaf out-octets { type uint64; }
    }
    action clear-counters { description "Clear the interface counters"; }
    action bounce {
      description "Take the interface down and up";
      input { leaf delay { type uint8; units seconds; } }
      output { leaf result { type string; } }
    }
  }
  container sessions {
    config false;
    list session {
      key id;
      leaf id { type uint32; }
      leaf user { type string; }
      action kill { description "Close the session"; }
    }
    list event { leaf text { type string; } }
  }
  rpc ping {
    description "Send echo requests to a host";
    input {
      leaf host { type string; mandatory true; }
      leaf count { type uint8; }
      container options { leaf ttl { type uint8; } leaf df { type empty; } leaf count-limit { type uint8; } }
      container record { presence "record the route"; leaf hops { type uint8; } }
      container source { presence "send from a source address"; leaf address { type string; mandatory true; } }
      list pattern { leaf byte { type uint8; } }
    }
    output {
      leaf sent { type uint32; }
      leaf received { type uint32; }
      list probe { key seq; leaf seq { type uint32; } leaf time { type decimal64 { fraction-digits 3; } units ms; } }
    }
  }
  rpc reload { description "Restart the device"; }
  rpc current-time { output { leaf time { type string; } } }
  rpc get-log { output { anyxml log; } }
  notification link-down {
    description "An interface went down";
    leaf if-name { type string; }
    leaf reason { type string; }
  }
  notification reboot-started { description "The device started a reboot"; }
  container conf { config false; leaf version { type string; } }
  container configuration { config false; leaf version { type string; } }
}"""

DATA = r"""<data>
<system xmlns="urn:demo">
  <host-name>r1</host-name>
  <name-server>10.0.0.1</name-server>
  <name-server>10.0.0.2</name-server>
  <services/>
  <syslog><file><name>messages</name><contents><name>any</name><notice/></contents></file></syslog>
</system>
<interfaces xmlns="urn:demo">
  <interface>
    <name>ge-0/0/0</name>
    <description>uplink to core</description>
    <mtu>9000</mtu>
    <type xmlns:d="urn:demo">d:ethernet</type>
    <enabled>true</enabled>
    <unit><name>0</name><vlan-id>10</vlan-id><family><inet><address><name>10.0.0.1/24</name></address></inet><inet6/></family></unit>
  </interface>
  <interface><name>lo0</name></interface>
  <interface><name>trace</name><mtu>1500</mtu></interface>
</interfaces>
<routing xmlns="urn:demo">
  <route><prefix>10.0.0.0/8</prefix><next-hop>192.0.2.1</next-hop><metric>5</metric></route>
  <policy><name>p1</name><action>accept</action></policy>
  <policy><name>p2</name><action>reject</action></policy>
</routing>
<snmp xmlns="urn:demo">
  <location>dc1</location>
  <location xmlns="urn:demo-extra">rack4</location>
</snmp>
</data>"""


STATE = r"""<data>
<interfaces xmlns="urn:demo">
  <interface>
    <name>ge-0/0/0</name>
    <mtu>9000</mtu>
    <counters xmlns="urn:demo-ops"><in-octets>1000</in-octets><out-octets>2000</out-octets></counters>
  </interface>
  <interface><name>lo0</name><mtu>1500</mtu></interface>
  <lo0-address xmlns="urn:demo-ops">127.0.0.1</lo0-address>
</interfaces>
<state xmlns="urn:demo"><uptime>42</uptime></state>
<sessions xmlns="urn:demo-ops">
  <session><id>7</id><user>admin</user></session>
  <event><text>boot</text></event>
  <event><text>login</text></event>
</sessions>
</data>"""


def context() -> command.Context:
    """Return an operational mode context over the shared schema and data."""
    root = yang.compile([EXT, DEMO, EXTRA, OPS])
    data = yxml.from_xml(root, xml.decode(DATA))
    return command.Context(root, data)


def state_context() -> command.Context:
    """Return an operational mode context over the shared schema, with configuration and state data as a get returns them."""
    root = yang.compile([EXT, DEMO, EXTRA, OPS])
    data = yxml.from_xml(root, xml.decode(STATE), loose=True)
    return command.Context(root, data)
