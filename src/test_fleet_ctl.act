"""Tests of the controller's release decisions, on times the tests give."""

import testing

import fleet_ctl
from fleet_ctl import Controller
import fleet_ctl_sim as sim

HOUR = 3600
DAY = 86400


def devices(prefix: str, n: int, est: int, schedule: str) -> list[(str, int, str)]:
    """n devices prefix0, prefix1, ... of est seconds on schedule."""
    return [("{prefix}{i}", est, schedule) for i in range(n)]


def daily(schedule: str, start: int, length: int, days: int) -> list[(str, int, int)]:
    """A window of length seconds at start every day for days days."""
    return [(schedule, d * DAY + start, d * DAY + start + length) for d in range(days)]


def configured(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
               maxc: int, must_place: bool=False, debounce: int=0,
               estimate: int=600, groups: dict[str, list[str]]={},
               priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
               close_margin: int=fleet_ctl.CLOSE_MARGIN, stagger: int=0,
               prepare: bool=False, prepare_s: int=100,
               failure_budget: int=-1) -> Controller:
    """A controller before its first run, every device answered that it
    needs the upgrade. Each device's prepare takes prepare_s seconds."""
    c = Controller()
    c.configure(windows, devs, target, maxc, must_place, debounce, estimate, groups, priority,
                separation, close_margin, stagger, prepare, {d.0: prepare_s for d in devs},
                failure_budget)
    sim.answer_all(c, 0)
    return c


def controller(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
               maxc: int, must_place: bool=False, debounce: int=0,
               estimate: int=600, groups: dict[str, list[str]]={},
               priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
               rung: int=1, close_margin: int=fleet_ctl.CLOSE_MARGIN,
               stagger: int=0, prepare: bool=False, prepare_s: int=100,
               failure_budget: int=-1) -> Controller:
    """A controller at the start of a run, every device answered that it
    needs the upgrade. Each device's prepare takes prepare_s seconds."""
    c = configured(windows, devs, target, maxc, must_place, debounce, estimate, groups, priority,
                   separation, close_margin, stagger, prepare, prepare_s, failure_budget)
    c.start(rung)
    return c


def open_window(n: int, target: int, maxc: int, debounce: int=0) -> Controller:
    """n devices d0, d1, ... of 600 s in a window that never closes."""
    return controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", n, 600, "w"), target, maxc,
                      debounce=debounce)


def _test_final_statuses():
    """Only the statuses that end an attempt are final."""
    cases = [
        ("succeeded", True),
        ("up-to-date", True),
        ("failed", True),
        ("rolled-back", True),
        ("in-progress", False),
        ("pending", False),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.is_final(case.0), case.1, case.0)
    testing.assertEqual(fleet_ctl.is_final(None), False, "no status")


def _test_answers():
    """A status answers the campaign's target when the device needs the
    upgrade or the status is final. No status, unknown and in-progress
    are no answer."""
    cases: list[(?str, bool)] = [
        ("upgrade-needed", True),
        ("up-to-date", True),
        ("succeeded", True),
        ("failed", True),
        ("rolled-back", True),
        (None, False),
        ("unknown", False),
        ("in-progress", False),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.is_answer(case.0), case.1, str(case.0))


def _test_first_step_starts_one_device():
    """The ramp starts at one device, and the next decision is one
    debounce after its upgrade is expected to end."""
    c = open_window(10, 4, 8, 5)
    s = c.decide(0)
    testing.assertEqual(s.started, ["d0"])
    testing.assertEqual(s.wake, 605)
    testing.assertEqual(s.finished, False)


def _test_ramp_grows_four_times_a_round():
    """The ramp starts at one device, and each device done without a
    failure lets three more start, up to the concurrency. So when the
    devices of a round succeed together, the next round is four times as
    large, up to the concurrency: 1, 4, 16, then 20."""
    c = open_window(60, 20, 20)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2", "d3", "d4"])
    testing.assertEqual(c.rung, 4)
    for i in range(1, 5):
        c.report("d{i}", "succeeded", 1200)
    testing.assertEqual(c.decide(1200).started, ["d{i}" for i in range(5, 21)])
    testing.assertEqual(c.rung, 16)
    for i in range(5, 21):
        c.report("d{i}", "succeeded", 1800)
    testing.assertEqual(c.decide(1800).started, ["d{i}" for i in range(21, 41)])
    testing.assertEqual(c.rung, 20)


def _test_only_a_device_done_without_a_failure_grows_the_ramp():
    """The ramp grows by three for each device that is done without a
    failure, also one that reported up-to-date before its release. 10 at
    once in a window that never closes, the ramp at one device. d1
    reports up-to-date before its release. d0 fails: the ramp stays at
    one, and d1 starts. d1 is done at the next decision, up to date: the
    ramp lets 4 be in flight, and d2 to d5 start. d2 rolls back: the ramp
    stays at 4, and d6 takes the slot of d2. d3 succeeds: the ramp lets 7
    be in flight, and with d4, d5 and d6 in flight, d7 to d10 start."""
    c = open_window(12, 10, 10)
    c.report("d1", "up-to-date", 0)
    testing.assertEqual(c.decide(0).started, ["d0"])
    # (the time of the decision, the reports that come then, the devices
    # that start, the ramp after)
    cases: list[(int, list[(str, str)], list[str], int)] = [
        (600, [("d0", "failed")], ["d1"], 1),
        (601, [], ["d2", "d3", "d4", "d5"], 4),
        (1201, [("d2", "rolled-back")], ["d6"], 4),
        (1250, [("d3", "succeeded")], ["d7", "d8", "d9", "d10"], 7),
    ]
    for case in cases:
        for r in case.1:
            c.report(r.0, r.1, case.0)
        testing.assertEqual(c.decide(case.0).started, case.2, str(case.0))
        testing.assertEqual(c.rung, case.3, str(case.0))


def _test_devices_up_to_date_before_their_release_grow_the_ramp():
    """100 devices, u0 to u99, report up-to-date at 0, and 40 devices of
    600 s, r0 to r39, come after them, 10 at once, in a window that never
    closes, with a debounce of 30 s. The run starts at 0 too, and each
    up-to-date device reported before its release, so it ran no upgrade
    and is done at the decision after its release. It grows the ramp as a device that
    succeeds does: the decisions start 1, 4 and then 10 devices. So the
    first 11 decisions start 95 of the up-to-date devices, and the 12th
    the last 5 and r0 to r4. If the ramp did not grow on them, it would
    stay at one device, and r0 would start at the 101st decision. r0 must
    start at the 12th decision at the latest, and every device must be
    done."""
    devs = devices("u", 100, 600, "w") + devices("r", 40, 600, "w")
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 10, 10, debounce=30)
    for i in range(100):
        c.report("u{i}", "up-to-date", 0)
    ds = sim.drive(c, 0, {}, DAY)
    first = -1
    for k in range(len(ds)):
        if first < 0 and "r0" in ds[k].started:
            first = k + 1
    testing.assertTrue(first > 0 and first <= 12,
                       "r0 starts at decision {first}, at the latest the 12th")
    testing.assertEqual(len(c.done_times()), 140)


def _test_a_report_before_the_release_in_its_second_ran_no_upgrade():
    """d0 has an upgrade of 600 s, one device at a time, released at 0. A
    final report that came before the release ran no upgrade, also in the
    same second: d0 is done at the step that takes the report, and the
    pace stays at 600 s. A report that came after the release is an
    upgrade, in the same second too: it counts as 1 s, and the pace, the
    mean of one upgrade at a target of one, becomes 1 s."""
    # (whether d0 reports before its release, when it reports, when it is
    # done, the pace after)
    cases: list[(bool, int, int, int)] = [
        (True, 0, 1, 600),
        (False, 0, 0, 1),
        (False, 1, 1, 1),
    ]
    for case in cases:
        c = open_window(2, 1, 1)
        if case.0:
            c.report("d0", "succeeded", case.1)
        testing.assertEqual(c.decide(0).started, ["d0"])
        if not case.0:
            c.report("d0", "succeeded", case.1)
        c.decide(1)
        testing.assertEqual((c.done_times()["d0"], c.observed_s), (case.2, case.3),
                            "report at {case.1}, before the release: {case.0}")


def _test_each_device_that_succeeds_lets_three_more_start():
    """The ramp does not wait for a round to end. 10 at once. d0 succeeds,
    and the ramp lets 4 be in flight: d1 to d4 start. d1 succeeds, though
    d2 to d4 are still in flight: the ramp lets 7 be in flight, and d5 to
    d8 start. d2 succeeds: the ramp reaches the concurrency of 10, and d9
    to d12 start. d3 succeeds: the ramp stays at 10, and d13 takes the
    slot of d3."""
    c = open_window(30, 10, 10)
    testing.assertEqual(c.decide(0).started, ["d0"])
    # (the device done, when, the devices that start, the ramp after)
    cases: list[(str, int, list[str], int)] = [
        ("d0", 600, ["d1", "d2", "d3", "d4"], 4),
        ("d1", 700, ["d5", "d6", "d7", "d8"], 7),
        ("d2", 800, ["d9", "d10", "d11", "d12"], 10),
        ("d3", 900, ["d13"], 10),
    ]
    for case in cases:
        c.report(case.0, "succeeded", case.1)
        testing.assertEqual(c.decide(case.1).started, case.2, case.0)
        testing.assertEqual(c.rung, case.3, case.0)


def _test_the_ramp_follows_a_rise_of_the_concurrency_as_devices_finish():
    """4 at once: the ramp is at the concurrency, with d1 to d4 in flight.
    New limits raise the concurrency to 10. No device is done, so the next
    decision starts none. Then each device that succeeds lets three more
    start, as on the way up: when d1 succeeds, d5 to d8 start, when d2
    succeeds, d9 to d12, and when d3 succeeds, d13 only."""
    c = open_window(30, 4, 4)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2", "d3", "d4"])
    c.configure([("w", 0, fleet_ctl.OPEN_END)], devices("d", 30, 600, "w"), 10, 10, False, 0, 600)
    s = c.decide(610)
    testing.assertEqual((s.plan.c, s.started, c.rung), (10, [], 4))
    # (the device done, when, the devices that start, the ramp after)
    cases: list[(str, int, list[str], int)] = [
        ("d1", 700, ["d5", "d6", "d7", "d8"], 7),
        ("d2", 800, ["d9", "d10", "d11", "d12"], 10),
        ("d3", 900, ["d13"], 10),
    ]
    for case in cases:
        c.report(case.0, "succeeded", case.1)
        testing.assertEqual(c.decide(case.1).started, case.2, case.0)
        testing.assertEqual(c.rung, case.3, case.0)


def _test_done_at_its_report():
    """A device is done at the time of its final report, not at the
    decision that sees it, so the time it waited for the decision is not
    upgrade time. A later final report does not move the end."""
    c = open_window(2, 1, 1)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.report("d0", "succeeded", 650)
    c.decide(700)
    testing.assertEqual(c.done_times(), {"d0": 600})
    testing.assertEqual(c.observed_s, 600)


def _test_final_report_from_before_the_release():
    """A device that reported a final status before it was released is
    done at the decision that sees it after the release. It ran no
    upgrade, so the pace stays."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    c.decide(10)
    c.decide(40)
    testing.assertEqual(c.done_times(), {"d0": 40})
    testing.assertEqual(c.observed_s, 600)


def _test_lost_or_later_status_is_not_done():
    """A device whose report was lost, or whose later report is not
    final, is not done, and keeps its slot."""
    c = open_window(3, 1, 1)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.lost("d0")
    testing.assertEqual(c.decide(600).started, [])
    testing.assertEqual(c.done_times(), {})
    c.report("d0", "succeeded", 1100)
    c.report("d0", "in-progress", 1150)
    c.decide(1200)
    testing.assertEqual(c.done_times(), {})


def _test_waits_for_the_window_to_open():
    """Before its window opens nothing starts, and the next decision is at
    the opening."""
    c = controller([("w", 1000, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1)
    s = c.decide(0)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.wake, 1000)
    testing.assertEqual(c.decide(1000).started, ["d0"])


def _test_a_device_waits_for_a_window_it_fits():
    """Two 1000 s windows a day apart, one device at a time. d0 starts at
    the first opening. At 600 the 400 s left are too short for one and a
    half times d1's 600 s, so it starts at the second opening, and waits in
    the first window no more. The controller decides again when the first
    window closes, and then at the second opening."""
    wins = daily("w", 0, 1000, 2)
    c = controller(wins, devices("d", 2, 600, "w"), 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.wake, 1000)
    testing.assertEqual(c.decide(1000).wake, DAY)
    testing.assertEqual(c.decide(DAY).started, ["d1"])
    testing.assertEqual(c.release_windows(), {"d0": wins[0], "d1": wins[1]})
    c.report("d1", "succeeded", DAY + 600)
    testing.assertEqual(c.decide(DAY + 600).finished, True)


def plan_is_run(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
                maxc: int, must_place: bool, estimate: int,
                groups: dict[str, list[str]]={}, priority: dict[str, int]={},
                separation: dict[str, (bool, int)]={},
                close_margin: int=fleet_ctl.CLOSE_MARGIN, stagger: int=0) -> list[int]:
    """Run on the expected durations, the controller starts every device
    in the window and at the time its first plan said. Return how many
    devices the first plan puts in each window that has devices."""
    c = controller(windows, devs, target, maxc, must_place, 1, estimate, groups, priority,
                   separation, close_margin=close_margin, stagger=stagger)
    p = c.plan(0)
    sim.drive(c, 0, {}, 30 * DAY)
    testing.assertEqual(sim.started(c), sim.planned(c, p))
    return [len(w.3) for w in c.layout(p)]


def reconfigure(c: Controller, devs: list[(str, int, str)], failure_budget: int) -> None:
    """Configure c again as it is, with the devices devs and the failure
    budget failure_budget."""
    c.configure(c.current, devs, c.target, c.maxc, c.must_place, c.debounce, c.estimate_s,
                c.groups, c.priority, c.separation, c.close_margin, c.stagger, c.prepare,
                c.prepare_est, failure_budget)


def same_as_a_new_plan(c: Controller, dur_of: dict[str, int], until: int,
                       late: int=0, answers: list[(int, str)]=[],
                       in_progress: bool=False, prepare: bool=False,
                       failing: list[str]=[], budgets: list[(int, int)]=[],
                       lives: list[(int, str, bool)]=[], reboots: bool=False) -> int:
    """Run c the way the campaign actor does, each decision late seconds
    after its time, next to a copy of it that plans at every decision.
    Each decision of c starts the same devices, wakes at the same time and
    has the same plan as the copy's. answers holds the devices that answer
    the campaign's target later, as (time, name): each reports to both
    that it needs the upgrade at its time, and the next decision is one
    debounce later at the latest. With in_progress, each device that
    starts reports in-progress to both at its start. With prepare, each
    decision of c also has the same prepares as the copy's and lets the
    same members prepare, and each member let prepare reports to both its
    prepare running when it is let and done one expected prepare time
    later; the next decision is one debounce after that at the latest.
    The devices in failing report failed instead of succeeded. budgets
    holds new failure budgets, as (time, budget): both take each at its
    time, and a decision comes then. lives holds devices that go down or
    come back up, as (time, name, up), in the order of their times: both
    take each at its time, and a decision comes then. With reboots, each
    device that starts goes down a third of the way into its upgrade and
    comes back up two thirds of the way in, and a decision comes at each;
    both take the changes that are due at a decision in the order they
    came. Return how many decisions of c took the last plan again."""
    d = c.copy()
    flying: list[(int, str)] = []
    pending = sorted(answers)
    budgets_left = sorted(budgets)
    # The changes of up and down to come.
    changes: list[(int, str, bool)] = lives
    # The prepares that run, as (end, name), and the members let prepare.
    prepping: list[(int, str)] = []
    let: set[str] = set()
    again = 0
    t = 0
    while t <= until:
        still: list[(int, str)] = []
        for f in flying:
            if f.0 <= t:
                status = "failed" if f.1 in failing else "succeeded"
                c.report(f.1, status, f.0)
                d.report(f.1, status, f.0)
            else:
                still.append(f)
        flying = still
        while len(budgets_left) > 0 and budgets_left[0].0 <= t:
            b = budgets_left.pop(0)
            reconfigure(c, c.devices, b.1)
            reconfigure(d, d.devices, b.1)
        to_come: list[(int, str, bool)] = []
        for e in changes:
            if e.0 <= t:
                c.set_live(e.1, e.2)
                d.set_live(e.1, e.2)
            else:
                to_come.append(e)
        changes = to_come
        later: list[(int, str)] = []
        for a in pending:
            if a.0 <= t:
                c.report(a.1, "upgrade-needed", a.0)
                d.report(a.1, "upgrade-needed", a.0)
            else:
                later.append(a)
        pending = later
        copying: list[(int, str)] = []
        for p in prepping:
            if p.0 <= t:
                c.report_prepare(p.1, "done")
                d.report_prepare(p.1, "done")
            else:
                copying.append(p)
        prepping = copying
        down = c.down_end()
        if c.last_plan is not None and c.quiet_from <= t and t < c.quiet_until \
           and (down < 0 or t < down):
            again += 1
        d.quiet_until = 0
        s = c.decide(t)
        n = d.decide(t)
        testing.assertEqual(s.started, n.started, "started at {t}")
        testing.assertEqual(s.wake, n.wake, "wake at {t}")
        testing.assertEqual(s.finished, n.finished, "finished at {t}")
        testing.assertEqual(s.plan.c, n.plan.c, "concurrency at {t}")
        testing.assertEqual(s.plan.starts, n.plan.starts, "plan at {t}")
        testing.assertEqual(s.plan.held, n.plan.held, "held at {t}")
        testing.assertEqual(s.plan.why, n.plan.why, "why at {t}")
        testing.assertEqual(s.plan.alarms, n.plan.alarms, "alarms at {t}")
        if prepare:
            testing.assertEqual(s.prepares.starts, n.prepares.starts, "prepare starts at {t}")
            testing.assertEqual(s.prepares.c, n.prepares.c, "prepares at once at {t}")
            testing.assertEqual(s.prepares.alarms, n.prepares.alarms, "prepare alarms at {t}")
            testing.assertEqual(sorted(list(c.allowed)), sorted(list(d.allowed)),
                                "let prepare at {t}")
            testing.assertEqual(c.prepare_at, d.prepare_at, "let prepare in this run at {t}")
            for name in sorted(c.prepare_at.keys()):
                if name not in let:
                    let.add(name)
                    c.report_prepare(name, "running")
                    d.report_prepare(name, "running")
                    prepping.append((t + c.prepare_est.get_def(name, 1), name))
        for name in s.started:
            dur = dur_of.get_def(name, c.est.get_def(name, 1))
            flying.append((t + dur, name))
            if in_progress:
                c.report(name, "in-progress", t)
                d.report(name, "in-progress", t)
            if reboots:
                changes = changes + [(t + dur // 3, name, False), (t + 2 * dur // 3, name, True)]
        if s.finished:
            break
        nxt = s.wake
        for f in flying + prepping:
            if nxt < 0 or f.0 + c.debounce < nxt:
                nxt = f.0 + c.debounce
        for e in changes:
            if nxt < 0 or e.0 < nxt:
                nxt = e.0
        if len(pending) > 0 and (nxt < 0 or pending[0].0 + c.debounce < nxt):
            nxt = pending[0].0 + c.debounce
        if len(budgets_left) > 0 and (nxt < 0 or budgets_left[0].0 < nxt):
            nxt = budgets_left[0].0
        if nxt < 0:
            break
        t = nxt + late
    return again


def _test_the_plan_is_the_run_uniform():
    """100 devices of 10 min in a 1 h window every day, 10 at once."""
    plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False, 600)


def _test_the_plan_is_the_run_at_a_close_margin_of_200_percent():
    """The same fleet with a close margin of 200 percent: a round starts
    only with 1200 s left, by 00:40:00, so the windows take 25, 40 and
    35 devices, not 35, 50 and 15."""
    sizes = plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False,
                        600, close_margin=200)
    testing.assertEqual(sizes, [25, 40, 35])


def _test_the_plan_is_the_run_at_a_stagger():
    """100 devices of 600 s in a 1 h window every day, 10 at once,
    staggered over a whole upgrade: one start a minute. A window fills
    over ten minutes, so the windows take 30, 45 and 25 devices, not 35,
    50 and 15."""
    sizes = plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False,
                        600, stagger=100)
    testing.assertEqual(sizes, [30, 45, 25])


def overlapping(days: int) -> list[(str, int, int)]:
    """Three schedules whose daily windows of an hour overlap: eu opens
    first, uk half an hour later and us 45 minutes later."""
    return daily("eu", 0, HOUR, days) + daily("uk", 1800, HOUR, days) \
        + daily("us", 2700, HOUR, days)


def overlapping_devices() -> list[(str, int, str)]:
    """40 devices of 600 s on eu, 20 on uk and 15 on us."""
    return devices("eu", 40, 600, "eu") + devices("uk", 20, 600, "uk") \
        + devices("us", 15, 600, "us")


def _test_the_plan_is_the_run_overlapping_windows():
    """The devices of three schedules whose windows overlap, 5 at once and
    at most 10."""
    # (stagger, every device must start in a window)
    cases = [(0, False), (25, False), (100, False), (0, True), (25, True)]
    for case in cases:
        plan_is_run(overlapping(9), overlapping_devices(), 5, 10, case.1, 600,
                    stagger=case.0)


def _test_overlapping_windows_share_the_slots_in_the_plan():
    """eu has more devices than its first window takes. In the first plan,
    uk starts devices in its first window while eu still starts devices
    in its own, not only once eu takes no more."""
    c = controller(overlapping(9), overlapping_devices(), 5, 5, debounce=1)
    p = c.plan(0)
    eu_last = 0
    uk_first = -1
    for name, s in p.starts.items():
        if name.startswith("eu") and s.0 == 0:
            eu_last = fleet_ctl.imax(eu_last, s.1)
        if name.startswith("uk") and (uk_first < 0 or s.1 < uk_first):
            uk_first = s.1
    testing.assertTrue(uk_first >= 0 and uk_first < eu_last,
                       "uk first starts at {uk_first}, eu last at {eu_last}")


def _test_a_decision_that_takes_the_last_plan_again_decides_as_a_new_plan():
    """60 devices of 600 s in a 1 h window every day, 5 at once and at most
    10. Their upgrades take 85 to 115 percent of the estimate, or every
    fifth one twice the estimate. Staggered, the decisions in which only
    devices start take the last plan again, and decide as a new plan
    would. A decision that comes a second or two late plans anew."""
    scatter: dict[str, int] = {}
    tail: dict[str, int] = {}
    for i in range(60):
        scatter["d{i}"] = 600 * (85 + (i * 7) % 31) // 100
        tail["d{i}"] = 1200 if i % 5 == 4 else 600
    # (stagger, upgrade times, how late each decision comes)
    cases = [
        (100, scatter, 0),
        (25, scatter, 0),
        (100, tail, 0),
        (25, tail, 0),
        (25, scatter, 1),
        (100, tail, 2),
    ]
    for case in cases:
        c = controller(daily("day", 0, HOUR, 9), devices("d", 60, 600, "day"), 5, 10, False, 1,
                       stagger=case.0)
        again = same_as_a_new_plan(c, case.1, 9 * DAY, case.2)
        if case.2 == 0:
            testing.assertTrue(again > 0,
                               "stagger {case.0}: {again} decisions took the plan again")


def _test_with_overlapping_windows_a_decision_that_takes_the_last_plan_again_decides_as_a_new_plan():
    """The same with three schedules whose windows overlap, 5 at once and
    at most 10."""
    scatter: dict[str, int] = {}
    for d in overlapping_devices():
        k = int(d.0[2:])
        scatter[d.0] = 600 * (85 + (k * 7) % 31) // 100
    # (stagger, how late each decision comes)
    cases = [(100, 0), (25, 0), (25, 1)]
    for case in cases:
        c = controller(overlapping(9), overlapping_devices(), 5, 10, False, 1, stagger=case.0)
        again = same_as_a_new_plan(c, scatter, 9 * DAY, case.1)
        if case.1 == 0:
            testing.assertTrue(again > 0,
                               "stagger {case.0}: {again} decisions took the plan again")


def _test_the_plan_is_the_run_mixed():
    """10 devices of 395 s and 100 of 4 s on one schedule, one at a time."""
    devs = devices("real", 10, 395, "night") + devices("sim", 100, 4, "night")
    plan_is_run(daily("night", 2 * HOUR, 1800, 9), devs, 1, 1, False, 40)


def _test_the_plan_is_the_run_two_schedules():
    """Two schedules of five 8 s devices each."""
    devs = devices("n", 5, 8, "night") + devices("w", 5, 8, "weekend")
    plan_is_run([("night", 0, HOUR), ("weekend", 2 * HOUR, 3 * HOUR)], devs, 8, 16, False, 8)


def _test_the_plan_is_the_run_deadline():
    """100 devices of 10 min with a deadline that raises the
    concurrency."""
    plan_is_run(daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50, True, 600)


def _test_uniform_fleet_fills_each_window_to_its_ramp():
    """100 devices of 10 min, a 1 h window every day, 10 at once. A
    round starts every 601 s, and the last round of a window starts by
    00:45:00. The first window ramps 1, 4, 10, 10, 10 and has no time for
    a sixth round: it takes 35. The ramp belongs to the campaign, so the
    next window runs five rounds of 10 and takes 50, and the third the
    last 15."""
    c = controller(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10,
                   debounce=1)
    sizes = [len(w.3) for w in c.layout(c.plan(0))]
    testing.assertEqual(sizes, [35, 50, 15])


def _test_deadline_raises_the_concurrency():
    """The same fleet with a deadline at the end of the second window. At
    11 at once the two windows take 38 and 55, 7 short; at 12 they take
    41 and 59."""
    c = controller(daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50,
                   True, 1)
    p = c.plan(0)
    testing.assertEqual(p.c, 12)
    testing.assertEqual([len(w.3) for w in c.layout(p)], [41, 59])
    testing.assertEqual(p.alarms, [])


def _test_device_without_a_window_keeps_the_concurrency():
    """A device whose schedule gives no window cannot start at any
    concurrency, so it does not raise the concurrency; it is the alarm."""
    devs = devices("d", 99, 600, "day") + [("x", 600, "never")]
    c = controller(daily("day", 0, HOUR, 3), devs, 10, 50, True, 1)
    p = c.plan(0)
    testing.assertEqual(p.c, 10)
    testing.assertEqual(p.alarms, ["1 device(s) cannot start before the deadline: x"])


def _test_a_device_that_misses_its_window_gets_a_later_one():
    """Three devices of 600 s are promised a 3000 s window at one at a
    time. d0 takes 2000 s, so the controller expects 2000 s upgrades and
    the 1000 s left are too short for d1. When the window closes d1 and
    d2 are promised the next day's window, where they start, d2 when d1
    reports after its 600 s."""
    wins = daily("w", 0, 3000, 2)
    c = controller(wins, devices("d", 3, 600, "w"), 1, 1)
    p = c.plan(0)
    testing.assertEqual([len(w.3) for w in c.layout(p)], [3])
    sim.drive(c, 0, {"d0": 2000}, 2 * DAY)
    testing.assertEqual(sim.started(c), {"d0": (wins[0], 0), "d1": (wins[1], DAY),
                                         "d2": (wins[1], DAY + 600)})


def _test_promises_raise_the_concurrency_when_upgrades_run_slow():
    """50 devices of 600 s are promised a 1 h window at 10 at once, the ramp
    already at 10. The upgrades take 900 s, so after the first round 10 at
    once can no longer keep the promises, and the controller goes above
    10 to keep them."""
    c = Controller()
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 10, 20, False, 0, 600)
    sim.answer_all(c, 0)
    c.start(10)
    c.plan(0)
    durations = {"d{i}": 900 for i in range(50)}
    sim.drive(c, 0, durations, HOUR)
    testing.assertEqual(len(c.released_devices()), 50)
    testing.assertTrue(c.c > 10, "the concurrency must rise above the target")


def _test_alarm_names_the_devices():
    """A window that one round fills cannot take 10 devices at max 1: the
    plan says which 9 do not fit."""
    c = controller([("w", 0, 1000)], devices("d", 10, 600, "w"), 1, 1, True)
    testing.assertEqual(c.plan(0).alarms,
                        ["9 device(s) cannot start before the deadline even at "
                         + "max-concurrency 1: d1, d2, d3, d4, d5 and 4 more"])


def _test_a_plan_is_a_fixed_point():
    """Windows [100, 500) and [1500, 1700), devices of 150, 150, 100 and
    150 s, one at a time and up to two, every device before the deadline.
    Run without promises, d2 takes the first window's last slot and d3
    fits nowhere. The plan promises d2 the second window, after which two
    at once start every device. The plan runs again until its promises
    stop changing, so it gives that at once, and again when asked
    again."""
    devs = [("d0", 150, "w"), ("d1", 150, "w"), ("d2", 100, "w"), ("d3", 150, "w")]
    c = controller([("w", 100, 500), ("w", 1500, 1700)], devs, 1, 2, True)
    p = c.plan(0)
    testing.assertEqual((p.c, p.alarms), (2, []))
    q = c.plan(0)
    testing.assertEqual((q.c, q.starts), (p.c, p.starts))


def _test_a_late_upgrade_keeps_the_end_it_was_given():
    """d1 is expected to end at 201. Up to 221 it is not late: a fifth of
    its upgrade, 20 s, has not passed since then. At 222 it is: it is
    expected to take one more upgrade, to 322. A decision with nothing
    new keeps that end, so the plans before and after it agree."""
    c = controller([("w", 0, 500)], devices("d", 6, 100, "w"), 2, 4, debounce=1,
                   estimate=100)
    c.decide(0)
    c.report("d0", "succeeded", 100)
    c.decide(101)
    c.report("d2", "succeeded", 201)
    c.decide(202)
    testing.assertEqual(c.due_time("d1"), 201)
    c.decide(221)
    testing.assertEqual(c.due_time("d1"), 201)
    p = c.decide(222).plan
    testing.assertEqual(c.due_time("d1"), 322)
    q = c.plan(260)
    testing.assertEqual((q.c, q.starts), (p.c, p.starts))


def _test_a_missed_promise_moves_to_an_open_window():
    """Windows [0, 300) and [100, open) of one schedule, one device at a
    time. The plan promises x the first window and b the second. a takes
    250 s, x no longer fits the first window, and when it closes x is
    promised the second, where it starts when b ends."""
    wins = [("s", 0, 300), ("s", 100, fleet_ctl.OPEN_END)]
    devs = [("a", 100, "s"), ("x", 100, "s"), ("b", 100, "s")]
    c = controller(wins, devs, 1, 1, estimate=100)
    p = c.plan(0)
    testing.assertEqual(sim.planned(c, p), {"a": (wins[0], 0), "x": (wins[0], 100),
                                            "b": (wins[1], 200)})
    sim.drive(c, 0, {"a": 250}, 1000)
    testing.assertEqual(sim.started(c), {"a": (wins[0], 0), "b": (wins[1], 250),
                                         "x": (wins[1], 350)})


def slow_then_fast() -> dict[str, int]:
    """Upgrade times: s0 and s1 take 300 s, and f0 to f48 take 90 s and
    80 s in turn. One at a time, in the order s0, f0, s1 and f1 to f48,
    each device ends at a time other than expected, so its time counts."""
    took = {"s0": 300, "s1": 300}
    for i in range(49):
        took["f{i}"] = 90 if i % 2 == 0 else 80
    return took


def _test_a_device_that_fits_again_starts():
    """One at a time, a window [0, 7000), and a campaign estimate of 100 s.
    The devices s0, f0, s1, x and f1 to f48 start in that order, and take
    the times of slow_then_fast(). x, of 1500 s, takes its estimate. When
    s1's time counts, at 690, two slow upgrades are among the 50 kept
    times, so the slow time is 300 s. x needs 6750 s and does not fit, and
    f1 starts. When f48's time counts, at 4770, s0's time has left the
    kept times, and the slow time falls to 90 s. x is looked at again,
    and starts with the 2025 s it needs."""
    devs = [("s0", 100, "w"), ("f0", 100, "w"), ("s1", 100, "w"), ("x", 1500, "w")] \
           + [("f{i}", 100, "w") for i in range(1, 49)]
    c = controller([("w", 0, 7000)], devs, 1, 1, estimate=100)
    sim.drive(c, 0, slow_then_fast(), 7000)
    testing.assertEqual(sim.started(c).get("x"), (("w", 0, 7000), 4770))


def _test_a_device_without_a_promise_that_a_free_slot_passed_starts_when_it_fits():
    """Two at a time, a window [0, 7000), and a campaign estimate of 100 s.
    x, of 2000 s, comes first. The run starts at a pace of 300 s, so x
    needs one and a half times 6000 s, 9000 s, and no plan promises it.
    f0 to f48, of 100 s, run in pairs that take 90 s and 80 s in turn, so
    each ends at a time other than expected, and its time counts. When
    f46 and f47 count, at 2040, two of the last 50 times are still the
    300 s that the run started from, and the slow time is 300 s: f48
    takes one slot, and the window looks at x for the other, but x does
    not fit. When f48 counts, at 2130, the slow time falls to 90 s, the
    second longest of the last 50 times. The window looks at x again, x
    needs 2700 s of the 4870 s left, and x starts."""
    devs = [("x", 2000, "w")] + [("f{i}", 100, "w") for i in range(49)]
    took: dict[str, int] = {}
    for i in range(49):
        took["f{i}"] = 90 if (i // 2) % 2 == 0 else 80
    c = Controller()
    c.configure([("w", 0, 7000)], devs, 2, 2, False, 0, 100)
    sim.answer_all(c, 0)
    c.start(2, 300)
    testing.assertEqual(sim.planned(c, c.plan(0)).get("x"), None)
    sim.drive(c, 0, took, 7000)
    testing.assertEqual(sim.started(c).get("x"), (("w", 0, 7000), 2130))


def _test_a_plan_keeps_the_window_a_promise_moves_to():
    """a runs late, so x misses the first window and its promise moves to
    the second, where y is promised. One at a time, x keeps the second
    window and y moves on to the third; two at once start both in the
    second, so the plan runs at two as soon as a is late, at 121: a fifth
    of its upgrade after its expected end, 100, has passed. At 120 the
    plan still runs at one. In the run, a's 201 s leave room in the
    second window, of 320 s, for x only: x needs one and a half times
    201 s, and y 603 s."""
    wins = [("s", 0, 300), ("s", 1000, 1320), ("s", 2000, 2300)]
    devs = [("a", 100, "s"), ("y", 200, "s"), ("x", 100, "s")]
    c = controller(wins, devs, 1, 2, estimate=100)
    c.decide(0)
    testing.assertEqual(c.plan(120).c, 1)
    p = c.decide(121).plan
    testing.assertEqual(p.c, 2)
    testing.assertEqual(sim.planned(c, p).get("x"), (wins[1], 1000))
    c.report("a", "succeeded", 201)
    sim.drive(c, 201, {}, 2000)
    testing.assertEqual(sim.started(c).get("x"), (wins[1], 1000))


def _test_a_pending_report_wakes_the_controller():
    """d0 reported up-to-date before its release, so it is done at the next
    decision, which the controller asks for a second later."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    s = c.decide(10)
    testing.assertEqual((s.started, s.wake), (["d0"], 11))
    testing.assertEqual(sim.planned(c, s.plan).get("d1"), (("w", 0, fleet_ctl.OPEN_END), 11))


def _test_reconfigure_keeps_the_order_of_a_moved_promise():
    """x is promised the first window ahead of y, and misses it. The
    campaign actor configures the controller again when the window has
    closed, without that window; x still goes first in the next one."""
    wins = [("s", 0, 25), ("s", 60, fleet_ctl.OPEN_END)]
    devs = [("a", 10, "s"), ("x", 10, "s"), ("y", 10, "s")]
    c = controller(wins, devs, 1, 1, estimate=10)
    sim.drive(c, 0, {"a": 20}, 24)
    c.configure(wins[1:], devs, 1, 1, False, 0, 10)
    p = c.plan(25)
    testing.assertEqual(sim.planned(c, p), {"x": (wins[1], 60), "y": (wins[1], 80)})


def _test_a_promise_ends_when_the_device_changes_schedule():
    """d1 is promised the window of schedule a. Bound to schedule b, it
    starts in b's window."""
    wins = [("a", 0, 3000), ("b", 4000, 5000)]
    c = controller(wins, [("d0", 600, "a"), ("d1", 600, "a")], 1, 1)
    c.decide(0)
    testing.assertEqual(c.promised_window("d1"), wins[0])
    c.configure(wins, [("d0", 600, "a"), ("d1", 600, "b")], 1, 1, False, 0, 600)
    p = c.plan(10)
    testing.assertEqual(sim.planned(c, p), {"d1": (wins[1], 4000)})


def _test_a_removed_device_does_not_count_for_the_ramp():
    """d0 and d1 are in flight at a ramp of two when d0 leaves the
    campaign. Its report does not count towards the ramp, so the run
    starts the rest where the plan said."""
    c = open_window(6, 4, 4)
    c.start(2)
    c.decide(0)
    c.configure([("w", 0, fleet_ctl.OPEN_END)], devices("d", 6, 600, "w")[1:], 4, 4,
                False, 0, 600)
    p = c.plan(10)
    sim.drive(c, 10, {}, DAY, [(600, "d0"), (600, "d1")])
    starts = sim.started(c)
    testing.assertEqual({k: starts[k] for k in sim.planned(c, p).keys()}, sim.planned(c, p))


def _test_a_removed_device_frees_its_slot():
    """One device at a time: d0 is in flight. Removed from the campaign,
    it holds no slot, and d1 starts."""
    c = open_window(2, 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.configure([("w", 0, fleet_ctl.OPEN_END)], [("d1", 600, "w")], 1, 1, False, 0, 600)
    testing.assertEqual(c.decide(10).started, ["d1"])


def _test_concurrency_counts_the_whole_campaign():
    """Two schedules whose windows overlap share the concurrency: at two
    at once, two devices start in all, one in each window."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 2, 2)
    c.start(2)
    testing.assertEqual(c.decide(0).started, ["a0", "b0"])


def _test_open_windows_share_the_slots():
    """Two windows that never close, with the same upgrade time waiting,
    take two of four slots each. Five slots give the fifth to the window
    that opened first."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "b0", "b1"])
    c = controller(wins, devs, 5, 5, rung=5)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "a2", "b0", "b1"])


def _test_a_window_that_opens_while_another_runs_gets_the_free_slots():
    """Window b opens at 100 while the devices of window a hold both
    slots. The slot a0 frees goes to b, which has no device in flight,
    though a opened first and has devices waiting. The slot a1 frees goes
    to a, which then has none in flight and b one."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 100, fleet_ctl.OPEN_END)]
    devs = devices("a", 4, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(0).started, ["a0", "a1"])
    testing.assertEqual(c.decide(100).started, [])
    c.report("a0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["b0"])
    c.report("a1", "succeeded", 650)
    testing.assertEqual(c.decide(650).started, ["a2"])


def _test_a_window_with_nothing_to_start_passes_its_turn():
    """Window a closes before its devices could end, so the other open
    window takes every slot."""
    wins = [("a", 0, 500), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 2, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(0).started, ["b0", "b1"])


def _test_shares():
    """The slots go one at a time, each to the window whose devices in
    flight plus a half, times its weight, are the fewest, the first window
    on a tie: each share is rounded to the nearest slot."""
    # (devices in flight, weights, slots, shares)
    cases = [
        ([0, 0], [1, 1], 4, [2, 2]),
        ([0, 0], [1, 1], 3, [2, 1]),
        ([3, 0], [1, 1], 2, [0, 2]),
        ([3, 0], [1, 1], 5, [1, 4]),
        ([0, 3], [1, 1], 5, [4, 1]),
        ([1, 1, 1], [1, 1, 1], 2, [1, 1, 0]),
        ([5, 0], [1, 1], 0, [0, 0]),
        ([0], [1], 7, [7]),
        ([0, 0], [1, 2], 3, [2, 1]),
        # Shares of 3.33 and 0.67 round to 3 and 1.
        ([0, 0], [1, 5], 4, [3, 1]),
        ([2, 0], [1, 3], 4, [3, 1]),
        ([0, 0], [1000, fleet_ctl.NO_SHARE], 3, [3, 0]),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.shares(case.0, case.1, case.2), case.3,
                            "shares of {case.2} for {case.0} at weights {case.1}")


def _test_an_open_window_that_changes_keeps_its_devices_in_flight():
    """Windows a and b grow from two hours to three while a0 and b0 run.
    a0 still counts for a, so the slot b0 frees goes to b."""
    devs = devices("a", 4, 600, "a") + devices("b", 4, 600, "b")
    c = controller([("a", 0, 2 * HOUR), ("b", 0, 2 * HOUR)], devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(0).started, ["a0", "b0"])
    c.configure([("a", 0, 3 * HOUR), ("b", 0, 3 * HOUR)], devs, 2, 2, False, 0, 600)
    c.report("b0", "succeeded", 400)
    testing.assertEqual(c.decide(400).started, ["b1"])


def _test_window_needs():
    """A schedule needs the upgrade time it must start before the first
    last start. The time after a last start goes to the schedules that
    can still start devices then, in proportion to their upgrade time
    left, c devices at once."""
    # (waiting upgrade time, last starts, now, concurrency, needs)
    cases = [
        ([1000], [500], 0, 4, [1000]),
        # One hour after eu's last start at 111 at once starts 399600 s of
        # uk's 600000.
        ([1200000, 600000], [13800, 17400], 3600, 111, [1200000, 200400]),
        # The time of its own holds all of the later schedule's upgrade time.
        ([100, 50], [1000, 2000], 0, 1, [100, 0]),
        # The last 100 s go to the third schedule alone; the 100 s before
        # them to the second and third, 3 to 2.
        ([300, 300, 300], [100, 200, 300], 0, 1, [300, 240, 160]),
        ([600, 300], [1000, 1000], 0, 4, [600, 300]),
        # Windows that never close have no time of their own.
        ([3600, 7200], [fleet_ctl.OPEN_END, fleet_ctl.OPEN_END], 0, 4, [3600, 7200]),
        # A last start that has passed counts from now.
        ([100, 100], [-5, 50], 10, 2, [100, 22]),
        # 30 days at 1000 at once start 2.592e9 s of 3.6e9: past 64 bits
        # in between.
        ([10, 3600000000], [10, 2592010], 0, 1000, [10, 1008000000]),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.window_needs(case.0, case.1, case.2, case.3), case.4,
                            "needs of {case.0} at last starts {case.1}")

def _test_a_window_with_time_of_its_own_leaves_the_slots_to_the_other():
    """Window a closes at 2 h with ten devices of 600 s, b at 3 h with two.
    b can start its two in the hour after a's last start, so a takes all
    four slots."""
    wins = [("a", 0, 2 * HOUR), ("b", 0, 3 * HOUR)]
    devs = devices("a", 10, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "a2", "a3"])


def _test_windows_that_close_together_share_by_their_waiting_upgrade_time():
    """Six devices wait in a and two in b, all of 600 s: a takes three of
    four slots."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 6, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "a2", "b0"])


def _test_windows_that_never_close_share_by_their_waiting_upgrade_time():
    """a waits 3600 s in six devices of 600 s, b 7200 s in six of 1200 s,
    both in windows that never close: b takes three of four slots,
    whatever the lengths of their devices."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 6, 600, "a") + devices("b", 6, 1200, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["b0", "b1", "b2", "a0"])


def _test_a_window_that_needs_no_slot_leaves_it_to_one_that_does():
    """a holds 20 devices of 20 s in flight and closes at 45; its last
    start is at 15. b never closes and needs nothing now. The slot a0
    frees at 5 goes to a's last device, not to b."""
    wins = [("a", 0, 45), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 21, 20, "a") + devices("b", 5, 20, "b")
    c = controller(wins, devs, 20, 20, rung=20)
    testing.assertEqual(len(c.decide(0).started), 20)
    c.report("a0", "succeeded", 5)
    testing.assertEqual(c.decide(5).started, ["a20"])


def _test_overlapping_windows_of_one_schedule_take_one_share():
    """Schedule a has two windows open, b one, all never closing, with
    four devices of 600 s on each schedule: a and b take two of four
    slots each, a in its window that opened first."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("a", 100, fleet_ctl.OPEN_END),
            ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 4, 600, "a") + devices("b", 4, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(100).started, ["a0", "a1", "b0", "b1"])


def _test_nothing_starts_before_the_turn_of_a_held_start():
    """a and b never close, three devices of 600 s each, four at once,
    staggered over a whole upgrade: 150 s from one start to the next. b0
    reports up to date at 0. At 0, a0 starts and a1 waits for its turn at
    150. A decision at 50 starts nothing, not even b0, as the plan of 0
    said: that plan starts b0 and b1 at 150."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4, stagger=100)
    c.report("b0", "up-to-date", 0)
    s = c.decide(0)
    testing.assertEqual(s.started, ["a0"])
    testing.assertEqual(s.plan.starts["b0"].1, 150)
    testing.assertEqual(c.decide(50).started, [])
    testing.assertEqual(c.decide(150).started, ["b0", "b1"])


def _test_a_short_window_next_to_a_long_one_starts_all_its_devices():
    """200 devices of 30 s in a daily 20 minute window and 20 of 1800 s in
    a daily 4 h window, both at midnight, 10 at once: the long window's
    devices fit after the short one closes, so the short window starts all
    200 the first night."""
    wins = daily("fast", 0, 1200, 3) + daily("slow", 0, 4 * HOUR, 3)
    devs = devices("f", 200, 30, "fast") + devices("s", 20, 1800, "slow")
    c = controller(wins, devs, 10, 20, debounce=1, estimate=191, stagger=25)
    sizes = [(w.0, w.1, len(w.3)) for w in c.layout(c.plan(0))]
    testing.assertEqual(sizes, [("fast", 0, 200), ("slow", 0, 20)])


def _test_a_window_whose_devices_all_started_sets_no_wake():
    """Two overlapping windows of one schedule. Both devices start in the
    first, so the opening of the second at 300 is no reason to decide: the
    next decision is when the upgrades are expected to end."""
    c = controller([("a", 0, HOUR), ("a", 300, 300 + HOUR)], devices("a", 2, 600, "a"), 2, 2,
                   rung=2)
    s = c.decide(0)
    testing.assertEqual(s.started, ["a0", "a1"])
    testing.assertEqual(s.wake, 600)


def _test_the_stagger_takes_turns_between_open_windows():
    """Two windows open at 0, two devices of 600 s at a time, staggered
    over a whole upgrade: a start every 300 s. The next start goes to the
    window with the fewest devices in flight."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 2, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 2, 2, rung=2, stagger=100)
    testing.assertEqual(c.decide(0).started, ["a0"])
    testing.assertEqual(c.decide(300).started, ["b0"])


def _test_new_limits_start_the_concurrency_over():
    """During a run the concurrency rises to keep promises. New limits
    start it over at the new target."""
    c = Controller()
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 10, 20, False, 0, 600)
    sim.answer_all(c, 0)
    c.start(10)
    c.plan(0)
    sim.drive(c, 0, {"d{i}": 900 for i in range(50)}, 1000)
    testing.assertTrue(c.c > 10, "the concurrency must rise above the target")
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 5, 20, False, 0, 600)
    testing.assertEqual(c.c, 5)


def _test_finished_when_every_device_is_done():
    """The run is finished at the decision that sees the last device
    done."""
    c = open_window(2, 2, 2)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["d1"])
    testing.assertEqual(s.finished, False)
    c.report("d1", "succeeded", 1200)
    testing.assertEqual(c.decide(1200).finished, True)


def _test_start_begins_a_new_run():
    """start() forgets the released devices and the ramp, and the next
    decision starts from one device again. d0 answers again that it needs
    the upgrade, so it no longer has its success."""
    c = open_window(4, 2, 2)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.decide(600)
    c.start()
    testing.assertEqual(c.released_devices(), set())
    testing.assertEqual(c.rung, 1)
    c.report("d0", "upgrade-needed", 700)
    c.report("d1", "upgrade-needed", 700)
    c.report("d2", "upgrade-needed", 700)
    testing.assertEqual(c.decide(1200).started, ["d0"])


def _test_observed_at_the_campaign_scale():
    """A device estimated at 30 s that takes 60 s took twice its estimate:
    on a campaign estimate of 120 s it counts as 240 s."""
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 2, 30, "w"), 1, 1,
                   estimate=120)
    c.decide(0)
    c.report("d0", "succeeded", 60)
    c.decide(60)
    testing.assertEqual(c.observed_s, 240)


def _test_a_new_target_keeps_the_upgrade_times():
    """At a target of 8 the pace is the mean of the last 10 upgrade times,
    and a run starts as if they took 600 s. Eight upgrades take 660 s:
    the pace is (2 * 600 + 8 * 660) / 10 = 648 s. A new target of 16 makes
    the pace the mean of the last 20 of the same times: (12 * 600 + 8 *
    660) / 20 = 624 s. Eight more upgrades take 650 s: the pace is (4 *
    600 + 8 * 660 + 8 * 650) / 20 = 644 s."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = devices("d", 16, 600, "w")
    c = controller(wins, devs, 8, 16, rung=8)
    testing.assertEqual(c.decide(0).started, ["d{i}" for i in range(8)])
    for i in range(8):
        c.report("d{i}", "succeeded", 660)
    testing.assertEqual(c.decide(660).started, ["d{i}" for i in range(8, 16)])
    testing.assertEqual(c.observed_s, 648)
    c.configure(wins, devs, 16, 16, False, 0, 600)
    testing.assertEqual(c.observed_s, 624)
    for i in range(8, 16):
        c.report("d{i}", "succeeded", 1310)
    c.decide(1310)
    testing.assertEqual(c.observed_s, 644)


def _test_a_new_estimate_rescales_the_upgrade_times():
    """The kept upgrade times are at the scale of the campaign's
    estimate. One at a time, three upgrades take 700, 800 and 650 s at a
    campaign estimate of 600 s: the pace is the last time, 650 s, and the
    slow time the second longest of the last 50, 700 s. A campaign
    estimate twice as long, 1200 s, doubles the kept times, the pace and
    the slow time."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = devices("d", 4, 600, "w")
    c = controller(wins, devs, 1, 1)
    c.decide(0)
    t = 0
    k = 0
    for took in [700, 800, 650]:
        t += took
        c.report("d{k}", "succeeded", t)
        c.decide(t)
        k += 1
    testing.assertEqual((c.observed_s, c.slow_s), (650, 700))
    before = list(c.took_s)
    c.configure(wins, devs, 1, 1, False, 0, 1200)
    testing.assertEqual(c.took_s, [2 * x for x in before])
    testing.assertEqual((c.observed_s, c.slow_s), (1300, 1400))


def _test_the_slow_time_is_the_98th_percentile():
    """The slow time of a set of upgrade times is their 98th percentile by
    nearest rank, or the pace when the pace is longer. Of 50 to 99 times
    it is the second longest, so one far outlier does not move it. Of
    fewer times it is the longest."""
    # (what the times are, the times, the pace, the slow time)
    cases: list[(str, list[int], int, int)] = [
        ("62, the two longest differ", [1500, 900] + [600 for _k in range(60)], 600, 900),
        ("62, one far outlier", [600 for _k in range(61)] + [6000], 600, 600),
        ("50, one far outlier", [600 for _k in range(49)] + [6000], 600, 600),
        ("49, one far outlier", [600 for _k in range(48)] + [6000], 600, 6000),
        ("5", [500, 700, 600, 650, 550], 600, 700),
        ("62, one far outlier, at their mean pace", [600 for _k in range(61)] + [6000], 687,
         687),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.slow_time(case.1, case.2), case.3, case.0)


def _test_the_slow_time_is_taken_from_two_rounds_at_max_concurrency():
    """The observed pace is the mean of the last target + target // 4
    upgrade times. The controller keeps the last two rounds of upgrade
    times at max-concurrency, and at least the last 50, and the slow time
    is the 98th percentile of all of them by nearest rank. So of the 50
    to 98 times kept up to max-concurrency 49 it is the second longest,
    of the 100 to 148 kept from 50 to 74 the third longest, and of 150
    the fourth longest."""
    # (the target or the max-concurrency, how many times the pace is the
    # mean of at that target, how many times the controller keeps at that
    # max-concurrency, and the place of the slow time among them, the
    # longest first)
    cases: list[(int, int, int, int)] = [
        (1, 1, 50, 2),
        (8, 10, 50, 2),
        (25, 31, 50, 2),
        (26, 32, 52, 2),
        (40, 50, 80, 2),
        (49, 61, 98, 2),
        (50, 62, 100, 3),
        (64, 80, 128, 3),
        (74, 92, 148, 3),
        (75, 93, 150, 4),
    ]
    for case in cases:
        n = fleet_ctl.slow_samples(case.0)
        # Times 1, 2, ... n s: the time at place k, the longest first, is
        # n + 1 - k s.
        place = n + 1 - fleet_ctl.slow_time([k + 1 for k in range(n)], 1)
        testing.assertEqual((fleet_ctl.pace_samples(case.0), n, place),
                            (case.1, case.2, case.3), "{case.0}")


def _test_a_device_fits_with_one_and_a_half_times_its_slow_time_left():
    """A window starts a device when one and a half times its slow time is
    left before the close, and not one second later. The slow time of a
    device is its estimate at the campaign's slow time. The campaign's
    estimate is 600 s. A run that starts from a pace has that pace as its
    slow time."""
    # (the device's estimate, the campaign's slow time, the time it needs)
    cases: list[(int, int, int)] = [
        (600, 600, 900),
        (200, 600, 300),
        (101, 600, 152),
        (600, 900, 1350),
        (200, 900, 450),
    ]
    for case in cases:
        for late in [0, 1]:
            c = Controller()
            c.configure([("w", 0, 10000)], [("x", case.0, "w")], 1, 1, False, 0, 600)
            sim.answer_all(c, 0)
            c.start(1, case.1)
            t = 10000 - case.2 + late
            expect = ["x"] if late == 0 else []
            testing.assertEqual(c.decide(t).started, expect,
                                "{case.0} s at a slow time of {case.1} s, {10000 - t} s left")


def _test_a_device_fits_with_its_close_margin_left():
    """A window starts a device when its close margin, in percent of its
    slow time of 600 s, is left before the close, and not one second
    later. A close margin below 100 percent counts as 100."""
    # (the close margin configured, the close margin that counts, the
    # time the device needs)
    cases: list[(int, int, int)] = [
        (100, 100, 600),
        (150, 150, 900),
        (200, 200, 1200),
        (50, 100, 600),
    ]
    for case in cases:
        for late in [0, 1]:
            c = controller([("w", 0, 10000)], [("x", 600, "w")], 1, 1, close_margin=case.0)
            testing.assertEqual(c.close_margin, case.1, "close margin {case.0}")
            t = 10000 - case.2 + late
            expect = ["x"] if late == 0 else []
            testing.assertEqual(c.decide(t).started, expect,
                                "close margin {case.0}, {10000 - t} s left")


def _test_the_stagger_spreads_the_starts_when_a_window_opens():
    """Four devices of 600 s, three at a time with the ramp at three,
    staggered over a quarter of an upgrade: three starts in 150 s, one
    every 50 s, in a window that opens at 1000. The time before the window
    opened gives no extra starts. Once no slot is left, the next decision
    is when an upgrade is expected to end. The decisions at 1050 and 1100
    take the plan of 1000 again: each comes on the stagger's turn, and
    before d0 is due at 1600 only starts happen. A decision a second after
    a turn would plan anew."""
    c = controller([("w", 1000, fleet_ctl.OPEN_END)], devices("d", 4, 600, "w"), 3, 3, rung=3,
                   stagger=25)
    cases = [
        (0, [], 1000, 1000),
        (1000, ["d0"], 1050, 1051),
        (1050, ["d1"], 1100, 1101),
        (1100, ["d2"], 1600, 1600),
    ]
    for case in cases:
        s = c.decide(case.0)
        testing.assertEqual(s.started, case.1, "started at {case.0}")
        testing.assertEqual(s.wake, case.2, "wake at {case.0}")
        testing.assertEqual(c.quiet_until, case.3, "quiet until, at {case.0}")
    c.report("d0", "succeeded", 1600)
    testing.assertEqual(c.quiet_until, 0)
    testing.assertEqual(c.decide(1600).started, ["d3"])


def _test_a_stagger_starts_several_devices_in_a_second():
    """Ten devices of 600 s, ten at a time with the ramp at ten, staggered
    over 1 percent of an upgrade: ten starts in 6 s, one every 0.6 s. Each
    second starts the devices whose turn falls in it."""
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 10, 600, "w"), 10, 10,
                   rung=10, stagger=1)
    cases = [
        (0, 2, 1),
        (1, 2, 2),
        (2, 1, 3),
        (3, 2, 4),
        (4, 2, 5),
        (5, 1, 600),
    ]
    for case in cases:
        s = c.decide(case.0)
        testing.assertEqual(len(s.started), case.1, "started at {case.0}")
        testing.assertEqual(s.wake, case.2, "wake at {case.0}")


def _test_the_stagger_follows_the_concurrency():
    """Six devices of 600 s with the ramp at six, staggered over half an
    upgrade. At a concurrency of three, the starts are 100 s apart: d0
    starts at 0, and the next device may start at 100. A target of six
    halves the time between starts at once: d1 may start at 50."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = devices("d", 6, 600, "w")
    c = controller(wins, devs, 3, 3, rung=6, stagger=50)
    s = c.decide(0)
    testing.assertEqual((s.started, s.wake), (["d0"], 100))
    c.configure(wins, devs, 6, 6, False, 0, 600, stagger=50)
    cases = [
        (25, [], 50),
        (50, ["d1"], 100),
        (100, ["d2"], 150),
    ]
    for case in cases:
        s = c.decide(case.0)
        testing.assertEqual(s.started, case.1, "started at {case.0}")
        testing.assertEqual(s.wake, case.2, "wake at {case.0}")

def _test_a_decision_after_the_stagger_wake_plans_anew_and_catches_up():
    """Three devices of 600 s in a window from 1000 to 2000, three at a
    time and at most six, staggered over a quarter of an upgrade: one
    start every 50 s. A device must start by 1100 to have its close
    margin. The decision at 1000 starts d0 and asks to decide again at
    1050. That decision comes a second late, at 1051: it plans anew, and d1
    starts as of its turn at 1050. So d2 can still start at 1100, and the
    plan keeps three at once and d2 its window."""
    c = controller([("w", 1000, 2000)], devices("d", 3, 600, "w"), 3, 6, rung=3, stagger=25)
    s = c.decide(1000)
    testing.assertEqual((s.started, s.wake, c.quiet_until), (["d0"], 1050, 1051))
    s = c.decide(1051)
    testing.assertEqual((s.started, s.wake, s.plan.c), (["d1"], 1100, 3))
    s = c.decide(1100)
    testing.assertEqual((s.started, s.plan.alarms), (["d2"], []))


def _test_the_stagger_does_not_hold_devices_that_reported_before_their_release():
    """Five devices that report up to date before their release, then
    three of 600 s, three at a time with the ramp at three, staggered over
    a whole upgrade: 200 s from one start to the next. They report at 0,
    the second the run starts in. The five run no upgrade, so the stagger
    does not hold them: they start as fast as the ramp allows, and r0
    starts with the last two. Then r1 and r2 follow 200 s apart."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    c = controller(wins, devices("u", 5, 600, "w") + devices("r", 3, 600, "w"), 3, 3, rung=3,
                   stagger=100)
    for i in range(5):
        c.report("u{i}", "up-to-date", 0)
    cases = [
        (0, ["u0", "u1", "u2"], 1),
        (1, ["u3", "u4", "r0"], 2),
        (2, [], 201),
        (201, ["r1"], 401),
        (401, ["r2"], 601),
    ]
    for case in cases:
        s = c.decide(case.0)
        testing.assertEqual(s.started, case.1, "started at {case.0}")
        testing.assertEqual(s.wake, case.2, "wake at {case.0}")


def _test_a_report_of_a_device_no_longer_in_the_campaign_ends_the_quiet():
    """x and four devices of 600 s, two at a time, staggered over a whole
    upgrade: 300 s from one start to the next. x starts and then leaves
    the campaign. Its report at 450 counts at 451 and takes the pace to
    525 s, so the gap after d0 shrinks to 262 s. The plan at 450 ends its
    quiet at 451, and the decision at 500 plans anew: d1 may start at 562,
    not 600."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = devices("x", 1, 600, "w") + devices("d", 4, 600, "w")
    c = controller(wins, devs, 2, 2, debounce=1, rung=2, stagger=100)
    testing.assertEqual(c.decide(0).started, ["x0"])
    c.configure(wins, devs[1:], 2, 2, False, 1, 600, stagger=100)
    testing.assertEqual(c.decide(300).started, ["d0"])
    c.report("x0", "succeeded", 450)
    s = c.decide(450)
    testing.assertEqual((s.started, s.wake, c.quiet_until), ([], 600, 451))
    s = c.decide(500)
    testing.assertEqual((s.started, s.wake, s.plan.starts.get("d1")), ([], 562, (0, 562)))


def _test_a_new_close_margin_takes_effect():
    """x, of 600 s, and y, of 100 s, two at a time, in a window that
    closes at 10000. At 9300 the 700 s left are too short for x, which
    needs 900 s at the default close margin of 150 percent, and y starts.
    The window then looks at x again only when the slow time falls. New
    limits that change only the close margin, to 100 percent, look at x
    again, and x starts with the 600 s it then needs."""
    wins = [("w", 0, 10000)]
    devs = [("x", 600, "w"), ("y", 100, "w")]
    c = controller(wins, devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(9300).started, ["y"])
    c.configure(wins, devs, 2, 2, False, 0, 600, close_margin=100)
    testing.assertEqual(c.close_margin, 100)
    testing.assertEqual(c.decide(9300).started, ["x"])


def _test_new_limits_hold_the_ramp_to_the_new_target():
    """10 at once, the ramp at 10, in a window that never closes: d0 to
    d9 start. New limits of 4 at once hold the ramp to 4 too. When d0 to
    d6 succeed, 3 devices are in flight, and d10 starts. Limits of 10 at
    once again leave the ramp at 4, so nothing starts until a device
    succeeds, and then each device that succeeds lets three more start,
    as on the way up: when d7 succeeds, the ramp lets 7 be in flight, and
    d11 to d14 start; when d8 succeeds, 10, and d15 to d18 start."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = devices("d", 30, 600, "w")
    c = controller(wins, devs, 10, 10, rung=10)
    testing.assertEqual(c.decide(0).started, ["d{i}" for i in range(10)])
    c.configure(wins, devs, 4, 4, False, 0, 600)
    testing.assertEqual(c.rung, 4)
    for i in range(7):
        c.report("d{i}", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d10"])
    c.configure(wins, devs, 10, 10, False, 0, 600)
    s = c.decide(700)
    testing.assertEqual((s.plan.c, s.started, c.rung), (10, [], 4))
    # (the device that succeeds, when, the devices that start, the ramp
    # after)
    cases: list[(str, int, list[str], int)] = [
        ("d7", 800, ["d11", "d12", "d13", "d14"], 7),
        ("d8", 810, ["d15", "d16", "d17", "d18"], 10),
    ]
    for case in cases:
        c.report(case.0, "succeeded", case.1)
        testing.assertEqual(c.decide(case.1).started, case.2, case.0)
        testing.assertEqual(c.rung, case.3, case.0)


def _test_the_slow_time_follows_the_last_upgrades():
    """One at a time, in a window that never closes, at a campaign
    estimate of 100 s. The devices take the times of slow_then_fast(), in
    the order s0, f0, s1 and f1 to f48. At one at a time the pace is the
    last upgrade's time, and the slow time is the second longest of the 50
    kept times, or the pace when that is longer. So s0 alone makes the
    slow time 300 s only until f0 counts. With s1, two slow upgrades are
    among the kept times, and the slow time stays 300 s, though the pace
    is 80 s or 90 s. When f48 counts, s0's time has left the kept times,
    and the slow time falls to 90 s."""
    order = ["s0", "f0", "s1"] + ["f{i}" for i in range(1, 49)]
    took = slow_then_fast()
    c = controller([("w", 0, fleet_ctl.OPEN_END)], [(n, 100, "w") for n in order], 1, 1,
                   estimate=100)
    c.decide(0)
    t = 0
    slow: list[int] = []
    for name in order:
        t += took[name]
        c.report(name, "succeeded", t)
        c.decide(t)
        slow.append(c.slow_s)
    testing.assertEqual(slow, [300, 100] + [300 for _k in range(48)] + [90])


def newest(c: Controller, n: int) -> list[int]:
    """The newest n upgrade times the controller c keeps, newest first."""
    m = len(c.took_s)
    return [c.took_s[(c.took_at - 1 - j + m) % m] for j in range(n)]


def _test_fast_upgrades_that_end_together_do_not_push_slow_ones_out_of_view():
    """40 at once in a window that never closes, at a campaign estimate
    of 600 s: the controller keeps the last 80 upgrade times, two rounds
    at max-concurrency, and the slow time is their second longest. 40
    devices start together. s0 and s1, of 100 s, take 300 s, 1800 s at
    the campaign's estimate, and their times count first. The fast
    devices, of 600 s, take 590 s each, and their times count in batches
    of 38, 2 and then the rest. While both slow times are among the last
    80, the slow time stays 1800 s: after 60 fast times, and after
    78. Taken from only the last 50 times, the ones of the pace at a
    target of 40, it would fall to 590 s. After 79 fast times, s0's time
    is no longer among the last 80, and the slow time falls to 590 s."""
    # (how many fast devices, the slow time at the end, the slow time of
    # the last 50 times)
    cases: list[(int, int, int)] = [
        (60, 1800, 590),
        (78, 1800, 590),
        (79, 590, 590),
    ]
    for case in cases:
        devs = [("s0", 100, "w"), ("s1", 100, "w")] + devices("f", case.0, 600, "w")
        took = {"s0": 300, "s1": 300}
        for i in range(case.0):
            took["f{i}"] = 590
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 40, 40, rung=40)
        sim.drive(c, 0, took, DAY)
        testing.assertEqual(len(c.done_times()), len(devs), "{case.0} fast")
        testing.assertEqual(len(c.took_s), 80, "{case.0} fast")
        testing.assertEqual(c.slow_s, case.1, "{case.0} fast")
        testing.assertEqual(fleet_ctl.slow_time(newest(c, 50), c.observed_s), case.2,
                            "{case.0} fast, the last 50 times")


def _test_the_runs_ahead_of_a_plan_see_one_slow_time_at_every_concurrency():
    """Target 20 and up to 64, in a window that never closes, at a
    campaign estimate of 600 s. The controller keeps the last 128 upgrade
    times, two rounds at max-concurrency, and a run starts as if they
    took 600 s. A step at 64 starts s0 and s1, of 100 s, and f0 to f59,
    of 600 s. s0 and s1 take 300 s, 1800 s at the campaign's estimate.
    Copies of the controller step at 20, 40 and 64, as the runs ahead of
    a plan do, and each takes the slow time from all 128 kept times:
    their 98th percentile is the third longest, 600 s, and the pace, the
    mean of the last 25 times, (23 * 600 + 2 * 1800) / 25 = 696 s, is
    longer. So the slow time is 696 s at each concurrency. Then f0 to f59
    take 590 s, and each copy steps again at its concurrency: the pace is
    590 s, and the slow time the third longest of the 128 times, 600 s.
    Taken over two rounds at the concurrency of the step, the slow time
    would be 1800 s at 20 and at 40 after the first step, and 590 s at 20
    and 1800 s at 40 after the second."""
    devs = [("s0", 100, "w"), ("s1", 100, "w")] + devices("f", 60, 600, "w")
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 20, 64, rung=64)
    testing.assertEqual(len(c.step(0, 64).0), 62)
    testing.assertEqual(len(c.took_s), 128)
    c.report("s0", "succeeded", 300)
    c.report("s1", "succeeded", 300)
    for conc in [20, 40, 64]:
        x = c.copy()
        x.step(300, conc)
        testing.assertEqual((x.observed_s, x.slow_s), (696, 696), "the step at 300 at {conc}")
        for i in range(60):
            x.report("f{i}", "succeeded", 590)
        x.step(590, conc)
        testing.assertEqual((x.observed_s, x.slow_s), (590, 600), "the step at 590 at {conc}")


def _test_the_upgrade_times_kept_follow_the_max_concurrency():
    """One at a time and up to 49: the controller keeps the last 98
    upgrade times, two rounds at max-concurrency, and a run starts as if
    they took 600 s. Three upgrades take 1800, 1500 and 630 s. The pace
    is the last time, 630 s, and the slow time the 98th percentile of the
    98 kept times, the second longest, 1500 s. New limits keep the newest
    times, and take the slow time from them again. Up to 50 keeps 100: the
    98 and two older ones at the pace. The 98th percentile of 100 times
    is the third longest, so the slow time falls to 630 s. Up to 16 then
    keeps the newest 50: the three and 47 of the 600 s, and the slow time
    is 1500 s again. Up to 40 keeps 80: those 50, and 30 older ones at the
    pace."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = devices("d", 4, 600, "w")
    c = controller(wins, devs, 1, 49)
    testing.assertEqual(c.took_s, [600 for _k in range(98)])
    c.decide(0)
    t = 0
    k = 0
    for took in [1800, 1500, 630]:
        t += took
        c.report("d{k}", "succeeded", t)
        c.decide(t)
        k += 1
    testing.assertEqual((len(c.took_s), newest(c, 3), c.observed_s, c.slow_s),
                        (98, [630, 1500, 1800], 630, 1500), "up to 49")
    three = [1800, 1500, 630]
    # (the new max-concurrency, the times it keeps, the oldest first, and
    # the slow time)
    cases: list[(int, list[int], int)] = [
        (50, [630, 630] + [600 for _k in range(95)] + three, 630),
        (16, [600 for _k in range(47)] + three, 1500),
        (40, [630 for _k in range(30)] + [600 for _k in range(47)] + three, 1500),
    ]
    for case in cases:
        c.configure(wins, devs, 1, case.0, False, 0, 600)
        testing.assertEqual((c.took_s, c.observed_s, c.slow_s), (case.1, 630, case.2),
                            "up to {case.0}")


def _test_a_close_margin_longer_than_every_window_stops_the_campaign_with_an_alarm():
    """A 1000 s window every day for three days, and three devices of
    300 s, one at a time, so the pace is the last upgrade's time. The
    campaign's estimate is 600 s. d0 takes 700 s, which counts as 1400 s
    at the campaign's estimate, so the slow time of d1 and d2 is 700 s.
    With a close margin of 150 percent, they need 1050 s, more than every
    window: they start in no window, and the plan at the second window's
    opening says why. With a close margin of 140 percent, they need 980 s,
    and start in the second window."""
    wins = daily("w", 0, 1000, 3)
    # (the close margin, the devices that start, the alarm at the second
    # window's opening that says why devices start in no window)
    cases: list[(int, list[str], list[str])] = [
        (150, ["d0"],
         ["2 device(s) fit in no window: 150 percent of their slow time, 1400 s at the "
          + "campaign's estimate, is longer than the time left in every window of their "
          + "schedule: d1, d2"]),
        (140, ["d0", "d1", "d2"], []),
    ]
    for case in cases:
        c = controller(wins, devices("d", 3, 300, "w"), 1, 1, estimate=600,
                       close_margin=case.0)
        ds = sim.drive(c, 0, {"d0": 700}, 3 * DAY)
        testing.assertEqual(sorted(list(c.released_devices())), case.1, str(case.0))
        at_day: list[str] = []
        for d in ds:
            if d.t == DAY:
                at_day.extend([a for a in d.alarms if "fit in no window" in a])
        testing.assertEqual(at_day, case.2, str(case.0))


def _test_the_plan_says_that_devices_fit_in_no_window_when_the_slow_upgrade_counts():
    """One device at a time, at a campaign estimate of 600 s. d0 takes
    1400 s at the campaign's estimate, and its report counts at its end.
    The plan of that decision takes the slow time of the reports that
    count, 1400 s, and says that d1 and d2 fit in no window: they need
    one and a half times their slow time, and the time left in each window
    of their schedule is shorter. With a 1000 s window every day for
    three days, and devices of 300 s, d0 takes 700 s: d1 and d2 need
    1050 s, more than a window. With one window from 0 to a deadline at
    3000, and devices of 600 s, d0 takes 1400 s: d1 and d2 need 2100 s,
    less than the window, but more than the 1600 s left at 1400."""
    alarm = ("2 device(s) fit in no window: 150 percent of their slow time, 1400 s at the "
             + "campaign's estimate, is longer than the time left in every window of their "
             + "schedule: d1, d2")
    # (the windows, whether they end at a deadline, the estimate of the
    # devices, how long d0 takes, the time of the first decision whose
    # plan says that devices fit in no window)
    cases: list[(list[(str, int, int)], bool, int, int, int)] = [
        (daily("w", 0, 1000, 3), False, 300, 700, 700),
        ([("w", 0, 3000)], True, 600, 1400, 1400),
    ]
    for case in cases:
        c = controller(case.0, devices("d", 3, case.2, "w"), 1, 1, case.1)
        first = (-1, "")
        for d in sim.drive(c, 0, {"d0": case.3}, 3 * DAY):
            for a in d.alarms:
                if first.0 < 0 and "fit in no window" in a:
                    first = (d.t, a)
        testing.assertEqual(first, (case.4, alarm), str(case.0))


def _test_one_long_upgrade_does_not_stop_the_campaign():
    """nights(), and d13, the first device of the second night, takes
    1700 s, more than two thirds of a night: one and a half times it is
    longer than the night. The slow time is the second longest of the
    last 64 upgrade times, two rounds at max-concurrency, or the pace when
    that is longer. So this one upgrade moves it only through the pace,
    the mean of the last ten upgrades, to 710 s. The slow time stays below
    two thirds of a night, and no plan says that a device fits in no
    window. d13 holds its slot.
    It is late at 00:12:01, and the plan expects it to end one upgrade
    later, at 00:22:01, and rises to 9: then d36, the last device
    promised to the second night, can take d13's slot. d13 is late again
    at 00:24:02, and the plan says that d36 will miss the night. When
    d13's 1700 s count, at 00:28:21, the night has no room for d36 left:
    699 s, and d36 needs one and a half times 710 s. So with room up to
    32, every device starts, one promise breaks, and no device is in
    flight when its window closes."""
    cp = nights()
    o = run(cp, cp.maxc, {"d13": 1700})
    room = "d13 takes 1700 s, up to {cp.maxc}"
    problems = out_of_bounds(o, room, cp.maxc, 1, 0)
    if o.slowest >= 1600:
        problems.append("{room}: the slow time goes up to {o.slowest} s")
    if o.unfit > 0:
        problems.append("{room}: {o.unfit} plans say that devices fit in no window")
    testing.assertTrue(len(problems) == 0, "\n" + "\n".join(problems))


def pairs(n: int) -> (dict[str, list[str]], dict[str, int]):
    """Redundancy groups of two of the devices d0, d1, ...: d0 and d1, d2
    and d3, and so on, the second of each pair first. Returns the groups
    and the priorities."""
    groups: dict[str, list[str]] = {}
    priority: dict[str, int] = {}
    for k in range(n // 2):
        groups["g{k}"] = ["d{2 * k}", "d{2 * k + 1}"]
        priority["d{2 * k}"] = 2
        priority["d{2 * k + 1}"] = 1
    return (groups, priority)


def _test_the_member_before_comes_by_priority_then_name():
    """Each member of a redundancy group waits for the member before it,
    by priority and then name, in each of its groups. A member that is
    not in the campaign orders nothing."""
    cases: list[(dict[str, list[str]], dict[str, int], dict[str, list[(str, str)]])] = [
        ({"g": ["a", "b"]}, {"a": 2, "b": 1}, {"a": [("b", "g")]}),
        ({"g": ["b", "a"]}, {"a": 1, "b": 1}, {"b": [("a", "g")]}),
        ({"g": ["a", "c", "b"]}, {"a": 1, "c": 2, "b": 3}, {"c": [("a", "g")], "b": [("c", "g")]}),
        ({"g": ["a", "x"]}, {"a": 1, "x": 0}, {}),
        ({"g1": ["a", "c"], "g2": ["b", "c"]}, {"a": 1, "b": 1, "c": 2},
         {"c": [("a", "g1"), ("b", "g2")]}),
    ]
    devs = [("a", 600, "w"), ("b", 600, "w"), ("c", 600, "w")]
    for case in cases:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups=case.0,
                       priority=case.1)
        testing.assertEqual(c.before, case.2, str(case.0))


def _test_members_start_one_at_a_time_by_priority():
    """r1 and r2 back each other up. r1 has the lower priority, so it
    goes first, though r2 comes first in the campaign. d0 is in no group
    and starts with r1. r2 starts when r1 is done, not when d0 is."""
    devs = [("r2", 600, "w"), ("r1", 600, "w"), ("d0", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4, groups={"g": ["r1", "r2"]},
                   priority={"r1": 10, "r2": 20}, rung=4)
    testing.assertEqual(c.decide(0).started, ["r1", "d0"])
    c.report("d0", "succeeded", 300)
    testing.assertEqual(c.decide(300).started, [])
    c.report("r1", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["r2"])


def _test_a_device_in_two_groups_waits_for_both():
    """x comes after a in one group and after b in another. a and b share
    no group, so they start together; x starts when both are done, and
    after the min-separation of each group has passed."""
    devs = [("x", 600, "w"), ("a", 600, "w"), ("b", 600, "w")]
    # (the separations, and the devices that start when b is done at 700
    # and the next decision; b took 700 s, so x is expected to take 620 s)
    cases: list[(dict[str, (bool, int)], (list[str], int))] = [
        ({}, (["x"], 1320)),
        ({"g1": (False, 600), "g2": (False, 0)}, ([], 1200)),
        ({"g1": (False, 0), "g2": (False, 600)}, ([], 1300)),
    ]
    for case in cases:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4,
                       groups={"g1": ["a", "x"], "g2": ["b", "x"]},
                       priority={"a": 1, "b": 1, "x": 2}, separation=case.0, rung=4)
        testing.assertEqual(c.decide(0).started, ["a", "b"])
        c.report("a", "succeeded", 600)
        testing.assertEqual(c.decide(600).started, [])
        c.report("b", "succeeded", 700)
        s = c.decide(700)
        testing.assertEqual((s.started, s.wake), case.1, str(case.0))


def _test_a_member_added_before_a_member_in_flight_waits_for_it():
    """b upgrades. An operator adds a to the campaign and to b's group,
    with a lower priority than b's. a starts only when b is done."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    c = controller(wins, [("b", 600, "w")], 2, 2, groups={"g": ["b"]}, priority={"b": 2},
                   rung=2)
    testing.assertEqual(c.decide(0).started, ["b"])
    c.configure(wins, [("a", 600, "w"), ("b", 600, "w")], 2, 2, False, 0, 600,
                {"g": ["a", "b"]}, {"a": 1, "b": 2})
    sim.answer_all(c, 100)
    testing.assertEqual(c.decide(100).started, [])
    c.report("b", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["a"])


def _test_a_failed_member_holds_the_other_members():
    """r1 fails, so r2 and r3 wait for an operator. The plan that sees the
    failure says so, and keeps r2 and r3 in their window, also when the
    run stops. The devices it holds do not raise the concurrency, and d0,
    in no group, still starts."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("r3", 600, "w"), ("d0", 600, "w")]
    c = controller([("w", 0, DAY)], devs, 1, 10, True, groups={"g": ["r1", "r2", "r3"]},
                   priority={"r1": 1, "r2": 2, "r3": 3})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "failed", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["d0"])
    testing.assertEqual(s.plan.c, 1)
    testing.assertEqual(s.plan.alarms,
                        ["2 device(s) wait behind a failed redundancy group member: "
                         + "r2, r3"])
    testing.assertEqual([e.0 for e in c.layout(s.plan)[0].3], ["r1", "d0", "r2", "r3"])
    c.stop()
    testing.assertEqual([e.0 for e in c.layout(c.plan(700))[0].3], ["r1", "d0", "r2", "r3"])


def _test_a_failed_member_holds_the_members_after_the_held_ones():
    """r1 fails. r2 waits behind r1 in one group, and r3 waits behind r2 in
    another: the plan holds both."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("r3", 600, "w"), ("d0", 600, "w")]
    c = controller([("w", 0, DAY)], devs, 1, 10, True,
                   groups={"g1": ["r1", "r2"], "g2": ["r2", "r3"]},
                   priority={"r1": 1, "r2": 2, "r3": 3})
    c.decide(0)
    c.report("r1", "failed", 600)
    testing.assertEqual(c.decide(600).plan.alarms,
                        ["2 device(s) wait behind a failed redundancy group member: "
                         + "r2, r3"])


def _test_a_failure_that_has_not_counted_yet_holds_the_members():
    """a reports a failure after its upgrade was expected to end, and the
    failure counts one debounce later. A plan before then holds b already,
    in the first window, and gives d, in no group, the room left there."""
    wins = [("w", 0, 1600), ("w", DAY, DAY + 1600)]
    devs = [("a", 600, "w"), ("b", 600, "w"), ("d", 600, "w")]
    c = controller(wins, devs, 1, 1, debounce=5, groups={"g": ["a", "b"]},
                   priority={"a": 1, "b": 2})
    c.resume("a", 0, wins[0])
    c.report("a", "failed", 600)
    p = c.decide(601).plan
    testing.assertEqual(p.alarms,
                        ["1 device(s) wait behind a failed redundancy group member: b"])
    testing.assertEqual(p.starts, {"d": (0, 605)})
    testing.assertEqual(p.held, {"b": (0, 601)})


def _test_a_failed_member_holds_a_member_added_before_it():
    """b fails. An operator adds a to the campaign and to b's group, with a
    lower priority than b's. a waits too, in the window of its schedule."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    c = controller(wins, [("b", 600, "w")], 1, 1, groups={"g": ["b"]}, priority={"b": 2})
    testing.assertEqual(c.decide(0).started, ["b"])
    c.report("b", "failed", 600)
    c.decide(600)
    c.configure(wins, [("a", 600, "w"), ("b", 600, "w")], 1, 1, False, 0, 600,
                {"g": ["a", "b"]}, {"a": 1, "b": 2})
    sim.answer_all(c, 700)
    s = c.decide(700)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.plan.alarms,
                        ["1 device(s) wait behind a failed redundancy group member: a"])
    testing.assertEqual([e.0 for e in c.layout(s.plan)[0].3], ["b", "a"])


def _test_a_held_member_keeps_the_later_window_promised_to_it():
    """r1 starts, and d fills the rest of the first window, so r2, of
    15 min, is promised the second. r1 fails: r2 keeps the second window,
    though the first is still open."""
    wins = [("w", 0, 1600), ("w", DAY, DAY + 1600)]
    devs = [("r1", 600, "w"), ("d", 600, "w"), ("r2", 900, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2})
    testing.assertEqual(c.decide(0).plan.starts["r2"], (1, DAY))
    c.report("r1", "failed", 600)
    p = c.decide(600).plan
    testing.assertEqual(p.held, {"r2": (1, DAY)})
    testing.assertEqual([(w.1, [e.0 for e in w.3]) for w in c.layout(p)],
                        [(0, ["r1", "d"]), (DAY, ["r2"])])


def _test_a_held_member_without_a_promise_leaves_its_window_to_others():
    """r1 is down when the run starts, so r1 and r2 wait. The plan shows
    them in the first window but does not promise it to them, and fills it
    with d0 to d9. r1 comes back up before the window opens: the devices
    promised the first window keep it, and r1 and r2 go where there is
    room."""
    wins = daily("day", HOUR, HOUR, 5)
    devs = [("r1", 600, "day"), ("r2", 600, "day")] + devices("d", 12, 600, "day")
    c = controller(wins, devs, 2, 2, groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2},
                   rung=2)
    c.set_live("r1", False)
    p = c.decide(0).plan
    testing.assertEqual(p.held, {"r1": (0, HOUR), "r2": (0, HOUR)})
    testing.assertEqual(sorted([n for n, s in p.starts.items() if s.0 == 0]),
                        ["d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8", "d9"])
    c.set_live("r1", True)
    p = c.decide(1800).plan
    testing.assertEqual(p.alarms, [])
    testing.assertEqual((p.starts["r1"].0, p.starts["r2"].0), (1, 1))


def _test_a_member_looked_at_again_keeps_its_place_in_the_promises():
    """d1, of 25 min, is promised the first window before h. f fails, so h
    waits, and when f reports a success, h is looked at again. d1 still
    starts first, and h after it, so both keep the window."""
    wins = [("w", 0, 3600), ("w", DAY, DAY + 3600)]
    devs = [("f", 600, "w"), ("d0", 600, "w"), ("d1", 1500, "w"), ("h", 600, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["f", "h"]}, priority={"f": 1, "h": 2})
    c.decide(0)
    c.report("f", "failed", 600)
    c.decide(600)
    c.report("f", "succeeded", 700)
    c.decide(700)
    c.report("d0", "succeeded", 1200)
    s = c.decide(1200)
    testing.assertEqual(s.started, ["d1"])
    testing.assertEqual(s.plan.starts.get("h"), (0, 2700))
    testing.assertEqual(s.plan.alarms, [])


def _test_members_looked_at_again_start_in_the_order_of_their_promises():
    """f1 and f2 fail, so h1 and h2 wait, and d1 and d2 take both slots.
    f2 reports a success, then f1, so h2 is looked at again before h1.
    h1 was promised the window before h2, so h1 starts in the first free
    slot, and h2 in the next one: both keep the window."""
    wins = [("w", 0, 7200)]
    devs = [("f1", 600, "w"), ("f2", 600, "w"), ("h1", 600, "w"), ("h2", 600, "w"),
            ("d1", 1200, "w"), ("d2", 1800, "w")]
    c = controller(wins, devs, 2, 2, groups={"g1": ["f1", "h1"], "g2": ["f2", "h2"]},
                   priority={"f1": 1, "h1": 2, "f2": 1, "h2": 2}, rung=2)
    testing.assertEqual(c.decide(0).started, ["f1", "f2"])
    c.report("f1", "failed", 600)
    c.report("f2", "failed", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2"])
    c.report("f2", "succeeded", 700)
    c.decide(700)
    c.report("f1", "succeeded", 800)
    testing.assertEqual(c.decide(800).plan.alarms, [])
    c.report("d1", "succeeded", 1800)
    s = c.decide(1800)
    testing.assertEqual(s.started, ["h1"])
    testing.assertEqual(s.plan.starts, {"h1": (0, 1800), "h2": (0, 2400)})


def _test_a_member_looked_at_again_starts_before_later_promises():
    """h is promised the window before d. f fails, so h waits, and x takes
    the slot. f reports a success, so h is looked at again. When x is
    done, h starts before d."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = [("f", 600, "w"), ("h", 600, "w"), ("x", 600, "w"), ("d", 600, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["f", "h"]}, priority={"f": 1, "h": 2})
    testing.assertEqual(c.decide(0).plan.starts,
                        {"f": (0, 0), "h": (0, 600), "x": (0, 1200), "d": (0, 1800)})
    c.report("f", "failed", 600)
    testing.assertEqual(c.decide(600).started, ["x"])
    c.report("f", "succeeded", 700)
    c.decide(700)
    c.report("x", "succeeded", 1200)
    s = c.decide(1200)
    testing.assertEqual(s.started, ["h"])
    testing.assertEqual(s.plan.starts, {"h": (0, 1200), "d": (0, 1800)})


def _test_the_promises_follow_the_order_of_the_starts():
    """b waits for a, and y and z each wait 5 min after the member before
    them. One at a time, the run starts x, a, y, b and z: y's
    min-separation passes before a is done, so y starts before b. The
    promises go in that order, so the run ahead with them is the same,
    and z still fits."""
    wins = [("w", 0, 3300)]
    devs = [("b", 600, "w"), ("y", 600, "w"), ("z", 600, "w"), ("x", 600, "w"),
            ("a", 600, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["a", "b"], "h": ["x", "y", "z"]},
                   priority={"a": 1, "b": 2, "x": 1, "y": 2, "z": 3},
                   separation={"h": (False, 300)})
    p = c.plan(0)
    testing.assertEqual(p.starts, {"x": (0, 0), "a": (0, 600), "y": (0, 1200),
                                   "b": (0, 1800), "z": (0, 2400)})
    testing.assertEqual(p.alarms, [])


def _test_an_operator_frees_the_members_of_a_failed_one():
    """r1 rolls back and r2 waits. When the operator takes r1 out of the
    group, or out of the campaign, r2 starts."""
    wins = [("w", 0, DAY)]
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    priority = {"r1": 1, "r2": 2}
    # (what the operator does, devices, groups)
    cases: list[(str, list[(str, int, str)], dict[str, list[str]])] = [
        ("out of the group", devs, {"g": ["r2"]}),
        ("out of the campaign", [("r2", 600, "w")], {"g": ["r2"]}),
    ]
    for case in cases:
        c = controller(wins, devs, 1, 1, groups={"g": ["r1", "r2"]}, priority=priority)
        testing.assertEqual(c.decide(0).started, ["r1"], case.0)
        c.report("r1", "rolled-back", 600)
        testing.assertEqual(c.decide(600).started, [], case.0)
        c.configure(wins, case.1, 1, 1, False, 0, 600, case.2, priority)
        testing.assertEqual(c.decide(700).started, ["r2"], case.0)


def _test_a_later_success_frees_the_rest():
    """r1 fails and r2 waits. An operator fixes r1, and when r1 reports a
    success, whether or not it reported another status first, r2
    starts."""
    # (the reports of r1 after its failure, at 700 and 1300)
    cases: list[list[(int, str)]] = [
        [(700, "in-progress"), (1300, "succeeded")],
        [(1300, "up-to-date")],
        [(1300, "succeeded")],
    ]
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    for case in cases:
        c = controller([("w", 0, DAY)], devs, 1, 1, groups={"g": ["r1", "r2"]},
                       priority={"r1": 1, "r2": 2})
        testing.assertEqual(c.decide(0).started, ["r1"])
        c.report("r1", "failed", 600)
        testing.assertEqual(c.decide(600).started, [])
        started: list[str] = []
        for r in case:
            c.report("r1", r.1, r.0)
            started = c.decide(r.0).started
        testing.assertEqual(started, ["r2"], str(case))


def _test_a_retried_member_keeps_its_min_separation_from_its_success():
    """r1 fails, and reports a success after a retry. r2 starts no sooner
    than the min-separation of 30 min after that success."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2}, separation={"g": (False, 1800)})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "failed", 600)
    c.decide(600)
    c.report("r1", "succeeded", 5000)
    s = c.decide(5000)
    testing.assertEqual((s.started, s.wake), ([], 6800))
    testing.assertEqual(c.decide(6800).started, ["r2"])


def _test_a_member_held_past_its_window_starts_when_freed():
    """r comes after q in one group and after z in another. z ends late,
    when the window r was promised has no room left for it, and the
    window that never closes passes r over for its promise. Then q fails,
    so r waits while its window closes, and its promise moves to the
    window that never closes. When q reports a success after a retry, r
    starts there."""
    wins = [("s", 0, 230), ("s", 0, fleet_ctl.OPEN_END)]
    devs = [("q", 100, "s"), ("z", 100, "s"), ("r", 100, "s")]
    c = controller(wins, devs, 2, 2, estimate=100, groups={"g1": ["q", "r"], "g2": ["z", "r"]},
                   priority={"q": 1, "z": 1, "r": 2}, rung=2)
    testing.assertEqual(c.decide(0).started, ["q", "z"])
    c.decide(100)
    c.decide(101)
    c.report("z", "succeeded", 120)
    c.decide(120)
    c.report("q", "failed", 130)
    c.decide(130)
    c.report("q", "in-progress", 200)
    c.decide(200)
    c.report("q", "succeeded", 300)
    testing.assertEqual(c.decide(300).started, ["r"])


def _test_a_success_within_the_debounce_frees_the_rest():
    """r1 fails, and reports up-to-date before its failure counts. The
    success counts, so r2 starts."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, DAY)], devs, 1, 1, debounce=5, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "failed", 600)
    c.report("r1", "up-to-date", 603)
    testing.assertEqual(c.decide(605).started, ["r2"])


def _test_members_wait_while_a_member_is_down():
    """z backs up r1 and r2 but is not in the campaign. While z, or r1
    itself, is down, neither r1 nor r2 starts, and the plan says so and
    why; d0, in no group, starts. When the device comes back up, r1
    starts."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("d0", 600, "w")]
    # (the device that is down, the alarms, why each device is held)
    cases: list[(str, list[str], dict[str, (str, str)])] = [
        ("z", ["2 device(s) wait while a redundancy group member is down: r1, r2"],
         {"r1": ("group-down", "z"), "r2": ("group-down", "z")}),
        ("r1", ["1 device(s) are down: r1",
                "1 device(s) wait while a redundancy group member is down: r2"],
         {"r1": ("down", ""), "r2": ("group-down", "r1")}),
    ]
    for case in cases:
        down = case.0
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4,
                       groups={"g": ["r1", "r2", "z"]}, priority={"r1": 1, "r2": 2, "z": 3},
                       rung=4)
        c.set_live(down, False)
        s = c.decide(0)
        testing.assertEqual(s.started, ["d0"], down)
        testing.assertEqual(s.plan.alarms, case.1, down)
        testing.assertEqual(s.plan.why, case.2, down)
        testing.assertEqual(s.plan.starts, {"d0": (0, 0)}, down)
        c.set_live(down, True)
        s = c.decide(10)
        testing.assertEqual(s.started, ["r1"], down)
        testing.assertEqual(s.plan.alarms, [], down)
        testing.assertEqual(s.plan.why, {}, down)


def _test_a_member_that_reports_while_down_holds_the_others():
    """a goes down while it upgrades, and reports a success while it is
    still down. b waits until a is back up."""
    devs = [("a", 600, "w"), ("b", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups={"g": ["a", "b"]},
                   priority={"a": 1, "b": 2})
    testing.assertEqual(c.decide(0).started, ["a"])
    c.set_live("a", False)
    c.report("a", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.plan.alarms,
                        ["1 device(s) wait while a redundancy group member is down: b"])
    c.set_live("a", True)
    testing.assertEqual(c.decide(700).started, ["b"])


def _test_a_member_down_while_it_upgrades_keeps_the_plan():
    """a goes down while it upgrades, as a device does when it reboots.
    The plan expects it back up when its upgrade ends, so b keeps its
    place right after a, in the first window."""
    wins = [("w", 0, 1500), ("w", 5000, 8000)]
    devs = [("a", 600, "w"), ("b", 600, "w"), ("d", 100, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["a", "b"]}, priority={"a": 1, "b": 2})
    testing.assertEqual(c.decide(0).started, ["a"])
    c.set_live("a", False)
    s = c.decide(10)
    testing.assertEqual(s.plan.alarms, [])
    testing.assertEqual(s.plan.starts["b"], (0, 600))
    c.set_live("a", True)
    c.report("a", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["b"])


def _test_set_live_says_when_the_quiet_time_ends():
    """a starts at 0, b and c wait, with a debounce of 5 s. A change of a
    member that waits, or of a device in a redundancy group that is not in
    flight without a report, ends the quiet time, and set_live returns
    True. So does a change of a member in flight without a report that was
    past its expected end at the last step. A change of any other member in
    flight or done in no group, of a member in flight without a report in a
    group, a value that does not change, and an unknown device that is up
    return False and keep the quiet time."""
    devs = [("a", 600, "w"), ("b", 600, "w"), ("c", 600, "w")]
    # (the redundancy groups, the device that goes down and comes back up,
    # a's report at 600 or "", when the last step is, returned)
    cases: list[(dict[str, list[str]], str, str, int, bool)] = [
        ({}, "a", "", 0, False),
        ({}, "a", "", 700, True),
        ({}, "a", "succeeded", 601, False),
        ({}, "a", "succeeded", 605, False),
        ({"g": ["a", "c"]}, "a", "", 0, False),
        ({"g": ["a", "c"]}, "a", "succeeded", 601, True),
        ({"g": ["a", "c"]}, "a", "succeeded", 605, True),
        ({}, "b", "", 0, True),
        ({"g": ["b", "c"]}, "b", "", 0, True),
    ]
    for case in cases:
        label = "{case.1} in groups {case.0}, a's report {case.2}, last step at {case.3}"
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, debounce=5, groups=case.0)
        testing.assertEqual(c.decide(0).started, ["a"], label)
        if case.2 != "":
            c.report("a", case.2, 600)
        if case.3 > 0:
            c.decide(case.3)
        testing.assertEqual(c.done_time("a") is not None, case.3 == 605, "done, " + label)
        quiet = c.quiet_until
        testing.assertTrue(quiet > 0, "quiet until {quiet}, " + label)
        testing.assertEqual(c.set_live(case.1, False), case.4, "down, " + label)
        testing.assertEqual(c.quiet_until == quiet, not case.4, "quiet, " + label)
        testing.assertEqual(c.set_live(case.1, False), False, "down again, " + label)
        c.quiet_until = quiet
        testing.assertEqual(c.set_live(case.1, True), case.4, "up, " + label)
        testing.assertEqual(c.quiet_until == quiet, not case.4, "quiet when up, " + label)
        testing.assertEqual(c.set_live("x", True), False, "unknown, " + label)


def _test_a_pack_group_keeps_its_min_separation():
    """r2 starts no sooner than the min-separation of 300 s after r1 is
    done, and the controller decides again then."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2}, separation={"g": (False, 300)})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual((s.started, s.wake), ([], 900))
    testing.assertEqual(c.decide(900).started, ["r2"])


def _test_a_min_separation_past_the_deadline_alarms():
    """A min-separation of 1 h puts r2 after the window that the deadline
    ends: the plan says r2 cannot start before the deadline."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, HOUR)], devs, 1, 4, True, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2}, separation={"g": (False, HOUR)})
    testing.assertEqual(c.plan(0).alarms,
                        ["1 device(s) cannot start before the deadline: r2"])


def _test_a_spread_pair_goes_in_the_first_and_the_last_window():
    """r1 and r2, then 98 devices in no group, all of 10 min, in a 1 h
    window every day, 10 at once. The run uses the first three windows.
    Packed, r2 goes right after r1, in the first window. Spread, r2 goes
    in the third window, and a device of the same estimate takes its
    place in the first. The windows take the same number of devices
    either way."""
    devs = [("r1", 600, "day"), ("r2", 600, "day")] + devices("d", 98, 600, "day")
    # (spread, the window of r1 and of r2)
    cases: list[(bool, (int, int))] = [(False, (0, 0)), (True, (0, 2))]
    for case in cases:
        c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                       groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2},
                       separation={"g": (case.0, 0)})
        p = c.plan(0)
        testing.assertEqual((p.starts["r1"].0, p.starts["r2"].0), case.1, str(case.0))
        testing.assertEqual([len(w.3) for w in c.layout(p)], [35, 50, 15])
        testing.assertEqual(p.alarms, [])
        sim.drive(c, 0, {}, 30 * DAY)
        testing.assertEqual(sim.started(c), sim.planned(c, p))


def _test_a_spread_pair_in_one_window_goes_one_after_the_other():
    """In a window that never closes, 4 at once, r2 starts when r1 is
    done, whether the group spreads or packs. Without the group it would
    start with r1."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")] + devices("d", 10, 600, "w")
    for spread in [True, False]:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4, groups={"g": ["r1", "r2"]},
                       priority={"r1": 1, "r2": 2}, separation={"g": (spread, 0)}, rung=4)
        testing.assertEqual(c.plan(0).starts["r2"], (0, 600), str(spread))


def _test_a_spread_member_trades_only_with_a_device_of_its_estimate():
    """r1 and r2 spread, then 98 devices of 10 min in no group, a 1 h
    window every day, 10 at once. Members of 10 min trade, so r2 goes in
    the third window. Members of 5 min have no device of their estimate to
    trade with, so r2 stays in the first."""
    # (the estimate of r1 and r2, and the window of r2)
    cases: list[(int, int)] = [(600, 2), (300, 0)]
    for case in cases:
        devs = [("r1", case.0, "day"), ("r2", case.0, "day")] + devices("d", 98, 600, "day")
        c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                       groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2},
                       separation={"g": (True, 0)})
        testing.assertEqual(c.plan(0).starts["r2"].0, case.1, str(case.0))


def _test_a_spread_member_keeps_an_earlier_promise():
    """r1, r2 and 10 devices fit the first window, so r2 is promised it.
    Then 90 more devices make the run use three windows; r2 keeps the
    first."""
    devs = [("r1", 600, "day"), ("r2", 600, "day")] + devices("d", 10, 600, "day")
    groups = {"g": ["r1", "r2"]}
    priority = {"r1": 1, "r2": 2}
    separation = {"g": (True, 0)}
    c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1, groups=groups,
                   priority=priority, separation=separation)
    testing.assertEqual(c.plan(0).starts["r2"].0, 0)
    c.configure(daily("day", 0, HOUR, 9), devs + devices("e", 90, 600, "day"), 10, 10, False, 1,
                600, groups, priority, separation)
    sim.answer_all(c, 0)
    testing.assertEqual(c.plan(0).starts["r2"].0, 0)


def _test_a_spread_group_that_cannot_keep_its_order_packs_alone():
    """r1, r2 and r3 spread, but r3 takes 5 min and no device in no group
    has that estimate, so r3 cannot move. r2 would then go after r3, so
    the group packs. s1 and s2 spread all the same."""
    devs = [("r1", 600, "day"), ("r2", 600, "day"), ("r3", 300, "day"), ("s1", 600, "day"),
            ("s2", 600, "day")] + devices("d", 95, 600, "day")
    c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                   groups={"g": ["r1", "r2", "r3"], "h": ["s1", "s2"]},
                   priority={"r1": 1, "r2": 2, "r3": 3, "s1": 1, "s2": 2},
                   separation={"g": (True, 0), "h": (True, 0)})
    p = c.plan(0)
    testing.assertEqual([p.starts[n].0 for n in ["r1", "r2", "r3", "s1", "s2"]], [0, 0, 0, 0, 2])


def _test_a_spread_member_trades_only_with_a_device_in_no_group():
    """r1 and r2 spread. p2 comes after p1 in a pack group, and the run
    puts it in the second window, where it is the only device of 10 min.
    r2 does not trade with it, so it stays in the first window."""
    devs = [("r1", 600, "day"), ("r2", 600, "day"), ("p1", 600, "day")] \
           + devices("d", 60, 300, "day") + [("p2", 600, "day")]
    c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                   groups={"g": ["r1", "r2"], "h": ["p1", "p2"]},
                   priority={"r1": 1, "r2": 2, "p1": 1, "p2": 2},
                   separation={"g": (True, 0)})
    p = c.plan(0)
    testing.assertEqual((p.starts["r2"].0, p.starts["p2"].0), (0, 1))
    testing.assertEqual(p.alarms, [])


def _test_a_spread_member_goes_after_the_window_of_the_member_before_it():
    """A 20 h window every day, and devices of 2 h, one at a time: the run
    uses three windows. A member moves only to a window that opens at
    least the min-separation of each of its groups after the window of
    the member before it in that group closes, and that closes at least
    that long before the window of the member after it opens. The second
    window opens 4 h after the first closes, less than the 6 h
    min-separation of g in the first row: r2 stays and r3 goes in the
    third window. With a min-separation of 4 h in the second row, r2 goes
    in the second window. m cannot move, because of q before it or y
    after it in h, so g packs."""
    wins = daily("day", 0, 20 * HOUR, 9)
    sep = 6 * HOUR
    # (the devices before and after 20 devices in no group, the groups,
    # priorities and separations, and the windows of the named devices)
    cases: list[(list[str], list[str], dict[str, list[str]], dict[str, int],
                 dict[str, (bool, int)], dict[str, int])] = [
        (["r1", "r2", "r3"], [], {"g": ["r1", "r2", "r3"]}, {"r1": 1, "r2": 2, "r3": 3},
         {"g": (True, sep)}, {"r2": 0, "r3": 2}),
        (["r1", "r2", "r3"], [], {"g": ["r1", "r2", "r3"]}, {"r1": 1, "r2": 2, "r3": 3},
         {"g": (True, 4 * HOUR)}, {"r2": 1, "r3": 2}),
        (["a", "q", "m", "z"], [], {"g": ["a", "m", "z"], "h": ["q", "m"]},
         {"a": 1, "q": 1, "m": 2, "z": 3}, {"g": (True, 0), "h": (False, sep)},
         {"m": 0, "z": 0}),
        (["a", "m", "z"], ["y"], {"g": ["a", "m", "z"], "h": ["m", "y"]},
         {"a": 1, "m": 2, "z": 3, "y": 4}, {"g": (True, 0), "h": (False, sep)},
         {"m": 0, "z": 0, "y": 2}),
    ]
    for case in cases:
        devs = [(n, 2 * HOUR, "day") for n in case.0] + devices("d", 20, 2 * HOUR, "day") \
               + [(n, 2 * HOUR, "day") for n in case.1]
        c = controller(wins, devs, 1, 1, debounce=1, groups=case.2, priority=case.3,
                       separation=case.4)
        p = c.plan(0)
        testing.assertEqual({n: p.starts[n].0 for n in case.5.keys()}, case.5, str(case.2))
        testing.assertEqual(p.alarms, [], str(case.2))


def _test_a_spread_partner_takes_the_place_of_the_member_in_the_promises():
    """a and m spread, two at once, and D takes 15 min. Without spreading,
    a and D start first, m when a is done, and P, in no group, in the
    second window. m trades windows with P, and P takes m's place after D
    in the order of the promises: P starts when a is done, D still fits,
    and m goes in the second window."""
    wins = [("w", 0, 1500), ("w", DAY, DAY + 1500)]
    devs = [("a", 600, "w"), ("m", 600, "w"), ("D", 900, "w"), ("P", 600, "w")]
    c = controller(wins, devs, 2, 2, groups={"g": ["a", "m"]}, priority={"a": 1, "m": 2},
                   separation={"g": (True, 0)}, rung=2)
    p = c.plan(0)
    testing.assertEqual(p.starts, {"a": (0, 0), "D": (0, 0), "P": (0, 600), "m": (1, DAY)})
    testing.assertEqual(p.alarms, [])


def _test_a_spread_partner_keeps_the_place_of_the_member_in_a_new_configuration():
    """m trades windows with P, and P takes m's place before Q in the order
    of the promises. A new max-concurrency keeps that order: P starts when
    a is done, and Q when D is done."""
    wins = [("w", 0, 1800), ("w", DAY, DAY + 1800)]
    devs = [("a", 600, "w"), ("m", 600, "w"), ("D", 900, "w"), ("Q", 600, "w"), ("P", 600, "w")]
    groups = {"g": ["a", "m"]}
    priority = {"a": 1, "m": 2}
    separation = {"g": (True, 0)}
    c = controller(wins, devs, 2, 2, groups=groups, priority=priority, separation=separation,
                   rung=2)
    testing.assertEqual(c.decide(0).plan.starts,
                        {"a": (0, 0), "D": (0, 0), "P": (0, 600), "Q": (0, 900), "m": (1, DAY)})
    c.configure(wins, devs, 2, 3, False, 0, 600, groups, priority, separation)
    c.report("a", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["P"])
    testing.assertEqual(s.plan.starts, {"P": (0, 600), "Q": (0, 900), "m": (1, DAY)})


def _test_a_spread_swap_that_breaks_a_promise_is_undone():
    """r2 and s2 report that they are up to date before they start, so
    each one is done as soon as it starts. Moved to the second window,
    each would give its place in the first window to a device of 10 min,
    and devices promised the first window would miss it. The plan keeps
    r2 and s2 in the first window."""
    devs = [("r1", 600, "day"), ("r2", 600, "day"), ("s1", 600, "day"), ("s2", 600, "day")] \
           + devices("d", 9, 600, "day")
    c = controller(daily("day", 0, HOUR, 3), devs, 1, 1,
                   groups={"g": ["r1", "r2"], "h": ["s1", "s2"]},
                   priority={"r1": 1, "r2": 2, "s1": 1, "s2": 2},
                   separation={"g": (True, 0), "h": (True, 0)})
    c.report("r2", "up-to-date", 0)
    c.report("s2", "up-to-date", 0)
    p = c.plan(0)
    testing.assertEqual(p.alarms, [])
    testing.assertEqual((p.starts["r2"].0, p.starts["s2"].0), (0, 0))


def _test_a_spread_member_needs_a_device_in_no_group_to_swap_with():
    """40 devices in spread pairs and nothing else: the plan is the packed
    one."""
    groups, priority = pairs(40)
    separation = {g: (True, 0) for g in groups.keys()}
    spread = controller(daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10,
                        debounce=1, groups=groups, priority=priority, separation=separation)
    packed = controller(daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10,
                        debounce=1, groups=groups, priority=priority)
    testing.assertEqual(spread.plan(0).starts, packed.plan(0).starts)


def _test_the_plan_is_the_run_pairs():
    """40 devices of 10 min in pairs, the second of each pair first, in a
    1 h window every day, 10 at once."""
    groups, priority = pairs(40)
    plan_is_run(daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10, False, 600,
                groups, priority)


def _test_the_plan_is_the_run_spread_pairs():
    """The same 20 pairs, spread with a min-separation of 10 min, and 60
    devices in no group."""
    groups, priority = pairs(40)
    separation = {g: (True, 600) for g in groups.keys()}
    devs = devices("d", 40, 600, "day") + devices("e", 60, 600, "day")
    plan_is_run(daily("day", 0, HOUR, 9), devs, 10, 10, False, 600, groups, priority, separation)


def _test_the_plan_is_the_run_chains():
    """20 devices of 10 min with a deadline: d0 to d3 in a chain of two
    groups, spread, and d4 and d5 in a pair, d5 first."""
    groups = {"a": ["d0", "d1", "d2"], "b": ["d2", "d3"], "c": ["d5", "d4"]}
    priority = {"d0": 1, "d1": 2, "d2": 3, "d3": 4, "d5": 1, "d4": 2}
    separation = {"a": (True, 0), "b": (True, 0)}
    plan_is_run(daily("day", 0, HOUR, 2), devices("d", 20, 600, "day"), 4, 8, True, 600,
                groups, priority, separation)


#############################################################################
# Answers to the campaign's target
#############################################################################

def _test_an_unanswered_device_waits():
    """d0, d1 and d2, three at a time with the ramp at three. d0's answer is
    lost. The plan holds d0 with an alarm, and d1 and d2 start. d0's
    answer ends the quiet time, and the plan at the next decision starts
    d0. In a window that is open, the first decision passed d0 over, and
    the answer looks at it again. In a window that opens at 1000, no
    decision passed d0 over before its answer at 500: d0 starts at the
    opening, after d1 and d2, which were promised the window first."""
    # (the window, the devices the decision at 0 starts, d0's held window
    # and time, the time of the answer, the time of the next decision, the
    # devices it starts)
    cases: list[((str, int, int), list[str], (int, int), int, int, list[str])] = [
        (("w", 0, fleet_ctl.OPEN_END), ["d1", "d2"], (0, 0), 5, 5, ["d0"]),
        (("w", 1000, fleet_ctl.OPEN_END), [], (0, 1000), 500, 1000, ["d1", "d2", "d0"]),
    ]
    for case in cases:
        label = "a window from {case.0.1}"
        c = controller([case.0], devices("d", 3, 600, "w"), 3, 3, rung=3)
        c.lost("d0")
        s = c.decide(0)
        testing.assertEqual(s.started, case.1, label)
        testing.assertEqual(s.plan.alarms,
                            ["1 device(s) have not answered the campaign's target: d0"], label)
        testing.assertEqual(s.plan.held, {"d0": case.2}, label)
        testing.assertTrue(c.quiet_until > case.3, "quiet until {c.quiet_until}, " + label)
        c.report("d0", "upgrade-needed", case.3)
        testing.assertEqual(c.quiet_until, 0, label)
        s = c.decide(case.4)
        testing.assertEqual(s.started, case.5, label)
        testing.assertEqual(s.plan.alarms, [], label)


def _test_an_unanswered_device_keeps_its_promise():
    """One at a time, a window of an hour every day. The first decision
    starts d0 and promises d1 the first window. d1's answer is lost: d1
    is held and keeps its promise, and the plan says that it has not
    answered, not that it misses its window. d1 answers, and starts in the
    first window when d0 is done."""
    wins = daily("w", 0, HOUR, 2)
    c = controller(wins, devices("d", 2, 600, "w"), 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    testing.assertEqual(c.promised_window("d1"), wins[0])
    c.lost("d1")
    p = c.decide(100).plan
    testing.assertEqual(p.alarms, ["1 device(s) have not answered the campaign's target: d1"])
    testing.assertEqual(p.held, {"d1": (0, 100)})
    testing.assertEqual(c.promised_window("d1"), wins[0])
    c.report("d1", "upgrade-needed", 300)
    c.report("d0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d1"])
    testing.assertEqual(c.release_windows().get("d1"), wins[0])


def _test_a_member_behind_an_unanswered_member():
    """a and b pack, a first, in a window that opens at 1000. The first
    decision promises both the window. When a's answer is lost, the plan
    holds a, and b behind it, each with its own alarm, and says that no
    one misses the window. A member that has not answered holds only the
    members after it: when b's answer is lost, a still starts."""
    # (the device whose answer is lost, the alarms, the held devices, the
    # devices the plan starts)
    cases: list[(str, list[str], list[str], list[str])] = [
        ("a", ["1 device(s) have not answered the campaign's target: a",
               "1 device(s) wait behind a redundancy group member that has not answered: b"],
         ["a", "b"], []),
        ("b", ["1 device(s) have not answered the campaign's target: b"], ["b"], ["a"]),
    ]
    for case in cases:
        c = controller([("w", 1000, fleet_ctl.OPEN_END)], [("a", 600, "w"), ("b", 600, "w")], 1,
                       1, groups={"g": ["a", "b"]}, priority={"a": 1, "b": 2})
        testing.assertEqual(sorted(list(c.decide(0).plan.starts.keys())), ["a", "b"], case.0)
        c.lost(case.0)
        p = c.decide(10).plan
        testing.assertEqual(p.alarms, case.1, case.0)
        testing.assertEqual(p.held, {name: (0, 1000) for name in case.2}, case.0)
        testing.assertEqual(sorted(list(p.starts.keys())), case.3, case.0)


def _test_the_plan_holds_unanswered_devices_before_a_run():
    """Before a run, only d1 has answered. The plan holds d0 and d2, and
    says so."""
    c = Controller()
    c.configure([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1, False, 0, 600)
    c.report("d1", "upgrade-needed", 0)
    p = c.plan(0)
    testing.assertEqual(p.alarms, ["2 device(s) have not answered the campaign's target: d0, d2"])
    testing.assertEqual(p.held, {"d0": (0, 0), "d2": (0, 0)})
    testing.assertEqual(p.starts, {"d1": (0, 0)})


def _test_answers_keep_the_campaign_order():
    """One at a time, a window that opens at 100, and d1 answers before d0.
    When both answer before the run, or in one batch after a decision of
    the run, d0 starts first, in the campaign's order. A plan does not
    park the devices that have not answered, or the answers would put them
    in the order they come. In a run in which d1 answers in a batch of its
    own, the decision after it promises d1 the window, and d1 starts
    first: a campaign created in run promises its windows in the order its
    members answer."""
    # (what happens, the steps before the decision at 100, each a name and
    # a time: start, plan, decide, or a device that answers, and the
    # device that starts at 100)
    cases: list[(str, list[(str, int)], str)] = [
        ("both answer before the run",
         [("plan", 0), ("d1", 0), ("plan", 1), ("d0", 5), ("plan", 6), ("start", 50)], "d0"),
        ("both answer in one batch of the run",
         [("start", 0), ("decide", 0), ("d1", 3), ("d0", 5), ("decide", 6)], "d0"),
        ("d1 answers in a batch of its own",
         [("start", 0), ("decide", 0), ("d1", 3), ("decide", 4), ("d0", 5), ("decide", 6)],
         "d1"),
    ]
    for case in cases:
        c = Controller()
        c.configure([("w", 100, fleet_ctl.OPEN_END)], devices("d", 2, 600, "w"), 1, 1, False, 0,
                    600)
        for st in case.1:
            if st.0 == "start":
                c.start()
            elif st.0 == "plan":
                c.plan(st.1)
            elif st.0 == "decide":
                c.decide(st.1)
            else:
                c.report(st.0, "upgrade-needed", st.1)
        testing.assertEqual(c.decide(100).started, [case.2], case.0)


def _test_answers_before_release():
    """x and y pack, x first, one at a time, in a window that opens at
    1000. x reports before the window opens. A final status answers: x is
    released at the opening, and done at the next step with no upgrade,
    so the pace stays. A failure then holds y. in-progress says that x
    still upgrades from before the run: x is in flight from its report,
    and y waits for it. unknown is no answer: x is held, and y behind
    it."""
    not_answered = ["1 device(s) have not answered the campaign's target: x",
                    "1 device(s) wait behind a redundancy group member that has not answered: y"]
    # (x's report, the devices that start at 1000, the devices that start
    # at the next step, the alarms then, whether x is done, whether it
    # failed)
    cases: list[(str, list[str], list[str], list[str], bool, bool)] = [
        ("failed", ["x"], [],
         ["1 device(s) wait behind a failed redundancy group member: y"], True, True),
        ("up-to-date", ["x"], ["y"], [], True, False),
        ("in-progress", [], [], [], False, False),
        ("unknown", [], [], not_answered, False, False),
    ]
    for case in cases:
        c = controller([("w", 1000, fleet_ctl.OPEN_END)], [("x", 600, "w"), ("y", 600, "w")], 1,
                       1, groups={"g": ["x", "y"]}, priority={"x": 1, "y": 2})
        c.report("x", case.0, 500)
        testing.assertEqual(c.decide(1000).started, case.1, case.0)
        s = c.decide(1001)
        testing.assertEqual(s.started, case.2, case.0)
        testing.assertEqual(s.plan.alarms, case.3, case.0)
        testing.assertEqual("x" in c.done_times(), case.4, case.0)
        testing.assertEqual("x" in c.failed_devices(), case.5, case.0)
        testing.assertEqual(c.observed_s, 600, case.0)
        testing.assertEqual("x" in c.released_devices(), case.0 != "unknown", case.0)


def _test_a_device_still_upgrading_holds_its_slot():
    """One at a time, in a window that is open. d0 reports in-progress at
    10: a run released it, and the campaign was stopped and run again, as
    a pause does; or the report reaches a run that has started, as after a
    restart. d0 still upgrades from before the run, so the run takes it in
    flight from 10, keeps holding it, and d1 does not start. When d0 is
    done, d1 starts, and d0 gave no pace sample: the start of its upgrade
    is not known. When d0 stops before its install instead, it reports
    upgrade-needed and waits again; d1, promised the window while d0 was
    in flight, starts first."""
    # (how d0 comes to report in-progress, d0's next status at 900)
    cases: list[(str, str)] = [
        ("pause", "succeeded"),
        ("pause", "upgrade-needed"),
        ("restart", "succeeded"),
        ("restart", "upgrade-needed"),
    ]
    for case in cases:
        label = "{case.0}, then {case.1}"
        c = open_window(2, 1, 1)
        if case.0 == "pause":
            testing.assertEqual(c.decide(0).started, ["d0"], label)
            c.report("d0", "in-progress", 10)
            c.stop()
            c.start()
        else:
            c.report("d0", "in-progress", 10)
        testing.assertEqual(sorted(list(c.resumed_devices())), ["d0"], label)
        testing.assertEqual(sorted(list(c.flying_devices())), ["d0"], label)
        testing.assertEqual(c.release_times(), {"d0": 10}, label)
        s = c.decide(20)
        testing.assertEqual(s.started, [], label)
        testing.assertEqual(s.plan.alarms, [], label)
        c.report("d0", case.1, 900)
        testing.assertEqual(c.decide(900).started, ["d1"], label)
        done = case.1 == "succeeded"
        testing.assertEqual("d0" in c.done_times(), done, label)
        testing.assertEqual("d0" in c.released_devices(), done, label)
        testing.assertEqual("d0" in c.resumed_devices(), done, label)
        testing.assertEqual(c.observed_s, 600, label)


def one_at_a_time(c: Controller, windows: list[(str, int, int)],
                  devs: list[(str, int, str)]) -> None:
    """Configure c again with windows and devs, one device at a time."""
    c.configure(windows, devs, 1, 1, False, 0, 600)


def _test_a_device_that_joins_again_is_a_new_member():
    """d0 runs in the first of two daily windows of an hour. It fails, or
    it leaves the campaign while in flight. It leaves, and drop() forgets
    it. It joins again at 4000, when the window has closed: it is not in
    flight, and the plan holds it until it answers. It then starts at the
    next opening, not before."""
    wins = daily("w", 0, HOUR, 2)
    devs = devices("d", 1, 600, "w")
    for case in ["failed", "in flight"]:
        c = controller(wins, devs, 1, 1)
        testing.assertEqual(c.decide(0).started, ["d0"], case)
        if case == "failed":
            c.report("d0", "failed", 600)
            c.decide(600)
            testing.assertEqual(sorted(list(c.failed_devices())), ["d0"], case)
        one_at_a_time(c, wins, [])
        c.drop({"d0"})
        one_at_a_time(c, wins, devs)
        testing.assertEqual(len(c.released_devices()), 0, case)
        testing.assertEqual(len(c.failed_devices()), 0, case)
        testing.assertEqual(len(c.done_times()), 0, case)
        held = c.decide(4000)
        testing.assertEqual(held.started, [], case)
        testing.assertEqual(held.plan.alarms,
                            ["1 device(s) have not answered the campaign's target: d0"], case)
        c.report("d0", "upgrade-needed", 4100)
        closed = c.decide(4100)
        testing.assertEqual(closed.started, [], case)
        testing.assertEqual(closed.wake, DAY, case)
        testing.assertEqual(c.decide(DAY).started, ["d0"], case)


def _test_a_lost_answer_holds_the_device_again():
    """d0 answers up-to-date, and then reports no status. Its final status
    is gone, and the plan holds it."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    c.report("d0", None, 1)
    testing.assertEqual(c.has_final("d0"), False)
    p = c.plan(2)
    testing.assertEqual(p.alarms, ["1 device(s) have not answered the campaign's target: d0"])
    testing.assertEqual(list(p.held.keys()), ["d0"])


def _test_lost_all_forgets_the_answers():
    """d0 is in flight when every status is lost. The plan holds the
    devices that wait, d1 and d2."""
    c = open_window(3, 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.lost_all()
    testing.assertEqual(c.plan(1).alarms,
                        ["2 device(s) have not answered the campaign's target: d1, d2"])


def _test_a_released_device_in_progress_keeps_the_quiet_time():
    """d0 starts. Its in-progress is no answer, but a device in flight
    needs none, so the quiet time stays. The same status from d1, which
    waits, says that d1 still upgrades from before the run: the run takes
    it in flight, and the quiet time ends."""
    # (the device that reports in-progress, whether the quiet time stays)
    cases: list[(str, bool)] = [("d0", True), ("d1", False)]
    for case in cases:
        c = open_window(3, 1, 1)
        testing.assertEqual(c.decide(0).started, ["d0"])
        quiet = c.quiet_until
        testing.assertTrue(quiet > 1, "quiet until {quiet}")
        c.report(case.0, "in-progress", 1)
        testing.assertEqual(c.quiet_until == quiet, case.1, case.0)


def _test_a_plan_with_only_holds_is_taken_again():
    """20 devices of 600 s in a 1 h window every day, two at a time and at
    most four, staggered over a whole upgrade. d7 never answers, so every
    plan holds it with an alarm. The decisions in which only devices start
    still take the last plan again, and decide as a new plan would, also
    when each device reports in-progress when it starts."""
    for in_progress in [False, True]:
        c = controller(daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, False, 1,
                       stagger=100)
        c.lost("d7")
        again = same_as_a_new_plan(c, {}, 9 * DAY, in_progress=in_progress)
        testing.assertTrue(again > 0, "in-progress {in_progress}: {again} decisions took the "
                           + "plan again")
        testing.assertEqual(sorted(list(c.released_devices())),
                            sorted(["d{i}" for i in range(20) if i != 7]), str(in_progress))


def late_answers() -> list[(int, str)]:
    """d3 answers at 300 and d8 at 1300."""
    return [(300, "d3"), (1300, "d8")]


def _test_the_plan_is_the_run_with_late_answers():
    """20 devices of 600 s in a 1 h window every day, two at a time and at
    most four. d3 and d8 answer late, the others at the start. Each
    decision decides as a new plan would, staggered or not. Once the
    last answer is in, the plan of that decision is the run from then
    on."""
    for stagger in [0, 100]:
        c = controller(daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, False, 1,
                       stagger=stagger)
        c.lost("d3")
        c.lost("d8")
        same_as_a_new_plan(c, {}, 9 * DAY, answers=late_answers())
        testing.assertEqual(len(c.done_times()), 20, "stagger {stagger}")

        r = controller(daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, False, 1,
                       stagger=stagger)
        r.lost("d3")
        r.lost("d8")
        ds = sim.drive(r, 0, {}, 9 * DAY, answers=late_answers())
        last: ?sim.Decision = None
        for d in ds:
            if last is None and d.t >= 1300:
                last = d
        if last is not None:
            p = last.plan
            testing.assertEqual(p.alarms, [], "stagger {stagger}")
            planned = sim.planned(r, p)
            started = sim.started(r)
            before = [n for n, st in started.items() if st.1 < last.t]
            testing.assertEqual(len(planned) + len(before), 20,
                                "stagger {stagger}: every device placed")
            testing.assertEqual({n: started[n] for n in planned.keys() if n in started}, planned,
                                "stagger {stagger}: the run after {last.t}")
        else:
            testing.assertTrue(False, "stagger {stagger}: no decision after the last answer")


#############################################################################
# Prepares before the window
#############################################################################

def one(debounce: int=0, prepare: bool=True) -> Controller:
    """ONE: d0 to d4 of 600 s on a window that opens at 10150 and never
    closes, two at a time and at most 10, at the start of a run. Each
    prepare takes 100 s and the close margin is 150 percent, so each
    member's deadline is 10000."""
    return controller([("w", 10150, fleet_ctl.OPEN_END)], devices("d", 5, 600, "w"), 2, 10,
                      debounce=debounce, prepare=prepare)


def configure_one(c: Controller, prepare: bool) -> None:
    """Configure c again as ONE, with prepare on or off."""
    devs = devices("d", 5, 600, "w")
    c.configure([("w", 10150, fleet_ctl.OPEN_END)], devs, 2, 10, False, 0, 600, {}, {}, {},
                fleet_ctl.CLOSE_MARGIN, 0, prepare, {d.0: 100 for d in devs})


def _test_prepare_turns():
    """The turns to prepare that the plan at 0 shows, and the alarms. ONE
    spreads d0 to d4 evenly from 0 to their deadline at 10000. Nothing
    prepares with prepare off, before the run, while the window is open,
    or in a window that never closes and is open now. A window that opens
    within the lead leaves no time to prepare. A member that has not
    answered, is up to date, or reports a prepare does not wait, and the
    others share the time. With a debounce of 30 s, each member starts at
    the start of the debounce slot of its turn. A member that fits in no
    window has no promise and does not prepare."""
    one_w = [("w", 10150, fleet_ctl.OPEN_END)]
    five = devices("d", 5, 600, "w")
    # (case, windows, devices, debounce, prepare, whether the run started,
    # status reports at 0, prepare reports, the starts, the alarms)
    cases: list[(str, list[(str, int, int)], list[(str, int, str)], int, bool, bool,
                 list[(str, ?str)], list[(str, str)], dict[str, int], list[str])] = [
        ("ONE", one_w, five, 0, True, True, [], [],
         {"d0": 0, "d1": 2500, "d2": 5000, "d3": 7500, "d4": 10000}, []),
        ("prepare off", one_w, five, 0, False, True, [], [], {}, []),
        ("not started", one_w, five, 0, True, False, [], [], {}, []),
        ("open at 0", [("w", 0, 20000)], five, 0, True, True, [], [], {}, []),
        ("opens at 100", [("w", 100, fleet_ctl.OPEN_END)], five, 0, True, True, [], [], {},
         ["5 device(s) cannot prepare before their window opens: d0, d1, d2, d3, d4"]),
        ("always open", [("w", 0, fleet_ctl.OPEN_END)], five, 0, True, True, [], [], {}, []),
        ("d1 lost, d2 up to date", one_w, five, 0, True, True,
         [("d1", None), ("d2", "up-to-date")], [], {"d0": 0, "d3": 5000, "d4": 10000}, []),
        ("d3 prepared", one_w, five, 0, True, True, [], [("d3", "done")],
         {"d0": 0, "d1": 3333, "d2": 6666, "d4": 10000}, []),
        ("debounce 30", one_w, five, 30, True, True, [], [],
         {"d0": 0, "d1": 2490, "d2": 4980, "d3": 7500, "d4": 9990}, []),
        ("d4 fits in no window", [("w", 10150, 13750)],
         devices("d", 4, 600, "w") + [("d4", 3000, "w")], 0, True, True, [], [],
         {"d0": 0, "d1": 3333, "d2": 6666, "d3": 10000}, []),
    ]
    for case in cases:
        c = configured(case.1, case.2, 2, 10, debounce=case.3, prepare=case.4)
        if case.5:
            c.start()
        for r in case.6:
            c.report(r.0, r.1, 0)
        for r in case.7:
            c.report_prepare(r.0, r.1)
        c.plan(0)
        p = c.prepares(0)
        testing.assertEqual(p.starts, case.8, case.0)
        testing.assertEqual(p.alarms, case.9, case.0)


def _test_prepares_spread_over_the_whole_time():
    """a0 and a1 wait for a window that opens at 10150, and b0 and b1 for
    one that opens at 20150: their deadlines are 10000 and 20000. The
    turns are as far apart as both deadlines allow, so they cover the
    whole time to the last deadline: a1 goes a third of the way to 20000,
    not at 10000."""
    c = controller([("a", 10150, fleet_ctl.OPEN_END), ("b", 20150, fleet_ctl.OPEN_END)],
                   devices("a", 2, 600, "a") + devices("b", 2, 600, "b"), 2, 10, prepare=True)
    c.plan(0)
    testing.assertEqual(c.prepares(0).starts, {"a0": 0, "a1": 6666, "b0": 13333, "b1": 20000})


def _test_prepares_follow_the_promises():
    """ONE, but d0 has not answered: the plan at 0 promises it no window,
    and d1 goes first. d0 answers at 1000. The plan at 1000 promises it
    the window after the others, and it takes the last turn."""
    c = one()
    c.report("d0", None, 0)
    c.decide(0)
    testing.assertEqual(sorted(list(c.allowed)), ["d1"])
    c.report("d0", "upgrade-needed", 1000)
    testing.assertEqual(c.decide(1000).prepares.starts,
                        {"d1": 0, "d2": 2500, "d3": 5000, "d4": 7500, "d0": 10000})


def _test_prepare_concurrency():
    """The most members that prepare at once, each from its start for its
    expected prepare time. ONE's turns are 2500 s apart and each prepare
    takes 100 s: one at a time. 100 members whose prepare takes 250 s,
    with a window that opens at 10275, have a turn every 100 s from 0 to
    9900: three at once. Three more members that report their prepare
    running, and were not let in this run, count from now: six at once.
    31 members whose prepare takes 2 s and whose deadline is 30 have a
    turn every second, but with a debounce of 5 s the five turns of each
    slot start together at the slot's start: five at once."""
    # (case, members that wait, members that report their prepare running,
    # the window's opening, the prepare time, the debounce, the most at
    # once)
    cases: list[(str, int, int, int, int, int, int)] = [
        ("ONE", 5, 0, 10150, 100, 0, 1),
        ("a turn every 100 s", 100, 0, 10275, 250, 0, 3),
        ("and three that run", 100, 3, 10275, 250, 0, 6),
        ("five turns in each slot", 31, 0, 33, 2, 5, 5),
    ]
    for case in cases:
        c = controller([("w", case.3, fleet_ctl.OPEN_END)],
                       devices("d", case.1, 600, "w") + devices("r", case.2, 600, "w"), 2, 10,
                       debounce=case.5, prepare=True, prepare_s=case.4)
        for k in range(case.2):
            c.report_prepare("r{k}", "running")
        c.plan(0)
        testing.assertEqual(c.prepares(0).c, case.6, case.0)


def _test_decisions_let_members_at_their_turns():
    """A decision lets each member whose turn is before the end of its
    debounce slot, and wakes at the slot of the next turn. ONE: the
    decision at 0 lets d0 and wakes at 2500, d1's turn; at 2499 it lets no
    one, and at 2500 it lets d1. With a debounce of 30 s it wakes at 2490,
    the start of the slot of d1's turn, and with prepare off at the
    opening. 31 members whose deadline is 30 have a turn every second:
    with a debounce of 5 s, each decision lets five of them."""
    c = one()
    s = c.decide(0)
    testing.assertEqual((sorted(list(c.allowed)), s.wake), (["d0"], 2500))
    c.decide(2499)
    testing.assertEqual(c.prepare_at, {"d0": 0})
    c.decide(2500)
    testing.assertEqual(c.prepare_at, {"d0": 0, "d1": 2500})
    testing.assertEqual(one(debounce=30).decide(0).wake, 2490)
    testing.assertEqual(one(prepare=False).decide(0).wake, 10150)

    b = controller([("w", 33, fleet_ctl.OPEN_END)], devices("d", 31, 600, "w"), 2, 10,
                   debounce=5, prepare=True, prepare_s=2)
    # (the decision, the members it lets, its wake)
    batches: list[(int, list[str], int)] = [
        (0, ["d0", "d1", "d2", "d3", "d4"], 5),
        (5, ["d5", "d6", "d7", "d8", "d9"], 10),
    ]
    for batch in batches:
        s = b.decide(batch.0)
        let = sorted([name for name, at in b.prepare_at.items() if at == batch.0])
        testing.assertEqual((let, s.wake), (batch.1, batch.2), str(batch.0))


def _test_a_late_answer_joins_the_spread():
    """ONE, but d4 has not answered: d0 to d3 share the time to 10000. d0
    goes at 0 and d1 at 3333. d4 answers at 4000 and joins the turns: the
    members left share the time from d1's turn."""
    c = one()
    c.report("d4", None, 0)
    testing.assertEqual(c.decide(0).prepares.starts,
                        {"d0": 0, "d1": 3333, "d2": 6666, "d3": 10000})
    c.decide(3333)
    c.report("d4", "upgrade-needed", 4000)
    testing.assertEqual(c.decide(4000).prepares.starts,
                        {"d0": 0, "d1": 3333, "d2": 5555, "d3": 7777, "d4": 10000})


def _test_a_late_decision_spreads_the_rest_from_then():
    """ONE: d0 goes at 0. The next decision comes at 3000, after the
    debounce slot of d1's turn at 2500. It lets d1 now, and the members
    left share the time from now: no two members go at once to catch up.
    With a debounce of 30 s, a decision at 2519 is in the slot of d1's
    turn, which starts at 2490: it lets d1, and the turns after it stay as
    they were."""
    # (the debounce, the late decision, the starts after it)
    cases: list[(int, int, dict[str, int])] = [
        (0, 3000, {"d0": 0, "d1": 3000, "d2": 5333, "d3": 7666, "d4": 10000}),
        (30, 2519, {"d0": 0, "d1": 2519, "d2": 4980, "d3": 7500, "d4": 9990}),
    ]
    for case in cases:
        c = one(debounce=case.0)
        c.decide(0)
        testing.assertEqual(c.decide(case.1).prepares.starts, case.2, str(case.0))


def _test_a_member_that_comes_to_wait_after_the_turns_goes_at_once():
    """a0 and a1 wait for a window that opens at 10150, and b0, which has
    not answered, for one that opens at 20150. a0 goes at 0 and a1 at
    10000, the last turn. b0 answers at 12000 and goes at once: the
    spread before it ended."""
    c = controller([("a", 10150, fleet_ctl.OPEN_END), ("b", 20150, fleet_ctl.OPEN_END)],
                   devices("a", 2, 600, "a") + devices("b", 1, 600, "b"), 2, 10, prepare=True)
    c.report("b0", None, 0)
    c.decide(0)
    c.decide(10000)
    testing.assertEqual(c.prepare_at, {"a0": 0, "a1": 10000})
    c.report("b0", "upgrade-needed", 12000)
    c.decide(12000)
    testing.assertEqual(c.prepare_at, {"a0": 0, "a1": 10000, "b0": 12000})


def prepare_campaign(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
                     maxc: int, estimate: int, groups: dict[str, list[str]],
                     priority: dict[str, int], stagger: int, answers: list[(int, str)],
                     prepare: bool) -> Controller:
    """A controller at the start of a run with a debounce of 1 s, prepare
    on or off and each prepare 100 s. The devices in answers have not
    answered yet."""
    c = controller(windows, devs, target, maxc, False, 1, estimate, groups, priority,
                   stagger=stagger, prepare=prepare)
    for a in answers:
        c.lost(a.1)
    return c


def _test_prepares_do_not_change_the_releases():
    """Prepares change no release decision. Each campaign runs once with
    prepare off, and once with prepare on and every member let prepare
    reporting its prepare: the devices start in the same windows at the
    same times. The members let prepare are the ones that start in a
    window that opens after the run starts, and each is let by its
    deadline. Next to a copy that plans at every decision, each decision
    with prepare on starts and lets prepare as a new plan would, and some
    decisions take the last plan again."""
    groups, priority = pairs(40)
    no_groups: dict[str, list[str]] = {}
    no_priority: dict[str, int] = {}
    # (case, windows, devices, target, max, estimate, groups, priorities,
    # stagger, the devices that answer later, as (time, name))
    cases: list[(str, list[(str, int, int)], list[(str, int, str)], int, int, int,
                 dict[str, list[str]], dict[str, int], int, list[(int, str)])] = [
        ("uniform", daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, 600,
         no_groups, no_priority, 0, []),
        ("two schedules", [("night", 0, HOUR), ("weekend", 2 * HOUR, 3 * HOUR)],
         devices("n", 5, 8, "night") + devices("w", 5, 8, "weekend"), 8, 16, 8,
         no_groups, no_priority, 0, []),
        ("stagger", daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, 600,
         no_groups, no_priority, 100, []),
        ("late answers", daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, 600,
         no_groups, no_priority, 0, late_answers()),
        ("pairs", daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10, 600,
         groups, priority, 0, []),
    ]
    for case in cases:
        runs: list[dict[str, ((str, int, int), int)]] = []
        for prepare in [False, True]:
            c = prepare_campaign(case.1, case.2, case.3, case.4, case.5, case.6, case.7, case.8,
                                 case.9, prepare)
            sim.drive(c, 0, {}, 30 * DAY, answers=case.9, prepare_reports=prepare)
            runs.append(sim.started(c))
            if prepare:
                later = sorted([n for n, st in runs[0].items() if st.0.1 > 0])
                testing.assertTrue(len(later) > 0, "{case.0}: no member starts later")
                testing.assertEqual(sorted(c.prepare_at.keys()), later, case.0)
                for name, at in c.prepare_at.items():
                    d = c.prepare_deadline(name, at)
                    if d is not None:
                        testing.assertTrue(at * fleet_ctl.MICRO <= d,
                                           "{case.0}: {name} let at {at}, after its deadline")
                    else:
                        testing.assertTrue(False, "{case.0}: {name} let at {at} without a deadline")
        testing.assertEqual(runs[1], runs[0], case.0)
        c = prepare_campaign(case.1, case.2, case.3, case.4, case.5, case.6, case.7, case.8,
                             case.9, True)
        again = same_as_a_new_plan(c, {}, 9 * DAY, answers=case.9, prepare=True)
        testing.assertTrue(again > 0, "{case.0}: {again} decisions took the plan again")


def _test_the_prepares_are_the_plan():
    """A 1 h window at 06:00 every day for three days, and 20 devices of
    600 s, two at a time, each prepare 100 s. The prepares that the
    decision at 0 shows are the run: each member is let prepare at the
    second shown, when every member reports its prepare."""
    c = controller(daily("w", 6 * HOUR, HOUR, 3), devices("d", 20, 600, "w"), 2, 2, debounce=1,
                   prepare=True)
    ds = sim.drive(c, 0, {}, 3 * DAY, prepare_reports=True)
    testing.assertEqual(len(c.prepare_at), 20)
    testing.assertEqual(c.prepare_at, ds[0].prepares.starts)


def _test_prepare_reports_keep_the_quiet_time():
    """A prepare report changes no release decision, so the quiet time
    stays."""
    c = one()
    c.decide(0)
    quiet = c.quiet_until
    testing.assertEqual(quiet, 10150)
    states: list[?str] = ["running", "done", None]
    for st in states:
        c.report_prepare("d0", st)
        testing.assertEqual(c.quiet_until, quiet, str(st))


def _test_revokes():
    """ONE: the decision at 0 lets d0 prepare. d0 stays let while its
    prepare runs. It stops being let when its prepare is done or failed,
    when it no longer answers that it needs the upgrade, when prepare goes
    off, when the run stops, when it leaves the campaign, or when its
    window opens. It is let once: it gets no later turn, and only leaving
    the campaign forgets that it was let. When the window opens, d1, let
    at 2500, stops being let too, though only d0 starts."""
    # (the event, the next decision, or -1 for none, whether d0 is still
    # let)
    cases: list[(str, int, bool)] = [
        ("prepare running", 5, True),
        ("prepare done", 100, False),
        ("prepare failed", 100, False),
        ("lost answer", 100, False),
        ("up to date", 100, False),
        ("prepare off", -1, False),
        ("stop", -1, False),
        ("drop", 100, False),
        ("window opens", 10150, False),
    ]
    for case in cases:
        c = one()
        c.decide(0)
        testing.assertEqual(sorted(list(c.allowed)), ["d0"], case.0)
        if case.0 == "prepare running":
            c.report_prepare("d0", "running")
        elif case.0 == "prepare done":
            c.report_prepare("d0", "done")
        elif case.0 == "prepare failed":
            c.report_prepare("d0", "failed")
        elif case.0 == "lost answer":
            c.report("d0", None, 50)
        elif case.0 == "up to date":
            c.report("d0", "up-to-date", 50)
        elif case.0 == "prepare off":
            configure_one(c, False)
        elif case.0 == "stop":
            c.stop()
        elif case.0 == "drop":
            c.drop({"d0"})
        elif case.0 == "window opens":
            c.decide(2500)
            testing.assertEqual(sorted(list(c.allowed)), ["d0", "d1"], case.0)
        t = 0
        if case.1 >= 0:
            t = case.1
            c.decide(t)
        testing.assertEqual("d0" in c.allowed, case.2, case.0)
        testing.assertEqual("d0" in [e.1 for e in c.turns(t).0], False, case.0)
        testing.assertEqual(c.prepare_at.get_def("d0", -1), -1 if case.0 == "drop" else 0, case.0)
        if case.0 == "window opens":
            testing.assertEqual((sorted(list(c.released_devices())), len(c.allowed)), (["d0"], 0), case.0)


def _test_once_per_run():
    """A member is let prepare once in a run. ONE: d0 is let at 0 and
    reports its prepare done. When that report goes, as after a flotilla
    restart, d0 gets no new turn in this run, and a new run lets it again
    at once. A new run does not let it again while it reports its prepare
    done. After the decision at 200, d0 has no turn left in any case."""
    # (case, whether d0's report goes, whether a new run starts, whether d0
    # is let again at 200)
    cases: list[(str, bool, bool, bool)] = [
        ("report gone", True, False, False),
        ("report gone, new run", True, True, True),
        ("new run", False, True, False),
    ]
    for case in cases:
        c = one()
        c.decide(0)
        c.report_prepare("d0", "done")
        c.decide(100)
        if case.1:
            c.report_prepare("d0", None)
        if case.2:
            c.stop()
            c.start()
        c.decide(200)
        testing.assertEqual((c.prepare_at.get_def("d0", -1) == 200,
                             "d0" in [e.1 for e in c.turns(200).0]), (case.3, False), case.0)


def _test_prepares_between_the_windows_of_a_schedule():
    """Two 1 h windows a day apart, and d0 to d9 of 600 s, one at a time,
    each prepare 100 s. d0 to d4 start in the first window, and no member
    prepares while it is open. When it closes, d5 to d9 wait for the
    second window: their turns spread from the close to their deadline,
    150 s before the second opening."""
    c = controller([("w", 0, HOUR), ("w", DAY, DAY + HOUR)], devices("d", 10, 600, "w"), 1, 1,
                   prepare=True)
    sim.drive(c, 0, {}, HOUR - 1, prepare_reports=True)
    testing.assertEqual(sorted(list(c.released_devices())), ["d0", "d1", "d2", "d3", "d4"])
    testing.assertEqual(c.prepare_at, {})
    testing.assertEqual(c.decide(HOUR).prepares.starts,
                        {"d5": 3600, "d6": 24262, "d7": 44925, "d8": 65587, "d9": 86250})


def _test_prepare_alarms():
    """The prepares name the members whose window opens too soon to
    prepare before it, and then the members whose prepare failed while
    they wait for their release. A failed prepare is forgotten when every
    status is lost. A member whose prepare failed is not named when it no
    longer waits: it is released, it has not answered, or its upgrade
    failed and a new run starts, so it is no longer released. That holds
    with prepare off too, where the run's own prepare is what failed."""
    # (case, the window's opening, prepare on or off, the members whose
    # prepare failed, the event, the alarms)
    cases: list[(str, int, bool, list[str], str, list[str])] = [
        ("failed", 10150, True, ["d0"], "",
         ["1 device(s) failed to prepare and copy the image in their window: d0"]),
        ("too soon", 100, True, [], "",
         ["5 device(s) cannot prepare before their window opens: d0, d1, d2, d3, d4"]),
        ("both", 100, True, ["d0"], "",
         ["4 device(s) cannot prepare before their window opens: d1, d2, d3, d4",
          "1 device(s) failed to prepare and copy the image in their window: d0"]),
        ("failed, then all lost", 10150, True, ["d0"], "all lost", []),
        ("released", 0, True, ["d0", "d4"], "released",
         ["1 device(s) failed to prepare and copy the image in their window: d4"]),
        ("answer lost", 10150, True, ["d0"], "answer lost", []),
        ("upgrade failed, new run", 10150, True, ["d0"], "upgrade failed", []),
        ("prepare off, upgrade failed, new run", 10150, False, ["d0"], "upgrade failed", []),
    ]
    for case in cases:
        c = controller([("w", case.1, fleet_ctl.OPEN_END)], devices("d", 5, 600, "w"), 2, 10,
                       prepare=case.2)
        for name in case.3:
            c.report_prepare(name, "failed")
        if case.4 == "all lost":
            c.lost_all()
        elif case.4 == "answer lost":
            c.report("d0", None, 0)
        elif case.4 == "upgrade failed":
            c.report("d0", "failed", 0)
            c.stop()
            c.start()
        if case.4 == "released":
            c.decide(0)
            testing.assertEqual(sorted(list(c.released_devices())), ["d0"], case.0)
        else:
            c.plan(0)
        testing.assertEqual(c.prepares(0).alarms, case.5, case.0)


def _test_the_plan_before_a_run_shows_a_run_started_now():
    """Before a run, ONE prepares nothing. A copy that starts a run now
    and plans shows the turns of that run. With a debounce of 30 s, a run
    that starts at 15 shows d0 at 15, though the debounce slot of its turn
    starts at 0."""
    # (the debounce, when the run starts, the starts it shows)
    cases: list[(int, int, dict[str, int])] = [
        (0, 0, {"d0": 0, "d1": 2500, "d2": 5000, "d3": 7500, "d4": 10000}),
        (30, 15, {"d0": 15, "d1": 2490, "d2": 4980, "d3": 7500, "d4": 9990}),
    ]
    for case in cases:
        c = configured([("w", 10150, fleet_ctl.OPEN_END)], devices("d", 5, 600, "w"), 2, 10,
                       debounce=case.0, prepare=True)
        c.plan(case.1)
        testing.assertEqual(c.prepares(case.1).starts, {}, str(case.0))
        r = c.copy()
        r.start()
        r.plan(case.1)
        testing.assertEqual(r.prepares(case.1).starts, case.2, str(case.0))


def _test_copy_keeps_the_prepares():
    """ONE: d0 is let at 0 and reports its prepare done, and d2 reports
    its prepare running, so no member is let at 1. A copy shows the same
    prepares, and a decision on the copy does not change who the original
    lets prepare."""
    c = one()
    c.decide(0)
    c.report_prepare("d0", "done")
    c.report_prepare("d2", "running")
    c.decide(1)
    testing.assertEqual(len(c.allowed), 0)
    r = c.copy()
    a = c.prepares(1)
    b = r.prepares(1)
    testing.assertEqual(b.starts, a.starts)
    testing.assertEqual(b.c, a.c)
    testing.assertEqual(b.alarms, a.alarms)
    r.decide(3333)
    testing.assertEqual(sorted(list(r.allowed)), ["d1"])
    testing.assertEqual(len(c.allowed), 0)
    testing.assertEqual(c.prepare_at, {"d0": 0})


#############################################################################
# The failure budget
#############################################################################

def budget_alarm(failures: int, budget: int) -> str:
    """The plan's alarm when failures members failed, more than the budget
    budget."""
    return ("{failures} device(s) failed, more than the failure budget of {budget}: "
            + "no more devices start")


def _test_a_failure_budget_stops_the_starts():
    """10 devices of 600 s in a window that never closes, three at a time,
    the ramp at three. d0, d1 and d2 start, and d0 and d1 fail at 600. With
    a budget of two or more, or none, d3 and d4 take their slots, and d5
    starts when d2 succeeds. With a budget of one or zero, more members
    failed than the budget: nothing starts, the plan holds the waiting
    devices and says why, and d2, in flight, still finishes. A copy plans
    the same."""
    waiting = ["d{i}" for i in range(3, 10)]
    # (the budget, or -1 for none, the devices that start at 600 and at
    # 700, and the alarms at 600)
    cases: list[(int, list[str], list[str], list[str])] = [
        (-1, ["d3", "d4"], ["d5"], []),
        (3, ["d3", "d4"], ["d5"], []),
        (2, ["d3", "d4"], ["d5"], []),
        (1, [], [], [budget_alarm(2, 1)]),
        (0, [], [], [budget_alarm(2, 0)]),
    ]
    for case in cases:
        label = "budget {case.0}"
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 10, 600, "w"), 3, 3, rung=3,
                       failure_budget=case.0)
        testing.assertEqual(c.decide(0).started, ["d0", "d1", "d2"], label)
        c.report("d0", "failed", 600)
        c.report("d1", "failed", 600)
        s = c.decide(600)
        testing.assertEqual(s.started, case.1, label)
        testing.assertEqual(s.plan.alarms, case.3, label)
        held = sorted(list(s.plan.held.keys()))
        testing.assertEqual(held, sorted(waiting) if len(case.3) > 0 else [], label)
        testing.assertEqual(c.copy().plan(600).alarms, case.3, label)
        c.report("d2", "succeeded", 700)
        testing.assertEqual(c.decide(700).started, case.2, label)
        testing.assertEqual("d2" in c.done_times(), True, label)
        testing.assertEqual(c.failures, 2, label)


def _test_the_failures_are_the_members_whose_latest_report_is_a_failure():
    """The failures that count against the budget are the members whose
    latest report is failed or rolled-back, as the campaign's failed
    counter counts them. A success after a failure, a status that is not
    final, and no status take a failure back; a failure after a success
    counts. A device that is not a member does not count."""
    # (case, the reports in order, the failures)
    cases: list[(str, list[(str, ?str)], int)] = [
        ("failed", [("d0", "failed")], 1),
        ("rolled back", [("d0", "rolled-back")], 1),
        ("three reports", [("d0", "failed"), ("d1", "up-to-date"), ("d2", "rolled-back")], 2),
        ("failed, then succeeded", [("d0", "failed"), ("d0", "succeeded")], 0),
        ("succeeded, then failed", [("d0", "succeeded"), ("d0", "failed")], 1),
        ("failed, then in progress", [("d0", "failed"), ("d0", "in-progress")], 0),
        ("failed, then no status", [("d0", "failed"), ("d0", None)], 0),
        ("not a member", [("x", "failed")], 0),
    ]
    for case in cases:
        c = configured([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1,
                       failure_budget=0)
        for r in case.1:
            c.report(r.0, r.1, 0)
        testing.assertEqual((c.failures, c.over_budget()), (case.2, case.2 > 0), case.0)


def _test_a_member_that_leaves_no_longer_counts():
    """d0 and d1 failed. When d0 leaves the campaign, only d1 counts. If d0
    joins again before drop() forgets it, it counts again; once drop() has
    forgotten it, it does not. Every status lost, no member counts."""
    devs = devices("d", 3, 600, "w")
    # (the step, the failures after it)
    steps: list[(str, int)] = [
        ("d0 leaves", 1),
        ("d0 joins again", 2),
        ("d0 leaves", 1),
        ("drop d0", 1),
        ("d0 joins again", 1),
        ("every status lost", 0),
    ]
    c = configured([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, failure_budget=0)
    c.report("d0", "failed", 0)
    c.report("d1", "failed", 0)
    testing.assertEqual(c.failures, 2)
    for st in steps:
        if st.0 == "d0 leaves":
            reconfigure(c, devs[1:], 0)
        elif st.0 == "d0 joins again":
            reconfigure(c, devs, 0)
        elif st.0 == "drop d0":
            c.drop({"d0"})
        else:
            c.lost_all()
        testing.assertEqual(c.failures, st.1, st.0)


def _test_the_quiet_time_ends_when_the_budget_holds_or_frees_the_starts():
    """d1 answered up-to-date before the run, and d0 starts, one at a time:
    the decision is quiet until d0 is due. A new count of failures ends
    the quiet time when more members have failed than the budget before
    it or after it: when d1 reports a failure over the budget, and when d1
    reports up-to-date after that failure. A new budget ends the quiet
    time too; the same budget again does not. The next decision then plans
    as a new plan would: over the budget, it holds d1 and d2 and says
    why."""
    # (the budget, or -1 for none, the event, whether the quiet time ends,
    # the alarms of the next decision)
    cases: list[(int, str, bool, list[str])] = [
        (0, "d1 fails", True, [budget_alarm(1, 0)]),
        (1, "d1 fails", False, []),
        (-1, "d1 fails", False, []),
        (0, "d1 fails, then up-to-date", True, []),
        (1, "budget 2", True, []),
        (1, "no budget", True, []),
        (1, "budget 1", False, []),
    ]
    for case in cases:
        label = "budget {case.0}, {case.1}"
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1,
                       failure_budget=case.0)
        c.report("d1", "up-to-date", 0)
        testing.assertEqual(c.decide(0).started, ["d0"], label)
        testing.assertTrue(c.quiet_until > 2, "quiet until {c.quiet_until}, " + label)
        if case.1 == "d1 fails":
            c.report("d1", "failed", 1)
        elif case.1 == "d1 fails, then up-to-date":
            c.report("d1", "failed", 1)
            testing.assertEqual(c.decide(1).plan.alarms, [budget_alarm(1, 0)], label)
            testing.assertTrue(c.quiet_until > 2, "quiet until {c.quiet_until}, " + label)
            c.report("d1", "up-to-date", 2)
        elif case.1 == "budget 2":
            reconfigure(c, c.devices, 2)
        elif case.1 == "no budget":
            reconfigure(c, c.devices, -1)
        else:
            reconfigure(c, c.devices, 1)
        testing.assertEqual(c.quiet_until == 0, case.2, label)
        s = c.decide(2)
        held = sorted(list(s.plan.held.keys()))
        testing.assertEqual((s.started, s.plan.alarms), ([], case.3), label)
        testing.assertEqual(held, ["d1", "d2"] if len(case.3) > 0 else [], label)


def _test_the_alarm_follows_the_failures_over_the_budget():
    """d2 reports failed before the run, more than the budget of zero, so
    the decision at 0 starts nothing, and its plan is quiet. When d1, up to
    date, then reports a failure, the quiet time ends, and the next plan's
    alarm counts two failures."""
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1,
                   failure_budget=0)
    c.report("d1", "up-to-date", 0)
    c.report("d2", "failed", 0)
    s = c.decide(0)
    testing.assertEqual((s.started, s.plan.alarms), ([], [budget_alarm(1, 0)]))
    testing.assertTrue(c.quiet_until > 1, "quiet until {c.quiet_until}")
    c.report("d1", "failed", 1)
    testing.assertEqual(c.quiet_until, 0)
    testing.assertEqual(c.decide(1).plan.alarms, [budget_alarm(2, 0)])


def _test_the_plan_before_a_run_shows_that_a_run_starts_nothing():
    """Before a run, d1 reports failed, from an earlier run. A copy that
    starts a run now, as a campaign in plan shows it, starts nothing at a
    budget of zero: the plan holds every device and says why. At a budget
    of one it starts all three."""
    # (the budget, how many devices the plan starts, the held devices, the
    # alarms)
    cases: list[(int, int, list[str], list[str])] = [
        (0, 0, ["d0", "d1", "d2"], [budget_alarm(1, 0)]),
        (1, 3, [], []),
    ]
    for case in cases:
        label = "budget {case.0}"
        c = configured([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1,
                       failure_budget=case.0)
        c.report("d1", "failed", 0)
        r = c.copy()
        r.start()
        p = r.plan(0)
        testing.assertEqual(len(p.starts), case.1, label)
        testing.assertEqual(sorted(list(p.held.keys())), case.2, label)
        testing.assertEqual(p.alarms, case.3, label)


def _test_a_pause_keeps_the_failures():
    """d0 starts and fails, more than the budget of zero. The run stops,
    and the count stays: a copy that starts a run, as a campaign in plan
    shows it, starts nothing and says why. When the run starts again, it
    starts nothing either, and holds every device."""
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1,
                   failure_budget=0)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "failed", 600)
    s = c.decide(600)
    testing.assertEqual((s.started, s.plan.alarms), ([], [budget_alarm(1, 0)]))
    c.stop()
    testing.assertEqual(c.failures, 1, "stopped")
    r = c.copy()
    r.start()
    p = r.plan(700)
    testing.assertEqual((len(p.starts), p.alarms), (0, [budget_alarm(1, 0)]), "plan")
    c.start()
    testing.assertEqual(c.failures, 1, "run again")
    s = c.decide(800)
    testing.assertEqual((s.started, s.plan.alarms), ([], [budget_alarm(1, 0)]), "run again")
    testing.assertEqual(sorted(list(s.plan.held.keys())), ["d0", "d1", "d2"], "run again")


def _test_releases_go_on_when_the_failures_fit_the_budget_again():
    """20 devices of 600 s in a 1 h window every day, two at a time and at
    most four, with a budget of zero. The plan at 0 promises d0 to d8 the
    first window. d0 starts at 0 and fails at 600, so nothing starts after
    it. At 700 the budget rises to one, or goes, or d0 leaves the
    campaign, or d0 reports a success. The decision then starts d1 at once,
    and its plan has no alarm: three at a time, d1 to d8 still start in
    the window promised to them. From then on the plan is the run."""
    # (the event at 700, how many devices are done in the end)
    cases: list[(str, int)] = [
        ("budget 1", 20),
        ("no budget", 20),
        ("d0 leaves", 19),
        ("d0 succeeds", 20),
    ]
    first = ("day", 0, HOUR)
    for case in cases:
        devs = devices("d", 20, 600, "day")
        c = controller(daily("day", 0, HOUR, 9), devs, 2, 4, False, 1, failure_budget=0)
        testing.assertEqual(c.decide(0).started, ["d0"], case.0)
        c.report("d0", "failed", 600)
        s = c.decide(601)
        testing.assertEqual((s.started, s.plan.alarms), ([], [budget_alarm(1, 0)]), case.0)
        if case.0 == "budget 1":
            reconfigure(c, devs, 1)
        elif case.0 == "no budget":
            reconfigure(c, devs, -1)
        elif case.0 == "d0 leaves":
            reconfigure(c, devs[1:], 0)
            c.drop({"d0"})
        else:
            c.report("d0", "succeeded", 700)
        ds = sim.drive(c, 700, {}, 30 * DAY)
        testing.assertEqual(ds[0].started, ["d1"], case.0)
        p = ds[0].plan
        testing.assertEqual((p.c, p.alarms), (3, []), case.0)
        planned = sim.planned(c, p)
        started = sim.started(c)
        testing.assertEqual(len(planned), 19, case.0)
        testing.assertEqual({n: started[n] for n in planned.keys() if n in started}, planned,
                            case.0)
        testing.assertEqual(len(c.done_times()), case.1, case.0)
        in_first = sorted([n for n, w in c.release_windows().items() if w == first and n != "d0"])
        testing.assertEqual(in_first, ["d{i}" for i in range(1, 9)], case.0)


def _test_decisions_over_the_failure_budget_decide_as_a_new_plan():
    """20 devices of 600 s in a 1 h window every day, two at a time and at
    most four, with a budget of one. d1 and d2 fail on the first day, so
    the starts stop, and no device starts on the second day. On the third
    day the budget rises to two, and the starts go on. Staggered or not,
    each decision decides as a new plan would, and every device is
    done."""
    for stagger in [0, 100]:
        label = "stagger {stagger}"
        c = controller(daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, False, 1,
                       stagger=stagger, failure_budget=1)
        same_as_a_new_plan(c, {}, 9 * DAY, failing=["d1", "d2"], budgets=[(2 * DAY + 600, 2)])
        second_day = [n for n, at in c.release_times().items()
                      if at >= DAY and at < 2 * DAY + 600]
        testing.assertEqual(second_day, [], label)
        testing.assertEqual(len(c.done_times()), 20, label)
        testing.assertEqual(c.failures, 2, label)


def _test_no_member_prepares_while_more_members_failed_than_the_budget():
    """ONE with a budget of zero: the decision at 0 lets d0 prepare. d4
    reports failed at 50, from an earlier run, so more members failed
    than the budget: d0 is let no more, no member has a turn, and the
    prepares show only d0's from 0. When the budget rises to one at 2500,
    the turns go on from then: d1 goes at once, and d2 and d3 share the
    time to their deadline at 10000. d0 has had its turn in this run."""
    c = controller([("w", 10150, fleet_ctl.OPEN_END)], devices("d", 5, 600, "w"), 2, 10,
                   prepare=True, failure_budget=0)
    c.decide(0)
    testing.assertEqual(sorted(list(c.allowed)), ["d0"])
    c.report("d4", "failed", 50)
    s = c.decide(100)
    tr = c.turns(100)
    testing.assertEqual((len(c.allowed), len(tr.0), len(tr.1)), (0, 0, 0))
    testing.assertEqual(s.prepares.starts, {"d0": 0})
    reconfigure(c, c.devices, 1)
    s = c.decide(2500)
    testing.assertEqual(sorted(list(c.allowed)), ["d1"])
    testing.assertEqual(s.prepares.starts, {"d0": 0, "d1": 2500, "d2": 6250, "d3": 10000})


def _test_a_failure_budget_with_redundancy_groups():
    """r1, r2 and r3 upgrade one at a time in a group, and d0 is in no
    group. r1 fails. Within the budget, r2 and r3 wait behind r1, and d0
    starts. Over it, d0 waits too, and the plan gives both alarms. When r1
    then reports a success, r2 starts at a budget of zero; within the
    budget d0 still holds the slot."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("r3", 600, "w"), ("d0", 600, "w")]
    group = "2 device(s) wait behind a failed redundancy group member: r2, r3"
    # (the budget, or -1 for none, the devices that start at 600, the
    # alarms, the held devices, the devices that start at 700)
    cases: list[(int, list[str], list[str], list[str], list[str])] = [
        (-1, ["d0"], [group], ["r2", "r3"], []),
        (1, ["d0"], [group], ["r2", "r3"], []),
        (0, [], [budget_alarm(1, 0), group], ["d0", "r2", "r3"], ["r2"]),
    ]
    for case in cases:
        label = "budget {case.0}"
        c = controller([("w", 0, DAY)], devs, 1, 10, True, groups={"g": ["r1", "r2", "r3"]},
                       priority={"r1": 1, "r2": 2, "r3": 3}, failure_budget=case.0)
        testing.assertEqual(c.decide(0).started, ["r1"], label)
        c.report("r1", "failed", 600)
        s = c.decide(600)
        testing.assertEqual(s.started, case.1, label)
        testing.assertEqual(s.plan.alarms, case.2, label)
        testing.assertEqual(sorted(list(s.plan.held.keys())), case.3, label)
        c.report("r1", "succeeded", 700)
        testing.assertEqual(c.decide(700).started, case.4, label)


#############################################################################
# Devices that are down
#############################################################################

def are_down(names: str) -> str:
    """The plan's alarm for the waiting devices names that are down."""
    n = len(names.split(", "))
    return "{n} device(s) are down: {names}"


def lost_window(names: str) -> str:
    """The plan's alarm for the devices names that lost their promised
    window while held."""
    n = len(names.split(", "))
    return "{n} device(s) lost their promised window while held: {names}"


def down_in_flight(names: str) -> str:
    """The plan's alarm for the devices names in flight that are down past
    their expected end."""
    n = len(names.split(", "))
    return "{n} device(s) in flight are down past their expected end: {names}"


def _test_a_down_member_in_no_group_waits_until_it_is_back_up():
    """d0 to d3 of 600 s, one at a time, in a 1 h window every day. The
    plan at 0 promises the first window to all four. d1, in no group,
    goes down at 100: it is held and keeps its promise, and d2 and d3 take
    the slots. Back up at 1000, it starts when d2 is done, before d3, in
    the window promised to it. Back up at 3000, it no longer fits that
    window: the plan says that it will miss it, and it starts in the
    next."""
    wins = daily("w", 0, HOUR, 2)
    down = are_down("d1")
    miss = "1 device(s) will miss the window they were promised even at max-concurrency 1: d1"
    # (when d1 comes back up, the steps after 100, each as (time, the
    # device that reports a success then or "up", the devices that start,
    # the alarms), the window d1 starts in)
    cases: list[(int, list[(int, str, list[str], list[str])], (str, int, int))] = [
        (1000, [(600, "d0", ["d2"], [down]),
                (1000, "up", [], []),
                (1200, "d2", ["d1"], [])], wins[0]),
        (3000, [(600, "d0", ["d2"], [down]),
                (1200, "d2", ["d3"], [down]),
                (1800, "d3", [], [down]),
                (3000, "up", [], [miss]),
                (HOUR, "", [], []),
                (DAY, "", ["d1"], [])], wins[1]),
    ]
    for case in cases:
        label = "up at {case.0}"
        c = controller(wins, devices("d", 4, 600, "w"), 1, 1)
        testing.assertEqual(c.decide(0).started, ["d0"], label)
        c.set_live("d1", False)
        s = c.decide(100)
        testing.assertEqual(s.started, [], label)
        testing.assertEqual(s.plan.alarms, [down], label)
        testing.assertEqual(s.plan.why, {"d1": ("down", "")}, label)
        testing.assertEqual(s.plan.held, {"d1": (0, 100)}, label)
        testing.assertEqual(c.promised_window("d1"), wins[0], label)
        for st in case.1:
            if st.1 == "up":
                c.set_live("d1", True)
            elif st.1 != "":
                c.report(st.1, "succeeded", st.0)
            s = c.decide(st.0)
            testing.assertEqual((s.started, s.plan.alarms), (st.2, st.3), "{label}, at {st.0}")
        testing.assertEqual(c.release_windows().get("d1"), case.2, label)


def _test_the_plan_holds_down_devices_before_a_run():
    """Before a run, d1 is down. The plan holds it, and says so."""
    c = configured([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1)
    c.set_live("d1", False)
    p = c.plan(0)
    testing.assertEqual(p.alarms, [are_down("d1")])
    testing.assertEqual(p.why, {"d1": ("down", "")})
    testing.assertEqual(sorted(list(p.starts.keys())), ["d0", "d2"])


def _test_a_member_held_when_its_window_closes_loses_its_promise():
    """The same campaign: d1 is held, for each reason below, from before
    600 until 5000, after its promised window closed at 3600. Its promise
    moves to the next window, and the plan says that it lost its window
    while held, also once it is free, until it starts at the next opening.
    The decision right after that start no longer says it."""
    wins = daily("w", 0, HOUR, 2)
    # (the reason, the alarm while it is held)
    cases: list[(str, str)] = [
        ("down", are_down("d1")),
        ("not answered", "1 device(s) have not answered the campaign's target: d1"),
        ("d0 failed", "1 device(s) wait behind a failed redundancy group member: d1"),
    ]
    for case in cases:
        label = case.0
        c = controller(wins, devices("d", 4, 600, "w"), 1, 1, groups={"g": ["d0", "d1"]},
                       priority={"d0": 1, "d1": 2})
        testing.assertEqual(c.decide(0).started, ["d0"], label)
        if label == "down":
            c.set_live("d1", False)
        elif label == "not answered":
            c.lost("d1")
        c.report("d0", "failed" if label == "d0 failed" else "succeeded", 600)
        # (the time, the device that reports a success then, the devices
        # that start, the alarms)
        steps: list[(int, str, list[str], list[str])] = [
            (600, "", ["d2"], [case.1]),
            (1200, "d2", ["d3"], [case.1]),
            (1800, "d3", [], [case.1]),
            (HOUR, "", [], [case.1, lost_window("d1")]),
            (5000, "", [], [lost_window("d1")]),
            (DAY, "", ["d1"], [lost_window("d1")]),
            (DAY + 10, "", [], []),
        ]
        for st in steps:
            if st.0 == 5000:
                if label == "down":
                    c.set_live("d1", True)
                elif label == "not answered":
                    c.report("d1", "upgrade-needed", 5000)
                else:
                    c.report("d0", "succeeded", 5000)
            if st.1 != "":
                c.report(st.1, "succeeded", st.0)
            s = c.decide(st.0)
            testing.assertEqual((s.started, s.plan.alarms), (st.2, st.3), "{label}, at {st.0}")
            if st.0 == HOUR:
                testing.assertEqual(c.promised_window("d1"), wins[1], label)
        testing.assertEqual(c.release_windows().get("d1"), wins[1], label)


def _test_a_pause_or_leaving_ends_the_alarm_for_a_lost_window():
    """d0 and d1 of 600 s, one at a time, in a 1 h window on two days. d1
    goes down after the plan at 0 promised it the first window, and loses
    that window at its close. A plan after a pause, and a plan after d1
    left the campaign and joined it again, no longer say that d1 lost its
    window."""
    wins = daily("w", 0, HOUR, 2)
    devs = devices("d", 2, 600, "w")
    for how in ["pause", "leave"]:
        c = controller(wins, devs, 1, 1)
        testing.assertEqual(c.decide(0).started, ["d0"], how)
        c.set_live("d1", False)
        c.report("d0", "succeeded", 600)
        c.decide(600)
        testing.assertEqual(c.decide(HOUR).plan.alarms, [are_down("d1"), lost_window("d1")],
                            how)
        if how == "pause":
            c.stop()
        else:
            reconfigure(c, devs[:1], -1)
            c.drop({"d1"})
            reconfigure(c, devs, -1)
        testing.assertEqual(c.plan(HOUR + 10).alarms, [are_down("d1")], how)


def _test_a_held_member_without_a_window_left_is_held():
    """d0 and d1 of 600 s, one at a time, in a 1 h window on two days. d1
    goes down after the plan at 0 promised it the first window, and stays
    down past the last window. The plan after that window shows d1 in no
    window, but still holds it, for down."""
    wins = daily("w", 0, HOUR, 2)
    c = controller(wins, devices("d", 2, 600, "w"), 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.set_live("d1", False)
    c.report("d0", "succeeded", 600)
    for t in [600, HOUR, DAY]:
        c.decide(t)
    p = c.decide(DAY + HOUR).plan
    testing.assertEqual((p.why, p.held, p.alarms),
                        ({"d1": ("down", "")}, {}, [are_down("d1"), lost_window("d1")]))


def _test_a_member_that_goes_down_and_up_again_is_looked_at_once_in_each_window():
    """d0, d1 and d2 of 600 s, one at a time, in a 1 h window every day
    for 9 days. d0 starts at 0. Then d1, in no group, or z, in a group with
    d1 and not in the campaign, goes down and comes back up three times,
    with a decision after each change. Each window of d1's schedule looks
    at d1 again once, not once for each time it came back up."""
    wins = daily("w", 0, HOUR, 9)
    # (the groups, the device that goes down and comes back up)
    cases: list[(dict[str, list[str]], str)] = [
        ({}, "d1"),
        ({"g": ["d1", "z"]}, "z"),
    ]
    for case in cases:
        c = controller(wins, devices("d", 3, 600, "w"), 1, 1, groups=case.0,
                       priority={"d1": 1, "z": 2})
        testing.assertEqual(c.decide(0).started, ["d0"], case.1)
        t = 0
        for _round in range(3):
            for up in [False, True]:
                t += 10
                c.set_live(case.1, up)
                c.decide(t)
        k = c.names.num["d1"]
        testing.assertEqual([len([d for d in r if d == k]) for r in c.retry],
                            [1 for _w in wins], case.1)
        c.report("d0", "succeeded", 600)
        testing.assertEqual(c.decide(600).started, ["d1"], case.1)


def _test_a_member_in_flight_that_is_down_holds_its_slot():
    """d0 starts at 0, one at a time, in a window that never closes, and
    goes down at 100, as a device does when it reboots. In a group or not,
    that keeps the quiet time. d0 holds its slot and no one else, and the
    plan expects it back up when its upgrade ends at 600. While it is down
    after that, the plan says so. Back up at 700, it reports, and d1
    starts."""
    groups: list[dict[str, list[str]]] = [{}, {"g": ["d0", "x"]}]
    for g in groups:
        label = str(g)
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1,
                       groups=g, priority={"d0": 1, "x": 2})
        testing.assertEqual(c.decide(0).started, ["d0"], label)
        quiet = c.quiet_until
        testing.assertEqual(c.set_live("d0", False), False, label)
        testing.assertEqual(c.quiet_until, quiet, label)
        s = c.decide(100)
        testing.assertEqual((s.started, s.plan.alarms, s.plan.starts["d1"]), ([], [], (0, 600)),
                            label)
        s = c.decide(601)
        testing.assertEqual((s.started, s.plan.alarms), ([], [down_in_flight("d0")]), label)
        c.set_live("d0", True)
        c.report("d0", "succeeded", 700)
        s = c.decide(700)
        testing.assertEqual((s.started, s.plan.alarms), (["d1"], []), label)


def _test_the_alarm_for_a_member_in_flight_that_is_down_follows_the_pace():
    """d0 and d1 start at 0, two at a time, in a window that never closes.
    d0 succeeds at 150, so the pace falls to 375 s, and so does d1's
    expected end; d2 starts, due at 525. While d1 is down after 375, the
    plan says so, and a decision wakes at 376 for it. When d1 goes down
    after the decision at 150, set_live says that the campaign must decide
    before that decision's wake. When d1 comes back up after 375, set_live
    says so too, and the plan no longer names d1."""
    gone = down_in_flight("d1")
    # (when d1 goes down and what set_live returns, when it comes back up
    # or -1 and what set_live returns, the decisions after the one at 0 as
    # (time, alarms, wake))
    cases: list[(int, bool, int, bool, list[(int, list[str], int)])] = [
        (100, False, -1, False, [(150, [], 376), (376, [gone], 525)]),
        (300, True, -1, False, [(150, [], 525), (300, [], 376), (376, [gone], 525)]),
        (380, True, -1, False, [(150, [], 525), (380, [gone], 525)]),
        (100, False, 450, True, [(150, [], 376), (376, [gone], 525), (450, [], 525)]),
    ]
    for case in cases:
        label = "down at {case.0}, up at {case.2}"
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 4, 600, "w"), 2, 2, rung=2)
        testing.assertEqual(c.decide(0).started, ["d0", "d1"], label)
        c.report("d0", "succeeded", 150)
        down_at = case.0
        up_at = case.2
        for st in case.4:
            if down_at >= 0 and down_at <= st.0:
                testing.assertEqual(c.set_live("d1", False), case.1, "{label}, down")
                down_at = -1
            if up_at >= 0 and up_at <= st.0:
                testing.assertEqual(c.set_live("d1", True), case.3, "{label}, up")
                up_at = -1
            d = c.copy()
            s = c.decide(st.0)
            testing.assertEqual((s.plan.alarms, s.wake), (st.1, st.2), "{label}, at {st.0}")
            testing.assertEqual(d.plan(st.0).alarms, st.1, "{label}, new plan at {st.0}")
            if st.0 == 150:
                testing.assertEqual((s.started, c.observed_s), (["d2"], 375), label)


def _test_why_each_device_is_held():
    """r1, r2 and r3 upgrade one at a time in the groups g1 and g2, r1
    first; d1 is in g3 with z, which is not in the campaign; d0 is in no
    group. r1 starts at 0 and reports at 600. Each held device has the
    first reason that applies to it, its own first, and the device that
    holds it when another one does."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("r3", 600, "w"), ("d0", 600, "w"),
            ("d1", 600, "w")]
    groups = {"g1": ["r1", "r2"], "g2": ["r2", "r3"], "g3": ["d1", "z"]}
    priority = {"r1": 1, "r2": 2, "r3": 3, "d1": 1, "z": 2}
    fb = ("failure-budget", "")
    # (the case, the failure budget, r1's report, the devices that go down,
    # the devices whose answer is lost, the waiting devices that report a
    # failure, why each device is held)
    cases: list[(str, int, str, list[str], list[str], list[str], dict[str, (str, str)])] = [
        ("nothing", -1, "succeeded", [], [], [], {}),
        ("r1 failed", -1, "failed", [], [], [],
         {"r2": ("group-failed", "r1"), "r3": ("group-failed", "r1")}),
        ("r2 down", -1, "succeeded", ["r2"], [], [],
         {"r2": ("down", ""), "r3": ("group-down", "r2")}),
        ("r2 not answered", -1, "succeeded", [], ["r2"], [],
         {"r2": ("not-answered", ""), "r3": ("group-not-answered", "r2")}),
        ("r3 not answered", -1, "succeeded", [], ["r3"], [], {"r3": ("not-answered", "")}),
        ("r2 down and not answered", -1, "succeeded", ["r2"], ["r2"], [],
         {"r2": ("down", ""), "r3": ("group-down", "r2")}),
        ("r1 failed, r2 not answered", -1, "failed", [], ["r2"], [],
         {"r2": ("not-answered", ""), "r3": ("group-failed", "r1")}),
        ("r1 failed, r3 down", -1, "failed", ["r3"], [], [],
         {"r2": ("group-failed", "r1"), "r3": ("down", "")}),
        ("z down", -1, "succeeded", ["z"], [], [], {"d1": ("group-down", "z")}),
        ("d0 down", -1, "succeeded", ["d0"], [], [], {"d0": ("down", "")}),
        ("over the budget", 0, "failed", [], [], [],
         {"r2": ("group-failed", "r1"), "r3": ("group-failed", "r1"), "d0": fb, "d1": fb}),
        ("over the budget, d0 down", 0, "failed", ["d0"], [], [],
         {"r2": ("group-failed", "r1"), "r3": ("group-failed", "r1"), "d0": ("down", ""),
          "d1": fb}),
        ("over the budget, z down", 0, "failed", ["z"], [], [],
         {"r2": ("group-failed", "r1"), "r3": ("group-failed", "r1"), "d0": fb,
          "d1": ("group-down", "z")}),
        ("over the budget by d0, r2 not answered", 0, "succeeded", [], ["r2"], ["d0"],
         {"r2": ("not-answered", ""), "r3": ("group-not-answered", "r2"), "d0": fb,
          "d1": fb}),
    ]
    for case in cases:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups=groups,
                       priority=priority, failure_budget=case.1)
        testing.assertEqual(c.decide(0).started, ["r1"], case.0)
        c.report("r1", case.2, 600)
        for name in case.3:
            c.set_live(name, False)
        for name in case.4:
            c.lost(name)
        for name in case.5:
            c.report(name, "failed", 600)
        p = c.plan(600)
        testing.assertEqual(p.why, case.6, case.0)
        testing.assertEqual(sorted(list(p.held.keys())), sorted(list(case.6.keys())), case.0)


def _test_a_change_of_up_or_down_ends_the_quiet_time_of_a_waiting_member_or_a_group():
    """d0 and r1 start at 0, two at a time; r1 and r2 are in a group with
    z, which is not in the campaign, and x is in no group and not in the
    campaign. A device that goes down, and comes back up, ends the quiet
    time when it is a member that waits or it is in a group. d0 and r1, in
    flight without a report, and x do not."""
    devs = [("d0", 600, "w"), ("r1", 600, "w"), ("d1", 600, "w"), ("r2", 600, "w")]
    # (the device, whether a change ends the quiet time)
    cases: list[(str, bool)] = [
        ("d0", False),
        ("r1", False),
        ("d1", True),
        ("r2", True),
        ("z", True),
        ("x", False),
    ]
    for case in cases:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 2, 2,
                       groups={"g": ["r1", "r2", "z"]}, priority={"r1": 1, "r2": 2, "z": 3},
                       rung=2)
        testing.assertEqual(c.decide(0).started, ["d0", "r1"], case.0)
        for up in [False, True]:
            quiet = c.quiet_until
            testing.assertTrue(quiet > 10, "quiet until {quiet}, " + case.0)
            c.set_live(case.0, up)
            testing.assertEqual(c.quiet_until == 0, case.1, "{case.0}, up {up}")
            c.decide(10 if not up else 20)


def _test_a_member_that_is_down_has_no_turn_to_prepare():
    """ONE: each member's turn to prepare. d1 goes down after the plan at 0
    promised it the window: it keeps its promise but has no turn, also in
    the next plan, and the others share the time. Back up, it has its
    turn again."""
    c = one()
    c.plan(0)
    all_five = {"d0": 0, "d1": 2500, "d2": 5000, "d3": 7500, "d4": 10000}
    testing.assertEqual(c.prepares(0).starts, all_five)
    c.set_live("d1", False)
    without = {"d0": 0, "d2": 3333, "d3": 6666, "d4": 10000}
    testing.assertEqual(c.prepares(0).starts, without)
    c.plan(0)
    testing.assertEqual(c.prepares(0).starts, without)
    c.set_live("d1", True)
    testing.assertEqual(c.prepares(0).starts, all_five)


def _test_decisions_with_devices_that_go_down_decide_as_a_new_plan():
    """20 devices of 600 s in a 1 h window every day, two at a time and at
    most four; d17 and d18 are in a group with z, which is not in the
    campaign. Each device reboots during its upgrade. d5 is down from 0 to
    2000, z from DAY + 100 to DAY + 900, and d12 from 1000 on: it loses its
    window, and every later plan holds it. Staggered or not, each decision
    decides as a new plan would, and the decisions in which only devices
    start or reboot take the last plan again."""
    lives: list[(int, str, bool)] = [
        (0, "d5", False),
        (1000, "d12", False),
        (2000, "d5", True),
        (DAY + 100, "z", False),
        (DAY + 900, "z", True),
    ]
    for stagger in [0, 100]:
        label = "stagger {stagger}"
        c = controller(daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, False, 1,
                       groups={"g": ["d17", "d18", "z"]}, priority={"d17": 1, "d18": 2, "z": 3},
                       stagger=stagger)
        again = same_as_a_new_plan(c, {}, 9 * DAY, lives=lives, reboots=True)
        testing.assertTrue(again > 0, "{label}: {again} decisions took the plan again")
        testing.assertEqual(sorted(list(c.released_devices())),
                            sorted(["d{i}" for i in range(20) if i != 12]), label)


def _test_the_plan_with_a_down_member_is_the_run_of_the_others():
    """20 devices of 600 s in a 1 h window every day, two at a time and at
    most four. d7 is down from the start and stays down, in no group or in
    a group with d6. The first plan holds d7, and d6 too when d7 is in its
    group, and only says so; the run starts every other device where
    and when that plan said, and never starts the held ones."""
    # (the groups, the held devices)
    cases: list[(dict[str, list[str]], list[str])] = [
        ({}, ["d7"]),
        ({"g": ["d6", "d7"]}, ["d6", "d7"]),
    ]
    for case in cases:
        label = str(case.0)
        c = controller(daily("day", 0, HOUR, 9), devices("d", 20, 600, "day"), 2, 4, False, 1,
                       groups=case.0, priority={"d6": 1, "d7": 2})
        c.set_live("d7", False)
        p = c.plan(0)
        testing.assertEqual(sorted(list(p.why.keys())), case.1, label)
        for a in p.alarms:
            testing.assertTrue("are down" in a or "is down" in a, label + ": " + a)
        sim.drive(c, 0, {}, 30 * DAY)
        testing.assertEqual(sim.started(c), sim.planned(c, p), label)
        testing.assertEqual(len(c.released_devices()), 20 - len(case.1), label)


#############################################################################
# Whole campaigns on upgrade times that differ from the estimate
#############################################################################

class Campaign(object):
    """A campaign for the tests below: its windows and devices, the target
    and max concurrency, the debounce, the campaign's estimate and the
    time that a run goes on to. The ramp starts at one device."""
    windows: list[(str, int, int)]
    devs: list[(str, int, str)]
    target: int
    maxc: int
    debounce: int
    estimate: int
    until: int

    def __init__(self, windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
                 maxc: int, debounce: int, estimate: int, until: int):
        self.windows = windows
        self.devs = devs
        self.target = target
        self.maxc = maxc
        self.debounce = debounce
        self.estimate = estimate
        self.until = until


def nights(n: int=79) -> Campaign:
    """n devices of 600 s in a 40 min window at midnight every day for 8
    days, 8 at once and up to 32, and a debounce of 1 s. A round of
    upgrades takes 601 s. A round fits in a night when it starts by
    00:25:00, with the 900 s that one and a half times the slow time
    needs, so a night holds three rounds. For 79 devices the first plan
    promises 13 to the first night, in rounds of 1, 4 and 8, 24 to each
    of the next two nights, and 18 to the fourth."""
    return Campaign(daily("night", 0, 2400, 8), devices("d", n, 600, "night"), 8, 32, 1, 600,
                    8 * DAY)


def edge(length: int) -> Campaign:
    """41 devices of 600 s in a window of length seconds every day for 2
    days, 8 at once and up to 32, and a debounce of 30 s. A round of
    upgrades takes 630 s. In a 4140 s window the first plan promises 37
    devices to the first window, in rounds of 1, 4, 8, 8, 8 and 8, and in
    a 3510 s window 29, one round less."""
    return Campaign(daily("w", 0, length, 2), devices("d", 41, 600, "w"), 8, 32, 30, 600,
                    2 * DAY)


def clock(t: int) -> str:
    """The time t as day and time of day, to the second."""
    return f"d{t // DAY} {(t % DAY) // HOUR:02d}:{(t % HOUR) // 60:02d}:{t % 60:02d}"


class Outcome(object):
    """What one run of a campaign did.

    cpath has the concurrency at the first decision and at each change,
    as (time, concurrency). broken counts the devices that did not start
    in the window that the first plan promised them, overran the devices
    in flight when their window closed, and unstarted the devices that did
    not start. decisions counts the decisions, alarmed the decisions whose
    plan says that devices will miss their window, and unfit the decisions
    whose plan says that devices fit in no window. peak is the most
    devices in flight after a decision, slowest the longest slow time
    after a decision, and slow_at the slow time after each decision, by
    the time of the decision."""
    cpath: list[(int, int)]
    broken: int
    overran: int
    unstarted: int
    decisions: int
    alarmed: int
    unfit: int
    peak: int
    slowest: int
    slow_at: dict[int, int]

    def __init__(self, cpath: list[(int, int)], broken: int, overran: int, unstarted: int,
                 decisions: int, alarmed: int, unfit: int, peak: int, slowest: int,
                 slow_at: dict[int, int]):
        self.cpath = cpath
        self.broken = broken
        self.overran = overran
        self.unstarted = unstarted
        self.decisions = decisions
        self.alarmed = alarmed
        self.unfit = unfit
        self.peak = peak
        self.slowest = slowest
        self.slow_at = slow_at

    def top(self) -> int:
        """The highest concurrency of the run."""
        top = 0
        for e in self.cpath:
            top = fleet_ctl.imax(top, e.1)
        return top

    def changes(self) -> str:
        """The changes of the concurrency after the first decision."""
        return ", then ".join(["to {e.1} at {clock(e.0)}" for e in self.cpath[1:]])


def run(cp: Campaign, maxc: int, durations: dict[str, int]) -> Outcome:
    """Run the campaign cp at max-concurrency maxc the way the campaign
    actor runs it. A device in durations takes that time, the others
    their estimate."""
    c = controller(cp.windows, cp.devs, cp.target, maxc, debounce=cp.debounce,
                   estimate=cp.estimate)
    first = sim.planned(c, c.plan(0))
    ds = sim.drive(c, 0, durations, cp.until)
    starts = sim.started(c)
    est = {d.0: d.1 for d in cp.devs}
    broken = 0
    for name, p in first.items():
        if name not in starts or starts[name].0 != p.0:
            broken += 1
    overran = 0
    for name, s in starts.items():
        if s.1 + durations.get_def(name, est[name]) > s.0.2:
            overran += 1
    cpath: list[(int, int)] = []
    alarmed = 0
    unfit = 0
    peak = 0
    slowest = 0
    slow_at: dict[int, int] = {}
    for d in ds:
        if len(cpath) == 0 or cpath[len(cpath) - 1].1 != d.c:
            cpath.append((d.t, d.c))
        if len([a for a in d.alarms if "will miss" in a]) > 0:
            alarmed += 1
        if len([a for a in d.alarms if "fit in no window" in a]) > 0:
            unfit += 1
        peak = fleet_ctl.imax(peak, d.flying)
        slowest = fleet_ctl.imax(slowest, d.slow)
        slow_at[d.t] = d.slow
    return Outcome(cpath, broken, overran, len(cp.devs) - len(starts), len(ds), alarmed, unfit,
                   peak, slowest, slow_at)


def out_of_bounds(o: Outcome, room: str, most: int, broken: int, overran: int) -> list[str]:
    """What goes wrong in the run o, one problem to a line, each line
    starting with room: a device that does not start, more than broken
    promises that break, more than overran devices in flight when their
    window closes, an alarm when no promise breaks, a promise that breaks
    with no alarm, or more than most devices at once."""
    problems: list[str] = []
    if o.unstarted > 0:
        problems.append("{room}: {o.unstarted} device(s) do not start")
    if o.broken > broken:
        problems.append("{room}: {o.broken} promise(s) break, at most {broken}")
    if o.overran > overran:
        problems.append("{room}: {o.overran} device(s) in flight when their window closes, "
                        + "at most {overran}")
    if o.alarmed > 0 and o.broken == 0:
        problems.append("{room}: will-miss alarms in {o.alarmed} of {o.decisions} plans, "
                        + "and no promise breaks")
    if o.broken > 0 and o.alarmed == 0:
        problems.append("{room}: {o.broken} promise(s) break, and no plan says so")
    if o.top() > most or o.peak > most:
        problems.append("{room}: the concurrency goes {o.changes()}, and {o.peak} devices "
                        + "are in flight at once, at most {most}")
    return problems


def keeps_its_promises(cp: Campaign, cases: list[(str, dict[str, int])]) -> None:
    """Run the campaign cp for each case, as (what the upgrade times are,
    the times), held at the target and with room up to max-concurrency.
    Both runs must keep every promise, start every device, run no device
    past its window's close, and give no alarm: the times need no rise.
    With room, the concurrency may rise, but to no more than twice the
    target. The test fails with what goes wrong, one to a line."""
    problems: list[str] = []
    for case in cases:
        held = run(cp, cp.target, case.1)
        problems.extend(out_of_bounds(held, "{case.0}, held at {cp.target}", cp.target, 0, 0))
        o = run(cp, cp.maxc, case.1)
        problems.extend(out_of_bounds(o, "{case.0}, up to {cp.maxc}", 2 * cp.target, 0, 0))
    testing.assertTrue(len(problems) == 0, "\n" + "\n".join(problems))


def needs_a_rise(cp: Campaign, cases: list[(str, dict[str, int], int, int)]) -> None:
    """Run the campaign cp for each case, as (what the upgrade times are,
    the times, the most promises that may break, the most devices that
    may be in flight when their window closes), held at the target and
    with room up to max-concurrency. Held at the target, more promises
    break than the case lets break, so the concurrency must rise. With
    room it must rise, break and overrun no more than the case lets, start
    every device, give an alarm when and only when a promise breaks, and
    stay at max-concurrency or below. The test fails with what goes
    wrong, one to a line."""
    problems: list[str] = []
    for case in cases:
        held = run(cp, cp.target, case.1)
        if held.broken <= case.2:
            problems.append("{case.0}, held at {cp.target}: only {held.broken} promise(s) "
                            + "break, so no rise is needed")
        o = run(cp, cp.maxc, case.1)
        room = "{case.0}, up to {cp.maxc}"
        if o.top() <= cp.target:
            problems.append("{room}: the concurrency does not rise")
        problems.extend(out_of_bounds(o, room, cp.maxc, case.2, case.3))
    testing.assertTrue(len(problems) == 0, "\n" + "\n".join(problems))


def late_by_seconds() -> list[(str, dict[str, int])]:
    """Upgrade times where one device ends 3 to 60 s late: in the round of
    1, in the round of 4 (3 s and 60 s late), and in the first round of
    the second night. The device reports before a fifth of its upgrade,
    120 s, has passed since it was expected to end, so it is not late.
    Held at 8, the run keeps every promise."""
    return [
        ("d0 ends 10 s late", {"d0": 610}),
        ("d1 ends 3 s late", {"d1": 603}),
        ("d1 ends 60 s late", {"d1": 660}),
        ("d13 ends 10 s late", {"d13": 610}),
    ]


def _test_a_device_seconds_late_stays_near_the_target():
    """On the times of late_by_seconds(), held at 8, the run keeps every
    promise and gives no alarm. With room up to 32 it must do so too, and
    run no more than 16 at once."""
    keeps_its_promises(nights(), late_by_seconds())


def early_by_seconds() -> list[(str, dict[str, int])]:
    """Upgrade times where one device ends 10 s early: in the round of 1,
    and in the last round of the first night. Its report moves the
    observed pace below 600 s. So the devices that start after the report
    end a few seconds after they are expected to, long before they are
    late. Held at 8, the run keeps every promise."""
    return [
        ("d0 ends 10 s early", {"d0": 590}),
        ("d6 ends 10 s early", {"d6": 590}),
    ]


def _test_a_device_seconds_early_stays_near_the_target():
    """On the times of early_by_seconds(), held at 8, the run keeps every
    promise and gives no alarm. With room up to 32 it must do so too, and
    run no more than 16 at once."""
    keeps_its_promises(nights(), early_by_seconds())


def scattered() -> list[(str, dict[str, int])]:
    """Upgrade times for d0 to d78 that scatter around the estimate: 570,
    630, 600, 660 and 540 s in turn. d0 ends 30 s early, and the observed
    pace falls below 600 s. So d1 and d2 end after they are expected to,
    d2 although it takes its 600 s estimate, and so do later devices of
    600 s or more, but none is late. The slow time goes up to 660 s, and
    then a round fits in a night when it starts by 00:23:30, as the third
    round does. Held at 8, the run keeps every promise."""
    times = [570, 630, 600, 660, 540]
    return [("570, 630, 600, 660 and 540 s in turn",
             {"d{i}": times[i % len(times)] for i in range(79)})]


def _test_scattered_upgrades_stay_near_the_target():
    """On the times of scattered(), held at 8, the run keeps every
    promise and gives no alarm. With room up to 32 it must do so too, and
    run no more than 16 at once."""
    keeps_its_promises(nights(), scattered())


def one_slow_upgrade() -> list[(str, dict[str, int])]:
    """Upgrade times where d6, in the last round of the first night, takes
    950 s. It ends before the night closes, and after the last start that
    fits in it. One slow upgrade moves the slow time only through the
    pace: its report makes the pace, the mean of the last ten upgrades,
    635 s, and the slow time with it, so a night still holds three rounds.
    Held at 8, the run keeps every promise."""
    return [("d6 takes 950 s", {"d6": 950})]


def _test_one_slow_upgrade_stays_near_the_target():
    """On the times of one_slow_upgrade(), held at 8, the run keeps every
    promise and gives no alarm. With room up to 32 it must do so too, and
    run no more than 16 at once."""
    keeps_its_promises(nights(), one_slow_upgrade())


def round_of_8() -> list[(str, dict[str, int])]:
    """Upgrade times for the first round of 8 of edge(), d5 to d12, that
    average the 600 s estimate, with the slower devices last. The round
    starts at 00:21:00. The upgrades after the round take 600 s. The next
    devices start when the round's times count, from 00:31:06 to 00:31:54,
    and the rounds after them 630 s later each: the last devices start at
    00:42:24 in a 3510 s window and at 00:52:54 in a 4140 s window."""
    return [
        ("four take 576 s, then four 624 s",
         {"d5": 576, "d6": 576, "d7": 576, "d8": 576,
          "d9": 624, "d10": 624, "d11": 624, "d12": 624}),
        ("they take 576, 582, 588, 594, 606, 612, 618 and 624 s",
         {"d5": 576, "d6": 582, "d7": 588, "d8": 594,
          "d9": 606, "d10": 612, "d11": 618, "d12": 624}),
    ]


def _test_a_round_that_averages_the_estimate_keeps_every_promise():
    """On the times of round_of_8(), in a 4140 s window and in a 3510 s
    window, held at 8, the run keeps every promise and gives no alarm.
    With room up to 32 it must do so too, and run no more than 16 at once.
    Once the round's times count, the slow time is their second longest,
    624 s or 618 s, so each window has room after its last start for one
    and a half times the round's longest time, 936 s, and 30 s more."""
    keeps_its_promises(edge(4140), round_of_8())
    keeps_its_promises(edge(3510), round_of_8())


def _test_upgrades_too_slow_for_8_at_once_raise_the_concurrency():
    """When every upgrade takes 720 s, the slow time is 720 s, a round
    must start 1080 s before the close, and 2 rounds fit in a night, not
    3. The first night starts 5 devices at any concurrency, so 8 promises
    break. When d1 takes 1200 s, it holds a slot of the third round of the
    first night, which starts 7 devices, not 8. d1 is late at 00:22:02,
    but the ramp lets no more devices be in flight until a device is
    done: when d1's 1200 s count, at 00:30:02, the night has no room left
    for d12. So 1 promise breaks at any concurrency. Held at 8, more break
    in both cases."""
    needs_a_rise(nights(), [
        ("every upgrade takes 720 s", {"d{i}": 720 for i in range(79)}, 8, 0),
        ("d1 takes 1200 s", {"d1": 1200}, 1, 0),
    ])


def _test_a_change_of_pace_raises_the_concurrency_in_time():
    """The upgrades become 30 % slower. Then 2 rounds fit in a night, not
    3, and the concurrency must rise before the rest of the night is
    lost. The slow time must follow the change, so that no device starts
    that is then in flight when its window closes."""
    later: dict[str, int] = {}
    for i in range(79):
        later["d{i}"] = 570 if i < 37 else 780
    needs_a_rise(nights(), [
        ("780 s from the second night", {"d{i}": 780 for i in range(13, 79)}, 0, 0),
        # Every upgrade before the change ends early, so the first round
        # of the third night is late at 00:11:25, and the plan, which
        # expects it to take one more upgrade, raises the concurrency to
        # 16. When the round's 780 s count, at 00:13:01, its 8 devices
        # done take the ramp to 16, and 16 devices start.
        ("570 s for two nights, then 780 s", later, 0, 0),
    ])


def every_tenth(n: int) -> dict[str, int]:
    """Upgrade times where every tenth of n devices, d9, d19 and so on,
    takes 1500 s, 2.5 times its estimate of 600 s."""
    out: dict[str, int] = {}
    for i in range(n):
        if i % 10 == 9:
            out["d{i}"] = 1500
    return out


def _test_a_heavy_tail_raises_the_concurrency():
    """Some devices take 1500 s, 2.5 times their estimate. While two such
    upgrades are among the kept times, the last 50 held at 8 and the last
    64 up to 32, the slow time is 1500 s, and a night starts devices only
    in its first 150 s. So the concurrency must rise. The ramp follows
    the rise only as devices are done, and few are done between the rise
    and the next night."""
    needs_a_rise(nights(), [
        # d2 holds a slot of the third round of the first night, which
        # starts 7 devices, and d12 misses the night. When d20's 1500 s
        # count, at 00:25:01 of the second night, the slow time is
        # 1500 s. d20 done takes the ramp to 16, and d36, the one device
        # done after it that night, to 19: the third night starts 19
        # devices, and 5 miss it at any concurrency.
        ("d2, d20 and d45 take 1500 s", {"d2": 1500, "d20": 1500, "d45": 1500}, 6, 0),
        # d9, d19, ... d69. d9 starts in the third round of the first
        # night, before any upgrade of 1500 s has counted, and is in
        # flight when the night closes. No other device is. When d19's
        # 1500 s count, at 00:25:01 of the second night, the slow time is
        # 1500 s. d19 done takes the ramp to 16, and the two devices done
        # after it that night to 22: the third night starts 22 devices,
        # and 2 miss it at any concurrency.
        ("every tenth device takes 1500 s", every_tenth(79), 2, 1),
    ])


def _test_the_plan_does_not_rise_to_max_concurrency_to_forget_a_slow_upgrade():
    """nights(), every tenth device takes 1500 s, at max-concurrency 50
    and at 64. The controller keeps the last 100 and the last 128 upgrade
    times. The 98th percentile of either is the third longest, and the
    slow time is that, or the pace when the pace is longer. The campaign
    has 79 devices, so both keep every time of the run, and the slow time
    after each decision is the same at 50 and at 64. d9's and d19's
    1500 s count at 00:45:03 of the first night and at 00:25:01 of the
    second, and the slow time stays at the pace. It becomes 1500 s when
    the third, d29's, counts, at 00:35:02. Each run ahead of a plan takes
    the slow time from all the kept times, whatever its concurrency, so a
    run at max-concurrency forgets no slow upgrade that a run at a lower
    concurrency sees, and the plan gains nothing by a rise to
    max-concurrency. So at 50 and at 64 the concurrency must take the
    same path, and stay below 50. If a run took the slow time over two
    rounds at its own concurrency, a run at 13 would see the second
    longest of the last 50 times, and a run at 50 or more the third
    longest of the last 100 times or more. When d19's time counts, the
    runs at 50 and more would forget it and break fewer promises, and the
    plan would rise to 50, up to 50 and up to 64 alike."""
    cp = nights()
    outcomes = [run(cp, maxc, every_tenth(79)) for maxc in [50, 64]]
    testing.assertEqual(outcomes[1].slow_at, outcomes[0].slow_at, "the slow times up to 50 and 64")
    testing.assertEqual(outcomes[0].slowest, 1500, "the longest slow time")
    testing.assertEqual(outcomes[1].cpath, outcomes[0].cpath,
                        "up to 64 the concurrency goes {outcomes[1].changes()}; up to 50 it "
                        + "goes {outcomes[0].changes()}")
    testing.assertTrue(outcomes[0].top() < 50,
                       "up to 50 the concurrency goes {outcomes[0].changes()}, to 50")


def _test_a_heavy_tail_runs_no_device_past_the_close():
    """60 devices of 600 s, 16 at once and up to 32, and a 4000 s window,
    to 01:06:40, every night. Every tenth device takes 1500 s, 2.5 times
    its estimate. The slow time is the second longest of the last 64
    upgrade times, two rounds at max-concurrency, or the pace when that is
    longer, so the tail raises it only once it has shown twice. One slow
    upgrade alone moves it only through the pace, and the night's last
    starts could then run past the close. Here the tail shows twice before
    them: d9 and d19 start in the round of 16 at 00:20:02, and when their
    1500 s count, at 00:45:03, the slow time is 1500 s. The night starts
    no more devices: each would need 2250 s. d29 and d39, which started
    before then, end by 01:05:04.
    Every device must start, none may be in flight when its window
    closes, and the concurrency may not go above 32."""
    cp = Campaign(daily("night", 0, 4000, 3), devices("d", 60, 600, "night"), 16, 32, 1, 600,
                  3 * DAY)
    o = run(cp, cp.maxc, every_tenth(60))
    problems = out_of_bounds(o, "every tenth device takes 1500 s", cp.maxc, len(cp.devs), 0)
    testing.assertTrue(len(problems) == 0, "\n" + "\n".join(problems))


def _test_a_device_that_never_reports_is_looked_at_no_more_than_three_times_an_upgrade():
    """37 devices: 13 for the first night and 24 for the second. d1 never
    reports. It holds its slot, and each time it is late the plan expects
    it to end one upgrade later. So while nothing else happens, the
    controller decides twice in each 721 s: when the report could count,
    and when the device is late, a fifth of its upgrade later. That is
    about 250 times up to the end of the second night. The run may have at
    most three decisions in each upgrade time of 600 s. d1 also holds a
    slot of the third round of the first night, which starts 7 devices,
    so d12 misses the night. The plan raises the concurrency to 9, and
    the second night runs three rounds of 8 beside d1, so d36 misses it.
    2 promises break, and no device but d1 is in flight when its window
    closes."""
    cp = nights(37)
    cp.until = DAY + 2400
    o = run(cp, 32, {"d1": 100 * DAY})
    most = 3 * cp.until // 600
    testing.assertTrue(o.decisions <= most, "{o.decisions} decisions, at most {most}")
    testing.assertTrue(o.broken <= 2, "{o.broken} broken promises, at most 2")
    testing.assertTrue(o.overran <= 1, "{o.overran} devices in flight at a close, at most 1")
