"""Tests of the controller's release decisions, on times the tests give."""

import testing

import fleet_ctl
from fleet_ctl import Controller
import fleet_sched_sim as sim

HOUR = 3600
DAY = 86400


def devices(prefix: str, n: int, est: int, schedule: str) -> list[(str, int, str)]:
    """n devices prefix0, prefix1, ... of est seconds on schedule."""
    return [("{prefix}{i}", est, schedule) for i in range(n)]


def daily(schedule: str, start: int, length: int, days: int) -> list[(str, int, int)]:
    """A window of length seconds at start every day for days days."""
    return [(schedule, d * DAY + start, d * DAY + start + length) for d in range(days)]


def controller(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
               maxc: int, must_place: bool=False, debounce: int=0,
               estimate: int=600, groups: dict[str, list[str]]={},
               priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
               rung: int=1) -> Controller:
    """A controller at the start of a run."""
    c = Controller()
    c.configure(windows, devs, target, maxc, must_place, debounce, estimate, groups, priority,
                separation)
    c.start(rung)
    return c


def open_window(n: int, target: int, maxc: int, debounce: int=0) -> Controller:
    """n devices d0, d1, ... of 600 s in a window that never closes."""
    return controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", n, 600, "w"), target, maxc,
                      debounce=debounce)


def _test_final_statuses():
    """Only the statuses that end an attempt are final."""
    cases = [
        ("succeeded", True),
        ("up-to-date", True),
        ("failed", True),
        ("rolled-back", True),
        ("in-progress", False),
        ("pending", False),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.is_final(case.0), case.1, case.0)
    testing.assertEqual(fleet_ctl.is_final(None), False, "no status")


def _test_first_step_starts_one_device():
    """The ramp starts at one device, and the next decision is one
    debounce after its upgrade is expected to end."""
    c = open_window(10, 4, 8, 5)
    s = c.decide(0)
    testing.assertEqual(s.started, ["d0"])
    testing.assertEqual(s.wake, 605)
    testing.assertEqual(s.finished, False)


def _test_ramp_doubles_as_devices_finish():
    """Each time the devices done reach the rung target, the rung doubles
    up to the concurrency."""
    c = open_window(10, 4, 8)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2"])
    testing.assertEqual((c.rung, c.rung_target), (2, 3))
    c.report("d1", "succeeded", 1200)
    c.report("d2", "failed", 1200)
    testing.assertEqual(c.decide(1200).started, ["d3", "d4", "d5", "d6"])
    testing.assertEqual((c.rung, c.rung_target), (4, 7))


def _test_done_at_its_report():
    """A device is done at the time of its final report, not at the
    decision that sees it, so the time it waited for the decision is not
    upgrade time. A later final report does not move the end."""
    c = open_window(2, 1, 1)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.report("d0", "succeeded", 650)
    c.decide(700)
    testing.assertEqual(c.done_at, {"d0": 600})
    testing.assertEqual(c.observed_s, 600)


def _test_final_report_from_before_the_release():
    """A device that reported a final status before it was released is
    done at the decision that sees it after the release."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    c.decide(10)
    c.decide(40)
    testing.assertEqual(c.done_at, {"d0": 40})
    testing.assertEqual(c.observed_s, (600 * 3 + 30) // 4)


def _test_lost_or_later_status_is_not_done():
    """A device whose report was lost, or whose later report is not
    final, is not done, and keeps its slot."""
    c = open_window(3, 1, 1)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.lost("d0")
    testing.assertEqual(c.decide(600).started, [])
    testing.assertEqual(c.done_at, {})
    c.report("d0", "succeeded", 1100)
    c.report("d0", "in-progress", 1150)
    c.decide(1200)
    testing.assertEqual(c.done_at, {})


def _test_waits_for_the_window_to_open():
    """Before its window opens nothing starts, and the next decision is at
    the opening."""
    c = controller([("w", 1000, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1)
    s = c.decide(0)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.wake, 1000)
    testing.assertEqual(c.decide(1000).started, ["d0"])


def _test_a_device_waits_for_a_window_it_fits():
    """Two 1000 s windows a day apart, one device at a time. d0 starts at
    the first opening. At 600 the 400 s left are too short for d1's 600 s
    and a fifth to spare, so it starts at the second opening, and waits in
    the first window no more. The controller decides again when the first
    window closes, and then at the second opening."""
    wins = daily("w", 0, 1000, 2)
    c = controller(wins, devices("d", 2, 600, "w"), 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.wake, 1000)
    testing.assertEqual(c.decide(1000).wake, DAY)
    testing.assertEqual(c.decide(DAY).started, ["d1"])
    testing.assertEqual(c.released_in, {"d0": wins[0], "d1": wins[1]})
    c.report("d1", "succeeded", DAY + 600)
    testing.assertEqual(c.decide(DAY + 600).finished, True)


def plan_is_run(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
                maxc: int, must_place: bool, estimate: int,
                groups: dict[str, list[str]]={}, priority: dict[str, int]={},
                separation: dict[str, (bool, int)]={}) -> None:
    """Run on the expected durations, the controller starts every device
    in the window and at the time its first plan said."""
    c = controller(windows, devs, target, maxc, must_place, 1, estimate, groups, priority,
                   separation)
    p = c.plan(0)
    sim.drive(c, 0, {}, 30 * DAY)
    testing.assertEqual(sim.started(c), sim.planned(c, p))


def _test_the_plan_is_the_run_uniform():
    """100 devices of 10 min in a 1 h window every day, 10 at once."""
    plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False, 600)


def _test_the_plan_is_the_run_mixed():
    """10 devices of 395 s and 100 of 4 s on one schedule, one at a time."""
    devs = devices("real", 10, 395, "night") + devices("sim", 100, 4, "night")
    plan_is_run(daily("night", 2 * HOUR, 1800, 9), devs, 1, 1, False, 40)


def _test_the_plan_is_the_run_two_schedules():
    """Two schedules of five 8 s devices each."""
    devs = devices("n", 5, 8, "night") + devices("w", 5, 8, "weekend")
    plan_is_run([("night", 0, HOUR), ("weekend", 2 * HOUR, 3 * HOUR)], devs, 8, 16, False, 8)


def _test_the_plan_is_the_run_deadline():
    """100 devices of 10 min with a deadline that raises the
    concurrency."""
    plan_is_run(daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50, True, 600)


def _test_uniform_fleet_fills_each_window_to_its_ramp():
    """100 devices of 10 min, a 1 h window every day, 10 at once. The
    first window ramps 1, 2, 4, 8, 10 and has no time for a sixth round:
    it takes 25. The ramp belongs to the campaign, so the next window
    runs five rounds of 10 and takes 50, and the third the last 25."""
    c = controller(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10,
                   debounce=1)
    sizes = [len(w.3) for w in c.layout(c.plan(0))]
    testing.assertEqual(sizes, [25, 50, 25])


def _test_deadline_raises_the_concurrency():
    """The same fleet with a deadline at the end of the second window. At
    14 at once the two windows take 29 and 70, one short; at 15 they take
    30 and 70."""
    c = controller(daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50,
                   True, 1)
    p = c.plan(0)
    testing.assertEqual(p.c, 15)
    testing.assertEqual([len(w.3) for w in c.layout(p)], [30, 70])
    testing.assertEqual(p.alarms, [])


def _test_device_without_a_window_keeps_the_concurrency():
    """A device whose schedule gives no window cannot start at any
    concurrency, so it does not raise the concurrency; it is the alarm."""
    devs = devices("d", 99, 600, "day") + [("x", 600, "never")]
    c = controller(daily("day", 0, HOUR, 3), devs, 10, 50, True, 1)
    p = c.plan(0)
    testing.assertEqual(p.c, 10)
    testing.assertEqual(p.alarms, ["1 device(s) cannot start before the deadline: x"])


def _test_a_device_that_misses_its_window_gets_a_later_one():
    """Three devices of 600 s are promised a 3000 s window at one at a
    time. d0 takes 2000 s, so the controller expects 950 s upgrades and
    the 1000 s left are too short for d1. When the window closes d1 and
    d2 are promised the next day's window, where they start, d2 when d1
    reports after its 600 s."""
    wins = daily("w", 0, 3000, 2)
    c = controller(wins, devices("d", 3, 600, "w"), 1, 1)
    p = c.plan(0)
    testing.assertEqual([len(w.3) for w in c.layout(p)], [3])
    sim.drive(c, 0, {"d0": 2000}, 2 * DAY)
    testing.assertEqual(sim.started(c), {"d0": (wins[0], 0), "d1": (wins[1], DAY),
                                         "d2": (wins[1], DAY + 600)})


def _test_promises_raise_the_concurrency_when_upgrades_run_slow():
    """50 devices of 600 s are promised a 1 h window at 10 at once, the ramp
    already at 10. The upgrades take 900 s, so after the first round 10 at
    once can no longer keep the promises, and the controller goes above
    10 to keep them."""
    c = Controller()
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 10, 20, False, 0, 600)
    c.start(10)
    c.plan(0)
    durations = {"d{i}": 900 for i in range(50)}
    sim.drive(c, 0, durations, HOUR)
    testing.assertEqual(len(c.released), 50)
    testing.assertTrue(c.c > 10, "the concurrency must rise above the target")


def _test_alarm_names_the_devices():
    """A window that one round fills cannot take 10 devices at max 1: the
    plan says which 9 do not fit."""
    c = controller([("w", 0, 1000)], devices("d", 10, 600, "w"), 1, 1, True)
    testing.assertEqual(c.plan(0).alarms,
                        ["9 device(s) cannot start before the deadline even at "
                         + "max-concurrency 1: d1, d2, d3, d4, d5 and 4 more"])


def _test_a_plan_is_a_fixed_point():
    """Windows [100, 500) and [1500, 1650), devices of 150, 150, 100 and
    150 s, one at a time and up to three, every device before the
    deadline. Run without promises, d2 takes the first window's last slot
    and d3 fits nowhere. The plan promises d2 the second window, after
    which two at once start every device. The plan runs again until its
    promises stop changing, so it gives that at once, and again when
    asked again."""
    devs = [("d0", 150, "w"), ("d1", 150, "w"), ("d2", 100, "w"), ("d3", 150, "w")]
    c = controller([("w", 100, 500), ("w", 1500, 1650)], devs, 1, 3, True)
    p = c.plan(0)
    testing.assertEqual((p.c, p.alarms), (2, []))
    q = c.plan(0)
    testing.assertEqual((q.c, q.starts), (p.c, p.starts))


def _test_a_late_upgrade_keeps_the_end_it_was_given():
    """d1 is expected to end at 201. At 202 its report could still count,
    so it is not late. At 227 it is: it is expected to take one more
    upgrade, to 327. A decision with nothing new keeps that end, so the
    plans before and after it agree."""
    c = controller([("w", 0, 500)], devices("d", 6, 100, "w"), 2, 4, debounce=1,
                   estimate=100)
    c.decide(0)
    c.report("d0", "succeeded", 100)
    c.decide(101)
    c.report("d2", "succeeded", 201)
    c.decide(202)
    testing.assertEqual(c.due["d1"], 201)
    p = c.decide(227).plan
    testing.assertEqual(c.due["d1"], 327)
    q = c.plan(260)
    testing.assertEqual((q.c, q.starts), (p.c, p.starts))


def _test_a_missed_promise_moves_to_an_open_window():
    """Windows [0, 300) and [100, open) of one schedule, one device at a
    time. The plan promises x the first window and b the second. a takes
    250 s, x no longer fits the first window, and when it closes x is
    promised the second, where it starts when b ends."""
    wins = [("s", 0, 300), ("s", 100, fleet_ctl.OPEN_END)]
    devs = [("a", 100, "s"), ("x", 100, "s"), ("b", 100, "s")]
    c = controller(wins, devs, 1, 1, estimate=100)
    p = c.plan(0)
    testing.assertEqual(sim.planned(c, p), {"a": (wins[0], 0), "x": (wins[0], 100),
                                            "b": (wins[1], 200)})
    sim.drive(c, 0, {"a": 250}, 1000)
    testing.assertEqual(sim.started(c), {"a": (wins[0], 0), "b": (wins[1], 250),
                                         "x": (wins[1], 350)})


def _test_a_device_that_fits_again_starts():
    """x of 800 s does not fit at 100 with 900 s left. b ends after 10 s,
    the observed pace falls, and x fits at 110."""
    devs = [("a", 100, "w"), ("b", 100, "w"), ("x", 800, "w")]
    c = controller([("w", 0, 1000)], devs, 2, 2, True, estimate=100)
    c.decide(0)
    c.report("a", "succeeded", 100)
    testing.assertEqual(c.decide(100).started, ["b"])
    c.report("b", "succeeded", 110)
    testing.assertEqual(c.decide(110).started, ["x"])


def _test_a_plan_keeps_the_window_a_promise_moves_to():
    """a runs late, so x misses the first window and its promise moves to
    the second, behind y. One at a time, y fills the second window and x
    moves on to the third; two at once start both in the second, so the
    plan runs at two as soon as a is late, and the run starts x in the
    second window."""
    wins = [("s", 0, 300), ("s", 1000, 1300), ("s", 2000, 2300)]
    devs = [("a", 100, "s"), ("y", 200, "s"), ("x", 100, "s")]
    c = controller(wins, devs, 1, 2, estimate=100)
    c.decide(0)
    p = c.decide(101).plan
    testing.assertEqual(p.c, 2)
    testing.assertEqual(sim.planned(c, p).get("x"), (wins[1], 1000))
    c.report("a", "succeeded", 201)
    sim.drive(c, 201, {}, 2000)
    testing.assertEqual(sim.started(c).get("x"), (wins[1], 1000))


def _test_a_pending_report_wakes_the_controller():
    """d0 reported up-to-date before its release, so it is done at the next
    decision, which the controller asks for a second later."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    s = c.decide(10)
    testing.assertEqual((s.started, s.wake), (["d0"], 11))
    testing.assertEqual(sim.planned(c, s.plan).get("d1"), (("w", 0, fleet_ctl.OPEN_END), 11))


def _test_reconfigure_keeps_the_order_of_a_moved_promise():
    """x is promised the first window ahead of y, and misses it. The
    campaign actor configures the controller again when the window has
    closed, without that window; x still goes first in the next one."""
    wins = [("s", 0, 25), ("s", 60, fleet_ctl.OPEN_END)]
    devs = [("a", 10, "s"), ("x", 10, "s"), ("y", 10, "s")]
    c = controller(wins, devs, 1, 1, estimate=10)
    sim.drive(c, 0, {"a": 20}, 24)
    c.configure(wins[1:], devs, 1, 1, False, 0, 10)
    p = c.plan(25)
    testing.assertEqual(sim.planned(c, p), {"x": (wins[1], 60), "y": (wins[1], 72)})


def _test_a_promise_ends_when_the_device_changes_schedule():
    """d1 is promised the window of schedule a. Bound to schedule b, it
    starts in b's window."""
    wins = [("a", 0, 3000), ("b", 4000, 5000)]
    c = controller(wins, [("d0", 600, "a"), ("d1", 600, "a")], 1, 1)
    c.decide(0)
    testing.assertEqual(c.promised.get("d1"), wins[0])
    c.configure(wins, [("d0", 600, "a"), ("d1", 600, "b")], 1, 1, False, 0, 600)
    p = c.plan(10)
    testing.assertEqual(sim.planned(c, p), {"d1": (wins[1], 4000)})


def _test_a_removed_device_does_not_count_for_the_ramp():
    """d0 and d1 are in flight at a ramp of two when d0 leaves the
    campaign. Its report does not count towards the ramp, so the run
    starts the rest where the plan said."""
    c = open_window(6, 4, 4)
    c.start(2)
    c.decide(0)
    c.configure([("w", 0, fleet_ctl.OPEN_END)], devices("d", 6, 600, "w")[1:], 4, 4,
                False, 0, 600)
    p = c.plan(10)
    sim.drive(c, 10, {}, DAY, [(600, "d0"), (600, "d1")])
    starts = sim.started(c)
    testing.assertEqual({k: starts[k] for k in sim.planned(c, p).keys()}, sim.planned(c, p))


def _test_a_removed_device_frees_its_slot():
    """One device at a time: d0 is in flight. Removed from the campaign,
    it holds no slot, and d1 starts."""
    c = open_window(2, 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.configure([("w", 0, fleet_ctl.OPEN_END)], [("d1", 600, "w")], 1, 1, False, 0, 600)
    testing.assertEqual(c.decide(10).started, ["d1"])


def _test_concurrency_counts_the_whole_campaign():
    """Two schedules whose windows overlap share the concurrency: at two
    at once, two devices start in all."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 2, 2)
    c.start(2)
    testing.assertEqual(c.decide(0).started, ["a0", "a1"])


def _test_new_limits_start_the_concurrency_over():
    """During a run the concurrency rises to keep promises. New limits
    start it over at the new target."""
    c = Controller()
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 10, 20, False, 0, 600)
    c.start(10)
    c.plan(0)
    sim.drive(c, 0, {"d{i}": 900 for i in range(50)}, 1000)
    testing.assertTrue(c.c > 10, "the concurrency must rise above the target")
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 5, 20, False, 0, 600)
    testing.assertEqual(c.c, 5)


def _test_finished_when_every_device_is_done():
    """The run is finished at the decision that sees the last device
    done."""
    c = open_window(2, 2, 2)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["d1"])
    testing.assertEqual(s.finished, False)
    c.report("d1", "succeeded", 1200)
    testing.assertEqual(c.decide(1200).finished, True)


def _test_start_begins_a_new_run():
    """start() forgets the released devices and the ramp, and the next
    decision starts from one device again."""
    c = open_window(4, 2, 2)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.decide(600)
    c.start()
    testing.assertEqual(c.released, set())
    testing.assertEqual((c.rung, c.rung_target), (1, 1))
    c.report("d0", "in-progress", 700)
    c.report("d1", "in-progress", 700)
    c.report("d2", "in-progress", 700)
    testing.assertEqual(c.decide(1200).started, ["d0"])


def _test_observed_at_the_campaign_scale():
    """A device estimated at 30 s that takes 60 s took twice its estimate:
    on a campaign estimate of 120 s it counts as 240 s."""
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", 2, 30, "w"), 1, 1,
                   estimate=120)
    c.decide(0)
    c.report("d0", "succeeded", 60)
    c.decide(60)
    testing.assertEqual(c.observed_s, (120 * 3 + 240) // 4)


def pairs(n: int) -> (dict[str, list[str]], dict[str, int]):
    """Redundancy groups of two of the devices d0, d1, ...: d0 and d1, d2
    and d3, and so on, the second of each pair first. Returns the groups
    and the priorities."""
    groups: dict[str, list[str]] = {}
    priority: dict[str, int] = {}
    for k in range(n // 2):
        groups["g{k}"] = ["d{2 * k}", "d{2 * k + 1}"]
        priority["d{2 * k}"] = 2
        priority["d{2 * k + 1}"] = 1
    return (groups, priority)


def _test_the_member_before_comes_by_priority_then_name():
    """Each member of a redundancy group waits for the member before it,
    by priority and then name, in each of its groups. A member that is
    not in the campaign orders nothing."""
    cases: list[(dict[str, list[str]], dict[str, int], dict[str, list[(str, str)]])] = [
        ({"g": ["a", "b"]}, {"a": 2, "b": 1}, {"a": [("b", "g")]}),
        ({"g": ["b", "a"]}, {"a": 1, "b": 1}, {"b": [("a", "g")]}),
        ({"g": ["a", "c", "b"]}, {"a": 1, "c": 2, "b": 3}, {"c": [("a", "g")], "b": [("c", "g")]}),
        ({"g": ["a", "x"]}, {"a": 1, "x": 0}, {}),
        ({"g1": ["a", "c"], "g2": ["b", "c"]}, {"a": 1, "b": 1, "c": 2},
         {"c": [("a", "g1"), ("b", "g2")]}),
    ]
    devs = [("a", 600, "w"), ("b", 600, "w"), ("c", 600, "w")]
    for case in cases:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups=case.0,
                       priority=case.1)
        testing.assertEqual(c.before, case.2, str(case.0))


def _test_members_start_one_at_a_time_by_priority():
    """r1 and r2 back each other up. r1 has the lower priority, so it
    goes first, though r2 comes first in the campaign. d0 is in no group
    and starts with r1. r2 starts when r1 is done, not when d0 is."""
    devs = [("r2", 600, "w"), ("r1", 600, "w"), ("d0", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4, groups={"g": ["r1", "r2"]},
                   priority={"r1": 10, "r2": 20}, rung=4)
    testing.assertEqual(c.decide(0).started, ["r1", "d0"])
    c.report("d0", "succeeded", 300)
    testing.assertEqual(c.decide(300).started, [])
    c.report("r1", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["r2"])


def _test_a_device_in_two_groups_waits_for_both():
    """x comes after a in one group and after b in another. a and b share
    no group, so they start together; x starts when both are done, and
    after the min-separation of each group has passed."""
    devs = [("x", 600, "w"), ("a", 600, "w"), ("b", 600, "w")]
    # (the separations, and the devices that start when b is done at 700
    # and the next decision; b took 700 s, so x is expected to take 625 s)
    cases: list[(dict[str, (bool, int)], (list[str], int))] = [
        ({}, (["x"], 1325)),
        ({"g1": (False, 600), "g2": (False, 0)}, ([], 1200)),
        ({"g1": (False, 0), "g2": (False, 600)}, ([], 1300)),
    ]
    for case in cases:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4,
                       groups={"g1": ["a", "x"], "g2": ["b", "x"]},
                       priority={"a": 1, "b": 1, "x": 2}, separation=case.0, rung=4)
        testing.assertEqual(c.decide(0).started, ["a", "b"])
        c.report("a", "succeeded", 600)
        testing.assertEqual(c.decide(600).started, [])
        c.report("b", "succeeded", 700)
        s = c.decide(700)
        testing.assertEqual((s.started, s.wake), case.1, str(case.0))


def _test_a_member_added_before_a_member_in_flight_waits_for_it():
    """b upgrades. An operator adds a to the campaign and to b's group,
    with a lower priority than b's. a starts only when b is done."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    c = controller(wins, [("b", 600, "w")], 2, 2, groups={"g": ["b"]}, priority={"b": 2},
                   rung=2)
    testing.assertEqual(c.decide(0).started, ["b"])
    c.configure(wins, [("a", 600, "w"), ("b", 600, "w")], 2, 2, False, 0, 600,
                {"g": ["a", "b"]}, {"a": 1, "b": 2})
    testing.assertEqual(c.decide(100).started, [])
    c.report("b", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["a"])


def _test_a_failed_member_holds_the_other_members():
    """r1 fails, so r2 and r3 wait for an operator. The plan that sees the
    failure says so, and keeps r2 and r3 in their window, also when the
    run stops. The devices it holds do not raise the concurrency, and d0,
    in no group, still starts."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("r3", 600, "w"), ("d0", 600, "w")]
    c = controller([("w", 0, DAY)], devs, 1, 10, True, groups={"g": ["r1", "r2", "r3"]},
                   priority={"r1": 1, "r2": 2, "r3": 3})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "failed", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["d0"])
    testing.assertEqual(s.plan.c, 1)
    testing.assertEqual(s.plan.alarms,
                        ["2 device(s) wait behind a failed redundancy group member: "
                         + "r2, r3"])
    testing.assertEqual([e.0 for e in c.layout(s.plan)[0].3], ["r1", "d0", "r2", "r3"])
    c.stop()
    testing.assertEqual([e.0 for e in c.layout(c.plan(700))[0].3], ["r1", "d0", "r2", "r3"])


def _test_a_failed_member_holds_the_members_after_the_held_ones():
    """r1 fails. r2 waits behind r1 in one group, and r3 waits behind r2 in
    another: the plan holds both."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("r3", 600, "w"), ("d0", 600, "w")]
    c = controller([("w", 0, DAY)], devs, 1, 10, True,
                   groups={"g1": ["r1", "r2"], "g2": ["r2", "r3"]},
                   priority={"r1": 1, "r2": 2, "r3": 3})
    c.decide(0)
    c.report("r1", "failed", 600)
    testing.assertEqual(c.decide(600).plan.alarms,
                        ["2 device(s) wait behind a failed redundancy group member: "
                         + "r2, r3"])


def _test_a_failure_that_has_not_counted_yet_holds_the_members():
    """a reports a failure after its upgrade was expected to end, and the
    failure counts one debounce later. A plan before then holds b already,
    in the first window, and gives d, in no group, the room left there."""
    wins = [("w", 0, 1400), ("w", DAY, DAY + 1400)]
    devs = [("a", 600, "w"), ("b", 600, "w"), ("d", 600, "w")]
    c = controller(wins, devs, 1, 1, debounce=5, groups={"g": ["a", "b"]},
                   priority={"a": 1, "b": 2})
    c.resume("a", 0, wins[0])
    c.report("a", "failed", 600)
    p = c.decide(601).plan
    testing.assertEqual(p.alarms,
                        ["1 device(s) wait behind a failed redundancy group member: b"])
    testing.assertEqual(p.starts, {"d": (0, 605)})
    testing.assertEqual(p.held, {"b": (0, 601)})


def _test_a_failed_member_holds_a_member_added_before_it():
    """b fails. An operator adds a to the campaign and to b's group, with a
    lower priority than b's. a waits too, in the window of its schedule."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    c = controller(wins, [("b", 600, "w")], 1, 1, groups={"g": ["b"]}, priority={"b": 2})
    testing.assertEqual(c.decide(0).started, ["b"])
    c.report("b", "failed", 600)
    c.decide(600)
    c.configure(wins, [("a", 600, "w"), ("b", 600, "w")], 1, 1, False, 0, 600,
                {"g": ["a", "b"]}, {"a": 1, "b": 2})
    s = c.decide(700)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.plan.alarms,
                        ["1 device(s) wait behind a failed redundancy group member: a"])
    testing.assertEqual([e.0 for e in c.layout(s.plan)[0].3], ["b", "a"])


def _test_a_held_member_keeps_the_later_window_promised_to_it():
    """r1 starts, and d fills the rest of the first window, so r2, of
    15 min, is promised the second. r1 fails: r2 keeps the second window,
    though the first is still open."""
    wins = [("w", 0, 1400), ("w", DAY, DAY + 1400)]
    devs = [("r1", 600, "w"), ("d", 600, "w"), ("r2", 900, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2})
    testing.assertEqual(c.decide(0).plan.starts["r2"], (1, DAY))
    c.report("r1", "failed", 600)
    p = c.decide(600).plan
    testing.assertEqual(p.held, {"r2": (1, DAY)})
    testing.assertEqual([(w.1, [e.0 for e in w.3]) for w in c.layout(p)],
                        [(0, ["r1", "d"]), (DAY, ["r2"])])


def _test_a_held_member_without_a_promise_leaves_its_window_to_others():
    """r1 is down when the run starts, so r1 and r2 wait. The plan shows
    them in the first window but does not promise it to them, and fills it
    with d0 to d9. r1 comes back up before the window opens: the devices
    promised the first window keep it, and r1 and r2 go where there is
    room."""
    wins = daily("day", HOUR, HOUR, 5)
    devs = [("r1", 600, "day"), ("r2", 600, "day")] + devices("d", 12, 600, "day")
    c = controller(wins, devs, 2, 2, groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2},
                   rung=2)
    c.set_live("r1", False)
    p = c.decide(0).plan
    testing.assertEqual(p.held, {"r1": (0, HOUR), "r2": (0, HOUR)})
    testing.assertEqual(sorted([n for n, s in p.starts.items() if s.0 == 0]),
                        ["d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8", "d9"])
    c.set_live("r1", True)
    p = c.decide(1800).plan
    testing.assertEqual(p.alarms, [])
    testing.assertEqual((p.starts["r1"].0, p.starts["r2"].0), (1, 1))


def _test_a_member_looked_at_again_keeps_its_place_in_the_promises():
    """d1, of 25 min, is promised the first window before h. f fails, so h
    waits, and when f reports a success, h is looked at again. d1 still
    starts first, and h after it, so both keep the window."""
    wins = [("w", 0, 3500), ("w", DAY, DAY + 3500)]
    devs = [("f", 600, "w"), ("d0", 600, "w"), ("d1", 1500, "w"), ("h", 600, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["f", "h"]}, priority={"f": 1, "h": 2})
    c.decide(0)
    c.report("f", "failed", 600)
    c.decide(600)
    c.report("f", "succeeded", 700)
    c.decide(700)
    c.report("d0", "succeeded", 1200)
    s = c.decide(1200)
    testing.assertEqual(s.started, ["d1"])
    testing.assertEqual(s.plan.starts.get("h"), (0, 2700))
    testing.assertEqual(s.plan.alarms, [])


def _test_members_looked_at_again_start_in_the_order_of_their_promises():
    """f1 and f2 fail, so h1 and h2 wait, and d1 and d2 take both slots.
    f2 reports a success, then f1, so h2 is looked at again before h1.
    h1 was promised the window before h2, so h1 starts in the first free
    slot, and h2 in the next one: both keep the window."""
    wins = [("w", 0, 7200)]
    devs = [("f1", 600, "w"), ("f2", 600, "w"), ("h1", 600, "w"), ("h2", 600, "w"),
            ("d1", 1200, "w"), ("d2", 1800, "w")]
    c = controller(wins, devs, 2, 2, groups={"g1": ["f1", "h1"], "g2": ["f2", "h2"]},
                   priority={"f1": 1, "h1": 2, "f2": 1, "h2": 2}, rung=2)
    testing.assertEqual(c.decide(0).started, ["f1", "f2"])
    c.report("f1", "failed", 600)
    c.report("f2", "failed", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2"])
    c.report("f2", "succeeded", 700)
    c.decide(700)
    c.report("f1", "succeeded", 800)
    testing.assertEqual(c.decide(800).plan.alarms, [])
    c.report("d1", "succeeded", 1800)
    s = c.decide(1800)
    testing.assertEqual(s.started, ["h1"])
    testing.assertEqual(s.plan.starts, {"h1": (0, 1800), "h2": (0, 2400)})


def _test_a_member_looked_at_again_starts_before_later_promises():
    """h is promised the window before d. f fails, so h waits, and x takes
    the slot. f reports a success, so h is looked at again. When x is
    done, h starts before d."""
    wins = [("w", 0, fleet_ctl.OPEN_END)]
    devs = [("f", 600, "w"), ("h", 600, "w"), ("x", 600, "w"), ("d", 600, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["f", "h"]}, priority={"f": 1, "h": 2})
    testing.assertEqual(c.decide(0).plan.starts,
                        {"f": (0, 0), "h": (0, 600), "x": (0, 1200), "d": (0, 1800)})
    c.report("f", "failed", 600)
    testing.assertEqual(c.decide(600).started, ["x"])
    c.report("f", "succeeded", 700)
    c.decide(700)
    c.report("x", "succeeded", 1200)
    s = c.decide(1200)
    testing.assertEqual(s.started, ["h"])
    testing.assertEqual(s.plan.starts, {"h": (0, 1200), "d": (0, 1800)})


def _test_the_promises_follow_the_order_of_the_starts():
    """b waits for a, and y and z each wait 5 min after the member before
    them. One at a time, the run starts x, a, y, b and z: y's
    min-separation passes before a is done, so y starts before b. The
    promises go in that order, so the run ahead with them is the same,
    and z still fits."""
    wins = [("w", 0, 3200)]
    devs = [("b", 600, "w"), ("y", 600, "w"), ("z", 600, "w"), ("x", 600, "w"),
            ("a", 600, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["a", "b"], "h": ["x", "y", "z"]},
                   priority={"a": 1, "b": 2, "x": 1, "y": 2, "z": 3},
                   separation={"h": (False, 300)})
    p = c.plan(0)
    testing.assertEqual(p.starts, {"x": (0, 0), "a": (0, 600), "y": (0, 1200),
                                   "b": (0, 1800), "z": (0, 2400)})
    testing.assertEqual(p.alarms, [])


def _test_an_operator_frees_the_members_of_a_failed_one():
    """r1 rolls back and r2 waits. When the operator takes r1 out of the
    group, or out of the campaign, r2 starts."""
    wins = [("w", 0, DAY)]
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    priority = {"r1": 1, "r2": 2}
    # (what the operator does, devices, groups)
    cases: list[(str, list[(str, int, str)], dict[str, list[str]])] = [
        ("out of the group", devs, {"g": ["r2"]}),
        ("out of the campaign", [("r2", 600, "w")], {"g": ["r2"]}),
    ]
    for case in cases:
        c = controller(wins, devs, 1, 1, groups={"g": ["r1", "r2"]}, priority=priority)
        testing.assertEqual(c.decide(0).started, ["r1"], case.0)
        c.report("r1", "rolled-back", 600)
        testing.assertEqual(c.decide(600).started, [], case.0)
        c.configure(wins, case.1, 1, 1, False, 0, 600, case.2, priority)
        testing.assertEqual(c.decide(700).started, ["r2"], case.0)


def _test_a_later_success_frees_the_rest():
    """r1 fails and r2 waits. An operator fixes r1, and when r1 reports a
    success, whether or not it reported another status first, r2
    starts."""
    # (the reports of r1 after its failure, at 700 and 1300)
    cases: list[list[(int, str)]] = [
        [(700, "in-progress"), (1300, "succeeded")],
        [(1300, "up-to-date")],
        [(1300, "succeeded")],
    ]
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    for case in cases:
        c = controller([("w", 0, DAY)], devs, 1, 1, groups={"g": ["r1", "r2"]},
                       priority={"r1": 1, "r2": 2})
        testing.assertEqual(c.decide(0).started, ["r1"])
        c.report("r1", "failed", 600)
        testing.assertEqual(c.decide(600).started, [])
        started: list[str] = []
        for r in case:
            c.report("r1", r.1, r.0)
            started = c.decide(r.0).started
        testing.assertEqual(started, ["r2"], str(case))


def _test_a_retried_member_keeps_its_min_separation_from_its_success():
    """r1 fails, and reports a success after a retry. r2 starts no sooner
    than the min-separation of 30 min after that success."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2}, separation={"g": (False, 1800)})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "failed", 600)
    c.decide(600)
    c.report("r1", "succeeded", 5000)
    s = c.decide(5000)
    testing.assertEqual((s.started, s.wake), ([], 6800))
    testing.assertEqual(c.decide(6800).started, ["r2"])


def _test_a_member_held_past_its_window_starts_when_freed():
    """r comes after q in one group and after z in another. z ends late,
    when the window r was promised has no room left for it, and the
    window that never closes passes r over for its promise. Then q fails,
    so r waits while its window closes, and its promise moves to the
    window that never closes. When q reports a success after a retry, r
    starts there."""
    wins = [("s", 0, 230), ("s", 0, fleet_ctl.OPEN_END)]
    devs = [("q", 100, "s"), ("z", 100, "s"), ("r", 100, "s")]
    c = controller(wins, devs, 2, 2, estimate=100, groups={"g1": ["q", "r"], "g2": ["z", "r"]},
                   priority={"q": 1, "z": 1, "r": 2}, rung=2)
    testing.assertEqual(c.decide(0).started, ["q", "z"])
    c.decide(100)
    c.decide(101)
    c.report("z", "succeeded", 120)
    c.decide(120)
    c.report("q", "failed", 130)
    c.decide(130)
    c.report("q", "in-progress", 200)
    c.decide(200)
    c.report("q", "succeeded", 300)
    testing.assertEqual(c.decide(300).started, ["r"])


def _test_a_success_within_the_debounce_frees_the_rest():
    """r1 fails, and reports up-to-date before its failure counts. The
    success counts, so r2 starts."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, DAY)], devs, 1, 1, debounce=5, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "failed", 600)
    c.report("r1", "up-to-date", 603)
    testing.assertEqual(c.decide(605).started, ["r2"])


def _test_members_wait_while_a_member_is_down():
    """z backs up r1 and r2 but is not in the campaign. While z, or r1
    itself, is down, neither r1 nor r2 starts, and the plan says so; d0,
    in no group, starts. When the device comes back up, r1 starts."""
    devs = [("r1", 600, "w"), ("r2", 600, "w"), ("d0", 600, "w")]
    for down in ["z", "r1"]:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4,
                       groups={"g": ["r1", "r2", "z"]}, priority={"r1": 1, "r2": 2, "z": 3},
                       rung=4)
        c.set_live(down, False)
        s = c.decide(0)
        testing.assertEqual(s.started, ["d0"], down)
        testing.assertEqual(s.plan.alarms,
                            ["2 device(s) wait while a redundancy group member is down: "
                             + "r1, r2"], down)
        testing.assertEqual(s.plan.starts, {"d0": (0, 0)}, down)
        c.set_live(down, True)
        s = c.decide(10)
        testing.assertEqual(s.started, ["r1"], down)
        testing.assertEqual(s.plan.alarms, [], down)


def _test_a_member_that_reports_while_down_holds_the_others():
    """a goes down while it upgrades, and reports a success while it is
    still down. b waits until a is back up."""
    devs = [("a", 600, "w"), ("b", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups={"g": ["a", "b"]},
                   priority={"a": 1, "b": 2})
    testing.assertEqual(c.decide(0).started, ["a"])
    c.set_live("a", False)
    c.report("a", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.plan.alarms,
                        ["1 device(s) wait while a redundancy group member is down: b"])
    c.set_live("a", True)
    testing.assertEqual(c.decide(700).started, ["b"])


def _test_a_member_down_while_it_upgrades_keeps_the_plan():
    """a goes down while it upgrades, as a device does when it reboots.
    The plan expects it back up when its upgrade ends, so b keeps its
    place right after a, in the first window."""
    wins = [("w", 0, 1320), ("w", 5000, 8000)]
    devs = [("a", 600, "w"), ("b", 600, "w"), ("d", 100, "w")]
    c = controller(wins, devs, 1, 1, groups={"g": ["a", "b"]}, priority={"a": 1, "b": 2})
    testing.assertEqual(c.decide(0).started, ["a"])
    c.set_live("a", False)
    s = c.decide(10)
    testing.assertEqual(s.plan.alarms, [])
    testing.assertEqual(s.plan.starts["b"], (0, 600))
    c.set_live("a", True)
    c.report("a", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["b"])


def _test_a_pack_group_keeps_its_min_separation():
    """r2 starts no sooner than the min-separation of 300 s after r1 is
    done, and the controller decides again then."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 1, 1, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2}, separation={"g": (False, 300)})
    testing.assertEqual(c.decide(0).started, ["r1"])
    c.report("r1", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual((s.started, s.wake), ([], 900))
    testing.assertEqual(c.decide(900).started, ["r2"])


def _test_a_min_separation_past_the_deadline_alarms():
    """A min-separation of 1 h puts r2 after the window that the deadline
    ends: the plan says r2 cannot start before the deadline."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")]
    c = controller([("w", 0, HOUR)], devs, 1, 4, True, groups={"g": ["r1", "r2"]},
                   priority={"r1": 1, "r2": 2}, separation={"g": (False, HOUR)})
    testing.assertEqual(c.plan(0).alarms,
                        ["1 device(s) cannot start before the deadline: r2"])


def _test_a_spread_pair_goes_in_the_first_and_the_last_window():
    """r1 and r2, then 98 devices in no group, all of 10 min, in a 1 h
    window every day, 10 at once. The run uses the first three windows.
    Packed, r2 goes right after r1, in the first window. Spread, r2 goes
    in the third window, and a device of the same estimate takes its
    place in the first. The windows take the same number of devices
    either way."""
    devs = [("r1", 600, "day"), ("r2", 600, "day")] + devices("d", 98, 600, "day")
    # (spread, the window of r1 and of r2)
    cases: list[(bool, (int, int))] = [(False, (0, 0)), (True, (0, 2))]
    for case in cases:
        c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                       groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2},
                       separation={"g": (case.0, 0)})
        p = c.plan(0)
        testing.assertEqual((p.starts["r1"].0, p.starts["r2"].0), case.1, str(case.0))
        testing.assertEqual([len(w.3) for w in c.layout(p)], [25, 50, 25])
        testing.assertEqual(p.alarms, [])
        sim.drive(c, 0, {}, 30 * DAY)
        testing.assertEqual(sim.started(c), sim.planned(c, p))


def _test_a_spread_pair_in_one_window_goes_one_after_the_other():
    """In a window that never closes, 4 at once, r2 starts when r1 is
    done, whether the group spreads or packs. Without the group it would
    start with r1."""
    devs = [("r1", 600, "w"), ("r2", 600, "w")] + devices("d", 10, 600, "w")
    for spread in [True, False]:
        c = controller([("w", 0, fleet_ctl.OPEN_END)], devs, 4, 4, groups={"g": ["r1", "r2"]},
                       priority={"r1": 1, "r2": 2}, separation={"g": (spread, 0)}, rung=4)
        testing.assertEqual(c.plan(0).starts["r2"], (0, 600), str(spread))


def _test_a_spread_member_trades_only_with_a_device_of_its_estimate():
    """r1 and r2 spread, then 98 devices of 10 min in no group, a 1 h
    window every day, 10 at once. Members of 10 min trade, so r2 goes in
    the third window. Members of 5 min have no device of their estimate to
    trade with, so r2 stays in the first."""
    # (the estimate of r1 and r2, and the window of r2)
    cases: list[(int, int)] = [(600, 2), (300, 0)]
    for case in cases:
        devs = [("r1", case.0, "day"), ("r2", case.0, "day")] + devices("d", 98, 600, "day")
        c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                       groups={"g": ["r1", "r2"]}, priority={"r1": 1, "r2": 2},
                       separation={"g": (True, 0)})
        testing.assertEqual(c.plan(0).starts["r2"].0, case.1, str(case.0))


def _test_a_spread_member_keeps_an_earlier_promise():
    """r1, r2 and 10 devices fit the first window, so r2 is promised it.
    Then 90 more devices make the run use three windows; r2 keeps the
    first."""
    devs = [("r1", 600, "day"), ("r2", 600, "day")] + devices("d", 10, 600, "day")
    groups = {"g": ["r1", "r2"]}
    priority = {"r1": 1, "r2": 2}
    separation = {"g": (True, 0)}
    c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1, groups=groups,
                   priority=priority, separation=separation)
    testing.assertEqual(c.plan(0).starts["r2"].0, 0)
    c.configure(daily("day", 0, HOUR, 9), devs + devices("e", 90, 600, "day"), 10, 10, False, 1,
                600, groups, priority, separation)
    testing.assertEqual(c.plan(0).starts["r2"].0, 0)


def _test_a_spread_group_that_cannot_keep_its_order_packs_alone():
    """r1, r2 and r3 spread, but r3 takes 5 min and no device in no group
    has that estimate, so r3 cannot move. r2 would then go after r3, so
    the group packs. s1 and s2 spread all the same."""
    devs = [("r1", 600, "day"), ("r2", 600, "day"), ("r3", 300, "day"), ("s1", 600, "day"),
            ("s2", 600, "day")] + devices("d", 95, 600, "day")
    c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                   groups={"g": ["r1", "r2", "r3"], "h": ["s1", "s2"]},
                   priority={"r1": 1, "r2": 2, "r3": 3, "s1": 1, "s2": 2},
                   separation={"g": (True, 0), "h": (True, 0)})
    p = c.plan(0)
    testing.assertEqual([p.starts[n].0 for n in ["r1", "r2", "r3", "s1", "s2"]], [0, 0, 0, 0, 2])


def _test_a_spread_member_trades_only_with_a_device_in_no_group():
    """r1 and r2 spread. p2 comes after p1 in a pack group, and the run
    puts it in the second window, where it is the only device of 10 min.
    r2 does not trade with it, so it stays in the first window."""
    devs = [("r1", 600, "day"), ("r2", 600, "day"), ("p1", 600, "day")] \
           + devices("d", 60, 300, "day") + [("p2", 600, "day")]
    c = controller(daily("day", 0, HOUR, 9), devs, 10, 10, debounce=1,
                   groups={"g": ["r1", "r2"], "h": ["p1", "p2"]},
                   priority={"r1": 1, "r2": 2, "p1": 1, "p2": 2},
                   separation={"g": (True, 0)})
    p = c.plan(0)
    testing.assertEqual((p.starts["r2"].0, p.starts["p2"].0), (0, 1))
    testing.assertEqual(p.alarms, [])


def _test_a_spread_member_goes_after_the_window_of_the_member_before_it():
    """A 20 h window every day, and devices of 2 h, one at a time: the run
    uses three windows. A member moves only to a window that opens at
    least the min-separation of each of its groups after the window of
    the member before it in that group closes, and that closes at least
    that long before the window of the member after it opens. The second
    window opens 4 h after the first closes, less than the 6 h
    min-separation of g in the first row: r2 stays and r3 goes in the
    third window. With a min-separation of 4 h in the second row, r2 goes
    in the second window. m cannot move, because of q before it or y
    after it in h, so g packs."""
    wins = daily("day", 0, 20 * HOUR, 9)
    sep = 6 * HOUR
    # (the devices before and after 20 devices in no group, the groups,
    # priorities and separations, and the windows of the named devices)
    cases: list[(list[str], list[str], dict[str, list[str]], dict[str, int],
                 dict[str, (bool, int)], dict[str, int])] = [
        (["r1", "r2", "r3"], [], {"g": ["r1", "r2", "r3"]}, {"r1": 1, "r2": 2, "r3": 3},
         {"g": (True, sep)}, {"r2": 0, "r3": 2}),
        (["r1", "r2", "r3"], [], {"g": ["r1", "r2", "r3"]}, {"r1": 1, "r2": 2, "r3": 3},
         {"g": (True, 4 * HOUR)}, {"r2": 1, "r3": 2}),
        (["a", "q", "m", "z"], [], {"g": ["a", "m", "z"], "h": ["q", "m"]},
         {"a": 1, "q": 1, "m": 2, "z": 3}, {"g": (True, 0), "h": (False, sep)},
         {"m": 0, "z": 0}),
        (["a", "m", "z"], ["y"], {"g": ["a", "m", "z"], "h": ["m", "y"]},
         {"a": 1, "m": 2, "z": 3, "y": 4}, {"g": (True, 0), "h": (False, sep)},
         {"m": 0, "z": 0, "y": 2}),
    ]
    for case in cases:
        devs = [(n, 2 * HOUR, "day") for n in case.0] + devices("d", 20, 2 * HOUR, "day") \
               + [(n, 2 * HOUR, "day") for n in case.1]
        c = controller(wins, devs, 1, 1, debounce=1, groups=case.2, priority=case.3,
                       separation=case.4)
        p = c.plan(0)
        testing.assertEqual({n: p.starts[n].0 for n in case.5.keys()}, case.5, str(case.2))
        testing.assertEqual(p.alarms, [], str(case.2))


def _test_a_spread_partner_takes_the_place_of_the_member_in_the_promises():
    """a and m spread, two at once, and D takes 15 min. Without spreading,
    a and D start first, m when a is done, and P, in no group, in the
    second window. m trades windows with P, and P takes m's place after D
    in the order of the promises: P starts when a is done, D still fits,
    and m goes in the second window."""
    wins = [("w", 0, 1400), ("w", DAY, DAY + 1400)]
    devs = [("a", 600, "w"), ("m", 600, "w"), ("D", 900, "w"), ("P", 600, "w")]
    c = controller(wins, devs, 2, 2, groups={"g": ["a", "m"]}, priority={"a": 1, "m": 2},
                   separation={"g": (True, 0)}, rung=2)
    p = c.plan(0)
    testing.assertEqual(p.starts, {"a": (0, 0), "D": (0, 0), "P": (0, 600), "m": (1, DAY)})
    testing.assertEqual(p.alarms, [])


def _test_a_spread_partner_keeps_the_place_of_the_member_in_a_new_configuration():
    """m trades windows with P, and P takes m's place before Q in the order
    of the promises. A new max-concurrency keeps that order: P starts when
    a is done, and Q when D is done."""
    wins = [("w", 0, 1800), ("w", DAY, DAY + 1800)]
    devs = [("a", 600, "w"), ("m", 600, "w"), ("D", 900, "w"), ("Q", 600, "w"), ("P", 600, "w")]
    groups = {"g": ["a", "m"]}
    priority = {"a": 1, "m": 2}
    separation = {"g": (True, 0)}
    c = controller(wins, devs, 2, 2, groups=groups, priority=priority, separation=separation,
                   rung=2)
    testing.assertEqual(c.decide(0).plan.starts,
                        {"a": (0, 0), "D": (0, 0), "P": (0, 600), "Q": (0, 900), "m": (1, DAY)})
    c.configure(wins, devs, 2, 3, False, 0, 600, groups, priority, separation)
    c.report("a", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["P"])
    testing.assertEqual(s.plan.starts, {"P": (0, 600), "Q": (0, 900), "m": (1, DAY)})


def _test_a_spread_swap_that_breaks_a_promise_is_undone():
    """r2 and s2 report that they are up to date before they start, so
    each one is done as soon as it starts. Moved to the second window,
    each would give its place in the first window to a device of 10 min,
    and devices promised the first window would miss it. The plan keeps
    r2 and s2 in the first window."""
    devs = [("r1", 600, "day"), ("r2", 600, "day"), ("s1", 600, "day"), ("s2", 600, "day")] \
           + devices("d", 9, 600, "day")
    c = controller(daily("day", 0, HOUR, 3), devs, 1, 1,
                   groups={"g": ["r1", "r2"], "h": ["s1", "s2"]},
                   priority={"r1": 1, "r2": 2, "s1": 1, "s2": 2},
                   separation={"g": (True, 0), "h": (True, 0)})
    c.report("r2", "up-to-date", 0)
    c.report("s2", "up-to-date", 0)
    p = c.plan(0)
    testing.assertEqual(p.alarms, [])
    testing.assertEqual((p.starts["r2"].0, p.starts["s2"].0), (0, 0))


def _test_a_spread_member_needs_a_device_in_no_group_to_swap_with():
    """40 devices in spread pairs and nothing else: the plan is the packed
    one."""
    groups, priority = pairs(40)
    separation = {g: (True, 0) for g in groups.keys()}
    spread = controller(daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10,
                        debounce=1, groups=groups, priority=priority, separation=separation)
    packed = controller(daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10,
                        debounce=1, groups=groups, priority=priority)
    testing.assertEqual(spread.plan(0).starts, packed.plan(0).starts)


def _test_the_plan_is_the_run_pairs():
    """40 devices of 10 min in pairs, the second of each pair first, in a
    1 h window every day, 10 at once."""
    groups, priority = pairs(40)
    plan_is_run(daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10, False, 600,
                groups, priority)


def _test_the_plan_is_the_run_spread_pairs():
    """The same 20 pairs, spread with a min-separation of 10 min, and 60
    devices in no group."""
    groups, priority = pairs(40)
    separation = {g: (True, 600) for g in groups.keys()}
    devs = devices("d", 40, 600, "day") + devices("e", 60, 600, "day")
    plan_is_run(daily("day", 0, HOUR, 9), devs, 10, 10, False, 600, groups, priority, separation)


def _test_the_plan_is_the_run_chains():
    """20 devices of 10 min with a deadline: d0 to d3 in a chain of two
    groups, spread, and d4 and d5 in a pair, d5 first."""
    groups = {"a": ["d0", "d1", "d2"], "b": ["d2", "d3"], "c": ["d5", "d4"]}
    priority = {"d0": 1, "d1": 2, "d2": 3, "d3": 4, "d5": 1, "d4": 2}
    separation = {"a": (True, 0), "b": (True, 0)}
    plan_is_run(daily("day", 0, HOUR, 2), devices("d", 20, 600, "day"), 4, 8, True, 600,
                groups, priority, separation)
