def _test_the_plan_in_a_pause_is_the_run_that_carries_on_in_groups():
    """plan_in_a_pause() for two schedules, deadline, pairs, spread pairs
    and chains."""
    plan_in_a_pause(5, 10)


class Fixture(object):
    """A campaign for the pause checks: its windows, devices, target and
    max concurrency, whether every device must start in a window, the
    estimate, the redundancy groups, priorities and separations, the close
    margin, the stagger, the devices that answer later, as (time, name),
    and the time each device's upgrade takes when it is not its
    estimate."""
    windows: list[(str, int, int)]
    devs: list[(str, int, str)]
    target: int
    maxc: int
    must_place: bool
    estimate: int
    groups: dict[str, list[str]]
    priority: dict[str, int]
    separation: dict[str, (bool, int)]
    close_margin: int
    stagger: int
    answers: list[(int, str)]
    durations: dict[str, int]

    def __init__(self, windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
                 maxc: int, must_place: bool=False, estimate: int=600,
                 groups: dict[str, list[str]]={}, priority: dict[str, int]={},
                 separation: dict[str, (bool, int)]={},
                 close_margin: int=fleet_ctl.CLOSE_MARGIN, stagger: int=0,
                 answers: list[(int, str)]=[], durations: dict[str, int]={}):
        self.windows = windows
        self.devs = devs
        self.target = target
        self.maxc = maxc
        self.must_place = must_place
        self.estimate = estimate
        self.groups = groups
        self.priority = priority
        self.separation = separation
        self.close_margin = close_margin
        self.stagger = stagger
        self.answers = answers
        self.durations = durations

    def make(self) -> Controller:
        """The campaign at the start of its run, with prepare on, a debounce
        of 1 s, and the devices that answer later not answered."""
        c = controller(self.windows, self.devs, self.target, self.maxc, self.must_place, 1,
                       self.estimate, self.groups, self.priority, self.separation,
                       close_margin=self.close_margin, stagger=self.stagger, prepare=True)
        for a in self.answers:
            c.lost(a.1)
        return c


def pause_fixture(name: str) -> Fixture:
    """The campaigns of the plan-is-the-run tests, smaller, and the
    campaign with late answers and PAUSED without its group. In the
    uniform campaign and the one with late answers the upgrades take 85
    to 115 percent of the estimate."""
    groups, priority = pairs(12)
    spread_groups, spread_priority = pairs(8)
    spread = {g: (True, 600) for g in spread_groups.keys()}
    chain_groups, chain_priority, chain_separation = chains()
    days = daily("day", 0, HOUR, 4)
    scatter = {"d{i}": 600 * (85 + (i * 7) % 31) // 100 for i in range(20)}
    if name == "uniform":
        return Fixture(days, devices("d", 20, 600, "day"), 2, 4, durations=scatter)
    elif name == "close margin 200":
        return Fixture(days, devices("d", 20, 600, "day"), 2, 4, close_margin=200)
    elif name == "stagger":
        return Fixture(days, devices("d", 20, 600, "day"), 2, 4, stagger=100)
    elif name == "overlapping":
        return Fixture(overlapping(4), devices("eu", 8, 600, "eu") + devices("uk", 4, 600, "uk")
                       + devices("us", 3, 600, "us"), 2, 4)
    elif name == "mixed":
        return Fixture(daily("night", 2 * HOUR, 1800, 4),
                       devices("real", 5, 395, "night") + devices("sim", 10, 4, "night"), 1, 1,
                       estimate=40)
    elif name == "two schedules":
        return Fixture([("night", 0, HOUR), ("weekend", 2 * HOUR, 3 * HOUR)],
                       devices("n", 5, 8, "night") + devices("w", 5, 8, "weekend"), 8, 16,
                       estimate=8)
    elif name == "deadline":
        return Fixture(daily("day", 0, HOUR, 2), devices("d", 30, 600, "day"), 2, 8, True)
    elif name == "pairs":
        return Fixture(days, devices("d", 12, 600, "day"), 2, 4, groups=groups,
                       priority=priority)
    elif name == "spread pairs":
        return Fixture(days, devices("d", 8, 600, "day") + devices("e", 8, 600, "day"), 2, 4,
                       groups=spread_groups, priority=spread_priority, separation=spread)
    elif name == "chains":
        return Fixture(days, devices("d", 12, 600, "day"), 2, 4, groups=chain_groups,
                       priority=chain_priority, separation=chain_separation)
    elif name == "late answers":
        return Fixture(days, devices("d", 20, 600, "day"), 2, 4, answers=late_answers(),
                       durations=scatter)
    return Fixture(daily("w", 6 * HOUR, HOUR, 3), devices("d", 10, 600, "w"), 2, 4)


def pause_points(f: Fixture) -> list[int]:
    """The times to pause the campaign f at, from the decisions of its run
    with no pause (same_as_a_new_plan): just after the first decision; in
    the middle of the first window, or as near it as a device is in flight
    in that window; the last second of the window that closes first; and
    the middle of the first time between windows. Each comes before the
    run ends: a run that ends in a window has no point after it."""
    decided: list[(int, list[str])] = []
    same_as_a_new_plan(f.make(), f.durations, 10 * DAY, answers=f.answers, in_progress=True,
                       prepare=True, decided=decided)
    ends = decided[-1].0
    est = {d.0: d.1 for d in f.devs}
    points = [decided[0].0 + 1]
    first = sorted([(w.1, w.2) for w in f.windows])[0]
    mid = first.0 + (first.1 - first.0) // 2
    # The time nearest mid in the first window with a device in flight.
    near = -1
    for d in decided:
        for name in d.1:
            lo = fleet_ctl.imax(d.0 + 1, first.0)
            hi = fleet_ctl.imin(d.0 + f.durations.get_def(name, est[name]) - 1, first.1 - 1)
            if lo <= hi:
                at = fleet_ctl.imin(fleet_ctl.imax(mid, lo), hi)
                if near < 0 or abs(at - mid) < abs(near - mid):
                    near = at
    testing.assertTrue(near >= 0, "no device in flight in the first window")
    points.append(near)
    closes = min([w.2 for w in f.windows])
    if closes - 1 < ends:
        points.append(closes - 1)
    # The windows merged where they overlap or touch, by start.
    spans: list[(int, int)] = []
    for w in sorted([(w.1, w.2) for w in f.windows]):
        if len(spans) > 0 and w.0 <= spans[-1].1:
            spans[-1] = (spans[-1].0, fleet_ctl.imax(spans[-1].1, w.1))
        else:
            spans.append(w)
    if len(spans) > 1:
        between = spans[0].1 + (spans[1].0 - spans[0].1) // 2
        if between < ends:
            points.append(between)
    return points


def pauses_carry_the_run_on(name: str, event: str) -> None:
    """Run the campaign name of pause_fixture() next to a copy that plans
    at every decision (same_as_a_new_plan), with prepare and in-progress
    reports, and one pause at each of its pause_points(); of no time, 1 s,
    600 s and a day. In the pause, by event: the devices in flight finish
    ("finish"), or stop before their install ("stop"), the last device
    goes down until the end of the pause ("down"), a new device x0 joins
    and answers ("join"), or the windows that open after the start of the
    pause move an hour later ("edit")."""
    testing.assertTrue(event in ["finish", "stop", "down", "join", "edit"],
                       "no event {event}")
    f = pause_fixture(name)
    points = pause_points(f)
    lengths = [0, 1, 600, DAY]
    last = f.devs[-1].0
    for p in points:
        for length in lengths:
            r = p + length
            label = "{name}, pause at {p} for {length} s, {event}"
            lives: list[(int, str, bool)] = []
            edits: list[(int, list[(str, int, int)], list[(str, int, str)])] = []
            answers = f.answers
            if event == "down":
                lives = [(p, last, False), (r, last, True)]
            elif event == "join":
                edits = [(p, f.windows, f.devs + [("x0", f.devs[0].1, f.devs[0].2)])]
                answers = sorted(f.answers + [(p, "x0")])
            elif event == "edit":
                moved = [(w.0, w.1 + HOUR, w.2 + HOUR) if w.1 > p else w for w in f.windows]
                edits = [(p, moved, f.devs)]
            c = f.make()
            same_as_a_new_plan(c, f.durations, 10 * DAY, answers=answers, in_progress=True,
                               prepare=True, lives=lives, pauses=[(p, r)],
                               stop_flights=event == "stop", edits=edits)


