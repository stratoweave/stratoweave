def limits(c: Controller, target: int, maxc: int) -> None:
    """Configure c again as it is, with the target target and the max
    concurrency maxc."""
    c.configure(c.current, c.devices, target, maxc, c.must_place, c.debounce, c.estimate_s,
                c.groups, c.priority, c.separation, c.close_margin, c.stagger, c.prepare,
                c.prepare_est, c.failure_budget, c.hold_failed)


def where(c: Controller, name: str) -> ?(str, int, int):
    """The window the device name was released in, or else the window
    promised to it, or None."""
    w = c.release_windows().get(name)
    if w is not None:
        return w
    return c.promised_window(name)


def later(w: (str, int, int), at: int) -> (str, int, int):
    """The window w an hour later when it opens after at."""
    if w.1 > at:
        return (w.0, w.1 + HOUR, w.2 + HOUR)
    return w


def promise_order(c: Controller, names: list[str], shift: int) -> list[((str, int, int), str)]:
    """The devices of names that wait with a promise, as (window, name),
    by window and then in the order of the promises. With shift at 0 or
    later, each window that opens after shift counts as an hour later."""
    out: list[((str, int, int), int, str)] = []
    for name in names:
        w = c.promised_window(name)
        if c.is_waiting(name) and w is not None:
            out.append((later(w, shift) if shift >= 0 else w, c.promise_seq[c.known(name)],
                        name))
    return [(e.0, e.2) for e in sorted(out)]


def replans_move_little(name: str) -> None:
    """Run the campaign name of pause_fixture(), with prepare and
    in-progress reports, until each of its pause_points(), next to a
    copy, and change one thing in the run: the max concurrency or the
    target rises, the windows that open later move an hour later, a
    member x0 joins at the end and answers, the last member that waits
    leaves, goes down, or gets a veto of another holder, or a member z
    that has not answered reports failed, as when it left the campaign and
    joined it again with the same attempt, at a failure budget of zero.
    Both decide, the down member comes back up, the veto goes and z's
    status goes, and both decide a second later.
    Each device with a release or a promise before the change, other than
    the one it changes, keeps its window, an hour later when an edit moved
    it, and the devices that wait keep the order of their promises. A
    higher max changes nothing in the plan. The time each member was let
    prepare stays. New limits change no prepare. Nor does a hold of the
    failure budget when the copy lets no member prepare in it, and that
    last check runs at least once."""
    f = pause_fixture(name)
    events = ["max raised", "target raised", "windows later", "member added",
              "member removed", "down and up", "veto on and off", "short budget hold"]
    held_turns = 0
    for p in pause_points(f):
        for event in events:
            label = "{name}, {event} at {p}"
            c = f.make()
            if event == "short budget hold":
                edit(c, c.current, c.devices + [("z", f.devs[0].1, f.devs[0].2)])
                reconfigure(c, c.devices, 0)
            sim.drive(c, 0, f.durations, p, answers=f.answers, prepare_reports=True,
                      in_progress=True)
            last = ""
            for n in c.order:
                if c.is_waiting(n) and n != "z":
                    last = n
            testing.assertTrue(last != "", "{label}: no member waits")
            kept = [n for n in c.order if where(c, n) is not None]
            let = {n: at for n, at in c.prepare_at.items()}
            x = c.copy()
            y = c.copy()
            shift = -1
            # The member the event changes, if any: the others keep their
            # windows and their order.
            touched = ""
            if event in ["member removed", "down and up", "veto on and off"]:
                touched = last
            if event == "max raised":
                limits(y, y.target, y.maxc + 4)
            elif event == "target raised":
                limits(y, y.target + 1, y.maxc)
            elif event == "windows later":
                shift = p
                edit(y, [later(w, p) for w in y.current], y.devices)
            elif event == "member added":
                touched = "x0"
                edit(y, y.current, y.devices + [("x0", f.devs[0].1, f.devs[0].2)])
                y.report("x0", "upgrade-needed", p)
            elif event == "member removed":
                edit(y, y.current, [d for d in y.devices if d.0 != last])
                y.drop({last})
            elif event == "down and up":
                y.set_live(last, False)
            elif event == "veto on and off":
                y.set_vetoed(last, "health")
            else:
                touched = "z"
                y.report("z", "failed", p)
            x.decide(p)
            y.decide(p)
            if event == "down and up":
                y.set_live(last, True)
            elif event == "veto on and off":
                y.set_vetoed(last, "")
            elif event == "short budget hold":
                y.lost("z")
            sx = x.decide(p + 1)
            sy = y.decide(p + 1)
            if event == "max raised":
                testing.assertEqual((sy.started, sy.plan.c, sy.plan.starts),
                                    (sx.started, sx.plan.c, sx.plan.starts), "{label}: the plan")
            names = [n for n in kept if n != touched]
            for n in names:
                wx = where(x, n)
                if wx is not None and shift >= 0:
                    wx = later(wx, shift)
                testing.assertEqual(where(y, n), wx, "{label}: {n}'s window")
            testing.assertEqual(promise_order(y, names, -1), promise_order(x, names, shift),
                                "{label}: the order of the promises")
            for n, at in let.items():
                if n != touched or event != "member removed":
                    testing.assertEqual(y.prepare_at.get(n), at, "{label}: {n} let at")
            same_turns = False
            if event == "max raised" or event == "target raised":
                same_turns = True
            elif event == "short budget hold" \
               and len([n for n, at in x.prepare_at.items() if at >= p]) == 0:
                same_turns = True
                held_turns += 1
            if same_turns:
                testing.assertEqual((y.prepare_at, y.prepares(p + 1).starts),
                                    (x.prepare_at, x.prepares(p + 1).starts),
                                    "{label}: the prepares")
    testing.assertTrue(held_turns > 0, "{name}: no hold kept the turns")


