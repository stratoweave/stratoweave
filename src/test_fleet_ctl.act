"""Tests of the controller's release decisions, on times the tests give."""

import testing

import fleet_ctl
from fleet_ctl import Controller
import fleet_ctl_sim as sim

HOUR = 3600
DAY = 86400


def devices(prefix: str, n: int, est: int, schedule: str) -> list[(str, int, str)]:
    """n devices prefix0, prefix1, ... of est seconds on schedule."""
    return [("{prefix}{i}", est, schedule) for i in range(n)]


def daily(schedule: str, start: int, length: int, days: int) -> list[(str, int, int)]:
    """A window of length seconds at start every day for days days."""
    return [(schedule, d * DAY + start, d * DAY + start + length) for d in range(days)]


def configured(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
               maxc: int, must_place: bool=False, debounce: int=0,
               estimate: int=600, groups: dict[str, list[str]]={},
               priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
               close_margin: int=fleet_ctl.CLOSE_MARGIN, stagger: int=0,
               prepare: bool=False, prepare_s: int=100,
               failure_budget: int=-1, hold_failed: ?set[str]=None) -> Controller:
    """A controller before its first run, every device answered that it
    needs the upgrade. Each device's prepare takes prepare_s seconds."""
    c = Controller()
    c.configure(windows, devs, target, maxc, must_place, debounce, estimate, groups, priority,
                separation, close_margin, stagger, prepare, {d.0: prepare_s for d in devs},
                failure_budget, hold_failed)
    sim.answer_all(c, 0)
    return c


def hold_all() -> set[str]:
    """The groups of the tests in this module that hold on a failure."""
    return {"g", "g1", "g2", "h"}


def controller(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
               maxc: int, must_place: bool=False, debounce: int=0,
               estimate: int=600, groups: dict[str, list[str]]={},
               priority: dict[str, int]={}, separation: dict[str, (bool, int)]={},
               rung: int=1, close_margin: int=fleet_ctl.CLOSE_MARGIN,
               stagger: int=0, prepare: bool=False, prepare_s: int=100,
               failure_budget: int=-1, hold_failed: ?set[str]=None) -> Controller:
    """A controller at the start of a run, every device answered that it
    needs the upgrade. Each device's prepare takes prepare_s seconds."""
    c = configured(windows, devs, target, maxc, must_place, debounce, estimate, groups, priority,
                   separation, close_margin, stagger, prepare, prepare_s, failure_budget,
                   hold_failed)
    c.start(rung)
    return c


def open_window(n: int, target: int, maxc: int, debounce: int=0) -> Controller:
    """n devices d0, d1, ... of 600 s in a window that never closes."""
    return controller([("w", 0, fleet_ctl.OPEN_END)], devices("d", n, 600, "w"), target, maxc,
                      debounce=debounce)


def _test_final_statuses():
    """Only the statuses that end an attempt are final."""
    cases = [
        ("succeeded", True),
        ("up-to-date", True),
        ("failed", True),
        ("rolled-back", True),
        ("in-progress", False),
        ("pending", False),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.is_final(case.0), case.1, case.0)
    testing.assertEqual(fleet_ctl.is_final(None), False, "no status")


def _test_answers():
    """A status answers the campaign's target when the device needs the
    upgrade or the status is final. No status, unknown and in-progress
    are no answer."""
    cases: list[(?str, bool)] = [
        ("upgrade-needed", True),
        ("up-to-date", True),
        ("succeeded", True),
        ("failed", True),
        ("rolled-back", True),
        (None, False),
        ("unknown", False),
        ("in-progress", False),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.is_answer(case.0), case.1, str(case.0))


def _test_first_step_starts_one_device():
    """The ramp starts at one device, and the next decision is one
    debounce after its upgrade is expected to end."""
    c = open_window(10, 4, 8, 5)
    s = c.decide(0)
    testing.assertEqual(s.started, ["d0"])
    testing.assertEqual(s.wake, 605)
    testing.assertEqual(s.finished, False)


def _test_ramp_grows_four_times_a_round():
    """The ramp starts at one device, and each device done without a
    failure lets three more start, up to the concurrency. So when the
    devices of a round succeed together, the next round is four times as
    large, up to the concurrency: 1, 4, 16, then 20."""
    c = open_window(60, 20, 20)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2", "d3", "d4"])
    testing.assertEqual(c.rung, 4)
    for i in range(1, 5):
        c.report("d{i}", "succeeded", 1200)
    testing.assertEqual(c.decide(1200).started, ["d{i}" for i in range(5, 21)])
    testing.assertEqual(c.rung, 16)
    for i in range(5, 21):
        c.report("d{i}", "succeeded", 1800)
    testing.assertEqual(c.decide(1800).started, ["d{i}" for i in range(21, 41)])
    testing.assertEqual(c.rung, 20)


def _test_only_a_device_done_without_a_failure_grows_the_ramp():
    """The ramp grows by three for each device that is done without a
    failure, but not for one that is done without a release. 10 at once
    in a window that never closes, the ramp at one device. d1 reports
    up-to-date before its release: it is done at once, and the ramp stays
    at one. d0 fails: the ramp stays at one, and d2 starts. d2 rolls back:
    the ramp stays at one, and d3 starts. d3 succeeds: the ramp lets 4 be
    in flight, and d4 to d7 start. d4 succeeds: the ramp lets 7 be in
    flight, and with d5, d6 and d7 in flight, d8 to d11 start."""
    c = open_window(12, 10, 10)
    c.report("d1", "up-to-date", 0)
    testing.assertEqual(c.decide(0).started, ["d0"])
    # (the time of the decision, the reports that come then, the devices
    # that start, the ramp after)
    cases: list[(int, list[(str, str)], list[str], int)] = [
        (600, [("d0", "failed")], ["d2"], 1),
        (1200, [("d2", "rolled-back")], ["d3"], 1),
        (1800, [("d3", "succeeded")], ["d4", "d5", "d6", "d7"], 4),
        (1850, [("d4", "succeeded")], ["d8", "d9", "d10", "d11"], 7),
    ]
    for case in cases:
        for r in case.1:
            c.report(r.0, r.1, case.0)
        testing.assertEqual(c.decide(case.0).started, case.2, str(case.0))
        testing.assertEqual(c.rung, case.3, str(case.0))


def without(devs: list[(str, int, str)], names: list[str]) -> list[(str, int, str)]:
    """The devices devs without the devices names."""
    return [d for d in devs if d.0 not in names]


def _test_members_up_to_date_at_the_start_take_no_window_and_no_slot():
    """Members that report up-to-date before the run are done at once,
    without a release. They take no window, no slot and no turn of the
    stagger, and add nothing to the ramp or the pace. So every decision
    starts the same devices at the same time as in the campaign without
    them, with the same devices in flight, ramp, pace and alarms, and the
    run ends at the same decision. The first plan is the same too: it
    places none of them. They count as done."""
    open_w = [("w", 0, fleet_ctl.OPEN_END)]
    # Every fourth device is up to date.
    every_fourth = [("u{i}" if i % 4 == 1 else "d{i}", 600, "day") for i in range(24)]
    # (case, the windows, the devices, the members up to date, the target,
    # the max concurrency, whether every device must start in a window,
    # the ramp, the stagger)
    cases: list[(str, list[(str, int, int)], list[(str, int, str)], list[str], int, int, bool,
                 int, int)] = [
        ("100 first", open_w, devices("u", 100, 600, "w") + devices("r", 40, 600, "w"),
         ["u{i}" for i in range(100)], 10, 10, False, 1, 0),
        ("every fourth", daily("day", 0, HOUR, 9), every_fourth,
         [d.0 for d in every_fourth if d.0.startswith("u")], 2, 4, False, 1, 0),
        ("staggered", open_w, devices("u", 5, 600, "w") + devices("r", 3, 600, "w"),
         ["u{i}" for i in range(5)], 3, 3, False, 3, 100),
        ("deadline", [("w", 0, 2 * HOUR)],
         [("u0", 600, "w")] + devices("d", 12, 600, "w") + [("u1", 600, "w")],
         ["u0", "u1"], 1, 4, True, 1, 0),
    ]
    for case in cases:
        c = controller(case.1, case.2, case.4, case.5, case.6, 30, rung=case.7,
                       stagger=case.8)
        for name in case.3:
            c.report(name, "up-to-date", 0)
        alone = controller(case.1, without(case.2, case.3), case.4, case.5, case.6, 30,
                           rung=case.7, stagger=case.8)
        p = c.plan(0)
        q = alone.plan(0)
        testing.assertEqual(c.layout(p), alone.layout(q), case.0)
        testing.assertEqual(p.alarms, q.alarms, case.0)
        ds = sim.drive(c, 0, {}, 30 * DAY)
        es = sim.drive(alone, 0, {}, 30 * DAY)
        up = len(case.3)
        testing.assertEqual([(d.t, d.started, d.c, d.flying, d.rung, d.done - up, d.pace, d.slow,
                              d.alarms) for d in ds],
                            [(e.t, e.started, e.c, e.flying, e.rung, e.done, e.pace, e.slow,
                              e.alarms) for e in es], case.0)
        testing.assertEqual([n for n in case.3 if c.is_released(n) or not c.is_done(n)], [],
                            case.0)
        testing.assertEqual(c.done_count(), len(case.2), case.0)


def _test_a_report_before_the_release_in_its_second_ran_no_upgrade():
    """d0 has an upgrade of 600 s, one device at a time. A final report
    that came before the decision at 0 ran no upgrade, also in the same
    second: d0 is done at once, without a release, d1 starts instead, and
    the pace stays at 600 s. A report that came after d0's release at 0 is
    an upgrade, in the same second too: it counts as 1 s, and the pace,
    the mean of one upgrade at a target of one, becomes 1 s."""
    # (whether d0 reports before the decision at 0, when it reports, the
    # device that starts at 0, when d0 is done after a release or -1, the
    # pace after)
    cases: list[(bool, int, str, int, int)] = [
        (True, 0, "d1", -1, 600),
        (False, 0, "d0", 0, 1),
        (False, 1, "d0", 1, 1),
    ]
    for case in cases:
        label = "report at {case.1}, before the release: {case.0}"
        c = open_window(2, 1, 1)
        if case.0:
            c.report("d0", "succeeded", case.1)
        testing.assertEqual(c.decide(0).started, [case.2], label)
        if not case.0:
            c.report("d0", "succeeded", case.1)
        c.decide(1)
        testing.assertEqual(c.is_done("d0"), True, label)
        testing.assertEqual((c.done_times().get_def("d0", -1), c.observed_s), (case.3, case.4),
                            label)


def _test_each_device_that_succeeds_lets_three_more_start():
    """The ramp does not wait for a round to end. 10 at once. d0 succeeds,
    and the ramp lets 4 be in flight: d1 to d4 start. d1 succeeds, though
    d2 to d4 are still in flight: the ramp lets 7 be in flight, and d5 to
    d8 start. d2 succeeds: the ramp reaches the concurrency of 10, and d9
    to d12 start. d3 succeeds: the ramp stays at 10, and d13 takes the
    slot of d3."""
    c = open_window(30, 10, 10)
    testing.assertEqual(c.decide(0).started, ["d0"])
    # (the device done, when, the devices that start, the ramp after)
    cases: list[(str, int, list[str], int)] = [
        ("d0", 600, ["d1", "d2", "d3", "d4"], 4),
        ("d1", 700, ["d5", "d6", "d7", "d8"], 7),
        ("d2", 800, ["d9", "d10", "d11", "d12"], 10),
        ("d3", 900, ["d13"], 10),
    ]
    for case in cases:
        c.report(case.0, "succeeded", case.1)
        testing.assertEqual(c.decide(case.1).started, case.2, case.0)
        testing.assertEqual(c.rung, case.3, case.0)


def _test_the_ramp_follows_a_rise_of_the_concurrency_as_devices_finish():
    """4 at once: the ramp is at the concurrency, with d1 to d4 in flight.
    New limits raise the concurrency to 10. No device is done, so the next
    decision starts none. Then each device that succeeds lets three more
    start, as on the way up: when d1 succeeds, d5 to d8 start, when d2
    succeeds, d9 to d12, and when d3 succeeds, d13 only."""
    c = open_window(30, 4, 4)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["d1", "d2", "d3", "d4"])
    c.configure([("w", 0, fleet_ctl.OPEN_END)], devices("d", 30, 600, "w"), 10, 10, False, 0, 600)
    s = c.decide(610)
    testing.assertEqual((s.plan.c, s.started, c.rung), (10, [], 4))
    # (the device done, when, the devices that start, the ramp after)
    cases: list[(str, int, list[str], int)] = [
        ("d1", 700, ["d5", "d6", "d7", "d8"], 7),
        ("d2", 800, ["d9", "d10", "d11", "d12"], 10),
        ("d3", 900, ["d13"], 10),
    ]
    for case in cases:
        c.report(case.0, "succeeded", case.1)
        testing.assertEqual(c.decide(case.1).started, case.2, case.0)
        testing.assertEqual(c.rung, case.3, case.0)


def _test_done_at_its_report():
    """A device is done at the time of its final report, not at the
    decision that sees it, so the time it waited for the decision is not
    upgrade time. A later final report does not move the end."""
    c = open_window(2, 1, 1)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.report("d0", "succeeded", 650)
    c.decide(700)
    testing.assertEqual(c.done_times(), {"d0": 600})
    testing.assertEqual(c.observed_s, 600)


def _test_final_report_from_before_the_release():
    """A device that reported a final status before it was released is
    done at once, without a release, and the decision starts the next
    device in its slot. It ran no upgrade, so the pace stays."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    testing.assertEqual(c.decide(10).started, ["d1"])
    testing.assertEqual((c.is_done("d0"), c.is_released("d0")), (True, False))
    c.report("d1", "succeeded", 610)
    c.decide(610)
    testing.assertEqual(c.done_times(), {"d1": 610})
    testing.assertEqual(c.observed_s, 600)


def _test_lost_or_later_status_is_not_done():
    """A device whose report was lost, or whose later report is not
    final, is not done, and keeps its slot."""
    c = open_window(3, 1, 1)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    c.lost("d0")
    testing.assertEqual(c.decide(600).started, [])
    testing.assertEqual(c.done_times(), {})
    c.report("d0", "succeeded", 1100)
    c.report("d0", "in-progress", 1150)
    c.decide(1200)
    testing.assertEqual(c.done_times(), {})


def _test_waits_for_the_window_to_open():
    """Before its window opens nothing starts, and the next decision is at
    the opening."""
    c = controller([("w", 1000, fleet_ctl.OPEN_END)], devices("d", 3, 600, "w"), 1, 1)
    s = c.decide(0)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.wake, 1000)
    testing.assertEqual(c.decide(1000).started, ["d0"])


def _test_a_device_waits_for_a_window_it_fits():
    """Two 1000 s windows a day apart, one device at a time. d0 starts at
    the first opening. At 600 the 400 s left are too short for one and a
    half times d1's 600 s, so it starts at the second opening, and waits in
    the first window no more. The controller decides again when the first
    window closes, and then at the second opening."""
    wins = daily("w", 0, 1000, 2)
    c = controller(wins, devices("d", 2, 600, "w"), 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.report("d0", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, [])
    testing.assertEqual(s.wake, 1000)
    testing.assertEqual(c.decide(1000).wake, DAY)
    testing.assertEqual(c.decide(DAY).started, ["d1"])
    testing.assertEqual(c.release_windows(), {"d0": wins[0], "d1": wins[1]})
    c.report("d1", "succeeded", DAY + 600)
    testing.assertEqual(c.decide(DAY + 600).finished, True)


def plan_is_run(windows: list[(str, int, int)], devs: list[(str, int, str)], target: int,
                maxc: int, must_place: bool, estimate: int,
                groups: dict[str, list[str]]={}, priority: dict[str, int]={},
                separation: dict[str, (bool, int)]={},
                close_margin: int=fleet_ctl.CLOSE_MARGIN, stagger: int=0) -> list[int]:
    """Run on the expected durations, the controller starts every device
    in the window and at the time its first plan said. Return how many
    devices the first plan puts in each window that has devices."""
    c = controller(windows, devs, target, maxc, must_place, 1, estimate, groups, priority,
                   separation, close_margin=close_margin, stagger=stagger)
    p = c.plan(0)
    sim.drive(c, 0, {}, 30 * DAY)
    testing.assertEqual(sim.started(c), sim.planned(c, p))
    return [len(w.3) for w in c.layout(p)]


def reconfigure(c: Controller, devs: list[(str, int, str)], failure_budget: int) -> None:
    """Configure c again as it is, with the devices devs and the failure
    budget failure_budget."""
    c.configure(c.current, devs, c.target, c.maxc, c.must_place, c.debounce, c.estimate_s,
                c.groups, c.priority, c.separation, c.close_margin, c.stagger, c.prepare,
                c.prepare_est, failure_budget)


def same_as_a_new_plan(c: Controller, dur_of: dict[str, int], until: int,
                       late: int=0, answers: list[(int, str)]=[],
                       in_progress: bool=False, prepare: bool=False,
                       failing: list[str]=[], budgets: list[(int, int)]=[],
                       lives: list[(int, str, bool)]=[], reboots: bool=False,
                       statuses: list[(int, str, ?str)]=[], pauses: list[(int, int)]=[],
                       stop_flights: bool=False,
                       edits: list[(int, list[(str, int, int)], list[(str, int, str)])]=[],
                       decided: ?list[(int, list[str])]=None) -> int:
    """Run c the way the campaign actor does, each decision late seconds
    after its time, next to a copy of it that plans at every decision.
    Each decision of c starts the same devices, wakes at the same time and
    has the same plan as the copy's. answers holds the devices that answer
    the campaign's target later, as (time, name): each reports to both
    that it needs the upgrade at its time, and the next decision is one
    debounce later at the latest. With in_progress, each device that
    starts reports in-progress to both at its start. With prepare, each
    decision of c also has the same prepares as the copy's and lets the
    same members prepare, and each member let prepare reports to both its
    prepare running when it is let and done one expected prepare time
    later; the next decision is one debounce after that at the latest.
    The devices in failing report failed instead of succeeded. budgets
    holds new failure budgets, as (time, budget): both take each at its
    time, and a decision comes then. lives holds devices that go down or
    come back up, as (time, name, up), in the order of their times: both
    take each at its time, and a decision comes then. With reboots, each
    device that starts goes down a third of the way into its upgrade and
    comes back up two thirds of the way in, and a decision comes at each;
    both take the changes that are due at a decision in the order they
    came. statuses holds other reports, as (time, name, status), in the
    order of their times: both take each at its time, and a decision
    comes then. edits holds new windows and devices, as (time, windows,
    devices), in the order of their times: both take each at its time,
    and a decision comes then.

    pauses holds pauses, as (start, end), in order. At the start, after
    the events then, both stop; with stop_flights, each device in flight
    then stops before its install, reports upgrade-needed and never ends.
    Until the end they decide nothing, and the events in the pause come
    at their times. At each event in the pause and at its end, a copy of
    each that starts and stops letting prepare the members that may no
    longer prepare, as a campaign in plan shows it, plans the same and
    has the same prepares. At the end both start again, stop letting
    prepare the members that may no longer prepare, and decide: c's
    decision has the plan and the prepares of that copy, and the run
    carries on (Paused.kept(), Paused.promises_kept()). A pause of no time
    that takes no device back decides as no pause. Each pause comes before
    the run ends.

    With prepare, the time a member was let prepare never changes, each
    member is let by its deadline, and a decision lets each member at
    the start that the decision before it showed, when the decisions are
    on time, and in between only prepare reports came, no window opened
    or closed, and the later decision starts no device.

    decided, when given, gets each decision of c, as (time, the devices it
    starts).

    Return how many decisions of c took the last plan again."""
    d = c.copy()
    flying: list[(int, str)] = []
    pending = sorted(answers)
    budgets_left = sorted(budgets)
    reports_left: list[(int, str, ?str)] = list(statuses)
    edits_left = list(edits)
    pauses_left = list(pauses)
    # The changes of up and down to come.
    changes: list[(int, str, bool)] = lives
    # The prepares that run, as (end, name), and the members let prepare.
    prepping: list[(int, str)] = []
    let: set[str] = set()
    # When each member was let prepare, and the starts that the last
    # decision showed.
    let_at: dict[str, int] = {}
    shown: dict[str, int] = {}
    last_t = -1
    paused: ?Paused = None
    again = 0
    t = 0
    while t <= until:
        came = False
        still: list[(int, str)] = []
        for f in flying:
            if f.0 <= t:
                status = "failed" if f.1 in failing else "succeeded"
                c.report(f.1, status, f.0)
                d.report(f.1, status, f.0)
                came = True
            else:
                still.append(f)
        flying = still
        while len(budgets_left) > 0 and budgets_left[0].0 <= t:
            b = budgets_left.pop(0)
            reconfigure(c, c.devices, b.1)
            reconfigure(d, d.devices, b.1)
            came = True
        while len(edits_left) > 0 and edits_left[0].0 <= t:
            e = edits_left.pop(0)
            edit(c, e.1, e.2)
            edit(d, e.1, e.2)
            came = True
        to_come: list[(int, str, bool)] = []
        for e in changes:
            if e.0 <= t:
                c.set_live(e.1, e.2)
                d.set_live(e.1, e.2)
                came = True
            else:
                to_come.append(e)
        changes = to_come
        later: list[(int, str)] = []
        for a in pending:
            if a.0 <= t:
                c.report(a.1, "upgrade-needed", a.0)
                d.report(a.1, "upgrade-needed", a.0)
                came = True
            else:
                later.append(a)
        pending = later
        while len(reports_left) > 0 and reports_left[0].0 <= t:
            r = reports_left.pop(0)
            c.report(r.1, r.2, r.0)
            d.report(r.1, r.2, r.0)
            came = True
        copying: list[(int, str)] = []
        for p in prepping:
            if p.0 <= t:
                c.report_prepare(p.1, "done")
                d.report_prepare(p.1, "done")
            else:
                copying.append(p)
        prepping = copying
        if paused is None and len(pauses_left) > 0 and pauses_left[0].0 <= t:
            unpaused = c.copy()
            c.stop()
            d.stop()
            if stop_flights:
                for f in flying:
                    c.report(f.1, "upgrade-needed", t)
                    d.report(f.1, "upgrade-needed", t)
                flying = []
            paused = Paused(c, unpaused, t)
        resumed: ?Paused = None
        shown_plan: ?fleet_ctl.Plan = None
        shown_prepares: ?fleet_ctl.Prepares = None
        pz = paused
        if pz is not None:
            end = pauses_left[0].1
            x = c.carried_on(t)
            y = d.carried_on(t)
            px = x.plan(t)
            py = y.plan(t)
            qx = x.prepares(t)
            qy = y.prepares(t)
            testing.assertEqual((px.c, px.starts, px.held, px.why, px.alarms),
                                (py.c, py.starts, py.held, py.why, py.alarms),
                                "plan in the pause at {t}")
            testing.assertEqual((qx.starts, qx.c, qx.alarms), (qy.starts, qy.c, qy.alarms),
                                "prepares in the pause at {t}")
            if t < end:
                nxt = end
                for f in flying + prepping:
                    nxt = fleet_ctl.imin(nxt, f.0)
                for e in changes:
                    nxt = fleet_ctl.imin(nxt, e.0)
                if len(pending) > 0:
                    nxt = fleet_ctl.imin(nxt, pending[0].0)
                if len(budgets_left) > 0:
                    nxt = fleet_ctl.imin(nxt, budgets_left[0].0)
                if len(reports_left) > 0:
                    nxt = fleet_ctl.imin(nxt, reports_left[0].0)
                if len(edits_left) > 0:
                    nxt = fleet_ctl.imin(nxt, edits_left[0].0)
                t = nxt
                continue
            shown_plan = px
            shown_prepares = qx
            c.start()
            c.revoke_prepares(t)
            d.start()
            d.revoke_prepares(t)
            pz.kept(c, t)
            resumed = pz
            paused = None
            pauses_left.pop(0)
            came = True
        down = c.down_end()
        if c.last_plan is not None and c.quiet_from <= t and t < c.quiet_until \
           and (down < 0 or t < down):
            again += 1
        d.quiet_until = 0
        s = c.decide(t)
        n = d.decide(t)
        testing.assertEqual(s.started, n.started, "started at {t}")
        testing.assertEqual(s.wake, n.wake, "wake at {t}")
        testing.assertEqual(s.finished, n.finished, "finished at {t}")
        testing.assertEqual(s.plan.c, n.plan.c, "concurrency at {t}")
        testing.assertEqual(s.plan.starts, n.plan.starts, "plan at {t}")
        testing.assertEqual(s.plan.held, n.plan.held, "held at {t}")
        testing.assertEqual(s.plan.why, n.plan.why, "why at {t}")
        testing.assertEqual(s.plan.alarms, n.plan.alarms, "alarms at {t}")
        rz = resumed
        sp = shown_plan
        sq = shown_prepares
        if rz is not None and sp is not None and sq is not None:
            testing.assertEqual((s.plan.c, s.plan.starts, s.plan.held, s.plan.why, s.plan.alarms),
                                (sp.c, sp.starts, sp.held, sp.why, sp.alarms),
                                "the plan in the pause is the run at {t}")
            testing.assertEqual((s.prepares.starts, s.prepares.c, s.prepares.alarms),
                                (sq.starts, sq.c, sq.alarms),
                                "the prepares in the pause are the run at {t}")
            rz.promises_kept(c, t)
            u = rz.unpaused
            if rz.since == t and len(rz.back) == 0:
                u.quiet_until = 0
                us = u.decide(t)
                testing.assertEqual((s.started, s.plan.c, s.plan.starts, s.plan.held, s.plan.why,
                                     s.plan.alarms),
                                    (us.started, us.plan.c, us.plan.starts, us.plan.held,
                                     us.plan.why, us.plan.alarms),
                                    "a pause of no time at {t}")
        if prepare:
            testing.assertEqual(s.prepares.starts, n.prepares.starts, "prepare starts at {t}")
            testing.assertEqual(s.prepares.c, n.prepares.c, "prepares at once at {t}")
            testing.assertEqual(s.prepares.alarms, n.prepares.alarms, "prepare alarms at {t}")
            testing.assertEqual(sorted(list(c.allowed)), sorted(list(d.allowed)),
                                "let prepare at {t}")
            testing.assertEqual(c.prepare_at, d.prepare_at, "let prepare in this run at {t}")
            opened = False
            for w in c.windows:
                if (last_t < w.1 and w.1 <= t) or (last_t < w.2 and w.2 <= t):
                    opened = True
            calm = not came and not opened and len(s.started) == 0 and late == 0
            for name in sorted(c.prepare_at.keys()):
                at = c.prepare_at[name]
                if name in let_at:
                    testing.assertEqual(at, let_at[name], "{name} let again at {t}")
                else:
                    let_at[name] = at
                    dl = c.prepare_deadline(name, at)
                    testing.assertTrue(dl is not None and at * fleet_ctl.MICRO <= dl,
                                       "{name} let at {at}, after its deadline")
                    if calm and name in shown:
                        testing.assertEqual(at, shown[name], "{name} let as shown, at {t}")
            testing.assertEqual([n for n in let_at.keys() if n not in c.prepare_at], [],
                                "let prepare at {t}")
            shown = s.prepares.starts
            for name in sorted(c.prepare_at.keys()):
                if name not in let:
                    let.add(name)
                    c.report_prepare(name, "running")
                    d.report_prepare(name, "running")
                    prepping.append((t + c.prepare_est.get_def(name, 1), name))
        last_t = t
        if decided is not None:
            decided.append((t, s.started))
        for name in s.started:
            dur = dur_of.get_def(name, c.est.get_def(name, 1))
            flying.append((t + dur, name))
            if in_progress:
                c.report(name, "in-progress", t)
                d.report(name, "in-progress", t)
            if reboots:
                changes = changes + [(t + dur // 3, name, False), (t + 2 * dur // 3, name, True)]
        if s.finished:
            break
        nxt = s.wake
        for f in flying + prepping:
            if nxt < 0 or f.0 + c.debounce < nxt:
                nxt = f.0 + c.debounce
        for e in changes:
            if nxt < 0 or e.0 < nxt:
                nxt = e.0
        if len(pending) > 0 and (nxt < 0 or pending[0].0 + c.debounce < nxt):
            nxt = pending[0].0 + c.debounce
        if len(budgets_left) > 0 and (nxt < 0 or budgets_left[0].0 < nxt):
            nxt = budgets_left[0].0
        if len(reports_left) > 0 and (nxt < 0 or reports_left[0].0 < nxt):
            nxt = reports_left[0].0
        if len(edits_left) > 0 and (nxt < 0 or edits_left[0].0 < nxt):
            nxt = edits_left[0].0
        if len(pauses_left) > 0 and (nxt < 0 or pauses_left[0].0 < nxt):
            nxt = pauses_left[0].0
        if nxt < 0:
            break
        t = nxt + late
    testing.assertEqual(pauses_left, [], "pauses after the end of the run")
    return again


def edit(c: Controller, windows: list[(str, int, int)], devs: list[(str, int, str)]) -> None:
    """Configure c again as it is, with the windows windows and the devices
    devs, each new device with a prepare of 100 s."""
    est = {name: s for name, s in c.prepare_est.items()}
    for dv in devs:
        if dv.0 not in est:
            est[dv.0] = 100
    c.configure(windows, devs, c.target, c.maxc, c.must_place, c.debounce, c.estimate_s,
                c.groups, c.priority, c.separation, c.close_margin, c.stagger, c.prepare, est,
                c.failure_budget, c.hold_failed)


class Paused(object):
    """What a run knew when it paused at since, to check that it carries on
    when it goes on (kept, promises_kept). unpaused is a copy of the run
    that did not pause."""
    since: int
    unpaused: Controller
    times: dict[str, int]
    windows: dict[str, (str, int, int)]
    done: dict[str, int]
    failed: set[str]
    let: dict[str, int]
    kept_state: (int, int, int, int, int)
    # The windows promised to the waiting devices, and the order of their
    # promises; the devices taken back when the run goes on.
    promised: dict[str, (str, int, int)]
    seqs: dict[str, int]
    back: list[str]

    def __init__(self, c: Controller, unpaused: Controller, since: int):
        self.unpaused = unpaused
        self.since = since
        self.times = c.release_times()
        self.windows = c.release_windows()
        self.done = c.done_times()
        self.failed = c.failed_devices()
        self.let = {name: at for name, at in c.prepare_at.items()}
        self.kept_state = (c.rung, c.c, c.observed_s, c.slow_s, c.prep_last)
        self.promised = {}
        self.seqs = {}
        for name in c.order:
            w = c.promised_window(name)
            if c.is_waiting(name) and w is not None:
                self.promised[name] = w
                self.seqs[name] = c.promise_seq[c.known(name)]
        self.back = []

    def kept(self, c: Controller, t: int) -> None:
        """Check the run that goes on at t, before its first decision: the
        released devices keep their release, except the ones taken back,
        which were in flight without a report and are promised the window
        they were released in; the devices done keep their done time and
        their failure, the waiting devices their promises and their order,
        the members let prepare their time, and the ramp, the
        concurrency, the pace, the slow time and the last turn stay."""
        times = c.release_times()
        self.back = sorted([n for n in self.times.keys() if n not in times])
        for name in self.back:
            testing.assertEqual((name in self.done, c.promised_window(name)),
                                (False, self.windows.get(name)), "{name} taken back at {t}")
        testing.assertEqual(times, {n: at for n, at in self.times.items() if n not in self.back},
                            "released at {t}")
        testing.assertEqual(c.release_windows(),
                            {n: w for n, w in self.windows.items() if n not in self.back},
                            "release windows at {t}")
        testing.assertEqual((c.done_times(), c.failed_devices()), (self.done, self.failed),
                            "done at {t}")
        testing.assertEqual(c.prepare_at, self.let, "let prepare at {t}")
        testing.assertEqual((c.rung, c.c, c.observed_s, c.slow_s, c.prep_last), self.kept_state,
                            "ramp, concurrency, pace, slow time and turn at {t}")
        for name, w in self.promised.items():
            k = c.known(name)
            testing.assertEqual((c.promised_window(name), c.promise_seq[k]),
                                (w, self.seqs[name]), "{name}'s promise at {t}")

    def promises_kept(self, c: Controller, t: int) -> None:
        """Check the first decision of the run that goes on at t: each
        device promised a window when the run paused, or taken back, starts
        in that window or keeps its promise while the window has not
        closed; once it has, in the next window of its schedule. When an
        edit took the window away before it closed, the device is in the
        window of its schedule nearest it (moved()). The concurrency is not
        lower."""
        testing.assertTrue(c.c >= self.kept_state.1, "concurrency at {t}")
        wins: dict[str, (str, int, int)] = {n: w for n, w in self.promised.items()}
        for name in self.back:
            w = self.windows.get(name)
            if w is not None:
                wins[name] = w
        for name, w in wins.items():
            want: ?(str, int, int) = w
            if t >= w.2 or w not in c.current:
                want = moved(w, c.current, t)
            got = c.release_windows().get(name)
            if got is None:
                got = c.promised_window(name)
            testing.assertEqual(got, want, "{name} promised before the pause, at {t}")


def moved(w: (str, int, int), windows: list[(str, int, int)], t: int) -> ?(str, int, int):
    """The window that a promise of the window w moves to at t, among the
    windows windows: when w has closed, the first window of its schedule
    that has not; otherwise the one of those whose opening is nearest w's,
    the later one of two as near. None when there is none."""
    best = (-1, -1)
    for x in sorted([(cw.1, cw.2) for cw in windows if cw.0 == w.0 and t < cw.2 and cw != w]):
        if best.0 < 0 or (t < w.2 and abs(x.0 - w.1) <= abs(best.0 - w.1)):
            best = x
    if best.0 < 0:
        return None
    return (w.0, best.0, best.1)


def _test_the_plan_is_the_run_uniform():
    """100 devices of 10 min in a 1 h window every day, 10 at once."""
    plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False, 600)


def _test_the_plan_is_the_run_at_a_close_margin_of_200_percent():
    """The same fleet with a close margin of 200 percent: a round starts
    only with 1200 s left, by 00:40:00, so the windows take 25, 40 and
    35 devices, not 35, 50 and 15."""
    sizes = plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False,
                        600, close_margin=200)
    testing.assertEqual(sizes, [25, 40, 35])


def _test_the_plan_is_the_run_at_a_stagger():
    """100 devices of 600 s in a 1 h window every day, 10 at once,
    staggered over a whole upgrade: one start a minute. A window fills
    over ten minutes, so the windows take 30, 45 and 25 devices, not 35,
    50 and 15."""
    sizes = plan_is_run(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False,
                        600, stagger=100)
    testing.assertEqual(sizes, [30, 45, 25])


def overlapping(days: int) -> list[(str, int, int)]:
    """Three schedules whose daily windows of an hour overlap: eu opens
    first, uk half an hour later and us 45 minutes later."""
    return daily("eu", 0, HOUR, days) + daily("uk", 1800, HOUR, days) \
        + daily("us", 2700, HOUR, days)


def overlapping_devices() -> list[(str, int, str)]:
    """40 devices of 600 s on eu, 20 on uk and 15 on us."""
    return devices("eu", 40, 600, "eu") + devices("uk", 20, 600, "uk") \
        + devices("us", 15, 600, "us")


def _test_the_plan_is_the_run_overlapping_windows():
    """The devices of three schedules whose windows overlap, 5 at once and
    at most 10."""
    # (stagger, every device must start in a window)
    cases = [(0, False), (25, False), (100, False), (0, True), (25, True)]
    for case in cases:
        plan_is_run(overlapping(9), overlapping_devices(), 5, 10, case.1, 600,
                    stagger=case.0)


def _test_overlapping_windows_share_the_slots_in_the_plan():
    """eu has more devices than its first window takes. In the first plan,
    uk starts devices in its first window while eu still starts devices
    in its own, not only once eu takes no more."""
    c = controller(overlapping(9), overlapping_devices(), 5, 5, debounce=1)
    p = c.plan(0)
    eu_last = 0
    uk_first = -1
    for name, s in p.starts.items():
        if name.startswith("eu") and s.0 == 0:
            eu_last = fleet_ctl.imax(eu_last, s.1)
        if name.startswith("uk") and (uk_first < 0 or s.1 < uk_first):
            uk_first = s.1
    testing.assertTrue(uk_first >= 0 and uk_first < eu_last,
                       "uk first starts at {uk_first}, eu last at {eu_last}")


def _test_a_decision_that_takes_the_last_plan_again_decides_as_a_new_plan():
    """60 devices of 600 s in a 1 h window every day, 5 at once and at most
    10. Their upgrades take 85 to 115 percent of the estimate, or every
    fifth one twice the estimate. Staggered, the decisions in which only
    devices start take the last plan again, and decide as a new plan
    would. A decision that comes a second or two late plans anew."""
    scatter: dict[str, int] = {}
    tail: dict[str, int] = {}
    for i in range(60):
        scatter["d{i}"] = 600 * (85 + (i * 7) % 31) // 100
        tail["d{i}"] = 1200 if i % 5 == 4 else 600
    # (stagger, upgrade times, how late each decision comes)
    cases = [
        (100, scatter, 0),
        (25, scatter, 0),
        (100, tail, 0),
        (25, tail, 0),
        (25, scatter, 1),
        (100, tail, 2),
    ]
    for case in cases:
        c = controller(daily("day", 0, HOUR, 9), devices("d", 60, 600, "day"), 5, 10, False, 1,
                       stagger=case.0)
        again = same_as_a_new_plan(c, case.1, 9 * DAY, case.2)
        if case.2 == 0:
            testing.assertTrue(again > 0,
                               "stagger {case.0}: {again} decisions took the plan again")


def _test_with_overlapping_windows_a_decision_that_takes_the_last_plan_again_decides_as_a_new_plan():
    """The same with three schedules whose windows overlap, 5 at once and
    at most 10."""
    scatter: dict[str, int] = {}
    for d in overlapping_devices():
        k = int(d.0[2:])
        scatter[d.0] = 600 * (85 + (k * 7) % 31) // 100
    # (stagger, how late each decision comes)
    cases = [(100, 0), (25, 0), (25, 1)]
    for case in cases:
        c = controller(overlapping(9), overlapping_devices(), 5, 10, False, 1, stagger=case.0)
        again = same_as_a_new_plan(c, scatter, 9 * DAY, case.1)
        if case.1 == 0:
            testing.assertTrue(again > 0,
                               "stagger {case.0}: {again} decisions took the plan again")


def _test_the_plan_is_the_run_mixed():
    """10 devices of 395 s and 100 of 4 s on one schedule, one at a time."""
    devs = devices("real", 10, 395, "night") + devices("sim", 100, 4, "night")
    plan_is_run(daily("night", 2 * HOUR, 1800, 9), devs, 1, 1, False, 40)


def _test_the_plan_is_the_run_two_schedules():
    """Two schedules of five 8 s devices each."""
    devs = devices("n", 5, 8, "night") + devices("w", 5, 8, "weekend")
    plan_is_run([("night", 0, HOUR), ("weekend", 2 * HOUR, 3 * HOUR)], devs, 8, 16, False, 8)


def _test_the_plan_is_the_run_deadline():
    """100 devices of 10 min with a deadline that raises the
    concurrency."""
    plan_is_run(daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50, True, 600)


def _test_uniform_fleet_fills_each_window_to_its_ramp():
    """100 devices of 10 min, a 1 h window every day, 10 at once. A
    round starts every 601 s, and the last round of a window starts by
    00:45:00. The first window ramps 1, 4, 10, 10, 10 and has no time for
    a sixth round: it takes 35. The ramp belongs to the campaign, so the
    next window runs five rounds of 10 and takes 50, and the third the
    last 15."""
    c = controller(daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10,
                   debounce=1)
    sizes = [len(w.3) for w in c.layout(c.plan(0))]
    testing.assertEqual(sizes, [35, 50, 15])


def _test_deadline_raises_the_concurrency():
    """The same fleet with a deadline at the end of the second window. At
    11 at once the two windows take 38 and 55, 7 short; at 12 they take
    41 and 59."""
    c = controller(daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50,
                   True, 1)
    p = c.plan(0)
    testing.assertEqual(p.c, 12)
    testing.assertEqual([len(w.3) for w in c.layout(p)], [41, 59])
    testing.assertEqual(p.alarms, [])


def _test_device_without_a_window_keeps_the_concurrency():
    """A device whose schedule gives no window cannot start at any
    concurrency, so it does not raise the concurrency; it is the alarm."""
    devs = devices("d", 99, 600, "day") + [("x", 600, "never")]
    c = controller(daily("day", 0, HOUR, 3), devs, 10, 50, True, 1)
    p = c.plan(0)
    testing.assertEqual(p.c, 10)
    testing.assertEqual(p.alarms, ["1 device(s) cannot start before the deadline: x"])


def _test_a_device_that_misses_its_window_gets_a_later_one():
    """Three devices of 600 s are promised a 3000 s window at one at a
    time. d0 takes 2000 s, so the controller expects 2000 s upgrades and
    the 1000 s left are too short for d1. When the window closes d1 and
    d2 are promised the next day's window, where they start, d2 when d1
    reports after its 600 s."""
    wins = daily("w", 0, 3000, 2)
    c = controller(wins, devices("d", 3, 600, "w"), 1, 1)
    p = c.plan(0)
    testing.assertEqual([len(w.3) for w in c.layout(p)], [3])
    sim.drive(c, 0, {"d0": 2000}, 2 * DAY)
    testing.assertEqual(sim.started(c), {"d0": (wins[0], 0), "d1": (wins[1], DAY),
                                         "d2": (wins[1], DAY + 600)})


def _test_promises_raise_the_concurrency_when_upgrades_run_slow():
    """50 devices of 600 s are promised a 1 h window at 10 at once, the ramp
    already at 10. The upgrades take 900 s, so after the first round 10 at
    once can no longer keep the promises, and the controller goes above
    10 to keep them."""
    c = Controller()
    c.configure([("w", 0, HOUR)], devices("d", 50, 600, "w"), 10, 20, False, 0, 600)
    sim.answer_all(c, 0)
    c.start(10)
    c.plan(0)
    durations = {"d{i}": 900 for i in range(50)}
    sim.drive(c, 0, durations, HOUR)
    testing.assertEqual(len(c.released_devices()), 50)
    testing.assertTrue(c.c > 10, "the concurrency must rise above the target")


def _test_alarm_names_the_devices():
    """A window that one round fills cannot take 10 devices at max 1: the
    plan says which 9 do not fit."""
    c = controller([("w", 0, 1000)], devices("d", 10, 600, "w"), 1, 1, True)
    testing.assertEqual(c.plan(0).alarms,
                        ["9 device(s) cannot start before the deadline even at "
                         + "max-concurrency 1: d1, d2, d3, d4, d5 and 4 more"])


def _test_a_plan_is_a_fixed_point():
    """Windows [100, 500) and [1500, 1700), devices of 150, 150, 100 and
    150 s, one at a time and up to two, every device before the deadline.
    Run without promises, d2 takes the first window's last slot and d3
    fits nowhere. The plan promises d2 the second window, after which two
    at once start every device. The plan runs again until its promises
    stop changing, so it gives that at once, and again when asked
    again."""
    devs = [("d0", 150, "w"), ("d1", 150, "w"), ("d2", 100, "w"), ("d3", 150, "w")]
    c = controller([("w", 100, 500), ("w", 1500, 1700)], devs, 1, 2, True)
    p = c.plan(0)
    testing.assertEqual((p.c, p.alarms), (2, []))
    q = c.plan(0)
    testing.assertEqual((q.c, q.starts), (p.c, p.starts))


def _test_a_late_upgrade_keeps_the_end_it_was_given():
    """d1 is expected to end at 201. Up to 221 it is not late: a fifth of
    its upgrade, 20 s, has not passed since then. At 222 it is: it is
    expected to take one more upgrade, to 322. A decision with nothing
    new keeps that end, so the plans before and after it agree."""
    c = controller([("w", 0, 500)], devices("d", 6, 100, "w"), 2, 4, debounce=1,
                   estimate=100)
    c.decide(0)
    c.report("d0", "succeeded", 100)
    c.decide(101)
    c.report("d2", "succeeded", 201)
    c.decide(202)
    testing.assertEqual(c.due_time("d1"), 201)
    c.decide(221)
    testing.assertEqual(c.due_time("d1"), 201)
    p = c.decide(222).plan
    testing.assertEqual(c.due_time("d1"), 322)
    q = c.plan(260)
    testing.assertEqual((q.c, q.starts), (p.c, p.starts))


def _test_a_missed_promise_moves_to_an_open_window():
    """Windows [0, 300) and [100, open) of one schedule, one device at a
    time. The plan promises x the first window and b the second. a takes
    250 s, x no longer fits the first window, and when it closes x is
    promised the second, where it starts when b ends."""
    wins = [("s", 0, 300), ("s", 100, fleet_ctl.OPEN_END)]
    devs = [("a", 100, "s"), ("x", 100, "s"), ("b", 100, "s")]
    c = controller(wins, devs, 1, 1, estimate=100)
    p = c.plan(0)
    testing.assertEqual(sim.planned(c, p), {"a": (wins[0], 0), "x": (wins[0], 100),
                                            "b": (wins[1], 200)})
    sim.drive(c, 0, {"a": 250}, 1000)
    testing.assertEqual(sim.started(c), {"a": (wins[0], 0), "b": (wins[1], 250),
                                         "x": (wins[1], 350)})


def slow_then_fast() -> dict[str, int]:
    """Upgrade times: s0 and s1 take 300 s, and f0 to f48 take 90 s and
    80 s in turn. One at a time, in the order s0, f0, s1 and f1 to f48,
    each device ends at a time other than expected, so its time counts."""
    took = {"s0": 300, "s1": 300}
    for i in range(49):
        took["f{i}"] = 90 if i % 2 == 0 else 80
    return took


def _test_a_device_that_fits_again_starts():
    """One at a time, a window [0, 7000), and a campaign estimate of 100 s.
    The devices s0, f0, s1, x and f1 to f48 start in that order, and take
    the times of slow_then_fast(). x, of 1500 s, takes its estimate. When
    s1's time counts, at 690, two slow upgrades are among the 50 kept
    times, so the slow time is 300 s. x needs 6750 s and does not fit, and
    f1 starts. When f48's time counts, at 4770, s0's time has left the
    kept times, and the slow time falls to 90 s. x is looked at again,
    and starts with the 2025 s it needs."""
    devs = [("s0", 100, "w"), ("f0", 100, "w"), ("s1", 100, "w"), ("x", 1500, "w")] \
           + [("f{i}", 100, "w") for i in range(1, 49)]
    c = controller([("w", 0, 7000)], devs, 1, 1, estimate=100)
    sim.drive(c, 0, slow_then_fast(), 7000)
    testing.assertEqual(sim.started(c).get("x"), (("w", 0, 7000), 4770))


def _test_a_device_without_a_promise_that_a_free_slot_passed_starts_when_it_fits():
    """Two at a time, a window [0, 7000), and a campaign estimate of 100 s.
    x, of 2000 s, comes first. The run starts at a pace of 300 s, so x
    needs one and a half times 6000 s, 9000 s, and no plan promises it.
    f0 to f48, of 100 s, run in pairs that take 90 s and 80 s in turn, so
    each ends at a time other than expected, and its time counts. When
    f46 and f47 count, at 2040, two of the last 50 times are still the
    300 s that the run started from, and the slow time is 300 s: f48
    takes one slot, and the window looks at x for the other, but x does
    not fit. When f48 counts, at 2130, the slow time falls to 90 s, the
    second longest of the last 50 times. The window looks at x again, x
    needs 2700 s of the 4870 s left, and x starts."""
    devs = [("x", 2000, "w")] + [("f{i}", 100, "w") for i in range(49)]
    took: dict[str, int] = {}
    for i in range(49):
        took["f{i}"] = 90 if (i // 2) % 2 == 0 else 80
    c = Controller()
    c.configure([("w", 0, 7000)], devs, 2, 2, False, 0, 100)
    sim.answer_all(c, 0)
    c.start(2, 300)
    testing.assertEqual(sim.planned(c, c.plan(0)).get("x"), None)
    sim.drive(c, 0, took, 7000)
    testing.assertEqual(sim.started(c).get("x"), (("w", 0, 7000), 2130))


def _test_a_plan_keeps_the_window_a_promise_moves_to():
    """a runs late, so x misses the first window and its promise moves to
    the second, where y is promised. One at a time, x keeps the second
    window and y moves on to the third; two at once start both in the
    second, so the plan runs at two as soon as a is late, at 121: a fifth
    of its upgrade after its expected end, 100, has passed. At 120 the
    plan still runs at one. In the run, a's 201 s leave room in the
    second window, of 320 s, for x only: x needs one and a half times
    201 s, and y 603 s."""
    wins = [("s", 0, 300), ("s", 1000, 1320), ("s", 2000, 2300)]
    devs = [("a", 100, "s"), ("y", 200, "s"), ("x", 100, "s")]
    c = controller(wins, devs, 1, 2, estimate=100)
    c.decide(0)
    testing.assertEqual(c.plan(120).c, 1)
    p = c.decide(121).plan
    testing.assertEqual(p.c, 2)
    testing.assertEqual(sim.planned(c, p).get("x"), (wins[1], 1000))
    c.report("a", "succeeded", 201)
    sim.drive(c, 201, {}, 2000)
    testing.assertEqual(sim.started(c).get("x"), (wins[1], 1000))


def _test_a_member_done_before_its_release_asks_for_no_decision():
    """d0 reported up-to-date before its release, so it is done at once,
    and no decision waits for it: the decision at 10 starts d1, and wakes
    when d1's report is expected to count."""
    c = open_window(2, 1, 1)
    c.report("d0", "up-to-date", 0)
    s = c.decide(10)
    testing.assertEqual((s.started, s.wake), (["d1"], 610))
    testing.assertEqual(sim.planned(c, s.plan), {"d1": (("w", 0, fleet_ctl.OPEN_END), 10)})


def _test_reconfigure_keeps_the_order_of_a_moved_promise():
    """x is promised the first window ahead of y, and misses it. The
    campaign actor configures the controller again when the window has
    closed, without that window; x still goes first in the next one."""
    wins = [("s", 0, 25), ("s", 60, fleet_ctl.OPEN_END)]
    devs = [("a", 10, "s"), ("x", 10, "s"), ("y", 10, "s")]
    c = controller(wins, devs, 1, 1, estimate=10)
    sim.drive(c, 0, {"a": 20}, 24)
    c.configure(wins[1:], devs, 1, 1, False, 0, 10)
    p = c.plan(25)
    testing.assertEqual(sim.planned(c, p), {"x": (wins[1], 60), "y": (wins[1], 80)})


def _test_a_promise_ends_when_the_device_changes_schedule():
    """d1 is promised the window of schedule a. Bound to schedule b, it
    starts in b's window."""
    wins = [("a", 0, 3000), ("b", 4000, 5000)]
    c = controller(wins, [("d0", 600, "a"), ("d1", 600, "a")], 1, 1)
    c.decide(0)
    testing.assertEqual(c.promised_window("d1"), wins[0])
    c.configure(wins, [("d0", 600, "a"), ("d1", 600, "b")], 1, 1, False, 0, 600)
    p = c.plan(10)
    testing.assertEqual(sim.planned(c, p), {"d1": (wins[1], 4000)})


def _test_a_window_edit_keeps_the_promises():
    """d0 to d14 of 600 s in a 1 h window at 06:00 on three days, one at
    a time: the decision at 0 promises d0 to d4 day 1's window, d5 to d9
    day 2's and d10 to d14 day 3's. An edit of the windows before they
    open moves each promise to the window whose opening is nearest its
    own, so a window moved by less than half a day keeps its promises on
    their day. A utc-offset of +60 min is the
    window an hour earlier. A shorter window keeps the promises that it
    can no longer keep, and the plan gives an alarm. A shift of 12 h puts
    day 2's and day 3's windows as near the evening before as their own
    evening: the later one keeps them on their day. When a day's window
    is gone, its promises go to the nearest window that is left, the
    later of two as near: day 1's to day 2, day 2's to day 3, and day 3's,
    which a deadline cuts off, to day 2."""
    wins = daily("w", 6 * HOUR, HOUR, 3)
    cut = ("w", 2 * DAY + 6 * HOUR, 2 * DAY + 6 * HOUR + 1800)
    # (case, the windows after the edit, the windows of day 1's, day 2's
    # and day 3's members after it)
    cases: list[(str, list[(str, int, int)], list[(str, int, int)])] = [
        ("an hour later", daily("w", 7 * HOUR, HOUR, 3), daily("w", 7 * HOUR, HOUR, 3)),
        ("an hour earlier, utc-offset +60 min", daily("w", 5 * HOUR, HOUR, 3),
         daily("w", 5 * HOUR, HOUR, 3)),
        ("half an hour earlier", daily("w", 5 * HOUR + 1800, HOUR, 3),
         daily("w", 5 * HOUR + 1800, HOUR, 3)),
        ("longer", daily("w", 6 * HOUR, 2 * HOUR, 3), daily("w", 6 * HOUR, 2 * HOUR, 3)),
        ("shorter", daily("w", 6 * HOUR, 1800, 3), daily("w", 6 * HOUR, 1800, 3)),
        ("12 h later", daily("w", 18 * HOUR, HOUR, 3), daily("w", 18 * HOUR, HOUR, 3)),
        ("a deadline in day 3's window", [wins[0], wins[1], cut], [wins[0], wins[1], cut]),
        ("a deadline before day 3", [wins[0], wins[1]], [wins[0], wins[1], wins[1]]),
        ("the notice leaves out day 1", [wins[1], wins[2]], [wins[1], wins[1], wins[2]]),
        ("day 2 gone", [wins[0], wins[2]], [wins[0], wins[2], wins[2]]),
    ]
    devs = devices("d", 15, 600, "w")
    for case in cases:
        c = controller(wins, devs, 1, 1)
        c.decide(0)
        for i in range(15):
            testing.assertEqual(c.promised_window("d{i}"), wins[i // 5], "{case.0}: before")
        edit(c, case.1, devs)
        c.decide(1)
        for i in range(15):
            testing.assertEqual(c.promised_window("d{i}"), case.2[i // 5], "{case.0}: d{i}")


def _test_an_edit_gives_a_held_member_no_lost_window_alarm():
    """The windows and members of _test_a_window_edit_keeps_the_promises.
    d7, promised day 2's window, is held by a veto of another holder, and
    the window moves an hour later. d7's promise moves to day 2's 07:00
    window, so it lost no window, and the plan says nothing of the kind.
    When that window closes with d7 still held, d7 lost it, and the plan
    says so."""
    wins = daily("w", 6 * HOUR, HOUR, 3)
    new = daily("w", 7 * HOUR, HOUR, 3)
    devs = devices("d", 15, 600, "w")
    c = controller(wins, devs, 1, 1)
    c.decide(0)
    c.set_vetoed("d7", "health")
    edit(c, new, devs)
    p = c.decide(1).plan
    testing.assertEqual(c.promised_window("d7"), new[1])
    testing.assertEqual([a for a in p.alarms if "lost their promised window" in a], [])
    q = c.plan(new[1].2)
    testing.assertEqual([a for a in q.alarms if "lost their promised window" in a],
                        ["1 device(s) lost their promised window while held: d7"])


def _test_a_broken_promise_keeps_its_row():
    """d0 to d3 of 600 s in a window [10150, 13750), one at a time, with
    prepare: the decision at 0 promises each of them the window. d3's
    estimate then grows to 3000 s, and one and a half times that is
    longer than the window, so the run ahead starts d3 in no window. The
    plan keeps d3 in the window promised to it, at the window's opening,
    with its turn to prepare, and its alarms name d3. d3 is not held: it
    has no reason."""
    win = ("w", 10150, 10150 + HOUR)
    devs = devices("d", 4, 600, "w")
    c = controller([win], devs, 1, 1, prepare=True)
    c.decide(0)
    edit(c, [win], devs[:3] + [("d3", 3000, "w")])
    s = c.decide(1)
    p = s.plan
    testing.assertEqual((p.held, p.why), ({"d3": (0, 10150)}, {}))
    testing.assertEqual(c.layout(p), [(win.0, win.1, win.2, [("d0", 10150, 600),
                                                          ("d3", 10150, 3000),
                                                          ("d1", 10750, 600),
                                                          ("d2", 11350, 600)])])
    testing.assertEqual(s.prepares.starts, {"d0": 0, "d1": 3333, "d2": 6666, "d3": 10000})
    testing.assertEqual(p.alarms, [
        "1 device(s) will miss the window they were promised even at max-concurrency 1: d3",
        "1 device(s) fit in no window: 150 percent of their slow time, 600 s at the "
        + "campaign's estimate, is longer than the time left in every window of their "
        + "schedule: d3"])


def _test_a_removed_device_does_not_count_for_the_ramp():
    """d0 and d1 are in flight at a ramp of two when d0 leaves the
    campaign. Its report does not count towards the ramp, so the run
    starts the rest where the plan said."""
    c = open_window(6, 4, 4)
    c.start(2)
    c.decide(0)
    c.configure([("w", 0, fleet_ctl.OPEN_END)], devices("d", 6, 600, "w")[1:], 4, 4,
                False, 0, 600)
    p = c.plan(10)
    sim.drive(c, 10, {}, DAY, [(600, "d0"), (600, "d1")])
    starts = sim.started(c)
    testing.assertEqual({k: starts[k] for k in sim.planned(c, p).keys()}, sim.planned(c, p))


def _test_a_removed_device_frees_its_slot():
    """One device at a time: d0 is in flight. Removed from the campaign,
    it holds no slot, and d1 starts."""
    c = open_window(2, 1, 1)
    testing.assertEqual(c.decide(0).started, ["d0"])
    c.configure([("w", 0, fleet_ctl.OPEN_END)], [("d1", 600, "w")], 1, 1, False, 0, 600)
    testing.assertEqual(c.decide(10).started, ["d1"])


def _test_concurrency_counts_the_whole_campaign():
    """Two schedules whose windows overlap share the concurrency: at two
    at once, two devices start in all, one in each window."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 2, 2)
    c.start(2)
    testing.assertEqual(c.decide(0).started, ["a0", "b0"])


def _test_open_windows_share_the_slots():
    """Two windows that never close, with the same upgrade time waiting,
    take two of four slots each. Five slots give the fifth to the window
    that opened first."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "b0", "b1"])
    c = controller(wins, devs, 5, 5, rung=5)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "a2", "b0", "b1"])


def _test_a_window_that_opens_while_another_runs_gets_the_free_slots():
    """Window b opens at 100 while the devices of window a hold both
    slots. The slot a0 frees goes to b, which has no device in flight,
    though a opened first and has devices waiting. The slot a1 frees goes
    to a, which then has none in flight and b one."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 100, fleet_ctl.OPEN_END)]
    devs = devices("a", 4, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(0).started, ["a0", "a1"])
    testing.assertEqual(c.decide(100).started, [])
    c.report("a0", "succeeded", 600)
    testing.assertEqual(c.decide(600).started, ["b0"])
    c.report("a1", "succeeded", 650)
    testing.assertEqual(c.decide(650).started, ["a2"])


def _test_a_window_with_nothing_to_start_passes_its_turn():
    """Window a closes before its devices could end, so the other open
    window takes every slot."""
    wins = [("a", 0, 500), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 2, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(0).started, ["b0", "b1"])


def _test_shares():
    """The slots go one at a time, each to the window whose devices in
    flight plus a half, times its weight, are the fewest, the first window
    on a tie: each share is rounded to the nearest slot."""
    # (devices in flight, weights, slots, shares)
    cases = [
        ([0, 0], [1, 1], 4, [2, 2]),
        ([0, 0], [1, 1], 3, [2, 1]),
        ([3, 0], [1, 1], 2, [0, 2]),
        ([3, 0], [1, 1], 5, [1, 4]),
        ([0, 3], [1, 1], 5, [4, 1]),
        ([1, 1, 1], [1, 1, 1], 2, [1, 1, 0]),
        ([5, 0], [1, 1], 0, [0, 0]),
        ([0], [1], 7, [7]),
        ([0, 0], [1, 2], 3, [2, 1]),
        # Shares of 3.33 and 0.67 round to 3 and 1.
        ([0, 0], [1, 5], 4, [3, 1]),
        ([2, 0], [1, 3], 4, [3, 1]),
        ([0, 0], [1000, fleet_ctl.NO_SHARE], 3, [3, 0]),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.shares(case.0, case.1, case.2), case.3,
                            "shares of {case.2} for {case.0} at weights {case.1}")


def _test_an_open_window_that_changes_keeps_its_devices_in_flight():
    """Windows a and b grow from two hours to three while a0 and b0 run.
    a0 still counts for a, so the slot b0 frees goes to b."""
    devs = devices("a", 4, 600, "a") + devices("b", 4, 600, "b")
    c = controller([("a", 0, 2 * HOUR), ("b", 0, 2 * HOUR)], devs, 2, 2, rung=2)
    testing.assertEqual(c.decide(0).started, ["a0", "b0"])
    c.configure([("a", 0, 3 * HOUR), ("b", 0, 3 * HOUR)], devs, 2, 2, False, 0, 600)
    c.report("b0", "succeeded", 400)
    testing.assertEqual(c.decide(400).started, ["b1"])


def _test_window_needs():
    """A schedule needs the upgrade time it must start before the first
    last start. The time after a last start goes to the schedules that
    can still start devices then, in proportion to their upgrade time
    left, c devices at once."""
    # (waiting upgrade time, last starts, now, concurrency, needs)
    cases = [
        ([1000], [500], 0, 4, [1000]),
        # One hour after eu's last start at 111 at once starts 399600 s of
        # uk's 600000.
        ([1200000, 600000], [13800, 17400], 3600, 111, [1200000, 200400]),
        # The time of its own holds all of the later schedule's upgrade time.
        ([100, 50], [1000, 2000], 0, 1, [100, 0]),
        # The last 100 s go to the third schedule alone; the 100 s before
        # them to the second and third, 3 to 2.
        ([300, 300, 300], [100, 200, 300], 0, 1, [300, 240, 160]),
        ([600, 300], [1000, 1000], 0, 4, [600, 300]),
        # Windows that never close have no time of their own.
        ([3600, 7200], [fleet_ctl.OPEN_END, fleet_ctl.OPEN_END], 0, 4, [3600, 7200]),
        # A last start that has passed counts from now.
        ([100, 100], [-5, 50], 10, 2, [100, 22]),
        # 30 days at 1000 at once start 2.592e9 s of 3.6e9: past 64 bits
        # in between.
        ([10, 3600000000], [10, 2592010], 0, 1000, [10, 1008000000]),
    ]
    for case in cases:
        testing.assertEqual(fleet_ctl.window_needs(case.0, case.1, case.2, case.3), case.4,
                            "needs of {case.0} at last starts {case.1}")

def _test_a_window_with_time_of_its_own_leaves_the_slots_to_the_other():
    """Window a closes at 2 h with ten devices of 600 s, b at 3 h with two.
    b can start its two in the hour after a's last start, so a takes all
    four slots."""
    wins = [("a", 0, 2 * HOUR), ("b", 0, 3 * HOUR)]
    devs = devices("a", 10, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "a2", "a3"])


def _test_windows_that_close_together_share_by_their_waiting_upgrade_time():
    """Six devices wait in a and two in b, all of 600 s: a takes three of
    four slots."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 6, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["a0", "a1", "a2", "b0"])


def _test_windows_that_never_close_share_by_their_waiting_upgrade_time():
    """a waits 3600 s in six devices of 600 s, b 7200 s in six of 1200 s,
    both in windows that never close: b takes three of four slots,
    whatever the lengths of their devices."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 6, 600, "a") + devices("b", 6, 1200, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(0).started, ["b0", "b1", "b2", "a0"])


def _test_a_window_that_needs_no_slot_leaves_it_to_one_that_does():
    """a holds 20 devices of 20 s in flight and closes at 45; its last
    start is at 15. b never closes and needs nothing now. The slot a0
    frees at 5 goes to a's last device, not to b."""
    wins = [("a", 0, 45), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 21, 20, "a") + devices("b", 5, 20, "b")
    c = controller(wins, devs, 20, 20, rung=20)
    testing.assertEqual(len(c.decide(0).started), 20)
    c.report("a0", "succeeded", 5)
    testing.assertEqual(c.decide(5).started, ["a20"])


def _test_overlapping_windows_of_one_schedule_take_one_share():
    """Schedule a has two windows open, b one, all never closing, with
    four devices of 600 s on each schedule: a and b take two of four
    slots each, a in its window that opened first."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("a", 100, fleet_ctl.OPEN_END),
            ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 4, 600, "a") + devices("b", 4, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4)
    testing.assertEqual(c.decide(100).started, ["a0", "a1", "b0", "b1"])


def _test_nothing_starts_before_the_turn_of_a_held_start():
    """a and b never close, three devices of 600 s each, four at once,
    staggered over a whole upgrade: 150 s from one start to the next. At
    0, a0 starts and a1 waits for its turn at 150. A decision at 50 starts
    nothing, as the plan of 0 said: that plan starts b0 at 150."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 3, 600, "a") + devices("b", 3, 600, "b")
    c = controller(wins, devs, 4, 4, rung=4, stagger=100)
    s = c.decide(0)
    testing.assertEqual(s.started, ["a0"])
    testing.assertEqual(s.plan.starts["b0"].1, 150)
    testing.assertEqual(c.decide(50).started, [])
    testing.assertEqual(c.decide(150).started, ["b0"])


def _test_a_short_window_next_to_a_long_one_starts_all_its_devices():
    """200 devices of 30 s in a daily 20 minute window and 20 of 1800 s in
    a daily 4 h window, both at midnight, 10 at once: the long window's
    devices fit after the short one closes, so the short window starts all
    200 the first night."""
    wins = daily("fast", 0, 1200, 3) + daily("slow", 0, 4 * HOUR, 3)
    devs = devices("f", 200, 30, "fast") + devices("s", 20, 1800, "slow")
    c = controller(wins, devs, 10, 20, debounce=1, estimate=191, stagger=25)
    sizes = [(w.0, w.1, len(w.3)) for w in c.layout(c.plan(0))]
    testing.assertEqual(sizes, [("fast", 0, 200), ("slow", 0, 20)])


def _test_a_window_whose_devices_all_started_sets_no_wake():
    """Two overlapping windows of one schedule. Both devices start in the
    first, so the opening of the second at 300 is no reason to decide: the
    next decision is when the upgrades are expected to end."""
    c = controller([("a", 0, HOUR), ("a", 300, 300 + HOUR)], devices("a", 2, 600, "a"), 2, 2,
                   rung=2)
    s = c.decide(0)
    testing.assertEqual(s.started, ["a0", "a1"])
    testing.assertEqual(s.wake, 600)


def _test_the_stagger_takes_turns_between_open_windows():
    """Two windows open at 0, two devices of 600 s at a time, staggered
    over a whole upgrade: a start every 300 s. The next start goes to the
    window with the fewest devices in flight."""
    wins = [("a", 0, fleet_ctl.OPEN_END), ("b", 0, fleet_ctl.OPEN_END)]
    devs = devices("a", 2, 600, "a") + devices("b", 2, 600, "b")
    c = controller(wins, devs, 2, 2, rung=2, stagger=100)
    testing.assertEqual(c.decide(0).started, ["a0"])
    testing.assertEqual(c.decide(300).started, ["b0"])


def _test_new_limits_keep_the_concurrency_within_them():
    """RISEN runs at 14 at 1000, and would keep its promises at 6. A
    higher max, or a target up to 14, keeps 14 and the ramp. A target
    above 14 raises the next plan to it, and a max below 14 caps it. A
    lower target starts the concurrency over at the target, the ramp at
    most at the target, and the next plan rises to what the promises
    need. A higher max keeps every start of the plan, and a max below the
    concurrency caps the plan, so the starts move; a new target takes the
    pace from the same upgrade times again, so the starts move."""
    # (case, the new target, the new max, the concurrency and the ramp
    # after the change, the concurrency of the next plan, whether its
    # starts stay)
    cases: list[(str, int, int, int, int, int, bool)] = [
        ("max 20 to 30", 10, 30, 14, 20, 14, True),
        ("target 10 to 12", 12, 20, 14, 20, 14, False),
        ("target 10 to 16", 16, 20, 14, 20, 16, False),
        ("max 20 to 12", 10, 12, 14, 20, 12, False),
        ("target 10 to 5", 5, 20, 5, 5, 6, False),
    ]
    for case in cases:
        c = risen()
        p = c.plan(1000)
        testing.assertEqual(p.c, 14, case.0)
        c.configure([("w", 0, HOUR)], devices("d", 70, 600, "w"), case.1, case.2, True, 0, 600)
        r = (c.c, c.rung)
        q = c.plan(1000)
        testing.assertEqual((r.0, r.1, q.c, p.starts == q.starts),
                            (case.3, case.4, case.5, case.6), case.0)


def risen() -> Controller:
    """RISEN: d0 to d69 of 600 s, which must start in a window [0, 3600),
    ten at once and at most 20, the ramp at 20. 50 fit at ten at once, so
    the run goes at 14. d0 to d27 take 300 s. Run until 1000."""
    c = Controller()
    c.configure([("w", 0, HOUR)], devices("d", 70, 600, "w"), 10, 20, True, 0, 600)
    sim.answer_all(c, 0)
    c.start(20)
    sim.drive(c, 0, {"d{i}": 300 for i in range(28)}, 1000)
    return c


def _test_finished_when_every_device_is_done():
    """The run is finished at the decision that sees the last device
    done."""
    c = open_window(2, 2, 2)
    c.decide(0)
    c.report("d0", "succeeded", 600)
    s = c.decide(600)
    testing.assertEqual(s.started, ["d1"])
    testing.assertEqual(s.finished, False)
    c.report("d1", "succeeded", 1200)
    testing.assertEqual(c.decide(1200).finished, True)


def paused(hold: bool, budget: int, failing: list[str], pause: int) -> Controller:
    """PAUSED: d0 to d9 of 600 s in a 1 h window at 06:00 on three days,
    two at a time and at most four, each prepare 100 s, with a debounce of
    1 s. d8 and d9 pack with a min-separation of 1 h, d8 first; with hold,
    their group holds on a failure. budget is the failure budget. The run
    goes until pause and stops there: each device that starts reports
    in-progress, and succeeded, or failed for the devices in failing, when
    its upgrade ends, and each member let prepare reports its prepare
    running and then done. Run so without a pause, d0 starts at 21600,
    then two devices every 601 s from 22201 to 24004, and d9 on the second
    day, an hour after d8 is done. The members are let prepare every
    2383 s from 0, d0 first, until their deadline at 21450."""
    c = controller(daily("w", 6 * HOUR, HOUR, 3), devices("d", 10, 600, "w"), 2, 4, debounce=1,
                   groups={"g": ["d8", "d9"]}, priority={"d8": 1, "d9": 2},
                   separation={"g": (False, HOUR)}, prepare=True, failure_budget=budget,
                   hold_failed={"g"} if hold else set())
    sim.drive(c, 0, {}, pause, prepare_reports=True, failing=failing, in_progress=True)
    c.stop()
    return c


def _test_a_pause_keeps_the_run():
    """PAUSED stops at P, the reports in the pause come, and the run
    starts again at R, as a campaign set to plan and back to run does. The
    run carries on: the released devices keep their start, their window
    and their done time, the ramp, the concurrency, the pace, the slow
    time and the last turn to prepare stay, and each member keeps the
    time it was let prepare. A released device that did not start its
    run, because its in-progress report never came or it stopped before
    its install, waits again in the window it was released in, before the
    devices promised that window after it. A device that finished in the
    pause keeps its slot until the decision at R counts its report. The
    devices in flight keep their slot also when their window closes in
    the pause, and the promises of a window that closed move to the next
    window, first in it: d8 then goes a day later, and d9, an hour after
    it, misses its window. A failure keeps holding its group and counts
    against the budget, and d9 waits an hour from d8's success, not from
    R. The members let prepare that have not prepared are let again,
    until their window opens, and one that reports no prepare yet counts
    as preparing from R. The plan of a copy that goes on at R, as a
    campaign in plan shows it, is the plan and the prepares of the run at
    R. The turns
    to prepare stay when the run goes on before the next turn; after it,
    the next member goes at once and the rest spread from R."""
    no_failing: list[str] = []
    none: dict[str, int] = {}
    # (case, (hold, budget, failing), (P, R), the reports in the pause as
    # (time, device, status), where "no prepare" says that the device
    # reports no prepare, the devices taken back, the devices that start at
    # R, the alarms at R, the members let prepare at R after the revoke,
    # (the day of the window promised to devices after R, the time from
    # which devices may start, the turns to prepare of the waiting members
    # at R, and how many members prepare at once then, or -1 when not
    # checked))
    cases: list[(str, (bool, int, list[str]), (int, int), list[(int, str, str)], list[str],
                 list[str], list[str], list[str],
                 (dict[str, int], dict[str, int], dict[str, int], int))] = [
        ("zero-length", (False, -1, no_failing), (22500, 22500), [], [], [], [], [],
         ({"d3": 0, "d9": 1}, none, none, -1)),
        ("d0 done", (False, -1, no_failing), (22300, 22400), [], [], [], [], [],
         ({"d3": 0}, none, none, -1)),
        ("d2 finishes", (False, -1, no_failing), (22500, 23000), [(22700, "d2", "succeeded")],
         [], ["d3", "d4"], [], [], ({"d5": 0}, none, none, -1)),
        ("d2 stops", (False, -1, no_failing), (22500, 23000), [(22600, "d2", "upgrade-needed")],
         ["d2"], ["d2"], [], [], ({"d3": 0}, none, none, -1)),
        ("d3 has no report", (False, -1, no_failing), (22802, 22900),
         [(22802, "d3", "upgrade-needed")], ["d3"], ["d3"], [], [], ({"d5": 0}, none, none, -1)),
        ("the window closes", (False, -1, no_failing), (23500, 25300), [], [], [],
         ["1 device(s) will miss the window they were promised: d9"], [],
         ({"d7": 1, "d8": 1, "d9": 1}, none, none, -1)),
        ("d8 fails, hold", (True, -1, ["d8"]), (24700, 25000), [], [], [],
         ["1 device(s) wait behind a failed redundancy group member: d9"], [],
         (none, none, none, -1)),
        ("over the budget", (False, 0, ["d1"]), (23000, 23100), [], [], [],
         [budget_alarm(1, 0)], [], (none, none, none, -1)),
        ("d8, then d9 an hour later", (False, -1, no_failing), (24664, 24724), [], [], [], [],
         [], ({"d9": 1}, {"d9": 24604 + HOUR}, none, -1)),
        ("d5 prepared", (False, -1, no_failing), (12100, 12200), [], [], [], [], [],
         (none, none, none, -1)),
        ("d6 prepares", (False, -1, no_failing), (14350, 14360), [], [], [], [], ["d6"],
         (none, none, none, -1)),
        ("d6 no prepare report", (False, -1, no_failing), (14299, 14310),
         [(14299, "d6", "no prepare")], [], [], [], ["d6"], (none, none, none, -1)),
        ("d6 no prepare report, at d7's turn", (False, -1, no_failing), (14299, 16683),
         [(14299, "d6", "no prepare")], [], [], [], ["d6"],
         (none, none, {"d7": 16683, "d8": 19066, "d9": 21450}, 2)),
        ("d6 no prepare report, in its window", (False, -1, no_failing), (14299, 21700),
         [(14299, "d6", "no prepare")], [], ["d0"], [], [], (none, none, none, 0)),
        ("shorter than a turn", (False, -1, no_failing), (10000, 11000), [], [], [], [], [],
         (none, none, {"d5": 11916, "d6": 14299, "d7": 16683, "d8": 19066, "d9": 21450}, -1)),
        ("longer than a turn", (False, -1, no_failing), (10000, 13000), [], [], [], [], [],
         (none, none, {"d5": 13000, "d6": 15112, "d7": 17225, "d8": 19337, "d9": 21450}, -1)),
    ]
    wins = daily("w", 6 * HOUR, HOUR, 3)
    for case in cases:
        label = case.0
        r = case.2.1
        c = paused(case.1.0, case.1.1, case.1.2, case.2.0)
        times = c.release_times()
        windows = c.release_windows()
        done = c.done_times()
        failed = c.failed_devices()
        let = {name: at for name, at in c.prepare_at.items()}
        kept = (c.rung, c.c, c.observed_s, c.slow_s, c.prep_last)
        for e in case.3:
            if e.2 == "no prepare":
                c.report_prepare(e.1, None)
            else:
                c.report(e.1, e.2, e.0)
        x = c.carried_on(r)
        shown = x.plan(r)
        shown_prepares = x.prepares(r)
        c.start()
        c.revoke_prepares(r)
        testing.assertEqual((c.rung, c.c, c.observed_s, c.slow_s, c.prep_last), kept, label)
        testing.assertEqual(c.prepare_at, let, label)
        testing.assertEqual(sorted(list(c.allowed)), case.7, label)
        testing.assertEqual(c.release_times(),
                            {n: at for n, at in times.items() if n not in case.4}, label)
        testing.assertEqual(c.release_windows(),
                            {n: w for n, w in windows.items() if n not in case.4}, label)
        testing.assertEqual((c.done_times(), c.failed_devices()), (done, failed), label)
        for name in case.4:
            testing.assertEqual(c.promised_window(name), windows.get(name),
                                "{label}: {name} taken back")
        prepares = c.prepares(r)
        if len(case.8.2) > 0:
            testing.assertEqual({n: at for n, at in prepares.starts.items() if n not in let},
                                case.8.2, label)
        if case.8.3 >= 0:
            testing.assertEqual(prepares.c, case.8.3, label)
        released = c.released_devices()
        s = c.decide(r)
        testing.assertEqual((s.plan.c, s.plan.starts, s.plan.held, s.plan.alarms),
                            (shown.c, shown.starts, shown.held, shown.alarms), label)
        testing.assertEqual((s.prepares.starts, s.prepares.c),
                            (shown_prepares.starts, shown_prepares.c), label)
        testing.assertEqual(s.started, case.5, label)
        testing.assertEqual(s.plan.alarms, case.6, label)
        testing.assertEqual([n for n in released if n in s.plan.starts or n in s.plan.held], [],
                            label)
        for name, day in case.8.0.items():
            testing.assertEqual(c.promised_window(name), wins[day], "{label}: {name}")
        for name, at in case.8.1.items():
            testing.assertEqual(c.gate(c.known(name)), at, "{label}: {name}")


def carries_on(c: Controller, pause: int, resume: int, label: str) -> None:
    """Run c on the expected durations until pause, each device that
    starts reporting in-progress, and each member let prepare its
    prepare, and stop it there. The devices in flight whose upgrade ends
    by resume report then, in the pause; the others are still in flight
    at resume. A copy of c that starts at resume and stops letting
    prepare the members that may no longer prepare, as a campaign in plan
    shows it, plans what the run decides when it starts at resume: the
    same plan and prepares. When that plan has no alarm, each device that
    the run starts from resume on starts where and when it said."""
    sim.drive(c, 0, {}, pause, prepare_reports=True, in_progress=True)
    c.stop()
    times = c.release_times()
    inflight: list[(int, str)] = []
    for name in sorted(list(c.flying_devices())):
        end = times[name] + c.est[name]
        if end <= resume:
            c.report(name, "succeeded", end)
        else:
            inflight.append((end, name))
    x = c.carried_on(resume)
    p = x.plan(resume)
    q = x.prepares(resume)
    c.start()
    c.revoke_prepares(resume)
    ds = sim.drive(c, resume, {}, 30 * DAY, inflight=inflight, in_progress=True)
    s = ds[0]
    testing.assertEqual((s.plan.c, s.plan.starts, s.plan.held, s.plan.why, s.plan.alarms),
                        (p.c, p.starts, p.held, p.why, p.alarms), label)
    testing.assertEqual((s.prepares.starts, s.prepares.c, s.prepares.alarms),
                        (q.starts, q.c, q.alarms), label)
    if len(p.alarms) == 0:
        planned = sim.planned(c, p)
        started = sim.started(c)
        testing.assertEqual({n: started[n] for n in planned.keys() if n in started}, planned,
                            label)
        testing.assertEqual([n for n in planned.keys() if n not in started], [], label)


def plan_in_a_pause(lo: int, hi: int, pause_lo: int=0, pause_hi: int=4) -> None:
    """The campaigns of the plan-is-the-run tests from the place lo to the
    place hi, with prepare on, pause in the middle of their first window for
    no time, for 600 s and for a day, and in its last second until after it
    closes; of these four pauses, those from the place pause_lo to the place
    pause_hi. The plan of a copy that starts at the end of the pause is the
    plan and the prepares of the run that starts then, and, without an
    alarm, the run that follows."""
    groups, priority = pairs(40)
    spread = {g: (True, 600) for g in groups.keys()}
    chain_groups = {"a": ["d0", "d1", "d2"], "b": ["d2", "d3"], "c": ["d5", "d4"]}
    chain_priority = {"d0": 1, "d1": 2, "d2": 3, "d3": 4, "d5": 1, "d4": 2}
    chain_separation = {"a": (True, 0), "b": (True, 0)}
    no_groups: dict[str, list[str]] = {}
    no_priority: dict[str, int] = {}
    no_separation: dict[str, (bool, int)] = {}
    # (case, windows, devices, target, max, whether every device must start
    # in a window, estimate, groups, priorities, separations, close margin,
    # stagger)
    cases: list[(str, list[(str, int, int)], list[(str, int, str)], int, int, bool, int,
                 dict[str, list[str]], dict[str, int], dict[str, (bool, int)], int, int)] = [
        ("uniform", daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False, 600,
         no_groups, no_priority, no_separation, fleet_ctl.CLOSE_MARGIN, 0),
        ("close margin 200", daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10,
         False, 600, no_groups, no_priority, no_separation, 200, 0),
        ("stagger", daily("day", 0, HOUR, 9), devices("d", 100, 600, "day"), 10, 10, False, 600,
         no_groups, no_priority, no_separation, fleet_ctl.CLOSE_MARGIN, 100),
        ("overlapping", overlapping(9), overlapping_devices(), 5, 10, False, 600, no_groups,
         no_priority, no_separation, fleet_ctl.CLOSE_MARGIN, 0),
        ("mixed", daily("night", 2 * HOUR, 1800, 9),
         devices("real", 10, 395, "night") + devices("sim", 100, 4, "night"), 1, 1, False, 40,
         no_groups, no_priority, no_separation, fleet_ctl.CLOSE_MARGIN, 0),
        ("two schedules", [("night", 0, HOUR), ("weekend", 2 * HOUR, 3 * HOUR)],
         devices("n", 5, 8, "night") + devices("w", 5, 8, "weekend"), 8, 16, False, 8,
         no_groups, no_priority, no_separation, fleet_ctl.CLOSE_MARGIN, 0),
        ("deadline", daily("day", 0, HOUR, 2), devices("d", 100, 600, "day"), 10, 50, True, 600,
         no_groups, no_priority, no_separation, fleet_ctl.CLOSE_MARGIN, 0),
        ("pairs", daily("day", 0, HOUR, 9), devices("d", 40, 600, "day"), 10, 10, False, 600,
         groups, priority, no_separation, fleet_ctl.CLOSE_MARGIN, 0),
        ("spread pairs", daily("day", 0, HOUR, 9),
         devices("d", 40, 600, "day") + devices("e", 60, 600, "day"), 10, 10, False, 600,
         groups, priority, spread, fleet_ctl.CLOSE_MARGIN, 0),
        ("chains", daily("day", 0, HOUR, 2), devices("d", 20, 600, "day"), 4, 8, True, 600,
         chain_groups, chain_priority, chain_separation, fleet_ctl.CLOSE_MARGIN, 0),
    ]
    for case in cases[lo:hi]:
        first = sorted([(w.1, w.2) for w in case.1])[0]
        mid = first.0 + (first.1 - first.0) // 2
        # (the pause, the run again)
        pauses: list[(int, int)] = [
            (mid, mid),
            (mid, mid + 600),
            (mid, mid + DAY),
            (first.1 - 1, first.1 + 100),
        ]
        for pause in pauses[pause_lo:pause_hi]:
            c = controller(case.1, case.2, case.3, case.4, case.5, 1, case.6, case.7, case.8,
                           case.9, close_margin=case.10, stagger=case.11, prepare=True)
            carries_on(c, pause.0, pause.1, "{case.0}, pause {pause.0} to {pause.1}")


def _test_the_plan_in_a_pause_is_the_run_that_carries_on():
    """plan_in_a_pause() for uniform and close margin 200."""
    plan_in_a_pause(0, 2)


def _test_the_plan_in_a_pause_is_the_run_that_carries_on_at_a_stagger():
    """plan_in_a_pause() for stagger."""
    plan_in_a_pause(2, 3)


def _test_the_plan_in_a_pause_is_the_run_that_carries_on_overlapping_windows():
    """plan_in_a_pause() for overlapping."""
    plan_in_a_pause(3, 4)


def _test_the_plan_in_a_pause_is_the_run_that_carries_on_mixed_in_the_first_window():
    """plan_in_a_pause() for mixed, with the pauses that end in its first
    window."""
    plan_in_a_pause(4, 5, 0, 2)


def _test_the_plan_in_a_pause_is_the_run_that_carries_on_mixed_after_the_first_window():
    """plan_in_a_pause() for mixed, with the pauses that end after its first
    window."""
