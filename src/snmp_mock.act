"""In-process SNMP device mock using the actsnmp command responder.

Telemetry is explicitly seeded and changed by the scenario. The upstream
agent also supplies its own sysUpTime.0 and snmpEngineID.0 management objects.
A MemNet transport gives the normal SNMP client the same encoded request and
response path without requiring socket capabilities in a mini-system test.
"""

import logging
import snmp.agent as agent
import snmp.mibview as mibview
import snmp.oid as oid
import snmp.transport as transport_mod
import snmp.values as values


ADDRESS = "127.0.0.1"
PORT = 161


actor SnmpMockServer(community: str="public", bindings: list[values.VarBind]=[],
                     log_handler: ?logging.Handler=None,
                     server_transport: ?transport_mod.ServerTransport=None):
    """Serve seeded read-only SNMP data over MemNet or a supplied UDP transport.

    transport creates a fresh in-process client endpoint; use it with
    Client(None, ADDRESS, Community(community), ..., port=local_port(),
    transport=transport()). A supplied transport is owned and closed
    by this mock; its caller connects through the matching network transport.
    """
    _network = transport_mod.MemNet()
    _endpoint = server_transport if server_transport is not None else _network.server(ADDRESS, PORT)
    _agent = agent.Agent(_endpoint, mibview.MibView(bindings), agent.AgentConfig({community: False}), log_handler)
    var _closed = False

    def set_bindings(bindings: list[values.VarBind]):
        """Replace seeded instances; await this action before a dependent read."""
        await async _agent.set_view(mibview.MibView(bindings))

    def set_value(name: oid.Oid, value: values.Value):
        """Create or update one seeded instance for subsequent reads."""
        await async _agent.set_value(name, value)

    def transport() -> transport_mod.Transport:
        """Create an in-process client connection; the client owns its close."""
        if _closed:
            raise ValueError("SNMP mock is closed")
        if server_transport is not None:
            raise ValueError("A supplied mock transport needs a matching client transport")
        return _network.client(ADDRESS, 0, ADDRESS, _endpoint.local_port())

    def local_port() -> int:
        return 0 if _closed else _endpoint.local_port()

    def close():
        """Stop the responder and release the endpoint (idempotent)."""
        if not _closed:
            _closed = True
            await async _agent.close()
