#
# Fleet upgrade scheduler -- small helpers for the campaign controller
# (fleet_ctl) and its simulator.
#

def imin(a: int, b: int) -> int:
    if a < b:
        return a
    return b

def imax(a: int, b: int) -> int:
    if a > b:
        return a
    return b

def ceil_div(a: int, b: int) -> int:
    if b <= 0:
        return 0
    return (a + b - 1) // b

def fmt_ts(ts: int) -> str:
    """Render a timestamp as day + wall clock. Demos use t=0 as campaign start."""
    d = ts // 86400
    hh = (ts % 86400) // 3600
    mm = (ts % 3600) // 60
    return f"d{d:02d} {hh:02d}:{mm:02d}"


class Window(value):
    """One concrete occurrence of a maintenance schedule."""
    schedule: str
    start: int
    end: int

    def __init__(self, schedule: str, start: int, end: int):
        self.schedule = schedule
        self.start = start
        self.end = end

    def __str__(self) -> str:
        return f"{self.schedule} {fmt_ts(self.start)}-{fmt_ts(self.end)}"
