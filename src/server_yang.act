    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='reason', config=False, description='Identifies the condition that resulted in the termination.', is_key=False, mandatory=True, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_subscribed_notifications_subscription_terminated_reason], identities=_identities), adata_name='reason')
])

SRC_DNODE_CHILD_131: DNotification = DNotification(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='push-update', description='This notification contains a push update that in turn contains\ndata subscribed to via a subscription.  In the case of a\nperiodic subscription, this notification is sent for periodic\nupdates.  It can also be used for synchronization updates of\nan on-change subscription.  This notification shall only be\nsent to receivers of a subscription.  It does not constitute\na general-purpose notification that would be subscribable as\npart of the NETCONF event stream by any receiver.', adata_name='push_update', children=[
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='id', config=False, description='This references the subscription that drove the\nnotification to be sent.', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='sn:subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id'),
    DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-contents', config=False, description="This contains the updated data.  It constitutes a snapshot\nat the time of update of the set of data that has been\nsubscribed to.  The snapshot corresponds to the same\nsnapshot that would be returned in a corresponding 'get'\noperation with the same selection filter parameters\napplied.", adata_name='datastore_contents'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='incomplete-update', config=False, description='This is a flag that indicates that not all datastore\nnodes subscribed to are included with this update.  In\nother words, the publisher has failed to fulfill its full\nsubscription obligations and, despite its best efforts, is\nproviding an incomplete set of objects.', is_key=False, mandatory=False, type=DTypeEmpty(name='empty', description=None, reference=None, units=None, exts=[], builtin_type='empty', default=None), adata_name='incomplete_update')
])

SRC_DNODE_CHILD_132: DNotification = DNotification(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='push-change-update', description='This notification contains an on-change push update.  This\nnotification shall only be sent to the receivers of a\nsubscription.  It does not constitute a general-purpose\nnotification that would be subscribable as part of the\nNETCONF event stream by any receiver.', if_feature=['on-change'], adata_name='push_change_update', children=[
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='id', config=False, description='This references the subscription that drove the\nnotification to be sent.', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='sn:subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id'),
    DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-changes', config=False, description='This contains the set of datastore changes of the target\ndatastore, starting at the time of the previous update, per\nthe terms of the subscription.', presence=False, adata_name='datastore_changes', children=[
        DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='yang-patch', config=False, description="Represents a conceptual sequence of datastore edits,\ncalled a patch.  Each patch is given a client-assigned\npatch identifier.  Each edit MUST be applied\nin ascending order, and all edits MUST be applied.\nIf any errors occur, then the target datastore MUST NOT\nbe changed by the YANG Patch operation.\n\nIt is possible for a datastore constraint violation to occur\ndue to any node in the datastore, including nodes not\nincluded in the 'edit' list.  Any validation errors MUST\nbe reported in the reply message.", presence=False, reference='RFC 7950, Section 8.3.', adata_name='yang_patch', children=[
            DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='patch-id', config=False, description="An arbitrary string provided by the client to identify\nthe entire patch.  Error messages returned by the server\nthat pertain to this patch will be identified by this\n'patch-id' value.  A client SHOULD attempt to generate\nunique 'patch-id' values to distinguish between\ntransactions from multiple clients in any audit logs\nmaintained by the server.", is_key=False, mandatory=True, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='patch_id'),
            DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='comment', config=False, description='An arbitrary string provided by the client to describe\nthe entire patch.  This value SHOULD be present in any\naudit logging records generated by the server for the\npatch.', is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='comment'),
            DList(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='edit', key=['edit-id'], config=False, description="Represents one edit within the YANG Patch request message.\nThe 'edit' list is applied in the following manner:\n\n  - The first edit is conceptually applied to a copy\n    of the existing target datastore, e.g., the\n    running configuration datastore.\n  - Each ascending edit is conceptually applied to\n    the result of the previous edit(s).\n  - After all edits have been successfully processed,\n    the result is validated according to YANG constraints.\n  - If successful, the server will attempt to apply\n    the result to the target datastore.", min_elements=0, ordered_by='user', adata_name='edit', children=[
                DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='edit-id', config=False, description='Arbitrary string index for the edit.\nError messages returned by the server that pertain\nto a specific edit will be identified by this value.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='edit_id'),
                DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='operation', config=False, description="The datastore operation requested for the associated\n'edit' entry.", is_key=False, mandatory=True, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'create':0, 'delete':1, 'insert':2, 'merge':3, 'move':4, 'replace':5, 'remove':6}), adata_name='operation'),
                DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='target', config=False, description="Identifies the target data node for the edit\noperation.  If the target has the value '/', then\nthe target data node is the target resource.\nThe target node MUST identify a data resource,\nnot the datastore resource.", is_key=False, mandatory=True, type=DTypeString(name='ypatch:target-resource-offset', description='Contains a data resource identifier string representing\na sub-resource within the target resource.\nThe document root for this expression is the\ntarget resource that is specified in the\nprotocol operation (e.g., the URI for the PATCH request).\n\nThis string is encoded according to the same rules as those\nfor a data resource identifier in a RESTCONF request URI.', reference='RFC 8040, Section 3.5.3.', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='target'),
                DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='point', config=False, description="The absolute URL path for the data node that is being\nused as the insertion point or move point for the\ntarget of this 'edit' entry.", is_key=False, mandatory=False, type=DTypeString(name='ypatch:target-resource-offset', description='Contains a data resource identifier string representing\na sub-resource within the target resource.\nThe document root for this expression is the\ntarget resource that is specified in the\nprotocol operation (e.g., the URI for the PATCH request).\n\nThis string is encoded according to the same rules as those\nfor a data resource identifier in a RESTCONF request URI.', reference='RFC 8040, Section 3.5.3.', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), when="(../operation = 'insert' or ../operation = 'move')and (../where = 'before' or ../where = 'after')", adata_name='point'),
                DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='where', config=False, description="Identifies where a data resource will be inserted\nor moved.  YANG only allows these operations for\nlist and leaf-list data nodes that are\n'ordered-by user'.", default='last', is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'before':0, 'after':1, 'first':2, 'last':3}), when="../operation = 'insert' or ../operation = 'move'", adata_name='where'),
                DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='value', config=False, description="Value used for this edit operation.  The anydata 'value'\ncontains the target resource associated with the\n'target' leaf.\n\nFor example, suppose the target node is a YANG container\nnamed foo:\n\n    container foo {{\n      leaf a {{ type string; }}\n      leaf b {{ type int32; }}\n    }}\n\nThe 'value' node contains one instance of foo:\n\n    <value>\n       <foo xmlns='example-foo-namespace'>\n          <a>some value</a>\n          <b>42</b>\n       </foo>\n    </value>\n ", when="../operation = 'create' or ../operation = 'merge' or ../operation = 'replace' or ../operation = 'insert'", adata_name='value')
            ])
        ])
    ]),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='incomplete-update', config=False, description='The presence of this object indicates that not all changes\nthat have occurred since the last update are included with\nthis update.  In other words, the publisher has failed to\nfulfill its full subscription obligations -- for example,\nin cases where it was not able to keep up with a burst of\nchanges.', is_key=False, mandatory=False, type=DTypeEmpty(name='empty', description=None, reference=None, units=None, exts=[], builtin_type='empty', default=None), adata_name='incomplete_update')
])

SRC_DNODE_CHILD_134: DContainer = DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='capabilities', config=False, description='Contains the list of NETCONF capabilities supported by the\nserver.', presence=False, adata_name='capabilities', children=[
    DLeafList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='capability', config=False, description='List of NETCONF capabilities supported by the server.', min_elements=0, ordered_by='system', type=DTypeString(name='inet:uri', description="The uri type represents a Uniform Resource Identifier\n(URI) as defined by STD 66.\n\nObjects using the uri type MUST be in US-ASCII encoding,\nand MUST be normalized as described by RFC 3986 Sections\n6.2.1, 6.2.2.1, and 6.2.2.2.  All unnecessary\npercent-encoding is removed, and all case-insensitive\ncharacters are set to lowercase except for hexadecimal\ndigits, which are normalized to uppercase as described in\nSection 6.2.2.1.\n\nThe purpose of this normalization is to help provide\nunique URIs.  Note that this normalization is not\nsufficient to provide uniqueness.  Two URIs that are\ntextually distinct after this normalization may still be\nequivalent.\n\nObjects using the uri type may restrict the schemes that\nthey permit.  For example, 'data:' and 'urn:' schemes\nmight not be appropriate.\n\nA zero-length URI is not a valid URI.  This can be used to\nexpress 'URI absent' where required.\n\nIn the value set and its semantics, this type is equivalent\nto the Uri SMIv2 textual convention defined in RFC 5017.", reference='RFC 3986: Uniform Resource Identifier (URI): Generic Syntax\nRFC 3305: Report from the Joint W3C/IETF URI Planning Interest\n          Group: Uniform Resource Identifiers (URIs), URLs,\n          and Uniform Resource Names (URNs): Clarifications\n          and Recommendations\nRFC 5017: MIB Textual Conventions for Uniform Resource\n          Identifiers (URIs)', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='capability')
])

SRC_DNODE_CHILD_135: DContainer = DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='datastores', config=False, description='Contains the list of NETCONF configuration datastores.', presence=False, adata_name='datastores', children=[
    DList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='datastore', key=['name'], config=False, description='List of NETCONF configuration datastores supported by\nthe NETCONF server and related information.', min_elements=0, ordered_by='system', adata_name='datastore', children=[
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='name', config=False, description='Name of the datastore associated with this list entry.', is_key=True, mandatory=False, type=DTypeEnum(name='netconf-datastore-type', description='Enumeration of possible NETCONF datastore types.', reference='RFC 4741: NETCONF Configuration Protocol', units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'running':0, 'candidate':1, 'startup':2}), adata_name='name'),
        DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='locks', config=False, description='The NETCONF <lock> and <partial-lock> operations allow\na client to lock specific resources in a datastore.  The\nNETCONF server will prevent changes to the locked\nresources by all sessions except the one that acquired\nthe lock(s).\n\nMonitoring information is provided for each datastore\nentry including details such as the session that acquired\nthe lock, the type of lock (global or partial) and the\nlist of locked resources.  Multiple locks per datastore\nare supported.', presence=True, adata_name='locks', children=[
            DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='global-lock', config=False, description='Present if the global lock is set.', presence=False, adata_name='global_lock', children=[
                DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='locked-by-session', config=False, description='The session ID of the session that has locked\nthis resource.  Both a global lock and a partial\nlock MUST contain the NETCONF session-id.\n\nIf the lock is held by a session that is not managed\nby the NETCONF server (e.g., a CLI session), a session\nid of 0 (zero) is reported.', is_key=False, mandatory=True, reference='RFC 4741: NETCONF Configuration Protocol', type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='locked_by_session'),
                DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='locked-time', config=False, description='The date and time of when the resource was\nlocked.', is_key=False, mandatory=True, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='locked_time')
            ]),
            DList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='partial-lock', key=['lock-id'], config=False, description='List of partial locks.', min_elements=0, ordered_by='system', reference='RFC 5717: Partial Lock Remote Procedure Call (RPC) for\n          NETCONF', adata_name='partial_lock', children=[
                DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='lock-id', config=False, description='This is the lock id returned in the <partial-lock>\nresponse.', is_key=True, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='lock_id'),
                DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='locked-by-session', config=False, description='The session ID of the session that has locked\nthis resource.  Both a global lock and a partial\nlock MUST contain the NETCONF session-id.\n\nIf the lock is held by a session that is not managed\nby the NETCONF server (e.g., a CLI session), a session\nid of 0 (zero) is reported.', is_key=False, mandatory=True, reference='RFC 4741: NETCONF Configuration Protocol', type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='locked_by_session'),
                DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='locked-time', config=False, description='The date and time of when the resource was\nlocked.', is_key=False, mandatory=True, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='locked_time'),
                DLeafList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='select', config=False, description='The xpath expression that was used to request\nthe lock.  The select expression indicates the\noriginal intended scope of the lock.', min_elements=1, ordered_by='system', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='select'),
                DLeafList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='locked-node', config=False, description='The list of instance-identifiers (i.e., the\nlocked nodes).\n\nThe scope of the partial lock is defined by the list\nof locked nodes.', min_elements=0, ordered_by='system', type=DTypeInstanceIdentifier(name='instance-identifier', description=None, reference=None, units=None, exts=[], builtin_type='instance-identifier', default=None, require_instance=False), adata_name='locked_node')
            ])
        ])
    ])
])

SRC_DNODE_CHILD_136: DContainer = DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='schemas', config=False, description='Contains the list of data model schemas supported by the\nserver.', presence=False, adata_name='schemas', children=[
    DList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='schema', key=[
'identifier',
'version',
'format'
        ], config=False, description='List of data model schemas supported by the server.', min_elements=0, ordered_by='system', adata_name='schema', children=[
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='identifier', config=False, description='Identifier to uniquely reference the schema.  The\nidentifier is used in the <get-schema> operation and may\nbe used for other purposes such as file retrieval.\n\nFor modeling languages that support or require a data\nmodel name (e.g., YANG module name) the identifier MUST\nmatch that name.  For YANG data models, the identifier is\nthe name of the module or submodule.  In other cases, an\nidentifier such as a filename MAY be used instead.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='identifier'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='version', config=False, description="Version of the schema supported.  Multiple versions MAY be\nsupported simultaneously by a NETCONF server.  Each\nversion MUST be reported individually in the schema list,\ni.e., with same identifier, possibly different location,\nbut different version.\n\nFor YANG data models, version is the value of the most\nrecent YANG 'revision' statement in the module or\nsubmodule, or the empty string if no 'revision' statement\nis present.", is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='version'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='format', config=False, description="The data modeling language the schema is written\nin (currently xsd, yang, yin, rng, or rnc).\nFor YANG data models, 'yang' format MUST be supported and\n'yin' format MAY also be provided.", is_key=True, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_netconf_monitoring_schema_format], identities=_identities), adata_name='format'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='namespace', config=False, description="The XML namespace defined by the data model.\n\nFor YANG data models, this is the module's namespace.\nIf the list entry describes a submodule, this field\ncontains the namespace of the module to which the\nsubmodule belongs.", is_key=False, mandatory=True, type=DTypeString(name='inet:uri', description="The uri type represents a Uniform Resource Identifier\n(URI) as defined by STD 66.\n\nObjects using the uri type MUST be in US-ASCII encoding,\nand MUST be normalized as described by RFC 3986 Sections\n6.2.1, 6.2.2.1, and 6.2.2.2.  All unnecessary\npercent-encoding is removed, and all case-insensitive\ncharacters are set to lowercase except for hexadecimal\ndigits, which are normalized to uppercase as described in\nSection 6.2.2.1.\n\nThe purpose of this normalization is to help provide\nunique URIs.  Note that this normalization is not\nsufficient to provide uniqueness.  Two URIs that are\ntextually distinct after this normalization may still be\nequivalent.\n\nObjects using the uri type may restrict the schemes that\nthey permit.  For example, 'data:' and 'urn:' schemes\nmight not be appropriate.\n\nA zero-length URI is not a valid URI.  This can be used to\nexpress 'URI absent' where required.\n\nIn the value set and its semantics, this type is equivalent\nto the Uri SMIv2 textual convention defined in RFC 5017.", reference='RFC 3986: Uniform Resource Identifier (URI): Generic Syntax\nRFC 3305: Report from the Joint W3C/IETF URI Planning Interest\n          Group: Uniform Resource Identifiers (URIs), URLs,\n          and Uniform Resource Names (URNs): Clarifications\n          and Recommendations\nRFC 5017: MIB Textual Conventions for Uniform Resource\n          Identifiers (URIs)', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='namespace'),
        DLeafList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='location', config=False, description="One or more locations from which the schema can be\nretrieved.  This list SHOULD contain at least one\nentry per schema.\n\nA schema entry may be located on a remote file system\n(e.g., reference to file system for ftp retrieval) or\nretrieved directly from a server supporting the\n<get-schema> operation (denoted by the value 'NETCONF').", min_elements=0, ordered_by='system', type=DTypeUnion(name='union', description=None, reference=None, units=None, exts=[], builtin_type='union', default=None, types=[DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'NETCONF':0}), DTypeString(name='inet:uri', description="The uri type represents a Uniform Resource Identifier\n(URI) as defined by STD 66.\n\nObjects using the uri type MUST be in US-ASCII encoding,\nand MUST be normalized as described by RFC 3986 Sections\n6.2.1, 6.2.2.1, and 6.2.2.2.  All unnecessary\npercent-encoding is removed, and all case-insensitive\ncharacters are set to lowercase except for hexadecimal\ndigits, which are normalized to uppercase as described in\nSection 6.2.2.1.\n\nThe purpose of this normalization is to help provide\nunique URIs.  Note that this normalization is not\nsufficient to provide uniqueness.  Two URIs that are\ntextually distinct after this normalization may still be\nequivalent.\n\nObjects using the uri type may restrict the schemes that\nthey permit.  For example, 'data:' and 'urn:' schemes\nmight not be appropriate.\n\nA zero-length URI is not a valid URI.  This can be used to\nexpress 'URI absent' where required.\n\nIn the value set and its semantics, this type is equivalent\nto the Uri SMIv2 textual convention defined in RFC 5017.", reference='RFC 3986: Uniform Resource Identifier (URI): Generic Syntax\nRFC 3305: Report from the Joint W3C/IETF URI Planning Interest\n          Group: Uniform Resource Identifiers (URIs), URLs,\n          and Uniform Resource Names (URNs): Clarifications\n          and Recommendations\nRFC 5017: MIB Textual Conventions for Uniform Resource\n          Identifiers (URIs)', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])]), adata_name='location')
    ])
])

SRC_DNODE_CHILD_137: DContainer = DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='sessions', config=False, description='The sessions container includes session-specific data for\nNETCONF management sessions.  The session list MUST include\nall currently active NETCONF sessions.', presence=False, adata_name='sessions', children=[
    DList(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='session', key=['session-id'], config=False, description='All NETCONF sessions managed by the NETCONF server\nMUST be reported in this list.', min_elements=0, ordered_by='system', adata_name='session', children=[
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='session-id', config=False, description='Unique identifier for the session.  This value is the\nNETCONF session identifier, as defined in RFC 4741.', is_key=True, mandatory=False, reference='RFC 4741: NETCONF Configuration Protocol', type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(1, 4294967295)])), adata_name='session_id'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='transport', config=False, description="Identifies the transport for each session, e.g.,\n'netconf-ssh', 'netconf-soap', etc.", is_key=False, mandatory=True, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_netconf_monitoring_transport], identities=_identities), adata_name='transport'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='username', config=False, description='The username is the client identity that was authenticated\nby the NETCONF transport protocol.  The algorithm used to\nderive the username is NETCONF transport protocol specific\nand in addition specific to the authentication mechanism\nused by the NETCONF transport protocol.', is_key=False, mandatory=True, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='username'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='source-host', config=False, description='Host identifier of the NETCONF client.  The value\nreturned is implementation specific (e.g., hostname,\nIPv4 address, IPv6 address)', is_key=False, mandatory=False, type=DTypeUnion(name='inet:host', description='The host type represents either an IP address or a DNS\ndomain name.', reference=None, units=None, exts=[], builtin_type='union', default=None, types=[DTypeString(name='inet:ipv4-address', description='The ipv4-address type represents an IPv4 address in\ndotted-quad notation.  The IPv4 address may include a zone\nindex, separated by a % sign.\n\nThe zone index is used to disambiguate identical address\nvalues.  For link-local addresses, the zone index will\ntypically be the interface index number or the name of an\ninterface.  If the zone index is not present, the default\nzone of the device will be used.\n\nThe canonical format for the zone index is the numerical\nformat', reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{{N}}\\p{{L}}]+)?', pcre='^((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{{N}}\\p{{L}}]+)?)$', invert=False)]), DTypeString(name='inet:ipv6-address', description='The ipv6-address type represents an IPv6 address in full,\nmixed, shortened, and shortened-mixed notation.  The IPv6\naddress may include a zone index, separated by a % sign.\n\nThe zone index is used to disambiguate identical address\nvalues.  For link-local addresses, the zone index will\ntypically be the interface index number or the name of an\ninterface.  If the zone index is not present, the default\nzone of the device will be used.\n\nThe canonical format of IPv6 addresses uses the textual\nrepresentation defined in Section 4 of RFC 5952.  The\ncanonical format for the zone index is the numerical\nformat as described in Section 11.2 of RFC 4007.', reference='RFC 4291: IP Version 6 Addressing Architecture\nRFC 4007: IPv6 Scoped Address Architecture\nRFC 5952: A Recommendation for IPv6 Address Text\n          Representation', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='((:|[0-9a-fA-F]{{0,4}}):)([0-9a-fA-F]{{0,4}}:){{0,5}}((([0-9a-fA-F]{{0,4}}:)?(:|[0-9a-fA-F]{{0,4}}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){{3}}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\\p{{N}}\\p{{L}}]+)?', pcre='^(((:|[0-9a-fA-F]{{0,4}}):)([0-9a-fA-F]{{0,4}}:){{0,5}}((([0-9a-fA-F]{{0,4}}:)?(:|[0-9a-fA-F]{{0,4}}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){{3}}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\\p{{N}}\\p{{L}}]+)?)$', invert=False), YangPattern(yang_regex='(([^:]+:){{6}}(([^:]+:[^:]+)|(.*\\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(%.+)?', pcre='^((([^\\:]+:){{6}}(([^\\:]+:[^\\:]+)|(.*\\..*)))|((([^\\:]+:)*[^\\:]+)?::(([^\\:]+:)*[^\\:]+)?)(%.+)?)$', invert=False)]), DTypeString(name='inet:domain-name', description='The domain-name type represents a DNS domain name.  The\nname SHOULD be fully qualified whenever possible.\n\nInternet domain names are only loosely specified.  Section\n3.5 of RFC 1034 recommends a syntax (modified in Section\n2.1 of RFC 1123).  The pattern above is intended to allow\nfor current practice in domain name use, and some possible\nfuture expansion.  It is designed to hold various types of\ndomain names, including names used for A or AAAA records\n(host names) and other records, such as SRV records.  Note\nthat Internet host names have a stricter syntax (described\nin RFC 952) than the DNS recommendations in RFCs 1034 and\n1123, and that systems that want to store host names in\nschema nodes using the domain-name type are recommended to\nadhere to this stricter standard to ensure interoperability.\n\nThe encoding of DNS names in the DNS protocol is limited\nto 255 characters.  Since the encoding consists of labels\nprefixed by a length bytes and there is a trailing NULL\nbyte, only 253 characters can appear in the textual dotted\nnotation.\n\nThe description clause of schema nodes using the domain-name\ntype MUST describe when and how these names are resolved to\nIP addresses.  Note that the resolution of a domain-name value\nmay require to query multiple DNS records (e.g., A for IPv4\nand AAAA for IPv6).  The order of the resolution process and\nwhich DNS record takes precedence can either be defined\nexplicitly or may depend on the configuration of the\nresolver.\n\nDomain-name values use the US-ASCII encoding.  Their canonical\nformat uses lowercase US-ASCII characters.  Internationalized\ndomain names MUST be A-labels as per RFC 5890.', reference='RFC  952: DoD Internet Host Table Specification\nRFC 1034: Domain Names - Concepts and Facilities\nRFC 1123: Requirements for Internet Hosts -- Application\n          and Support\nRFC 2782: A DNS RR for specifying the location of services\n          (DNS SRV)\nRFC 5890: Internationalized Domain Names in Applications\n          (IDNA): Definitions and Document Framework', units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 253)]), patterns=[YangPattern(yang_regex='((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){{0,61}})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){{0,61}})?[a-zA-Z0-9]\\.?)|\\.', pcre='^(((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){{0,61}})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){{0,61}})?[a-zA-Z0-9]\\.?)|\\.)$', invert=False)])]), adata_name='source_host'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='login-time', config=False, description='Time at the server at which the session was established.', is_key=False, mandatory=True, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='login_time'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='in-rpcs', config=False, description='Number of correct <rpc> messages received.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='in_rpcs'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='in-bad-rpcs', config=False, description='Number of messages received when an <rpc> message was expected,\nthat were not correct <rpc> messages.  This includes XML parse\nerrors and errors on the rpc layer.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='in_bad_rpcs'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='out-rpc-errors', config=False, description='Number of <rpc-reply> messages sent that contained an\n<rpc-error> element.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='out_rpc_errors'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='out-notifications', config=False, description='Number of <notification> messages sent.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='out_notifications')
    ])
])

SRC_DNODE_CHILD_138: DContainer = DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='statistics', config=False, description='Statistical data pertaining to the NETCONF server.', presence=False, adata_name='statistics', children=[
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='netconf-start-time', config=False, description='Date and time at which the management subsystem was\nstarted.', is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='netconf_start_time'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='in-bad-hellos', config=False, description="Number of sessions silently dropped because an\ninvalid <hello> message was received.  This includes <hello>\nmessages with a 'session-id' attribute, bad namespace, and\nbad capability declarations.", default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='in_bad_hellos'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='in-sessions', config=False, description="Number of sessions started.  This counter is incremented\nwhen a <hello> message with a <session-id> is sent.\n\n'in-sessions' - 'in-bad-hellos' =\n   'number of correctly started netconf sessions'", default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='in_sessions'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='dropped-sessions', config=False, description='Number of sessions that were abnormally terminated, e.g.,\ndue to idle timeout or transport close.  This counter is not\nincremented when a session is properly closed by a\n<close-session> operation, or killed by a <kill-session>\noperation.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='dropped_sessions'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='in-rpcs', config=False, description='Number of correct <rpc> messages received.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='in_rpcs'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='in-bad-rpcs', config=False, description='Number of messages received when an <rpc> message was expected,\nthat were not correct <rpc> messages.  This includes XML parse\nerrors and errors on the rpc layer.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='in_bad_rpcs'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='out-rpc-errors', config=False, description='Number of <rpc-reply> messages sent that contained an\n<rpc-error> element.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='out_rpc_errors'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='out-notifications', config=False, description='Number of <notification> messages sent.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='yang:zero-based-counter32', description="The zero-based-counter32 type represents a counter32\nthat has the defined 'initial' value zero.\n\nA data tree node using this type will be set to zero (0)\non creation and will thereafter increase monotonically until\nit reaches a maximum value of 2^32-1 (4294967295 decimal),\nwhen it wraps around and starts increasing again from zero.\n\nProvided that an application discovers a new data tree node\nusing this type within the minimum time to wrap, it can use\nthe 'initial' value as a delta.  It is important for a\nmanagement station to be aware of this minimum time and the\nactual time between polls, and to discard data if the actual\ntime is too long or there is no defined minimum time.\n\nIn the value set and its semantics, this type is equivalent\nto the ZeroBasedCounter32 textual convention of the SMIv2.", reference='RFC 4502: Remote Network Monitoring Management Information\n          Base Version 2', units=None, exts=[], builtin_type='uint32', default='0', ranges=Ranges([(0, 4294967295)])), adata_name='out_notifications')
])

SRC_DNODE_CHILD_133: DContainer = DContainer(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='netconf-state', config=False, description='The netconf-state container is the root of the monitoring\ndata model.', presence=False, adata_name='netconf_state', children=[SRC_DNODE_CHILD_134, SRC_DNODE_CHILD_135, SRC_DNODE_CHILD_136, SRC_DNODE_CHILD_137, SRC_DNODE_CHILD_138])

SRC_DNODE_CHILD_141: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-filter-name', config=False, description='References an existing event stream filter that is\nto be applied to an event stream for the\nsubscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='stream-filter-ref', description='This type is used to reference an event stream filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('sn', 'stream-filter', []), yxpath.NodeTestStep('sn', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='stream_filter_name')

SRC_DNODE_CHILD_142: DAnydata = DAnydata(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-subtree-filter', config=False, description='Event stream evaluation criteria encoded in the syntax of\na subtree filter as defined in RFC 6241, Section 6.\n\nThe subtree filter is applied to the representation of\nindividual, delineated event records as contained in the\nevent stream.\n\nIf the subtree filter returns a non-empty node set, the\nfilter matches the event record, and the event record is\nincluded in the notification message sent to the\nreceivers.', if_feature=['subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='stream_subtree_filter')

SRC_DNODE_CHILD_143: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-xpath-filter', config=False, description="Event stream evaluation criteria encoded in the syntax of\nan XPath 1.0 expression.\n\nThe XPath expression is evaluated on the representation of\nindividual, delineated event records as contained in\nthe event stream.\n\nThe result of the XPath expression is converted to a\nboolean value using the standard XPath 1.0 rules.  If the\nboolean value is 'true', the filter matches the event\nrecord, and the event record is included in the\nnotification message sent to the receivers.\n\nThe expression is evaluated in the following XPath\ncontext:\n\n   o  The set of namespace declarations is the set of\n      prefix and namespace pairs for all YANG modules\n      implemented by the server, where the prefix is the\n      YANG module name and the namespace is as defined by\n      the 'namespace' statement in the YANG module.\n\n      If the leaf is encoded in XML, all namespace\n      declarations in scope on the 'stream-xpath-filter'\n      leaf element are added to the set of namespace\n      declarations.  If a prefix found in the XML is\n      already present in the set of namespace\n      declarations, the namespace in the XML is used.\n\n   o  The set of variable bindings is empty.\n\n   o  The function library is comprised of the core\n      function library and the XPath functions defined in\n      Section 10 in RFC 7950.\n\n   o  The context node is the root node.", if_feature=['xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='stream_xpath_filter')

SRC_DNODE_CHILD_144: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream', config=False, description='Indicates the event stream to be considered for\nthis subscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='stream-ref', description='This type is used to reference a system-provided\nevent stream.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'streams', []), yxpath.NodeTestStep('sn', 'stream', []), yxpath.NodeTestStep('sn', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='stream')

SRC_DNODE_CHILD_145: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-start-time', config=False, description="Used to trigger the 'replay' feature for a dynamic\nsubscription, where event records that are selected\nneed to be at or after the specified starting time.  If\n'replay-start-time' is not present, this is not a replay\nsubscription and event record push should start\nimmediately.  It is never valid to specify start times\nthat are later than or equal to the current time.", if_feature=['replay'], is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='replay_start_time')

SRC_DNODE_CHILD_146: DLeaf = DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore', config=False, description='Datastore from which to retrieve data.', is_key=False, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_datastores_datastore], identities=_identities), adata_name='datastore')

SRC_DNODE_CHILD_147: DLeaf = DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='selection-filter-ref', config=False, description='References an existing selection filter that is to be\napplied to the subscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='selection-filter-ref', description='This type is used to reference a selection filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('yp', 'selection-filter', []), yxpath.NodeTestStep('yp', 'filter-id', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='selection_filter_ref')

SRC_DNODE_CHILD_148: DAnydata = DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-subtree-filter', config=False, description='This parameter identifies the portions of the\ntarget datastore to retrieve.', if_feature=['sn:subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='datastore_subtree_filter')

SRC_DNODE_CHILD_149: DLeaf = DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-xpath-filter', config=False, description="This parameter contains an XPath expression identifying\nthe portions of the target datastore to retrieve.\n\nIf the expression returns a node set, all nodes in the\nnode set are selected by the filter.  Otherwise, if the\nexpression does not return a node set, the filter\ndoesn't select any nodes.\n\nThe expression is evaluated in the following XPath\ncontext:\n\no  The set of namespace declarations is the set of prefix\n   and namespace pairs for all YANG modules implemented\n   by the server, where the prefix is the YANG module\n   name and the namespace is as defined by the\n   'namespace' statement in the YANG module.\n\n   If the leaf is encoded in XML, all namespace\n   declarations in scope on the 'stream-xpath-filter'\n   leaf element are added to the set of namespace\n   declarations.  If a prefix found in the XML is\n   already present in the set of namespace declarations,\n   the namespace in the XML is used.\n\no  The set of variable bindings is empty.\n\no  The function library is comprised of the core\n   function library and the XPath functions defined in\n   Section 10 in RFC 7950.\n\no  The context node is the root node of the target\n   datastore.", if_feature=['sn:xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='datastore_xpath_filter')

SRC_DNODE_CHILD_150: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stop-time', config=False, description="Identifies a time after which notification messages for a\nsubscription should not be sent.  If 'stop-time' is not\npresent, the notification messages will continue until the\nsubscription is terminated.  If 'replay-start-time' exists,\n'stop-time' must be for a subsequent time.  If\n'replay-start-time' doesn't exist, 'stop-time', when\nestablished, must be for a future time.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='stop_time')

SRC_DNODE_CHILD_151: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='dscp', config=False, description='The desired network transport priority level.  This is the\npriority set on notification messages encapsulating the\nresults of the subscription.  This transport priority is\nshared for all receivers of a given subscription.', default='0', if_feature=['dscp'], is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='inet:dscp', description='The dscp type represents a Differentiated Services Code Point\nthat may be used for marking packets in a traffic stream.\nIn the value set and its semantics, this type is equivalent\nto the Dscp textual convention of the SMIv2.', reference='RFC 3289: Management Information Base for the Differentiated\n          Services Architecture\nRFC 2474: Definition of the Differentiated Services Field\n          (DS Field) in the IPv4 and IPv6 Headers\nRFC 2780: IANA Allocation Guidelines For Values In\n          the Internet Protocol and Related Headers', units=None, exts=[], builtin_type='uint8', default=None, ranges=Ranges([(0, 63)])), adata_name='dscp')

SRC_DNODE_CHILD_152: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='weighting', config=False, description='Relative weighting for a subscription.  Larger weights get\nmore resources.  Allows an underlying transport layer to\nperform informed load-balance allocations between various\nsubscriptions.', if_feature=['qos'], is_key=False, mandatory=False, reference='RFC 7540: Hypertext Transfer Protocol Version 2 (HTTP/2),\n          Section 5.3.2', type=DTypeIntegerUnsigned(name='uint8', description=None, reference=None, units=None, exts=[], builtin_type='uint8', default=None, ranges=Ranges([(0, 255)])), adata_name='weighting')

SRC_DNODE_CHILD_153: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='dependency', config=False, description="Provides the 'subscription-id' of a parent subscription.\nThe parent subscription has absolute precedence should\nthat parent have push updates ready to egress the publisher.\nIn other words, there should be no streaming of objects from\nthe current subscription if the parent has something ready\nto push.\n\nIf a dependency is asserted via configuration or via an RPC\nbut the referenced 'subscription-id' does not exist, the\ndependency is silently discarded.  If a referenced\nsubscription is deleted, this dependency is removed.", if_feature=['qos'], is_key=False, mandatory=False, reference='RFC 7540: Hypertext Transfer Protocol Version 2 (HTTP/2),\n          Section 5.3.1', type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='dependency')

SRC_DNODE_CHILD_154: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='encoding', config=False, description='The type of encoding for the subscribed data.  If not\nincluded as part of the RPC, the encoding MUST be set by\nthe publisher to be the encoding used by this RPC.', is_key=False, mandatory=False, type=DTypeIdentityref(name='encoding', description='Specifies a data encoding, e.g., for a data subscription.', reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_subscribed_notifications_encoding], identities=_identities), adata_name='encoding')

SRC_DNODE_CHILD_155: DContainer = DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='periodic', config=False, description='The publisher is requested to periodically notify the\nreceiver regarding the current values of the datastore\nas defined by the selection filter.', presence=True, adata_name='periodic', children=[
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='period', config=False, description='Duration of time that should occur between periodic\npush updates, in units of 0.01 seconds.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='period'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='anchor-time', config=False, description="Designates a timestamp before or after which a series\nof periodic push updates are determined.  The next\nupdate will take place at a point in time that is a\nmultiple of a period from the 'anchor-time'.\nFor example, for an 'anchor-time' that is set for the\ntop of a particular minute and a period interval of a\nminute, updates will be sent at the top of every\nminute that this subscription is active.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='anchor_time')
])

SRC_DNODE_CHILD_156: DContainer = DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='on-change', config=False, description='The publisher is requested to notify the receiver\nregarding changes in values in the datastore subset as\ndefined by a selection filter.', presence=True, adata_name='on_change', children=[
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='dampening-period', config=False, description='Specifies the minimum interval between the assembly of\nsuccessive update records for a single receiver of a\nsubscription.  Whenever subscribed objects change and\na dampening-period interval (which may be zero) has\nelapsed since the previous update record creation for\na receiver, any subscribed objects and properties\nthat have changed since the previous update record\nwill have their current values marshalled and placed\nin a new update record.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='dampening_period'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='sync-on-start', config=False, description="When this object is set to 'false', (1) it restricts an\non-change subscription from sending 'push-update'\nnotifications and (2) pushing a full selection per the\nterms of the selection filter MUST NOT be done for\nthis subscription.  Only updates about changes\n(i.e., only 'push-change-update' notifications)\nare sent.  When set to 'true' (the default behavior),\nin order to facilitate a receiver's synchronization,\na full update is sent, via a 'push-update' notification,\nwhen the subscription starts.  After that,\n'push-change-update' notifications are exclusively sent,\nunless the publisher chooses to resync the subscription\nvia a new 'push-update' notification.", default='true', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, units=None, exts=[], builtin_type='boolean', default=None), adata_name='sync_on_start'),
    DLeafList(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='excluded-change', config=False, description="Used to restrict which changes trigger an update.  For\nexample, if a 'replace' operation is excluded, only the\ncreation and deletion of objects are reported.", min_elements=0, ordered_by='system', type=DTypeEnum(name='change-type', description="Specifies different types of datastore changes.\n\nThis type is based on the edit operations defined for\nYANG Patch, with the difference that it is valid for a\nreceiver to process an update record that performs a\n'create' operation on a datastore node the receiver believes\nexists or to process a delete on a datastore node the\nreceiver believes is missing.", reference='RFC 8072: YANG Patch Media Type, Section 2.5', units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'create':0, 'delete':1, 'insert':2, 'move':3, 'replace':4}), adata_name='excluded_change')
])

SRC_DNODE_CHILD_140: DInput = DInput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', adata_name='input', children=[SRC_DNODE_CHILD_141, SRC_DNODE_CHILD_142, SRC_DNODE_CHILD_143, SRC_DNODE_CHILD_144, SRC_DNODE_CHILD_145, SRC_DNODE_CHILD_146, SRC_DNODE_CHILD_147, SRC_DNODE_CHILD_148, SRC_DNODE_CHILD_149, SRC_DNODE_CHILD_150, SRC_DNODE_CHILD_151, SRC_DNODE_CHILD_152, SRC_DNODE_CHILD_153, SRC_DNODE_CHILD_154, SRC_DNODE_CHILD_155, SRC_DNODE_CHILD_156])

SRC_DNODE_CHILD_157: DOutput = DOutput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', adata_name='output', children=[
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='id', config=False, description='Identifier used for this subscription.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-start-time-revision', config=False, description="If a replay has been requested, this object represents\nthe earliest time covered by the event buffer for the\nrequested event stream.  The value of this object is the\n'replay-log-aged-time' if it exists.  Otherwise, it is\nthe 'replay-log-creation-time'.  All buffered event\nrecords after this time will be replayed to a receiver.\nThis object will only be sent if the starting time has\nbeen revised to be later than the time requested by the\nsubscriber.", if_feature=['replay'], is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='replay_start_time_revision')
])

SRC_DNODE_CHILD_139: DRpc = DRpc(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='establish-subscription', description="This RPC allows a subscriber to create (and possibly\nnegotiate) a subscription on its own behalf.  If successful,\nthe subscription remains in effect for the duration of the\nsubscriber's association with the publisher or until the\nsubscription is terminated.  If an error occurs or the\npublisher cannot meet the terms of a subscription, an RPC\nerror is returned, and the subscription is not created.\nIn that case, the RPC reply's 'error-info' MAY include\nsuggested parameter settings that would have a higher\nlikelihood of succeeding in a subsequent\n'establish-subscription' request.", input=DInput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', children=[
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-filter-name', config=False, description='References an existing event stream filter that is\nto be applied to an event stream for the\nsubscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='stream-filter-ref', description='This type is used to reference an event stream filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('sn', 'stream-filter', []), yxpath.NodeTestStep('sn', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='stream_filter_name'),
    DAnydata(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-subtree-filter', config=False, description='Event stream evaluation criteria encoded in the syntax of\na subtree filter as defined in RFC 6241, Section 6.\n\nThe subtree filter is applied to the representation of\nindividual, delineated event records as contained in the\nevent stream.\n\nIf the subtree filter returns a non-empty node set, the\nfilter matches the event record, and the event record is\nincluded in the notification message sent to the\nreceivers.', if_feature=['subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='stream_subtree_filter'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-xpath-filter', config=False, description="Event stream evaluation criteria encoded in the syntax of\nan XPath 1.0 expression.\n\nThe XPath expression is evaluated on the representation of\nindividual, delineated event records as contained in\nthe event stream.\n\nThe result of the XPath expression is converted to a\nboolean value using the standard XPath 1.0 rules.  If the\nboolean value is 'true', the filter matches the event\nrecord, and the event record is included in the\nnotification message sent to the receivers.\n\nThe expression is evaluated in the following XPath\ncontext:\n\n   o  The set of namespace declarations is the set of\n      prefix and namespace pairs for all YANG modules\n      implemented by the server, where the prefix is the\n      YANG module name and the namespace is as defined by\n      the 'namespace' statement in the YANG module.\n\n      If the leaf is encoded in XML, all namespace\n      declarations in scope on the 'stream-xpath-filter'\n      leaf element are added to the set of namespace\n      declarations.  If a prefix found in the XML is\n      already present in the set of namespace\n      declarations, the namespace in the XML is used.\n\n   o  The set of variable bindings is empty.\n\n   o  The function library is comprised of the core\n      function library and the XPath functions defined in\n      Section 10 in RFC 7950.\n\n   o  The context node is the root node.", if_feature=['xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='stream_xpath_filter'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream', config=False, description='Indicates the event stream to be considered for\nthis subscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='stream-ref', description='This type is used to reference a system-provided\nevent stream.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'streams', []), yxpath.NodeTestStep('sn', 'stream', []), yxpath.NodeTestStep('sn', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='stream'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-start-time', config=False, description="Used to trigger the 'replay' feature for a dynamic\nsubscription, where event records that are selected\nneed to be at or after the specified starting time.  If\n'replay-start-time' is not present, this is not a replay\nsubscription and event record push should start\nimmediately.  It is never valid to specify start times\nthat are later than or equal to the current time.", if_feature=['replay'], is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='replay_start_time'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore', config=False, description='Datastore from which to retrieve data.', is_key=False, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_datastores_datastore], identities=_identities), adata_name='datastore'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='selection-filter-ref', config=False, description='References an existing selection filter that is to be\napplied to the subscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='selection-filter-ref', description='This type is used to reference a selection filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('yp', 'selection-filter', []), yxpath.NodeTestStep('yp', 'filter-id', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='selection_filter_ref'),
    DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-subtree-filter', config=False, description='This parameter identifies the portions of the\ntarget datastore to retrieve.', if_feature=['sn:subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='datastore_subtree_filter'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-xpath-filter', config=False, description="This parameter contains an XPath expression identifying\nthe portions of the target datastore to retrieve.\n\nIf the expression returns a node set, all nodes in the\nnode set are selected by the filter.  Otherwise, if the\nexpression does not return a node set, the filter\ndoesn't select any nodes.\n\nThe expression is evaluated in the following XPath\ncontext:\n\no  The set of namespace declarations is the set of prefix\n   and namespace pairs for all YANG modules implemented\n   by the server, where the prefix is the YANG module\n   name and the namespace is as defined by the\n   'namespace' statement in the YANG module.\n\n   If the leaf is encoded in XML, all namespace\n   declarations in scope on the 'stream-xpath-filter'\n   leaf element are added to the set of namespace\n   declarations.  If a prefix found in the XML is\n   already present in the set of namespace declarations,\n   the namespace in the XML is used.\n\no  The set of variable bindings is empty.\n\no  The function library is comprised of the core\n   function library and the XPath functions defined in\n   Section 10 in RFC 7950.\n\no  The context node is the root node of the target\n   datastore.", if_feature=['sn:xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='datastore_xpath_filter'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stop-time', config=False, description="Identifies a time after which notification messages for a\nsubscription should not be sent.  If 'stop-time' is not\npresent, the notification messages will continue until the\nsubscription is terminated.  If 'replay-start-time' exists,\n'stop-time' must be for a subsequent time.  If\n'replay-start-time' doesn't exist, 'stop-time', when\nestablished, must be for a future time.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='stop_time'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='dscp', config=False, description='The desired network transport priority level.  This is the\npriority set on notification messages encapsulating the\nresults of the subscription.  This transport priority is\nshared for all receivers of a given subscription.', default='0', if_feature=['dscp'], is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='inet:dscp', description='The dscp type represents a Differentiated Services Code Point\nthat may be used for marking packets in a traffic stream.\nIn the value set and its semantics, this type is equivalent\nto the Dscp textual convention of the SMIv2.', reference='RFC 3289: Management Information Base for the Differentiated\n          Services Architecture\nRFC 2474: Definition of the Differentiated Services Field\n          (DS Field) in the IPv4 and IPv6 Headers\nRFC 2780: IANA Allocation Guidelines For Values In\n          the Internet Protocol and Related Headers', units=None, exts=[], builtin_type='uint8', default=None, ranges=Ranges([(0, 63)])), adata_name='dscp'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='weighting', config=False, description='Relative weighting for a subscription.  Larger weights get\nmore resources.  Allows an underlying transport layer to\nperform informed load-balance allocations between various\nsubscriptions.', if_feature=['qos'], is_key=False, mandatory=False, reference='RFC 7540: Hypertext Transfer Protocol Version 2 (HTTP/2),\n          Section 5.3.2', type=DTypeIntegerUnsigned(name='uint8', description=None, reference=None, units=None, exts=[], builtin_type='uint8', default=None, ranges=Ranges([(0, 255)])), adata_name='weighting'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='dependency', config=False, description="Provides the 'subscription-id' of a parent subscription.\nThe parent subscription has absolute precedence should\nthat parent have push updates ready to egress the publisher.\nIn other words, there should be no streaming of objects from\nthe current subscription if the parent has something ready\nto push.\n\nIf a dependency is asserted via configuration or via an RPC\nbut the referenced 'subscription-id' does not exist, the\ndependency is silently discarded.  If a referenced\nsubscription is deleted, this dependency is removed.", if_feature=['qos'], is_key=False, mandatory=False, reference='RFC 7540: Hypertext Transfer Protocol Version 2 (HTTP/2),\n          Section 5.3.1', type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='dependency'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='encoding', config=False, description='The type of encoding for the subscribed data.  If not\nincluded as part of the RPC, the encoding MUST be set by\nthe publisher to be the encoding used by this RPC.', is_key=False, mandatory=False, type=DTypeIdentityref(name='encoding', description='Specifies a data encoding, e.g., for a data subscription.', reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_subscribed_notifications_encoding], identities=_identities), adata_name='encoding'),
    DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='periodic', config=False, description='The publisher is requested to periodically notify the\nreceiver regarding the current values of the datastore\nas defined by the selection filter.', presence=True, adata_name='periodic', children=[
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='period', config=False, description='Duration of time that should occur between periodic\npush updates, in units of 0.01 seconds.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='period'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='anchor-time', config=False, description="Designates a timestamp before or after which a series\nof periodic push updates are determined.  The next\nupdate will take place at a point in time that is a\nmultiple of a period from the 'anchor-time'.\nFor example, for an 'anchor-time' that is set for the\ntop of a particular minute and a period interval of a\nminute, updates will be sent at the top of every\nminute that this subscription is active.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='anchor_time')
    ]),
    DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='on-change', config=False, description='The publisher is requested to notify the receiver\nregarding changes in values in the datastore subset as\ndefined by a selection filter.', presence=True, adata_name='on_change', children=[
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='dampening-period', config=False, description='Specifies the minimum interval between the assembly of\nsuccessive update records for a single receiver of a\nsubscription.  Whenever subscribed objects change and\na dampening-period interval (which may be zero) has\nelapsed since the previous update record creation for\na receiver, any subscribed objects and properties\nthat have changed since the previous update record\nwill have their current values marshalled and placed\nin a new update record.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='dampening_period'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='sync-on-start', config=False, description="When this object is set to 'false', (1) it restricts an\non-change subscription from sending 'push-update'\nnotifications and (2) pushing a full selection per the\nterms of the selection filter MUST NOT be done for\nthis subscription.  Only updates about changes\n(i.e., only 'push-change-update' notifications)\nare sent.  When set to 'true' (the default behavior),\nin order to facilitate a receiver's synchronization,\na full update is sent, via a 'push-update' notification,\nwhen the subscription starts.  After that,\n'push-change-update' notifications are exclusively sent,\nunless the publisher chooses to resync the subscription\nvia a new 'push-update' notification.", default='true', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, units=None, exts=[], builtin_type='boolean', default=None), adata_name='sync_on_start'),
        DLeafList(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='excluded-change', config=False, description="Used to restrict which changes trigger an update.  For\nexample, if a 'replace' operation is excluded, only the\ncreation and deletion of objects are reported.", min_elements=0, ordered_by='system', type=DTypeEnum(name='change-type', description="Specifies different types of datastore changes.\n\nThis type is based on the edit operations defined for\nYANG Patch, with the difference that it is valid for a\nreceiver to process an update record that performs a\n'create' operation on a datastore node the receiver believes\nexists or to process a delete on a datastore node the\nreceiver believes is missing.", reference='RFC 8072: YANG Patch Media Type, Section 2.5', units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'create':0, 'delete':1, 'insert':2, 'move':3, 'replace':4}), adata_name='excluded_change')
    ])
]), output=DOutput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', children=[
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='id', config=False, description='Identifier used for this subscription.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-start-time-revision', config=False, description="If a replay has been requested, this object represents\nthe earliest time covered by the event buffer for the\nrequested event stream.  The value of this object is the\n'replay-log-aged-time' if it exists.  Otherwise, it is\nthe 'replay-log-creation-time'.  All buffered event\nrecords after this time will be replayed to a receiver.\nThis object will only be sent if the starting time has\nbeen revised to be later than the time requested by the\nsubscriber.", if_feature=['replay'], is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='replay_start_time_revision')
]), adata_name='establish_subscription', children=[SRC_DNODE_CHILD_140, SRC_DNODE_CHILD_157])

SRC_DNODE_CHILD_158: DRpc = DRpc(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='modify-subscription', description="This RPC allows a subscriber to modify a dynamic\nsubscription's parameters.  If successful, the changed\nsubscription parameters remain in effect for the duration of\nthe subscription, until the subscription is again modified, or\nuntil the subscription is terminated.  In the case of an error\nor an inability to meet the modified parameters, the\nsubscription is not modified and the original subscription\nparameters remain in effect.  In that case, the RPC error MAY\ninclude 'error-info' suggested parameter hints that would have\na high likelihood of succeeding in a subsequent\n'modify-subscription' request.  A successful\n'modify-subscription' will return a suspended subscription to\nthe 'active' state.", input=DInput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', children=[
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='id', config=False, description='Identifier to use for this subscription.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-filter-name', config=False, description='References an existing event stream filter that is\nto be applied to an event stream for the\nsubscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='stream-filter-ref', description='This type is used to reference an event stream filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('sn', 'stream-filter', []), yxpath.NodeTestStep('sn', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='stream_filter_name'),
    DAnydata(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-subtree-filter', config=False, description='Event stream evaluation criteria encoded in the syntax of\na subtree filter as defined in RFC 6241, Section 6.\n\nThe subtree filter is applied to the representation of\nindividual, delineated event records as contained in the\nevent stream.\n\nIf the subtree filter returns a non-empty node set, the\nfilter matches the event record, and the event record is\nincluded in the notification message sent to the\nreceivers.', if_feature=['subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='stream_subtree_filter'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-xpath-filter', config=False, description="Event stream evaluation criteria encoded in the syntax of\nan XPath 1.0 expression.\n\nThe XPath expression is evaluated on the representation of\nindividual, delineated event records as contained in\nthe event stream.\n\nThe result of the XPath expression is converted to a\nboolean value using the standard XPath 1.0 rules.  If the\nboolean value is 'true', the filter matches the event\nrecord, and the event record is included in the\nnotification message sent to the receivers.\n\nThe expression is evaluated in the following XPath\ncontext:\n\n   o  The set of namespace declarations is the set of\n      prefix and namespace pairs for all YANG modules\n      implemented by the server, where the prefix is the\n      YANG module name and the namespace is as defined by\n      the 'namespace' statement in the YANG module.\n\n      If the leaf is encoded in XML, all namespace\n      declarations in scope on the 'stream-xpath-filter'\n      leaf element are added to the set of namespace\n      declarations.  If a prefix found in the XML is\n      already present in the set of namespace\n      declarations, the namespace in the XML is used.\n\n   o  The set of variable bindings is empty.\n\n   o  The function library is comprised of the core\n      function library and the XPath functions defined in\n      Section 10 in RFC 7950.\n\n   o  The context node is the root node.", if_feature=['xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='stream_xpath_filter'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore', config=False, description='Datastore from which to retrieve data.', is_key=False, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_datastores_datastore], identities=_identities), adata_name='datastore'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='selection-filter-ref', config=False, description='References an existing selection filter that is to be\napplied to the subscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='selection-filter-ref', description='This type is used to reference a selection filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('yp', 'selection-filter', []), yxpath.NodeTestStep('yp', 'filter-id', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='selection_filter_ref'),
    DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-subtree-filter', config=False, description='This parameter identifies the portions of the\ntarget datastore to retrieve.', if_feature=['sn:subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='datastore_subtree_filter'),
    DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-xpath-filter', config=False, description="This parameter contains an XPath expression identifying\nthe portions of the target datastore to retrieve.\n\nIf the expression returns a node set, all nodes in the\nnode set are selected by the filter.  Otherwise, if the\nexpression does not return a node set, the filter\ndoesn't select any nodes.\n\nThe expression is evaluated in the following XPath\ncontext:\n\no  The set of namespace declarations is the set of prefix\n   and namespace pairs for all YANG modules implemented\n   by the server, where the prefix is the YANG module\n   name and the namespace is as defined by the\n   'namespace' statement in the YANG module.\n\n   If the leaf is encoded in XML, all namespace\n   declarations in scope on the 'stream-xpath-filter'\n   leaf element are added to the set of namespace\n   declarations.  If a prefix found in the XML is\n   already present in the set of namespace declarations,\n   the namespace in the XML is used.\n\no  The set of variable bindings is empty.\n\no  The function library is comprised of the core\n   function library and the XPath functions defined in\n   Section 10 in RFC 7950.\n\no  The context node is the root node of the target\n   datastore.", if_feature=['sn:xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='datastore_xpath_filter'),
    DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stop-time', config=False, description="Identifies a time after which notification messages for a\nsubscription should not be sent.  If 'stop-time' is not\npresent, the notification messages will continue until the\nsubscription is terminated.  If 'replay-start-time' exists,\n'stop-time' must be for a subsequent time.  If\n'replay-start-time' doesn't exist, 'stop-time', when\nestablished, must be for a future time.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='stop_time'),
    DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='periodic', config=False, description='The publisher is requested to periodically notify the\nreceiver regarding the current values of the datastore\nas defined by the selection filter.', presence=True, adata_name='periodic', children=[
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='period', config=False, description='Duration of time that should occur between periodic\npush updates, in units of 0.01 seconds.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='period'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='anchor-time', config=False, description="Designates a timestamp before or after which a series\nof periodic push updates are determined.  The next\nupdate will take place at a point in time that is a\nmultiple of a period from the 'anchor-time'.\nFor example, for an 'anchor-time' that is set for the\ntop of a particular minute and a period interval of a\nminute, updates will be sent at the top of every\nminute that this subscription is active.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='anchor_time')
    ]),
    DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='on-change', config=False, description='The publisher is requested to notify the receiver\nregarding changes in values in the datastore subset as\ndefined by a selection filter.', presence=True, adata_name='on_change', children=[
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='dampening-period', config=False, description='Specifies the minimum interval between the assembly of\nsuccessive update records for a single receiver of a\nsubscription.  Whenever subscribed objects change and\na dampening-period interval (which may be zero) has\nelapsed since the previous update record creation for\na receiver, any subscribed objects and properties\nthat have changed since the previous update record\nwill have their current values marshalled and placed\nin a new update record.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='dampening_period')
    ])
]), adata_name='modify_subscription', children=[
    DInput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', adata_name='input', children=[
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='id', config=False, description='Identifier to use for this subscription.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-filter-name', config=False, description='References an existing event stream filter that is\nto be applied to an event stream for the\nsubscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='stream-filter-ref', description='This type is used to reference an event stream filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('sn', 'stream-filter', []), yxpath.NodeTestStep('sn', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='stream_filter_name'),
        DAnydata(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-subtree-filter', config=False, description='Event stream evaluation criteria encoded in the syntax of\na subtree filter as defined in RFC 6241, Section 6.\n\nThe subtree filter is applied to the representation of\nindividual, delineated event records as contained in the\nevent stream.\n\nIf the subtree filter returns a non-empty node set, the\nfilter matches the event record, and the event record is\nincluded in the notification message sent to the\nreceivers.', if_feature=['subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='stream_subtree_filter'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-xpath-filter', config=False, description="Event stream evaluation criteria encoded in the syntax of\nan XPath 1.0 expression.\n\nThe XPath expression is evaluated on the representation of\nindividual, delineated event records as contained in\nthe event stream.\n\nThe result of the XPath expression is converted to a\nboolean value using the standard XPath 1.0 rules.  If the\nboolean value is 'true', the filter matches the event\nrecord, and the event record is included in the\nnotification message sent to the receivers.\n\nThe expression is evaluated in the following XPath\ncontext:\n\n   o  The set of namespace declarations is the set of\n      prefix and namespace pairs for all YANG modules\n      implemented by the server, where the prefix is the\n      YANG module name and the namespace is as defined by\n      the 'namespace' statement in the YANG module.\n\n      If the leaf is encoded in XML, all namespace\n      declarations in scope on the 'stream-xpath-filter'\n      leaf element are added to the set of namespace\n      declarations.  If a prefix found in the XML is\n      already present in the set of namespace\n      declarations, the namespace in the XML is used.\n\n   o  The set of variable bindings is empty.\n\n   o  The function library is comprised of the core\n      function library and the XPath functions defined in\n      Section 10 in RFC 7950.\n\n   o  The context node is the root node.", if_feature=['xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='stream_xpath_filter'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore', config=False, description='Datastore from which to retrieve data.', is_key=False, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_datastores_datastore], identities=_identities), adata_name='datastore'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='selection-filter-ref', config=False, description='References an existing selection filter that is to be\napplied to the subscription.', is_key=False, mandatory=False, type=DTypeLeafref(name='selection-filter-ref', description='This type is used to reference a selection filter.', reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sn', 'filters', []), yxpath.NodeTestStep('yp', 'selection-filter', []), yxpath.NodeTestStep('yp', 'filter-id', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='selection_filter_ref'),
        DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-subtree-filter', config=False, description='This parameter identifies the portions of the\ntarget datastore to retrieve.', if_feature=['sn:subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='datastore_subtree_filter'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-xpath-filter', config=False, description="This parameter contains an XPath expression identifying\nthe portions of the target datastore to retrieve.\n\nIf the expression returns a node set, all nodes in the\nnode set are selected by the filter.  Otherwise, if the\nexpression does not return a node set, the filter\ndoesn't select any nodes.\n\nThe expression is evaluated in the following XPath\ncontext:\n\no  The set of namespace declarations is the set of prefix\n   and namespace pairs for all YANG modules implemented\n   by the server, where the prefix is the YANG module\n   name and the namespace is as defined by the\n   'namespace' statement in the YANG module.\n\n   If the leaf is encoded in XML, all namespace\n   declarations in scope on the 'stream-xpath-filter'\n   leaf element are added to the set of namespace\n   declarations.  If a prefix found in the XML is\n   already present in the set of namespace declarations,\n   the namespace in the XML is used.\n\no  The set of variable bindings is empty.\n\no  The function library is comprised of the core\n   function library and the XPath functions defined in\n   Section 10 in RFC 7950.\n\no  The context node is the root node of the target\n   datastore.", if_feature=['sn:xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='datastore_xpath_filter'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stop-time', config=False, description="Identifies a time after which notification messages for a\nsubscription should not be sent.  If 'stop-time' is not\npresent, the notification messages will continue until the\nsubscription is terminated.  If 'replay-start-time' exists,\n'stop-time' must be for a subsequent time.  If\n'replay-start-time' doesn't exist, 'stop-time', when\nestablished, must be for a future time.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='stop_time'),
        DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='periodic', config=False, description='The publisher is requested to periodically notify the\nreceiver regarding the current values of the datastore\nas defined by the selection filter.', presence=True, adata_name='periodic', children=[
            DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='period', config=False, description='Duration of time that should occur between periodic\npush updates, in units of 0.01 seconds.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='period'),
            DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='anchor-time', config=False, description="Designates a timestamp before or after which a series\nof periodic push updates are determined.  The next\nupdate will take place at a point in time that is a\nmultiple of a period from the 'anchor-time'.\nFor example, for an 'anchor-time' that is set for the\ntop of a particular minute and a period interval of a\nminute, updates will be sent at the top of every\nminute that this subscription is active.", is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), adata_name='anchor_time')
        ]),
        DContainer(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='on-change', config=False, description='The publisher is requested to notify the receiver\nregarding changes in values in the datastore subset as\ndefined by a selection filter.', presence=True, adata_name='on_change', children=[
            DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='dampening-period', config=False, description='Specifies the minimum interval between the assembly of\nsuccessive update records for a single receiver of a\nsubscription.  Whenever subscribed objects change and\na dampening-period interval (which may be zero) has\nelapsed since the previous update record creation for\na receiver, any subscribed objects and properties\nthat have changed since the previous update record\nwill have their current values marshalled and placed\nin a new update record.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='centiseconds', description='A period of time, measured in units of 0.01 seconds.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='dampening_period')
        ])
    ])
])

SRC_DNODE_CHILD_159: DRpc = DRpc(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='delete-subscription', description="This RPC allows a subscriber to delete a subscription that\nwas previously created by that same subscriber using the\n'establish-subscription' RPC.\n\nIf an error occurs, the server replies with an 'rpc-error'\nwhere the 'error-info' field MAY contain a\n'delete-subscription-error-info' structure.", input=DInput(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', children=[
