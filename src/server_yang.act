SRC_DNODE_CHILD_56: DContainer = DContainer(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='streams', config=False, description='Contains information on the built-in event streams provided by\nthe publisher.', presence=False, adata_name='streams', children=[
    DList(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream', key=['name'], config=False, description='Identifies the built-in event streams that are supported by\nthe publisher.', min_elements=0, ordered_by='system', adata_name='stream', children=[
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='name', config=False, description='A handle for a system-provided event stream made up of a\nsequential set of event records, each of which is\ncharacterized by its own domain and semantics.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='name'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='description', config=False, description='A description of the event stream, including such\ninformation as the type of event records that are\navailable in this event stream.', is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='description'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-support', config=False, description='Indicates that event record replay is available on this\nevent stream.', if_feature=['replay'], is_key=False, mandatory=False, type=DTypeEmpty(name='empty', description=None, reference=None, units=None, exts=[], builtin_type='empty', default=None), adata_name='replay_support'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-log-creation-time', config=False, description='The timestamp of the creation of the log used to support\nthe replay function on this event stream.  This time\nmight be earlier than the earliest available information\ncontained in the log.  This object is updated if the log\nresets for some reason.', if_feature=['replay'], is_key=False, mandatory=True, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), when='../replay-support', adata_name='replay_log_creation_time'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='replay-log-aged-time', config=False, description="The timestamp associated with the last event record that\nhas been aged out of the log.  This timestamp identifies\nhow far back in history this replay log extends, if it\ndoesn't extend back to the 'replay-log-creation-time'.\nThis object MUST be present if replay is supported and any\nevent records have been aged out of the log.", if_feature=['replay'], is_key=False, mandatory=False, type=DTypeString(name='yang:date-and-time', description="The date-and-time type is a profile of the ISO 8601\nstandard for representation of dates and times using the\nGregorian calendar.  The profile is defined by the\ndate-time production in Section 5.6 of RFC 3339 and the\nupdate defined in Section 2 of RFC 9557.  The value of\n60 for seconds is allowed only in the case of leap seconds.\n\nThe date-and-time type is compatible with the dateTime XML\nschema dateTime type with the following notable exceptions:\n\n(a) The date-and-time type does not allow negative years.\n\n(b) The time-offset Z indicates that the date-and-time\n    value is reported in UTC and that the local time zone\n    reference point is unknown.  The time-offset +00:00\n    indicates that the date-and-time value is reported in\n    UTC and that the local time zone reference point is UTC\n    (see Section 2 of RFC 9557).\n\nThis type is not equivalent to the DateAndTime textual\nconvention of the SMIv2 since RFC 3339 uses a different\nseparator between full-date and full-time and provides\nhigher resolution of time-secfrac.\n\nThe canonical format for date-and-time values with a known\ntime zone uses a numeric time zone offset that is calculated\nusing the device's configured known offset to UTC time.  A\nchange of the device's offset to UTC time will cause\ndate-and-time values to change accordingly.  Such changes\nmight happen periodically if a server automatically follows\ndaylight saving time (DST) time zone offset changes.  The\ncanonical format for date-and-time values reported in UTC\nwith an unknown local time zone offset SHOULD use the\ntime-offset Z and MAY use -00:00 for backwards\ncompatibility.", reference='ISO 8601: Data elements and interchange formats -- Information\n          interchange -- Representation of dates and times\nRFC 3339: Date and Time on the Internet: Timestamps\nRFC 9557: Date and Time on the Internet: Timestamps\n          with Additional Information\nRFC 2579: Textual Conventions for SMIv2\nXSD-TYPES: XML Schema Definition Language (XSD) 1.1\n           Part 2: Datatypes', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?', pcre='^([0-9]{{4}}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?)$', invert=False)]), when='../replay-support', adata_name='replay_log_aged_time')
    ])
])

SRC_DNODE_CHILD_57: DContainer = DContainer(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='filters', config=True, description='Contains a list of configurable filters that can be applied to\nsubscriptions.  This facilitates the reuse of complex filters\nonce defined.', presence=False, adata_name='filters', children=[
    DList(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-filter', key=['name'], config=True, description='A list of preconfigured filters that can be applied to\nsubscriptions.', min_elements=0, ordered_by='system', adata_name='stream_filter', children=[
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='name', config=True, description='A name to differentiate between filters.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='name'),
        DAnydata(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-subtree-filter', config=True, description='Event stream evaluation criteria encoded in the syntax of\na subtree filter as defined in RFC 6241, Section 6.\n\nThe subtree filter is applied to the representation of\nindividual, delineated event records as contained in the\nevent stream.\n\nIf the subtree filter returns a non-empty node set, the\nfilter matches the event record, and the event record is\nincluded in the notification message sent to the\nreceivers.', if_feature=['subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='stream_subtree_filter'),
        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='stream-xpath-filter', config=True, description="Event stream evaluation criteria encoded in the syntax of\nan XPath 1.0 expression.\n\nThe XPath expression is evaluated on the representation of\nindividual, delineated event records as contained in\nthe event stream.\n\nThe result of the XPath expression is converted to a\nboolean value using the standard XPath 1.0 rules.  If the\nboolean value is 'true', the filter matches the event\nrecord, and the event record is included in the\nnotification message sent to the receivers.\n\nThe expression is evaluated in the following XPath\ncontext:\n\n   o  The set of namespace declarations is the set of\n      prefix and namespace pairs for all YANG modules\n      implemented by the server, where the prefix is the\n      YANG module name and the namespace is as defined by\n      the 'namespace' statement in the YANG module.\n\n      If the leaf is encoded in XML, all namespace\n      declarations in scope on the 'stream-xpath-filter'\n      leaf element are added to the set of namespace\n      declarations.  If a prefix found in the XML is\n      already present in the set of namespace\n      declarations, the namespace in the XML is used.\n\n   o  The set of variable bindings is empty.\n\n   o  The function library is comprised of the core\n      function library and the XPath functions defined in\n      Section 10 in RFC 7950.\n\n   o  The context node is the root node.", if_feature=['xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='stream_xpath_filter')
    ]),
    DList(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='selection-filter', key=['filter-id'], config=True, description='A list of preconfigured filters that can be applied\nto datastore subscriptions.', min_elements=0, ordered_by='system', adata_name='selection_filter', children=[
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='filter-id', config=True, description='An identifier to differentiate between selection\nfilters.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='filter_id'),
        DAnydata(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-subtree-filter', config=True, description='This parameter identifies the portions of the\ntarget datastore to retrieve.', if_feature=['sn:subtree'], reference='RFC 6241: Network Configuration Protocol (NETCONF),\n          Section 6', adata_name='datastore_subtree_filter'),
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='datastore-xpath-filter', config=True, description="This parameter contains an XPath expression identifying\nthe portions of the target datastore to retrieve.\n\nIf the expression returns a node set, all nodes in the\nnode set are selected by the filter.  Otherwise, if the\nexpression does not return a node set, the filter\ndoesn't select any nodes.\n\nThe expression is evaluated in the following XPath\ncontext:\n\no  The set of namespace declarations is the set of prefix\n   and namespace pairs for all YANG modules implemented\n   by the server, where the prefix is the YANG module\n   name and the namespace is as defined by the\n   'namespace' statement in the YANG module.\n\n   If the leaf is encoded in XML, all namespace\n   declarations in scope on the 'stream-xpath-filter'\n   leaf element are added to the set of namespace\n   declarations.  If a prefix found in the XML is\n   already present in the set of namespace declarations,\n   the namespace in the XML is used.\n\no  The set of variable bindings is empty.\n\no  The function library is comprised of the core\n   function library and the XPath functions defined in\n   Section 10 in RFC 7950.\n\no  The context node is the root node of the target\n   datastore.", if_feature=['sn:xpath'], is_key=False, mandatory=False, reference='XML Path Language (XPath) Version 1.0\n(https://www.w3.org/TR/1999/REC-xpath-19991116)\nRFC 7950: The YANG 1.1 Data Modeling Language,\n          Section 10', type=DTypeString(name='yang:xpath1.0', description='This type represents an XPATH 1.0 expression.\n\nWhen a schema node is defined that uses this type, the\ndescription of the schema node MUST specify the XPath\ncontext in which the XPath expression is evaluated.', reference='XPATH: XML Path Language (XPath) Version 1.0', units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='datastore_xpath_filter')
    ])
])

SRC_DNODE_CHILD_60: DLeaf = DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='id', config=True, description='Identifier of a subscription; unique in a given\npublisher.', is_key=True, mandatory=False, type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id')

