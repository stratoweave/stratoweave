        DLeaf(module='ietf-subscribed-notifications', namespace='urn:ietf:params:xml:ns:yang:ietf-subscribed-notifications', prefix='sn', name='id', config=False, description="Identifier of the subscription that is to be deleted.\nOnly subscriptions that were created using\n'establish-subscription' from the same origin as this RPC\ncan be deleted via this RPC.", is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id')
    ])
