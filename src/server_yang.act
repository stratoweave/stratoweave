        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='version', config=False, description="Version of the schema requested.  If this parameter is not\npresent, and more than one version of the schema exists on\nthe server, a 'data-not-unique' error is returned, as\ndescribed above.", is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='version'),
        DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='format', config=False, description="The data modeling language of the schema.  If this\nparameter is not present, and more than one formats of\nthe schema exists on the server, a 'data-not-unique' error\nis returned, as described above.", is_key=False, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_netconf_monitoring_schema_format], identities=_identities), adata_name='format')
    ]),
