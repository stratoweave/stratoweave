]), output=DOutput(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', children=[
    DAnyxml(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='data', config=False, description='Contains the schema content.', adata_name='data')
