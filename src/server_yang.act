]), adata_name='resync_subscription', children=[
    DInput(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', adata_name='input', children=[
        DLeaf(module='ietf-yang-push', namespace='urn:ietf:params:xml:ns:yang:ietf-yang-push', prefix='yp', name='id', config=False, description='Identifier of the subscription that is to be resynced.', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='sn:subscription-id', description='A type for subscription identifiers.', reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), adata_name='id')
    ])
])

SRC_DNODE_CHILD_162: DRpc = DRpc(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='get-schema', description="This operation is used to retrieve a schema from the\nNETCONF server.\n\nPositive Response:\n  The NETCONF server returns the requested schema.\n\nNegative Response:\n  If requested schema does not exist, the <error-tag> is\n  'invalid-value'.\n\n  If more than one schema matches the requested parameters, the\n  <error-tag> is 'operation-failed', and <error-app-tag> is\n  'data-not-unique'.", input=DInput(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', children=[
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='identifier', config=False, description='Identifier for the schema list entry.', is_key=False, mandatory=True, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='identifier'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='version', config=False, description="Version of the schema requested.  If this parameter is not\npresent, and more than one version of the schema exists on\nthe server, a 'data-not-unique' error is returned, as\ndescribed above.", is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='version'),
    DLeaf(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='format', config=False, description="The data modeling language of the schema.  If this\nparameter is not present, and more than one formats of\nthe schema exists on the server, a 'data-not-unique' error\nis returned, as described above.", is_key=False, mandatory=False, type=DTypeIdentityref(name='identityref', description=None, reference=None, units=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_netconf_monitoring_schema_format], identities=_identities), adata_name='format')
]), output=DOutput(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', children=[
    DAnyxml(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', name='data', config=False, description='Contains the schema content.', adata_name='data')
]), adata_name='get_schema', children=[
    DInput(module='ietf-netconf-monitoring', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-monitoring', prefix='ncm', adata_name='input', children=[
