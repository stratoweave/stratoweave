import file

import swyang
import yang
import adapters.software_iosxe_yang as swxe_yang
import adapters.iosxe_cli_yang as xecli_yang
import adapters.platform_iosxr_yang as xr_yang
import adapters.platform_srlinux_yang as srl_yang
import adapters.platform_sros_yang as sros_yang
import adapters.platform_arcos_yang as arcos_yang
from yang.transform_filter_schema import filter_schema


actor main(env):
    wfc = file.WriteFileCap(file.FileCap(env.cap))

    proc def __startup__():
        try:
            schema_yang = [swyang.rfs, swyang.ssh, swyang.stratoweave, swyang.ietf_inet_types, swyang.ietf_yang_types]
            y = yang.compile_with_sources(schema_yang)

            # Emit the oper view first: the config-only prdaclass below strips
            # config-false nodes from the compiled tree as it prints.
            oper_src = y.root.prdaclass(schema_yang=y.sources, loose=True, include_state=True, root_path=["stratoweave-rfs:device"]).encode()

            wfo = file.WriteFile(wfc, "src/device_oper.act")
            await async wfo.write(oper_src)
            await async wfo.close()

            src = y.root.prdaclass(schema_yang=y.sources, root_path=["stratoweave-rfs:device"]).encode()

            wf = file.WriteFile(wfc, "src/device_meta_config.act")
            await async wf.write(src)
            await async wf.close()

            # Typed bindings for the RPCs the IOS-XE software adapter sends. Built
            # from the same module text the device type gets, so the adapter cannot
            # drift from the schema it is validated against. include_state, because
            # xcopy declares an output and the generated callback has to carry it.
            iosxe_rpc_schema = [swxe_yang.xcopy_rpc, swxe_yang.install_rpc, swxe_yang.cisco_rpc]
            yi = yang.compile_with_sources(iosxe_rpc_schema)
            iosxe_src = (yi.root.prdaclass(schema_yang=yi.sources,
                                           include_state=True).strip() + "\n").encode()

            wfi = file.WriteFile(wfc, "src/adapters/software_iosxe_rpc.act")
            await async wfi.write(iosxe_src)
            await async wfi.close()

            # Typed operational data and schema-safe filter paths for the state the
            # IOS-XE software adapter polls.
            iosxe_oper_schema = [swxe_yang.install_oper, swxe_yang.device_hardware_oper,
                                 swxe_yang.platform_software_oper]
            yo = yang.compile_with_sources(iosxe_oper_schema)
            iosxe_oper_src = (yo.root.prdaclass(schema_yang=yo.sources,
                                               loose=True,
                                               include_state=True,
                                               include_subs=True).strip() + "\n").encode()

            wfio = file.WriteFile(wfc, "src/adapters/software_iosxe_oper.act")
            await async wfio.write(iosxe_oper_src)
            await async wfio.close()

            # Typed data for what the IOS XE CLI adapter reads and runs: it builds
            # its replies with these classes.
            yx = yang.compile_with_sources(xecli_yang.models)
            xecli_src = (yx.root.prdaclass(schema_yang=yx.sources,
                                           include_state=True).strip() + "\n").encode()
            wfx = file.WriteFile(wfc, "src/adapters/iosxe_cli_data.act")
            await async wfx.write(xecli_src)
            await async wfx.close()

            # Typed operational data and schema-safe filter paths for the state
            # each platform probe reads, from the YANG the probe ships.
            platform_schemas = [
                (path="src/adapters/platform_iosxr_oper.act", models=xr_yang.models),
                (path="src/adapters/platform_srlinux_oper.act", models=srl_yang.models),
                (path="src/adapters/platform_sros_oper.act", models=sros_yang.models),
                (path="src/adapters/platform_arcos_oper.act", models=arcos_yang.models),
            ]
            for ps in platform_schemas:
                yp = yang.compile_with_sources(ps.models)
                plat_src = (yp.root.prdaclass(schema_yang=yp.sources,
                                              loose=True,
                                              include_state=True,
                                              include_subs=True).strip() + "\n").encode()
                wfp = file.WriteFile(wfc, ps.path)
                await async wfp.write(plat_src)
                await async wfp.close()

            rcmon_schema = [swyang.ietf_restconf_monitoring, swyang.ietf_yang_types, swyang.ietf_inet_types]
            yr = yang.compile_with_sources(rcmon_schema)
            rcmon_src = yr.root.prdaclass(schema_yang=yr.sources, include_state=True).encode()

            wfr = file.WriteFile(wfc, "src/ietf_restconf_monitoring.act")
            await async wfr.write(rcmon_src)
            await async wfr.close()

            yanglib_schema = [swyang.ietf_yang_library, swyang.ietf_datastores, swyang.ietf_yang_types, swyang.ietf_inet_types]
            yl = yang.compile_with_sources(yanglib_schema)
            filter_schema(yl.root, ["/yanglib:yang-library", "/yanglib:modules-state"])
            yanglib_src = yl.root.prdaclass(schema_yang=yl.sources, include_state=True).encode()

            wfl = file.WriteFile(wfc, "src/ietf_yang_library.act")
            await async wfl.write(yanglib_src)
            await async wfl.close()

            # The schema and sources of the modules that the NETCONF server
            # implements in its own code, and of the modules that they import.
            # The server lists them in its YANG library and serves them with
            # <get-schema>.
            server_schema = [swyang.ietf_netconf_monitoring, swyang.ietf_subscribed_notifications, swyang.ietf_yang_push,
                             swyang.ietf_restconf, swyang.ietf_yang_patch, swyang.ietf_interfaces, swyang.ietf_ip,
                             swyang.ietf_netconf_acm, swyang.ietf_network_instance, swyang.ietf_yang_schema_mount,
                             swyang.ietf_datastores, swyang.ietf_yang_types, swyang.ietf_inet_types]
            ys = yang.compile_with_sources(server_schema)
            server_src = ys.root.prschema(schema_yang=ys.sources).encode()

            wfs = file.WriteFile(wfc, "src/server_yang.act")
            await async wfs.write(server_src)
            await async wfs.close()
        except Exception as exc:
            print(exc, err=True)
            env.exit(1)
        else:
            env.exit(0)

    __startup__()
