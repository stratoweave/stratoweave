"""Pruned SR Linux YANG that the SR Linux platform probe reads.

The namespaces and the node names are the real modules'. As on the device,
information and chassis are augments from their own modules. An SR Linux
device type whose schema lacks these modules adds models; one that has the
real modules already must keep the nodes below in them.
"""

system = r"""module srl_nokia-system {
  yang-version "1.1";
  namespace "urn:nokia.com:srlinux:general:system";
  prefix srl_nokia-system;

  description
    "Pruned to the system container, which srl_nokia-system-info augments.";

  container system {
  }
}
"""

system_info = r"""module srl_nokia-system-info {
  yang-version "1.1";
  namespace "urn:nokia.com:srlinux:linux:system-info";
  prefix srl_nokia-system-info;

  import srl_nokia-system {
    prefix srl-system;
  }

  description
    "Pruned to the software version.";

  augment "/srl-system:system" {
    container information {
      config false;
      leaf version {
        description "The release and the build, e.g.
          v25.3.2-312-ga0c5002f15.";
        type string;
      }
    }
  }
}
"""

platform = r"""module srl_nokia-platform {
  yang-version "1.1";
  namespace "urn:nokia.com:srlinux:chassis:platform";
  prefix srl_nokia-platform;

  description
    "Pruned to the platform container, which srl_nokia-platform-chassis
     augments.";

  container platform {
  }
}
"""

platform_chassis = r"""module srl_nokia-platform-chassis {
  yang-version "1.1";
  namespace "urn:nokia.com:srlinux:chassis:platform-chassis";
  prefix srl_nokia-platform-chassis;

  import srl_nokia-platform {
    prefix srl-platform;
  }

  description
    "Pruned to the chassis type and serial number.";

  augment "/srl-platform:platform" {
    container chassis {
      config false;
      leaf type {
        description "The chassis type, e.g. 7220 IXR-D2L.";
        type string;
      }
      leaf serial-number {
        type string;
      }
    }
  }
}
"""

## Modules an app adds to its SR Linux device type for the platform probe.
models: list[str] = [
    system,
    system_info,
    platform,
    platform_chassis,
]
