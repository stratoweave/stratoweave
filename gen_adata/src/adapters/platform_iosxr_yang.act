"""Pruned IOS XR YANG that the IOS XR platform probe reads.

The namespaces and the node names are the real modules'. An IOS XR device
type whose schema lacks these modules adds models; one that has the real
modules already must keep the nodes below in them.
"""

install_oper = r"""module Cisco-IOS-XR-install-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XR-install-oper";
  prefix install-oper;

  description
    "Pruned to the release and the chassis product id that install/version
     reports, as 'show version' does.";

  container install {
    config false;
    container version {
      leaf label {
        description "The release, e.g. 25.3.1.";
        type string;
      }
      leaf chassis-pid {
        description "The chassis product id, e.g. XRd-CP-C-01.";
        type string;
      }
    }
  }
}
"""

invmgr_oper = r"""module Cisco-IOS-XR-invmgr-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XR-invmgr-oper";
  prefix invmgr-oper;

  description
    "Pruned to the model and serial number of each rack, as 'show inventory'
     prints them for 'Rack 0'.";

  container inventory {
    config false;
    container racks {
      list rack {
        key "name";
        leaf name {
          type string;
        }
        container attributes {
          container inv-basic-bag {
            leaf model-name {
              description "The chassis product id, e.g. R-IOSXRV9000-CC.";
              type string;
            }
            leaf serial-number {
              type string;
            }
          }
        }
      }
    }
  }
}
"""

shellutil_oper = r"""module Cisco-IOS-XR-shellutil-oper {
  yang-version "1.1";
  namespace "http://cisco.com/ns/yang/Cisco-IOS-XR-shellutil-oper";
  prefix shellutil-oper;

  description
    "Pruned to the clock, as 'show clock' prints it, and the uptime that
     system-time reports.";

  container system-time {
    config false;
    container clock {
      leaf year {
        type uint16;
      }
      leaf month {
        type uint8;
      }
      leaf day {
        type uint8;
      }
      leaf hour {
        type uint8;
      }
      leaf minute {
        type uint8;
      }
      leaf second {
        type uint8;
      }
      leaf time-zone {
        description "The time zone of the clock, e.g. UTC.";
        type string;
      }
    }
    container uptime {
      leaf uptime {
        description "Seconds since the system last started.";
        type uint32;
        units "second";
      }
    }
  }
}
"""

## Modules an app adds to its IOS XR device type for the platform probe.
models: list[str] = [
    install_oper,
    invmgr_oper,
    shellutil_oper,
]
