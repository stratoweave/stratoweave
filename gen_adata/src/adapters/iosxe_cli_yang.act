"""The YANG module of the IOS XE CLI adapter.

A device type that uses the adapter adds models to its schema.
"""

NS = "http://stratoweave.org/yang/stratoweave-iosxe-cli"
MODULE = "stratoweave-iosxe-cli"

iosxe_cli = r"""module stratoweave-iosxe-cli {
  yang-version "1.1";
  namespace "http://stratoweave.org/yang/stratoweave-iosxe-cli";
  prefix xecli;

  description
    "Data that the StratoWeave IOS XE CLI adapter reads with exec commands
     over SSH, and the commands that it runs on request.";

  container file-systems {
    config false;
    list file-system {
      key "name";
      description
        "The top directory of a file system, as 'dir' shows it. A read
         that does not select file systems by name gets bootflash:.";
      leaf name {
        type string;
        description "The file system name with its colon, e.g. bootflash:.";
      }
      list file {
        key "name";
        description "A regular file. Directories are not included.";
        leaf name {
          type string;
        }
        leaf size {
          type uint64;
          units "bytes";
        }
        leaf modified {
          type string;
          description
            "The modification time in the yang:date-and-time format, e.g.
             2026-11-07T20:28:06+00:00.";
        }
      }
    }
  }

  container version {
    config false;
    description "The software and the hardware, as 'show version' shows them.";
    leaf version {
      type string;
      description "The IOS XE release, e.g. 17.18.02.";
    }
    leaf model {
      type string;
      description "The chassis model, e.g. C8000V.";
    }
    leaf serial-number {
      type string;
      description "The processor board ID.";
    }
    leaf system-image {
      type string;
      description "The file that the device booted, e.g. bootflash:packages.conf.";
    }
  }

  container bootvar {
    config false;
    description "The boot variables, as 'show bootvar' shows them.";
    leaf-list boot {
      type string;
      ordered-by user;
      description
        "The files of the BOOT variable, in the order that ROMMON tries
         them, e.g. bootflash:packages.conf. The number after each file in
         the output is not kept.";
    }
    leaf config-file {
      type string;
      description "The CONFIG_FILE variable. Absent when it does not exist.";
    }
    leaf bootldr {
      type string;
      description "The BOOTLDR variable. Absent when it does not exist.";
    }
    leaf configuration-register {
      type string;
      description "The configuration register, e.g. 0x2102.";
    }
    leaf next-configuration-register {
      type string;
      description
        "The configuration register at the next reload, when the output
         gives one.";
    }
  }

  container install-summary {
    config false;
    description "The installed packages, as 'show install summary' shows them.";
    list location {
      key "name";
      description "A part of the device that runs software, e.g. R0.";
      leaf name {
        type string;
      }
      list package {
        key "name";
        leaf name {
          type string;
          description "The file name or the version, e.g. 17.09.05a.0.6476.";
        }
        leaf type {
          type string;
          description "The package type, e.g. IMG.";
        }
        leaf state {
          type enumeration {
            enum inactive;
            enum activated-uncommitted;
            enum activated-committed;
            enum deactivated-uncommitted;
          }
        }
      }
    }
    leaf auto-abort-timer {
      type string;
      description "The state of the auto-abort timer, e.g. inactive.";
    }
  }

  rpc install {
    description
      "Run an 'install' command. Only letters, digits and the characters
       ._~:/@%+=,- are permitted in a file, a URL or a label. A command that
       activates software reloads the device.";
    input {
      choice command {
        mandatory true;
        container add {
          presence "install add";
          leaf file {
            type string;
            mandatory true;
            description
              "A package file or a URL, e.g. bootflash:x.bin or
               http://host/x.bin.";
          }
          leaf activate {
            type empty;
          }
          leaf commit {
            type empty;
            description "Commit after the activation. It needs activate.";
          }
          leaf prompt-level {
            type enumeration {
              enum none;
            }
          }
        }
        container activate {
          presence "install activate";
          leaf file {
            type string;
          }
          leaf auto-abort-timer {
            type uint16 {
              range "30..1200";
            }
            units "minutes";
          }
          leaf prompt-level {
            type enumeration {
              enum none;
            }
          }
        }
        leaf commit {
          type empty;
        }
        leaf abort {
          type empty;
        }
        container remove {
          presence "install remove";
          choice what {
            mandatory true;
            leaf file {
              type string;
            }
            leaf inactive {
              type empty;
            }
          }
        }
        container rollback {
          presence "install rollback";
          choice to {
            mandatory true;
            leaf base {
              type empty;
            }
            leaf committed {
              type empty;
            }
            leaf id {
              type uint32;
            }
            leaf label {
              type string;
            }
          }
        }
      }
    }
    output {
      leaf reloading {
        type boolean;
        description
          "True if the device reloads to finish the command: it says so, or
           it ends the session early.";
      }
    }
  }

  rpc verify {
    description
      "Run 'verify' on a file. With an algorithm, the device computes the
       checksum of the file, and with a hash it also compares the checksum
       with the hash. Without an algorithm, the device checks an IOS XE
       image: it compares the hashes that the image holds with the hashes of
       its content, and it checks the digital signature of the image.";
    input {
      leaf file-system {
        type string;
        mandatory true;
        description "The file system name with its colon, e.g. bootflash:.";
      }
      leaf file {
        type string;
        mandatory true;
        description
          "The name of a file in the top directory. Only letters, digits,
           dots, underscores and hyphens are permitted.";
      }
      leaf algorithm {
        type enumeration {
          enum md5;
          enum sha512;
        }
      }
      leaf hash {
        type string;
        description
          "The expected checksum in hexadecimal digits: 32 for md5, 128 for
           sha512. It needs an algorithm.";
      }
    }
    output {
      leaf digest {
        type string;
        description
          "The checksum that the device computed, in lower-case hexadecimal
           digits. Only with an algorithm.";
      }
      leaf verified {
        type boolean;
        description
          "With a hash: true if the checksum is equal to the hash. Without an
           algorithm: true if each computed hash is equal to the hash that the
           image holds and the device verified the digital signature.";
      }
    }
  }
}
"""

## Modules an app adds to the device type that uses the IOS XE CLI adapter.
models: list[str] = [
    iosxe_cli,
]
