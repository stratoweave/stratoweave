"""Pruned SR OS YANG that the SR OS platform probe reads.

The namespace and the node names are the real nokia-state module's. An SR OS
device type whose schema lacks nokia-state adds models; one that has the real
module already must keep the nodes below in it.
"""

state = r"""module nokia-state {
  yang-version "1.1";
  namespace "urn:nokia.com:sros:ns:yang:sr:state";
  prefix state;

  description
    "Pruned to the platform, the release and the chassis serial numbers.";

  container state {
    config false;
    container system {
      leaf platform {
        description "The chassis type, e.g. 7750 SR-1.";
        type string;
      }
      container version {
        leaf version-number {
          description "The image type and the release, e.g. C-23.10.R1.";
          type string;
        }
      }
    }
    list chassis {
      key "chassis-class chassis-number";
      leaf chassis-class {
        description "An enumeration in the real module. A router chassis is
          'router'.";
        type string;
      }
      leaf chassis-number {
        type uint32;
      }
      container hardware-data {
        leaf serial-number {
          type string;
        }
      }
    }
  }
}
"""

## Modules an app adds to its SR OS device type for the platform probe.
models: list[str] = [
    state,
]
