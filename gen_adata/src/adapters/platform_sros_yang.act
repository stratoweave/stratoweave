"""Pruned SR OS YANG that the SR OS platform probe reads.

The namespace and the node names are the real nokia-state module's. An SR OS
device type whose schema lacks nokia-state adds models; one that has the real
module already must keep the nodes below in it.
"""

state = r"""module nokia-state {
  yang-version "1.1";
  namespace "urn:nokia.com:sros:ns:yang:sr:state";
  prefix state;

  description
    "Pruned to the platform, the release, the chassis serial numbers and
     the boot of the active CPM.";

  container state {
    config false;
    container system {
      leaf platform {
        description "The chassis type, e.g. 7750 SR-1.";
        type string;
      }
      container version {
        leaf version-number {
          description "The image type and the release, e.g. C-23.10.R1.";
          type string;
        }
      }
      leaf active-cpm-slot {
        description "The slot of the active CPM, A to D.";
        type string;
      }
    }
    list cpm {
      key "cpm-slot";
      leaf cpm-slot {
        type string;
      }
      container hardware-data {
        leaf software-last-boot-time {
          description "When the software on the CPM last booted, a
            yang:date-and-time by the device's clock.";
          type string;
        }
      }
    }
    list chassis {
      key "chassis-class chassis-number";
      leaf chassis-class {
        description "An enumeration in the real module. A router chassis is
          'router'.";
        type string;
      }
      leaf chassis-number {
        type uint32;
      }
      container hardware-data {
        leaf serial-number {
          type string;
        }
      }
    }
  }
}
"""

## Modules an app adds to its SR OS device type for the platform probe.
models: list[str] = [
    state,
]
