"""Generated oper subscriptions through a NETCONF device provider."""

import testing
import yang
import yang.gdata as gdata
import stratoweave.device as swdev
import stratoweave.adapters.netconf as netconf
import stratoweave.swyang as swyang
import stratoweave.ttt as ttt
import fleetmgr.layers.t_1 as t_1
import fleetmgr.layers.y_1 as y_1
import fleetmgr.layers.y_1_oper as y1_oper
import fleetmgr.devices.flotilla_oper as oper

from stratoweave.device_meta_config import \
    stratoweave_rfs__device_entry as DeviceMetaConfig, \
    stratoweave_rfs__device__credentials as Credentials, \
    stratoweave_rfs__device__mock as Mock
from fleetmgr.layers.y_1 import \
    stratoweave_rfs__rfs__device__credentials as InputCredentials


mut def telemetry(states: list[(str, str)]) -> gdata.Node:
    root = oper.root()
    for name, status in states:
        device = root.device.create(name, description="not selected")
        device.software.state.attempt.create(0, status=status, stage="prepare")
    return root.to_gdata()


def first_attempt(state: oper.stratoweave_rfs__device__software__state) -> (?str, ?str):
    """The status and the stage of attempt 0 in state."""
    a = state.attempt.get(u64(0))
    if a is not None:
        return (a.status, a.stage)
    return (None, None)


def new_device(t: testing.EnvT, name: str, on_change: bool) -> swdev.DeviceMgr:
    # The generated model already includes the inet-types and yang-types
    # imports. Add YANG-Push only for the native on-change test.
    push_models = [swyang.ietf_datastores, swyang.ietf_yang_push,
                   swyang.ietf_subscribed_notifications, swyang.ietf_restconf,
                   swyang.ietf_yang_patch, swyang.ietf_interfaces,
                   swyang.ietf_netconf_acm, swyang.ietf_network_instance,
                   swyang.ietf_ip, swyang.ietf_yang_schema_mount]
    schema = yang.compile(oper.src_yang() + (push_models if on_change else []))
    dev = swdev.DeviceMgr({"flotilla": swdev.DeviceType(
        name="flotilla", adapter_type=netconf.NetconfAdapter, src_dnode=schema,
    )}, None, name, t.log_handler, lambda name: None, swdev.SchemaRegistry())
    dev.set_dmc(DeviceMetaConfig(name, Credentials("admin", "admin"),
                                type="flotilla", mock=Mock(enabled=True)))
    return dev


actor GeneratedOperDelivery(t: testing.EnvT, on_change: bool):
    dev = new_device(t, "generated-oper", on_change)
    manager = gdata.SubscriptionManager(dev.tree_provider(), "generated-oper")
    var server: ?netconf.NetconfMockServer = None
    var phase = 0
    var seen: set[(str, str)] = set()
    var done = False

    def fail(msg: str):
        if not done:
            done = True
            manager.close()
            t.failure(ValueError(msg))

    def received(kind: str, name: str, status: ?str, stage: ?str):
        if done:
            return
        if status is not None and stage != "prepare":
            fail("typed instance lost the other selected leaf")
        elif phase == 0:
            if name not in ["a", "b"] or status != "in-progress":
                fail("unexpected typed baseline")
            else:
                seen.add((kind, name))
        elif phase == 1:
            if name == "a" and status == "succeeded":
                seen.add((kind, name))
                if len(seen) == 2:
                    phase = 2
                    seen = set()
                    server!.set_oper_ds(telemetry([("a", "succeeded")]))
            elif on_change:
                fail("on-change delivered an unaffected instance")
        elif phase == 2:
            if name == "b" and status is None:
                seen.add((kind, name))
                if len(seen) == 2:
                    phase = 3
                    seen = set()
                    server!.set_oper_ds(telemetry([]))
            elif on_change:
                fail("on-change removal delivered an unaffected instance")
        elif phase == 3:
            if name == "a" and status is None:
                seen.add((kind, name))
                if len(seen) == 2:
                    done = True
                    manager.close()
                    t.success()
            elif on_change:
                fail("empty feed did not remove the last typed instance")

    def on_device(keys: ?(device_name: str), device: ?oper.stratoweave_rfs__device_entry, err: ?Exception):
        if err is not None or keys is None:
            fail("typed device callback failed: {err}")
        elif device is not None:
            if device.name != keys!.device_name or device.description is not None:
                fail("typed device keys or selected fields are wrong")
            else:
                got = first_attempt(device.software.state)
                received("device", keys!.device_name, got.0, got.1)
        else:
            received("device", keys!.device_name, None, None)

    def on_state(keys: ?(device_name: str), state: ?oper.stratoweave_rfs__device__software__state, err: ?Exception):
        if err is not None or keys is None:
            fail("typed state callback failed: {err}")
        elif state is not None:
            got = first_attempt(state)
            received("state", keys!.device_name, got.0, got.1)
        else:
            received("state", keys!.device_name, None, None)

    def synced():
        if phase != 0 or seen != {("device", "a"), ("device", "b"),
                                  ("state", "a"), ("state", "b")}:
            fail("synced preceded both generated destinations' baselines")
            return
        phase = 1
        seen = set()
        server!.set_oper_ds(telemetry([("a", "succeeded"), ("b", "in-progress")]))

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(telemetry([("a", "in-progress"), ("b", "in-progress")]))
            state = oper.subs.device.software.state
            period = None if on_change else 0.05
            want = {state.attempt.status.subscribe(period=period),
                    state.attempt.stage.subscribe(period=period)}
            manager.declare({oper.subs.device.dst(on_device).deliver(want),
                             state.dst(on_state).deliver(want)}, synced=synced)
        else:
            fail("no NETCONF adapter")

    def timeout():
        fail("timed out in phase {phase}: {seen}")

    start()
    after 2: timeout()


actor _test_generated_oper_poll(t: testing.EnvT):
    GeneratedOperDelivery(t, False)


actor _test_generated_oper_on_change(t: testing.EnvT):
    GeneratedOperDelivery(t, True)


def device_path(flotilla: str, name: str) -> ttt.Path:
    """Return the path of one device entry under /rfs, as TTT builds it."""
    rfs = ttt.PathElem(gdata.Id(y1_oper.NS_stratoweave_rfs, "rfs"), ttt.PathRoot("root"))
    shard = ttt.PathKey(flotilla, rfs, {gdata.Id(y1_oper.NS_stratoweave_rfs, "name"): gdata.Leaf(flotilla)})
    device = ttt.PathElem(gdata.Id(y1_oper.NS_fleetmgr_rfs, "device"), shard)
    return ttt.PathKey(name, device, {gdata.Id(y1_oper.NS_fleetmgr_rfs, "name"): gdata.Leaf(name)})


mut def device_conf(name: str) -> gdata.Node:
    return y_1.stratoweave_rfs__rfs__device_entry(
        name=name, type="iosxe", credentials=InputCredentials(username="admin")).to_gdata()


mut def software(states: list[(str, ?str, ?str)]) -> gdata.Node:
    """Build the flotilla oper tree: one (name, status, stage) of attempt 0
    per device. Each device also has a platform: until acton-yang's
    gdata.filter is fixed, the subscription leaves out a device without
    one."""
    root = oper.root()
    for name, status, stage in states:
        device = root.device.create(name, description="not selected")
        device.software.state.attempt.create(0, status=status, stage=stage)
        device.state.platform.version = "17.18.2"
    return root.to_gdata()


mut def attempt0(data: gdata.Node) -> ?y1_oper.stratoweave_rfs__rfs__device__state__attempt_entry:
    """Attempt 0 in one publication of the device actor."""
    return y1_oper.stratoweave_rfs__rfs__device_entry.from_gdata(data).state.attempt.get(u64(0))


mut def published(data: ?gdata.Node) -> str:
    """Describe one publication of the device actor: the device name, and
    the status and stage of attempt 0, or "cleared"."""
    if data is not None:
        entry = y1_oper.stratoweave_rfs__rfs__device_entry.from_gdata(data)
        if entry.type is not None or entry.description is not None:
            return "config of {entry.name}"
        a = entry.state.attempt.get(u64(0))
        if a is not None:
            return "{entry.name} {a.status} {a.stage}"
        return "{entry.name} without attempt 0"
    return "cleared"


actor _test_device_status_instance(t: testing.EnvT):
    """The device actor publishes the state of its own device and nothing else.
    It clears the state when the device loses it and when the actor shuts down.
    A new configuration after shutdown starts from the current state."""
    dev = new_device(t, "device-status", True)
    var server: ?netconf.NetconfMockServer = None
    var device: ?ttt.TransformActor = None
    var phase = 0
    var done = False

    def fail(message: str):
        if not done:
            done = True
            d = device
            if d is not None:
                d.shutdown(None)
            t.failure(ValueError(message))

    def change_a():
        if not done and phase == 1:
            phase = 2
            tree = oper.root.from_gdata(software([("a", "succeeded", None), ("b", "succeeded", "prepare")]))
            tree.device["a"].software.state.attempt[u64(0)].job.create("install", state="done")
            server!.set_oper_ds(tree.to_gdata())

    def restart():
        if not done and phase == 6:
            phase = 7
            device!.on_conf(device_conf("a"), gdata.Container(), None)
            device!.on_conf(device_conf("a"), gdata.Container(), None)

    def finish():
        if not done and phase == 8:
            done = True
            device!.shutdown(None)
            t.success()

    def on_oper(data: ?gdata.Node):
        if done:
            return
        got = published(data)
        if phase == 0:
            if got != "a in-progress prepare":
                fail("first publication is not the current state: {got}")
                return
            phase = 1
            # Change the other device, and a job of this one that the actor
            # does not show: no publication.
            tree = oper.root.from_gdata(software([("a", "in-progress", "prepare"), ("b", "succeeded", "prepare")]))
            tree.device["a"].software.state.attempt[u64(0)].job.create("commit", state="running")
            server!.set_oper_ds(tree.to_gdata())
            after 0.1: change_a()
        elif phase == 2:
            if got != "a succeeded None":
                fail("change did not publish the new state: {got}")
                return
            phase = 3
            server!.set_oper_ds(software([("b", "succeeded", "prepare")]))
        elif phase == 3:
            if got != "cleared":
                fail("removal on the flotilla did not clear the state: {got}")
                return
            phase = 4
            server!.set_oper_ds(software([("a", "in-progress", "install"), ("b", "succeeded", "prepare")]))
        elif phase == 4:
            if got != "a in-progress install":
                fail("device did not come back: {got}")
                return
            phase = 5
            device!.shutdown(None)
        elif phase == 5:
            if got != "cleared":
                fail("shutdown did not clear the state: {got}")
                return
            phase = 6
            server!.set_oper_ds(software([("a", "succeeded", "install")]))
            after 0.1: restart()
        elif phase == 7:
            if got != "a succeeded install":
                fail("restart did not start from the current state: {got}")
                return
            phase = 8
            after 0.1: finish()
        else:
            fail("unexpected publication in phase {phase}: {got}")

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(software([("a", "in-progress", "prepare"), ("b", "in-progress", "prepare")]))
            params = ttt.TransformActorParams(device_path("flotilla-1", "a"), lambda conf: None, lambda state: None, on_oper, dev)
            device = t_1.DeviceTransformCtor(params)
            device!.on_conf(device_conf("a"), gdata.Container(), None)
        else:
            fail("no NETCONF adapter")

    def timeout():
        fail("device actor timed out in phase {phase}")

    start()
    after 3: timeout()


mut def preparing(progress: ?int, job_state: str) -> gdata.Node:
    """The flotilla oper tree of device a, in progress in prepare, whose
    prepare job is in job_state with progress."""
    tree = oper.root.from_gdata(software([("a", "in-progress", "prepare")]))
    job = tree.device["a"].software.state.attempt[u64(0)].job.create("prepare", state=job_state)
    if progress is not None:
        job.progress = u64(progress)
    return tree.to_gdata()


mut def published_progress(data: ?gdata.Node) -> str:
    """The progress in one publication of the device actor."""
    if data is not None:
        a = attempt0(data)
        p = a.prepare.progress if a is not None else None
        return str(p) if p is not None else "None"
    return "cleared"


actor _test_device_status_progress(t: testing.EnvT):
    """The device actor publishes the progress of the device's prepare job
    while it runs, and none when the job is done."""
    dev = new_device(t, "device-progress", True)
    var server: ?netconf.NetconfMockServer = None
    var device: ?ttt.TransformActor = None
    var phase = 0
    var done = False

    def fail(message: str):
        if not done:
            done = True
            d = device
            if d is not None:
                d.shutdown(None)
            t.failure(ValueError(message))

    def on_oper(data: ?gdata.Node):
        if done:
            return
        got = published_progress(data)
        if phase == 0:
            if got != "40":
                fail("the running prepare job's progress is not published: {got}")
                return
            phase = 1
            server!.set_oper_ds(preparing(100, "done"))
        elif phase == 1:
            if got != "None":
                fail("a done prepare job still shows progress: {got}")
                return
            done = True
            device!.shutdown(None)
            t.success()

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(preparing(40, "running"))
            params = ttt.TransformActorParams(device_path("flotilla-1", "a"), lambda conf: None, lambda state: None, on_oper, dev)
            device = t_1.DeviceTransformCtor(params)
            device!.on_conf(device_conf("a"), gdata.Container(), None)
        else:
            fail("no NETCONF adapter")

    def timeout():
        fail("device actor timed out in phase {phase}")

    start()
    after 3: timeout()


mut def installing(job_state: str, message: ?str) -> gdata.Node:
    """The flotilla oper tree of device a, in progress in install, whose
    install job is in job_state with message."""
    tree = oper.root.from_gdata(software([("a", "in-progress", "install")]))
    job = tree.device["a"].software.state.attempt[u64(0)].job.create(
        "install", state=job_state, release="17.18.03a")
    job.message = message
    return tree.to_gdata()


mut def published_install(data: ?gdata.Node) -> str:
    """The install job in one publication of the device actor."""
    if data is not None:
        a = attempt0(data)
        if a is not None:
            i = a.install
            return "{i.state} {i.release} {i.message}"
        return "without attempt 0"
    return "cleared"


actor _test_device_status_install(t: testing.EnvT):
    """The device actor publishes the device's install job: a new step, and
    the end of the job with the commit window."""
    dev = new_device(t, "device-install", True)
    want = ["running 17.18.03a add: extract", "running 17.18.03a activate: reload",
            "done 17.18.03a commit window ends 23:07 UTC"]
    var server: ?netconf.NetconfMockServer = None
    var device: ?ttt.TransformActor = None
    var phase = 0
    var done = False

    def fail(message: str):
        if not done:
            done = True
            d = device
            if d is not None:
                d.shutdown(None)
            t.failure(ValueError(message))

    def on_oper(data: ?gdata.Node):
        if done:
            return
        got = published_install(data)
        if got != want[phase]:
            fail("phase {phase}: published {got}")
            return
        phase += 1
        if phase == 1:
            server!.set_oper_ds(installing("running", "activate: reload"))
        elif phase == 2:
            server!.set_oper_ds(installing("done", "commit window ends 23:07 UTC"))
        else:
            done = True
            device!.shutdown(None)
            t.success()

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(installing("running", "add: extract"))
            params = ttt.TransformActorParams(device_path("flotilla-1", "a"), lambda conf: None, lambda state: None, on_oper, dev)
            device = t_1.DeviceTransformCtor(params)
            device!.on_conf(device_conf("a"), gdata.Container(), None)
        else:
            fail("no NETCONF adapter")

    def timeout():
        fail("device actor timed out in phase {phase}")

    start()
    after 3: timeout()


actor _test_device_status_absent(t: testing.EnvT):
    """The device actor publishes nothing until the flotilla has state for the
    device."""
    dev = new_device(t, "device-absent", True)
    var server: ?netconf.NetconfMockServer = None
    var device: ?ttt.TransformActor = None
    var waiting = True
    var done = False

    def fail(message: str):
        if not done:
            done = True
            d = device
            if d is not None:
                d.shutdown(None)
            t.failure(ValueError(message))

    def appear():
        if not done:
            waiting = False
            server!.set_oper_ds(software([("a", "in-progress", "prepare"), ("b", "in-progress", "prepare")]))

    def on_oper(data: ?gdata.Node):
        if done:
            return
        got = published(data)
        if waiting:
            fail("published before the device had state: {got}")
        elif got != "a in-progress prepare":
            fail("device state did not arrive: {got}")
        else:
            done = True
            device!.shutdown(None)
            t.success()

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(software([("b", "in-progress", "prepare")]))
            params = ttt.TransformActorParams(device_path("flotilla-1", "a"), lambda conf: None, lambda state: None, on_oper, dev)
            device = t_1.DeviceTransformCtor(params)
            device!.on_conf(device_conf("a"), gdata.Container(), None)
            after 0.2: appear()
        else:
            fail("no NETCONF adapter")

    start()
    after 3: fail("device actor timed out")


actor _test_device_status_verdicts(t: testing.EnvT):
    """The campaign and target release of the attempts, and a stage, a
    reason, a prepare, a check verdict and a platform that change while the
    status of the attempt stays the same, are published: the prepare with
    its release, times and message, the verdict with its detail and
    time."""
    dev = new_device(t, "device-verdicts", True)
    var server: ?netconf.NetconfMockServer = None
    var device: ?ttt.TransformActor = None
    var done = False

    def fail(message: str):
        if not done:
            done = True
            d = device
            if d is not None:
                d.shutdown(None)
            t.failure(ValueError(message))

    def on_oper(data: ?gdata.Node):
        if done:
            return
        if data is not None:
            entry = y1_oper.stratoweave_rfs__rfs__device_entry.from_gdata(data)
            state = entry.state
            model = entry.state.platform.model
            a = state.attempt.get(u64(0))
            if a is not None:
                if a.precheck.verdict is None and model is None:
                    tree = oper.root.from_gdata(software([("a", "in-progress", "prepare")]))
                    st = tree.device["a"].software.state
                    st.upgrade_campaign = "paced"
                    st.target_release = "17.18.03a"
                    ta = st.attempt[u64(0)]
                    ta.stage = "rollback"
                    ta.reason = "commit failed: install-img-commit-fail"
                    ta.job.create(
                        "prepare", state="failed", release="17.18.03a",
                        started="2026-10-07T11:00:00Z", ended="2026-10-07T11:02:10Z",
                        message="copy failed: no space left on bootflash:")
                    check = ta.precheck
                    check.verdict = "pass"
                    check.detail = "rfs-device-health: no BGP neighbors"
                    check.at = "2026-10-07T12:00:00Z"
                    tree.device["a"].state.platform.model = "C8000V"
                    server!.set_oper_ds(tree.to_gdata())
                elif a.status != "in-progress" or state.upgrade_campaign != "paced" or \
                     state.target_release != "17.18.03a" or a.stage != "rollback" or \
                     a.reason != "commit failed: install-img-commit-fail" or \
                     a.prepare.state != "failed" or a.prepare.release != "17.18.03a" or \
                     a.prepare.started != "2026-10-07T11:00:00Z" or \
                     a.prepare.ended != "2026-10-07T11:02:10Z" or \
                     a.prepare.message != "copy failed: no space left on bootflash:" or \
                     a.precheck.verdict != "pass" or \
                     a.precheck.detail != "rfs-device-health: no BGP neighbors" or \
                     a.precheck.at != "2026-10-07T12:00:00Z" or model != "C8000V":
                    prep = a.prepare
                    pre = a.precheck
                    fail("unexpected state: {a.status} {state.upgrade_campaign} {state.target_release} "
                         + "{a.stage} {a.reason} {prep.state} {prep.release} {prep.started} "
                         + "{prep.ended} {prep.message} {pre.verdict} {pre.detail} {pre.at} {model}")
                else:
                    done = True
                    device!.shutdown(None)
                    t.success()
            else:
                fail("no attempt 0")
        else:
            fail("state was cleared")

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(software([("a", "in-progress", "prepare")]))
            params = ttt.TransformActorParams(device_path("flotilla-1", "a"), lambda conf: None, lambda state: None, on_oper, dev)
            device = t_1.DeviceTransformCtor(params)
            device!.on_conf(device_conf("a"), gdata.Container(), None)
        else:
            fail("no NETCONF adapter")

    start()
    after 3: fail("device actor timed out")


mut def adapters(connected: list[(str, bool)]) -> gdata.Node:
    """Build the flotilla oper tree of device a, in progress, with one
    adapter entry per (device type, connected)."""
    tree = oper.root.from_gdata(software([("a", "in-progress", "install")]))
    for kind, up in connected:
        tree.device["a"].state.adapter.create(kind, connected=up)
    return tree.to_gdata()


actor _test_device_connection(t: testing.EnvT):
    """The device actor publishes whether the flotilla is connected to the
    device: its adapter entry of the device's type, iosxe. Until that entry
    first says connected, and without that entry, connected is absent. An
    extra adapter changes nothing."""
    dev = new_device(t, "device-connection", True)
    var server: ?netconf.NetconfMockServer = None
    var device: ?ttt.TransformActor = None
    var phase = 0
    var done = False
    steps = [
        [("iosxe", True)],
        [("iosxe", True), ("iosxe-cli", False)],
        [("iosxe", False), ("iosxe-cli", False)],
        [("iosxe-cli", True)],
    ]
    # What each step publishes; the extra adapter's step publishes nothing.
    want = ["a None", "a True", "a False", "a None"]

    def fail(message: str):
        if not done:
            done = True
            d = device
            if d is not None:
                d.shutdown(None)
            t.failure(ValueError(message))

    def step(i: int):
        if not done:
            server!.set_oper_ds(adapters(steps[i]))

    def on_oper(data: ?gdata.Node):
        if done:
            return
        got = "cleared"
        if data is not None:
            entry = y1_oper.stratoweave_rfs__rfs__device_entry.from_gdata(data)
            got = "{entry.name} {entry.state.connected}"
        if got != want[phase]:
            fail("publication {phase}: {got}")
        elif phase == len(want) - 1:
            done = True
            device!.shutdown(None)
            t.success()
        else:
            phase += 1
            if phase == 1:
                step(0)
            elif phase == 2:
                # The extra adapter first: the next publication must be
                # the change of iosxe.
                step(1)
                after 0.1: step(2)
            else:
                step(3)

    def start():
        adapter = dev.get_adapter()
        if isinstance(adapter, netconf.NetconfAdapter):
            server = adapter.get_mock_server()
            server!.set_oper_ds(adapters([("iosxe", False)]))
            params = ttt.TransformActorParams(device_path("flotilla-1", "a"), lambda conf: None, lambda state: None, on_oper, dev)
            device = t_1.DeviceTransformCtor(params)
            device!.on_conf(device_conf("a"), gdata.Container(), None)
        else:
            fail("no NETCONF adapter")

    start()
    after 3: fail("device actor timed out in phase {phase}")
