"""Controller pacing through a real FleetMgr deployment.

Reuses the deployment harness from test_scale: FleetMgr runs as a
subprocess with real flotilla processes and everything happens over
RESTCONF. The test adds slow-upgrading mock devices, creates a campaign in
plan, checks that the plan places everyone with no alarm once every member
has answered, and that nothing starts, flips it to run, and then watches
the rollout: the first release is small,
releases arrive in several steps, devices in flight never exceed
target-concurrency, and everyone succeeds with both upgrade checks passed.
Every device then reports the new version and its model in the campaign
and its platform on its fleet entry, one of them the model and serial
number its mock is set to.

Run from fleetmgr/:
    acton test --module test_fleetmgr_pacing --tag fleetmgr-system
"""

import http
import json
import testing
import time

import test_scale


def mock_platform(i: int) -> ?(model: str, serial: str):
    """The model and serial number device i's mock is set to; None for the
    mock's defaults, C8000V and 9ABCDEFGHIJ."""
    return (model="C8300-1N1S-4T2X", serial="FGL2231L0AB") if i == 1 else None


actor PacingRollout(size: int, client: http.Client, done: action(?Exception) -> None):
    path = "/restconf/data/software:software/upgrade-campaign=pacing"
    # Pacing is a behavior test, not a scale test: ten slow devices show
    # the ramp, whatever scale the runner asks for.
    n = 10
    var first = 0
    var prev = 0
    var steps = 0
    var max_ip = 0
    var polls = 0
    var plan_tries = 0
    var version_tries = 0

    def parse_status(body: str) -> ?(int, int, int, int, int, int):
        """(in-progress, succeeded, failed, placed, alarms, devices whose
        pre-check and post-check both passed), or None."""
        data = json.decode(body)
        if isinstance(data, dict):
            campaigns = data.get("software:upgrade-campaign")
            if isinstance(campaigns, list) and len(campaigns) == 1:
                campaign = campaigns[0]
                if isinstance(campaign, dict):
                    state = campaign.get("state")
                    if isinstance(state, dict):
                        ip = 0
                        ok = 0
                        bad = 0
                        v = state.get("in-progress")
                        if isinstance(v, int):
                            ip = v
                        v = state.get("succeeded")
                        if isinstance(v, int):
                            ok = v
                        v = state.get("failed")
                        if isinstance(v, int):
                            bad = v
                        placed = 0
                        alarms = 0
                        plan = state.get("plan")
                        if isinstance(plan, dict):
                            windows = plan.get("window")
                            if isinstance(windows, list):
                                for w in windows:
                                    if isinstance(w, dict):
                                        devices = w.get("device")
                                        if isinstance(devices, list):
                                            placed += len(devices)
                            al = plan.get("alarm")
                            if isinstance(al, list):
                                alarms = len(al)
                        checked = 0
                        rows = state.get("device-status")
                        if isinstance(rows, list):
                            for row in rows:
                                if isinstance(row, dict):
                                    pre = row.get("precheck")
                                    post = row.get("postcheck")
                                    if isinstance(pre, dict) and isinstance(post, dict):
                                        pv = pre.get("verdict")
                                        qv = post.get("verdict")
                                        if isinstance(pv, str) and isinstance(qv, str) and pv == "pass" and qv == "pass":
                                            checked += 1
                        return (ip, ok, bad, placed, alarms, checked)
        return None

    def parse_rows(body: str) -> dict[str, str]:
        """The version and model of each device-status row, by device,
        "None" where it has none."""
        found: dict[str, str] = {}
        data = json.decode(body)
        if isinstance(data, dict):
            campaigns = data.get("software:upgrade-campaign")
            if isinstance(campaigns, list) and len(campaigns) == 1:
                campaign = campaigns[0]
                if isinstance(campaign, dict):
                    state = campaign.get("state")
                    if isinstance(state, dict):
                        rows = state.get("device-status")
                        if isinstance(rows, list):
                            for row in rows:
                                if isinstance(row, dict):
                                    d = row.get("device")
                                    v = row.get("version")
                                    m = row.get("model")
                                    vs = v if isinstance(v, str) else "None"
                                    ms = m if isinstance(m, str) else "None"
                                    if isinstance(d, str):
                                        found[d] = vs + " " + ms
        return found

    def campaign_payload(admin: str) -> bytes:
        return json.encode({"software:upgrade-campaign": [{
            "name": "pacing",
            "target-concurrency": 8,
            "max-concurrency": 16,
            "device": [{"name": test_scale.device_name(i), "image": test_scale.IMAGE} for i in range(n)],
            "admin-state": admin,
        }]}).encode()

    def watched(client: http.Client, response: http.Response) -> None:
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        parsed = parse_status(response.body.decode())
        if parsed is not None:
            ip = parsed.0
            ok = parsed.1
            bad = parsed.2
            if bad > 0:
                done(ValueError("{bad} device(s) failed"))
                return
            started = ip + ok
            if ip > max_ip:
                max_ip = ip
            if started > prev:
                if first == 0:
                    first = started
                steps += 1
                print("pacing: started={started} in-progress={ip} succeeded={ok}")
                prev = started
            if ok == n:
                if first > 2:
                    done(ValueError("first release was {first} devices at once - not a ramp"))
                elif steps < 3:
                    done(ValueError("devices arrived in {steps} step(s) - looks like all at once"))
                elif max_ip > 8:
                    done(ValueError("in-progress peaked at {max_ip}, above target-concurrency"))
                elif parsed.5 != n:
                    done(ValueError("{n - parsed.5} device(s) succeeded without both checks passed"))
                else:
                    print("pacing: ramped from {first}, {steps} release steps, peak in-flight {max_ip}, {ok} of {n} succeeded")
                    client.get(path, versions_checked, {"Accept": "application/yang-data+json"})
                return
            polls += 1
            if polls > 360:
                done(ValueError("rollout did not complete: started={started} of {n}"))
                return
            after 0.5: watch()
        else:
            done(ValueError("invalid campaign status: " + response.body.decode()))

    def watch() -> None:
        client.get(path, watched, {"Accept": "application/yang-data+json"})

    def versions_checked(client: http.Client, response: http.Response) -> None:
        # The new version is read after the status is published, so it can
        # reach the campaign a moment later.
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        rows = parse_rows(response.body.decode())
        wrong = []
        for i in range(n):
            name = test_scale.device_name(i)
            p = mock_platform(i)
            model = p.model if p is not None else "C8000V"
            if rows.get(name) != "17.18.3a " + model:
                wrong.append("{name}={rows.get(name)}")
        if len(wrong) == 0:
            client.get("/restconf/data/fleetmgr:fleet", platforms_checked,
                       {"Accept": "application/yang-data+json"})
        elif version_tries >= 40:
            done(ValueError("campaign versions and models after the rollout: {wrong}"))
        else:
            version_tries += 1
            after 0.5: client.get(path, versions_checked, {"Accept": "application/yang-data+json"})

    def platforms_checked(client: http.Client, response: http.Response) -> None:
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        platforms: dict[str, str] = {}
        data = json.decode(response.body.decode())
        if isinstance(data, dict):
            fleet = data.get("fleetmgr:fleet")
            if isinstance(fleet, dict):
                devices = fleet.get("device")
                if isinstance(devices, list):
                    for d in devices:
                        if isinstance(d, dict):
                            name = d.get("name")
                            state = d.get("state")
                            if isinstance(name, str) and isinstance(state, dict):
                                platform = state.get("platform")
                                if isinstance(platform, dict):
                                    platforms[name] = "{platform.get('model')} {platform.get('serial-number')}"
        wrong = []
        for i in range(n):
            name = test_scale.device_name(i)
            p = mock_platform(i)
            want = "{p.model} {p.serial}" if p is not None else "C8000V 9ABCDEFGHIJ"
            if platforms.get(name) != want:
                wrong.append("{name}={platforms.get(name)}")
        if len(wrong) > 0:
            done(ValueError("platform not reported: {wrong}"))
        else:
            done(None)

    def running(client: http.Client, response: http.Response) -> None:
        # The flip is asked for asynchronously: the controller's first
        # dynstate write lands inside the transaction window otherwise,
        # and the campaign state is what an operator watches anyway.
        if response.status not in {200, 201, 204}:
            done(test_scale.status_error(response, 204))
            return
        watch()

    def run_campaign() -> None:
        client.put(path, campaign_payload("run"), running,
                   {"Content-Type": "application/yang-data+json", "async": "true"})

    def planned(client: http.Client, response: http.Response) -> None:
        # The plan holds each member, with an alarm, until the member has
        # read the release it runs and answered the campaign's target. The
        # mocks run 17.18.02, so they answer upgrade-needed, which counts
        # as neither started nor done. Give them up to 20 s.
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        parsed = parse_status(response.body.decode())
        if parsed is not None:
            started = parsed.0 + parsed.1 + parsed.2
            placed = parsed.3
            if placed == n and parsed.4 == 0 and started == 0:
                print("pacing: plan ok, {n} placed in the open window, nothing started")
                run_campaign()
                return
            if started != 0:
                done(ValueError("{started} device(s) started while still in plan"))
                return
            plan_tries += 1
            if plan_tries > 80:
                done(ValueError("plan placed {placed} of {n} with {parsed.4} alarm(s)"))
                return
            after 0.25: check_plan()
        else:
            plan_tries += 1
            if plan_tries > 80:
                done(ValueError("invalid campaign status: " + response.body.decode()))
                return
            after 0.25: check_plan()

    def check_plan() -> None:
        client.get(path, planned, {"Accept": "application/yang-data+json"})

    def created(client: http.Client, response: http.Response) -> None:
        if response.status == 201:
            check_plan()
        else:
            done(test_scale.status_error(response, 201))

    def put_campaign() -> None:
        client.put(path, campaign_payload("plan"), created,
                   {"Content-Type": "application/yang-data+json"})

    def devices_added(client: http.Client, response: http.Response) -> None:
        if response.status != 201:
            done(test_scale.status_error(response, 201))
            return
        test_scale.AddImages(client, put_campaign, done)

    def add_devices() -> None:
        devices = []
        for i in range(n):
            name = test_scale.device_name(i)
            # Slow installs, so the ramp is observable in the counters.
            mock = {"enabled": True, "software": {"upgrade-duration": 8}}
            p = mock_platform(i)
            if p is not None:
                mock["platform"] = {"model": p.model, "serial-number": p.serial}
            entry = {
                "name": name,
                "type": "iosxe",
                "description": "Pacing {name}",
                "credentials": {"username": "admin", "password": "admin"},
                "mock": mock,
            }
            devices.append(entry)
        payload = json.encode({"fleetmgr:fleet": {"device": devices}}).encode()
        client.post("/restconf/data", payload, devices_added,
                    {"Content-Type": "application/yang-data+json"})

    add_devices()


actor _test_controller_pacing(t: testing.EnvT):
    """Devices are released a few at a time, never the whole plan at once."""
    t.require("fleetmgr-system")
    def run(size: int, client: http.Client, done: action(?Exception) -> None) -> None:
        PacingRollout(size, client, done)
    test_scale.FleetMgrTest(t, run)


actor ScheduledRollout(size: int, client: http.Client, done: action(?Exception) -> None):
    """Two schedules: half the fleet is bound to a window that opens
    thirty seconds after launch, and must not start before it does."""
    path = "/restconf/data/software:software/upgrade-campaign=windows"
    n = 10
    later_from = 30
    var polls = 0
    var plan_tries = 0
    var later_started_at = -1.0
    var first_started = 0

    def parse_rows(body: str) -> ?(int, int, list[str]):
        """(succeeded, failed, names of devices seen started)."""
        data = json.decode(body)
        if isinstance(data, dict):
            campaigns = data.get("software:upgrade-campaign")
            if isinstance(campaigns, list) and len(campaigns) == 1:
                campaign = campaigns[0]
                if isinstance(campaign, dict):
                    state = campaign.get("state")
                    if isinstance(state, dict):
                        ok = 0
                        bad = 0
                        v = state.get("succeeded")
                        if isinstance(v, int):
                            ok = v
                        v = state.get("failed")
                        if isinstance(v, int):
                            bad = v
                        started: list[str] = []
                        rows = state.get("device-status")
                        if isinstance(rows, list):
                            for row in rows:
                                if isinstance(row, dict):
                                    st = row.get("status")
                                    name = row.get("device")
                                    if isinstance(st, str) and isinstance(name, str):
                                        if st == "in-progress" or st == "succeeded":
                                            started.append(name)
                        return (ok, bad, started)
        return None

    def is_later(name: str) -> bool:
        # device-5 through device-9 are bound to the later schedule.
        for i in range(5, 10):
            if name == test_scale.device_name(i):
                return True
        return False

    def watched(client: http.Client, response: http.Response) -> None:
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        parsed = parse_rows(response.body.decode())
        if parsed is not None:
            ok = parsed.0
            bad = parsed.1
            if bad > 0:
                done(ValueError("{bad} device(s) failed"))
                return
            t = float(polls) * 0.5
            for name in parsed.2:
                if is_later(name):
                    if later_started_at < 0.0:
                        later_started_at = t
                elif first_started == 0:
                    first_started = len(parsed.2)
            if later_started_at >= 0.0 and later_started_at < float(later_from) - 5.0:
                done(ValueError("a bound device started {later_started_at}s after "
                                + "launch, before its window at {later_from}s"))
                return
            if ok == n:
                if later_started_at < 0.0:
                    done(ValueError("the later window's devices never started"))
                elif first_started > 2:
                    done(ValueError("first release was {first_started} devices at once"))
                else:
                    print("schedules: later window opened at {later_started_at}s "
                          + "(bound at {later_from}s), {ok} of {n} succeeded")
                    done(None)
                return
            polls += 1
            if polls > 360:
                done(ValueError("rollout did not complete: {ok} of {n}"))
                return
            after 0.5: watch()
        else:
            done(ValueError("invalid campaign status: " + response.body.decode()))

    def watch() -> None:
        client.get(path, watched, {"Accept": "application/yang-data+json"})

    def running(client: http.Client, response: http.Response) -> None:
        if response.status not in {200, 201, 204}:
            done(test_scale.status_error(response, 204))
            return
        watch()

    def campaign_payload(admin: str) -> bytes:
        return json.encode({"software:upgrade-campaign": [{
            "name": "windows",
            "target-concurrency": 8,
            "max-concurrency": 16,
            "default-schedule": "first",
            "device": [{"name": test_scale.device_name(i), "image": test_scale.IMAGE} for i in range(n)],
            "admin-state": admin,
        }]}).encode()

    def run_campaign() -> None:
        client.put(path, campaign_payload("run"), running,
                   {"Content-Type": "application/yang-data+json", "async": "true"})

    def planned(client: http.Client, response: http.Response) -> None:
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        parsed = parse_rows(response.body.decode())
        if parsed is not None and len(parsed.2) == 0:
            print("schedules: plan ok, nothing started")
            run_campaign()
            return
        plan_tries += 1
        if plan_tries > 20:
            done(ValueError("devices started while still in plan"))
            return
        after 0.25: check_plan()

    def check_plan() -> None:
        client.get(path, planned, {"Accept": "application/yang-data+json"})

    def created(client: http.Client, response: http.Response) -> None:
        if response.status == 201:
            check_plan()
        else:
            done(test_scale.status_error(response, 201))

    def put_campaign() -> None:
        client.put(path, campaign_payload("plan"), created,
                   {"Content-Type": "application/yang-data+json"})

    def devices_added(client: http.Client, response: http.Response) -> None:
        if response.status != 201:
            done(test_scale.status_error(response, 201))
            return
        test_scale.AddImages(client, put_campaign, done)

    def schedules_added(client: http.Client, response: http.Response) -> None:
        if response.status not in {200, 201, 204}:
            done(test_scale.status_error(response, 201))
            return
        devices = []
        for i in range(n):
            name = test_scale.device_name(i)
            entry = {
                "name": name,
                "type": "iosxe",
                "description": "Windows {name}",
                "credentials": {"username": "admin", "password": "admin"},
                "mock": {"enabled": True, "software": {"upgrade-duration": 8}},
            }
            if i >= 5:
                entry["schedule"] = "later"
            devices.append(entry)
        payload = json.encode({"fleetmgr:fleet": {"device": devices}}).encode()
        client.post("/restconf/data", payload, devices_added,
                    {"Content-Type": "application/yang-data+json"})

    def add_schedules() -> None:
        # Asked for asynchronously: the schedules container is linked by
        # campaigns and its transaction can apply without answering, the
        # same open engine bug the run flip works around. The engine
        # serializes transactions, so the devices that reference the
        # schedules still commit after them.
        #
        # The schedules speak local wall clock, so pick a UTC offset that
        # puts local time near noon and no rule ever wraps midnight: the
        # first window is open now, the later one opens in thirty seconds.
        now = time.time().unix_s()
        off_min = (43200 - now % 86400) // 60
        if off_min < -720:
            off_min = -720
        if off_min > 840:
            off_min = 840
        local_now = (now + off_min * 60) % 86400
        payload = json.encode({"maintenance:schedules": {"schedule": [
            {"name": "first", "utc-offset": off_min,
             "window": [{"at": local_now - 600, "duration": 7200}]},
            {"name": "later", "utc-offset": off_min,
             "window": [{"at": local_now + later_from, "duration": 3600}]},
        ]}}).encode()
        client.put("/restconf/data/maintenance:schedules", payload, schedules_added,
                   {"Content-Type": "application/yang-data+json", "async": "true"})

    add_schedules()


actor _test_schedule_windows(t: testing.EnvT):
    """Nothing starts before its schedule's window opens."""
    t.require("fleetmgr-system")
    def run(size: int, client: http.Client, done: action(?Exception) -> None) -> None:
        ScheduledRollout(size, client, done)
    test_scale.FleetMgrTest(t, run)


class PreparedView(object):
    """What PreparedRollout reads from the campaign's state: the counters,
    the plan's alarms, each member's status and prepare, and each
    prepare-start of the plan."""
    preparing: int
    prepared: int
    succeeded: int
    failed: int
    alarms: list[str]
    statuses: dict[str, str]
    prepares: dict[str, str]
    starts: dict[str, int]

    def __init__(self):
        self.preparing = 0
        self.prepared = 0
        self.succeeded = 0
        self.failed = 0
        self.alarms = []
        self.statuses = {}
        self.prepares = {}
        self.starts = {}


def parse_prepared(body: str) -> ?PreparedView:
    """The state of the one campaign in body, or None."""
    data = json.decode(body)
    if isinstance(data, dict):
        campaigns = data.get("software:upgrade-campaign")
        if isinstance(campaigns, list) and len(campaigns) == 1:
            campaign = campaigns[0]
            if isinstance(campaign, dict):
                state = campaign.get("state")
                if isinstance(state, dict):
                    view = PreparedView()
                    v = state.get("preparing")
                    if isinstance(v, int):
                        view.preparing = v
                    v = state.get("prepared")
                    if isinstance(v, int):
                        view.prepared = v
                    v = state.get("succeeded")
                    if isinstance(v, int):
                        view.succeeded = v
                    v = state.get("failed")
                    if isinstance(v, int):
                        view.failed = v
                    rows = state.get("device-status")
                    if isinstance(rows, list):
                        for row in rows:
                            if isinstance(row, dict):
                                name = row.get("device")
                                st = row.get("status")
                                if isinstance(name, str) and isinstance(st, str):
                                    view.statuses[name] = st
                                    prep = row.get("prepare")
                                    if isinstance(prep, dict):
                                        ps = prep.get("state")
                                        pr = prep.get("release")
                                        if isinstance(ps, str) and isinstance(pr, str):
                                            view.prepares[name] = ps + " " + pr
                    plan = state.get("plan")
                    if isinstance(plan, dict):
                        windows = plan.get("window")
                        if isinstance(windows, list):
                            for w in windows:
                                if isinstance(w, dict):
                                    devices = w.get("device")
                                    if isinstance(devices, list):
                                        for d in devices:
                                            if isinstance(d, dict):
                                                # A uint64 leaf: RESTCONF JSON may
                                                # give it as a string.
                                                name = d.get("name")
                                                s = d.get("prepare-start")
                                                if isinstance(name, str):
                                                    if isinstance(s, int):
                                                        view.starts[name] = s
                                                    elif isinstance(s, str):
                                                        view.starts[name] = int(s)
                        al = plan.get("alarm")
                        if isinstance(al, list):
                            for a in al:
                                if isinstance(a, str):
                                    view.alarms.append(a)
                    return view
    return None


actor PreparedRollout(size: int, client: http.Client, done: action(?Exception) -> None):
    """Six members on a schedule whose window opens two minutes after the
    schedules are added, for an hour, and one member on a schedule whose
    window is open now. The mocks take 20 s, so the copy takes about 6.6 s,
    the prepare estimate is 6 s and the lead 9 s. The campaign has
    allow-staging.

    In plan, the plan gives each member of the later window a
    prepare-start, and nothing is copied. In run, before the later window
    opens, no member of it upgrades, at most one prepares at once, each
    shows its prepare done before it upgrades, and the prepare-starts
    spread over at least 40 s. The member in the open window has no
    prepare-start, upgrades at once, and never counts as preparing. Every
    member succeeds."""
    path = "/restconf/data/software:software/upgrade-campaign=prepared"
    n = 7
    later = 6
    opens_in = 120
    open_member = test_scale.device_name(later)
    var opening = 0
    var polls = 0
    var plan_tries = 0
    var most_preparing = 0
    var prepared_first: set[str] = set()
    var starts: dict[str, int] = {}
    var open_started = False

    def is_later(name: str) -> bool:
        # device-0 through device-5 wait for the later window.
        for i in range(later):
            if name == test_scale.device_name(i):
                return True
        return False

    def watched(client: http.Client, response: http.Response) -> None:
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        view = parse_prepared(response.body.decode())
        if view is None:
            done(ValueError("invalid campaign status: " + response.body.decode()))
            return
        v = view!
        if v.failed > 0:
            done(ValueError("{v.failed} device(s) failed"))
            return
        now = time.time().unix_s()
        if v.preparing > most_preparing:
            most_preparing = v.preparing
        if most_preparing > 1:
            done(ValueError("{most_preparing} members prepared at once"))
            return
        if open_member in v.starts:
            done(ValueError("{open_member}, in the open window, has a prepare-start"))
            return
        for name, s in v.starts.items():
            starts[name] = s
        for name, st in v.statuses.items():
            prep = v.prepares.get_def(name, "")
            if name == open_member:
                if st == "in-progress" or st == "succeeded":
                    if not open_started and now >= opening:
                        done(ValueError("{open_member} started only after the later window opened"))
                        return
                    open_started = True
                elif st == "upgrade-needed" and prep.startswith("running "):
                    done(ValueError("{open_member} prepares ahead of its open window"))
                    return
            elif st == "upgrade-needed":
                if prep == "done 17.18.03a":
                    prepared_first.add(name)
            elif st == "in-progress" or st == "succeeded":
                if now < opening - 2:
                    done(ValueError("{name} started {opening - now} s before its window"))
                    return
                if name not in prepared_first:
                    done(ValueError("{name} started before it showed its prepare done"))
                    return
        if v.succeeded == n:
            first = -1
            last = -1
            count = 0
            for name, s in starts.items():
                if is_later(name):
                    count += 1
                    if first < 0 or s < first:
                        first = s
                    if s > last:
                        last = s
            if count != later:
                done(ValueError("prepare-start of {count} of {later} members"))
            elif last - first < 40:
                done(ValueError("the prepare-starts spread over {last - first} s"))
            elif not open_started:
                done(ValueError("{open_member} was never seen upgrading"))
            else:
                print("prepares: spread over {last - first} s, at most {most_preparing} at once, "
                      + "{n} of {n} succeeded")
                done(None)
            return
        polls += 1
        if polls > 400:
            done(ValueError("rollout did not complete: {v.succeeded} of {n}"))
            return
        after 0.5: watch()

    def watch() -> None:
        client.get(path, watched, {"Accept": "application/yang-data+json"})

    def running(client: http.Client, response: http.Response) -> None:
        if response.status not in {200, 201, 204}:
            done(test_scale.status_error(response, 204))
            return
        watch()

    def campaign_payload(admin: str) -> bytes:
        return json.encode({"software:upgrade-campaign": [{
            "name": "prepared",
            "target-concurrency": 8,
            "max-concurrency": 16,
            "default-schedule": "soon",
            "allow-staging": True,
            "device": [{"name": test_scale.device_name(i), "image": test_scale.IMAGE} for i in range(n)],
            "admin-state": admin,
        }]}).encode()

    def run_campaign() -> None:
        client.put(path, campaign_payload("run"), running,
                   {"Content-Type": "application/yang-data+json", "async": "true"})

    def later_with_start(v: PreparedView) -> int:
        count = 0
        for name in v.starts.keys():
            if is_later(name):
                count += 1
        return count

    def planned(client: http.Client, response: http.Response) -> None:
        # The plan holds each member, with an alarm, until it has answered.
        if response.status != 200:
            done(test_scale.status_error(response, 200))
            return
        view = parse_prepared(response.body.decode())
        if view is not None:
            v = view!
            for st in v.statuses.values():
                if st == "in-progress" or st == "succeeded":
                    done(ValueError("a member started while still in plan"))
                    return
            if v.preparing != 0 or v.prepared != 0:
                done(ValueError("in plan, preparing {v.preparing} and prepared {v.prepared}"))
                return
            if open_member in v.starts:
                done(ValueError("{open_member}, in the open window, has a prepare-start"))
                return
            if len(v.alarms) == 0 and later_with_start(v) == later:
                print("prepares: plan ok, {later} prepare-starts, nothing copied")
                run_campaign()
                return
        plan_tries += 1
        if plan_tries > 80:
            done(ValueError("the plan has alarms, or no prepare-start for every later "
                            + "member: " + response.body.decode()))
            return
        after 0.25: check_plan()

    def check_plan() -> None:
        client.get(path, planned, {"Accept": "application/yang-data+json"})

    def created(client: http.Client, response: http.Response) -> None:
        if response.status == 201:
            check_plan()
        else:
            done(test_scale.status_error(response, 201))

    def put_campaign() -> None:
        client.put(path, campaign_payload("plan"), created,
                   {"Content-Type": "application/yang-data+json"})

    def devices_added(client: http.Client, response: http.Response) -> None:
        if response.status != 201:
            done(test_scale.status_error(response, 201))
            return
        test_scale.AddImages(client, put_campaign, done)

    def schedules_added(client: http.Client, response: http.Response) -> None:
        if response.status not in {200, 201, 204}:
            done(test_scale.status_error(response, 201))
            return
        devices = []
        for i in range(n):
            name = test_scale.device_name(i)
            entry = {
                "name": name,
                "type": "iosxe",
                "description": "Prepared {name}",
                "credentials": {"username": "admin", "password": "admin"},
                "mock": {"enabled": True, "software": {"upgrade-duration": 20,
                                                       "upgrade-duration-variance": 0}},
            }
            if i == later:
                entry["schedule"] = "open"
            devices.append(entry)
        payload = json.encode({"fleetmgr:fleet": {"device": devices}}).encode()
        client.post("/restconf/data", payload, devices_added,
                    {"Content-Type": "application/yang-data+json"})

    def add_schedules() -> None:
        # Asked for asynchronously, as in ScheduledRollout. The UTC offset
        # puts local time near noon, so no rule wraps midnight: the open
        # window is open now, and the later one opens in opens_in seconds.
        now = time.time().unix_s()
        opening = now + opens_in
        off_min = (43200 - now % 86400) // 60
        if off_min < -720:
            off_min = -720
        if off_min > 840:
            off_min = 840
        local_now = (now + off_min * 60) % 86400
        payload = json.encode({"maintenance:schedules": {"schedule": [
            {"name": "open", "utc-offset": off_min,
             "window": [{"at": local_now - 600, "duration": 7200}]},
            {"name": "soon", "utc-offset": off_min,
             "window": [{"at": local_now + opens_in, "duration": 3600}]},
        ]}}).encode()
        client.put("/restconf/data/maintenance:schedules", payload, schedules_added,
                   {"Content-Type": "application/yang-data+json", "async": "true"})

    add_schedules()


actor _test_prepares_before_the_window(t: testing.EnvT):
    """With allow-staging, members prepare one at a time before their
    window, and upgrade only in it."""
    t.require("fleetmgr-system")
    def run(size: int, client: http.Client, done: action(?Exception) -> None) -> None:
        PreparedRollout(size, client, done)
    test_scale.FleetMgrTest(t, run)
