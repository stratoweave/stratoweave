import testing

import fleetmgr.supervisor as supervisor


def _test_flotillas_get_the_image_folder():
    """A flotilla reads image files from the folder that the command line
    of the top names."""
    cases: list[(argv: list[str], want: ?str)] = [
        (argv=["fleetmgr"], want=None),
        (argv=["fleetmgr", "--software.image-dir", "out/images"], want="out/images"),
        (argv=["fleetmgr", "--http.port", "18200", "--software.image-dir=/srv/images"], want="/srv/images"),
        (argv=["fleetmgr", "--no-such-setting"], want=None),
    ]
    for c in cases:
        testing.assertEqual(supervisor.argv_image_dir(c.argv), c.want, str(c.argv))
    base = ["out/bin/flotilla", "--rts-wthreads", "2", "--http.port", "18203", "--netconf.port", "12903",
            "--log.dir", "logs/flotilla-3"]
    testing.assertEqual(supervisor.flotilla_command(2), base)
    testing.assertEqual(supervisor.flotilla_command(2, "/srv/images"), base + ["--software.image-dir", "/srv/images"])
