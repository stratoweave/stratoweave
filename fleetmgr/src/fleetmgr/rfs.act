from stratoweave.exception import UnsupportedDevice

import stratoweave.device as swdev
import yang.gdata as ygdata

import fleetmgr.layers.base_1 as base
import fleetmgr.layers.y_1 as y_1
import fleetmgr.layers.y_1_oper as y1_oper
import fleetmgr.devices.flotilla as flotilla
import fleetmgr.devices.flotilla_oper as flotilla_oper
# TODO: required by the compiler, see acton issue #2390
import yang.identityref


def status_subscription(name: str) -> ygdata.SubscriptionSpec:
    """Return the on-change subscription to the software state that the
    flotilla reports for one device."""
    return flotilla_oper.subs.device.entry(name).software.state.subscribe()


def platform_subscription(name: str) -> ygdata.SubscriptionSpec:
    """Return the on-change subscription to the platform that the flotilla
    reads for one device."""
    return flotilla_oper.subs.device.entry(name).state.platform.subscribe()


actor DeviceTransform(
    path,
    update_oper: proc(?y1_oper.stratoweave_rfs__rfs__device_entry) -> None,
    dev: swdev.DeviceMgr,
):
    """Publish the software state and platform that the flotilla reports for
    one device.

    The actor subscribes to the flotilla for this device only. It publishes
    the status, stage, reason, check verdicts and platform as the oper state
    of its own entry, so a change on one device publishes one entry. The
    software state and the platform are two subscriptions: a subtree filter
    with both drops the device while either is absent."""
    var subscriptions: ?ygdata.SubscriptionManager = None
    var latest: ?(status: ?str, stage: ?str, reason: ?str,
                  precheck: (verdict: ?str, detail: ?str, at: ?str),
                  postcheck: (verdict: ?str, detail: ?str, at: ?str)) = None
    var platform: ?(os: ?str, version: ?str, model: ?str, serial_number: ?str) = None
    var generation = 0

    def publish() -> None:
        value = latest
        p = platform
        if value is None and p is None:
            update_oper(None)
            return
        oper = base.Device.new_state(path)
        if value is not None:
            s = oper.software.state
            s.status = value.status
            s.stage = value.stage
            s.reason = value.reason
            s.precheck.verdict = value.precheck.verdict
            s.precheck.detail = value.precheck.detail
            s.precheck.at = value.precheck.at
            s.postcheck.verdict = value.postcheck.verdict
            s.postcheck.detail = value.postcheck.detail
            s.postcheck.at = value.postcheck.at
        if p is not None:
            o = oper.state.platform
            o.os = p.os
            o.version = p.version
            o.model = p.model
            o.serial_number = p.serial_number
        update_oper(oper)

    def on_state(gen: int, keys: ?(device_name: str),
                 state: ?flotilla_oper.stratoweave_rfs__device__software__state,
                 error: ?Exception) -> None:
        # A callback from an earlier subscription may already be queued.
        if gen != generation:
            return
        value: ?(status: ?str, stage: ?str, reason: ?str,
                 precheck: (verdict: ?str, detail: ?str, at: ?str),
                 postcheck: (verdict: ?str, detail: ?str, at: ?str)) = None
        if error is not None:
            print("device status subscription failed at {path}: {error}", err=True)
        elif state is not None and state.status is not None:
            pre = state.precheck
            post = state.postcheck
            value = (status=state.status, stage=state.stage, reason=state.reason,
                     precheck=(verdict=pre.verdict, detail=pre.detail, at=pre.at),
                     postcheck=(verdict=post.verdict, detail=post.detail, at=post.at))
        if value != latest:
            latest = value
            publish()

    def on_platform(gen: int, keys: ?(device_name: str),
                    state: ?flotilla_oper.stratoweave_rfs__device__state__platform,
                    error: ?Exception) -> None:
        if gen != generation:
            return
        value: ?(os: ?str, version: ?str, model: ?str, serial_number: ?str) = None
        if error is not None:
            print("device platform subscription failed at {path}: {error}", err=True)
        elif state is not None and (state.os is not None or state.version is not None or
                                    state.model is not None or state.serial_number is not None):
            value = (os=state.os, version=state.version, model=state.model,
                     serial_number=state.serial_number)
        if value != platform:
            platform = value
            publish()

    def shutdown() -> None:
        generation += 1
        latest = None
        platform = None
        if subscriptions is not None:
            subscriptions!.close()
            subscriptions = None
        update_oper(None)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__device_entry) -> None:
        if subscriptions is None:
            generation += 1
            gen = generation
            subscriptions = ygdata.SubscriptionManager(dev.tree_provider(), str(path))
            state = flotilla_oper.subs.device.software.state
            platform_state = flotilla_oper.subs.device.state.platform
            subscriptions!.declare({
                state.dst(lambda keys, value, error: self.on_state(gen, keys, value, error)).deliver({
                    status_subscription(conf.name),
                }),
                platform_state.dst(lambda keys, value, error: self.on_platform(gen, keys, value, error)).deliver({
                    platform_subscription(conf.name),
                }),
            })


class Device(base.Device):
    def transform(self, i, di):
        if "stratoweave-rfs" not in di.modules:
            raise UnsupportedDevice()

        o = flotilla.root()
        dev = o.device.create(i.name)
        dev.type = i.type
        dev.description = i.description
        dev.approval_required = i.approval_required
        dev.sync_check = i.sync_check

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.platform.version = i.mock.platform.version
        dev.mock.platform.model = i.mock.platform.model
        dev.mock.platform.serial_number = i.mock.platform.serial_number
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.debug.log_level = i.debug.log_level
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch

        dev.software.upgrade_campaign = i.software.upgrade_campaign
        dev.software.target_release = i.software.target_release
        dev.software.image_url = i.software.image_url
        dev.software.allow_staging = i.software.allow_staging
        for veto in i.software.veto:
            dev.software.veto.create(veto.holder, reason=veto.reason)

        # The flotilla's device-health service gates the device's upgrade on
        # its BGP state.
        health = o.rfs.create(i.name).device_health
        health.enabled = True
        health.precheck_wait = i.upgrade_checks.precheck_wait
        health.postcheck_wait = i.upgrade_checks.postcheck_wait

        return o
