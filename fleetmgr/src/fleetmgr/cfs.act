import yang.identityref
import fleetmgr.layers.y_0_oper as y0_oper


class Node(base.Node):
    def transform(self, i):
        o = base.o_root()
        dev = o.device.create(i.name)
        dev.type = "flotilla"
        dev.description = i.description
        dev.approval_required = i.approval_required

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.software.running_release = i.mock.software.running_release
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch

        # One collector per flotilla observes only device software state from
        # the bottom RFS datastore. Per-campaign membership is filtered locally.
        o.rfs.create(i.name).flotilla_status.enabled = True
        return o


class Device(base.Device):
    def transform(self, i):
        o = base.o_root()
        dev = o.rfs.create(i.shard).device.create(i.name)
        dev.type = i.type
        dev.description = i.description
        dev.approval_required = i.approval_required

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.software.running_release = i.mock.software.running_release
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch
        return o


def device_estimate(dev: ?y_0.fleetmgr__fleet__device_entry) -> int:
    """Estimated upgrade duration for one device, from the adapter that
    will run it: the configured mock duration when the device is mocked,
    the adapter's nominal figure otherwise. Controllers correct this
    from observation; planning starts here."""
    if dev is not None:
        if dev.mock.enabled:
            dur = dev.mock.software.upgrade_duration
            if dur is not None and int(dur) > 0:
                return int(dur)
            return sw_mock.MockSoftwareAdapter.plan_estimate()
    # The IOS XE adapter is the only real one today.
    return sw_iosxe.IosXeSoftwareAdapter.plan_estimate()


def estimated_duration(i: y_0.software__software__upgrade_campaign_entry,
                       inventory: y_0.root) -> int:
    """The average estimated upgrade duration over the campaign's
    members, in seconds. The rates convert to concurrency through it,
    and the observed duration starts from it."""
    total = 0
    n = 0
    for member in i.device:
        total += device_estimate(inventory.fleet.device.get(member.name))
        n += 1
    # Estimates are at least a second each, so the average is too.
    return fs.ceil_div(total, n) if n > 0 else 1

# End offset of a window that never closes. Ten years in seconds: far
# beyond any campaign, still well inside uint32.
OPEN_END = 315360000

def campaign_debounce_s(devices: int) -> float:
    # Keep demos quick while limiting full campaign publishes at scale.
    debounce = float(devices) / 1000.0
    if debounce < 0.1:
        return 0.1
    if debounce > 30.0:
        return 30.0
    return debounce


def plan_campaign(i: y_0.software__software__upgrade_campaign_entry,
                  inventory: y_0.root) -> (list[(str, int, int, list[(str, int, int)])], list[str]):
    """Plan the campaign into its windows at the rate the deadline demands.

    A campaign without windows gets one synthetic window that opens at
    launch and never closes, and the controller paces it like any other.
    The deadline cuts off the window supply - the synthetic window
    included - and the required rate is computed backwards from what
    remains, raised to target-rate and capped at max-rate, with alarms
    rather than overruns. Rates are devices per hour; the core's
    concurrency is rate times estimated duration.

    Returns the materialized layout: one (name, start-offset, end-offset,
    devices) entry per window, each device with its estimated start
    offset, all in seconds from campaign launch, plus the placement
    alarms. Devices that do not fit are absent from the layout and
    present in the alarms.

    The transform actuates from the layout; the companion actor publishes
    the same layout as the plan, so both views come from one computation.
    """
    devices = []
    est_of: dict[str, int] = {}
    for member in i.device:
        est = device_estimate(inventory.fleet.device.get(member.name))
        est_of[member.name] = est
        devices.append(fs.DeviceIn(member.name, "cpe", None, [], [], est, True))
    estimate = estimated_duration(i, inventory)
    n = len(devices)
    if n == 0:
        return ([], [])
    sel = [d.name for d in devices]
    alarms: list[str] = []

    deadline = 0
    dl = i.deadline
    if dl is not None:
        deadline = int(dl)

    target = int(i.target_rate)
    cap = int(i.max_rate)

    wins: list[(str, int, int)] = []
    for w in i.window:
        wstart = int(w.start)
        wend = wstart + int(w.duration)
        if deadline > 0:
            # The deadline cuts off the window supply.
            if wstart >= deadline:
                continue
            if wend > deadline:
                wend = deadline
        wins.append(("window", wstart, wend))

    default_scheds = ["window"]
    if len(wins) == 0:
        # No windows: one synthetic window that opens at launch and never
        # closes, or closes at the deadline like any other window.
        wins.append(("default", 0, deadline if deadline > 0 else OPEN_END))
        default_scheds = ["default"]

    available = 0
    for we in wins:
        available += we.2 - we.1
    # The planner keeps a margin; plan the rate against what it will use.
    usable = available * 95 // 100
    needed = 0
    needed_c = 0
    if deadline > 0:
        # The rate the deadline demands, with the ramp-up inverted rather
        # than assumed away: the smallest concurrency whose waves finish
        # the fleet within the windows, converted back to a rate.
        spans = [(we.2 - we.1) * 95 // 100 for we in wins]
        needed_c = fs.needed_concurrency(spans, n, estimate, int(campaign_debounce_s(n)))
        needed = fs.ceil_div(needed_c * 3600, estimate)
    rate = needed
    if target > rate:
        rate = target
    if cap > 0 and rate > cap:
        rate = cap
        # Rates quantize to whole devices in flight, so the shortfall
        # test happens in concurrency, not in rates.
        max_c = imax(1, fs.ceil_div(cap * estimate, 3600))
        if needed_c > max_c:
            alarms.append("deadline needs {needed} devices/hour but max-rate "
                          + "is {cap}; not all devices will be placed in time")
    if rate == 0:
        rate = fs.ceil_div(n * 3600, usable) if usable > 0 else n * 3600

    conc = imax(1, fs.ceil_div(rate * estimate, 3600))

    ordered = sorted([(we.1, we.0, we.2) for we in wins])
    fwins = []
    for oe in ordered:
        fwins.append(fs.Window(oe.1, oe.0, oe.2, conc))
    camp = fs.Campaign(i.name, default_scheds, conc, conc, conc, 2, 0, "spread",
                       sel_device=sel, admin_state="run")
    r = fs.plan([], devices, camp, {}, [fs.ScriptedWindowGen(fwins)], 0, len(fwins))
    for a in r.alarms:
        alarms.append(a)

    # Estimated starts come from the controller's own logic: simulate each
    # window on estimate, with target and max concurrency derived exactly
    # as the live controller derives them. Prediction and execution then
    # disagree only where reality disagrees with the estimate.
    tr = int(i.target_rate)
    pred_target = imax(1, fs.ceil_div(tr * estimate, 3600)) if tr > 0 else 1
    mr = int(i.max_rate)
    pred_max = imax(pred_target, fs.ceil_div(mr * estimate, 3600)) if mr > 0 else 1000000

    layout: list[(str, int, int, list[(str, int, int)])] = []
    for we in wins:
        placed: list[str] = []
        for a in r.assigns:
            if a.status != "unplannable":
                if a.schedule == we.0 and a.start == we.1:
                    placed.append(a.device)
        if len(placed) > 0:
            pcamp = fs.Campaign(i.name, [we.0], pred_target, pred_max, 1, 2, 0,
                                "spread", admin_state="run")
            durations = [est_of.get_def(d, estimate) for d in placed]
            pred = fsim.simulate_window(len(placed), estimate, estimate,
                                        fs.Window(we.0, we.1, we.2, 1000000),
                                        pcamp, 1, int(campaign_debounce_s(n)),
                                        durations=durations)
            devs: list[(str, int, int)] = []
            idx = 0
            for d in placed:
                if idx < len(pred.launch_offsets):
                    devs.append((d, pred.launch_offsets[idx], est_of.get_def(d, estimate)))
                else:
                    # The core placed it, but the ramp cannot reach it
                    # before the window closes: show it at the close.
                    devs.append((d, we.2, est_of.get_def(d, estimate)))
                idx += 1
            layout.append((we.0, we.1, we.2, devs))

    # Devices the core placed but the ramp cannot reach before their
    # window closes are shown at the close; say so out loud too.
    overflow = 0
    for win in layout:
        if win.2 != OPEN_END:
            for entry in win.3:
                if entry.1 >= win.2:
                    overflow += 1
    if overflow > 0:
        alarms.append("{overflow} device(s) will not complete before their "
                      + "window closes at the planned rate")
    return (layout, alarms)


class UpgradeCampaign(base.UpgradeCampaign):
    def transform(self, i, linked, dynstate):
        """Plan through the scheduling core and actuate the released layout.

        Every campaign is paced: the companion actor decides which planned
        devices are released and writes the decision as dynstate, and this
        function actuates exactly that set - a device never starts before
        the controller says so. The actor publishes the same layout under
        state as the plan.
        """
        o = base.o_root()
        released: set[str] = set()
        if dynstate is not None:
            for name in dynstate.released:
                released.add(name)
        if i.admin_state == "run":
            inventory = y_0.root.from_gdata(linked)
            layout, alarms = plan_campaign(i, inventory)
            for win in layout:
                for entry in win.3:
                    if entry.0 not in released:
                        continue
                    fleet_device = inventory.fleet.device.get(entry.0)
                    if fleet_device is not None:
                        dev = o.rfs.create(fleet_device.shard).device.create(entry.0)
                        dev.software.target_release = i.target_release
                        dev.software.upgrade_campaign = i.name
                        dev.software.image_url = i.image_url
                        dev.software.allow_staging = i.allow_staging
        return o


def imax(a: int, b: int) -> int:
    return a if a > b else b


actor UpgradeCampaignTransform(path: ttt.Path,
                               update_dynstate: proc(?y_0.software__software__upgrade_campaign__dynstate) -> None,
                               update_oper: proc(?y0_oper.software__software__upgrade_campaign_entry) -> None,
                               lower_tree_provider: ?ygdata.TreeProvider):
    """Aggregate flotilla telemetry and control the release of the plan.

    The actor plans for itself from the campaign and runs the core
    controller on the layout and the telemetry, driven by events rather
    than a tick: on-change telemetry arms a debounce timer and the timer
    firing decides once for the whole batch; window openings and the
    projected shortfall crossing get exact timers of their own. Releases
    start small and double as upgrades complete, and the decision is
    written as dynstate for the transform to actuate.
    """
    var members: list[str] = []
    var member_names: set[str] = set()
    var latest: dict[str, (rfs_name: str, state: FlotillaDeviceStatus)] = {}
    var subscriptions: ?ygdata.SubscriptionManager = None
    var subscriptions_synced = False
    var plan_layout: list[(str, int, int, list[(str, int, int)])] = []
    var plan_alarms: list[str] = []
    var running = False
    var active = False
    var generation = 0
    var debounce_armed = False
    var debounce_s = campaign_debounce_s(0)
    var alarmed = False
    var controller_alarms: list[str] = []
    var anchor: ?time.Instant = None
    var released: set[str] = set()
    var released_at: dict[str, int] = {}
    var done_at: dict[str, int] = {}
    var observed_s: int = 1
    var rung: int = 1
    var rung_target: int = 1
    var target_c: int = 1
    var max_c: int = 1

    def publish() -> None:
        oper = base.UpgradeCampaign.new_state(path)
        st = oper.state
        in_progress = 0
        succeeded = 0
        failed = 0

        for d in members:
            status: ?str = None
            running_release: ?str = None
            observed = latest.get(d)
            if observed is not None:
                status = observed.state.status
                running_release = observed.state.running_release

            ds = st.device_status.create(d)
            ds.status = status if status is not None else "pending"
            ds.running_release = running_release

            if status == "in-progress":
                in_progress += 1
            elif status == "succeeded" or status == "up-to-date":
                succeeded += 1
            elif status == "failed" or status == "rolled-back":
                failed += 1

        st.total = u64(len(members))
        st.in_progress = u64(in_progress)
        st.succeeded = u64(succeeded)
        st.failed = u64(failed)

        # The materialized plan: the same computation the transform actuates,
        # published so the layout is inspectable before and during the run.
        for pw in plan_layout:
            win = st.plan.window.create((schedule=pw.0, start=u64(pw.1)))
            if pw.2 != OPEN_END:
                win.end = u64(pw.2)
            for entry in pw.3:
                pd = win.device.create(entry.0)
                pd.estimated_start = u64(entry.1)
                pd.estimated_duration = u64(entry.2)
        for alarm in plan_alarms:
            st.plan.alarm.append(alarm)
        for alarm in controller_alarms:
            st.plan.alarm.append(alarm)
        update_oper(oper)

    def on_rfs(
        keys: ?(rfs_name: str, device_name: str),
        state: ?FlotillaDeviceStatus,
        error: ?Exception,
    ) -> None:
        relevant = error is not None
        if error is not None:
            print("campaign status subscription failed at {path}: {error}", err=True)
            latest = {}
        elif keys is not None:
            relevant = keys.device_name in member_names
            if state is not None:
                latest[keys.device_name] = (
                    rfs_name=keys.rfs_name,
                    state=state,
                )
            else:
                previous = latest.get(keys.device_name)
                if previous is not None and previous.rfs_name == keys.rfs_name:
                    del latest[keys.device_name]
        if relevant and subscriptions_synced and active and not debounce_armed:
            debounce_armed = True
            gen = generation
            after debounce_s: decide(gen)

    def on_subscriptions_synced() -> None:
        subscriptions_synced = True
        gen = generation
        if active:
            after 0.0: decide(gen)
        else:
            publish()

    def shutdown() -> None:
        # Releasing the subscriptions here is a separate change.
        pass

    def decide(gen: int) -> None:
        """Note completions, release what fits, and arm the next event."""
        if gen != generation or not active:
            return
        a = anchor
        if a is None:
            return
        debounce_armed = False
        generation += 1
        next_gen = generation
        t = int(time.monotonic().since(a!).to_float())

        for name in released:
            if name not in done_at:
                observed = latest.get(name)
                if observed is not None:
                    status = observed.state.status
                    if status == "succeeded" or status == "up-to-date" or \
                       status == "failed" or status == "rolled-back":
                        done_at[name] = t
                        took = imax(1, t - released_at.get_def(name, 0))
                        observed_s = (observed_s * 3 + took) // 4

        if len(done_at) >= rung_target and rung < target_c:
            rung = fs.ramp_next(rung, 2, target_c)
            rung_target = len(done_at) + rung

        grew = False
        placed_total = 0
        next_edge = -1
        crossings: list[(int, int)] = []
        for win in plan_layout:
            wstart = win.1
            wend = win.2
            placed_total += len(win.3)
            inflight = 0
            waiting = []
            for entry in win.3:
                if entry.0 in released:
                    if entry.0 not in done_at:
                        inflight += 1
                else:
                    waiting.append(entry.0)
            if len(waiting) > 0 and wend != OPEN_END and t < wend:
                crossings.append((wend, len(waiting)))
            if wstart > t and len(waiting) > 0:
                # A window opening is plain arithmetic in time: arm a
                # timer for it instead of polling toward it.
                if next_edge < 0 or wstart < next_edge:
                    next_edge = wstart
            if t < wstart or t >= wend:
                continue
            n_new = fs.launch_count(len(waiting), inflight, observed_s, wend - t,
                                    target_c, max_c, rung, 1000000)
            idx = 0
            for name in waiting:
                if idx < n_new:
                    released.add(name)
                    released_at[name] = t
                    grew = True
                idx += 1
        if grew:
            update_dynstate(y_0.software__software__upgrade_campaign__dynstate(
                released=sorted(list(released))))
        if next_edge >= 0:
            delay = float(next_edge - t)
            after delay: decide(next_gen)
        if not alarmed:
            # So is the moment a window stops being makeable: arm the
            # alarm for the projected crossing rather than waiting for
            # the next completion to reveal it.
            t_alarm = -1
            sf_now = 0
            for c in crossings:
                g_need = fs.ceil_div(c.1, max_c)
                t_need = (g_need - 1) * observed_s + (observed_s * 12) // 10
                t_x = c.0 - t_need + 1
                if t_x <= t:
                    sf_now += fs.shortfall(c.1, observed_s, c.0 - t, max_c)
                elif t_alarm < 0 or t_x < t_alarm:
                    t_alarm = t_x
            if sf_now > 0:
                alarmed = True
                controller_alarms.append("{sf_now} device(s) cannot make their "
                                         + "window even at max concurrency - deferral projected")
            elif t_alarm >= 0:
                delay = float(t_alarm - t)
                after delay: decide(next_gen)
        if placed_total > 0 and len(done_at) >= placed_total:
            active = False
        publish()

    def on_conf(conf: y_0.software__software__upgrade_campaign_entry, linked: ygdata.Node) -> None:
        ms = []
        names: set[str] = set()
        for member in conf.device:
            ms.append(member.name)
            names.add(member.name)
        members = ms
        member_names = names
        debounce_s = campaign_debounce_s(len(members))

        inventory = y_0.root.from_gdata(linked)
        layout, alarms = plan_campaign(conf, inventory)
        plan_layout = layout
        plan_alarms = alarms

        # Concurrency the controller may spend: the rates convert through
        # the same estimate the plan was made with.
        estimate = estimated_duration(conf, inventory)
        tr = int(conf.target_rate)
        target_c = imax(1, fs.ceil_div(tr * estimate, 3600)) if tr > 0 else 1
        mr = int(conf.max_rate)
        max_c = imax(target_c, fs.ceil_div(mr * estimate, 3600)) if mr > 0 else 1000000

        paced = len(plan_layout) > 0
        run_now = conf.admin_state == "run"
        if run_now and not running:
            # The window clock starts when the campaign starts.
            anchor = time.monotonic()
            released = set()
            released_at = {}
            done_at = {}
            observed_s = estimated_duration(conf, y_0.root.from_gdata(linked))
            rung = 1
            rung_target = 1
            alarmed = False
            controller_alarms = []
        running = run_now
        # New intent invalidates every armed timer. The first decision after
        # subscription sync arms the exact timers the fresh layout needs.
        generation += 1
        debounce_armed = False
        if running and paced:
            active = True
        else:
            active = False

        if lower_tree_provider is not None and subscriptions is None:
            subscriptions = ygdata.SubscriptionManager(
                lower_tree_provider!,
                "campaign-status:{path}",
            )

        if subscriptions is not None:
            want: set[ygdata.Delivery] = set()
            if len(members) > 0:
                statuses = y1_oper.subs.rfs.flotilla_status.state.device
                want.add(statuses.dst(on_rfs).deliver({
                    statuses.subscribe(),
                }))
            else:
                # A later subscription starts with a fresh rooted replay. Do
                # not retain entries that may disappear while unsubscribed.
                latest = {}
            subscriptions_synced = False
            subscriptions!.declare(want, synced=on_subscriptions_synced)
        else:
            gen = generation
            if active:
                after 0.0: decide(gen)
            else:
                publish()
