def flotilla_index(name: str) -> int:
    """Return the index of the flotilla that manages the device called name.
    Acton hashes a string the same way on every run, so a device stays on
    its flotilla across restarts."""
    return int(hash(name) % u64(supervisor.FLOTILLA_COUNT))


def flotilla_of(name: str) -> str:
    """Return the name of the flotilla that manages the device called name."""
    return "flotilla-{flotilla_index(name) + 1}"


class Device(base.Device):
    def transform(self, i):
        o = base.o_root()
        flotilla = flotilla_of(i.name)

        # The top's own entry for the flotilla. Every device on a flotilla
        # writes the same one, so the top connects to a flotilla once it has
        # a device.
        flotilla_dev = o.device.create(flotilla)
        flotilla_dev.type = "flotilla"
        flotilla_dev.sync_check = False
        port = supervisor.BASE_NETCONF_PORT + flotilla_index(i.name)
        flotilla_dev.address.create("primary", address="127.0.0.1", port=u64(port))
        # The flotillas' default NETCONF login.
        # TODO: reuse the top's northbound NETCONF credentials.
        flotilla_dev.credentials.username = "admin"
        flotilla_dev.credentials.password = "admin"

        dev = o.rfs.create(flotilla).device.create(i.name)
        dev.type = i.type
        dev.description = i.description
        dev.approval_required = i.approval_required
        dev.sync_check = i.sync_check

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.software.running_release = i.mock.software.running_release
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.debug.log_level = i.debug.log_level
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch
        dev.upgrade_checks.precheck_wait = i.upgrade_checks.precheck_wait
        dev.upgrade_checks.postcheck_wait = i.upgrade_checks.postcheck_wait
        return o


def device_estimate(dev: ?y_0.fleetmgr__fleet__device_entry) -> int:
    """Estimated upgrade duration for one device, from the adapter that
    will run it: the configured mock duration when the device is mocked,
    the adapter's nominal figure otherwise. Controllers correct this
    from observation; planning starts here."""
    if dev is not None:
        if dev.mock.enabled:
            dur = dev.mock.software.upgrade_duration
            if dur is not None and int(dur) > 0:
                return int(dur)
            return sw_mock.MockSoftwareAdapter.plan_estimate()
    # The IOS XE adapter is the only real one today.
    return sw_iosxe.IosXeSoftwareAdapter.plan_estimate()


def estimated_duration(i: y_0.software__software__upgrade_campaign_entry,
                       inventory: y_0.root) -> int:
    """The average estimated upgrade duration over the campaign's
    members, in seconds. The observed duration starts from it."""
    total = 0
    n = 0
    for member in i.device:
        total += device_estimate(inventory.fleet.device.get(member.name))
        n += 1
    # Estimates are at least a second each, so the average is too.
    return fs.ceil_div(total, n) if n > 0 else 1

# End of a window that never closes: the year 2100 as seconds since the
# Unix epoch, far beyond any campaign.
OPEN_END = 4102444800

def campaign_debounce_s(devices: int) -> float:
    # Keep demos quick while limiting full campaign publishes at scale.
    debounce = float(devices) / 1000.0
    if debounce < 0.1:
        return 0.1
    if debounce > 30.0:
        return 30.0
    return debounce


_DAYS = {"mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6}

# How far ahead the planner generates window occurrences. Nine days
# covers a weekly rule with margin; longer recurrences come later.
HORIZON_DAYS = 9


def occurrences(sched: y_0.maintenance__schedules__schedule_entry, now: int) -> list[(int, int)]:
    """The schedule's absolute window occurrences over the horizon, as
    seconds since the Unix epoch: each rule opens at its local time of
    day on its listed weekdays, every day when none are listed. A window
    already open now is included, also one that opened on an earlier day
    within the horizon; a closed one is not."""
    out: list[(int, int)] = []
    off = int(sched.utc_offset) * 60
    local_now = now + off
    day0 = local_now - local_now % 86400
    for w in sched.window:
        at = int(w.at)
        dur = int(w.duration)
        days: list[int] = []
        for d in w.day:
            if d in _DAYS:
                days.append(_DAYS[d])
        # A window that opened days ago can still be open; the horizon
        # bounds how far back too.
        for k in range(fs.imax(-(dur // 86400) - 1, -HORIZON_DAYS), HORIZON_DAYS):
            local_day = day0 + k * 86400
            if len(days) > 0:
                # 1970-01-01 was a Thursday; monday is day zero here.
                wd = (local_day // 86400 + 3) % 7
                if wd not in days:
                    continue
            start = local_day + at - off
            if start + dur <= now:
                continue
            out.append((start, start + dur))
    return sorted(out)


def plan_campaign(i: y_0.software__software__upgrade_campaign_entry,
                  inventory: y_0.root, now: int,
                  released_in: dict[str, (str, int, int)] = {},
                  released_at: dict[str, int] = {},
                  done_at: dict[str, int] = {}) -> (list[(str, int, int, list[(str, int, int)])], list[str]):
    """Plan the campaign into its windows at the concurrency the deadline
    demands.

    A campaign without windows gets one synthetic window that opens at
    launch and never closes, and the controller paces it like any other.
    The deadline cuts off the window supply - the synthetic window
    included - and the concurrency it needs is computed backwards from
    what remains, raised to target-concurrency and capped at
    max-concurrency, with alarms rather than overruns.

    Devices the controller has released stay in the window they were
    released in (released_in: schedule, start, end), at their real
    start, also when that window has closed or its schedule changed
    since. Only the others are placed and simulated: devices in flight
    hold their slots until they are expected to finish, done ones take
    no part.

    Returns the materialized layout: one (name, start, end, devices)
    entry per window, each device with its start, real or estimated,
    and its estimated duration, times as seconds since the Unix epoch,
    plus the placement alarms. Devices that do not fit are absent from
    the layout and present in the alarms.

    The transform actuates from the layout; the companion actor publishes
    the same layout as the plan, so both views come from one computation.
    """
    devices = []
    est_of: dict[str, int] = {}
    held: list[str] = []
    for member in i.device:
        dev = inventory.fleet.device.get(member.name)
        est = device_estimate(dev)
        est_of[member.name] = est
        if member.name in released_in:
            held.append(member.name)
            continue
        binding: ?str = None
        if dev is not None:
            binding = dev.schedule
        devices.append(fs.DeviceIn(member.name, "cpe", binding, [], [], est, True))
    estimate = estimated_duration(i, inventory)
    if len(est_of) == 0:
        return ([], [])
    n = len(devices)
    debounce = int(campaign_debounce_s(len(est_of)))
    sel = [d.name for d in devices]
    alarms: list[str] = []

    deadline = 0
    dl = i.deadline
    if dl is not None:
        deadline = int(dl)

    target = int(i.target_concurrency)
    cap = imax(target, int(i.max_concurrency))

    default_scheds: list[str] = []
    ds = i.default_schedule
    if ds is not None:
        default_scheds = [ds]

    referenced: list[str] = []
    for d in devices:
        b = d.schedule
        if b is not None:
            if b not in referenced:
                referenced.append(b)
    for name in default_scheds:
        if name not in referenced:
            referenced.append(name)

    wins: list[(str, int, int)] = []
    for sname in referenced:
        sched = inventory.schedules.schedule.get(sname)
        if sched is not None:
            for we in occurrences(sched, now):
                wstart = we.0
                wend = we.1
                if deadline > 0:
                    # The deadline cuts off the window supply.
                    if wstart >= deadline:
                        continue
                    if wend > deadline:
                        wend = deadline
                wins.append((sname, wstart, wend))

    if len(wins) == 0:
        # No windows: one synthetic window that opens at launch and never
        # closes, or closes at the deadline like any other window.
        wins.append(("default", 0, deadline if deadline > 0 else OPEN_END))
        default_scheds = ["default"]

    needed_c = 0
    if deadline > 0:
        # The concurrency the deadline demands, with the ramp-up inverted
        # rather than assumed away: the smallest concurrency whose waves
        # finish the fleet within the windows. The planner keeps a margin,
        # so it plans against what it will use.
        spans = [(we.2 - imax(we.1, now)) * 95 // 100 for we in wins]
        needed_c = fs.needed_concurrency(spans, n, estimate, debounce)
    conc = needed_c if needed_c > target else target
    if conc > cap:
        conc = cap
        alarms.append("deadline needs {needed_c} devices at once but "
                      + "max-concurrency is {cap}; not all devices will be placed in time")

    # A window already open gets only the time it has left, so the core
    # does not fill it as if it were whole.
    ordered = sorted([(imax(we.1, now), we.0, we.2) for we in wins])
    fwins = []
    for oe in ordered:
        fwins.append(fs.Window(oe.1, oe.0, oe.2, conc))
    camp = fs.Campaign(i.name, default_scheds, conc, conc, conc, 2, 0, "spread",
                       sel_device=sel, admin_state="run")
    r = fs.plan([], devices, camp, {}, [fs.ScriptedWindowGen(fwins)], 0, len(fwins))
    for a in r.alarms:
        alarms.append(a)

    # Estimated starts come from the controller's own logic: simulate each
    # window on estimate, with the target and max concurrency the live
    # controller uses. Prediction and execution then disagree only where
    # reality disagrees with the estimate.

    # Released devices by the window they were released in. Windows the
    # schedules no longer produce, closed since or changed, come first.
    current: set[str] = set()
    for we in wins:
        current.add("{we.0}@{we.1}")
    held_in: dict[str, list[(int, str)]] = {}
    gone: list[(int, str, int)] = []
    for name in held:
        hw = released_in[name]
        k = "{hw.0}@{hw.1}"
        if k not in held_in:
            held_in[k] = []
            if k not in current:
                gone.append((hw.1, hw.0, hw.2))
        held_in[k].append((released_at.get_def(name, now), name))
    all_wins = [(g.1, g.0, g.2) for g in sorted(gone)] + wins

    layout: list[(str, int, int, list[(str, int, int)])] = []
    overflow = 0
    for we in all_wins:
        devs: list[(str, int, int)] = []
        running: list[(int, int)] = []
        for h in sorted(held_in.get_def("{we.0}@{we.1}", [])):
            est = est_of.get_def(h.1, estimate)
            devs.append((h.1, h.0, est))
            if h.1 not in done_at:
                running.append((h.0 + est, est))
        # The core places devices only in the windows the schedules give
        # now. A window that closed or changed keeps only the devices
        # released in it, also when its start matches an open window's.
        placed: list[str] = []
        if "{we.0}@{we.1}" in current:
            for a in r.assigns:
                if a.status != "unplannable":
                    if a.schedule == we.0 and a.start == imax(we.1, now):
                        placed.append(a.device)
        if len(placed) > 0:
            pcamp = fs.Campaign(i.name, [we.0], target, cap, 1, 2, 0,
                                "spread", admin_state="run")
            durations = [est_of.get_def(d, estimate) for d in placed]
            # A window already open predicts from now, not from its past
            # opening. The controller has ramped at least as far as it
            # has devices in flight.
            pred = fsim.simulate_window(len(placed), estimate, estimate,
                                        fs.Window(we.0, imax(we.1, now), we.2, 1000000),
                                        pcamp, imax(1, len(running)), debounce,
                                        durations=durations,
                                        running=running)
            idx = 0
            for d in placed:
                if idx < len(pred.launch_offsets):
                    devs.append((d, pred.launch_offsets[idx], est_of.get_def(d, estimate)))
                else:
                    # The core placed it, but the ramp cannot reach it
                    # before the window closes: show it at the close.
                    devs.append((d, we.2, est_of.get_def(d, estimate)))
                    if we.2 != OPEN_END:
                        overflow += 1
                idx += 1
        if len(devs) > 0:
            layout.append((we.0, we.1, we.2, devs))

    # Devices the core placed but the ramp cannot reach before their
    # window closes are shown at the close; say so out loud too.
    if overflow > 0:
        alarms.append("{overflow} device(s) will not complete before their "
                      + "window closes at the planned concurrency")
    return (layout, alarms)


class Schedules(base.Schedules):
    def transform(self, i):
        """Maintenance schedules produce no configuration of their own.

        The container is a transform so campaigns can link it: their
        transforms and companion actors receive every schedule as linked
        input and re-plan when one changes.
        """
        return base.o_root()


def route_software(o: y_1_loose.root, fleet_device: y_0.fleetmgr__fleet__device_entry,
                   i: y_0.software__software__upgrade_campaign_entry) -> None:
    """Write the software intent of campaign i for one device to its flotilla."""
    software = o.rfs.create(flotilla_of(fleet_device.name)).device.create(fleet_device.name).software
    software.target_release = i.target_release
    software.upgrade_campaign = i.name
    software.image_url = i.image_url
    software.allow_staging = i.allow_staging


def campaign_config(i: y_0.software__software__upgrade_campaign_entry, inventory: y_0.root,
                    released: set[str]) -> y_1_loose.root:
    """Return the software intent of campaign i for its members in released.
    A campaign that does not run has no configuration."""
    o = base.o_root()
    if i.admin_state == "run":
        for member in i.device:
            if member.name in released:
                fleet_device = inventory.fleet.device.get(member.name)
                if fleet_device is not None:
                    route_software(o, fleet_device, i)
    return o


class UpgradeCampaign(base.UpgradeCampaign):
    def transform(self, i, linked):
        return base.o_root()


def imax(a: int, b: int) -> int:
    return a if a > b else b

actor UpgradeCampaignTransform(path: ttt.Path,
                               write_output: action(ygdata.Node) -> None,
                               update_oper: proc(?y0_oper.software__software__upgrade_campaign_entry) -> None,
                               lower_tree_provider: ?ygdata.TreeProvider):
    """Aggregate device telemetry and control the release of the plan.

    The actor plans for itself from the campaign and runs a
    fctl.Controller on the layout and the device reports, driven by events
    rather than a tick: on-change telemetry arms a debounce timer and the
    timer firing decides once for the whole batch; the controller says
    when it next needs to decide, at a window opening or the projected
    shortfall crossing, and the actor arms an exact timer for it. Releases
    start small and double as upgrades complete. The actor sends the
    configuration of the released devices directly.
    """
    var members: list[str] = []
    var member_names: set[str] = set()
    var latest: dict[str, (status: ?str, running_release: ?str, stage: ?str,
                           reason: ?str,
                           precheck: (verdict: ?str, detail: ?str, at: ?str),
                           postcheck: (verdict: ?str, detail: ?str, at: ?str))] = {}
    var subscriptions: ?ygdata.SubscriptionManager = None
    var subscriptions_synced = False
    var plan_layout: list[(str, int, int, list[(str, int, int)])] = []
    var plan_alarms: list[str] = []
    var running = False
    var active = False
    var generation = 0
    var debounce_armed = False
    var debounce_s = campaign_debounce_s(0)
    var ctl = fctl.Controller()
    # The campaign and the inventory from the last on_conf, and the
    # configuration they give for the released devices.
    var campaign: ?y_0.software__software__upgrade_campaign_entry = None
    var inventory = y_0.root()
    var output: ygdata.Node = base.o_root().to_gdata()

    def patch_output(names: set[str]) -> None:
        """Patch the configuration of the devices in names into output and emit it."""
        current = campaign
        if current is not None:
            patched = ygdata.patch(output, campaign_config(current, inventory, names).to_gdata())
            # None is an empty result: output stays empty.
            if patched is not None:
                output = patched
            write_output(output)

    def publish() -> None:
        oper = base.UpgradeCampaign.new_state(path)
        st = oper.state
        in_progress = 0
        succeeded = 0
        failed = 0

        for d in members:
            status: ?str = None
            running_release: ?str = None
            observed = latest.get(d)
            if observed is not None:
                status = observed.status
                running_release = observed.running_release

            ds = st.device_status.create(d)
            ds.status = status if status is not None else "pending"
            ds.running_release = running_release
            if observed is not None:
                ds.stage = observed.stage
                ds.reason = observed.reason
                ds.precheck.verdict = observed.precheck.verdict
                ds.precheck.detail = observed.precheck.detail
                ds.precheck.at = observed.precheck.at
                ds.postcheck.verdict = observed.postcheck.verdict
                ds.postcheck.detail = observed.postcheck.detail
                ds.postcheck.at = observed.postcheck.at

            if status == "in-progress":
                in_progress += 1
            elif status == "succeeded" or status == "up-to-date":
                succeeded += 1
            elif status == "failed" or status == "rolled-back":
                failed += 1

        st.total = u64(len(members))
        st.in_progress = u64(in_progress)
        st.succeeded = u64(succeeded)
        st.failed = u64(failed)

        # The materialized plan: the same computation the transform actuates,
        # published so the layout is inspectable before and during the run.
        for pw in plan_layout:
            win = st.plan.window.create((schedule=pw.0, start=u64(pw.1)))
            if pw.2 != OPEN_END:
                win.end = u64(pw.2)
            for entry in pw.3:
                pd = win.device.create(entry.0)
                started = ctl.released_at.get(entry.0)
                if started is not None:
                    pd.started = u64(started)
                    finished = ctl.done_at.get(entry.0)
                    if finished is not None:
                        pd.finished = u64(finished)
                else:
                    pd.estimated_start = u64(entry.1)
                pd.estimated_duration = u64(entry.2)
        for alarm in plan_alarms:
            st.plan.alarm.append(alarm)
        for alarm in ctl.alarms:
            st.plan.alarm.append(alarm)
        update_oper(oper)

    def observe(name: str, status: ?str, running_release: ?str, stage: ?str,
                reason: ?str,
                precheck: (verdict: ?str, detail: ?str, at: ?str),
                postcheck: (verdict: ?str, detail: ?str, at: ?str)) -> None:
        """Keep the state of one device, as its flotilla reports it, and
        pass its status to the controller."""
        latest[name] = (status=status, running_release=running_release,
                        stage=stage, reason=reason, precheck=precheck, postcheck=postcheck)
        ctl.report(name, status)

    def forget(name: str) -> None:
        if name in latest:
            del latest[name]
        ctl.lost(name)

    def changed(relevant: bool) -> None:
        if relevant and subscriptions_synced and active and not debounce_armed:
            debounce_armed = True
            gen = generation
            # after now: the batch gets the whole window, however late the
            # telemetry that opens it arrives.
            after now debounce_s: decide(gen)

    def on_rfs(
        keys: ?(rfs_name: str, device_name: str),
        state: ?FlotillaDeviceStatus,
        error: ?Exception,
    ) -> None:
        relevant = error is not None
        if error is not None:
            print("campaign status subscription failed at {path}: {error}", err=True)
            latest = {}
            ctl.lost_all()
        elif keys is not None:
            relevant = keys.device_name in member_names
            if state is not None:
                pre = state.precheck
                post = state.postcheck
                observe(keys.device_name, state.status, state.running_release,
                        state.stage, state.reason,
                        (verdict=pre.verdict, detail=pre.detail, at=pre.at),
                        (verdict=post.verdict, detail=post.detail, at=post.at))
            else:
                forget(keys.device_name)
        changed(relevant)

    def on_subscriptions_synced() -> None:
        subscriptions_synced = True
        gen = generation
        if active:
            after 0.0: decide(gen)
        else:
            publish()

    def shutdown() -> None:
        # Releasing the subscriptions here is a separate change.
        pass

    def decide(gen: int) -> None:
        """Run one step of the controller, start the devices it releases,
        and arm the next decision at the time the step says."""
        if gen != generation or not active:
            return
        debounce_armed = False
        generation += 1
        next_gen = generation
        t = time.time().unix_s()
        s = ctl.step(t)
        if len(s.started) > 0:
            patch_output(set(s.started))
        if s.wake >= 0:
            after now float(s.wake - t): decide(next_gen)
        if s.finished:
            active = False
        publish()

    def on_conf(conf: y_0.software__software__upgrade_campaign_entry, linked: ygdata.Node) -> None:
        ms = []
        names: set[str] = set()
        for member in conf.device:
            ms.append(member.name)
            names.add(member.name)
        members = ms
        member_names = names
        debounce_s = campaign_debounce_s(len(members))

        campaign = conf
        inventory = y_0.root.from_gdata(linked)
        run_now = conf.admin_state == "run"
        if run_now and not running:
            ctl.start(estimated_duration(conf, inventory))
        running = run_now
        output = campaign_config(conf, inventory, ctl.released).to_gdata()
        write_output(output)

        # Released devices keep their window and real times in the replan.
        layout, alarms = plan_campaign(conf, inventory, time.time().unix_s(),
                                       ctl.released_in, ctl.released_at, ctl.done_at)
        plan_layout = layout
        plan_alarms = alarms

        target_c = int(conf.target_concurrency)
        ctl.configure(layout, target_c, imax(target_c, int(conf.max_concurrency)))

        paced = len(plan_layout) > 0
        # New intent invalidates every armed timer. The first decision after
        # subscription sync arms the exact timers the fresh layout needs.
        generation += 1
        debounce_armed = False
        if running and paced:
            active = True
        else:
            active = False

        if lower_tree_provider is not None and subscriptions is None:
            subscriptions = ygdata.SubscriptionManager(
                lower_tree_provider!,
                "campaign-status:{path}",
            )

        if subscriptions is not None:
            want: set[ygdata.Delivery] = set()
            if len(members) > 0:
                statuses = y1_oper.subs.rfs.device.software.state
                want.add(statuses.dst(on_rfs).deliver({
                    statuses.subscribe(),
                }))
            else:
                # A later subscription starts with a fresh rooted replay. Do
                # not retain entries that may disappear while unsubscribed.
                latest = {}
                ctl.lost_all()
            subscriptions_synced = False
            subscriptions!.declare(want, synced=on_subscriptions_synced)
        else:
            gen = generation
            if active:
                after 0.0: decide(gen)
            else:
                publish()
