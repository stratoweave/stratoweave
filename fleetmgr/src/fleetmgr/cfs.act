import time
import yang.adata as yadata
import yang.gdata as ygdata
import stratoweave.ttt as ttt

import stratoweave.fleet_sched as fs

import fleetmgr.layers.base_0 as base
import fleetmgr.layers.y_0 as y_0
import fleetmgr.layers.y_1_oper as y1_oper
# TODO: required by the compiler, see acton issue #2390
import yang.identityref
import fleetmgr.layers.y_0_oper as y0_oper


class Node(base.Node):
    def transform(self, i):
        o = base.o_root()
        dev = o.device.create(i.name)
        dev.type = "flotilla"
        dev.description = i.description
        dev.approval_required = i.approval_required

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.software.running_release = i.mock.software.running_release
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch

        # One collector per flotilla observes only device software state from
        # the bottom RFS datastore. Per-campaign membership is filtered locally.
        o.rfs.create(i.name).flotilla_status.enabled = True
        return o


class Device(base.Device):
    def transform(self, i):
        o = base.o_root()
        dev = o.rfs.create(i.shard).device.create(i.name)
        dev.type = i.type
        dev.description = i.description
        dev.approval_required = i.approval_required

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.software.running_release = i.mock.software.running_release
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch
        return o


# Mock installs take 1-4s; the planner sizes window concurrency from this.
EST_S = 4

# End offset of a window that never closes. Ten years in seconds: far
# beyond any campaign, still well inside uint32.
OPEN_END = 315360000


def plan_campaign(i: y_0.software__software__upgrade_campaign_entry) -> (list[(str, int, int, list[(str, int)])], list[str]):
    """Plan the campaign into its windows at the rate the deadline demands.

    A campaign without windows gets one synthetic window that opens at
    launch and never closes, and the controller paces it like any other.
    The deadline cuts off the window supply - the synthetic window
    included - and the required rate is computed backwards from what
    remains, raised to target-rate and capped at max-rate, with alarms
    rather than overruns. Rates are devices per hour; the core's
    concurrency is rate times estimated duration.

    Returns the materialized layout: one (name, start-offset, end-offset,
    devices) entry per window, each device with its estimated start
    offset, all in seconds from campaign launch, plus the placement
    alarms. Devices that do not fit are absent from the layout and
    present in the alarms.

    The transform actuates from the layout; the companion actor publishes
    the same layout as the plan, so both views come from one computation.
    """
    devices = []
    for member in i.device:
        devices.append(fs.DeviceIn(member.name, "cpe", None, [], [], EST_S, True))
    n = len(devices)
    if n == 0:
        return ([], [])
    sel = [d.name for d in devices]
    alarms: list[str] = []

    deadline = 0
    dl = i.deadline
    if dl is not None:
        deadline = int(dl)

    target = int(i.target_rate)
    cap = int(i.max_rate)

    wins: list[(str, int, int)] = []
    for w in i.window:
        wstart = int(w.start)
        wend = wstart + int(w.duration)
        if deadline > 0:
            # The deadline cuts off the window supply.
            if wstart >= deadline:
                continue
            if wend > deadline:
                wend = deadline
        wins.append(("window", wstart, wend))

    default_scheds = ["window"]
    if len(wins) == 0:
        # No windows: one synthetic window that opens at launch and never
        # closes, or closes at the deadline like any other window.
        wins.append(("default", 0, deadline if deadline > 0 else OPEN_END))
        default_scheds = ["default"]

    available = 0
    for we in wins:
        available += we.2 - we.1
    # The planner keeps a margin; plan the rate against what it will use.
    usable = available * 95 // 100
    needed = 0
    if deadline > 0 and usable > 0:
        needed = fs.ceil_div(n * 3600, usable)
    rate = needed
    if target > rate:
        rate = target
    if cap > 0 and rate > cap:
        rate = cap
        if needed > cap:
            alarms.append("deadline needs {needed} devices/hour but max-rate "
                          + "is {cap}; not all devices will be placed in time")
    if rate == 0:
        rate = fs.ceil_div(n * 3600, usable) if usable > 0 else n * 3600

    conc = imax(1, fs.ceil_div(rate * EST_S, 3600))

    ordered = sorted([(we.1, we.0, we.2) for we in wins])
    fwins = []
    for oe in ordered:
        fwins.append(fs.Window(oe.1, oe.0, oe.2, conc))
    camp = fs.Campaign(i.name, default_scheds, conc, conc, conc, 2, 0, "spread",
                       sel_device=sel, admin_state="run")
    r = fs.plan([], devices, camp, {}, [fs.ScriptedWindowGen(fwins)], 0, len(fwins))
    for a in r.alarms:
        alarms.append(a)

    layout: list[(str, int, int, list[(str, int)])] = []
    for we in wins:
        placed: list[str] = []
        for a in r.assigns:
            if a.status != "unplannable":
                if a.schedule == we.0 and a.start == we.1:
                    placed.append(a.device)
        if len(placed) > 0:
            wdur = we.2 - we.1
            # An open window has no duration to spread estimates over;
            # space them at the planned rate instead.
            spacing = 3600 // rate if rate > 0 else EST_S
            devs: list[(str, int)] = []
            idx = 0
            for d in placed:
                if we.2 == OPEN_END:
                    devs.append((d, we.1 + idx * spacing))
                else:
                    devs.append((d, we.1 + idx * wdur // len(placed)))
                idx += 1
            layout.append((we.0, we.1, we.2, devs))
    return (layout, alarms)


class UpgradeCampaign(base.UpgradeCampaign):
    def transform(self, i, linked, dynstate):
        """Plan through the scheduling core and actuate the released layout.

        Every campaign is paced: the companion actor decides which planned
        devices are released and writes the decision as dynstate, and this
        function actuates exactly that set - a device never starts before
        the controller says so. The actor publishes the same layout under
        state as the plan.
        """
        o = base.o_root()
        released: set[str] = set()
        if dynstate is not None:
            for name in dynstate.released:
                released.add(name)
        if i.admin_state == "run":
            inventory = y_0.root.from_gdata(linked)
            layout, alarms = plan_campaign(i)
            for win in layout:
                for entry in win.3:
                    if entry.0 not in released:
                        continue
                    fleet_device = inventory.fleet.device.get(entry.0)
                    if fleet_device is not None:
                        dev = o.rfs.create(fleet_device.shard).device.create(entry.0)
                        dev.software.target_release = i.target_release
                        dev.software.upgrade_campaign = i.name
                        dev.software.image_url = i.image_url
                        dev.software.allow_staging = i.allow_staging
        return o


def imax(a: int, b: int) -> int:
    return a if a > b else b


# How often the controller reconsiders releases. A code constant for now;
# the intent is to make this event-driven with a debounce, since every
# decision write costs a recompute.
CONTROL_TICK_S = 1.0


actor UpgradeCampaignTransform(path: ttt.Path,
                               update_dynstate: proc(?y_0.software__software__upgrade_campaign__dynstate) -> None,
                               update_oper: proc(?y0_oper.software__software__upgrade_campaign_entry) -> None,
                               lower_tree_provider: ?ygdata.TreeProvider):
    """Aggregate flotilla telemetry and control the release of the plan.

    The actor plans for itself from the campaign and runs the core
    controller on the layout and the telemetry: windows open by the
    clock, releases start small and double as upgrades complete,
    concurrency follows the window pressure, and the decision is written
    as dynstate for the transform to actuate. Every campaign is paced
    this way; one without windows runs through its synthetic window.
    """
    var members: list[str] = []
    var latest: ?y1_oper.root = None
    var subscriptions: ?ygdata.SubscriptionManager = None
    var destination: ?ygdata.Dst = None
    var plan_layout: list[(str, int, int, list[(str, int)])] = []
    var plan_alarms: list[str] = []
    var running = False
    var ticking = False
    var anchor: ?time.Instant = None
    var released: set[str] = set()
    var released_at: dict[str, int] = {}
    var done_at: dict[str, int] = {}
    var observed_s: int = EST_S
    var rung: int = 1
    var rung_target: int = 1
    var target_c: int = 1
    var max_c: int = 1

    def publish() -> None:
        oper = base.UpgradeCampaign.new_state(path)
        st = oper.state
        in_progress = 0
        succeeded = 0
        failed = 0

        for d in members:
            status: ?str = None
            running_release: ?str = None
            if latest is not None:
                for shard in latest!.rfs:
                    observed = shard.flotilla_status.state.device.get(d)
                    if observed is not None:
                        status = observed!.status
                        running_release = observed!.running_release

            ds = st.device_status.create(d)
            ds.status = status if status is not None else "pending"
            ds.running_release = running_release

            if status == "in-progress":
                in_progress += 1
            elif status == "succeeded" or status == "up-to-date":
                succeeded += 1
            elif status == "failed" or status == "rolled-back":
                failed += 1

        st.total = u64(len(members))
        st.in_progress = u64(in_progress)
        st.succeeded = u64(succeeded)
        st.failed = u64(failed)

        # The materialized plan: the same computation the transform actuates,
        # published so the layout is inspectable before and during the run.
        for pw in plan_layout:
            win = st.plan.window.create((schedule=pw.0, start=u64(pw.1)))
            if pw.2 != OPEN_END:
                win.end = u64(pw.2)
            for entry in pw.3:
                pd = win.device.create(entry.0)
                pd.estimated_start = u64(entry.1)
                pd.estimated_duration = u64(EST_S)
        for alarm in plan_alarms:
            st.plan.alarm.append(alarm)
        update_oper(oper)

    def on_rfs(root: ?y1_oper.root, error: ?Exception) -> None:
        if error is not None:
            print("campaign status subscription failed at {path}: {error}", err=True)
            latest = None
        else:
            latest = root
        publish()

    def shutdown() -> None:
        # Releasing the subscriptions here is a separate change.
        pass

    def _status_of(name: str) -> ?str:
        lt = latest
        if lt is not None:
            for shard in lt.rfs:
                observed = shard.flotilla_status.state.device.get(name)
                if observed is not None:
                    return observed.status
        return None

    def _is_done(name: str) -> bool:
        st = _status_of(name)
        return st == "succeeded" or st == "up-to-date" or st == "failed" or st == "rolled-back"

    def _decide() -> None:
        """One controller pass: note completions, ramp, release what fits."""
        a = anchor
        if a is not None:
            _decide_at(a)

    def _decide_at(a: time.Instant) -> None:
        t = int(time.monotonic().since(a).to_float())

        for name in released:
            if name not in done_at:
                if _is_done(name):
                    done_at[name] = t
                    took = imax(1, t - released_at.get_def(name, 0))
                    observed_s = (observed_s * 3 + took) // 4

        if len(done_at) >= rung_target and rung < target_c:
            rung = fs.ramp_next(rung, 2, target_c)
            rung_target = len(done_at) + rung

        grew = False
        placed_total = 0
        for win in plan_layout:
            wstart = win.1
            wend = win.2
            placed_total += len(win.3)
            if t < wstart or t >= wend:
                continue
            inflight = 0
            waiting = []
            for entry in win.3:
                if entry.0 in released:
                    if entry.0 not in done_at:
                        inflight += 1
                else:
                    waiting.append(entry.0)
            n_new = fs.launch_count(len(waiting), inflight, observed_s, wend - t,
                                    target_c, max_c, rung, 1000000)
            idx = 0
            for name in waiting:
                if idx < n_new:
                    released.add(name)
                    released_at[name] = t
                    grew = True
                idx += 1
        if grew:
            update_dynstate(y_0.software__software__upgrade_campaign__dynstate(
                released=sorted(list(released))))
        if placed_total > 0 and len(done_at) >= placed_total:
            ticking = False

    def _tick() -> None:
        if not ticking:
            return
        _decide()
        after CONTROL_TICK_S: _tick()

    def on_conf(conf: y_0.software__software__upgrade_campaign_entry, linked: ygdata.Node) -> None:
        ms = []
        for member in conf.device:
            ms.append(member.name)
        members = ms

        layout, alarms = plan_campaign(conf)
        plan_layout = layout
        plan_alarms = alarms

        # Concurrency the controller may spend, derived from the rates.
        tr = int(conf.target_rate)
        target_c = imax(1, fs.ceil_div(tr * EST_S, 3600)) if tr > 0 else 1
        mr = int(conf.max_rate)
        max_c = imax(target_c, fs.ceil_div(mr * EST_S, 3600)) if mr > 0 else 1000000

        paced = len(plan_layout) > 0
        run_now = conf.admin_state == "run"
        if run_now and not running:
            # The window clock starts when the campaign starts.
            anchor = time.monotonic()
            released = set()
            released_at = {}
            done_at = {}
            observed_s = EST_S
            rung = 1
            rung_target = 1
        running = run_now
        if running and paced:
            if not ticking:
                ticking = True
                after 0.0: _tick()
        else:
            ticking = False
        publish()

        if lower_tree_provider is not None and subscriptions is None:
            subscriptions = ygdata.SubscriptionManager(
                lower_tree_provider!,
                "campaign-status:{path}",
            )
            destination = y1_oper.dst(on_rfs)

        if subscriptions is not None:
            want: set[ygdata.Delivery] = set()
            if len(members) > 0:
                want.add(destination!.deliver({
                    ygdata.SubscriptionSpec(None, period=0.25),
                }))
            subscriptions!.declare(want)
