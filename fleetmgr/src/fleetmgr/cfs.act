def flotilla_index(name: str) -> int:
    """Return the index of the flotilla that manages the device called name.
    Acton hashes a string the same way on every run, so a device stays on
    its flotilla across restarts."""
    return int(hash(name) % u64(supervisor.FLOTILLA_COUNT))


def flotilla_of(name: str) -> str:
    """Return the name of the flotilla that manages the device called name."""
    return "flotilla-{flotilla_index(name) + 1}"


# The device type of the top's entry for a flotilla.
FLOTILLA_TYPE = "flotilla"


def device_live(flotilla: ?bool, device: ?bool) -> bool:
    """Return whether a device is up: flotilla says whether the top is
    connected to the device's flotilla, and device whether the flotilla is
    connected to the device, each None while unknown. The device is down
    when either is False."""
    if flotilla is not None and not flotilla:
        return False
    if device is not None and not device:
        return False
    return True


def held_status(reason: str, holder: str, flotilla: str, flotilla_up: ?bool,
                device_up: ?bool) -> (str, str):
    """Return the reason and the holder that a campaign publishes for a held
    member, from the reason and the holder that its controller gives, ""
    for no holder. flotilla is the member's flotilla, and flotilla_up and
    device_up are as for device_live(). A member that is down only because
    the top is not connected to its flotilla is held for flotilla-down, by
    the flotilla."""
    if reason == "down" and device_live(None, device_up) and not device_live(flotilla_up, None):
        return ("flotilla-down", flotilla)
    return (reason, holder)


class Device(base.Device):
    def transform(self, i):
        o = base.o_root()
        flotilla = flotilla_of(i.name)

        # The top's own entry for the flotilla. Every device on a flotilla
        # writes the same one, so the top connects to a flotilla once it has
        # a device.
        flotilla_dev = o.device.create(flotilla)
        flotilla_dev.type = FLOTILLA_TYPE
        flotilla_dev.sync_check = False
        port = supervisor.BASE_NETCONF_PORT + flotilla_index(i.name)
        flotilla_dev.address.create("primary", address="127.0.0.1", port=u64(port))
        # The flotillas' default NETCONF login.
        # TODO: reuse the top's northbound NETCONF credentials.
        flotilla_dev.credentials.username = "admin"
        flotilla_dev.credentials.password = "admin"

        dev = o.rfs.create(flotilla).device.create(i.name)
        dev.type = i.type
        dev.description = i.description
        dev.approval_required = i.approval_required
        dev.sync_check = i.sync_check

        for address in i.address:
            out_address = dev.address.create(
                address.name,
                address=address.address,
                port=address.port,
            )
            for credentials in address.initial_credentials:
                out_address.initial_credentials.create((
                    username=credentials.username,
                    password=credentials.password,
                    key=credentials.key,
                ))

        dev.credentials.username = i.credentials.username
        dev.credentials.password = i.credentials.password
        for key in i.credentials.key:
            dev.credentials.key.create(key.key, private_key=key.private_key)

        for credentials in i.initial_credentials:
            dev.initial_credentials.create((
                username=credentials.username,
                password=credentials.password,
                key=credentials.key,
            ))

        for a in i.extra_adapter:
            out_adapter = dev.extra_adapter.create(a.type, address=a.address, port=a.port)
            c = a.credentials
            if c is not None:
                out_credentials = y_1_loose.stratoweave_rfs__rfs__device__extra_adapter__credentials(username=c.username, password=c.password)
                for key in c.key:
                    out_credentials.key.create(key.key, private_key=key.private_key)
                out_adapter.credentials = out_credentials
            s = a.ssh
            if s is not None:
                out_adapter.ssh = y_1_loose.stratoweave_rfs__rfs__device__extra_adapter__ssh(
                    cipher=s.cipher, mac=s.mac, key_exchange=s.key_exchange,
                    host_key_algorithm=s.host_key_algorithm, public_key_algorithm=s.public_key_algorithm,
                    compression_algorithm=s.compression_algorithm, compression_level=s.compression_level,
                    rekey_after_bytes=s.rekey_after_bytes, rekey_after_seconds=s.rekey_after_seconds,
                    minimum_rsa_bits=s.minimum_rsa_bits)

        dev.ssh.cipher = i.ssh.cipher
        dev.ssh.mac = i.ssh.mac
        dev.ssh.key_exchange = i.ssh.key_exchange
        dev.ssh.host_key_algorithm = i.ssh.host_key_algorithm
        dev.ssh.public_key_algorithm = i.ssh.public_key_algorithm
        dev.ssh.compression_algorithm = i.ssh.compression_algorithm
        dev.ssh.compression_level = i.ssh.compression_level
        dev.ssh.rekey_after_bytes = i.ssh.rekey_after_bytes
        dev.ssh.rekey_after_seconds = i.ssh.rekey_after_seconds
        dev.ssh.minimum_rsa_bits = i.ssh.minimum_rsa_bits

        dev.mock.enabled = i.mock.enabled
        dev.mock.software.upgrade_duration = i.mock.software.upgrade_duration
        dev.mock.software.upgrade_duration_variance = i.mock.software.upgrade_duration_variance
        dev.mock.software.failure = i.mock.software.failure
        dev.mock.platform.version = i.mock.platform.version
        dev.mock.platform.model = i.mock.platform.model
        dev.mock.platform.serial_number = i.mock.platform.serial_number
        for module in i.mock.module:
            out_module = dev.mock.module.create(
                module.name,
                namespace=module.namespace,
                revision=module.revision,
            )
            for feature in module.feature:
                out_module.feature.append(feature)

        dev.debug.connection = i.debug.connection
        dev.debug.log_level = i.debug.log_level
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch
        dev.upgrade_checks.enabled = i.upgrade_checks.enabled
        dev.upgrade_checks.precheck_wait = i.upgrade_checks.precheck_wait
        dev.upgrade_checks.postcheck_wait = i.upgrade_checks.postcheck_wait
        return o


actor DeviceTransform(path: ttt.Path,
                      update_oper: proc(?y0_oper.fleetmgr__fleet__device_entry) -> None,
                      lower_tree_provider: ?ygdata.TreeProvider):
    """Publish the platform of one device, as its RFS entry relays it from
    the device's flotilla."""
    var subscriptions: ?ygdata.SubscriptionManager = None
    var platform: ?(os: ?str, version: ?str, model: ?str, serial_number: ?str) = None

    def on_platform(keys: ?(rfs_name: str, device_name: str),
                    state: ?y1_oper.stratoweave_rfs__rfs__device__state__platform,
                    error: ?Exception) -> None:
        # A call can still arrive after shutdown closed the subscription.
        if subscriptions is None:
            return
        value: ?(os: ?str, version: ?str, model: ?str, serial_number: ?str) = None
        if error is not None:
            print("device platform subscription failed at {path}: {error}", err=True)
        elif state is not None and (state.os is not None or state.version is not None or
                                    state.model is not None or state.serial_number is not None):
            value = (os=state.os, version=state.version, model=state.model,
                     serial_number=state.serial_number)
        if value == platform:
            return
        platform = value
        if value is not None:
            oper = base.Device.new_state(path)
            o = oper.state.platform
            o.os = value.os
            o.version = value.version
            o.model = value.model
            o.serial_number = value.serial_number
            update_oper(oper)
        else:
            update_oper(None)

    def shutdown() -> None:
        if subscriptions is not None:
            subscriptions!.close()
            subscriptions = None
        if platform is not None:
            platform = None
            update_oper(None)

    def on_conf(conf: y_0.fleetmgr__fleet__device_entry) -> None:
        # The flotilla follows from the name, so it never changes.
        tp = lower_tree_provider
        if subscriptions is None and tp is not None:
            subscriptions = ygdata.SubscriptionManager(tp, "device-platform:{path}")
            platform_state = y1_oper.subs.rfs.device.state.platform
            subscriptions!.declare({platform_state.dst(on_platform).deliver({
                y1_oper.subs.rfs.entry(flotilla_of(conf.name)).device.entry(conf.name).state.platform.subscribe(),
            })})


def device_estimate(dev: ?y_0.fleetmgr__fleet__device_entry) -> int:
    """Estimated upgrade duration for one device, from the adapter that
    will run it: the configured mock duration when the device is mocked,
    the adapter's nominal figure otherwise. Controllers correct this
    from observation; planning starts here."""
    if dev is not None:
        if dev.mock.enabled:
            dur = dev.mock.software.upgrade_duration
            if dur is not None and int(dur) > 0:
                return int(dur)
            return sw_mock.MockSoftwareAdapter.plan_estimate()
    # The IOS XE adapter is the only real one today.
    return sw_iosxe.IosXeSoftwareAdapter.plan_estimate()


def device_prepare_estimate(dev: ?y_0.fleetmgr__fleet__device_entry) -> int:
    """Estimated prepare duration for one device, in seconds: the part of
    its upgrade estimate that the copy of the image takes on the IOS XE
    adapter. A real device gets the adapter's prepare estimate. A mocked
    device gets the time its mock takes for the copy. It is at least 1."""
    copy = sw_iosxe.IosXeSoftwareAdapter.prepare_estimate()
    upgrade = sw_iosxe.IosXeSoftwareAdapter.plan_estimate()
    return fctl.imax(1, device_estimate(dev) * copy // upgrade)


def estimated_duration(i: y_0.software__software__upgrade_campaign_entry,
                       inventory: y_0.root) -> int:
    """The average estimated upgrade duration over the campaign's
    members, in seconds. The observed duration starts from it."""
    total = 0
    n = 0
    for member in i.device:
        total += device_estimate(inventory.fleet.device.get(member.name))
        n += 1
    # Estimates are at least a second each, so the average is too.
    return (total + n - 1) // n if n > 0 else 1

# End of a window that never closes: the year 2100 as seconds since the
# Unix epoch, far beyond any campaign.
OPEN_END = 4102444800

def campaign_debounce_s(devices: int) -> int:
    """The debounce between a report and the decision it leads to, in
    whole seconds: a second per thousand devices, at least one and up to
    30. Whole seconds let the controller's plan decide at the very second
    the campaign actor does, with the reports of a second in one decision.
    Large campaigns limit how often the whole campaign is published."""
    return fctl.imax(1, fctl.imin(devices // 1000, 30))


_DAYS = {"mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6}

# How far ahead of now, or of a later notice cut, the planner generates
# window occurrences. Nine days covers a weekly rule with margin; longer
# recurrences come later.
HORIZON_DAYS = 9

# How long a running campaign waits at most before it decides again, so
# that the windows beyond the horizon come in.
HORIZON_REFRESH = 86400


def occurrences(sched: y_0.maintenance__schedules__schedule_entry, now: int,
                cut: int=0) -> list[(int, int)]:
    """The schedule's absolute window occurrences over the horizon, as
    seconds since the Unix epoch: each rule opens at its local time of
    day on its listed weekdays, every day when none are listed. A window
    already open now is included, also one that opened on an earlier day
    within the horizon; a closed one is not, and neither is one that opens
    before cut. The horizon starts at the later of now and cut."""
    out: list[(int, int)] = []
    off = int(sched.utc_offset) * 60
    local_now = fctl.imax(now, cut) + off
    day0 = local_now - local_now % 86400
    for w in sched.window:
        at = int(w.at)
        dur = int(w.duration)
        days: list[int] = []
        for d in w.day:
            if d in _DAYS:
                days.append(_DAYS[d])
        # A window that opened days ago can still be open; the horizon
        # bounds how far back too.
        for k in range(fctl.imax(-(dur // 86400) - 1, -HORIZON_DAYS), HORIZON_DAYS):
            local_day = day0 + k * 86400
            if len(days) > 0:
                # 1970-01-01 was a Thursday; monday is day zero here.
                wd = (local_day // 86400 + 3) % 7
                if wd not in days:
                    continue
            start = local_day + at - off
            if start + dur <= now or start < cut:
                continue
            out.append((start, start + dur))
    return sorted(out)


def notice_cut(period: int, run_since: ?int, now: int) -> int:
    """Return the time from which a campaign with a notification period of
    period days may use a window: run_since, the time the campaign first
    went to run, or now before its first run, plus the period. Return 0
    when the period is 0: every window counts."""
    if period <= 0:
        return 0
    since = run_since if run_since is not None else now
    return since + period * 86400


class CampaignMembers(object):
    """The members of a campaign as its controller takes them: the
    devices as (name, estimated duration, schedule) by name, the schedules
    they are bound to, their redundancy groups, priorities and the groups'
    separation, the groups that hold on a failure, the campaign's
    estimated duration, and each member's expected prepare time. When no
    member is bound to a schedule, every member is in the synthetic
    schedule "default"."""
    devices: list[(str, int, str)]
    referenced: list[str]
    groups: dict[str, list[str]]
    priority: dict[str, int]
    separation: dict[str, (bool, int)]
    hold_failed: set[str]
    estimate: int
    prepare_est: dict[str, int]

    def __init__(self, devices: list[(str, int, str)], referenced: list[str],
                 groups: dict[str, list[str]], priority: dict[str, int],
                 separation: dict[str, (bool, int)], hold_failed: set[str], estimate: int,
                 prepare_est: dict[str, int]):
        self.devices = devices
        self.referenced = referenced
        self.groups = groups
        self.priority = priority
        self.separation = separation
        self.hold_failed = hold_failed
        self.estimate = estimate
        self.prepare_est = prepare_est


def campaign_members(i: y_0.software__software__upgrade_campaign_entry,
                     inventory: y_0.root) -> CampaignMembers:
    """Return the members of campaign i as its controller takes them, from
    the campaign and the inventory.

    A member device goes in the schedule it is bound to, or else in the
    campaign's default schedule. The members' redundancy groups and
    priorities go with them, and each group's separation: a group with no
    entry under /redundancy-groups spreads."""
    default: ?str = i.default_schedule

    members = sorted([member.name for member in i.device])
    schedule_of: dict[str, ?str] = {}
    referenced: list[str] = []
    groups: dict[str, list[str]] = {}
    priority: dict[str, int] = {}
    for name in members:
        binding: ?str = None
        dev = inventory.fleet.device.get(name)
        if dev is not None:
            binding = dev.schedule
            priority[name] = int(dev.redundancy_priority)
            for g in dev.redundancy_group:
                if g not in groups:
                    groups[g] = []
                groups[g].append(name)
        if binding is None:
            binding = default
        schedule_of[name] = binding
        if binding is not None and binding not in referenced:
            referenced.append(binding)

    synthetic = len(referenced) == 0
    devices: list[(str, int, str)] = []
    prepare_est: dict[str, int] = {}
    for name in members:
        sname = "default"
        if not synthetic:
            b = schedule_of[name]
            sname = b if b is not None else ""
        dev = inventory.fleet.device.get(name)
        devices.append((name, device_estimate(dev), sname))
        prepare_est[name] = device_prepare_estimate(dev)

    separation: dict[str, (bool, int)] = {}
    hold_failed: set[str] = set()
    for g in groups.keys():
        policy = inventory.redundancy_groups.redundancy_group.get(g)
        if policy is not None:
            separation[g] = (policy.separation_policy == "spread", int(policy.min_separation))
            if policy.failure_policy == "hold":
                hold_failed.add(g)
        else:
            separation[g] = (True, 0)
    return CampaignMembers(devices, referenced, groups, priority, separation, hold_failed,
                           estimated_duration(i, inventory), prepare_est)


def failure_budget_devices(percent: ?Decimal, members: int) -> int:
    """Return how many devices may fail at a failure budget of percent of a
    campaign's members, rounded down to whole devices, or -1 when there is
    no budget. The argument members is how many members the campaign has.
    The count comes from the digits of the decimal, not from a float, so it
    is exact. The budget has at most two fraction digits."""
    if percent is not None:
        hundredths = percent.lossy_realign(-2).significand
        return hundredths * members // 10000
    return -1


def configure_campaign(ctl: fctl.Controller, i: y_0.software__software__upgrade_campaign_entry,
                       inventory: y_0.root, now: int,
                       members: ?CampaignMembers=None, run_since: ?int=None) -> None:
    """Give the campaign's controller the windows, the devices and the
    limits that the campaign and the inventory give at time now. members
    is campaign_members() of the campaign and the inventory; without it,
    configure_campaign() takes it again. run_since is the time the
    campaign first went to run, None before its first run.

    A member device goes in the windows of its schedule that open at the
    notice_cut() or later. A campaign with no default and no bound members
    gets one synthetic window that opens at the cut, at launch without a
    notification period, and never closes. The deadline cuts off the
    windows - the synthetic one included - and every device must start
    before it when the planner sees every window before it. So do the
    campaign's allow-staging, each member's expected prepare time, the
    campaign's failure budget, in devices of the members the campaign has
    now, and the redundancy groups that hold on a failure."""
    m = members if members is not None else campaign_members(i, inventory)
    deadline = 0
    dl = i.deadline
    if dl is not None:
        deadline = int(dl)
    cut = notice_cut(int(i.notification_period), run_since, now)

    windows: list[(str, int, int)] = []
    synthetic = len(m.referenced) == 0
    if synthetic:
        end = deadline if deadline > 0 else OPEN_END
        if cut < end:
            windows.append(("default", cut, end))
    for sname in m.referenced:
        sched = inventory.schedules.schedule.get(sname)
        if sched is not None:
            for we in occurrences(sched, now, cut):
                wstart = we.0
                wend = we.1
                if deadline > 0:
                    # The deadline cuts off the window supply.
                    if wstart >= deadline:
                        continue
                    if wend > deadline:
                        wend = deadline
                windows.append((sname, wstart, wend))

    must_place = deadline > 0 and (synthetic or
                                   deadline - fctl.imax(now, cut) <= (HORIZON_DAYS - 1) * 86400)
    ctl.configure(windows, m.devices, int(i.target_concurrency), int(i.max_concurrency),
                  must_place, campaign_debounce_s(len(m.devices)), m.estimate, m.groups,
                  m.priority, m.separation, int(i.close_margin), int(i.stagger),
                  i.allow_staging, m.prepare_est,
                  failure_budget_devices(i.failure_budget, len(m.devices)), m.hold_failed)


class RedundancyGroups(base.RedundancyGroups):
    def transform(self, i):
        """Redundancy group entries produce no configuration of their own.

        The container is a transform so campaigns can link it and re-plan
        when an entry changes.
        """
        return base.o_root()


class Schedules(base.Schedules):
    def transform(self, i):
        """Maintenance schedules produce no configuration of their own.

        The container is a transform so campaigns can link it: their
        transforms and companion actors receive every schedule as linked
        input and re-plan when one changes.
        """
        return base.o_root()


# The reason of the veto a campaign puts on its members. It is the same in
# plan, while a member waits and after it is done, so the veto entry does
# not change when the campaign starts to run.
CAMPAIGN_VETO_REASON = "waiting for its release by the campaign"


def veto_holder(campaign: str) -> str:
    """Return the holder of the veto that the campaign puts on its
    members."""
    return "campaign:" + campaign


def route_software(o: y_1_loose.root, fleet_device: y_0.fleetmgr__fleet__device_entry,
                   i: y_0.software__software__upgrade_campaign_entry,
                   image: ?y_0.stratoweave_images__images__image_entry, attempt: u64,
                   url_base: ?str, held: bool, prepare: bool) -> None:
    """Write the software intent of campaign i for one device to its
    flotilla. The intent is the campaign's name, the release of the
    device's image, the member's attempt, the URL to fetch the image from,
    url_base followed by the image's file, and the image's checksums and
    size. Without an image, only the name and the attempt are written.
    When held is true, the campaign's veto is written
    too: the device reads the release it runs, but does not install the
    target. When held and prepare are true, allow-staging is written as
    true: the device may prepare the target while the veto holds the
    install. Otherwise allow-staging is left out, which means false."""
    software = o.rfs.create(flotilla_of(fleet_device.name)).device.create(fleet_device.name).software
    software.upgrade_campaign = i.name
    software.attempt = attempt
    if image is not None:
        software.target_release = image.version
        if url_base is not None and url_base != "":
            software.image_url = url_base + image_file(image)
        for c in image.checksum:
            software.image_checksum.create(c.algorithm, digest=c.digest)
        software.image_size = image.size
    if held:
        software.veto.create(veto_holder(i.name), reason=CAMPAIGN_VETO_REASON)
        if prepare:
            software.allow_staging = True


def image_file(image: y_0.stratoweave_images__images__image_entry) -> str:
    """The path of the image's file in the image folder: its file leaf, or
    without one its name."""
    f = image.file
    if f is not None and f != "":
        return f
    return image.name


def member_image(inventory: y_0.root, name: ?str) -> ?y_0.stratoweave_images__images__image_entry:
    """The image list entry a member names, when it is there and has a
    version."""
    if name is not None:
        image = inventory.images.image.get(name)
        if image is not None:
            version = image.version
            if version is not None and version != "":
                return image
    return None


def member_targets(i: y_0.software__software__upgrade_campaign_entry,
                   inventory: y_0.root) -> dict[str, str]:
    """Return the target release that campaign i writes for each member: the
    version of the member's image. A member that is not in the fleet, or
    whose image is not in the image list or has no version, has none."""
    targets: dict[str, str] = {}
    for member in i.device:
        if inventory.fleet.device.get(member.name) is not None:
            image = member_image(inventory, member.image)
            if image is not None:
                version = image.version
                if version is not None:
                    targets[member.name] = version
    return targets


def member_attempts(i: y_0.software__software__upgrade_campaign_entry) -> dict[str, u64]:
    """Return the attempt that campaign i writes for each member."""
    return {member.name: member.attempt for member in i.device}


def campaign_config(i: y_0.software__software__upgrade_campaign_entry, inventory: y_0.root,
                    unheld: set[str], allowed: set[str], names: ?set[str]) -> y_1_loose.root:
    """Return the software intent of campaign i for its members, or only for
    the members in names when names is not None.

    Each member in the fleet gets the campaign's name, and the target
    release and image URL of its image when the image is in the image list
    and has a version. Each member also gets the campaign's veto, except
    when the campaign runs and the member is in unheld, the members in
    flight. When the campaign runs with allow-staging, each member with the
    veto that is in allowed, the members let prepare, gets allow-staging. A
    member that is not in the fleet gets nothing."""
    o = base.o_root()
    run = i.admin_state == "run"
    staging = False
    if run and i.allow_staging:
        staging = True
    url_base = inventory.images.url_base
    members: list[y_0.software__software__upgrade_campaign__device_entry] = []
    if names is not None:
        for name in names:
            m = i.device.get(name)
            if m is not None:
                members.append(m)
    else:
        for m in i.device:
            members.append(m)
    for member in members:
        fleet_device = inventory.fleet.device.get(member.name)
        if fleet_device is not None:
            held = True
            if run and member.name in unheld:
                held = False
            prepare = False
            if staging and member.name in allowed:
                prepare = True
            route_software(o, fleet_device, i, member_image(inventory, member.image),
                           member.attempt, url_base, held, prepare)
    return o


def devices_text(n: int) -> str:
    return "1 device" if n == 1 else "{n} devices"


def image_alarms(i: y_0.software__software__upgrade_campaign_entry, inventory: y_0.root) -> list[str]:
    """What keeps members of campaign i from their image: an image that is
    not in the image list or has no version, and an image list without
    url-base."""
    missing: dict[str, int] = {}
    no_version: dict[str, int] = {}
    with_image = 0
    for member in i.device:
        name = member.image
        if name is not None:
            if member_image(inventory, name) is not None:
                with_image += 1
            elif inventory.images.image.get(name) is not None:
                no_version[name] = no_version.get_def(name, 0) + 1
            else:
                missing[name] = missing.get_def(name, 0) + 1
    alarms: list[str] = []
    for name in sorted(list(missing.keys())):
        alarms.append("image {name} is not in the image list ({devices_text(missing[name])})")
    for name in sorted(list(no_version.keys())):
        alarms.append("image {name} has no version ({devices_text(no_version[name])})")
    url_base = inventory.images.url_base
    if with_image > 0 and not (url_base is not None and url_base != ""):
        alarms.append("no url-base in the image list: devices cannot fetch images")
    return alarms


def written_in(prev: ?ygdata.Node, i: y_0.software__software__upgrade_campaign_entry,
               inventory: y_0.root) -> (set[str], set[str]):
    """Return the members in flight and the members let prepare in prev, the
    output campaign i wrote last. A member is in flight when prev gives it
    the campaign's name without the campaign's veto. A member is let
    prepare when prev gives it the campaign's name and allow-staging, with
    the target release that the campaign gives it now. Either needs the
    attempt that the campaign gives the member now: a member with a new
    attempt is a new member. A campaign that does not run has neither, and one
    without allow-staging has no member let prepare."""
    unheld: set[str] = set()
    allowed: set[str] = set()
    if i.admin_state == "run" and prev is not None:
        holder = veto_holder(i.name)
        targets: dict[str, str] = {}
        if i.allow_staging:
            targets = member_targets(i, inventory)
        attempts = member_attempts(i)
        o = y_1_loose.root.from_gdata(prev)
        for flotilla in o.rfs:
            for dev in flotilla.device:
                sw = dev.software
                written = sw.attempt
                if sw.upgrade_campaign == i.name \
                   and (written if written is not None else u64(0)) == attempts.get_def(dev.name, 0):
                    if sw.veto.get(holder) is None:
                        unheld.add(dev.name)
                    staged = sw.allow_staging
                    target = targets.get(dev.name)
                    if staged is not None and staged and target is not None \
                       and sw.target_release == target:
                        allowed.add(dev.name)
    return (unheld, allowed)


def intent_patch(output: ygdata.Node, i: y_0.software__software__upgrade_campaign_entry,
                 inventory: y_0.root, old: (set[str], set[str]),
                 new: (set[str], set[str])) -> ?ygdata.Node:
    """Return output, the intent of campaign i written with old, changed to
    the intent written with new. Each of old and new is the members in
    flight and the members let prepare. Only the members in one set of a
    pair and not in the other change: a member that goes in flight loses
    the campaign's veto, a member that leaves flight gets it back, and a
    member gets or loses allow-staging. Return None when nothing changes.

    The change is a diff, because a patch removes a veto entry or a leaf
    only when it says that the entry or the leaf is absent."""
    changed: set[str] = set()
    for pair in [(old.0, new.0), (new.0, old.0), (old.1, new.1), (new.1, old.1)]:
        for name in pair.0:
            if name not in pair.1:
                changed.add(name)
    if len(changed) == 0:
        return None
    a = campaign_config(i, inventory, old.0, old.1, changed).to_gdata()
    b = campaign_config(i, inventory, new.0, new.1, changed).to_gdata()
    d = ygdata.diff(a, b)
    if d is None:
        return None
    patched = ygdata.patch(output, d)
    if patched is not None:
        return patched
    # The patch removed everything.
    return base.o_root().to_gdata()


def counted_attempt(campaign: str, target: ?str, attempt: u64, tag_campaign: ?str,
                    tag_target: ?str, statuses: list[(u64, ?str)]) -> ?u64:
    """Return the attempt that counts for a member of the campaign with the
    target release target and the attempt attempt. statuses has the number
    and the status of each attempt that the device reports for tag_campaign
    and tag_target. An attempt in-progress counts: a run of an earlier
    attempt is still under way, and holds its slot until it ends. Else the
    member's attempt counts, once the device has answered it. Return None
    for a device that reports another campaign or target, or has not
    answered. The status of the attempt answers the target only when it is
    upgrade-needed or final; the controller decides that."""
    if target is None or tag_campaign != campaign or tag_target != target:
        return None
    for a in statuses:
        if a.1 == "in-progress":
            return a.0
    for a in statuses:
        if a.0 == attempt:
            return attempt
    return None


def prepare_for(campaign: str, target: ?str, attempt: u64, tag_campaign: ?str,
                tag_target: ?str, prepares: list[(u64, ?str, ?str)]) -> ?str:
    """Return the state of the prepare of the attempt attempt of a member of
    the campaign with the target release target, when the prepare copies or
    copied the target. prepares has the number, and the release and state
    of the prepare, of each attempt that the device reports for tag_campaign
    and tag_target. Return None otherwise."""
    if target is None or tag_campaign != campaign or tag_target != target:
        return None
    for a in prepares:
        if a.0 == attempt and a.1 == target:
            return a.2
    return None


def controller_status(status: ?str, stage: ?str) -> (?str, bool):
    """Return the status that the controller takes for the counted attempt
    of a member, which has status and stage, and whether a failed rollback
    left the device as it is. A not-started attempt is such a failure: the
    run of an earlier attempt failed its rollback, and this one did not
    start."""
    if status == "not-started":
        return ("failed", True)
    return (status, status == "failed" and stage == "rollback")


def kept_run_since(memory: ?CampaignMemory) -> ?int:
    """Return the run-since in memory, the memory of a campaign, or None."""
    if memory is not None:
        r = memory.run_since
        if r is not None:
            return int(r)
    return None


def run_since_at(admin_state: str, kept: ?int, now: int) -> ?int:
    """Return the run-since of a campaign in admin_state at time now, when
    kept is the run-since it has: kept when it has one, now when the
    campaign runs, and None otherwise."""
    if kept is not None:
        return kept
    if admin_state == "run":
        return now
    return None


class UpgradeCampaign(base.UpgradeCampaign):
    def transform(self, i, linked, memory, prev_output):
        """Return the software intent of campaign i for its members, as the
        actor writes it, and the campaign's memory. The members that
        prev_output, the output written last, has in flight stay in flight,
        and the members it lets prepare stay let. So an edit of the
        campaign, or of its linked input, keeps what the actor wrote. An
        edit that turns allow-staging off, sets the campaign to plan, or
        gives a member a new target release, stops letting the member
        prepare.

        The output gives each member in the fleet the campaign's name in the
        operator's transaction. So an edit that puts a device of the fleet
        in two campaigns fails: the two names do not merge. A member that is
        not in the fleet gets nothing, so two campaigns can name it. The
        edit that adds it to the fleet then fails, while both campaigns
        name it.

        The memory that it returns keeps the run-since of memory, the
        memory of the last commit. The edit that first sets the campaign to
        run gives it the time of the edit."""
        inventory = y_0.root.from_gdata(linked)
        w = written_in(prev_output, i, inventory)
        since = run_since_at(i.admin_state, kept_run_since(memory), time.time().unix_s())
        out_memory: ?CampaignMemory = None
        if since is not None:
            out_memory = CampaignMemory(run_since=u64(since))
        return (campaign_config(i, inventory, w.0, w.1, None), out_memory)


actor UpgradeCampaignTransform(path: ttt.Path,
                               write_output: action(ygdata.Node) -> None,
                               update_oper: proc(?y0_oper.software__software__upgrade_campaign_entry) -> None,
                               lower_tree_provider: ?ygdata.TreeProvider):
    """Aggregate device telemetry and control the release of the plan.

    The actor runs a fctl.Controller on the campaign, the inventory and the
    device reports, driven by events rather than a tick: on-change
    telemetry arms a debounce timer and the timer firing decides once for
    the whole batch; the controller says when it next needs to decide, at
    a window opening or when an upgrade is expected to end, and the actor
    arms an exact timer for it. Each decision plans and takes the plan's
    first step, and the actor publishes that plan. Releases start small
    and grow as devices finish without a failure. They stop while more
    members have failed than the campaign's failure budget.

    The actor tells the controller which members are down: a member is
    down while its flotilla is not connected to it, or while the top is not
    connected to its flotilla. A connection that is not reported yet counts
    as up. The actor also tells the controller which members have a veto
    of another holder than the campaign, which holds their install, as
    their devices report it. The actor publishes why the plan holds each
    held member.

    The actor writes the intent of every member directly, in plan and in
    run, with the campaign's veto. So each member reads the release it runs
    and answers, but installs nothing. In run, the actor removes the veto of
    the members in flight, and puts it back when they are done. Of the
    attempts that a device reports for the campaign and the member's target
    release, the one in-progress counts, else the member's attempt. A
    not-started attempt counts as a failed rollback. The controller
    releases only the members whose status answers the target,
    upgrade-needed or a final status, and its plan holds the others with
    an alarm. A member that still upgrades from before a pause or a restart
    counts in flight, and keeps the veto. In plan, the actor plans what a
    new run would do, again when what the members report changes. A member
    that leaves the campaign is forgotten: added again, it is a new member.
    So is a member with a new attempt. A run of an earlier attempt that is
    still under way counts in flight until it ends.

    With allow-staging, in run, the actor writes allow-staging for each
    member from its turn to prepare until its prepare ends, it is released,
    or a window of its schedule opens, as the controller says. A prepare
    counts only when it is the prepare of the member's attempt and copies
    the member's target release.

    The actor takes run-since from the campaign's memory, gives the
    controller the windows that the notification period lets the campaign
    use from it, and publishes it.
    """
    var members: list[str] = []
    var member_names: set[str] = set()
    # What each device reports: the campaign and the target release of its
    # attempts, the attempts, the vetoes of its configuration, and the
    # version and model its platform has.
    var latest: dict[str, (upgrade_campaign: ?str, target_release: ?str,
                           attempts: list[(number: u64, status: ?str, stage: ?str,
                                           reason: ?str,
                                           prepare: (state: ?str, release: ?str,
                                                     started: ?str, ended: ?str,
                                                     message: ?str, progress: ?u64),
                                           install: (state: ?str, release: ?str,
                                                     started: ?str, ended: ?str,
                                                     message: ?str),
                                           precheck: (verdict: ?str, detail: ?str, at: ?str),
                                           postcheck: (verdict: ?str, detail: ?str, at: ?str))],
                           vetoes: list[(str, ?str)], version: ?str, model: ?str)] = {}
    # Whether each device's flotilla is connected to it, and whether the top
    # is connected to each flotilla, as they report it. A device or a
    # flotilla that is not here has not reported.
    var connected: dict[str, bool] = {}
    var flotilla_up: dict[str, bool] = {}
    var subscriptions: ?ygdata.SubscriptionManager = None
    var subscriptions_synced = False
    # Set by shutdown, when the campaign is deleted.
    var closed = False
    var plan_layout: list[(str, int, int, list[(str, int, int)])] = []
    var plan_alarms: list[str] = []
    # Why the plan holds each held member, and the holder.
    var plan_why: dict[str, (str, str)] = {}
    # The prepares at the time of the plan, from the controller that made it.
    var plan_prepares = fctl.Prepares({}, 0, [])
    # What keeps members from their image, published after the plan alarms.
    var member_alarms: list[str] = []
    var running = False
    # When the campaign first went to run, from the campaign's memory.
    var run_since: ?int = None
    var active = False
    var generation = 0
    var debounce_armed = False
    var debounce_s = 0.0
    var ctl = fctl.Controller()
    # The controller that made the published plan: ctl in run, and in plan
    # a copy of it that starts a new run.
    var shown = fctl.Controller()
    # The campaign and the inventory from the last on_conf, the target
    # release and the attempt of each member, the output written last, and the
    # members in flight and the members let prepare that it was written with.
    var campaign: ?y_0.software__software__upgrade_campaign_entry = None
    var inventory = y_0.root()
    # The members of the campaign as the controller takes them, from the
    # campaign and the inventory of the last on_conf.
    var member_info: ?CampaignMembers = None
    var targets: dict[str, str] = {}
    var attempts: dict[str, u64] = {}
    var output: ygdata.Node = base.o_root().to_gdata()
    var unheld: set[str] = set()
    var allowed: set[str] = set()

    def unheld_now() -> set[str]:
        """Return the members in flight that run an upgrade. A member whose
        final status came before its release runs none, so it keeps the
        veto. So does a member that still upgrades from before the run: it
        stops if it has not reached its install."""
        return ctl.upgrading()

    def counted(name: str):
        """Return the attempt of the device name that counts for the
        campaign, as the device reports it, or None."""
        observed = latest.get(name)
        current = campaign
        if observed is not None and current is not None:
            n = counted_attempt(current.name, targets.get(name), attempts.get_def(name, 0),
                                observed.upgrade_campaign, observed.target_release,
                                [(a.number, a.status) for a in observed.attempts])
            if n is not None:
                for a in observed.attempts:
                    if a.number == n:
                        return a
        return None

    def own_prepare(name: str) -> ?str:
        """Return the state of the prepare of the device name when it is the
        prepare of the member's attempt and copies the member's target, and
        None otherwise."""
        observed = latest.get(name)
        current = campaign
        if observed is not None and current is not None:
            return prepare_for(current.name, targets.get(name), attempts.get_def(name, 0),
                               observed.upgrade_campaign, observed.target_release,
                               [(a.number, a.prepare.release, a.prepare.state)
                                for a in observed.attempts])
        return None

    def report(name: str, at: int) -> None:
        """Tell the controller the status and the prepare of the device name
        that count for the campaign. The controller gets None for a device
        that has not answered the campaign."""
        a = counted(name)
        if a is not None:
            s = controller_status(a.status, a.stage)
            ctl.report(name, s.0, at, s.1)
        else:
            ctl.report(name, None, at)
        ctl.report_prepare(name, own_prepare(name))

    def plan_now(now: int) -> None:
        """Plan at time now. A campaign that does not run plans on a copy of
        the controller that starts a run now, so the plan shows what run
        would do: the members that a paused run released wait again, and
        the ramp and the pace start over."""
        if running:
            shown = ctl
        else:
            c = ctl.copy()
            c.start()
            shown = c
        p = shown.plan(now)
        plan_layout = shown.layout(p)
        plan_alarms = p.alarms
        plan_why = p.why
        plan_prepares = shown.prepares(now)

    def publish() -> None:
        oper = base.UpgradeCampaign.new_state(path)
        st = oper.state
        since = run_since
        if since is not None:
            st.run_since = u64(since)
        in_progress = 0
        succeeded = 0
        failed = 0
        preparing = 0
        prepared = 0
        held = 0

        for d in members:
            status: ?str = None
            prepare = own_prepare(d)
            # A device that has not answered the campaign shows as pending,
            # and counts nowhere.
            ds = st.device_status.create(d)
            a = counted(d)
            if a is not None:
                status = a.status
                ds.attempt = a.number
                ds.stage = a.stage
                ds.reason = a.reason
                ds.prepare.state = a.prepare.state
                ds.prepare.release = a.prepare.release
                ds.prepare.started = a.prepare.started
                ds.prepare.ended = a.prepare.ended
                ds.prepare.message = a.prepare.message
                ds.prepare.progress = a.prepare.progress
                ds.install.state = a.install.state
                ds.install.release = a.install.release
                ds.install.started = a.install.started
                ds.install.ended = a.install.ended
                ds.install.message = a.install.message
                ds.precheck.verdict = a.precheck.verdict
                ds.precheck.detail = a.precheck.detail
                ds.precheck.at = a.precheck.at
                ds.postcheck.verdict = a.postcheck.verdict
                ds.postcheck.detail = a.postcheck.detail
                ds.postcheck.at = a.postcheck.at
            ds.status = status if status is not None else "pending"
            observed = latest.get(d)
            if observed is not None:
                ds.version = observed.version
                ds.model = observed.model
                for v in observed.vetoes:
                    ds.veto.create(v.0, reason=v.1)

            if status == "in-progress":
                in_progress += 1
            elif status == "succeeded" or status == "up-to-date":
                succeeded += 1
            elif status == "failed" or status == "rolled-back" or status == "not-started":
                failed += 1
            # Only a member that waits for its release counts: the run of a
            # released member fills the same job.
            if status == "upgrade-needed":
                if prepare == "running":
                    preparing += 1
                elif prepare == "done":
                    prepared += 1

            why = plan_why.get(d)
            if why is not None:
                flotilla = flotilla_of(d)
                h = held_status(why.0, why.1, flotilla, flotilla_up.get(flotilla),
                                connected.get(d))
                ds.held = h.0
                if h.1 != "":
                    ds.held_by = h.1
                held += 1

        st.total = u64(len(members))
        st.in_progress = u64(in_progress)
        st.succeeded = u64(succeeded)
        st.failed = u64(failed)
        st.preparing = u64(preparing)
        st.prepared = u64(prepared)
        st.held = u64(held)

        # The materialized plan: the same computation the transform actuates,
        # published so the layout is inspectable before and during the run.
        for pw in plan_layout:
            win = st.plan.window.create((schedule=pw.0, start=u64(pw.1)))
            if pw.2 != OPEN_END:
                win.end = u64(pw.2)
            for entry in pw.3:
                pd = win.device.create(entry.0)
                started = shown.release_time(entry.0)
                if started is not None:
                    pd.started = u64(started)
                    finished = shown.done_time(entry.0)
                    if finished is not None:
                        pd.finished = u64(finished)
                else:
                    pd.estimated_start = u64(entry.1)
                pd.estimated_duration = u64(entry.2)
                prepare_start = plan_prepares.starts.get(entry.0)
                if prepare_start is not None:
                    pd.prepare_start = u64(prepare_start)
        if plan_prepares.c > 0:
            st.plan.prepare_concurrency = u64(plan_prepares.c)
        for alarm in plan_alarms + plan_prepares.alarms + member_alarms:
            st.plan.alarm.append(alarm)
        update_oper(oper)

    def forget(name: str) -> None:
        if name in latest:
            del latest[name]
        if name in connected:
            del connected[name]
        ctl.lost(name)
        ctl.report_prepare(name, None)
        ctl.set_vetoed(name, "")

    def foreign_veto(name: str) -> str:
        """Return the holder of a veto of another holder than the campaign
        that the device name reports, the first by name, or "" for
        none."""
        observed = latest.get(name)
        current = campaign
        if observed is not None and current is not None:
            own = veto_holder(current.name)
            for v in observed.vetoes:
                if v.0 != own:
                    return v.0
        return ""

    def live(name: str) -> bool:
        """Return whether the device name is up."""
        return device_live(flotilla_up.get(flotilla_of(name)), connected.get(name))

    def take_live(name: str) -> bool:
        """Tell the controller whether the member name is up, after a change.
        Return True when the campaign must decide for the change. In plan,
        any change can change the plan: the plan is that of a new run."""
        if ctl.set_live(name, live(name)):
            return True
        return not running

    def take_all_live() -> None:
        """Tell the controller whether each member is up."""
        for member in members:
            ctl.set_live(member, live(member))

    def changed(relevant: bool) -> None:
        """Act on a change in what the members report, once per debounce: a
        campaign that decides decides again, and the decision publishes;
        any other campaign publishes. Its devices can still change after it
        stops or finishes."""
        if relevant and subscriptions_synced and not debounce_armed and not closed:
            debounce_armed = True
            gen = generation
            # after now: the batch gets the whole window, however late the
            # telemetry that opens it arrives.
            if active:
                after now debounce_s: decide(gen)
            else:
                after now debounce_s: publish_settled(gen)

    def replan(now: int) -> None:
        """Plan again at time now when the campaign does not run, so the
        plan holds only the members that have not answered yet. A campaign
        that runs plans at each decision, and one whose run has finished
        does not plan again."""
        current = campaign
        if not running and current is not None:
            configure_campaign(ctl, current, inventory, now, member_info, run_since)
            plan_now(now)

    def publish_settled(gen: int) -> None:
        if gen != generation:
            return
        debounce_armed = False
        replan(time.time().unix_s())
        publish()

    def on_rfs(
        keys: ?(rfs_name: str, device_name: str),
        state: ?FlotillaDeviceStatus,
        error: ?Exception,
    ) -> None:
        relevant = error is not None
        if error is not None:
            print("campaign status subscription failed at {path}: {error}", err=True)
            latest = {}
            connected = {}
            ctl.lost_all()
            take_all_live()
        elif keys is not None:
            name = keys.device_name
            was = live(name)
            if state is not None:
                attempts_seen = []
                for a in state.attempt:
                    prep = a.prepare
                    inst = a.install
                    pre = a.precheck
                    post = a.postcheck
                    attempts_seen.append(
                        (number=a.number, status=a.status, stage=a.stage, reason=a.reason,
                         prepare=(state=prep.state, release=prep.release, started=prep.started,
                                  ended=prep.ended, message=prep.message,
                                  progress=prep.progress),
                         install=(state=inst.state, release=inst.release, started=inst.started,
                                  ended=inst.ended, message=inst.message),
                         precheck=(verdict=pre.verdict, detail=pre.detail, at=pre.at),
                         postcheck=(verdict=post.verdict, detail=post.detail, at=post.at)))
                value = (upgrade_campaign=state.upgrade_campaign,
                         target_release=state.target_release, attempts=attempts_seen,
                         vetoes=[(v.holder, v.reason) for v in state.veto],
                         version=state.platform.version, model=state.platform.model)
                # Of the platform the campaign keeps only the version and the
                # model, so a delivery can change nothing it keeps.
                if value != latest.get(name):
                    latest[name] = value
                    report(name, time.time().unix_s())
                    relevant = name in member_names
                    if relevant:
                        ctl.set_vetoed(name, foreign_veto(name))
                c = state.connected
                if c is not None:
                    connected[name] = c
                elif name in connected:
                    del connected[name]
            else:
                forget(name)
                relevant = name in member_names
            if name in member_names and live(name) != was and take_live(name):
                relevant = True
        changed(relevant)

    def on_flotilla(keys: ?(device_name: str, adapter_type: str),
                    entry: ?y1_oper.stratoweave_rfs__device__state__adapter_entry,
                    error: ?Exception) -> None:
        """Take whether the top is connected to a flotilla, and tell the
        controller about each member on it that goes down or comes up."""
        relevant = error is not None
        if error is not None:
            print("campaign flotilla subscription failed at {path}: {error}", err=True)
            flotilla_up = {}
            take_all_live()
        elif keys is not None:
            f = keys.device_name
            c: ?bool = None
            if entry is not None:
                c = entry.connected
            if c != flotilla_up.get(f):
                on_f = [m for m in members if flotilla_of(m) == f]
                was = [live(m) for m in on_f]
                if c is not None:
                    flotilla_up[f] = c
                else:
                    del flotilla_up[f]
                for i in range(len(on_f)):
                    if live(on_f[i]) != was[i] and take_live(on_f[i]):
                        relevant = True
        changed(relevant)

    def on_subscriptions_synced() -> None:
        # Closing the subscriptions fires a sync that is still pending.
        if closed:
            return
        subscriptions_synced = True
        gen = generation
        if active:
            after 0.0: decide(gen)
        else:
            # The replay's statuses came before the sync. Plan with them.
            replan(time.time().unix_s())
            publish()

    def shutdown(memory: ?CampaignMemory=None) -> None:
        # The campaign is deleted: end its timers, stop hearing from its
        # members and clear its state.
        closed = True
        generation += 1
        if subscriptions is not None:
            subscriptions!.close()
            subscriptions = None
        update_oper(None)

    def decide(gen: int) -> None:
        """Plan and take the plan's first step, lift the veto of the
        devices it releases, put the veto back on the devices that are
        done, write or remove allow-staging for the members that the step
        lets prepare or stops letting prepare, and arm the next decision at
        the time the step says."""
        if gen != generation or not active:
            return
        debounce_armed = False
        generation += 1
        next_gen = generation
        t = time.time().unix_s()
        # The schedules give new windows as time passes.
        current = campaign
        if current is not None:
            configure_campaign(ctl, current, inventory, t, member_info, run_since)
        s = ctl.decide(t)
        shown = ctl
        plan_layout = ctl.layout(s.plan)
        plan_alarms = s.plan.alarms
        plan_why = s.plan.why
        plan_prepares = s.prepares
        # Write only the members that went in flight or left it, and the
        # members let prepare or no longer let. A copy, so that the next
        # decision does not change the set the output was written with.
        in_flight = unheld_now()
        prep = fctl.copy_set(ctl.allowed)
        if current is not None:
            patched = intent_patch(output, current, inventory, (unheld, allowed),
                                   (in_flight, prep))
            if patched is not None:
                output = patched
                write_output(output)
            unheld = in_flight
            allowed = prep
        wake = s.wake
        if not s.finished and (wake < 0 or wake > t + HORIZON_REFRESH):
            # Devices that wait for windows beyond the horizon.
            wake = t + HORIZON_REFRESH
        if not s.finished:
            # Aim at the start of the wake's second on the wall clock, which t
            # is a whole second of, so that the time spent on this decision
            # does not push the next one into a later second. Plain after
            # keeps the offset within the second of the event that started
            # this chain of decisions: a decision that waits past the end of
            # that second is late, and the one after it is due a second early.
            delay = float(wake) - float(time.time().unix_ms()) / 1000.0
            if delay < 0.0:
                delay = 0.0
            after now delay: decide(next_gen)
        else:
            active = False
        publish()

    def on_conf(conf: y_0.software__software__upgrade_campaign_entry, linked: ygdata.Node,
                memory: ?CampaignMemory=None) -> None:
        run_since = kept_run_since(memory)
        ms = []
        names: set[str] = set()
        for member in conf.device:
            ms.append(member.name)
            names.add(member.name)
        left: set[str] = set()
        for name in member_names:
            if name not in names:
                left.add(name)
        # A member with a new attempt is a new member, like one removed and
        # added again.
        new_attempts = member_attempts(conf)
        tried_again: set[str] = set()
        for name, r in new_attempts.items():
            if name in member_names and r != attempts.get_def(name, 0):
                tried_again.add(name)
        members = ms
        member_names = names
        debounce_s = float(campaign_debounce_s(len(members)))

        campaign = conf
        inventory = y_0.root.from_gdata(linked)
        now = time.time().unix_s()
        member_info = campaign_members(conf, inventory)
        # The released devices, the ramp and the promises stay: a replan
        # goes on from where the run is.
        configure_campaign(ctl, conf, inventory, now, member_info, run_since)
        # The controller forgets the members that left and the members with
        # a new attempt. Added again, a member waits until it answers, and
        # starts in a window.
        ctl.drop(left | tried_again)
        take_all_live()
        run_now = conf.admin_state == "run"
        if run_now and not running:
            ctl.start()
        elif running and not run_now:
            ctl.stop()
        running = run_now
        targets = member_targets(conf, inventory)
        attempts = new_attempts
        # A new image makes the answers and the prepares for the old target
        # stale, and no device reports that. So report every member again.
        for name in members:
            if name in latest:
                report(name, now)
            ctl.set_vetoed(name, foreign_veto(name))
        # Stop letting prepare the members that may no longer prepare, such
        # as a member whose answer the new image made stale.
        ctl.revoke_prepares(now)
        # In plan every member is held.
        unheld = unheld_now() if run_now else set()
        allowed = fctl.copy_set(ctl.allowed)
        # The members that did not change keep the nodes of the output
        # written last. The transform function reused the same nodes, so
        # TTT writes again only the members that this edit changed.
        output = campaign_config(conf, inventory, unheld, allowed, None).to_gdata(
            output if isinstance(output, ygdata.Container) else None)
        write_output(output)
        member_alarms = image_alarms(conf, inventory)
        plan_now(now)

        # New intent invalidates every armed timer. The first decision after
        # subscription sync arms the exact timers the fresh plan needs.
        generation += 1
        debounce_armed = False
        active = running

        if lower_tree_provider is not None and subscriptions is None:
            # The actor id keeps apart the subscriptions of a deleted campaign
            # and of one created again under the same name.
            subscriptions = ygdata.SubscriptionManager(
                lower_tree_provider!,
                "campaign-status:{path}:{actorid()}",
            )

        if subscriptions is not None:
            want: set[ygdata.Delivery] = set()
            if len(members) > 0:
                statuses = y1_oper.subs.rfs.device.state
                want.add(statuses.dst(on_rfs).deliver({
                    statuses.subscribe(),
                }))
                adapters = y1_oper.subs.device.state.adapter
                want.add(adapters.dst(on_flotilla).deliver({
                    adapters.entry(FLOTILLA_TYPE).subscribe(),
                }))
            else:
                # A later subscription starts with a fresh rooted replay. Do
                # not retain entries that may disappear while unsubscribed.
                latest = {}
                connected = {}
                flotilla_up = {}
                ctl.lost_all()
            subscriptions_synced = False
            subscriptions!.declare(want, synced=on_subscriptions_synced)
        else:
            gen = generation
            if active:
                after 0.0: decide(gen)
            else:
                publish()
