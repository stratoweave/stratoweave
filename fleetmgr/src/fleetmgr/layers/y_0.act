    module_metadata={'http://stratoweave.org/yang/stratoweave':('stratoweave', '2026-04-01', [], False), 'http://stratoweave.org/yang/stratoweave-images':('stratoweave-images', None, [], True), 'urn:ietf:params:xml:ns:yang:ietf-inet-types':('ietf-inet-types', '2013-07-15', [], False), 'http://stratoweave.org/yang/stratoweave-ssh':('stratoweave-ssh', None, [], False), 'urn:fleetmgr:types':('fleetmgr-types', None, [], False), 'urn:fleetmgr:maintenance':('maintenance', None, [], True), 'urn:fleetmgr:fleetmgr':('fleetmgr', None, [], True), 'urn:fleetmgr:software':('software', None, [], True)},
