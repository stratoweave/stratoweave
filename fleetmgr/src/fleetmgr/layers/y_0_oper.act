SRC_DNODE_CHILD_31: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='allow-staging', config=True, description="Whether the members prepare their image before their window:\ncopy it to the device, with no outage, while the campaign's veto\nholds the install. In run, the campaign lets each member that\nneeds the upgrade, and that the plan gives a window, prepare\nonce. The first prepares at once. The others follow, as far\napart as their deadlines allow: the opening of the next window\nof the member's schedule that the campaign uses, less\nclose-margin percent of its expected prepare time. No member\nprepares while such a window is open. In plan nothing is copied.\nA failed prepare is not tried again. The upgrade in the window\ncopies the image again, so windows are not shorter.", default='false', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, units=None, exts=[], builtin_type='boolean', default=None), adata_name='allow_staging')

SRC_DNODE_CHILD_32: DList = DList(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='device', key=['name'], config=True, description='Devices this campaign upgrades. A device in the fleet is in one\ncampaign at most, also while the campaign is in plan or after it\nis done: an edit that names it in a second campaign fails. Delete\nthe campaign, or remove the device from it, to free the device.\nA device that is not in the fleet gets nothing from a campaign,\nso two campaigns can name it; the edit that adds it to the fleet\nthen fails until only one campaign names it. A device that is\nremoved and added again is a new member: it is held until it\nanswers again, so a member that failed is tried again.', min_elements=0, ordered_by='system', adata_name='device', children=[
    DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='name', config=True, is_key=True, mandatory=False, type=DTypeLeafref(name='leafref', description=None, reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('fleetmgr', 'fleet', []), yxpath.NodeTestStep('fleetmgr', 'device', []), yxpath.NodeTestStep('fleetmgr', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), exts=[
            DExt(module='stratoweave', namespace='http://stratoweave.org/yang/stratoweave', prefix='sw', name='link', arg='inventory', exts=[])
        ], adata_name='name'),
    DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='image', config=True, description='The image this device installs, from the image list. Its\nversion is the release the device should run.', is_key=False, mandatory=True, type=DTypeLeafref(name='leafref', description=None, reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('sw-img', 'images', []), yxpath.NodeTestStep('sw-img', 'image', []), yxpath.NodeTestStep('sw-img', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 200)]), patterns=[YangPattern(yang_regex='[A-Za-z0-9_\\-][A-Za-z0-9._\\-]*', pcre='^([A-Za-z0-9_\\-][A-Za-z0-9._\\-]*)$', invert=False)])), adata_name='image')
])

SRC_DNODE_CHILD_33: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='admin-state', config=True, description="plan: every member in the fleet gets the campaign's name and the\nveto campaign:NAME, which holds its install, and the target\nrelease and image URL of its image when the image is in the image\nlist and has a version. Each member reads the release it runs\nand answers up-to-date or upgrade-needed. Nothing is installed.\nA member in flight when the campaign goes from run to plan stops\nbefore its install; a member past its install finishes. The plan\nshows what a new run would do.\nrun: the campaign releases each member that has answered in a\nwindow of its schedule by removing the veto, and puts the veto\nback when the member is done. A member that still upgrades from\nbefore the run, after a pause or a restart, counts in flight and\nkeeps the veto.", default='plan', is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'plan':0, 'run':1}), adata_name='admin_state')

SRC_DNODE_CHILD_34: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='default-schedule', config=True, description='Schedule for members whose device has no binding of its own.\nDevices bound to a schedule are placed only in its windows, and\ndevices that do not fit are not actuated and surface as alarms\nin the plan. A campaign with no default and no bound members\ngets one synthetic window that opens at launch, or after\nnotification-period, and never closes; a deadline closes it\nlike any window.', is_key=False, mandatory=False, type=DTypeLeafref(name='leafref', description=None, reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('maint', 'schedules', []), yxpath.NodeTestStep('maint', 'schedule', []), yxpath.NodeTestStep('maint', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])), adata_name='default_schedule')

SRC_DNODE_CHILD_35: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='deadline', config=True, description='When the campaign must be finished, as seconds since the Unix\nepoch. The deadline cuts off the window supply: only window\ntime before it counts, and the concurrency it needs is computed\nbackwards from it. Devices that cannot be placed before the\ndeadline surface as alarms.', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint64', description=None, reference=None, units=None, exts=[], builtin_type='uint64', default=None, ranges=Ranges([(0, 18446744073709551615)])), units='seconds', adata_name='deadline')

SRC_DNODE_CHILD_36: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='notification-period', config=True, description='How long before a window the customers of its members must\nknow about it. The campaign uses only the windows that open this\nlong or more after run-since in state, or after now before the\nfirst run. It leaves out a window that opens earlier, also when\nthe window closes later. A member added later, and a member that\nis up to date, gets no notice of its own: it gets the first\nwindow that the campaign can use. A larger value during a run\ntakes windows away, and their waiting members get the next\nwindow that is left. 0 gives no notice.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint16', description=None, reference=None, units=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(0, 65535)])), units='days', adata_name='notification_period')

SRC_DNODE_CHILD_37: DContainer = DContainer(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='memory', config=True, description='What fleetmgr keeps for the campaign. A value configured here has\nno effect.', presence=False, exts=[
        DExt(module='stratoweave', namespace='http://stratoweave.org/yang/stratoweave', prefix='sw', name='memory', arg=None, exts=[])
    ], adata_name='memory', children=[
    DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='run-since', config=True, description='The run-since of state.', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint64', description=None, reference=None, units=None, exts=[], builtin_type='uint64', default=None, ranges=Ranges([(0, 18446744073709551615)])), units='seconds', adata_name='run_since')
])

SRC_DNODE_CHILD_38: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='target-concurrency', config=True, description='How many devices upgrade at the same time while the campaign\nis on schedule. The controller starts with one device and\ngrows toward this number as devices finish without a failure.\nIt goes above it only when a window or the deadline needs\nmore, up to max-concurrency.', default='10', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(1, 4294967295)])), units='devices', adata_name='target_concurrency')

SRC_DNODE_CHILD_39: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='max-concurrency', config=True, description='The most devices that upgrade at the same time, also when a\nwindow or the deadline needs more. A deadline that needs more\nraises an alarm. A value below target-concurrency counts as\ntarget-concurrency.', default='50', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(1, 4294967295)])), units='devices', adata_name='max_concurrency')

SRC_DNODE_CHILD_40: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='close-margin', config=True, description="How much time a device must have left before its window\ncloses to start there, in percent of its slow time. The slow\ntime is the 98th percentile of the last upgrade times, two\nrounds at max-concurrency and at least 50, or the mean of the\nlast round and a quarter at target-concurrency when that is\nlonger, scaled to the device's estimate. 150 starts a device\nonly while one and a half times its slow time is left. When\nthe margin is longer than the time left in every window of a\ndevice's schedule, the device starts in no window, and the\nplan says so.", default='150', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint16', description=None, reference=None, units=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(100, 65535)])), units='percent', adata_name='close_margin')

SRC_DNODE_CHILD_41: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='stagger', config=True, description='How long the campaign takes to start as many devices as its\nconcurrency, in percent of the expected upgrade time. The\nstarts are spread evenly, so when a window opens with room for\nmany devices, they start one after the other, and a larger\ncampaign starts them faster. At 100, the devices that fill a\nwindow start over one upgrade time, and then as fast as devices\nend on average; below 100 the starts can also catch up when more\ndevices end at once. 0 starts them all at once.', default='25', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint16', description=None, reference=None, units=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(0, 100)])), units='percent', adata_name='stagger')

SRC_DNODE_CHILD_42: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='failure-budget', config=True, description="The most members that may fail, in percent of the members the\ncampaign has now, rounded down to whole devices: 0.5 percent of\n1000 members is 5 devices. A member has failed while its status\nfor this campaign's intent is failed or rolled-back. When more\nmembers have failed than the budget, no more members start or\nprepare, and the plan gives an alarm. Without a budget, any\nnumber of members may fail.", is_key=False, mandatory=False, type=DTypeDecimal64(name='decimal64', description=None, reference=None, units=None, exts=[], builtin_type='decimal64', default=None, fraction_digits=2, ranges=Ranges([(Decimal(0, 0), Decimal(100, 0))])), units='percent', adata_name='failure_budget')

