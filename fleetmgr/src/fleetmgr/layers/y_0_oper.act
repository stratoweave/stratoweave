SRC_DNODE_CHILD_68: DList = DList(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='prepare-bandwidth', key=['time'], config=False, description='The bandwidth that the members use to prepare, over time:\nfrom each time on until the next, the sum of the bandwidths\nof the prepares that run, the prepares that run now included.\nA prepare runs for its expected prepare time from when its\nmember is let: its prepare-start, or when it is let again\nafter it had not begun, and not before now while it has not\nbegun. It uses the size of its image divided by its expected\nprepare time, and none when the image has no size. The list\nhas at most 1000 entries. When the bandwidth changes more\noften, the time from the first change to the last is cut into\nequal stretches, and each entry gives the most bandwidth that\nits stretch reaches.', min_elements=0, ordered_by='system', adata_name='prepare_bandwidth', children=[
