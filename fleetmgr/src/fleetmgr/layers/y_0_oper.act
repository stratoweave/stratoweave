SRC_DNODE_CHILD_27: DContainer = DContainer(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='redundancy-groups', config=True, description='How far apart the members of a redundancy group upgrade, and what a\nfailed member does to the others. A group that has no entry here\nspreads, with no min-separation, and continues after a failure. The\ncontainer is a transform so campaigns can link it and re-plan when\nan entry changes.', presence=False, exts=[
        DExt(module='stratoweave', namespace='http://stratoweave.org/yang/stratoweave', prefix='sw', name='transform', arg='fleetmgr.cfs.RedundancyGroups', exts=[])
    ], adata_name='redundancy_groups', children=[
    DList(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='redundancy-group', key=['name'], config=True, min_elements=0, ordered_by='system', adata_name='redundancy_group', children=[
        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='name', config=True, description='The group, as devices name it under redundancy-group.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='name'),
        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='separation-policy', config=True, description='spread: when the plan first gives the members their windows, it\nmoves later members to later windows of the campaign, up to as\nfar apart as those windows allow. A member moves only by trading\nwindows with a device of the same estimate in no group, and only\nwhen no device then misses its window. pack: each member starts\nas soon as the member before it is done.', default='spread', is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'spread':0, 'pack':1}), adata_name='separation_policy'),
        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='min-separation', config=True, description='The least time from when one member is done until the next may\nstart, for either policy.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), units='seconds', adata_name='min_separation'),
        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='failure-policy', config=True, description='continue: a member that failed or rolled back holds the other\nmembers only until it is done and up again; the next member\nthen starts after min-separation. A member whose rollback\nfailed is in an unknown state, and holds the other members until\nan operator acts, as under hold. So does a member whose attempt\ndid not start after the rollback of an earlier one failed. hold: while a member is failed,\nthe other members wait for an operator: a new attempt, a removal, or a\nsuccess that the member reports later.', default='continue', is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'continue':0, 'hold':1}), adata_name='failure_policy')
    ])
])

