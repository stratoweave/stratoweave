SRC_DNODE_CHILD_43: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='target-concurrency', config=True, description='How many devices upgrade at the same time while the campaign\nis on schedule. The controller starts with one device and\ngrows toward this number as devices finish without a failure.\nIt goes above it only when a window or the deadline needs\nmore, up to max-concurrency, and then stays there for the run.\nA higher value raises the concurrency of the run to it, or\nkeeps it when it is higher already; a lower value starts it\nover at the new value.', default='10', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(1, 4294967295)])), units='devices', adata_name='target_concurrency')

SRC_DNODE_CHILD_44: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='max-concurrency', config=True, description='The most devices that upgrade at the same time, also when a\nwindow or the deadline needs more. A deadline that needs more\nraises an alarm. A value below target-concurrency counts as\ntarget-concurrency. A new value keeps the concurrency of the\nrun, capped at the new value.', default='50', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(1, 4294967295)])), units='devices', adata_name='max_concurrency')

SRC_DNODE_CHILD_45: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='close-margin', config=True, description="How much time a device must have left before its window\ncloses to start there, in percent of its slow time. The slow\ntime is the 98th percentile of the last upgrade times, two\nrounds at max-concurrency and at least 50, or the mean of the\nlast round and a quarter at target-concurrency when that is\nlonger, scaled to the device's estimate. 150 starts a device\nonly while one and a half times its slow time is left. When\nthe margin is longer than the time left in every window of a\ndevice's schedule, the device starts in no window, and the\nplan says so.", default='150', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint16', description=None, reference=None, units=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(100, 65535)])), units='percent', adata_name='close_margin')

SRC_DNODE_CHILD_46: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='stagger', config=True, description='How long the campaign takes to start as many devices as its\nconcurrency, in percent of the expected upgrade time. The\nstarts are spread evenly, so when a window opens with room for\nmany devices, they start one after the other, and a larger\ncampaign starts them faster. At 100, the devices that fill a\nwindow start over one upgrade time, and then as fast as devices\nend on average; below 100 the starts can also catch up when more\ndevices end at once. 0 starts them all at once.', default='25', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint16', description=None, reference=None, units=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(0, 100)])), units='percent', adata_name='stagger')

SRC_DNODE_CHILD_47: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='failure-budget', config=True, description="The most members that may fail, in percent of the members the\ncampaign has now, rounded down to whole devices: 0.5 percent of\n1000 members is 5 devices. A member has failed while its status\nfor this campaign's intent is failed, rolled-back or\nnot-started, and while its rollback failed, also when its\nstatus is lost, until its device reports another final status,\nit gets a new attempt, or it leaves the campaign. A member that\nthe campaign has freed has failed while its result is failed,\nrolled-back or not-started. When more members have failed than\nthe budget, no more members start or prepare, and the plan gives\nan alarm. Without a budget, any number of members may fail.", is_key=False, mandatory=False, type=DTypeDecimal64(name='decimal64', description=None, reference=None, units=None, exts=[], builtin_type='decimal64', default=None, fraction_digits=2, ranges=Ranges([(Decimal(0, 0), Decimal(100, 0))])), units='percent', adata_name='failure_budget')

SRC_DNODE_CHILD_49: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='run-since', config=False, description='When the campaign first went to run, as seconds since the Unix\nepoch. A pause and a restart of fleetmgr keep it, and deleting\nthe campaign clears it. Absent before the first run.', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint64', description=None, reference=None, units=None, exts=[], builtin_type='uint64', default=None, ranges=Ranges([(0, 18446744073709551615)])), units='seconds', adata_name='run_since')

SRC_DNODE_CHILD_50: DLeaf = DLeaf(module='software', namespace='urn:fleetmgr:software', prefix='sw-cfs', name='completed', config=False, description="When the campaign was complete, as seconds since the Unix epoch:\nthe latest freed of its members. A campaign in run is complete\nwhen every member is done: its status for the campaign's intent\nis final, also when it failed, and it is not in flight. The\ncampaign then frees its members. Each member that is not done\nkeeps the campaign incomplete. A member that cannot start, such\nas one held by the failure budget, one that is not in the fleet\nor one with no window before the deadline, keeps it incomplete\nuntil an operator removes the member or lifts what holds it.\nAbsent while a member has no result, and in a campaign without\nmembers.", is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint64', description=None, reference=None, units=None, exts=[], builtin_type='uint64', default=None, ranges=Ranges([(0, 18446744073709551615)])), units='seconds', adata_name='completed')

