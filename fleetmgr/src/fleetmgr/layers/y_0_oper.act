    module_metadata={'http://stratoweave.org/yang/stratoweave':('stratoweave', '2026-04-01', [], False), 'http://stratoweave.org/yang/stratoweave-images':('stratoweave-images', None, [], True), 'urn:ietf:params:xml:ns:yang:ietf-inet-types':('ietf-inet-types', '2013-07-15', [], False), 'http://stratoweave.org/yang/stratoweave-ssh':('stratoweave-ssh', None, [], False), 'urn:fleetmgr:types':('fleetmgr-types', None, [], False), 'urn:fleetmgr:maintenance':('maintenance', None, [], True), 'urn:fleetmgr:fleetmgr':('fleetmgr', None, [], True), 'urn:fleetmgr:software':('software', None, [], True)},
)

SRC_YANG_0: str = r"""module fleetmgr {
  yang-version "1.1";
  namespace "urn:fleetmgr:fleetmgr";
  prefix fleetmgr;

  import stratoweave {
    prefix sw;
  }
  import maintenance {
    prefix maint;
  }
  import fleetmgr-types {
    prefix fleetmgr-types;
  }

  container fleet {
    list device {
      key name;

      sw:transform fleetmgr.cfs.Device;

      leaf name {
        type string;
      }

      leaf type {
        description "Device platform type understood by the owning flotilla.";
        type string;
        mandatory true;
      }

      leaf schedule {
        description
          "Maintenance schedule this device is bound to. A campaign places
           the device only in windows of this schedule; without a binding
           the campaign's default schedule applies.";
        type leafref {
          path "/maint:schedules/maint:schedule/maint:name";
        }
      }

      leaf-list redundancy-group {
        description
          "The redundancy groups this device is a member of. The members of
           a group back each other up, so a campaign upgrades them one at a
           time, in order of redundancy-priority, and as far apart as the
           group's entry under /redundancy-groups says. The group's
           failure-policy says whether the other members go on after a
           member fails.";
        type string;
      }

      leaf redundancy-priority {
        description
          "Where this device comes in each of its redundancy groups: lower
           first, and equal priorities in order of device name.";
        type uint16;
        default 100;
      }

      uses fleetmgr-types:device-options;
      uses fleetmgr-types:upgrade-checks;

      container state {
        config false;
        container platform {
          description
            "Absent until the device has connected.";
          uses fleetmgr-types:platform;
        }
        leaf connected {
          description
            "Whether the device can be reached. Absent while the device has
             not connected since fleetmgr started and its flotilla is not
             down.";
          type enumeration {
            enum connected {
              description
                "Its flotilla is connected to the device, and the top is
                 connected to the flotilla.";
            }
            enum device-down {
              description "Its flotilla is not connected to the device.";
            }
            enum flotilla-down {
              description
                "The top is not connected to the device's flotilla, so
                 whether the flotilla is connected to the device is not
                 known. A device that was down before stays device-down,
                 as a campaign holds it for down.";
            }
          }
        }
      }
    }
  }

  container redundancy-groups {
    description
      "How far apart the members of a redundancy group upgrade, and what a
       failed member does to the others. A group that has no entry here
       spreads, with no min-separation, and continues after a failure. The
       container is a transform so campaigns can link it and re-plan when
       an entry changes.";

    sw:transform fleetmgr.cfs.RedundancyGroups;

    list redundancy-group {
      key name;

      leaf name {
        description "The group, as devices name it under redundancy-group.";
        type string;
      }

      leaf separation-policy {
        description
          "spread: when the plan first gives the members their windows, it
           moves later members to later windows of the campaign, up to as
           far apart as those windows allow. A member moves only by trading
           windows with a device of the same estimate in no group, and only
           when no device then misses its window. pack: each member starts
           as soon as the member before it is done.";
        type enumeration {
          enum spread;
          enum pack;
        }
        default spread;
      }

      leaf min-separation {
        description
          "The least time from when one member is done until the next may
           start, for either policy.";
        type uint32;
        units "seconds";
        default 0;
      }

      leaf failure-policy {
        description
          "continue: a member that failed or rolled back holds the other
           members only until it is done and up again; the next member
           then starts after min-separation. A member whose rollback
           failed is in an unknown state, and holds the other members until
           an operator acts, as under hold. So does a member whose attempt
           did not start after the rollback of an earlier one failed. hold: while a member is failed,
           the other members wait for an operator: a new attempt, a removal, or a
           success that the member reports later.";
        type enumeration {
          enum continue;
          enum hold;
        }
        default continue;
      }
    }
  }
}
"""

SRC_YANG_1: str = r"""module maintenance {
  yang-version "1.1";
  namespace "urn:fleetmgr:maintenance";
  prefix maint;

  import stratoweave {
    prefix sw;
  }

  container schedules {
    description
      "The named maintenance schedules: generators of the absolute window
       occurrences in which impacting work on the devices bound to a
       schedule may run. Devices bind to a schedule by name on their
       inventory entry and campaigns name one as their default, so a
       schedule outlives any one campaign. The container is a transform
       so campaigns can link it and re-plan when any schedule changes.";

    sw:transform fleetmgr.cfs.Schedules;

    list schedule {
      key name;
      leaf name {
        type string;
      }
      leaf utc-offset {
        description
          "The schedule's local timezone, as minutes east of UTC. A stand
           in until proper timezone names arrive: it pretends there is no
           daylight saving.";
        type int16 {
          range "-720..840";
        }
        units "minutes";
        default 0;
      }
      list window {
        description
          "One recurrence rule: the window opens at the local time of day
           on the listed weekdays, and every day when none are listed.
           An edit of the rules or of utc-offset that takes away a window
           that a campaign promised to waiting members, before it closes,
           moves each promise to the window of the schedule that has not
           closed and whose opening is nearest, the later one of two as
           near. So a window moved by less than half a day, or made longer
           or shorter, that closes after the edit keeps its members on
           their day; a larger move can put them on the day before or
           after.";
        key "at";
        leaf at {
          description
            "Local time of day the window opens, as seconds after
             midnight.";
          type uint32 {
            range "0..86399";
          }
          units "seconds";
        }
        leaf duration {
          type uint32;
          units "seconds";
          mandatory true;
        }
        leaf-list day {
          type enumeration {
            enum mon;
            enum tue;
            enum wed;
            enum thu;
            enum fri;
            enum sat;
            enum sun;
          }
        }
      }
    }
  }
}
"""

SRC_YANG_2: str = r"""module software {
  yang-version "1.1";
  namespace "urn:fleetmgr:software";
  prefix sw-cfs;

  import stratoweave {
    prefix sw;
  }
  import maintenance {
    prefix maint;
  }
  import fleetmgr {
    prefix fleetmgr;
  }
  import fleetmgr-types {
    prefix fleetmgr-types;
  }
  import stratoweave-images {
    prefix sw-img;
  }

  grouping campaign-result {
    description
      "The result of a member that a campaign has freed, as device-status
       shows it: its final status, and when it was done and freed.";
    leaf status {
      type enumeration {
        enum succeeded;
        enum up-to-date;
        enum failed;
        enum rolled-back;
        enum not-started;
      }
    }
    leaf stage {
      type string;
    }
    leaf reason {
      type string;
    }
    leaf finished {
      description "When the member was done, as seconds since the Unix epoch.";
      type uint64;
      units "seconds";
    }
    leaf freed {
      description
        "When the campaign freed the member, as seconds since the Unix
         epoch.";
      type uint64;
      units "seconds";
    }
  }

  grouping plan-layout {
    list window {
      description
        "One planned window occurrence: which schedule it came from, when
         it opens and closes as absolute times, and the devices placed in
         it. An always-open window has no end.";
      key "schedule start";
      leaf schedule {
        description "Name of the window's source; a campaign without
           windows plans into one synthetic default window.";
        type string;
      }
      leaf start {
        description "Seconds since the Unix epoch.";
        type uint64;
        units "seconds";
      }
      leaf end {
        description "Seconds since the Unix epoch.";
        type uint64;
        units "seconds";
      }
      list device {
        key name;
        description
          "A device the controller has released stays in the window it
           was released in, with its real times.";
        leaf name {
          type string;
        }
        leaf estimated-start {
          description "Seconds since the Unix epoch; an estimate, for a
             device not released yet.";
          type uint64;
          units "seconds";
        }
        leaf estimated-duration {
          type uint32;
          units "seconds";
        }
        leaf prepare-start {
          description
            "Seconds since the Unix epoch: when the campaign first let the
             device prepare its image, or, for a device that waits to
             prepare, when it will. A waiting device keeps it when other
             devices join or leave, and through a pause or a hold of
             failure-budget that ends before it; only one that passed moves.
             Absent when the device does not prepare before its window.";
          type uint64;
          units "seconds";
        }
        leaf started {
          description "Seconds since the Unix epoch, when the controller
             released the device.";
          type uint64;
          units "seconds";
        }
        leaf finished {
          description "Seconds since the Unix epoch, when the device
             reported that its upgrade ended.";
          type uint64;
          units "seconds";
        }
      }
    }
    leaf-list alarm {
      description
        "Placement problems, such as devices that did not fit, the
         devices that are held, and the members that cannot prepare
         before their window, also when they were let and have not
         prepared, or that wait for it after a failed prepare.";
      type string;
    }
  }

  container software {
    list upgrade-campaign {
      key name;

      sw:transform fleetmgr.cfs.UpgradeCampaign {
          sw:direct-output;
      }
      sw:link schedules {
        sw:path /maint:schedules;
      }
      sw:link redundancy-groups {
        sw:path /fleetmgr:redundancy-groups;
      }
      sw:link images {
        sw:path /sw-img:images;
      }
      leaf name {
        type string;
      }
      leaf allow-staging {
        description
          "Whether the members prepare their image before their window:
           copy it to the device, with no outage, while the campaign's veto
           holds the install. In run, the campaign lets each member that
           needs the upgrade, and that the plan gives a window, prepare
           once, by its deadline: the opening of a window less close-margin
           percent of its expected prepare time. prepare-before-first-window,
           prepare-between-windows and prepare-during-windows say which
           window, and when the members may prepare. The first prepares as
           soon as they let it. The others follow, as far apart as their
           deadlines and prepare-max-bandwidth allow. A change of these
           settings or of the cap gives the members that wait to prepare
           new turns. A member that was let and has not begun when a window
           opens or closes, or when the run pauses, is let again once it
           may prepare, by its deadline. In plan nothing is copied.
           A prepare that fails for a transient reason, such as a device
           that is not connected, is tried again, and the campaign lets the
           member prepare until its window opens. After any other failure
           the member is not let again until its prepare-attempt changes.
           The upgrade in the window copies the image again, so windows are
           not shorter.";
        type boolean;
        default "false";
      }
      leaf prepare-before-first-window {
        description
          "Whether the members may prepare before the campaign's first
           window opens, with allow-staging. A member that fits there under
           prepare-max-bandwidth prepares by the opening of the first window
           less close-margin percent of its expected prepare time. The
           members of the earliest windows go first; with
           prepare-during-windows, a member with a longer expected prepare
           time can go before them. Set to false, a member promised the
           first window cannot prepare, and the plan's alarm names it.";
        type boolean;
        default "true";
      }
      leaf prepare-between-windows {
        description
          "Whether the members may prepare between windows, with
           allow-staging: after the first window opens, outside the windows.
           A member that does not fit before the first window prepares by
           the opening of its own window less close-margin percent of its
           expected prepare time. Absent, it is on, and state/plan says
           whether a member prepares between windows: a member that does
           not fit before the first window, or that was let before it and
           had not begun when it opened. Set to false, no member prepares
           between windows, nor in the time before each close that
           close-margin percent of the longest expected prepare time needs.
           Without prepare-during-windows, a member that does not fit before
           the first window then cannot prepare in time, and the plan's
           alarm names it.";
        type boolean;
      }
      leaf prepare-during-windows {
        description
          "Whether the members may prepare while a window of the campaign is
           open, with allow-staging, each still before its own window.
           Without it, no member prepares while a window of the campaign is
           open, a window that still holds a member in flight included, nor
           in the time before each opening that close-margin percent of the
           longest expected prepare time needs, so no prepare is planned to
           run into a window.";
        type boolean;
        default "false";
      }
      leaf prepare-max-bandwidth {
        description
          "The most bandwidth that the members of the campaign use together
           to prepare, with allow-staging, as state/plan/prepare-bandwidth
           counts it. A turn to prepare that would take the bandwidth over
           this comes later, and a prepare that alone uses more runs alone.
           Absent, the campaign takes the prepare-max-bandwidth of the image
           list.";
        type uint64 {
          range "1..max";
        }
        units "bits/second";
      }
      list device {
        key name;
        description
          "Devices this campaign upgrades. The campaign acquires each member
           that is in the fleet, in plan and in run: it writes the member's
           software intent and the campaign's veto. One campaign at most
           acquires a device: an edit that makes a second campaign acquire
           it fails. A complete campaign frees its members: it keeps each
           member's result and writes nothing more to their devices, so
           another campaign can acquire them; see completed in state. Only a
           new attempt acquires a freed member again, and adding a member to
           a complete campaign acquires that member; such an edit fails while
           another campaign has acquired the device. To move an acquired
           device, remove it from its campaign, or delete the campaign, and
           add it to the other campaign in a later edit: a move in one edit
           fails. A freed device can move in one edit. A device that is not
           in the fleet gets nothing from a campaign, so two campaigns can
           name it; the edit that adds it to the fleet then fails while two
           campaigns that have not freed it name it. A device that is
           removed and added again is a new member, and its device keeps
           the final status of its attempt: a member that failed counts as
           failed until it has a new attempt, and a freed member added
           again is done at once.";
        leaf name {
          sw:link inventory;
          type leafref {
            path "/fleetmgr:fleet/fleetmgr:device/fleetmgr:name";
          }
        }
        leaf image {
          description
            "The image this device installs, from the image list. Its
             version is the release the device should run. Once the
             campaign has let the device prepare or released it, the image
             and its version stay: an edit that gives the device another
             image, or that changes or removes the version of its image in
             the image list, fails.";
          type leafref {
            path "/sw-img:images/sw-img:image/sw-img:name";
          }
          mandatory true;
        }
        leaf attempt {
          description
            "Change it to try the device again, with the same image, after
             its attempt failed, rolled back or did not start, or after its
             rollback failed. The campaign then takes the device as a new
             member: it reads its release again, is held until it answers
             the new attempt, and is upgraded again in a window. An edit
             that gives a new attempt to any other device fails. Any new
             value counts.";
          type uint32;
          default "0";
        }
        leaf prepare-attempt {
          description
            "Change it to prepare the device again, as after a failed
             prepare. In run, with allow-staging, the campaign lets the
             device prepare at once, as soon as prepare-max-bandwidth
             allows, until its window opens, but not in a time in which no
             member may prepare. Without prepare-during-windows, all the
             time after the device's deadline is such a time. The device
             keeps its prepare-start. Any new value counts.";
          type uint32;
          default "0";
        }
      }
      leaf admin-state {
        description
          "plan: every member in the fleet that the campaign has not freed
           gets the campaign's name, its attempt and the veto campaign:NAME,
           which holds its install, and the target release and image URL of
           its image when the image is in the image list and has a version.
           Each member reads the release it runs and answers up-to-date or
           upgrade-needed. Nothing is installed.
           A member in flight when the campaign goes from run to plan stops
           before its install; a member past its install finishes. Going
           from run to plan pauses the run, and the plan shows what the run
           does when it goes on: the members that are done keep their
           times, the waiting members keep their prepare-starts and their
           places in the order of the promises, and the members still in
           flight keep their start and the veto.
           run: the campaign releases each member that needs the upgrade
           in a window of its schedule by removing the veto, and puts the
           veto back when the member is done. A member whose status is
           final while it waits, such as one that is up to date, or one
           that succeeded or failed before it left the campaign and
           joined it again with the same attempt, is done at once: it
           takes no window. After a pause, the run goes on where it was.
           A member that still upgrades from before a pause or a restart
           counts in flight and keeps the veto. A member released before a
           pause that did not start its run waits again in the window it
           was released in, before the members promised that window after
           it. A waiting member whose promised window closed in the pause
           waits in the next window of its schedule, in its place in the
           order of the promises.
           When every member is done, the campaign is complete and frees its
           members; see completed in state. Only run completes a campaign.
           admin-state changes nothing for the members that the campaign has
           freed.";
        type enumeration {
          enum plan;
          enum run;
        }
        default plan;
      }

      leaf default-schedule {
        description
          "Schedule for members whose device has no binding of its own.
           Devices bound to a schedule are placed only in its windows, and
           devices that do not fit are not actuated and surface as alarms
           in the plan. A campaign with no default and no bound members
           gets one synthetic window that opens at launch, or after
           notification-period, and never closes; a deadline closes it
           like any window.";
        type leafref {
          path "/maint:schedules/maint:schedule/maint:name";
        }
      }
      leaf deadline {
        description
          "When the campaign must be finished, as seconds since the Unix
           epoch. The deadline cuts off the window supply: only window
           time before it counts, and the concurrency it needs is computed
           backwards from it. Devices that cannot be placed before the
           deadline surface as alarms. A new deadline that takes away a
           window promised to waiting members moves each promise to the
           window of its schedule that has not closed and whose opening is
           nearest.";
        type uint64;
        units "seconds";
      }
      leaf notification-period {
        description
          "How long before a window the customers of its members must
           know about it. The campaign uses only the windows that open this
           long or more after run-since in state, or after now before the
           first run. It leaves out a window that opens earlier, also when
           the window closes later. A member added later gets no notice of
           its own: it gets the first window that the campaign can use. A
           larger value during a run takes windows away, and their waiting
           members get the next window that is left. 0 gives no notice.";
        type uint16;
        units "days";
        default 0;
      }
      container memory {
        sw:memory;
        description
          "What fleetmgr keeps for the campaign. A value configured here has
           no effect.";
        leaf run-since {
          description "The run-since of state.";
          type uint64;
          units "seconds";
        }
        list member {
          key device;
          description
            "Each member as the last edit of the campaign or of its linked
             input took it, with its result once the campaign has freed it:
             what device-status shows for it. The result stands while the
             member keeps its attempt.";
          leaf device {
            type string;
          }
          leaf image {
            type string;
          }
          leaf target-release {
            description "The version of the image.";
            type string;
          }
          leaf attempt {
            type uint32;
            default "0";
          }
          leaf image-locked {
            description
              "Whether the campaign has let the device prepare or released
               it, so that it keeps the image and its version.";
            type boolean;
            default "false";
          }
          uses campaign-result;
        }
        leaf request {
          description
            "The number of the last request in dynstate whose results the
             transform took. The transform takes a request once: one with
             this number or a lower one changes nothing.";
          type uint64;
        }
      }
      container dynstate {
        sw:dynstate;
        description
          "What the campaign's actor asked its transform to keep last: the
           results of all the members that it has freed. A value configured
           here has no effect.";
        leaf request {
          description
            "The number of the request: each request of the actor has a
             higher number than the last one that memory took.";
          type uint64;
        }
        list result {
          key device;
          leaf device {
            type string;
          }
          leaf attempt {
            description "The attempt of the member that the result is for.";
            type uint32;
          }
          uses campaign-result;
        }
      }
      leaf target-concurrency {
        description
          "How many devices upgrade at the same time while the campaign
           is on schedule. The controller starts with one device and
           grows toward this number as devices finish without a failure.
           It goes above it only when a window or the deadline needs
           more, up to max-concurrency, and then stays there for the run.
           A higher value raises the concurrency of the run to it, or
           keeps it when it is higher already; a lower value starts it
           over at the new value.";
        type uint32 {
          range "1..max";
        }
        units "devices";
        default 10;
      }
      leaf max-concurrency {
        description
          "The most devices that upgrade at the same time, also when a
           window or the deadline needs more. A deadline that needs more
           raises an alarm. A value below target-concurrency counts as
           target-concurrency. A new value keeps the concurrency of the
           run, capped at the new value.";
        type uint32 {
          range "1..max";
        }
        units "devices";
        default 50;
      }
      leaf close-margin {
        description
          "How much time a device must have left before its window
           closes to start there, in percent of its slow time. The slow
           time is the 98th percentile of the last upgrade times, two
           rounds at max-concurrency and at least 50, or the mean of the
           last round and a quarter at target-concurrency when that is
           longer, scaled to the device's estimate. 150 starts a device
           only while one and a half times its slow time is left. When
           the margin is longer than the time left in every window of a
           device's schedule, the device starts in no window, and the
           plan says so.";
        type uint16 {
          range "100..max";
        }
        units "percent";
        default 150;
      }
      leaf stagger {
        description
          "How long the campaign takes to start as many devices as its
           concurrency, in percent of the expected upgrade time. The
           starts are spread evenly, so when a window opens with room for
           many devices, they start one after the other, and a larger
           campaign starts them faster. At 100, the devices that fill a
           window start over one upgrade time, and then as fast as devices
           end on average; below 100 the starts can also catch up when more
           devices end at once. 0 starts them all at once.";
        type uint16 {
          range "0..100";
        }
        units "percent";
        default 25;
      }
      leaf failure-budget {
        description
          "The most members that may fail, in percent of the members the
           campaign has now, rounded down to whole devices: 0.5 percent of
           1000 members is 5 devices. A member has failed while its status
           for this campaign's intent is failed, rolled-back or
           not-started, and while its rollback failed, also when its
           status is lost, until its device reports another final status,
           it gets a new attempt, or it leaves the campaign. A member that
           the campaign has freed has failed while its result is failed,
           rolled-back or not-started. When more members have failed than
           the budget, no more members start or prepare, and the plan gives
           an alarm. Without a budget, any number of members may fail.";
        type decimal64 {
          fraction-digits 2;
          range "0..100";
        }
        units "percent";
      }

      container state {
        config false;
        leaf run-since {
          description
            "When the campaign first went to run, as seconds since the Unix
             epoch. A pause and a restart of fleetmgr keep it, and deleting
             the campaign clears it. Absent before the first run.";
          type uint64;
          units "seconds";
        }
        leaf completed {
          description
            "When the campaign was complete, as seconds since the Unix epoch:
             the latest freed of its members. A campaign in run is complete
             when every member is done: its status for the campaign's intent
             is final, also when it failed, and it is not in flight. The
             campaign then frees its members. Each member that is not done
             keeps the campaign incomplete. A member that cannot start, such
             as one held by the failure budget, one that is not in the fleet
             or one with no window before the deadline, keeps it incomplete
             until an operator removes the member or lifts what holds it.
             Absent while a member has no result, and in a campaign without
             members.";
          type uint64;
          units "seconds";
        }
        leaf total {
          type uint32;
        }
        leaf in-progress {
          description
            "Counts the statuses of device-status: those for this campaign's
             intent, which the device reports for its name and the member's
             target release, and the results of the freed members.";
          type uint32;
        }
        leaf succeeded {
          description
            "Counts the statuses of device-status: those for this campaign's
             intent, which the device reports for its name and the member's
             target release, and the results of the freed members. Includes
             up-to-date.";
          type uint32;
        }
        leaf up-to-date {
          description
            "Members whose status for this campaign's intent, or whose result
             when the campaign has freed them, is up-to-date: they ran the
             target release before the campaign upgraded them. succeeded
             counts them too.";
          type uint32;
        }
        leaf failed {
          description
            "Counts the statuses of device-status: those for this campaign's
             intent, which the device reports for its name and the member's
             target release, and the results of the freed members. Includes
             rolled-back and not-started.";
          type uint32;
        }
        leaf preparing {
          description
            "Members that wait for their release and prepare the target now:
             their status for this campaign's intent is upgrade-needed, and
             their prepare of the target runs.";
          type uint32;
        }
        leaf prepared {
          description
            "Members that wait for their release with the target prepared:
             their status for this campaign's intent is upgrade-needed, and
             their prepare of the target is done.";
          type uint32;
        }
        leaf held {
          description
            "Members that are held: the members that device-status gives
             a held reason.";
          type uint32;
        }
        container plan {
          description
            "The materialized plan: every window the campaign is placed
             into, the devices assigned to each, and their times: real for
             released devices, estimated for the rest. A member that is done
             without a release, because its status was final while it
             waited, is in no window. The companion actor computes it from
             the campaign; the transform actuates the same computation, so
             what runs is what is shown. Estimates, not guarantees. In plan,
             it is the plan of the run as it would go on now; before the
             first run, of a run that starts now.
             Held members, such as the members that have not answered the
             campaign's target, upgrade-needed or a final status, get an
             alarm, and device-status says why. A held member shows in the
             window promised to it, or else in the first window of its
             schedule that has not closed. A member that keeps a promise
             but that the plan starts in no window shows in the window
             promised to it too, and the alarm that it will miss that
             window names it. With allow-staging, each member's
             prepare-start says when it prepares. After a restart of
             fleetmgr, a member that the campaign has freed is in no
             window.";
          uses plan-layout;
          leaf prepare-concurrency {
            description
              "The most members that prepare at once, as prepare-bandwidth
               counts the prepares. Absent when no member prepares.";
            type uint32;
            units "devices";
          }
          leaf prepare-before-first-window {
            description
              "Whether the members may prepare before the campaign's first
               window opens. Absent without allow-staging.";
            type boolean;
          }
          leaf prepare-between-windows {
            description
              "Whether the members may prepare between windows: the
               campaign's prepare-between-windows, or when it is absent,
               whether a member is let prepare, or was in the run, between
               windows, or has its turn there. Absent without
               allow-staging.";
            type boolean;
          }
          leaf prepare-during-windows {
            description
              "Whether the members may prepare while a window of the
               campaign is open. Absent without allow-staging.";
            type boolean;
          }
          leaf prepare-max-bandwidth {
            description
              "The most bandwidth that the members use together to prepare:
               the campaign's prepare-max-bandwidth, or else that of the
               image list. Absent without allow-staging.";
            type uint64;
            units "bits/second";
          }
          leaf prepare-peak-bandwidth {
            description
              "The most bandwidth of prepare-bandwidth. Absent when the
               prepares use no bandwidth.";
            type uint64;
            units "bits/second";
          }
          list prepare-bandwidth {
            key time;
            description
              "The bandwidth that the members use to prepare, over time:
               from each time on until the next, the sum of the bandwidths
               of the prepares that run, the prepares that run now included.
               A prepare runs for its expected prepare time from when its
               member is let: its prepare-start, or when it is let again
               after it had not begun, and not before now while it has not
               begun. It uses the size of its image divided by its expected
               prepare time, and none when the image has no size. The list
               has at most 1000 entries. When the bandwidth changes more
               often, the time from the first change to the last is cut into
               equal stretches, and each entry gives the most bandwidth that
               its stretch reaches.";
            leaf time {
              description "Seconds since the Unix epoch.";
              type uint64;
              units "seconds";
            }
            leaf bandwidth {
              type uint64;
              units "bits/second";
            }
          }
        }
        list device-status {
          key device;
          description
            "The attempt that counts for the member, as its device reports
             it: the attempt that is in-progress, when the device runs one
             at the campaign's target, and else the member's attempt. status
             is pending when the device has not answered that attempt. Of
             the statuses, only upgrade-needed and the final ones answer the
             campaign's target; a member that shows unknown or pending has
             not answered, and the plan holds it. A member that the campaign
             has freed shows its result: attempt, status, stage and reason,
             with freed and finished. It shows nothing that its device
             reports.";
          leaf device {
            type string;
          }
          leaf attempt {
            description
              "The attempt that status is for.";
            type uint32;
          }
          uses fleetmgr-types:attempt-status;
          leaf freed {
            description
              "When the campaign freed the device, as seconds since the Unix
               epoch. Absent while the campaign has not freed it.";
            type uint64;
            units "seconds";
          }
          leaf finished {
            description
              "When a freed member was done, as seconds since the Unix
               epoch.";
            type uint64;
            units "seconds";
          }
          uses fleetmgr-types:vetoes;
          leaf version {
            description "Release the device runs, from its platform.";
            type string;
          }
          leaf model {
            description "Chassis model of the device, from its platform.";
            type string;
          }
          leaf held {
            description
              "Why the member waits and may not start now: the first of
               these reasons that applies to it. Absent when it is not
               held. A held member keeps the window promised to it. When
               that window closes, its promise moves to the next window
               of its schedule, and the plan gives an alarm.";
            type enumeration {
              enum down {
                description "The flotilla is not connected to the device.";
              }
              enum flotilla-down {
                description
                  "The top is not connected to the device's flotilla.
                   held-by names the flotilla.";
              }
              enum not-answered {
                description "It has not answered the campaign's target.";
              }
              enum vetoed {
                description
                  "Its device has a veto of another holder than the
                   campaign, which holds the install. held-by names the
                   holder.";
              }
              enum group-failed {
                description
                  "It waits behind a member of its redundancy groups that
                   failed. held-by names that member.";
              }
              enum group-down {
                description
                  "It waits behind a member of its redundancy groups that
                   is down. held-by names that member.";
              }
              enum group-not-answered {
                description
                  "It waits behind a member of its redundancy groups that
                   has not answered. held-by names that member.";
              }
              enum group-vetoed {
                description
                  "It waits behind a member of its redundancy groups that
                   is vetoed. held-by names that member.";
              }
              enum failure-budget {
                description
                  "More members have failed than the failure budget.";
              }
            }
          }
          leaf held-by {
            description
              "The device or the flotilla that holds the member, when
               another one does, or the holder of the veto that holds it.
               When several hold it, one of them.";
            type string;
          }
        }
      }
    }
  }
}
"""

SRC_YANG_3: str = r"""module fleetmgr-types {
  yang-version "1.1";
  namespace "urn:fleetmgr:types";
  prefix fleetmgr-types;

  import ietf-inet-types {
    prefix inet;
  }
  import stratoweave-ssh {
    prefix sw-ssh;
  }

  grouping device-options {
    leaf description {
      type string;
    }

    list address {
      key name;
      leaf name {
        description "Name of address, e.g. 'loopback' or 'OOB'";
        type string;
      }
      leaf address {
        type inet:host;
        mandatory true;
      }
      leaf port {
        type uint16;
      }
      list initial-credentials {
        key "username password key";
        leaf username {
          type string;
        }
        leaf password {
          type string;
        }
        leaf key {
          type string;
        }
      }
    }

    container credentials {
      leaf username {
        type string;
        mandatory true;
      }
      leaf password {
        type string;
      }
      list key {
        key key;
        leaf key {
          type string;
        }
        leaf private-key {
          type string;
        }
      }
    }

    list initial-credentials {
      key "username password key";
      leaf username {
        type string;
      }
      leaf password {
        type string;
      }
      leaf key {
        type string;
      }
    }

    list extra-adapter {
      key type;
      ordered-by user;
      description
        "Adapters that run beside the adapter of the device type, for the
         modules that adapter does not have, such as iosxe-cli beside the
         NETCONF adapter of an IOS XE device. Passed to the device as its
         extra-adapter list.";
      leaf type {
        description "Device type of the adapter.";
        type string;
      }
      leaf address {
        description "The address to connect to. Default: the first.";
        type leafref {
          path "../../address/name";
        }
      }
      leaf port {
        description
          "Port to connect to. Default: the adapter's own. The port of the
           address is for the adapter of the device type.";
        type uint16;
      }
      container credentials {
        presence "Use these credentials instead of the device's.";
        leaf username {
          type string;
          mandatory true;
        }
        leaf password {
          type string;
        }
        list key {
          key key;
          leaf key {
            type string;
          }
          leaf private-key {
            type string;
          }
        }
      }
      container ssh {
        presence "Use these SSH settings instead of the device's.";
        uses sw-ssh:ssh-client-config;
      }
    }

    container ssh {
      description
        "SSH transport parameters used when connecting to this device. Applies
         to every SSH-based adapter (NETCONF over SSH, CLI, ...), except an
         extra adapter that has its own.";
      uses sw-ssh:ssh-client-config;
    }

    leaf approval-required {
      description "Require approval of each individual configuration change to this device";
      type boolean;
      default "false";
    }

    leaf sync-check {
      type boolean;
      default true;
      description
        "Check that the device configuration is in sync before applying edits.";
    }

    container mock {
      leaf enabled {
        type boolean;
        default "false";
      }
      container software {
        description
          "How the mock behaves during a software upgrade.";
        leaf upgrade-duration {
          description
            "Seconds a whole mock software upgrade takes, spread over its
             operations as measured on a real device. Absent or 0 completes
             each operation at once.";
          units "seconds";
          type uint16;
        }
        leaf upgrade-duration-variance {
          description
            "How much the duration of each mock software upgrade varies, as
             a percentage of upgrade-duration in either direction. Each
             upgrade draws its duration evenly between upgrade-duration
             x (1 - v/100) and upgrade-duration x (1 + v/100) when it
             starts. 0 makes every upgrade take exactly upgrade-duration.";
          units "percent";
          type uint8 {
            range "0..100";
          }
          default 20;
        }
        leaf failure {
          description
            "IOS XE failure the mock reproduces during an upgrade.";
          type enumeration {
            enum none;
            enum download-failed {
              description "The download fails after xcopy was accepted.";
            }
            enum add-failed {
              description "The verify stage fails after install add was accepted.";
            }
            enum activate-refused {
              description "activate is rejected, as when the image was not added.";
            }
            enum commit-failed {
              description "The commit stage fails after install-commit was accepted.";
            }
            enum reverts {
              description "The abort timer runs out before the commit.";
            }
            enum bgp-down {
              description "The BGP session is idle from the start.";
            }
            enum bgp-lost {
              description
                "The BGP session is idle while the activated release runs,
                 until a commit or an abort.";
            }
            enum interface-lost {
              description
                "Interfaces that were up have their line protocol down
                 while the activated release runs, until a commit or an
                 abort.";
            }
            enum ospf-lost {
              description
                "An OSPF neighbor is stuck in init while the activated
                 release runs, until a commit or an abort.";
            }
          }
          default "none";
        }
      }
      container platform {
        description
          "The platform the mock reports.";
        leaf version {
          description
            "Release the mock runs before any upgrade; an install changes it.
             Absent means 17.18.02.";
          type string;
        }
        leaf model {
          description
            "Chassis product id. Absent means C8000V.";
          type string;
        }
        leaf serial-number {
          description
            "Chassis serial number. Absent means 9ABCDEFGHIJ.";
          type string;
        }
      }
      list module {
        key "name";
        leaf name {
          type string;
        }
        leaf namespace {
          type string;
          mandatory true;
        }
        leaf revision {
          type string;
        }
        leaf-list feature {
          type string;
        }
      }
    }

    container debug {
      leaf connection {
        type boolean;
        default "false";
      }
      leaf log-level {
        description
          "Log level for this device's log file.";
        type enumeration {
          enum off;
          enum error;
          enum warning;
          enum info;
          enum debug;
          enum trace;
        }
      }
    }

    container feature-flags {
      leaf runtime-schema-fetch {
        type boolean;
        default false;
      }
    }
  }

  grouping upgrade-checks {
    container upgrade-checks {
      description
        "How long the flotilla's upgrade checks, bgp, interfaces and ospf,
         wait before they refuse. An absent leaf keeps the flotilla's
         default, 45 s before the install and 600 s after it.";
      leaf enabled {
        description
          "Whether the checks gate the device's upgrade. A device whose BGP
           state, interfaces or OSPF state no adapter reads fails the
           pre-check unless they are off.";
        type boolean;
        default "true";
      }
      leaf precheck-wait {
        units "seconds";
        type uint16 {
          range "1..max";
        }
      }
      leaf postcheck-wait {
        units "seconds";
        type uint16 {
          range "1..max";
        }
      }
    }
  }

  grouping software-options {
    container software {
      leaf upgrade-campaign {
        description
          "The campaign that has acquired this device. One campaign at most
           acquires a device: an edit that gives it a second campaign
           fails. A campaign that frees the device removes this leaf.";
        type string;
      }
      leaf target-release {
        type string;
      }
      leaf attempt {
        description
          "The attempt of the intent: a new value makes the device read its
           release again and run a failed upgrade again.";
        type uint32;
        default "0";
      }
      leaf prepare-attempt {
        description
          "The prepare attempt of the intent: a new value makes the device
           prepare its target again.";
        type uint32;
        default "0";
      }
      leaf image-url {
        type string;
      }
      list image-checksum {
        key algorithm;
        leaf algorithm {
          type enumeration {
            enum md5;
            enum sha256;
            enum sha512;
          }
        }
        leaf digest {
          type string {
            pattern '[0-9a-fA-F]+';
          }
          mandatory true;
        }
      }
      leaf image-size {
        type uint64;
        units "bytes";
      }
      leaf allow-staging {
        description
          "Whether the device may prepare its target release while a veto
           holds the install. Its campaign sets it from the device's turn
           to prepare until the prepare ends, the device is released, or a
           window of its schedule opens.";
        type boolean;
        default "false";
      }
      leaf image-locked {
        description
          "Whether the campaign has let the device prepare or released it,
           so that it keeps the device's image. Only the campaign reads it.";
        type boolean;
        default "false";
      }
      leaf attempt-failed {
        description
          "Whether the attempt of the device failed, so that the campaign
           may give it a new attempt. Only the campaign reads it.";
        type boolean;
        default "false";
      }
      list veto {
        key holder;
        leaf holder {
          type string;
        }
        leaf reason {
          type string;
        }
      }
    }
  }

  grouping check-result {
    description
      "A software upgrade check verdict as the device reports it, relayed as
       strings like the status: verdict is not-run, pass or fail, and at is
       when it was reached.";
    leaf verdict {
      type string;
    }
    leaf detail {
      type string;
    }
    leaf at {
      type string;
    }
  }

  grouping platform {
    description
      "What a device is, as its flotilla reads it when the device connects.";
    leaf os {
      type string;
    }
    leaf version {
      type string;
    }
    leaf model {
      type string;
    }
    leaf serial-number {
      type string;
    }
    leaf last-boot {
      description
        "When the device last booted, as seconds since the Unix epoch by the
         device's clock, or by StratoWeave's clock when the device reports
         only how long it has been up. Absent when the device does not
         report it.";
      type uint64;
      units "seconds";
    }
  }

  grouping attempt-status {
    description
      "One attempt of a device's software upgrade as the flotilla reports
       it.";
    leaf status {
      type string;
    }
    leaf stage {
      description
        "The step the attempt's run is in, or the step it ended in:
         prepare, precheck, install, postcheck, commit or rollback.";
      type string;
    }
    leaf reason {
      description
        "Why the attempt's run failed or rolled back, as the device's
         software manager reports it.";
      type string;
    }
    container prepare {
      description
        "The device's prepare of its image, from the attempt's
         job[prepare], as its flotilla reports it: state is running, done,
         retrying or failed, release is the release it copies or copied,
         prepare-attempt is the prepare-attempt it ran for, and message
         says why it failed. The attempt's run fills the same entry.";
      leaf state {
        type string;
      }
      leaf release {
        type string;
      }
      leaf prepare-attempt {
        type uint32;
      }
      leaf started {
        type string;
      }
      leaf ended {
        type string;
      }
      leaf message {
        type string;
      }
      leaf progress {
        description
          "How far the prepare is while it runs, as the device's software
           manager reports it: the part of the image that the device has
           transferred.";
        units "percent";
        type uint8 {
          range "0..100";
        }
      }
    }
    container install {
      description
        "The device's install of its target, from the attempt's
         job[install], as its flotilla reports it: state is running, done
         or failed, and release is the release it installs or installed.
         While it runs, message
         says what the device does, e.g. 'add: extract' or 'waiting for the
         device to boot'; when it failed, why; after it, until the commit
         or the rollback, when the commit window ends.";
      leaf state {
        type string;
      }
      leaf release {
        type string;
      }
      leaf started {
        type string;
      }
      leaf ended {
        type string;
      }
      leaf message {
        type string;
      }
    }
    container precheck {
      uses check-result;
    }
    container postcheck {
      uses check-result;
    }
  }

  grouping vetoes {
    list veto {
      description
        "The vetoes that hold the device's install, by holder, as its
         software manager reports them.";
      key holder;
      leaf holder {
        type string;
      }
      leaf reason {
        type string;
      }
    }
  }

  grouping upgrade-status {
    description
      "A device's software upgrade state as the flotilla reports it.";
    leaf upgrade-campaign {
      description
        "The upgrade campaign of the attempts, as the device reports it.";
      type string;
    }
    leaf target-release {
      description
        "The target release of the attempts.";
      type string;
    }
    list attempt {
      description
        "The device's attempts at target-release in upgrade-campaign.";
      key number;
      leaf number {
        type uint32;
      }
      uses attempt-status;
    }
    uses vetoes;
  }
}
"""

SRC_YANG_4: str = r"""module stratoweave {
  yang-version "1.1";
  namespace "http://stratoweave.org/yang/stratoweave";
  prefix "sw";

  description
    "This module defines Stratoweave YANG extensions.";

  revision 2026-04-01;

  extension device {
    description
      "Used internally in the list defining the device manager model.";
  }
  extension device-config {
    description
      "Used internally in the list defining the device configuration store.";
  }
  extension transform {
    description
      "Used in a list or container defining a transform model. Takes as an
      argument the fully qualified name of the type implementing the transform
      function in user code. Makes the code generator create the base type in
      app.layers.base_X.";
    argument "function";
  }
  extension rfs-transform {
    description
      "Used in a list or container defining an RFS transform model. Takes as an
      argument the fully qualified name of the type implementing the RFS
      transform function in user code. Makes the code generator create the base
      type in app.layers.base_X.";
    argument "function";
  }
  extension dynstate {
    description
      "Used in the dynstate container of a transform model. Enriches the
      transform function inputs with an additional read-only structure. This
      subtree is accessible for writes to the transform actor for async
      (environmental) updates.";
  }
  extension memory {
    description
      "Used in the memory container of a transform model. Enriches the transform
      function inputs with an additional read-only structure. The transform
      function may update this subtree by returning new data.";
  }
  extension link {
    description
      "Declares a link demand from this transform towards another (linked)
      transform. The argument is a tag that identifies the link. On a leafref
      leaf, the link target is derived from the leafref path. On other nodes,
      a nested sw:path substatement provides the target path.";
    argument "tag";
  }
  extension path {
    description
      "Substatement of sw:link that provides an explicit absolute schema path
      to the linked transform target.";
    argument "path";
  }
  extension direct-output {
    description
      "Substatement of sw:transform that enables a transform to generate output
      whenever it chooses, wrapped in a transaction of its own.";
  }
}"""

SRC_YANG_5: str = r"""module stratoweave-ssh {
  yang-version "1.1";
  namespace "http://stratoweave.org/yang/stratoweave-ssh";
  prefix "sw-ssh";

  description "Reusable SSH client transport types and groupings.";

  typedef ssh-cipher {
    type enumeration {
      enum "chacha20-poly1305@openssh.com";
      enum "aes256-gcm@openssh.com";
      enum "aes128-gcm@openssh.com";
      enum "aes256-ctr";
      enum "aes192-ctr";
      enum "aes128-ctr";
      enum "aes256-cbc";
      enum "aes192-cbc";
      enum "aes128-cbc";
      enum "3des-cbc";
      enum "none";
    }
    description
      "Symmetric cipher, as negotiated in the SSH transport protocol.";
  }

  typedef ssh-mac {
    type enumeration {
      enum "hmac-sha2-256-etm@openssh.com";
      enum "hmac-sha2-512-etm@openssh.com";
      enum "hmac-sha1-etm@openssh.com";
      enum "hmac-sha2-256";
      enum "hmac-sha2-512";
      enum "hmac-sha1";
      enum "none";
    }
    description
      "Message authentication code, as negotiated in the SSH transport
     protocol. Not used with AEAD ciphers, which authenticate themselves.";
  }

  typedef ssh-key-exchange {
    type enumeration {
      enum "diffie-hellman-group-exchange-sha1";
      enum "mlkem768x25519-sha256";
      enum "mlkem768nistp256-sha256";
      enum "sntrup761x25519-sha512";
      enum "sntrup761x25519-sha512@openssh.com";
      enum "curve25519-sha256";
      enum "curve25519-sha256@libssh.org";
      enum "ecdh-sha2-nistp256";
      enum "ecdh-sha2-nistp384";
      enum "ecdh-sha2-nistp521";
      enum "diffie-hellman-group18-sha512";
      enum "diffie-hellman-group16-sha512";
      enum "diffie-hellman-group-exchange-sha256";
      enum "diffie-hellman-group14-sha256";
      enum "diffie-hellman-group14-sha1";
      enum "diffie-hellman-group1-sha1";
    }
    description
      "Key exchange algorithm, as negotiated in the SSH transport protocol.";
  }

  typedef ssh-host-key-algorithm {
    type enumeration {
      enum "ssh-ed25519-cert-v01@openssh.com";
      enum "sk-ssh-ed25519-cert-v01@openssh.com";
      enum "ecdsa-sha2-nistp521-cert-v01@openssh.com";
      enum "ecdsa-sha2-nistp384-cert-v01@openssh.com";
      enum "ecdsa-sha2-nistp256-cert-v01@openssh.com";
      enum "sk-ecdsa-sha2-nistp256-cert-v01@openssh.com";
      enum "rsa-sha2-512-cert-v01@openssh.com";
      enum "rsa-sha2-256-cert-v01@openssh.com";
      enum "ssh-rsa-cert-v01@openssh.com";
      enum "ssh-ed25519";
      enum "ecdsa-sha2-nistp521";
      enum "ecdsa-sha2-nistp384";
      enum "ecdsa-sha2-nistp256";
      enum "sk-ssh-ed25519@openssh.com";
      enum "sk-ecdsa-sha2-nistp256@openssh.com";
      enum "rsa-sha2-512";
      enum "rsa-sha2-256";
      enum "ssh-rsa";
    }
    description
      "Server host key algorithm, i.e. the key type we are willing to accept
     from the far end and verify the session signature with.";
  }

  typedef ssh-public-key-algorithm {
    type enumeration {
      enum "ssh-ed25519-cert-v01@openssh.com";
      enum "sk-ssh-ed25519-cert-v01@openssh.com";
      enum "ecdsa-sha2-nistp521-cert-v01@openssh.com";
      enum "ecdsa-sha2-nistp384-cert-v01@openssh.com";
      enum "ecdsa-sha2-nistp256-cert-v01@openssh.com";
      enum "sk-ecdsa-sha2-nistp256-cert-v01@openssh.com";
      enum "rsa-sha2-512-cert-v01@openssh.com";
      enum "rsa-sha2-256-cert-v01@openssh.com";
      enum "ssh-rsa-cert-v01@openssh.com";
      enum "ssh-ed25519";
      enum "ecdsa-sha2-nistp521";
      enum "ecdsa-sha2-nistp384";
      enum "ecdsa-sha2-nistp256";
      enum "sk-ssh-ed25519@openssh.com";
      enum "sk-ecdsa-sha2-nistp256@openssh.com";
      enum "rsa-sha2-512";
      enum "rsa-sha2-256";
      enum "ssh-rsa";
    }
    description
      "Public key algorithm offered during publickey authentication.";
  }

  typedef ssh-compression-algorithm {
    type enumeration {
      enum "none";
      enum "zlib@openssh.com";
      enum "zlib";
    }
    description
      "Transport compression algorithm.";
  }

  grouping ssh-client-config {
    description
      "SSH client transport parameters, shared by every adapter that talks to
       a device over SSH (NETCONF, CLI, ...). Each algorithm leaf-list is the
       ordered preference list sent in the SSH key exchange; leaving one empty
       means the SSH library picks its own default set.";

    leaf-list cipher {
      description
        "Symmetric ciphers to offer, most preferred first.";
      type sw-ssh:ssh-cipher;
      ordered-by user;
    }

    leaf-list mac {
      description
        "MAC algorithms to offer, most preferred first.";
      type sw-ssh:ssh-mac;
      ordered-by user;
    }

    leaf-list key-exchange {
      description
        "Key exchange algorithms to offer, most preferred first.";
      type sw-ssh:ssh-key-exchange;
      ordered-by user;
    }

    leaf-list host-key-algorithm {
      description
        "Server host key algorithms to accept, most preferred first. This is
         what decides which host key type the device presents.";
      type sw-ssh:ssh-host-key-algorithm;
      ordered-by user;
    }

    leaf-list public-key-algorithm {
      description
        "Public key algorithms to offer for publickey authentication, most
         preferred first.";
      type sw-ssh:ssh-public-key-algorithm;
      ordered-by user;
    }

    leaf-list compression-algorithm {
      description
        "Compression algorithms to offer, most preferred first. 'none' first
         disables compression against peers that also offer it.";
      type sw-ssh:ssh-compression-algorithm;
      ordered-by user;
    }

    leaf compression-level {
      description
        "zlib compression level, 1 (fastest) to 9 (smallest). Only relevant
         when a zlib compression algorithm is negotiated.";
      type uint8 {
        range "1..9";
      }
      default 7;
    }

    leaf rekey-after-bytes {
      description
        "Rekey after this many bytes have passed over the session. Absent
         means the RFC 4344 volume limit of the negotiated cipher. A value
         can only lower that limit, never raise it.";
      type uint64;
    }

    leaf rekey-after-seconds {
      description
        "Rekey after this many seconds. Absent disables time-based rekeying.";
      type uint32 {
        range "0..4294967";
      }
    }

    leaf minimum-rsa-bits {
      description
        "Reject RSA host and public keys shorter than this.";
      type uint32 {
        range "1024..2147483647";
      }
      default 1024;
    }
  }
}"""

SRC_YANG_6: str = r"""module ietf-inet-types {

  namespace "urn:ietf:params:xml:ns:yang:ietf-inet-types";
  prefix "inet";

  organization
   "IETF NETMOD (NETCONF Data Modeling Language) Working Group";

  contact
   "WG Web:   <http://tools.ietf.org/wg/netmod/>
    WG List:  <mailto:netmod@ietf.org>

    WG Chair: David Kessens
              <mailto:david.kessens@nsn.com>

    WG Chair: Juergen Schoenwaelder
              <mailto:j.schoenwaelder@jacobs-university.de>

    Editor:   Juergen Schoenwaelder
              <mailto:j.schoenwaelder@jacobs-university.de>";

  description
   "This module contains a collection of generally useful derived
    YANG data types for Internet addresses and related things.

    Copyright (c) 2013 IETF Trust and the persons identified as
    authors of the code.  All rights reserved.

    Redistribution and use in source and binary forms, with or
    without modification, is permitted pursuant to, and subject
    to the license terms contained in, the Simplified BSD License
    set forth in Section 4.c of the IETF Trust's Legal Provisions
    Relating to IETF Documents
    (http://trustee.ietf.org/license-info).

    This version of this YANG module is part of RFC 6991; see
    the RFC itself for full legal notices.";

  revision 2013-07-15 {
    description
     "This revision adds the following new data types:
      - ip-address-no-zone
      - ipv4-address-no-zone
      - ipv6-address-no-zone";
    reference
     "RFC 6991: Common YANG Data Types";
  }

  revision 2010-09-24 {
    description
     "Initial revision.";
    reference
     "RFC 6021: Common YANG Data Types";
  }

  /*** collection of types related to protocol fields ***/

  typedef ip-version {
    type enumeration {
      enum unknown {
        value "0";
        description
         "An unknown or unspecified version of the Internet
          protocol.";
      }
      enum ipv4 {
        value "1";
        description
         "The IPv4 protocol as defined in RFC 791.";
      }
      enum ipv6 {
        value "2";
        description
         "The IPv6 protocol as defined in RFC 2460.";
      }
    }
    description
     "This value represents the version of the IP protocol.

      In the value set and its semantics, this type is equivalent
      to the InetVersion textual convention of the SMIv2.";
    reference
     "RFC  791: Internet Protocol
      RFC 2460: Internet Protocol, Version 6 (IPv6) Specification
      RFC 4001: Textual Conventions for Internet Network Addresses";
  }

  typedef dscp {
    type uint8 {
      range "0..63";
    }
    description
     "The dscp type represents a Differentiated Services Code Point
      that may be used for marking packets in a traffic stream.
      In the value set and its semantics, this type is equivalent
      to the Dscp textual convention of the SMIv2.";
    reference
     "RFC 3289: Management Information Base for the Differentiated
                Services Architecture
      RFC 2474: Definition of the Differentiated Services Field
                (DS Field) in the IPv4 and IPv6 Headers
      RFC 2780: IANA Allocation Guidelines For Values In
                the Internet Protocol and Related Headers";
  }

  typedef ipv6-flow-label {
    type uint32 {
      range "0..1048575";
    }
    description
     "The ipv6-flow-label type represents the flow identifier or Flow
      Label in an IPv6 packet header that may be used to
      discriminate traffic flows.

      In the value set and its semantics, this type is equivalent
      to the IPv6FlowLabel textual convention of the SMIv2.";
    reference
     "RFC 3595: Textual Conventions for IPv6 Flow Label
      RFC 2460: Internet Protocol, Version 6 (IPv6) Specification";
  }

  typedef port-number {
    type uint16 {
      range "0..65535";
    }
    description
     "The port-number type represents a 16-bit port number of an
      Internet transport-layer protocol such as UDP, TCP, DCCP, or
      SCTP.  Port numbers are assigned by IANA.  A current list of
      all assignments is available from <http://www.iana.org/>.

      Note that the port number value zero is reserved by IANA.  In
      situations where the value zero does not make sense, it can
      be excluded by subtyping the port-number type.
      In the value set and its semantics, this type is equivalent
      to the InetPortNumber textual convention of the SMIv2.";
    reference
     "RFC  768: User Datagram Protocol
      RFC  793: Transmission Control Protocol
      RFC 4960: Stream Control Transmission Protocol
      RFC 4340: Datagram Congestion Control Protocol (DCCP)
      RFC 4001: Textual Conventions for Internet Network Addresses";
  }

  /*** collection of types related to autonomous systems ***/

  typedef as-number {
    type uint32;
    description
     "The as-number type represents autonomous system numbers
      which identify an Autonomous System (AS).  An AS is a set
      of routers under a single technical administration, using
      an interior gateway protocol and common metrics to route
      packets within the AS, and using an exterior gateway
      protocol to route packets to other ASes.  IANA maintains
      the AS number space and has delegated large parts to the
      regional registries.

      Autonomous system numbers were originally limited to 16
      bits.  BGP extensions have enlarged the autonomous system
      number space to 32 bits.  This type therefore uses an uint32
      base type without a range restriction in order to support
      a larger autonomous system number space.

      In the value set and its semantics, this type is equivalent
      to the InetAutonomousSystemNumber textual convention of
      the SMIv2.";
    reference
     "RFC 1930: Guidelines for creation, selection, and registration
                of an Autonomous System (AS)
      RFC 4271: A Border Gateway Protocol 4 (BGP-4)
      RFC 4001: Textual Conventions for Internet Network Addresses
      RFC 6793: BGP Support for Four-Octet Autonomous System (AS)
                Number Space";
  }

  /*** collection of types related to IP addresses and hostnames ***/

  typedef ip-address {
    type union {
      type inet:ipv4-address;
      type inet:ipv6-address;
    }
    description
     "The ip-address type represents an IP address and is IP
      version neutral.  The format of the textual representation
      implies the IP version.  This type supports scoped addresses
      by allowing zone identifiers in the address format.";
    reference
     "RFC 4007: IPv6 Scoped Address Architecture";
  }

  typedef ipv4-address {
    type string {
      pattern
        '(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}'
      +  '([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
      + '(%[\p{N}\p{L}]+)?';
    }
    description
      "The ipv4-address type represents an IPv4 address in
       dotted-quad notation.  The IPv4 address may include a zone
       index, separated by a % sign.

       The zone index is used to disambiguate identical address
       values.  For link-local addresses, the zone index will
       typically be the interface index number or the name of an
       interface.  If the zone index is not present, the default
       zone of the device will be used.

       The canonical format for the zone index is the numerical
       format";
  }

  typedef ipv6-address {
    type string {
      pattern '((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}'
            + '((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|'
            + '(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}'
            + '(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))'
            + '(%[\p{N}\p{L}]+)?';
      pattern '(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|'
            + '((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)'
            + '(%.+)?';
    }
    description
     "The ipv6-address type represents an IPv6 address in full,
      mixed, shortened, and shortened-mixed notation.  The IPv6
      address may include a zone index, separated by a % sign.

      The zone index is used to disambiguate identical address
      values.  For link-local addresses, the zone index will
      typically be the interface index number or the name of an
      interface.  If the zone index is not present, the default
      zone of the device will be used.

      The canonical format of IPv6 addresses uses the textual
      representation defined in Section 4 of RFC 5952.  The
      canonical format for the zone index is the numerical
      format as described in Section 11.2 of RFC 4007.";
    reference
     "RFC 4291: IP Version 6 Addressing Architecture
      RFC 4007: IPv6 Scoped Address Architecture
      RFC 5952: A Recommendation for IPv6 Address Text
                Representation";
  }

  typedef ip-address-no-zone {
    type union {
      type inet:ipv4-address-no-zone;
      type inet:ipv6-address-no-zone;
    }
    description
     "The ip-address-no-zone type represents an IP address and is
      IP version neutral.  The format of the textual representation
      implies the IP version.  This type does not support scoped
      addresses since it does not allow zone identifiers in the
      address format.";
    reference
     "RFC 4007: IPv6 Scoped Address Architecture";
  }

  typedef ipv4-address-no-zone {
    type inet:ipv4-address {
      pattern '[0-9\.]*';
    }
    description
      "An IPv4 address without a zone index.  This type, derived from
       ipv4-address, may be used in situations where the zone is
       known from the context and hence no zone index is needed.";
  }

  typedef ipv6-address-no-zone {
    type inet:ipv6-address {
      pattern '[0-9a-fA-F:\.]*';
    }
    description
      "An IPv6 address without a zone index.  This type, derived from
       ipv6-address, may be used in situations where the zone is
       known from the context and hence no zone index is needed.";
    reference
     "RFC 4291: IP Version 6 Addressing Architecture
      RFC 4007: IPv6 Scoped Address Architecture
      RFC 5952: A Recommendation for IPv6 Address Text
                Representation";
  }

  typedef ip-prefix {
    type union {
      type inet:ipv4-prefix;
      type inet:ipv6-prefix;
    }
    description
     "The ip-prefix type represents an IP prefix and is IP
      version neutral.  The format of the textual representations
      implies the IP version.";
  }

  typedef ipv4-prefix {
    type string {
      pattern
         '(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}'
       +  '([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
       + '/(([0-9])|([1-2][0-9])|(3[0-2]))';
    }
    description
     "The ipv4-prefix type represents an IPv4 address prefix.
      The prefix length is given by the number following the
      slash character and must be less than or equal to 32.

      A prefix length value of n corresponds to an IP address
      mask that has n contiguous 1-bits from the most
      significant bit (MSB) and all other bits set to 0.

      The canonical format of an IPv4 prefix has all bits of
      the IPv4 address set to zero that are not part of the
      IPv4 prefix.";
  }

  typedef ipv6-prefix {
    type string {
      pattern '((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}'
            + '((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|'
            + '(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}'
            + '(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))'
            + '(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))';
      pattern '(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|'
            + '((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)'
            + '(/.+)';
    }

    description
     "The ipv6-prefix type represents an IPv6 address prefix.
      The prefix length is given by the number following the
      slash character and must be less than or equal to 128.

      A prefix length value of n corresponds to an IP address
      mask that has n contiguous 1-bits from the most
      significant bit (MSB) and all other bits set to 0.

      The IPv6 address should have all bits that do not belong
      to the prefix set to zero.

      The canonical format of an IPv6 prefix has all bits of
      the IPv6 address set to zero that are not part of the
      IPv6 prefix.  Furthermore, the IPv6 address is represented
      as defined in Section 4 of RFC 5952.";
    reference
     "RFC 5952: A Recommendation for IPv6 Address Text
                Representation";
  }

  /*** collection of domain name and URI types ***/

  typedef domain-name {
    type string {
      pattern
        '((([a-zA-Z0-9_]([a-zA-Z0-9\-_]){0,61})?[a-zA-Z0-9]\.)*'
      + '([a-zA-Z0-9_]([a-zA-Z0-9\-_]){0,61})?[a-zA-Z0-9]\.?)'
      + '|\.';
      length "1..253";
    }
    description
     "The domain-name type represents a DNS domain name.  The
      name SHOULD be fully qualified whenever possible.

      Internet domain names are only loosely specified.  Section
      3.5 of RFC 1034 recommends a syntax (modified in Section
      2.1 of RFC 1123).  The pattern above is intended to allow
      for current practice in domain name use, and some possible
      future expansion.  It is designed to hold various types of
      domain names, including names used for A or AAAA records
      (host names) and other records, such as SRV records.  Note
      that Internet host names have a stricter syntax (described
      in RFC 952) than the DNS recommendations in RFCs 1034 and
      1123, and that systems that want to store host names in
      schema nodes using the domain-name type are recommended to
      adhere to this stricter standard to ensure interoperability.

      The encoding of DNS names in the DNS protocol is limited
      to 255 characters.  Since the encoding consists of labels
      prefixed by a length bytes and there is a trailing NULL
      byte, only 253 characters can appear in the textual dotted
      notation.

      The description clause of schema nodes using the domain-name
      type MUST describe when and how these names are resolved to
      IP addresses.  Note that the resolution of a domain-name value
      may require to query multiple DNS records (e.g., A for IPv4
      and AAAA for IPv6).  The order of the resolution process and
      which DNS record takes precedence can either be defined
      explicitly or may depend on the configuration of the
      resolver.

      Domain-name values use the US-ASCII encoding.  Their canonical
      format uses lowercase US-ASCII characters.  Internationalized
      domain names MUST be A-labels as per RFC 5890.";
    reference
     "RFC  952: DoD Internet Host Table Specification
      RFC 1034: Domain Names - Concepts and Facilities
      RFC 1123: Requirements for Internet Hosts -- Application
                and Support
      RFC 2782: A DNS RR for specifying the location of services
                (DNS SRV)
      RFC 5890: Internationalized Domain Names in Applications
                (IDNA): Definitions and Document Framework";
  }

  typedef host {
    type union {
      type inet:ip-address;
      type inet:domain-name;
    }
    description
     "The host type represents either an IP address or a DNS
      domain name.";
  }

  typedef uri {
    type string;
    description
     "The uri type represents a Uniform Resource Identifier
      (URI) as defined by STD 66.

      Objects using the uri type MUST be in US-ASCII encoding,
      and MUST be normalized as described by RFC 3986 Sections
      6.2.1, 6.2.2.1, and 6.2.2.2.  All unnecessary
      percent-encoding is removed, and all case-insensitive
      characters are set to lowercase except for hexadecimal
      digits, which are normalized to uppercase as described in
      Section 6.2.2.1.

      The purpose of this normalization is to help provide
      unique URIs.  Note that this normalization is not
      sufficient to provide uniqueness.  Two URIs that are
      textually distinct after this normalization may still be
      equivalent.

      Objects using the uri type may restrict the schemes that
      they permit.  For example, 'data:' and 'urn:' schemes
      might not be appropriate.

      A zero-length URI is not a valid URI.  This can be used to
      express 'URI absent' where required.

      In the value set and its semantics, this type is equivalent
      to the Uri SMIv2 textual convention defined in RFC 5017.";
    reference
     "RFC 3986: Uniform Resource Identifier (URI): Generic Syntax
      RFC 3305: Report from the Joint W3C/IETF URI Planning Interest
                Group: Uniform Resource Identifiers (URIs), URLs,
                and Uniform Resource Names (URNs): Clarifications
                and Recommendations
      RFC 5017: MIB Textual Conventions for Uniform Resource
                Identifiers (URIs)";
  }

}
"""

SRC_YANG_7: str = r"""module stratoweave-images {
  yang-version "1.1";
  namespace "http://stratoweave.org/yang/stratoweave-images";
  prefix "sw-img";
  import stratoweave {
    prefix sw;
  }

  description
    "Software images by name, each with the path of its file in the image
     folder (the software.image_dir setting), where files are uploaded over
     /image-file and can be kept in folders. An application adds this module
     to its top layer to use the list.";

  container images {
    description
      "The container is a transform only so the layer keeps the entries;
       it produces no configuration.";
    sw:transform stratoweave.image_list.ImageList;
    leaf url-base {
      description
        "Where devices fetch images from. A device's image URL is this
         followed by the image's file, e.g. scp://user:password@host:/images/.";
      type string;
    }
    leaf prepare-max-bandwidth {
      description
        "The bandwidth that the image server gives to prepares: the most
         that the devices of one software campaign use together to copy
         their images before their upgrade, when the campaign sets none.";
      type uint64 {
        range "1..max";
      }
      units "bits/second";
      default "1000000000";
    }
    list image {
      key name;
      leaf name {
        description
          "The image's name, e.g. c8000v-universalk9.17.18.03a.SPA.bin.
           Campaigns name the image by it.";
        type string {
          length "1..200";
          pattern '[A-Za-z0-9_\-][A-Za-z0-9._\-]*';
        }
      }
      leaf file {
        description
          "Path of the image's file in the image folder: the folders it is
           in and its file name, joined by '/', e.g.
           iosxe/17.18/c8000v-universalk9.17.18.03a.SPA.bin. Each folder and
           file name is at most 200 characters. Without it, the file is the
           image's name in the image folder itself. Moving the file changes
           only this leaf, so the campaigns that name the image give their
           devices the new URL.";
        type string {
          length "1..400";
          pattern '[A-Za-z0-9_\-][A-Za-z0-9._\-]{0,199}(/[A-Za-z0-9_\-][A-Za-z0-9._\-]{0,199})*';
        }
      }
      leaf os {
        description "Operating system, e.g. IOS XE.";
        type string;
      }
      leaf version {
        description
          "Version the image installs, as devices report it, e.g. 17.18.03a.
           A software campaign that has let a device prepare this image or
           released it keeps the version: an edit that changes or removes
           it, or removes the image, fails.";
        type string;
      }
      leaf-list model {
        description "Hardware models the image is for, as devices report them, e.g. C8000V.";
        type string;
      }
      list checksum {
        description
          "Checksums of the image file, as its vendor publishes them. A device
           checks its copy of the image against one of them.";
        key algorithm;
        leaf algorithm {
          type enumeration {
            enum md5;
            enum sha256;
            enum sha512;
          }
        }
        leaf digest {
          description "The checksum in hexadecimal digits.";
          type string {
            pattern '[0-9a-fA-F]+';
          }
          mandatory true;
        }
      }
      leaf size {
        description
          "The size of the image file. A device that can compute none of the
           checksums compares its copy with this size.";
        type uint64;
        units "bytes";
      }
      leaf family {
        description "Image family, e.g. c8000v-universalk9.";
        type string;
      }
      leaf default {
        description
          "Whether this is the default image of its family. A family has
           at most one default image.";
        type boolean;
        default false;
        must ". = 'false' or ../family" {
          error-message "A default image needs a family.";
        }
        must ". = 'false' or count(../../image[family = current()/../family][default = 'true']) = 1" {
          error-message "A family has at most one default image.";
        }
      }
    }
  }
}
"""

pure def src_yang() -> list[YangSource]:
    return [
        (name='fleetmgr', revision=None, src=SRC_YANG_0),
        (name='maintenance', revision=None, src=SRC_YANG_1),
        (name='software', revision=None, src=SRC_YANG_2),
        (name='fleetmgr-types', revision=None, src=SRC_YANG_3),
        (name='stratoweave', revision='2026-04-01', src=SRC_YANG_4),
        (name='stratoweave-ssh', revision=None, src=SRC_YANG_5),
        (name='ietf-inet-types', revision='2013-07-15', src=SRC_YANG_6),
        (name='stratoweave-images', revision=None, src=SRC_YANG_7),
    ]


NS_stratoweave: str = 'http://stratoweave.org/yang/stratoweave'
NS_stratoweave_images: str = 'http://stratoweave.org/yang/stratoweave-images'
NS_stratoweave_ssh: str = 'http://stratoweave.org/yang/stratoweave-ssh'
