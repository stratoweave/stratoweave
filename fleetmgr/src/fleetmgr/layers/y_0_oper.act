        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='name', config=True, description='The group, as devices name it under redundancy-group.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='name'),
        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='separation-policy', config=True, description='spread: when the plan first gives the members their windows, it\nmoves later members to later windows of the campaign, up to as\nfar apart as those windows allow. A member moves only by trading\nwindows with a device of the same estimate in no group, and only\nwhen no device then misses its window. pack: each member starts\nas soon as the member before it is done.', default='spread', is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'spread':0, 'pack':1}), adata_name='separation_policy'),
        DLeaf(module='fleetmgr', namespace='urn:fleetmgr:fleetmgr', prefix='fleetmgr', name='min-separation', config=True, description='The least time from when one member is done until the next may\nstart, for either policy.', default='0', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint32', description=None, reference=None, units=None, exts=[], builtin_type='uint32', default=None, ranges=Ranges([(0, 4294967295)])), units='seconds', adata_name='min_separation')
    ])
])

