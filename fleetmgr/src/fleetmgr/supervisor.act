import stratoweave.app as swapp

FLOTILLA_COUNT = 10
FLOTILLA_BIN = "out/bin/flotilla"
BASE_HTTP_PORT = 18201
BASE_NETCONF_PORT = 12901
# The user of users.xml, which the top logs in to its flotillas as
FLOTILLA_USER = "admin"
FLOTILLA_PASSWORD = "admin"


def flotilla_command(index: int, image_dir: ?str=None) -> list[str]:
    """Return the command that starts flotilla index. With image_dir, the
    flotilla reads image files from that folder, for its SCP adapters."""
    command = [
        FLOTILLA_BIN,
        "--rts-wthreads", "2",
        "--http.port", str(BASE_HTTP_PORT + index),
        "--netconf.port", str(BASE_NETCONF_PORT + index),
        "--log.dir", "logs/flotilla-{index + 1}",
        # Gives the flotilla FLOTILLA_USER
        "users.xml",
    ]
    if image_dir is not None:
        command.extend(["--software.image-dir", image_dir])
    return command


def argv_image_dir(argv: list[str]) -> ?str:
    """Return the image folder that the command line argv of the top
    names, or None."""
    try:
        return swapp.SystemSettings.parse(argv).software_image_dir
    except Exception:
        return None


actor Supervisor(env, on_ready: action() -> None):
    """Start the ten local flotillas and report when all accept NETCONF.
    Each gets the image folder of the top's command line."""
    var image_dir: ?str = None
    var children: list[Process] = []
    var pending: dict[int, str] = {}
    var ready: set[int] = set()

    def mark_ready(index: int) -> None:
        if index not in ready:
            ready.add(index)
            if index in pending:
                del pending[index]
            print("fleetmgr: flotilla-{index + 1} ready")
            if len(ready) == FLOTILLA_COUNT:
                print("fleetmgr: all {FLOTILLA_COUNT} flotillas ready")
                on_ready()

    def spawn(index: int) -> None:
        pending[index] = ""

        def on_stdout(p: Process, data: ?bytes) -> None:
            if data is not None and index not in ready:
                buf = pending.get_def(index, "") + data.decode()
                if "NETCONF server listening" in buf:
                    mark_ready(index)
                else:
                    pending[index] = buf[-4096:]

        def on_stderr(p: Process, data: ?bytes) -> None:
            if data is not None:
                print("flotilla-{index + 1}: {data.decode()}", err=True)

        def on_exit(p: Process, exit_code: int, signal: int) -> None:
            print(
                "fleetmgr: flotilla-{index + 1} exited "
                + "code={exit_code} signal={signal}",
                err=True,
            )

        def on_error(p: Process, error: str) -> None:
            print("fleetmgr: flotilla-{index + 1} error: {error}", err=True)

        children.append(env.process.spawn(
            flotilla_command(index, image_dir),
            on_stdout,
            on_stderr,
            on_exit,
            on_error,
        ))

    def __startup__():
        image_dir = argv_image_dir(env.argv)
        for index in range(FLOTILLA_COUNT):
            spawn(index)
