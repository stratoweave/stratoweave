import testing

import fleetmgr.webui_assets as webui_assets
import stratoweave.static_assets as swstatic


# The router matches the raw, still percent-encoded request path, so a file
# whose name a URL must encode is never served.
_URL_SAFE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/-"


def _url_safe(path: str) -> bool:
    return all([ch in _URL_SAFE for ch in path])


def _app_paths(html: str) -> list[str]:
    """The quoted /_app/ paths in html"""
    paths = []
    start = html.find('"/_app/')
    while start >= 0:
        end = html.find('"', start + 1)
        if end < 0:
            break
        paths.append(html[start + 1:end])
        start = html.find('"/_app/', end + 1)
    return paths


def _test_webui_assets_embedded():
    # Sanity-checks the embedded web UI (webui/build, see derived_modules in
    # Build.act), so a broken `just gen-webui` run or a commit that misses
    # new files fails here instead of in the browser.
    a = webui_assets.files
    count = len(a)
    testing.assertTrue(count > 10, "expected the full asset set, got {count} entries")

    index_body = a.get("/index.html")
    if index_body is not None:
        testing.assertTrue(index_body.lower().startswith(b"<!doctype html>"), "index must be the SPA entry page")
        # A changed chunk gets a new name, and so does each chunk that
        # imports it, up to the app entry that only index.html loads.
        loaded = _app_paths(index_body.decode())
        testing.assertTrue(len(loaded) > 0, "index.html loads no /_app/ file")
        for path in loaded:
            testing.assertTrue(path in a, "index.html loads " + path + ", which is not embedded; git add webui/build")
    else:
        raise ValueError("missing /index.html in embedded assets")

    # content_type gives this for an unknown extension
    fallback = swstatic.content_type("/x")
    for path, body in a.items():
        testing.assertTrue(len(body) > 0, "empty embedded asset: " + path)
        testing.assertTrue(path.startswith("/"), "asset path must be absolute: " + path)
        testing.assertTrue(_url_safe(path), "the top cannot serve " + path + ", use only letters, digits and ._-/ in names")
        known = path.lower().endswith(".txt") or swstatic.content_type(path) != fallback
        testing.assertTrue(known, "no Content-Type for " + path + ", add it to src/static_assets.act")


def _test_check_helpers():
    html = '<link href="/_app/immutable/entry/start.A.js" rel="modulepreload">\n<script>import("/_app/immutable/entry/app.B.js")</script>'
    testing.assertEqual(_app_paths(html), ["/_app/immutable/entry/start.A.js", "/_app/immutable/entry/app.B.js"])
    testing.assertTrue(_url_safe("/_app/immutable/chunks/DG_eqXSH.js"))
    testing.assertFalse(_url_safe("/_app/immutable/assets/StratoWeave Logo.B7cGtUOH.svg"))
