import testing

import fleetmgr.webui_assets as webui_assets


def _test_webui_assets_embedded():
    # Sanity-checks the generated module, so a broken `just gen-webui` run
    # fails here instead of at the top's startup.
    a = webui_assets.ASSETS
    count = len(a)
    testing.assertTrue(count > 10, "expected the full asset set, got {count} entries")

    index_body = a.get("/index.html")
    if index_body is not None:
        testing.assertTrue(index_body.lower().startswith("<!doctype html>"), "index must be the SPA entry page")
    else:
        raise ValueError("missing /index.html in embedded assets")

    for path, body in a.items():
        testing.assertTrue(len(body) > 0, "empty embedded asset: " + path)
        testing.assertTrue(path.startswith("/"), "asset path must be absolute: " + path)
