import testing

import stratoweave

import flotilla.layers.y_0 as rfs
import flotilla.layers.y_0_oper as rfs_oper
import flotilla.devices.iosxe_oper as iosxe_oper
import flotilla.rfs as health
import flotilla.sysspec as sysspec
from flotilla.layers.y_0 import \
    stratoweave_rfs__device__credentials as Credentials


def _neighbor(root: iosxe_oper.root, address: str, state: str, sent: int, received: int) -> None:
    n = root.bgp_state_data.neighbors.neighbor.create(
        (afi_safi="ipv4-unicast", vrf_name="default", neighbor_id=address),
        session_state=state)
    n.prefix_activity.sent.current_prefixes = u64(sent)
    n.prefix_activity.received.current_prefixes = u64(received)


def _test_read_neighbors():
    """A down peer is reported, not dropped."""
    root = iosxe_oper.root()
    _neighbor(root, "10.0.1.1", "fsm-idle", 0, 0)
    _neighbor(root, "10.0.2.1", "fsm-established", 3, 1)
    got = health.read_neighbors(root)
    testing.assertEqual(2, len(got))
    testing.assertEqual("fsm-idle", got[0].session_state)
    testing.assertEqual("fsm-established", got[1].session_state)
    testing.assertEqual(3, got[1].advertised)
    testing.assertEqual(1, got[1].received)
    testing.assertEqual("10.0.1.1 fsm-idle", health.down(got))
    testing.assertEqual(0, len(health.read_neighbors(None)))


actor _test_direct_device_config(t: testing.AsyncT):
    """The flotilla northbound is RFS: /device is its top-level intent."""
    root = rfs.root()
    root.device.create(
        "cpe-1",
        type="iosxe",
        credentials=Credentials(username="admin", password="admin"),
    ).mock.enabled = True

    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    var attempts = 0

    def check_device():
        attempts += 1
        mgr = tr.dev_registry.get("cpe-1")
        config = mgr!.get_dmc() if mgr is not None else None
        if config is not None and config!.type == "iosxe" and config!.mock.enabled!:
            t.success()
        elif attempts >= 100:
            t.failure(ValueError("direct /device config was not retained"))
        else:
            after 0.01: check_device()

    def cont(result):
        if isinstance(result, Exception):
            t.failure(result)
            return
        check_device()

    tr.edit_config(root.to_gdata(), cont)


actor _test_iosxe_software_upgrade(t: testing.AsyncT):
    """Run the production IOS XE workflow against flotilla's device mock, with
    the device-health checks gating it. The mock serves no BGP state, so both
    checks pass on an empty reading."""
    root = rfs.root()
    dev = root.device.create(
        "xe-1",
        type="iosxe",
        credentials=Credentials(username="admin", password="admin"),
    )
    dev.mock.enabled = True
    # The post-check waits for a sample taken after the reload, so the poll
    # period bounds the test time.
    root.rfs.create("xe-1").device_health.poll_period = u64(1)

    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    var attempts = 0
    var saw_in_progress = False
    var finished = False

    def fail(message: str) -> None:
        if not finished:
            finished = True
            t.failure(ValueError(message))

    def poll_status() -> None:
        attempts += 1
        oper = rfs_oper.root.from_gdata(tr.cfs.newsession().get_data())
        out = oper.device.get("xe-1")
        if out is not None:
            state = out!.software.state
            status = state.status
            if status == "in-progress":
                saw_in_progress = True
            elif status == "failed":
                fail("IOS XE software upgrade failed: {state.precheck.detail}")
                return
            elif status == "succeeded":
                if not saw_in_progress:
                    fail("IOS XE upgrade skipped the observable in-progress state")
                elif state.running_release != "17.18.3a":
                    fail("IOS XE running release was not published")
                elif state.precheck.verdict != "pass" or state.postcheck.verdict != "pass":
                    fail("the device-health checks did not both pass")
                else:
                    finished = True
                    t.success()
                return
        if attempts >= 1000:
            fail("timed out waiting for IOS XE software upgrade")
        else:
            after 0.01: poll_status()

    def start_upgrade() -> None:
        dev.software.upgrade_campaign = "xe-upgrade"
        dev.software.target_release = "17.18.03a"
        dev.software.image_url = \
            "scp://root:labpass@10.0.0.9:/images/" + \
            "c8000v-universalk9.17.18.03a.SPA.bin"

        def on_upgrade(result):
            if isinstance(result, Exception):
                fail("failed to apply IOS XE software intent: {result}")
            else:
                poll_status()

        tr.edit_config(root.to_gdata(), on_upgrade)

    def wait_for_mock() -> None:
        mgr = tr.dev_registry.get("xe-1")
        if mgr is not None and \
           "Cisco-IOS-XE-install-oper" in mgr!.get_modules().0:
            # The mock attachment follows adapter construction asynchronously.
            after 0.05: start_upgrade()
        elif attempts >= 500:
            fail("timed out waiting for IOS XE mock device")
        else:
            attempts += 1
            after 0.01: wait_for_mock()

    def on_device(result):
        if isinstance(result, Exception):
            fail("failed to create IOS XE mock device: {result}")
        else:
            wait_for_mock()

    tr.edit_config(root.to_gdata(), on_device)
