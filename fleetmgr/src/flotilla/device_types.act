# This file is generated only when missing.
# Edit it to register package-provided device types for this app.

import logging

import stratoweave.device as swdev
import stratoweave.platform_probes as swplat
import stratoweave.adapters.netconf as swna
import stratoweave.adapters.software_iosxe as swxe
import stratoweave.adapters.software_iosxe_mock as swxemock

import flotilla.devices.iosxe as iosxe_dev
import flotilla.devices.iosxe_oper as iosxe_oper


def _mock_upgrade_seconds(dmc) -> float:
    """mock/software/upgrade-duration in seconds; absent means an instant upgrade."""
    d = dmc.mock.software.upgrade_duration
    return float(d!) if d is not None else 0.0


def _iosxe_adapter(dev: swdev.DeviceMgr, schema, dmc, registry,
                   log_handler: logging.Handler,
                   env: ?Env):
    adapter = swna.NetconfAdapter(
        dev, schema, dmc, registry, log_handler, env)
    if dmc.mock.enabled:
        server = adapter.get_mock_server()
        if server is not None:
            running = dmc.mock.platform.version
            model = dmc.mock.platform.model
            serial = dmc.mock.platform.serial_number
            mock = swxemock.IosXeSoftwareMock(
                server!, log_handler,
                upgrade_duration=_mock_upgrade_seconds(dmc),
                failure=dmc.mock.software.failure,
                running=running if running is not None else swxemock.OLD_RELEASE,
                model=model if model is not None else swxemock.MODEL,
                serial=serial if serial is not None else swxemock.SERIAL)
            mock.attach()
    return adapter


def _iosxe_software(dev: swdev.DeviceMgr, dmc, log_handler: logging.Handler,
                    env: ?Env) -> swdev.SoftwareAdapter:
    if dmc.mock.enabled:
        # The production adapter still runs end to end; only its polls are
        # scaled to the slowest mock operation so the poll budgets hold.
        p = max([0.1, swxemock.longest_op_seconds(_mock_upgrade_seconds(dmc)) / 50.0])
        return swxe.IosXeSoftwareAdapter(dev, dmc, log_handler, env,
                                         p, 2.0 * p)
    return swxe.IosXeSoftwareAdapter(dev, dmc, log_handler, env)


device_types: dict[str, swdev.DeviceType] = {
    "iosxe": swdev.DeviceType(
        name="iosxe",
        adapter_type=_iosxe_adapter,
        src_dnode=iosxe_dev.SRC_DNODE,
        oper_src_dnode=iosxe_oper.SRC_DNODE,
        software_adapter_type=_iosxe_software)
}

# DeviceMgr runs the first probe that applies to a device, so put your own
# probes first: [my_probe] + swplat.PROBES
platform_probes: list[swdev.PlatformProbe] = swplat.PROBES
