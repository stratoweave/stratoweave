    fleetmgr__fleet__device__address_entry as InputAddress, \
    fleetmgr__fleet__device__credentials as InputCredentials, \
    fleetmgr__fleet__device__mock__module_entry as InputMockModule, \
    fleetmgr__fleet__device_entry as InputDevice, \
    fleetmgr__fleet__node__credentials as NodeCredentials, \
    fleetmgr__fleet__node_entry as InputNode, \
    software__software__upgrade_campaign_entry as InputCampaign
