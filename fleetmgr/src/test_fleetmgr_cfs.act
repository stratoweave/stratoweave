    stratoweave_rfs__device_entry as OutputNode, \
    stratoweave_rfs__rfs__device__address__initial_credentials_entry as AddressCredentials, \
    stratoweave_rfs__rfs__device__address_entry as OutputAddress, \
    stratoweave_rfs__rfs__device__credentials__key_entry as OutputKey, \
    stratoweave_rfs__rfs__device__initial_credentials_entry as DeviceCredentials, \
    stratoweave_rfs__rfs__device__mock__module_entry as OutputMockModule, \
    stratoweave_rfs__rfs__device_entry as OutputDevice


actor _test_node_transform(t: testing.AsyncT):
    i = InputNode(
        name="flotilla-1",
        description="Stockholm flotilla",
        credentials=NodeCredentials(username="admin", password="admin"),
    )
    address = i.address.create("primary", address="127.0.0.1", port=u64(12031))
    i.ssh.cipher = ["aes256-ctr", "aes128-ctr"]
    i.ssh.key_exchange = ["curve25519-sha256"]
    i.ssh.minimum_rsa_bits = u64(3072)
    i.ssh.rekey_after_seconds = u64(0)

    transform: cfs.Node = cfs.Node()
    o: y_1.root = y_1.root.from_gdata(transform.transform(i).to_gdata())
    dev: OutputNode = o.device.get("flotilla-1")!
    out_address = dev.address.get("primary")!

    if dev.type != "flotilla" or dev.description != "Stockholm flotilla":
        t.failure(ValueError("flotilla identity was not preserved"))
    elif out_address.address != "127.0.0.1" or out_address.port != 12031:
        t.failure(ValueError("flotilla address was not preserved"))
    elif dev.credentials.username != "admin" or dev.credentials.password != "admin":
        t.failure(ValueError("flotilla credentials were not preserved"))
    elif dev.ssh.cipher != ["aes256-ctr", "aes128-ctr"] or \
         dev.ssh.key_exchange != ["curve25519-sha256"] or \
         dev.ssh.minimum_rsa_bits != 3072 or \
         dev.ssh.rekey_after_seconds != 0:
        t.failure(ValueError("flotilla SSH options were not preserved"))
    elif o.rfs.get("flotilla-1")!.flotilla_status.enabled != True:
        t.failure(ValueError("flotilla status collector was not enabled"))
    else:
        t.success()


def _test_device_ssh_propagation():
    """CFS SSH options survive both transforms and the flotilla XML boundary."""
    config = xml.decode("""<config>
      <fleet xmlns="urn:fleetmgr:fleetmgr">
        <device>
          <name>configured</name>
          <type>iosxe</type>
          <shard>flotilla-1</shard>
          <credentials><username>admin</username></credentials>
          <ssh>
            <cipher>aes256-ctr</cipher>
            <cipher>aes128-ctr</cipher>
            <mac>hmac-sha2-512</mac>
            <mac>hmac-sha2-256</mac>
            <key-exchange>ecdh-sha2-nistp384</key-exchange>
            <key-exchange>curve25519-sha256</key-exchange>
            <host-key-algorithm>ssh-ed25519</host-key-algorithm>
            <host-key-algorithm>rsa-sha2-512</host-key-algorithm>
            <public-key-algorithm>ssh-ed25519</public-key-algorithm>
            <public-key-algorithm>rsa-sha2-256</public-key-algorithm>
            <compression-algorithm>zlib@openssh.com</compression-algorithm>
            <compression-algorithm>none</compression-algorithm>
            <compression-level>3</compression-level>
            <rekey-after-bytes>1048576</rekey-after-bytes>
            <rekey-after-seconds>3600</rekey-after-seconds>
            <minimum-rsa-bits>3072</minimum-rsa-bits>
          </ssh>
        </device>
        <device>
          <name>defaults</name>
          <type>iosxe</type>
          <shard>flotilla-1</shard>
          <credentials><username>admin</username></credentials>
        </device>
      </fleet>
    </config>""")
    inputs = y_0.root.from_gdata(yxml.from_xml(y_0.SRC_DNODE, config))
    di = ttt.DeviceInfo("flotilla-1", {
        "stratoweave-rfs": swadapt.ModCap(
            "stratoweave-rfs",
            "http://stratoweave.org/yang/stratoweave-rfs",
        )
    })
    devices: dict[str, DeviceMetaConfig] = {}
    for i in inputs.fleet.device:
        lower = y_1_config.root.from_gdata(cfs.Device().transform(i).to_gdata())
        entry = lower.rfs.get("flotilla-1")!.device.get(i.name)!
        rendered = rfs.Device().transform(entry, di).to_gdata()
        wire = xml.Node("config", children=rendered.to_xml())
        received = flotilla_rfs.root.from_gdata(
            yxml.from_xml(flotilla_rfs.SRC_DNODE, xml.decode(xml.encode(wire)))
        )
        devices[i.name] = DeviceMetaConfig.from_gdata(
            received.device.get(i.name)!.to_gdata()
        )

    configured = swadapt.ssh_transport_config(devices["configured"].ssh)
    testing.assertEqual([str(c) for c in configured.ciphers],
                        ["aes256-ctr", "aes128-ctr"])
    testing.assertEqual([str(m) for m in configured.macs],
                        ["hmac-sha2-512", "hmac-sha2-256"])
    testing.assertEqual([str(k) for k in configured.key_exchanges],
                        ["ecdh-sha2-nistp384", "curve25519-sha256"])
    testing.assertEqual([str(k) for k in configured.host_key_algorithms],
                        ["ssh-ed25519", "rsa-sha2-512"])
    testing.assertEqual([str(k) for k in configured.public_key_algorithms],
                        ["ssh-ed25519", "rsa-sha2-256"])
    testing.assertEqual([str(c) for c in configured.compression_algorithms],
                        ["zlib@openssh.com", "none"])
    testing.assertEqual(configured.compression_level, 3)
    testing.assertEqual(configured.rekey_after_bytes, 1048576)
    testing.assertEqual(configured.rekey_after_seconds, 3600)
    testing.assertEqual(configured.minimum_rsa_bits, 3072)

    defaults = devices["defaults"].ssh
    testing.assertEqual(defaults.cipher, [])
    testing.assertEqual(defaults.mac, [])
    testing.assertEqual(defaults.key_exchange, [])
    testing.assertEqual(defaults.host_key_algorithm, [])
    testing.assertEqual(defaults.public_key_algorithm, [])
    testing.assertEqual(defaults.compression_algorithm, [])
    testing.assertEqual(defaults.compression_level, u64(7))
    testing.assertEqual(defaults.rekey_after_bytes, None)
    testing.assertEqual(defaults.rekey_after_seconds, None)
    testing.assertEqual(defaults.minimum_rsa_bits, u64(1024))


actor _test_campaign_transform(t: testing.AsyncT):
    inventory = y_0.root()
    inventory.fleet.device.create(
        "cpe-1",
        type="iosxe",
        shard="flotilla-1",
        credentials=InputCredentials(username="admin"),
    )
    campaign = InputCampaign(
        name="xe-upgrade",
        target_release="17.18.03a",
        image_url="https://images.example/xe.bin",
        allow_staging=True,
        admin_state="run",
    )
    campaign.device.create("cpe-1")

    transform: cfs.UpgradeCampaign = cfs.UpgradeCampaign()
    decision = y_0.software__software__upgrade_campaign__dynstate(released=["cpe-1"])
    o: y_1.root = y_1.root.from_gdata(
        transform.transform(campaign, inventory.to_gdata(), decision).to_gdata()
    )
    dev = o.rfs.get("flotilla-1")!.device.get("cpe-1")!

    if dev.software.target_release != "17.18.03a" or \
       dev.software.upgrade_campaign != "xe-upgrade" or \
       dev.software.image_url != "https://images.example/xe.bin" or \
       not dev.software.allow_staging!:
        t.failure(ValueError("campaign was not routed through the device shard"))
    else:
        t.success()


actor _test_campaign_link_routes_existing_inventory(t: testing.AsyncT):
    """A later campaign resolves and augments an existing inventory device."""
    root = y_0.root()
    root.fleet.node.create(
        "flotilla-1",
        credentials=NodeCredentials(username="admin"),
    )
    root.fleet.device.create(
        "cpe-1",
        type="iosxe",
        shard="flotilla-1",
        credentials=InputCredentials(username="admin"),
    )
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def check(attempts: int) -> None:
        # The controller releases the device on its first tick, so the
        # augmented output appears shortly after the edit, not within it.
        if done:
            return
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        found = False
        shard = lower.rfs.get("flotilla-1")
        if shard is not None:
            out = shard.device.get("cpe-1")
            if out is not None:
                if out.software.target_release == "17.18.03a":
                    found = True
        if found:
            done = True
            t.success()
        elif attempts > 0:
            after 0.25: check(attempts - 1)
        else:
            fail("linked campaign did not augment the existing inventory device")

    def on_campaign(result) -> None:
        if isinstance(result, Exception):
            fail("campaign edit failed: {result}")
            return
        check(20)

    def on_inventory(result) -> None:
        if isinstance(result, Exception):
            fail("inventory edit failed: {result}")
            return
        campaign = root.software.upgrade_campaign.create(
            "xe-upgrade",
            target_release="17.18.03a",
            image_url="https://images.example/xe.bin",
            admin_state="run",
        )
        campaign.device.create("cpe-1")
        tr.edit_config(root.to_gdata(), on_campaign)

    tr.edit_config(root.to_gdata(), on_inventory)
    after 8.0: fail("timed out waiting for linked campaign")


actor _test_device_transform(t: testing.AsyncT):
    credentials: InputCredentials = InputCredentials(
        username="netops",
        password="netops-password",
    )
    credentials.key.create("ssh-ed25519 public", private_key="private")

    i: InputDevice = InputDevice(
        name="cpe-1",
        type="iosxe",
        shard="flotilla-1",
        description="Lab CPE",
        credentials=credentials,
        approval_required=True,
    )
    address: InputAddress = i.address.create(
        "oob",
        address="192.0.2.1",
        port=u64(830),
    )
    address.initial_credentials.create((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    i.initial_credentials.create((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    i.mock.enabled = True
    i.mock.software.upgrade_duration = u64(60)
    i.mock.software.failure = "commit-failed"
    i.mock.software.running_release = "17.18.03a"
    module: InputMockModule = i.mock.module.create(
        "ietf-system",
        namespace="urn:ietf:params:xml:ns:yang:ietf-system",
        revision="2014-08-06",
    )
    module.feature = ["authentication", "local-users"]
    i.debug.connection = True
    i.feature_flags.runtime_schema_fetch = True

    transform: cfs.Device = cfs.Device()
    o: y_1.root = y_1.root.from_gdata(transform.transform(i).to_gdata())
    shard = o.rfs.get("flotilla-1")!
    dev: OutputDevice = shard.device.get("cpe-1")!
    out_address: OutputAddress = dev.address.get("oob")!
    address_credentials: ?AddressCredentials = out_address.initial_credentials.get((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    device_credentials: ?DeviceCredentials = dev.initial_credentials.get((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    out_key: OutputKey = dev.credentials.key.get("ssh-ed25519 public")!
    out_module: OutputMockModule = dev.mock.module.get("ietf-system")!

    if dev.type != "iosxe" or dev.description != "Lab CPE":
        t.failure(ValueError("device identity was not preserved"))
    elif out_address.address != "192.0.2.1" or out_address.port != 830:
        t.failure(ValueError("device address fields were not preserved"))
    elif address_credentials is None or device_credentials is None:
        t.failure(ValueError("initial credentials were not preserved"))
    elif dev.credentials.username != "netops" or dev.credentials.password != "netops-password":
        t.failure(ValueError("active credentials were not preserved"))
    elif out_key.private_key != "private":
        t.failure(ValueError("credential keys were not preserved"))
    elif not dev.approval_required! or not dev.mock.enabled!:
        t.failure(ValueError("device policy fields were not preserved"))
    elif out_module.namespace != "urn:ietf:params:xml:ns:yang:ietf-system" or \
         out_module.revision != "2014-08-06" or \
         out_module.feature != ["authentication", "local-users"]:
        t.failure(ValueError("mock module fields were not preserved"))
    elif dev.mock.software.upgrade_duration != 60 or \
         dev.mock.software.failure != "commit-failed" or \
         dev.mock.software.running_release != "17.18.03a":
        t.failure(ValueError("mock upgrade duration, failure or running release was not preserved"))
    elif not dev.debug.connection! or not dev.feature_flags.runtime_schema_fetch!:
        t.failure(ValueError("debug or feature flags were not preserved"))
    else:
        t.success()


def _paced_campaign(names: list[str]) -> InputCampaign:
    campaign = InputCampaign(
        name="paced",
        target_release="17.18.03a",
        image_url="https://images.example/xe.bin",
        admin_state="run",
    )
    campaign.window.create(u64(0), duration=u64(600))
    for name in names:
        campaign.device.create(name)
    return campaign


def _flat_inventory(names: list[str]) -> y_0.root:
    linked = y_0.root()
    for name in names:
        linked.fleet.device.create(
            name,
            type="iosxe",
            shard="flotilla-1",
            credentials=InputCredentials(username="admin"),
        )
    return linked


def _window_names(layout: list[(str, int, int, list[(str, int)])], window: str) -> list[str]:
    names = []
    for win in layout:
        if win.0 == window:
            for entry in win.3:
                names.append(entry.0)
    return sorted(names)


actor _test_campaign_without_windows_gets_default_window(t: testing.AsyncT):
    """No windows defined: one synthetic open window takes everyone, and
    nothing starts before the controller releases it."""
    linked = _flat_inventory(["cpe-1"])
    campaign = InputCampaign(
        name="now",
        target_release="17.18.03a",
        image_url="https://images.example/xe.bin",
        admin_state="run",
    )
    campaign.device.create("cpe-1")
    layout, alarms = cfs.plan_campaign(campaign)
    testing.assertEqual(_window_names(layout, "default"), ["cpe-1"], None)
    out = cfs.UpgradeCampaign().transform(campaign, linked.to_gdata(), None)
    o: y_1.root = y_1.root.from_gdata(out.to_gdata())
    shards = 0
    for _s in o.rfs:
        shards += 1
    testing.assertEqual(shards, 0, "an unreleased device must not start")
    decision = y_0.software__software__upgrade_campaign__dynstate(released=["cpe-1"])
    out2 = cfs.UpgradeCampaign().transform(campaign, linked.to_gdata(), decision)
    o2: y_1.root = y_1.root.from_gdata(out2.to_gdata())
    shards2 = 0
    for _s2 in o2.rfs:
        shards2 += 1
    testing.assertEqual(shards2, 1, "a released device starts")
    t.success()


actor _test_campaign_deadline_without_windows_plans(t: testing.AsyncT):
    """A deadline alone closes the synthetic window; devices still plan."""
    campaign = InputCampaign(
        name="dl",
        target_release="17.18.03a",
        image_url="https://images.example/xe.bin",
        admin_state="plan",
        deadline=u64(3600),
    )
    for name in ["d1", "d2"]:
        campaign.device.create(name)
    layout, alarms = cfs.plan_campaign(campaign)
    testing.assertEqual(_window_names(layout, "default"), ["d1", "d2"], None)
    testing.assertEqual(len(alarms), 0, "a meetable deadline must not alarm")
    for win in layout:
        testing.assertEqual(win.2 <= 3600, True, "the deadline closes the window")
    t.success()


actor _test_campaign_plan_state_plans_without_actuating(t: testing.AsyncT):
    """In plan admin-state the layout exists and nothing is emitted."""
    campaign = _paced_campaign(["cpe-1", "cpe-2"])
    campaign.admin_state = "plan"
    layout, alarms = cfs.plan_campaign(campaign)
    testing.assertEqual(_window_names(layout, "window"), ["cpe-1", "cpe-2"], None)
    out = cfs.UpgradeCampaign().transform(campaign, _flat_inventory(["cpe-1", "cpe-2"]).to_gdata(), None)
    o: y_1.root = y_1.root.from_gdata(out.to_gdata())
    shards = 0
    for _s in o.rfs:
        shards += 1
    testing.assertEqual(shards, 0, "plan state must not actuate")
    t.success()


actor _test_campaign_actuates_only_released(t: testing.AsyncT):
    """The transform actuates exactly the controller's released set."""
    campaign = _paced_campaign(["cpe-1", "cpe-2", "cpe-3"])
    decision = y_0.software__software__upgrade_campaign__dynstate(released=["cpe-2"])
    out = cfs.UpgradeCampaign().transform(
        campaign, _flat_inventory(["cpe-1", "cpe-2", "cpe-3"]).to_gdata(), decision)
    o: y_1.root = y_1.root.from_gdata(out.to_gdata())
    names = []
    for shard in o.rfs:
        for d in shard.device:
            names.append(d.name)
    testing.assertEqual(sorted(names), ["cpe-2"], "only the released device actuates")
    t.success()


actor _test_campaign_full_release_actuates_all(t: testing.AsyncT):
    """A decision covering the whole plan actuates the whole plan."""
    campaign = _paced_campaign(["cpe-1", "cpe-2", "cpe-3"])
    decision = y_0.software__software__upgrade_campaign__dynstate(
        released=["cpe-1", "cpe-2", "cpe-3"])
    out = cfs.UpgradeCampaign().transform(
        campaign, _flat_inventory(["cpe-1", "cpe-2", "cpe-3"]).to_gdata(), decision)
    o: y_1.root = y_1.root.from_gdata(out.to_gdata())
    actuated = 0
    for shard in o.rfs:
        for _d in shard.device:
            actuated += 1
    testing.assertEqual(actuated, 3, None)
    t.success()


actor _test_campaign_estimates_follow_the_controller(t: testing.AsyncT):
    """Estimated starts are the controller's own predicted launches: the
    ramp from one, doubling on completions, not an even spread."""
    names = []
    for i in range(10):
        names.append("r{i}")
    campaign = InputCampaign(
        name="ramped",
        target_release="17.18.03a",
        image_url="https://images.example/xe.bin",
        admin_state="plan",
        target_rate=u64(3600),
        max_rate=u64(7200),
    )
    for name in names:
        campaign.device.create(name)
    layout, alarms = cfs.plan_campaign(campaign)
    testing.assertEqual(len(alarms), 0, None)
    offsets = []
    for win in layout:
        for entry in win.3:
            offsets.append(entry.1)
    # 4s estimates, 2s debounce, target concurrency 4: waves of 1, 2, 4
    # and the last 3, at 0, 6, 12 and 18 seconds after launch.
    testing.assertEqual(sorted(offsets), [0, 6, 6, 12, 12, 12, 12, 18, 18, 18],
                        "estimates must ramp like the controller")
    t.success()
