                     "cpe-001 None None", "cpe-002 not-answered None",
                     "cpe-007 group-not-answered cpe-002", "held 2"])


proc def _BackUp(t: testing.AsyncT, flotilla: bool, back: ?bool):
    t.timeout(8.0)
    """Run the campaign now over HELD_MEMBERS, one at a time, every member
    answered upgrade-needed. cpe-001 and cpe-007 are down: their flotilla
    is not connected to them, or, when flotilla is True, the top is not
    connected to their flotilla, flotilla-8. So the campaign releases
    cpe-002 first, and holds the members that are down. When cpe-002 is
    done, the campaign releases no one while they are down. When they are
    back up, it releases cpe-001: the connection that was False is back,
    as back gives it, True or no longer known."""
    done = False
    held: list[str] = []
    linked = _flat_inventory(HELD_MEMBERS, 600).to_gdata()
    want = ["cpe-001 flotilla-down flotilla-8", "cpe-002 None None",
            "cpe-007 flotilla-down flotilla-8", "held 2"] if flotilla else \
           ["cpe-001 down None", "cpe-002 None None", "cpe-007 down None", "held 2"]

    BackUpActor(t=t, flotilla=flotilla, back=back, _initial_done=done, _initial_held=held, linked=linked, want=want)


actor BackUpActor(t: testing.AsyncT, flotilla: bool, back: ?bool, _initial_done, _initial_held: list[str], linked, want):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = _initial_done
    var held: list[str] = _initial_held

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str, connected: ?bool) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _connected(status, "now", connected), None)

    def flotilla_8(connected: ?bool) -> None:
        cc = controller
        if cc is not None:
            entry: ?y1_oper.stratoweave_rfs__device__state__adapter_entry = None
            if connected is not None:
                entry = _flotilla_state(connected)
            cc.on_flotilla((device_name="flotilla-8", adapter_type=cfs.FLOTILLA_TYPE),
                           entry, None)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None:
            held = _held_rows(oper!, HELD_MEMBERS)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0:
            if free == ["cpe-002"]:
                stage = 1
                report("cpe-002", "succeeded", True)
            elif len(free) > 0:
                fail("first released {free}")
        elif stage == 1:
            if free != []:
                fail("cpe-002 done, released {free}")
            elif held != want:
                fail("held: {held}")
            else:
                stage = 2
                if flotilla:
                    flotilla_8(back)
                else:
                    report("cpe-001", "upgrade-needed", back)
                    report("cpe-007", "upgrade-needed", back)
        elif free == ["cpe-001"]:
            done = True
            t.success()
        else:
            fail("back up, released {free}")

    def start() -> None:
        cc = controller
        if cc is not None:
            cc.on_conf(_now_campaign("run", HELD_MEMBERS), linked)
            if flotilla:
                flotilla_8(False)
            for name in HELD_MEMBERS:
                up = True
                if not flotilla and name != "cpe-002":
                    up = False
                report(name, "upgrade-needed", up)
            cc.on_subscriptions_synced()

    def timeout() -> None:
        fail("at stage {stage}, held {held}")


    def __startup__():
        controller = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)
        start()
        after 6.0: timeout()



actor _test_campaign_releases_a_member_when_it_is_back_up(t: testing.AsyncT):

    def __startup__():
        _BackUp(t, False, True)


actor _test_campaign_releases_a_member_whose_connection_is_no_longer_known(t: testing.AsyncT):

    def __startup__():
        _BackUp(t, False, None)


actor _test_campaign_releases_the_members_of_a_flotilla_that_is_back_up(t: testing.AsyncT):

    def __startup__():
        _BackUp(t, True, True)


actor _test_campaign_releases_the_members_of_a_flotilla_no_longer_known(t: testing.AsyncT):

    def __startup__():
        _BackUp(t, True, None)


proc def _FlotillaLost(t: testing.AsyncT, status: str):
    t.timeout(8.0)
    """Run the campaign now over HELD_MEMBERS, one at a time, with a failure
    budget of 0 percent, every member answered upgrade-needed. cpe-001, on
    flotilla-8, is released first and reports status. Then the top loses
    flotilla-8. The campaign keeps cpe-001's status and the counter that
    counts it, holds cpe-007 for flotilla-down, and releases no other
    member: cpe-001 holds the only slot while it is in progress, and stops
    the releases while it has failed."""
    linked = _flat_inventory(HELD_MEMBERS, 600).to_gdata()

    FlotillaLostActor(t=t, status=status, linked=linked)


actor FlotillaLostActor(t: testing.AsyncT, status: str, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False

    def counted(o: y0_oper.software__software__upgrade_campaign_entry) -> ?u64:
        """The counter that counts status."""
        return o.state.failed if status == "failed" else o.state.in_progress

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(device: str, st: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(device), device_name=device),
                      _connected(st, "now", True), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        free = _vetoed(out, "now").1
        if stage == 0:
            if free == ["cpe-001"]:
                stage = 1
                report("cpe-001", status)
            elif len(free) > 0:
                fail("first released {free}")
        elif "cpe-002" in free or "cpe-007" in free:
            fail("at stage {stage}, released {free}")

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        if stage == 1 and counted(o) == u64(1):
            stage = 2
            cc = controller
            if cc is not None:
                cc.on_flotilla((device_name="flotilla-8", adapter_type=cfs.FLOTILLA_TYPE),
                               _flotilla_state(False), None)
        elif stage == 2 and _held_rows(o, ["cpe-007"])[0] == "cpe-007 flotilla-down flotilla-8":
            row = o.state.device_status.get("cpe-001")
            got = row.status if row is not None else None
            if counted(o) != u64(1) or got != status:
                fail("after the loss: cpe-001 {got}, counted {counted(o)}")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("at stage {stage}")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        campaign = _now_campaign("run", HELD_MEMBERS)
        campaign.failure_budget = Decimal.parse("0")
        controller = ctl
        ctl.on_conf(campaign, linked)
        for name in HELD_MEMBERS:
            report(name, "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 6.0: timeout()



actor _test_campaign_keeps_a_failed_member_of_a_lost_flotilla(t: testing.AsyncT):

    def __startup__():
        _FlotillaLost(t, "failed")


actor _test_campaign_keeps_a_member_in_flight_on_a_lost_flotilla(t: testing.AsyncT):

    def __startup__():
        _FlotillaLost(t, "in-progress")


actor _test_campaign_member_in_flight_that_reboots_publishes_nothing(t: testing.AsyncT):
    """cpe-001 upgrades, and its flotilla loses and gets back its
    connection to it, as in the reboot of the upgrade. The campaign does not
    decide for that, so it publishes nothing."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var publications = 0
    var released = False
    names = ["cpe-001", "cpe-002"]

    def report(connected: bool) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-001"), device_name="cpe-001"),
                      _connected("in-progress", "now", connected), None)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        publications += 1

    def quiet(seen: int) -> None:
        if publications == seen:
            t.success()
        else:
            t.failure(ValueError("published {publications - seen} time(s) more"))

    def reboot() -> None:
        seen = publications
        report(False)
        report(True)
        after float(cfs.campaign_debounce_s(len(names))) + 0.5: quiet(seen)

    def on_output(out: gdata.Node) -> None:
        if not released and _vetoed(out, "now").1 == ["cpe-001"]:
            released = True
            report(True)
            # The decision for the in-progress status is in by then.
            after float(cfs.campaign_debounce_s(len(names))) + 0.5: reboot()

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(6.0)
        controller = ctl
        ctl.on_conf(_now_campaign("run", names), _flat_inventory(names, 600).to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _connected("upgrade-needed", "now", True), None)
        ctl.on_subscriptions_synced()



proc def _test_campaign_hears_whether_the_top_is_connected_to_a_flotilla(t: testing.EnvT):
    """The campaign subscribes to the top's entries for the flotillas, in
    the layer below it. When the top loses its connection to flotilla-8,
    the campaign holds cpe-001, on flotilla-8, for flotilla-down. The
    layer has no device states, so every member has not answered."""
    registry = swdev.DeviceRegistry(
        {cfs.FLOTILLA_TYPE: swdev.DeviceType(name=cfs.FLOTILLA_TYPE,
                                             adapter_type=netconf.NetconfAdapter,
                                             src_dnode=flotilla_dev.SRC_DNODE,
                                             oper_src_dnode=flotilla_oper.SRC_DNODE)},
        None, t.log_handler)
    device = gdata.Id(y1_oper.NS_stratoweave_rfs, "device")
    layer = ttt.Layer("1", ttt.Container({
        device: ttt.List(ttt.Device(registry, t.log_handler),
                         [gdata.Id(y1_oper.NS_stratoweave_rfs, "name")]),
    }), None)
    names = ["cpe-001", "cpe-002"]
    want = ["cpe-001 flotilla-down flotilla-8", "cpe-002 not-answered None", "held 2"]
    campaign: ?cfs.UpgradeCampaignTransform = None
    TestCampaignHearsWhetherTheTopIsConnectedToAFlotillaActor(
        t=t,
        registry=registry,
        device=device,
        layer=layer,
        names=names,
        want=want,
        _initial_campaign=campaign
    )


actor TestCampaignHearsWhetherTheTopIsConnectedToAFlotillaActor(
    t: testing.EnvT,
    registry,
    device,
    layer,
    names,
    want,
    _initial_campaign: ?cfs.UpgradeCampaignTransform
):
    var last: list[str] = []
    var campaign: ?cfs.UpgradeCampaignTransform = _initial_campaign
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None and not done:
            last = _held_rows(oper!, names)
            if last == want:
                done = True
                t.success()

    def connected() -> bool:
        """Whether the top's entry for flotilla-8 says that it is connected."""
        tree = y1_oper.root.from_gdata(layer.get_data())
        node = tree.device.get("flotilla-8")
        if node is not None:
            adapter = node.state.adapter.get(cfs.FLOTILLA_TYPE)
            if adapter is not None:
                up = adapter.connected
                if up is not None and up:
                    return True
        return False

    def disconnect() -> None:
        if connected():
            registry.get_or_create("flotilla-8").on_disconnect()
        else:
            after 0.05: disconnect()

    def on_flotillas(result: value) -> None:
        if isinstance(result, Exception):
            fail("the flotillas were not added: {result}")
            return
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        made = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper,
                                            layer.tree_provider())
        campaign = made
        made.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        disconnect()

    def __startup__():
        top = y_1.root()
        for f in ["flotilla-8", "flotilla-9"]:
            entry = top.device.create(f)
            entry.type = cfs.FLOTILLA_TYPE
            entry.credentials.username = "admin"
            entry.mock.enabled = True

        layer.edit_config(top.to_gdata(), on_flotillas)
        after 2.5: fail("held: {last}")



actor _test_campaign_holds_a_member_still_upgrading(t: testing.AsyncT):
    """cpe-1 reports in-progress for the campaign, which has not released
    it: it still upgrades from before, as after a restart of fleetmgr. The
    campaign counts it in flight and keeps its veto, so cpe-2 does not
    start while it runs, one at a time. When cpe-1 is done, the campaign
    releases cpe-2."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0 and free != []:
            fail("{free} released while cpe-1 still upgrades")
        elif stage == 1 and free == ["cpe-2"]:
            done = True
            t.success()
        elif stage == 1 and free != []:
            fail("once cpe-1 is done: not vetoed {free}")

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or stage != 0:
            return
        started: list[str] = []
        for win in oper!.state.plan.window:
            for dev in win.device:
                if dev.started is not None:
                    started.append(dev.name)
        if "cpe-2" in started:
            fail("cpe-2 started while cpe-1 still upgrades")
        elif "cpe-1" in started:
            # A decision has cpe-1 in flight.
            stage = 1
            report("cpe-1", "succeeded")

    def timeout() -> None:
        fail("at stage {stage}, cpe-2 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(6.0)
        controller = ctl
        ctl.on_conf(_now_campaign("run", ["cpe-1", "cpe-2"]),
                    _flat_inventory(["cpe-1", "cpe-2"]).to_gdata())
        report("cpe-1", "in-progress")
        report("cpe-2", "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 5.0: timeout()



def _plan_row(o: y0_oper.software__software__upgrade_campaign_entry,
              name: str) -> (?u64, ?u64, ?u64, ?u64):
    """The started, finished, estimated-start and prepare-start of the device
    name in the plan of o, each None when absent."""
    for win in o.state.plan.window:
        for dev in win.device:
            if dev.name == name:
                return (dev.started, dev.finished, dev.estimated_start, dev.prepare_start)
    return (None, None, None, None)


proc def _test_campaign_in_plan_shows_the_run_that_carries_on(t: testing.AsyncT):
    """A campaign set back from run to plan publishes the plan of the run
    that carries on. cpe-1 is done: it keeps its start and its finish in
    plan, and when the campaign runs again. cpe-2, released when the
    campaign is set to plan, did not start its run: in plan it waits, with
    an estimated start and no start, and run releases it again."""
    t.timeout(8.0)
    names = ["cpe-1", "cpe-2"]
    linked = _flat_inventory(names).to_gdata()

    TestCampaignInPlanShowsTheRunThatCarriesOnActor(t=t, names=names, linked=linked)


actor TestCampaignInPlanShowsTheRunThatCarriesOnActor(t: testing.AsyncT, names, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var kept_started: ?u64 = None
    var kept_finished: ?u64 = None
    var again = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        cc = controller
        if stage == 0 and free == ["cpe-1"]:
            stage = 1
            report("cpe-1", "succeeded")
        elif stage == 1 and free == ["cpe-2"] and cc is not None:
            stage = 2
            cc.on_conf(_now_campaign("plan", names), linked)
        elif stage == 3 and free == ["cpe-2"]:
            again = True

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        one = _plan_row(oper!, "cpe-1")
        two = _plan_row(oper!, "cpe-2")
        cc = controller
        if stage == 2 and one.0 is not None and one.1 is not None and two.0 is None \
           and two.2 is not None and cc is not None:
            kept_started = one.0
            kept_finished = one.1
            stage = 3
            cc.on_conf(_now_campaign("run", names), linked)
        elif stage == 3 and again and two.0 is not None:
            if one.0 != kept_started or one.1 != kept_finished:
                fail("cpe-1 started at {one.0} and finished at {one.1}, not at "
                     + "{kept_started} and {kept_finished}")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("at stage {stage}, the plan in plan and in run again did not come")

    def __startup__():
        # self.on_oper runs in this actor, after the output that comes before
        # it.
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, self.on_oper, None)
        controller = ctl
        ctl.on_conf(_now_campaign("run", names), linked)
        for name in names:
            report(name, "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 7.0: timeout()


proc def _test_campaign_keeps_the_veto_of_a_member_that_finished_in_a_pause(t: testing.AsyncT):
    """cpe-1 is released, reports in-progress, and the campaign is set to
    plan. cpe-1 finishes in the pause. When the campaign runs again, it
    keeps cpe-1's veto from the start, though the decision that counts
    cpe-1 done comes a debounce later; that decision releases cpe-2."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2"]
    linked = _flat_inventory(names).to_gdata()

    TestCampaignKeepsTheVetoOfAMemberThatFinishedInAPauseActor(t=t, names=names, linked=linked)


actor TestCampaignKeepsTheVetoOfAMemberThatFinishedInAPauseActor(t: testing.AsyncT, names, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        cc = controller
        if cc is not None:
            if stage == 0 and free == ["cpe-1"]:
                stage = 1
                report("cpe-1", "in-progress")
                cc.on_conf(_now_campaign("plan", names), linked)
            elif stage == 1:
                if free != []:
                    fail("in plan: not vetoed {free}")
                else:
                    stage = 2
                    report("cpe-1", "succeeded")
                    cc.on_conf(_now_campaign("run", names), linked)
            elif stage == 2:
                if free != []:
                    fail("run again: not vetoed {free} before the decision")
                else:
                    stage = 3
            elif stage == 3 and free == ["cpe-2"]:
                done = True
                t.success()

    def timeout() -> None:
        fail("at stage {stage}, cpe-2 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(_now_campaign("run", names), linked)
        for name in names:
            report(name, "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


def _let_again(prepared: bool) -> list[str]:
    """The members that _PrepareThroughPause lets prepare again: cpe-1,
    unless it prepared."""
    if prepared:
        return []
    return ["cpe-1"]


proc def _PrepareThroughPause(t: testing.AsyncT, prepared: bool):
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging. cpe-1
    is let prepare at once. With prepared, it reports its prepare done.
    The campaign is then set to plan, where it lets no member prepare and
    shows cpe-1's prepare-start as it was, and to run again. Pass t when
    the run again shows the same prepare-start for cpe-1, and lets cpe-1
    prepare again when it did not report its prepare, and not when it
    prepared."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    now = time.time().unix_s()
    soon = _soon(names, "run", True, now)
    paused = _soon(names, "plan", True, now)
    want = _let_again(prepared)

    PrepareThroughPauseActor(t=t, prepared=prepared, names=names, soon=soon, paused=paused,
                             want=want)


actor PrepareThroughPauseActor(t: testing.AsyncT, prepared: bool, names, soon, paused, want):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var planned = False
    var staged_ok = False
    var first: ?u64 = None
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        staged = _staged(out)
        cc = controller
        if cc is not None:
            if stage == 0 and staged == ["cpe-1"]:
                if prepared:
                    stage = 1
                    cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                              _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "done",
                                              "17.18.03a"), None)
                else:
                    stage = 2
                    cc.on_conf(paused.0, paused.1.to_gdata())
            elif stage == 1 and staged == []:
                stage = 2
                cc.on_conf(paused.0, paused.1.to_gdata())
            elif stage == 2:
                if staged != []:
                    fail("in plan, let prepare {staged}")
                else:
                    planned = True
            elif stage == 3:
                if staged != want:
                    fail("run again: let prepare {staged}, not {want}")
                else:
                    staged_ok = True

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        start = _plan_row(oper!, "cpe-1").3
        cc = controller
        if stage == 1 or (stage == 2 and not planned):
            # The plan of a decision of the run after cpe-1 was let.
            first = start
        elif stage == 2 and planned and cc is not None:
            if start != first:
                fail("in plan, cpe-1 prepares at {start}, not {first}")
            else:
                stage = 3
                cc.on_conf(soon.0, soon.1.to_gdata())
        elif stage == 3 and staged_ok:
            if start != first:
                fail("run again: cpe-1 prepares at {start}, not {first}")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("at stage {stage}, the run again did not show cpe-1's prepare")

    def __startup__():
        # self.on_oper runs in this actor, after the output that comes before
        # it.
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, self.on_oper, None)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


actor _test_campaign_keeps_the_prepare_start_of_a_prepared_member_through_a_pause(
        t: testing.AsyncT):
    """A member that prepared keeps its prepare-start through a pause, and
    is not let prepare again."""

    def __startup__():
        _PrepareThroughPause(t, True)


actor _test_campaign_lets_a_member_prepare_again_after_a_pause(t: testing.AsyncT):
    """A member let prepare that reports no prepare is let again when a
    paused campaign runs again, with the same prepare-start."""

    def __startup__():
        _PrepareThroughPause(t, False)


def _prepare_attempts(out: gdata.Node) -> dict[str, u64]:
    """Return the prepare attempt that out, the output of a campaign,
    writes for each device that has one."""
    attempts: dict[str, u64] = {}
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            r = dev.software.prepare_attempt
            if r is not None:
                attempts[dev.name] = r
    return attempts


def _asked(names: list[str], name: str, now: int) -> (InputCampaign, y_0.root):
    """The campaign soon of _soon in run with allow-staging, where the
    member name has its prepare attempt 1."""
    asked = _soon(names, "run", True, now)
    member = asked.0.device.get(name)
    if member is not None:
        member.prepare_attempt = u64(1)
    return asked


proc def _FailedPrepareAgain(t: testing.AsyncT, restarted: bool):
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging. cpe-1
    is let prepare at once. Without restarted, its prepare fails. With
    restarted, it prepares, and cpe-2 reports a failed prepare from the
    start, as after a restart of fleetmgr, and gets no turn. The campaign
    does not let the member that failed prepare, and the plan names it in
    the alarm of the failed prepares. An operator then raises its
    prepare-attempt. Pass t when the output at once lets the member
    prepare, with prepare-attempt 1, and the plan keeps its prepare-start,
    or gives it one when it had none."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    failing = "cpe-2" if restarted else "cpe-1"
    now = time.time().unix_s()
    soon = _soon(names, "run", True, now)
    asked = _asked(names, failing, now)
    FailedPrepareAgainActor(t=t, restarted=restarted, names=names, failing=failing, soon=soon,
                            asked=asked)


actor FailedPrepareAgainActor(t: testing.AsyncT, restarted: bool, names, failing, soon, asked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var staged: list[str] = []
    var staged_ok = False
    var first: ?u64 = None
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def failed_prepare() -> y1_oper.stratoweave_rfs__rfs__device__state:
        return _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "failed", "17.18.03a")

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        staged = _staged(out)
        cc = controller
        if stage == 0 and staged == ["cpe-1"] and cc is not None:
            stage = 1
            # cpe-1's prepare fails, or with restarted is done, so that it
            # leaves the cap free.
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      failed_prepare() if not restarted else
                      _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "done", "17.18.03a"),
                      None)
        elif stage == 2:
            if failing in staged and _prepare_attempts(out).get(failing) == u64(1):
                staged_ok = True
            else:
                fail("after the ask: let prepare {staged}, prepare attempts "
                     + "{_prepare_attempts(out)}")

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        alarm = "1 device(s) failed to prepare and copy the image in their window: {failing}"
        start = _plan_row(o, failing).3
        cc = controller
        if stage == 1 and alarm in o.state.plan.alarm and failing not in staged \
           and cc is not None:
            first = start
            stage = 2
            cc.on_conf(asked.0, asked.1.to_gdata())
        elif stage == 2 and staged_ok:
            if alarm in o.state.plan.alarm:
                fail("the failed prepare is still named")
            elif start is None or (first is not None and start != first):
                fail("{failing} prepares at {start}, not {first}")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("at stage {stage}, {failing} was not let prepare again: let prepare {staged}")

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, self.on_oper, None)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            if restarted and name == failing:
                ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), failed_prepare(),
                           None)
            else:
                ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                           _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


actor _test_campaign_lets_a_failed_member_prepare_again(t: testing.AsyncT):
    """A member let prepare whose prepare fails is let prepare again at
    once when its prepare-attempt changes, with the same prepare-start."""

    def __startup__():
        _FailedPrepareAgain(t, False)


actor _test_campaign_lets_a_member_that_failed_before_a_restart_prepare(t: testing.AsyncT):
    """A member that reports a failed prepare from the start, as after a
    restart of fleetmgr, gets no turn. It is let prepare at once when its
    prepare-attempt changes."""

    def __startup__():
        _FailedPrepareAgain(t, True)


proc def _test_campaign_keeps_the_let_of_a_retrying_member(t: testing.AsyncT):
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging. cpe-1
    is let prepare at once, and its prepare is retrying: it failed for a
    transient reason, and its device tries it again. The campaign keeps
    letting it prepare."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    soon = _soon(names, "run", True, time.time().unix_s())
    RetryingMemberActor(t=t, names=names, soon=soon)


actor RetryingMemberActor(t: testing.AsyncT, names, soon):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var staged: list[str] = []
    var reported = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        staged = _staged(out)
        cc = controller
        if not reported and staged == ["cpe-1"] and cc is not None:
            reported = True
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "retrying",
                                      "17.18.03a"), None)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or not reported:
            return
        r = oper!.state.device_status.get("cpe-1")
        if r is not None and r.prepare.state == "retrying":
            if staged != ["cpe-1"]:
                fail("cpe-1 retries its prepare, and the campaign lets {staged} prepare")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("no plan showed cpe-1 retrying its prepare: let prepare {staged}")

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, self.on_oper, None)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


proc def _test_campaign_counts_a_prepare_that_runs_again_from_its_report(t: testing.AsyncT):
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging, where
    each member upgrades in 92 s, so that it prepares in 30 s. cpe-1 is let
    prepare at once, and its prepare is retrying. 1.5 s later its device
    reports the prepare running again. Pass t when the plan counts that
    prepare from the report, and not from when cpe-1 was let: the prepare
    bandwidth of the plan has its first step at the report."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    soon = _soon(names, "run", True, time.time().unix_s())
    for name in names:
        dev = soon.1.fleet.device.get(name)
        if dev is not None:
            dev.mock.software.upgrade_duration = u64(92)
    RunsAgainActor(t=t, names=names, soon=soon)


actor RunsAgainActor(t: testing.AsyncT, names, soon):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var sent_at = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(state: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged_prepare("upgrade-needed", "soon", "17.18.03a", state, "17.18.03a"),
                      None)

    def runs_again() -> None:
        stage = 3
        sent_at = time.time().unix_s()
        report("running")

    def on_output(out: gdata.Node) -> None:
        if not done and stage == 0 and _staged(out) == ["cpe-1"]:
            stage = 1
            report("retrying")

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        st = r.prepare.state if r is not None else None
        if stage == 1 and st == "retrying":
            stage = 2
            after 1.5: runs_again()
        elif stage == 3 and st == "running":
            first: ?u64 = None
            for e in o.state.plan.prepare_bandwidth:
                bw = e.bandwidth
                if first is None and bw is not None and bw > u64(0):
                    first = e.time
            f = -1
            if first is not None:
                f = int(first)
            if f < sent_at or f > sent_at + 5:
                fail("cpe-1's prepare counts from {first}, not from its report at {sent_at}")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("at stage {stage}, no plan showed cpe-1's prepare running again")

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, self.on_oper, None)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


proc def _test_campaign_in_plan_replans_on_answers(t: testing.AsyncT):
    """A campaign in plan plans again when its members answer: the alarm
    that names the members that have not answered goes once they
    answer."""
    answered = False
    names = ["cpe-1", "cpe-2", "cpe-3"]
    waiting = ["3 device(s) have not answered the campaign's target: cpe-1, cpe-2, cpe-3"]

    TestCampaignInPlanReplansOnAnswersActor(t=t, _initial_answered=answered, names=names, waiting=waiting)


actor TestCampaignInPlanReplansOnAnswersActor(t: testing.AsyncT, _initial_answered, names, waiting):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var answered = _initial_answered
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        alarms = list(oper!.state.plan.alarm)
        if not answered:
            if alarms == waiting:
                answered = True
                cc = controller
                if cc is not None:
                    for name in names:
                        cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                                  _tagged("upgrade-needed", "paced", "17.18.03a"), None)
            else:
                fail("before the answers, the alarms are {alarms}")
        elif alarms == []:
            done = True
            t.success()
        elif alarms != waiting:
            fail("after the answers, the alarms are {alarms}")

    def timeout() -> None:
        fail("the campaign did not plan again after the answers")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        controller = ctl
        ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        ctl.on_subscriptions_synced()
        after float(cfs.campaign_debounce_s(len(names))) + 1.5: timeout()



actor _PlanAfterReplay(t: testing.AsyncT, reports: list[(str, str)], want: list[str]):
    """Run a campaign called paced in plan over cpe-1 to cpe-3. Before the
    sync, each member in reports, as (name, campaign), reports
    upgrade-needed for that campaign and the target 17.18.03a, as the
    replay of the subscription does. Pass t when the publication after the
    sync has the alarms, followed by the status of each member as "name
    status", that want gives."""
    var publications = 0
    names = ["cpe-1", "cpe-2", "cpe-3"]

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is None:
            return
        publications += 1
        # The first publication comes from on_conf, before the reports.
        if publications == 2:
            o = oper!
            got = list(o.state.plan.alarm)
            for name in names:
                r = o.state.device_status.get(name)
                if r is not None:
                    got.append("{name} {r.status}")
            if got == want:
                t.success()
            else:
                t.failure(ValueError("after the sync: {got}"))

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        for r in reports:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(r.0), device_name=r.0),
                       _tagged("upgrade-needed", r.1, "17.18.03a"), None)
        ctl.on_subscriptions_synced()



actor _test_campaign_in_plan_plans_with_the_replay(t: testing.AsyncT):
    """The statuses of the replay come before the sync, and the plan that
    the campaign publishes at the sync has them: every member has
    answered, so there is no alarm."""

    def __startup__():
        _PlanAfterReplay(t, [("cpe-1", "paced"), ("cpe-2", "paced"), ("cpe-3", "paced")],
                         ["cpe-1 upgrade-needed", "cpe-2 upgrade-needed", "cpe-3 upgrade-needed"])


actor _test_campaign_holds_a_member_of_another_campaign(t: testing.AsyncT):
    """cpe-2's status answers another campaign, so cpe-2 has not answered
    this one: it shows pending, and the plan holds it and names it in an
    alarm."""

    def __startup__():
        _PlanAfterReplay(t, [("cpe-1", "paced"), ("cpe-2", "other"), ("cpe-3", "paced")],
                         ["1 device(s) have not answered the campaign's target: cpe-2",
                          "cpe-1 upgrade-needed", "cpe-2 pending", "cpe-3 upgrade-needed"])


def _claims_root(campaigns: list[(str, str, list[(str, str)])]) -> y_0.root:
    """The fleet cpe-1 and cpe-2, the image list, and campaigns, each as
    (name, admin-state, its members as (device, image))."""
    root = _with_images(y_0.root())
    for name in ["cpe-1", "cpe-2"]:
        root.fleet.device.create(name, type="iosxe", credentials=InputCredentials(username="admin"))
    for c in campaigns:
        campaign = root.software.upgrade_campaign.create(c.0, admin_state=c.1)
        for m in c.2:
            campaign.device.create(m.0, image=m.1)
    return root


proc def _ClaimEdits(name: str, edits: list[(list[(str, str, list[(str, str)])], bool)],
                  want: list[str], held: list[str], log_handler: logging.Handler,
                  report: action(str, ?str) -> None):
    """Apply edits in order to a new system, then report the case name and
    what went wrong, or None.

    Each edit gives the campaigns of the whole configuration, and whether
    TTT accepts the edit. It is sent as the diff from the last accepted
    configuration, so a member or campaign that is left out is removed. A
    refused edit must fail on the campaigns' names. At the end, want is
    each device that has a campaign's name, as "device campaign target",
    and held are the devices that have their campaign's veto. Edit 0
    creates the fleet and the image list, and edit 1 is the first of
    edits."""
    last = y_0.root()
    pending = y_0.root()
    tr = stratoweave.test_main(sysspec.SYSSPEC, log_handler)
    steps = [([], True)] + edits

    ClaimEditsActor(
        name=name,
        edits=edits,
        want=want,
        held=held,
        log_handler=log_handler,
        report=report,
        _initial_last=last,
        _initial_pending=pending,
        tr=tr,
        steps=steps
    )


actor ClaimEditsActor(
    name: str,
    edits: list[(list[(str, str, list[(str, str)])], bool)],
    want: list[str],
    held: list[str],
    log_handler: logging.Handler,
    report: action(str, ?str) -> None,
    _initial_last,
    _initial_pending,
    tr,
    steps
):
    var last = _initial_last
    var pending = _initial_pending
    var step = 0
    var done = False

    def finish(error: ?str) -> None:
        if not done:
            done = True
            report(name, error)

    def check() -> None:
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        got: list[str] = []
        vetoed: list[str] = []
        for flotilla in lower.rfs:
            for dev in flotilla.device:
                c = dev.software.upgrade_campaign
                if c is not None:
                    got.append("{dev.name} {c} {dev.software.target_release}")
                    if dev.software.veto.get(cfs.veto_holder(c)) is not None:
                        vetoed.append(dev.name)
        not_held = [d for d in held if d not in vetoed]
        if sorted(got) != want:
            finish("claims {sorted(got)}")
        elif len(not_held) > 0:
            finish("not held: {not_held}")
        else:
            finish(None)

    def apply() -> None:
        if done:
            return
        if step == len(steps):
            check()
            return
        pending = _claims_root(steps[step].0)
        d = gdata.diff(last.to_gdata(), pending.to_gdata())
        if d is not None:
            tr.cfs.edit_config(d, on_edit)
        else:
            finish("edit {step} changes nothing")

    def on_edit(result: value) -> None:
        if done:
            return
        accept = steps[step].1
        if isinstance(result, Exception):
            if accept:
                finish("edit {step} failed: {result}")
                return
            if "upgrade-campaign" not in str(result):
                finish("edit {step} failed for another reason: {result}")
                return
        elif not accept:
            finish("edit {step} was accepted")
            return
        else:
            last = pending
        step += 1
        # The campaign actors write their output after the edit.
        after 0.5: apply()

    def timeout() -> None:
        finish("timed out at edit {step}")

    def __startup__():
        apply()
        after 10.0: timeout()



actor _test_one_campaign_per_device(t: testing.AsyncT):
    """One campaign at most acquires a device, also while the campaign is
    in plan. An edit that names an acquired device in a second campaign
    fails, and changes nothing. A member added to a campaign that runs is
    held like every member. A device that is not in the fleet gets no
    intent, so two campaigns can name it. A device that a complete
    campaign freed is in _test_a_freed_device_can_join_another_campaign.

    A device moves to another campaign in two edits: the first removes it
    from its campaign, or deletes the campaign. In one edit the move
    fails. TTT removes the old campaign's name from the device only when
    it locks the device, after it merged the new campaign's name with
    it."""
    var results: dict[str, ?str] = {}
    var done = False
    a = ("A", "plan", [("cpe-1", IMAGE)])
    a_run = ("A", "run", [("cpe-1", IMAGE)])
    a_both = ("A", "plan", [("cpe-1", IMAGE), ("cpe-2", IMAGE)])
    a_two = ("A", "plan", [("cpe-2", IMAGE)])
    b = ("B", "plan", [("cpe-1", IMAGE)])
    # (case, the edits with whether TTT accepts each, each device's
    # campaign and target at the end, and the devices that must be held)
    cases: list[(str, list[(list[(str, str, list[(str, str)])], bool)], list[str], list[str])] = [
        ("a second campaign",
         [([a], True), ([a, b], False)],
         ["cpe-1 A 17.18.03a"], ["cpe-1"]),
        ("a held device added to another campaign",
         [([a], True), ([a, ("B", "plan", [("cpe-2", IMAGE)])], True),
          ([a, ("B", "plan", [("cpe-2", IMAGE), ("cpe-1", IMAGE)])], False)],
         ["cpe-1 A 17.18.03a", "cpe-2 B 17.18.03a"], ["cpe-1", "cpe-2"]),
        ("both in one edit",
         [([a, b], False)],
         [], []),
        ("a campaign in run holds too",
         [([a_run], True), ([a_run, b], False)],
         ["cpe-1 A 17.18.03a"], []),
        ("delete, then create",
         [([a], True), ([], True), ([b], True)],
         ["cpe-1 B 17.18.03a"], ["cpe-1"]),
        ("delete and create in one edit",
         [([a], True), ([b], False)],
         ["cpe-1 A 17.18.03a"], ["cpe-1"]),
        ("move in two edits",
         [([a_both], True), ([a_two], True), ([a_two, b], True)],
         ["cpe-1 B 17.18.03a", "cpe-2 A 17.18.03a"], ["cpe-1", "cpe-2"]),
        ("move in one edit",
         [([a_both], True), ([a_two, b], False)],
         ["cpe-1 A 17.18.03a", "cpe-2 A 17.18.03a"], ["cpe-1", "cpe-2"]),
        ("a member without an image",
         [([("A", "plan", [("cpe-1", "gone.bin")])], True),
          ([("A", "plan", [("cpe-1", "gone.bin")]), b], False)],
         ["cpe-1 A None"], ["cpe-1"]),
        ("a member not in the fleet",
         [([("A", "plan", [("cpe-9", IMAGE)])], True),
          ([("A", "plan", [("cpe-9", IMAGE)]), ("B", "plan", [("cpe-9", IMAGE)])], True)],
         [], []),
        ("a member added to a campaign that runs",
         [([a_run], True), ([("A", "run", [("cpe-1", IMAGE), ("cpe-2", IMAGE)])], True)],
         ["cpe-1 A 17.18.03a", "cpe-2 A 17.18.03a"], ["cpe-2"]),
    ]

    def on_case(name: str, error: ?str) -> None:
        if done:
            return
        results[name] = error
        if len(results) == len(cases):
            done = True
            failed = ["{case.0}: {results[case.0]}" for case in cases if results[case.0] is not None]
            if len(failed) == 0:
                t.success()
            else:
                t.failure(ValueError("; ".join(failed)))

    def __startup__():
        t.timeout(15.0)
        for case in cases:
            _ClaimEdits(case.0, case.1, case.2, case.3, t.log_handler, on_case)



def _soon(names: list[str], admin_state: str, allow_staging: bool,
          now: int) -> (InputCampaign, y_0.root):
    """A campaign called soon over names, and its inventory. Its default
    schedule soon has one window of ten minutes that opens an hour after
    now, in UTC. The members are mocks with no duration: each prepares in
    1 s, and must start to prepare 1.5 s before the window opens. So the
    first member goes at once, and the turns of three members are 30
    minutes apart."""
    campaign = InputCampaign(name="soon", admin_state=admin_state, default_schedule="soon",
                             allow_staging=allow_staging)
    for name in names:
        campaign.device.create(name, image=IMAGE)
    linked = _flat_inventory(names)
    linked.schedules.schedule.create("soon").window.create(u64(1), at=u64((now + 3600) % 86400),
                                                           duration=u64(600))
    return (campaign, linked)


def _soon_state(event: str) -> str:
    """The admin-state that _PrepareTurn starts the campaign in."""
    return "plan" if event == "plan to run" else "run"


proc def _CountsItsPrepareAttempt(t: testing.AsyncT, reported: ?u64, counts: bool):
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging, where
    cpe-1 has its prepare attempt 1. cpe-1 is let prepare at once, and its
    device reports its prepare done for the prepare attempt reported. Pass
    t when the plan that shows that prepare counts cpe-1 as prepared and
    lets it prepare no more, with counts, and else does not count it and
    lets it prepare. The device status shows the prepare attempt that the
    device reports."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    soon = _soon(names, "run", True, time.time().unix_s())
    member = soon.0.device.get("cpe-1")
    if member is not None:
        member.prepare_attempt = u64(1)
    CountsItsPrepareAttemptActor(t=t, reported=reported, counts=counts, names=names, soon=soon)


actor CountsItsPrepareAttemptActor(t: testing.AsyncT, reported: ?u64, counts: bool, names, soon):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var staged: list[str] = []
    var sent = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        staged = _staged(out)
        cc = controller
        if not sent and staged == ["cpe-1"] and cc is not None:
            sent = True
            s, a = _attempt_state("upgrade-needed", "soon", "17.18.03a", u64(0), None, None)
            a.prepare.state = "done"
            a.prepare.release = "17.18.03a"
            a.prepare.prepare_attempt = reported
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), s, None)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or not sent:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        if r is not None and r.prepare.state == "done":
            ran = r.prepare.prepare_attempt
            want_prepared = u64(1) if counts else u64(0)
            want_staged: list[str] = [] if counts else ["cpe-1"]
            if o.state.prepared != want_prepared or ran != reported or staged != want_staged:
                fail("cpe-1's prepare done for {reported}: prepared {o.state.prepared}, "
                     + "prepare attempt {ran}, let prepare {staged}")
            else:
                done = True
                t.success()

    def timeout() -> None:
        fail("no plan showed cpe-1's prepare done: let prepare {staged}")

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, self.on_oper, None)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


actor _test_campaign_counts_the_prepare_of_the_member_prepare_attempt(t: testing.AsyncT):
    """A member with prepare attempt 1 whose device reports its prepare
    done for 1 counts as prepared, and is let prepare no more."""

    def __startup__():
        _CountsItsPrepareAttempt(t, u64(1), True)


actor _test_campaign_does_not_count_the_prepare_of_an_earlier_prepare_attempt(t: testing.AsyncT):
    """A member with prepare attempt 1 whose device reports its prepare
    done without a prepare attempt, which counts as 0, does not count as
    prepared, and stays let prepare."""

    def __startup__():
        _CountsItsPrepareAttempt(t, None, False)


proc def _PrepareTurn(t: testing.AsyncT, event: str):
    t.timeout(6.0)
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging, and let
    the members answer upgrade-needed. The first output with allow-staging
    must hold every member and let only the first member prepare. What
    happens then depends on event:

    - "first": nothing more.
    - "down": cpe-1 is down when it answers: its read fails, so it reports
      unknown. It gets no turn, and cpe-2 goes first.
    - "plan to run": the campaign starts in plan, where no member prepares,
      and runs once the members answered.
    - "prepared": cpe-1 reports its prepare done.
    - "failed": cpe-1 is down at its turn: its prepare fails.
    - "run to plan": the campaign is set to plan.

    After "prepared", "failed" and "run to plan", the next output must hold
    every member and let no member prepare."""
    done = False
    names = ["cpe-1", "cpe-2", "cpe-3"]
    now = time.time().unix_s()
    first = "cpe-2" if event == "down" else "cpe-1"
    soon = _soon(names, _soon_state(event), True, now)
    linked = soon.1.to_gdata()

    PrepareTurnActor(t=t, event=event, _initial_done=done, names=names, now=now, first=first, soon=soon, linked=linked)


actor PrepareTurnActor(t: testing.AsyncT, event: str, _initial_done, names, now, first, soon, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var phase = 0
    var ran = False
    var done = _initial_done

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def succeed() -> None:
        if not done:
            done = True
            t.success()

    def report(name: str, s: y1_oper.stratoweave_rfs__rfs__device__state) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), s, None)

    def act() -> None:
        cc = controller
        if event == "prepared" or event == "failed":
            state = "done" if event == "prepared" else "failed"
            report("cpe-1", _tagged_prepare("upgrade-needed", "soon", "17.18.03a", state,
                                            "17.18.03a"))
        elif cc is not None:
            if event == "run to plan":
                cc.on_conf(_soon(names, "plan", True, now).0, linked)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "soon")
        staged = _staged(out)
        if phase == 0:
            if len(staged) == 0:
                return
            if event == "plan to run" and not ran:
                fail("in plan, the campaign let {staged} prepare")
            elif vetoed != names or staged != [first]:
                fail("at the first turn: vetoed {vetoed}, let prepare {staged}")
            elif event == "first" or event == "down" or event == "plan to run":
                succeed()
            else:
                phase = 1
                act()
        elif vetoed != names or staged != []:
            fail("after {event}: vetoed {vetoed}, let prepare {staged}")
        else:
            succeed()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or event != "plan to run" or ran:
            return
        answered = 0
        for name in names:
            r = oper!.state.device_status.get(name)
            if r is not None and r.status == "upgrade-needed":
                answered += 1
        cc = controller
        if answered == len(names) and cc is not None:
            ran = True
            cc.on_conf(_soon(names, "run", True, now).0, linked)

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(soon.0, linked)
        for name in names:
            report(name, _tagged("unknown" if event == "down" and name == "cpe-1" else "upgrade-needed",
                                 "soon", "17.18.03a"))
        ctl.on_subscriptions_synced()
        after 5.0: fail("at phase {phase} of {event}, no output came")



actor _test_campaign_lets_one_member_prepare(t: testing.AsyncT):
    """In run with allow-staging, the campaign lets the first member prepare
    at once, and holds every member."""

    def __startup__():
        _PrepareTurn(t, "first")


actor _test_campaign_gives_no_turn_to_a_member_that_is_down(t: testing.AsyncT):
    """A member that is down when it answers, and so reports unknown, gets
    no turn: the next member goes first."""

    def __startup__():
        _PrepareTurn(t, "down")


actor _test_campaign_plan_to_run_lets_the_first_member_prepare(t: testing.AsyncT):
    """In plan, no member prepares. Set to run, the campaign lets the first
    member prepare at once."""

    def __startup__():
        _PrepareTurn(t, "plan to run")


actor _test_campaign_ends_a_turn_when_prepared(t: testing.AsyncT):
    """The campaign stops letting a member prepare once its prepare is
    done, and it keeps the veto."""

    def __startup__():
        _PrepareTurn(t, "prepared")


actor _test_campaign_ends_a_turn_when_the_prepare_fails(t: testing.AsyncT):
    """A member down at its turn fails its prepare. The campaign stops
    letting it prepare, and does not let it again."""

    def __startup__():
        _PrepareTurn(t, "failed")


actor _test_campaign_run_to_plan_ends_the_turns(t: testing.AsyncT):
    """Set back to plan, the campaign lets no member prepare."""

    def __startup__():
        _PrepareTurn(t, "run to plan")


proc def _test_campaign_without_allow_staging_prepares_nothing(t: testing.AsyncT):
    """The campaign soon without allow-staging: a decision after the
    members answered lets no member prepare."""
    answered = False
    names = ["cpe-1", "cpe-2", "cpe-3"]
    soon = _soon(names, "run", False, time.time().unix_s())

    TestCampaignWithoutAllowStagingPreparesNothingActor(t=t, _initial_answered=answered, names=names, soon=soon)


actor TestCampaignWithoutAllowStagingPreparesNothingActor(t: testing.AsyncT, _initial_answered, names, soon):
    var answered = _initial_answered
    var staged: list[str] = []
    var outputs = 0

    def on_output(out: gdata.Node) -> None:
        outputs += 1
        for name in _staged(out):
            staged.append(name)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is None:
            return
        n = 0
        for name in names:
            r = oper!.state.device_status.get(name)
            if r is not None and r.status == "upgrade-needed":
                n += 1
        if n == len(names):
            answered = True

    def finish() -> None:
        if not answered:
            t.failure(ValueError("no decision saw the members answer"))
        elif outputs == 0 or len(staged) > 0:
            t.failure(ValueError("{outputs} output(s), let prepare {staged}"))
        else:
            t.success()

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 2.5: finish()



proc def _test_campaign_lets_a_member_added_late_prepare(t: testing.AsyncT):
    t.timeout(6.0)
    """The campaign soon over cpe-1 alone lets cpe-1 prepare at once, and
    has no turn left. cpe-2 is added: the campaign holds it, and cpe-1 stays
    let. cpe-1's prepare is done, so it is no longer let. When cpe-2
    answers, it goes at once."""
    done = False
    now = time.time().unix_s()
    one = _soon(["cpe-1"], "run", True, now)
    both = _soon(["cpe-1", "cpe-2"], "run", True, now)
    linked = both.1.to_gdata()

    TestCampaignLetsAMemberAddedLatePrepareActor(t=t, _initial_done=done, one=one, both=both, linked=linked)


actor TestCampaignLetsAMemberAddedLatePrepareActor(t: testing.AsyncT, _initial_done, one, both, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = _initial_done

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "soon")
        staged = _staged(out)
        got = "vetoed {vetoed}, let prepare {staged}"
        cc = controller
        if stage == 0:
            if len(staged) == 0:
                return
            if vetoed != ["cpe-1"] or staged != ["cpe-1"]:
                fail("at the first turn: {got}")
            elif cc is not None:
                stage = 1
                cc.on_conf(both.0, linked)
        elif stage == 1:
            if vetoed != ["cpe-1", "cpe-2"] or staged != ["cpe-1"]:
                fail("once cpe-2 is added: {got}")
            elif cc is not None:
                stage = 2
                cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                          _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "done",
                                          "17.18.03a"), None)
        elif stage == 2:
            if vetoed != ["cpe-1", "cpe-2"] or staged != []:
                fail("once cpe-1 is prepared: {got}")
            elif cc is not None:
                stage = 3
                cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-2"), device_name="cpe-2"),
                          _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        elif vetoed == ["cpe-1", "cpe-2"] and staged == ["cpe-2"]:
            done = True
            t.success()
        else:
            fail("once cpe-2 answered: {got}")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(one.0, linked)
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: fail("at stage {stage}, no output came")



def _prepare_starts(o: y0_oper.software__software__upgrade_campaign_entry) -> dict[str, int]:
    """The prepare-start of each device in the plan of o that has one."""
    starts: dict[str, int] = {}
    for win in o.state.plan.window:
        for dev in win.device:
            s = dev.prepare_start
            if s is not None:
                starts[dev.name] = int(s)
    return starts


def _by_start(starts: dict[str, int]) -> list[str]:
    """The names in starts, by their start."""
    pairs: list[(int, str)] = []
    for name, s in starts.items():
        pairs.append((s, name))
    return [e.1 for e in sorted(pairs)]


def _with_image(campaign: InputCampaign, name: str, image: str) -> InputCampaign:
    """campaign with image as the image of its member name."""
    member = campaign.device.get(name)
    if member is not None:
        member.image = image
    return campaign


proc def _test_campaign_in_plan_shows_prepares_and_writes_none(t: testing.AsyncT):
    t.timeout(6.0)
    """The campaign soon in plan with allow-staging, once its members have
    answered: the plan shows when each member would prepare in a run that
    starts now, 30 minutes apart and one at a time. It shows that the
    members may prepare before the first window, not between windows, as
    all fit before it, and not during windows, and the cap of 1 Gbit/s.
    Each prepare takes 1 s and copies the image of 962330352 bytes, so the
    bandwidth goes to 7698642816 bit/s at each prepare-start and back to 0
    a second later, and that is the peak. The campaign lets no member
    prepare, and no member counts as preparing or prepared."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    now = time.time().unix_s()
    soon = _soon(names, "plan", True, now)

    TestCampaignInPlanShowsPreparesAndWritesNoneActor(t=t, names=names, now=now, soon=soon)


actor TestCampaignInPlanShowsPreparesAndWritesNoneActor(t: testing.AsyncT, names, now, soon):
    var staged: list[str] = []
    var outputs = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        outputs += 1
        for name in _staged(out):
            staged.append(name)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        starts = _prepare_starts(o)
        # The first publication comes before the answers, with no turns.
        if len(starts) < len(names):
            return
        done = True
        order = _by_start(starts)
        first = starts.get_def("cpe-1", 0)
        gaps = [starts.get_def("cpe-2", 0) - first, starts.get_def("cpe-3", 0) - first]
        pl = o.state.plan
        bw = IMAGE_SIZE * 8
        # Each step from the prepare-start of its prepare.
        steps: list[(int, int)] = []
        for e in pl.prepare_bandwidth:
            k = len(steps) // 2
            base = starts.get_def(order[k], 0) if k < len(order) else 0
            level = e.bandwidth
            steps.append((int(e.time) - base, int(level) if level is not None else -1))
        got = ("order {order}, first {first - now}, gaps {gaps}, "
               + "concurrency {pl.prepare_concurrency}, "
               + "before {pl.prepare_before_first_window}, "
               + "between {pl.prepare_between_windows}, during {pl.prepare_during_windows}, "
               + "max {pl.prepare_max_bandwidth}, peak {pl.prepare_peak_bandwidth}, "
               + "steps {steps}, "
               + "preparing {o.state.preparing}, prepared {o.state.prepared}, "
               + "{outputs} output(s), let prepare {staged}")
        if order != names or first < now or first > now + 2 \
           or gaps[0] < 1795 or gaps[0] > 1800 or gaps[1] < 3590 or gaps[1] > 3600 \
           or pl.prepare_concurrency != u64(1) \
           or str(pl.prepare_before_first_window) != "True" \
           or str(pl.prepare_between_windows) != "False" \
           or str(pl.prepare_during_windows) != "False" \
           or pl.prepare_max_bandwidth != u64(1000000000) \
           or pl.prepare_peak_bandwidth != u64(bw) \
           or steps != [(0, bw), (1, 0), (0, bw), (1, 0), (0, bw), (1, 0)] \
           or o.state.preparing != u64(0) or o.state.prepared != u64(0) \
           or outputs == 0 or len(staged) > 0:
            t.failure(ValueError(got))
        else:
            t.success()

    def __startup__():
        # Through the proc parameter, a bare on_oper would run in the campaign's
        # actor, before this actor has taken the output that the campaign wrote
        # first. self.on_oper comes as a message, after that output.
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None, self.on_oper, None)
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: fail("no plan showed a prepare-start for every member")



proc def _test_campaign_shows_the_prepares(t: testing.AsyncT):
    t.timeout(6.0)
    """The campaign soon in run with allow-staging. cpe-1 has prepared,
    cpe-2 failed to prepare, cpe-3 is in its upgrade and its run prepares,
    cpe-4 waits to prepare, and the image of cpe-5 is not in the image
    list. Only cpe-1 counts, as prepared: the run of cpe-3 is not a
    prepare. The rows show each prepare as the device reports it. The
    alarms are the plan's, then the failed prepare, then the image's. The
    campaign lets cpe-4 prepare at once, and it alone prepares."""
    done = False
    names = ["cpe-1", "cpe-2", "cpe-3", "cpe-4", "cpe-5"]
    soon = _soon(names, "run", True, time.time().unix_s())
    campaign = _with_image(soon.0, "cpe-5", "missing.bin")
    reports = [
        ("cpe-1", _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "done", "17.18.03a")),
        ("cpe-2", _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "failed", "17.18.03a")),
        ("cpe-3", _tagged_prepare("in-progress", "soon", "17.18.03a", "running", "17.18.03a")),
        ("cpe-4", _tagged("upgrade-needed", "soon", "17.18.03a")),
    ]

    TestCampaignShowsThePreparesActor(t=t, _initial_done=done, names=names, soon=soon, campaign=campaign, reports=reports)


actor TestCampaignShowsThePreparesActor(t: testing.AsyncT, _initial_done, names, soon, campaign, reports):
    var done = _initial_done

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def row(o: y0_oper.software__software__upgrade_campaign_entry, name: str) -> str:
        r = o.state.device_status.get(name)
        if r is not None:
            return "{name} {r.status} prepare {r.prepare.state} {r.prepare.release}"
        return "{name} missing"

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        rows = [row(o, name) for name in names]
        # Wait for the publication that has every report.
        if rows[:4] != ["cpe-1 upgrade-needed prepare done 17.18.03a",
                        "cpe-2 upgrade-needed prepare failed 17.18.03a",
                        "cpe-3 in-progress prepare running 17.18.03a",
                        "cpe-4 upgrade-needed prepare None None"]:
            return
        done = True
        got = ["preparing {o.state.preparing}, prepared {o.state.prepared}",
               "starts " + ", ".join(_by_start(_prepare_starts(o))),
               "concurrency {o.state.plan.prepare_concurrency}"] + list(o.state.plan.alarm)
        want = ["preparing 0, prepared 1",
                "starts cpe-4",
                "concurrency 1",
                "1 device(s) have not answered the campaign's target: cpe-5",
                "1 device(s) failed to prepare and copy the image in their window: cpe-2",
                "image missing.bin is not in the image list (1 device)"]
        if got != want:
            t.failure(ValueError("{got}"))
        else:
            t.success()

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), lambda o: None, lambda d: None, on_oper, None)
        ctl.on_conf(campaign, soon.1.to_gdata())
        for r in reports:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(r.0), device_name=r.0), r.1, None)
        ctl.on_subscriptions_synced()
        after 5.0: fail("no publication had every report")



proc def _test_campaign_forgets_the_prepare_of_a_member_that_goes(t: testing.AsyncT):
    """Run the campaign soon over cpe-1 and cpe-2 with allow-staging. cpe-1
    failed to prepare, and cpe-2 has prepared. Once the campaign shows the
    alarm for cpe-1 and counts cpe-2 as prepared, cpe-1's state goes, as
    when its flotilla no longer has it. The campaign drops the alarm, and
    cpe-2 still counts as prepared."""
    names = ["cpe-1", "cpe-2"]
    soon = _soon(names, "run", True, time.time().unix_s())
    alarm = "1 device(s) failed to prepare and copy the image in their window: cpe-1"

    PrepareAlarmActor(t=t, soon=soon, alarm=alarm)


actor PrepareAlarmActor(t: testing.AsyncT, soon, alarm):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var phase = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        alarms = list(o.state.plan.alarm)
        cc = controller
        if phase == 0:
            if alarm not in alarms:
                return
            if o.state.prepared != u64(1):
                fail("before cpe-1 went: prepared {o.state.prepared}")
            elif cc is not None:
                phase = 1
                cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), None, None)
        elif alarm not in alarms:
            if o.state.prepared != u64(1):
                fail("after cpe-1 went: prepared {o.state.prepared}")
            else:
                done = True
                t.success()

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), lambda o: None, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(6.0)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "failed", "17.18.03a"), None)
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-2"), device_name="cpe-2"),
                   _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "done", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: fail("at phase {phase}, the alarm stayed")



actor _NoticePlan(t: testing.AsyncT, paused: bool):
    """Plan a campaign called paced, in plan, with cpe-1 and a notification
    period of a day. Its schedule has a window that opens an hour from now
    every day. Paused, the campaign has a run-since of a day ago less one
    second in its memory, so its notice cut is a second from now. Before
    its first run it has no memory and plans a run that starts now, so its
    cut is a day from now. cpe-1 answers before the sync, and the sync plans
    again. Pass t when each plan up to the one with the answer starts with
    the first window after the cut, and the campaign publishes the
    run-since of its memory."""
    start = time.time().unix_s()
    since = start - 86400 + 1
    first = start + 3600 if paused else start + 3600 + 86400
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        want: ?int = None
        if paused:
            want = since
        got: ?int = None
        r = o.state.run_since
        if r is not None:
            got = int(r)
        starts = sorted([int(w.start) for w in o.state.plan.window])
        ds = o.state.device_status.get("cpe-1")
        if got != want:
            fail("run-since {got}, not {want}")
        elif len(starts) == 0 or starts[0] != first:
            fail("the windows open {[s - start for s in starts]} s from now, not {first - start}")
        elif ds is not None and ds.status == "upgrade-needed":
            done = True
            t.success()

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda o: None, lambda d: None, on_oper, None)

    def __startup__():
        linked = _flat_inventory(["cpe-1"])
        sched = linked.schedules.schedule.create("nightly")
        conf = _paced_campaign(["cpe-1"])
        conf.admin_state = "plan"
        conf.notification_period = u64(1)
        sched.window.create(u64(1), at=u64((start + 3600) % 86400), duration=u64(600))
        ctl.on_conf(conf, linked.to_gdata(), InputMemory(run_since=u64(since)) if paused else None)
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("upgrade-needed", "paced", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 2.0: fail("the campaign published no plan with the answer of cpe-1")



actor _test_campaign_in_plan_plans_from_now_and_the_notice(t: testing.AsyncT):

    def __startup__():
        _NoticePlan(t, False)


actor _test_campaign_in_a_pause_plans_from_its_run_since(t: testing.AsyncT):

    def __startup__():
        _NoticePlan(t, True)


actor _NoticeRelease(t: testing.AsyncT, period: int):
    """Run a campaign called paced with cpe-1, one at a time, and a
    notification period of period days. Its run began a day ago, less one
    second. Its schedule has a window that opened a minute ago and is open
    for 30 min, and a window that opens 3 s from now. cpe-1 needs the
    upgrade. Pass t when the campaign releases cpe-1: with no notice before
    the second window opens, and with a day of notice once it opens."""
    start = time.time().unix_s()
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "paced")
        if free == ["cpe-1"]:
            at = time.time().unix_s() - start
            released_in_time = False
            if period == 0 and at < 3:
                released_in_time = True
            elif period > 0 and at >= 3:
                released_in_time = True
            if released_in_time:
                done = True
                t.success()
            else:
                fail("with a notice of {period} day(s), cpe-1 was released after {at} s")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        linked = _flat_inventory(["cpe-1"])
        sched = linked.schedules.schedule.create("nightly")
        conf = _paced_campaign(["cpe-1"])
        conf.target_concurrency = u64(1)
        conf.max_concurrency = u64(1)
        conf.notification_period = u64(period)
        sched.window.create(u64(1), at=u64((start - 60) % 86400), duration=u64(1800))
        sched.window.create(u64(2), at=u64((start + 3) % 86400), duration=u64(1800))
        ctl.on_conf(conf, linked.to_gdata(), InputMemory(run_since=u64(start - 86400 + 1)))
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("upgrade-needed", "paced", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 6.0: fail("with a notice of {period} day(s), cpe-1 was not released")



actor _test_campaign_without_notice_releases_in_the_open_window(t: testing.AsyncT):

    def __startup__():
        _NoticeRelease(t, 0)


actor _test_campaign_releases_in_the_first_window_after_the_notice(t: testing.AsyncT):

    def __startup__():
        _NoticeRelease(t, 1)


proc def _test_campaign_keeps_run_since_through_a_pause_and_a_restart(t: testing.EnvT):
    t.timeout(10.0)
    """A campaign keeps the time of the edit that first set it to run as
    run-since. It is set to plan and to run again more than a second later.
    Then fleetmgr restarts: a new layer stack restores the database of the
    first, and recomputes. The campaign publishes the first run-since again,
    so the pause did not set it again, and the database kept it."""
    fc = file.FileCap(t.env.cap)
    fs = file.FS(fc)
    db_path = fs.mktmpdir("test_campaign_run_since_")
    cap = file.WriteFileCap(fc)
    db = swlmdb.LmdbStore(cap, db_path)
    layer = sysspec.get_layers(
        swdev.DeviceRegistry(sysspec.device_types, log_handler=t.log_handler), t.log_handler, db)
    first = -1
    root = y_0.root()
    campaign = root.software.upgrade_campaign.create("kept", admin_state="run",
                                                     notification_period=u64(2))

    TestCampaignKeepsRunSinceThroughAPauseAndARestartActor(
        t=t,
        fs=fs,
        db_path=db_path,
        cap=cap,
        _initial_db=db,
        _initial_layer=layer,
        _initial_first=first,
        root=root,
        campaign=campaign
    )


actor TestCampaignKeepsRunSinceThroughAPauseAndARestartActor(t: testing.EnvT, fs, db_path, cap, _initial_db, _initial_layer, _initial_first, root, campaign):
    var db = _initial_db
    var layer = _initial_layer
    var first = _initial_first
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def published() -> ?int:
        """The run-since that the campaign publishes, or None."""
        c = y0_oper.root.from_gdata(layer.get_data()).software.upgrade_campaign.get("kept")
        if c is not None:
            r = c.state.run_since
            if r is not None:
                return int(r)
        return None

    def cleanup() -> None:
        await async db.db.close()
        await async fs.rmtree(db_path)
        await async fs.rmdir(db_path)

    def restored_published(tries: int) -> None:
        got = published()
        if got is not None:
            cleanup()
            if got == first:
                done = True
                t.success()
            else:
                fail("after the restart, run-since is {got}, not {first}")
        elif tries > 0:
            after 0.05: restored_published(tries - 1)
        else:
            fail("after the restart, the campaign published no run-since")

    def recomputed(r: value) -> None:
        if isinstance(r, Exception):
            fail("the recompute after the restart failed: {r}")
            return
        restored_published(60)

    def restored(error: ?Exception) -> None:
        if error is not None:
            fail("the restore failed: {error}")
            return
        layer.newsession().recompute(recomputed)

    def restart() -> None:
        await async db.db.close()
        db = swlmdb.LmdbStore(cap, db_path)
        layer = sysspec.get_layers(
            swdev.DeviceRegistry(sysspec.device_types, log_handler=t.log_handler),
            t.log_handler, db)
        layer.load_from_db(restored)

    def resumed(r: value) -> None:
        if isinstance(r, Exception):
            fail("the edit to run again failed: {r}")
            return
        after 0.3: restart()

    def paused(r: value) -> None:
        if isinstance(r, Exception):
            fail("the edit to plan failed: {r}")
            return
        campaign.admin_state = "run"
        layer.edit_config(root.to_gdata(), None, resumed)

    def pause() -> None:
        campaign.admin_state = "plan"
        layer.edit_config(root.to_gdata(), None, paused)

    def first_published(tries: int) -> None:
        got = published()
        if got is not None:
            first = got
            after 1.1: pause()
        elif tries > 0:
            after 0.05: first_published(tries - 1)
        else:
            fail("the campaign published no run-since")

    def ran(r: value) -> None:
        if isinstance(r, Exception):
            fail("the edit to run failed: {r}")
            return
        first_published(60)

    def __startup__():
        layer.edit_config(root.to_gdata(), None, ran)


#############################################################################
# The image lock: the campaign keeps the image of each member that it has
# let prepare or released
#############################################################################

def _lock_campaign(admin_state: str, members: list[(str, str, int)]) -> InputCampaign:
    """Campaign A in admin_state over members, each as (device, image,
    attempt), in one window that is open now."""
    campaign = InputCampaign(name="A", admin_state=admin_state)
    for m in members:
        campaign.device.create(m.0, image=m.1, attempt=u64(m.2))
    return campaign


def _lock_rows(out: ?gdata.Node) -> list[str]:
    """Each device in out, written by a campaign, as "device campaign target
    attempt held", or free without its campaign's veto, with " locked" when
    it has image-locked and " failed" when it has attempt-failed, sorted."""
    lines: list[str] = []
    if out is not None:
        for flotilla in y_1.root.from_gdata(out).rfs:
            for dev in flotilla.device:
                sw = dev.software
                c = sw.upgrade_campaign
                if c is not None:
                    written = sw.attempt
                    attempt = written if written is not None else u64(0)
                    held = "held" if sw.veto.get(cfs.veto_holder(c)) is not None else "free"
                    marks = ""
                    locked = sw.image_locked
                    if locked is not None and locked:
                        marks += " locked"
                    failed = sw.attempt_failed
                    if failed is not None and failed:
                        marks += " failed"
                    lines.append("{dev.name} {c} {sw.target_release} {attempt} {held}{marks}")
    return sorted(lines)


actor _CaseResults(t: testing.EnvT, names: list[str]):
    """Collect the result of each case, and pass t when every case
    passes."""
    var results: dict[str, ?str] = {}
    var done = False

    def on_case(name: str, error: ?str) -> None:
        if done:
            return
        results[name] = error
        if len(results) == len(names):
            done = True
            failed = ["{n}: {results[n]}" for n in names if results[n] is not None]
            if len(failed) == 0:
                t.success()
            else:
                t.failure(ValueError("; ".join(failed)))


actor MarksActor(case: str, conf: InputCampaign, linked: gdata.Node,
                 reports: list[(str, y1_oper.stratoweave_rfs__rfs__device__state)], late: bool,
                 status: str, want: list[str], report: action(str, ?str) -> None):
    """Run the actor of campaign conf over linked, tell it reports, each as
    (device, state), and sync, or sync first when late. Report case, and
    what went wrong or None, once cpe-1 shows status and the output written
    last has the marks want, as _mark_rows() gives them."""
    var marked: list[str] = []
    var seen = "nothing"
    var done = False

    def finish(error: ?str) -> None:
        if not done:
            done = True
            report(case, error)

    def on_output(out: gdata.Node) -> None:
        marked = _mark_rows(out)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None:
            r = oper.state.device_status.get("cpe-1")
            got = r.status if r is not None else None
            seen = "cpe-1 {got}, marked {marked}"
            if got == status and marked == want:
                finish(None)

    def timeout() -> None:
        finish(seen)

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path(conf.name), self.on_output,
                                           lambda d: None, self.on_oper, None)
        ctl.on_conf(conf, linked)
        if late:
            ctl.on_subscriptions_synced()
        for r in reports:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(r.0), device_name=r.0), r.1, None)
        if not late:
            ctl.on_subscriptions_synced()
        after now 5.0: timeout()


proc def _test_campaign_marks_its_members(t: testing.EnvT):
    """The actor marks image-locked each member that it lets prepare or
    releases. A member that waits or that is up to date is not marked. The
    actor marks attempt-failed each member whose attempt failed, rolled
    back, failed its rollback or did not start, in run and in plan, also
    when the report comes after the replay. In run, cpe-2 never answers, so
    the campaign is not complete and frees no member."""
    t.timeout(10.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    now = time.time().unix_s()
    linked = _rules_inventory(RULES_IMAGES).to_gdata()
    soon = _soon(names, "run", True, now)
    run = _lock_campaign("run", [("cpe-1", IMAGE, 0), ("cpe-2", IMAGE, 0)])
    plan = _lock_campaign("plan", [("cpe-1", IMAGE, 0)])
    answered = [(name, _tagged("upgrade-needed", "soon", "17.18.03a")) for name in names]
    # (case, the campaign, its linked input, what each device reports, the
    # status of cpe-1 once it is published, and the members marked)
    cases: list[(str, InputCampaign, gdata.Node,
                 list[(str, y1_oper.stratoweave_rfs__rfs__device__state)], str, list[str])] = [
        ("let prepare", soon.0, soon.1.to_gdata(), answered, "upgrade-needed", ["cpe-1 locked"]),
        ("released", run, linked, [("cpe-1", _tagged("upgrade-needed", "A", "17.18.03a"))],
         "upgrade-needed", ["cpe-1 locked"]),
        ("up to date", run, linked, [("cpe-1", _tagged("up-to-date", "A", "17.18.03a"))],
         "up-to-date", []),
        ("waits in plan", plan, linked, [("cpe-1", _tagged("upgrade-needed", "A", "17.18.03a"))],
         "upgrade-needed", []),
        ("failed", plan, linked, [("cpe-1", _tagged("failed", "A", "17.18.03a"))], "failed",
         ["cpe-1 failed"]),
        ("failed, in run", run, linked, [("cpe-1", _tagged("failed", "A", "17.18.03a"))],
         "failed", ["cpe-1 failed"]),
        ("rolled back", plan, linked, [("cpe-1", _tagged("rolled-back", "A", "17.18.03a"))],
         "rolled-back", ["cpe-1 failed"]),
        ("failed its rollback", plan, linked,
         [("cpe-1", _attempt_state("failed", "A", "17.18.03a", u64(0), "rollback", None).0)],
         "failed", ["cpe-1 failed"]),
        ("not started", plan, linked, [("cpe-1", _tagged("not-started", "A", "17.18.03a"))],
         "not-started", ["cpe-1 failed"]),
    ]
    # The same, with the reports after the sync.
    late: list[(str, InputCampaign, gdata.Node,
                list[(str, y1_oper.stratoweave_rfs__rfs__device__state)], str, list[str])] = [
        ("failed after the replay, in plan", plan, linked,
         [("cpe-1", _tagged("failed", "A", "17.18.03a"))], "failed", ["cpe-1 failed"]),
    ]
    collector = _CaseResults(t, [c.0 for c in cases] + [c.0 for c in late])
    for c in cases:
        MarksActor(c.0, c.1, c.2, c.3, False, c.4, c.5, collector.on_case)
    for c in late:
        MarksActor(c.0, c.1, c.2, c.3, True, c.4, c.5, collector.on_case)


proc def _test_campaign_takes_its_locks_from_memory(t: testing.AsyncT):
    """A new actor of campaign A, in plan, as after a restart of fleetmgr,
    marks cpe-1, which the memory locks, and not cpe-2. Once cpe-1 leaves
    the campaign, it loses the mark, also when it joins again."""
    t.timeout(6.0)
    linked = _rules_inventory(RULES_IMAGES).to_gdata()
    both = _lock_campaign("plan", [("cpe-1", IMAGE, 0), ("cpe-2", IMAGE, 0)])
    without = _lock_campaign("plan", [("cpe-2", IMAGE, 0)])
    memory = InputMemory()
    memory.member.create("cpe-1", image=IMAGE, target_release="17.18.03a", image_locked=True)
    memory.member.create("cpe-2", image=IMAGE, target_release="17.18.03a")
    left = InputMemory()
    left.member.create("cpe-2", image=IMAGE, target_release="17.18.03a")
    again = InputMemory()
    again.member.create("cpe-1", image=IMAGE, target_release="17.18.03a")
    again.member.create("cpe-2", image=IMAGE, target_release="17.18.03a")
    LocksFromMemoryActor(t=t, linked=linked, both=both, without=without, memory=memory,
                         left=left, again=again)


actor LocksFromMemoryActor(t: testing.AsyncT, linked, both, without, memory, left, again):
    var outputs: list[list[str]] = []
    var done = False

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        outputs.append(_mark_rows(out))
        if len(outputs) == 3:
            done = True
            want = [["cpe-1 locked"], [], []]
            if outputs == want:
                t.success()
            else:
                t.failure(ValueError("marked {outputs}, not {want}"))

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("A"), self.on_output, lambda d: None,
                                           lambda o: None, None)
        ctl.on_conf(both, linked, memory)
        ctl.on_conf(without, linked, left)
        ctl.on_conf(both, linked, again)


proc def _test_campaign_marks_a_member_that_an_ask_lets_prepare(t: testing.AsyncT):
    """Run the campaign soon over cpe-1 to cpe-3 with allow-staging. cpe-1
    is let prepare at once, and its prepare is done. cpe-3 waits for its
    turn, and the campaign has not touched it. An operator then raises the
    prepare-attempt of cpe-3, and the campaign lets cpe-3 prepare at once.
    Pass t when the write that lets cpe-3 prepare marks it image-locked."""
    t.timeout(6.0)
    names = ["cpe-1", "cpe-2", "cpe-3"]
    now = time.time().unix_s()
    AskMarksActor(t=t, names=names, soon=_soon(names, "run", True, now),
                  asked=_asked(names, "cpe-3", now))


actor AskMarksActor(t: testing.AsyncT, names, soon, asked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var marked: list[str] = []
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        staged = _staged(out)
        marked = _mark_rows(out)
        cc = controller
        if stage == 0 and staged == ["cpe-1"] and cc is not None:
            stage = 1
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged_prepare("upgrade-needed", "soon", "17.18.03a", "done", "17.18.03a"),
                      None)
        elif stage == 2:
            # The first write after the ask is the one that lets cpe-3.
            if "cpe-3" in staged and "cpe-3 locked" in marked:
                done = True
                t.success()
            else:
                fail("the write after the ask lets prepare {staged}, and marks {marked}")

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        r = oper!.state.device_status.get("cpe-1")
        cc = controller
        if stage == 1 and r is not None and r.prepare.state == "done" and cc is not None:
            if "cpe-3 locked" in marked:
                fail("cpe-3 is marked before the ask")
                return
            stage = 2
            cc.on_conf(asked.0, asked.1.to_gdata())

    def timeout() -> None:
        fail("at stage {stage}, cpe-3 was not let prepare: marked {marked}")

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("soon"), on_output, lambda d: None,
                                           self.on_oper, None)
        controller = ctl
        ctl.on_conf(soon.0, soon.1.to_gdata())
        for name in names:
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _tagged("upgrade-needed", "soon", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()


#############################################################################
# Campaigns on a layer like fleetmgr's top: the campaign's transform function
# and actor in TTT
#############################################################################

def _request_text(d: ?gdata.Node) -> str:
    """A dynstate write of a campaign as text: the number of the request
    and each result as "device attempt status stage reason", with " late"
    when it was freed before it was done."""
    rows: list[str] = []
    request = InputDynstate.from_gdata(d)
    for device, r in cfs.requested_results(request).items():
        late = ""
        if r.finished <= 0 or r.freed < r.finished:
            late = " late"
        rows.append("{device} {r.attempt} {r.status} {r.stage} {r.reason}{late}")
    return "{cfs.asked_request(request)}: " + ", ".join(rows)


actor _Wire(write: action(gdata.Node) -> None, request: action(?gdata.Node) -> None):
    """The way from a campaign actor to its transform. It counts the writes
    of the output, and holds them, in order, while held. It logs the
    dynstate writes, and holds them, in order, while the requests are
    held."""
    var held = False
    var queue: list[gdata.Node] = []
    var writes = 0
    var requests_held = False
    var requests: list[?gdata.Node] = []
    var log: list[str] = []

    def output(conf: gdata.Node) -> None:
        writes += 1
        if held:
            queue.append(conf)
        else:
            write(conf)

    def dynstate(d: ?gdata.Node) -> None:
        log.append(_request_text(d))
        if requests_held:
            requests.append(d)
        else:
            request(d)

    def hold() -> None:
        held = True

    def release_one() -> None:
        if len(queue) > 0:
            write(queue[0])
            queue = queue[1:]

    def waiting() -> int:
        return len(queue)

    def hold_requests() -> None:
        requests_held = True

    def release_requests() -> None:
        requests_held = False
        for d in requests:
            request(d)
        requests = []

    def release_request() -> None:
        if len(requests) > 0:
            request(requests[0])
            requests = requests[1:]

    def seen() -> (int, list[str]):
        return (writes, list(log))


actor _Campaigns():
    """The actor of each campaign of a _campaign_stack(), and the _Wire that
    its writes go through, by the campaign's name."""
    var acts: dict[str, cfs.UpgradeCampaignTransform] = {}
    var wires: dict[str, _Wire] = {}

    def register(name: str, a: cfs.UpgradeCampaignTransform, w: _Wire) -> None:
        acts[name] = a
        wires[name] = w

    def actor_of(name: str) -> ?cfs.UpgradeCampaignTransform:
        return acts.get(name)

    def wire_of(name: str) -> ?_Wire:
        return wires.get(name)

    def clear() -> None:
        acts = {}
        wires = {}


def _campaign_links(conf: gdata.Node) -> list[ttt.TaggedPath]:
    """The links of a campaign, as fleetmgr's top generates them: the
    schedules, the redundancy groups, the image list, and the fleet entry of
    each member."""
    res = [ttt.TaggedPath("schedules", gdata.FNode(gdata.Id("urn:fleetmgr:maintenance", "schedules"))),
           ttt.TaggedPath("redundancy-groups",
                          gdata.FNode(gdata.Id("urn:fleetmgr:fleetmgr", "redundancy-groups"))),
           ttt.TaggedPath("images", gdata.FNode(gdata.Id(
               "http://stratoweave.org/yang/stratoweave-images", "images")))]
    devices = conf.get_opt_list(gdata.Id("urn:fleetmgr:software", "device"))
    if devices is not None:
        for e in devices.elements.values():
            name = e.get_opt_value(gdata.Id("urn:fleetmgr:software", "name"))
            if name is not None:
                res.append(ttt.TaggedPath("inventory", gdata.FNode(
                    gdata.Id("urn:fleetmgr:fleetmgr", "fleet"), children=[gdata.FNode(
                        gdata.Id("urn:fleetmgr:fleetmgr", "device"), children=[gdata.FNode(
                            gdata.Id("urn:fleetmgr:fleetmgr", "name"), value_match=name)])])))
    return res


def _campaign_stack(register: action(str, cfs.UpgradeCampaignTransform, _Wire) -> None,
                    log_handler: logging.Handler, db: swlmdb.LmdbStore) -> ttt.Layer:
    """A layer like fleetmgr's top, over a sink, with the campaigns' real
    transform function and actor. The actors hear from no device: a test
    tells them what each device reports. register gets each campaign's
    actor, and the _Wire that its writes go through."""
    lower = ttt.Sink()

    pure def input(c: gdata.Node):
        return InputCampaign.from_gdata(c)
    pure def memory(m: ?gdata.Node):
        return InputMemory.from_gdata(m) if m is not None else None
    pure def campaign_name(path: ttt.Path) -> str:
        return y0_oper.software__software__upgrade_campaign_entry.from_gdata(
            ttt.path_key_data(path)).name

    def make(params: ttt.TransformActorParams) -> ttt.TransformActor:
        wire = _Wire(params.write_output, params.update_dynstate)
        dyn = yadata.ToGdataPrevWrapper(wire.dynstate)
        oper = yadata.ToGdataPrevWrapper(params.update_oper)
        a = cfs.UpgradeCampaignTransform(params.path, wire.output, dyn.update, oper.update, None)
        register(campaign_name(params.path), a, wire)
        return ttt.TransformActor(action lambda c, l, m: a.on_conf(input(c), l, memory(m)),
                                  lambda m: a.shutdown(memory(m)))

    root = ttt.Container({
        gdata.Id("http://stratoweave.org/yang/stratoweave-images", "images"):
            ttt.Transform(image_list.ImageList, None, None, lower, log_handler),
        gdata.Id("urn:fleetmgr:maintenance", "schedules"):
            ttt.Transform(cfs.Schedules, None, None, lower, log_handler),
        gdata.Id("urn:fleetmgr:fleetmgr", "fleet"): ttt.Container({
            gdata.Id("urn:fleetmgr:fleetmgr", "device"):
                ttt.List(ttt.Transform(cfs.Device, None, None, lower, log_handler),
                         [gdata.Id("urn:fleetmgr:fleetmgr", "name")])},
            ns='urn:fleetmgr:fleetmgr', module='fleetmgr'),
        gdata.Id("urn:fleetmgr:fleetmgr", "redundancy-groups"):
            ttt.Transform(cfs.RedundancyGroups, None, None, lower, log_handler),
        gdata.Id("urn:fleetmgr:software", "software"): ttt.Container({
            gdata.Id("urn:fleetmgr:software", "upgrade-campaign"):
                ttt.List(ttt.Transform(cfs.UpgradeCampaign, make, _campaign_links, lower,
                                       log_handler),
                         [gdata.Id("urn:fleetmgr:software", "name")])},
            ns='urn:fleetmgr:software', module='software'),
    })
    return ttt.Layer("0", root, lower, db)


def _published(data: ?gdata.Node, name: str) -> ?y0_oper.software__software__upgrade_campaign_entry:
    """The campaign name in data, the configuration and state of the layer
    of the campaigns, when it has published its state."""
    if data is not None:
        c = y0_oper.root.from_gdata(data).software.upgrade_campaign.get(name)
        if c is not None and c.state.total is not None:
            return c
    return None


def _stack_root(campaigns: list[(str, str, list[(str, str, int, int)], str)],
                images: list[(str, str, str, int)], group: str) -> y_0.root:
    """The fleet and the image list images of _rules_inventory(), and
    campaigns, each as (name, admin-state, its members as (device, image,
    attempt, prepare-attempt), its failure budget or ""). Each campaign
    upgrades up to three devices at once, with no stagger, in a window that
    is open. group puts cpe-1 and cpe-2 in the redundancy group g, cpe-1
    first: "hold" with failure-policy hold, "apart" with pack and a
    min-separation of an hour, "continue" with neither, and "" in no
    group."""
    root = _rules_inventory(images)
    if group != "":
        for member in [("cpe-1", 1), ("cpe-2", 2)]:
            dev = root.fleet.device.get(member.0)
            if dev is not None:
                dev.redundancy_group = ["g"]
                dev.redundancy_priority = u64(member.1)
        if group == "hold":
            root.redundancy_groups.redundancy_group.create("g", failure_policy="hold")
        elif group == "apart":
            root.redundancy_groups.redundancy_group.create("g", separation_policy="pack",
                                                           min_separation=u64(3600))
        else:
            root.redundancy_groups.redundancy_group.create("g", failure_policy="continue")
    for c in campaigns:
        campaign = root.software.upgrade_campaign.create(c.0, admin_state=c.1,
                                                         target_concurrency=u64(3),
                                                         max_concurrency=u64(3), stagger=u64(0))
        if c.3 != "":
            campaign.failure_budget = Decimal.parse(c.3)
        for m in c.2:
            campaign.device.create(m.0, image=m.1, attempt=u64(m.2), prepare_attempt=u64(m.3))
    return root


def _acquired(sink: ?gdata.Node) -> list[str]:
    """Each device that a campaign has acquired in sink, the layer below the
    campaigns, as "device campaign attempt held", or free without its
    campaign's veto, sorted."""
    lines: list[str] = []
    if sink is not None:
        for flotilla in y_1.root.from_gdata(sink).rfs:
            for dev in flotilla.device:
                sw = dev.software
                c = sw.upgrade_campaign
                if c is not None:
                    written = sw.attempt
                    attempt = written if written is not None else u64(0)
                    held = "held" if sw.veto.get(cfs.veto_holder(c)) is not None else "free"
                    lines.append("{dev.name} {c} {attempt} {held}")
    return sorted(lines)


# The devices that a case can name as members.
STACK_DEVICES = ["cpe-1", "cpe-2", "cpe-3", "cpe-9"]


def _state_rows(c: y0_oper.software__software__upgrade_campaign_entry) -> list[str]:
    """Each member's device-status as "device status", with " freed" for a
    freed member, and then "counted succeeded failed in-progress"."""
    rows: list[str] = []
    for name in STACK_DEVICES:
        ds = c.state.device_status.get(name)
        if ds is not None:
            freed = " freed" if ds.freed is not None else ""
            rows.append("{name} {ds.status}{freed}")
    st = c.state
    return rows + ["counted {st.succeeded} {st.failed} {st.in_progress}"]


def _completed_text(c: y0_oper.software__software__upgrade_campaign_entry) -> str:
    """"complete" when the campaign publishes completed, the latest freed of
    its members, "" when it does not, and what is wrong otherwise."""
    completed = c.state.completed
    if completed is None:
        return ""
    last = u64(0)
    for name in STACK_DEVICES:
        ds = c.state.device_status.get(name)
        if ds is not None:
            f = ds.freed
            if f is not None and f > last:
                last = f
    if completed != last:
        return "completed {completed}, not the latest freed {last}"
    return "complete"


def _result_rows(c: y0_oper.software__software__upgrade_campaign_entry) -> list[str]:
    """Each freed member's device-status as "device status attempt stage
    reason", with " late" when it was freed before it was done, and " live"
    when it shows anything that its device reports."""
    rows: list[str] = []
    for name in STACK_DEVICES:
        ds = c.state.device_status.get(name)
        if ds is not None:
            freed = ds.freed
            finished = ds.finished
            late = " late"
            if freed is not None and finished is not None and finished > u64(0) \
               and freed >= finished:
                late = ""
            live = ""
            if ds.version is not None or ds.model is not None or len(ds.veto) > 0 \
               or ds.prepare.state is not None or ds.install.state is not None \
               or ds.precheck.verdict is not None or ds.held is not None:
                live = " live"
            if freed is not None:
                rows.append("{name} {ds.status} {ds.attempt} {ds.stage} {ds.reason}{late}{live}")
    return rows


class _Step(object):
    """One step of a _StackActor() case: an edit, what a device reports, or
    what to check. kind names it, and the step uses the fields that it
    needs:

    - edit: campaigns, images and group, as _stack_root() takes them; error
      is "" when TTT accepts the edit, and else a part of the error.
    - report: device reports status to the actor of campaign, for the
      intent of tag (campaign when "", none when "-"), target and attempt,
      with stage and connected, a veto of veto when not "", and a last boot
      boot seconds after the report when boot is not None.
    - gone, error: device's state goes; the actor's subscription fails.
    - sync: the actor's subscriptions are in sync, so it decides.
    - hold, release-one: hold the output writes of the actor of campaign,
      or let the first held write go on. queued: the actor has want[0]
      writes held.
    - hold-requests, release-requests: hold the dynstate writes of the
      actor of campaign, or let them go on. release-request: let the first
      held one go on, and hold the others.
    - wait: seconds pass. restart: fleetmgr restarts from its database.
    - mark, quiet: count the actor's writes; seconds later, check that it
      wrote nothing more.
    - config: the configuration is that of the last edit TTT accepted.
    - acquired, rows, state, results, requests, row, held, apart, kept,
      later: check want."""
    kind: str
    campaign: str
    campaigns: list[(str, str, list[(str, str, int, int)], str)]
    images: list[(str, str, str, int)]
    group: str
    error: str
    device: str
    status: str
    tag: str
    attempt: int
    target: str
    stage: ?str
    connected: ?bool
    veto: str
    boot: ?int
    seconds: float
    want: list[str]
    complete: bool

    def __init__(self, kind: str, campaign: str,
                 campaigns: list[(str, str, list[(str, str, int, int)], str)],
                 images: list[(str, str, str, int)], group: str, error: str, device: str,
                 status: str, tag: str, attempt: int, target: str, stage: ?str,
                 connected: ?bool, veto: str, boot: ?int, seconds: float, want: list[str],
                 complete: bool):
        self.kind = kind
        self.campaign = campaign
        self.campaigns = campaigns
        self.images = images
        self.group = group
        self.error = error
        self.device = device
        self.status = status
        self.tag = tag
        self.attempt = attempt
        self.target = target
        self.stage = stage
        self.connected = connected
        self.veto = veto
        self.boot = boot
        self.seconds = seconds
        self.want = want
        self.complete = complete


def _step(kind: str, campaign: str="", device: str="", seconds: float=0.0,
          want: list[str]=[], complete: bool=False) -> _Step:
    """A step that is not an edit or a report."""
    return _Step(kind, campaign, [], [], "", "", device, "", "", 0, "17.18.03a", None, None, "",
                 None, seconds, want, complete)


def _do_edit(campaigns: list[(str, str, list[(str, str, int, int)], str)],
             images: list[(str, str, str, int)]=RULES_IMAGES, group: str="",
             error: str="") -> _Step:
    """An edit to campaigns, the image list images and group."""
    return _Step("edit", "", campaigns, images, group, error, "", "", "", 0, "17.18.03a", None,
                 None, "", None, 0.0, [], False)


def _do_report(campaign: str, device: str, status: str, attempt: int=0, tag: str="",
               target: str="17.18.03a", stage: ?str=None, connected: ?bool=None,
               veto: str="", boot: ?int=None) -> _Step:
    """What device reports to the actor of campaign."""
    return _Step("report", campaign, [], [], "", "", device, status, tag, attempt, target, stage,
                 connected, veto, boot, 0.0, [], False)


def _a(admin: str, members: list[(str, str, int, int)],
       budget: str="") -> (str, str, list[(str, str, int, int)], str):
    """Campaign A in admin with members, and budget."""
    return ("A", admin, members, budget)


def _m(device: str, image: str=IMAGE, attempt: int=0,
       prepare_attempt: int=0) -> (str, str, int, int):
    """A member: device with image, attempt and prepare-attempt."""
    return (device, image, attempt, prepare_attempt)


proc def _stack_case(case: str, steps: list[_Step], fc: file.FileCap,
                     log_handler: logging.Handler, report: action(str, ?str) -> None) -> None:
    """Run the steps of case on a _campaign_stack() over an LMDB database of
    its own, then report the case and what went wrong, or None
    (_StackActor)."""
    fs = file.FS(fc)
    cap = file.WriteFileCap(fc)
    db_path = fs.mktmpdir("test_campaign_stack_")
    db = swlmdb.LmdbStore(cap, db_path)
    campaigns = _Campaigns()
    stack = _campaign_stack(campaigns.register, log_handler, db)
    _StackActor(case, steps, fs, cap, db_path, db, campaigns, stack, y_0.root(), log_handler,
                report)


actor _StackActor(case: str, steps: list[_Step], fs: file.FS, cap: file.WriteFileCap,
                  db_path: str, _initial_db: swlmdb.LmdbStore, campaigns: _Campaigns,
                  _initial_stack: ttt.Layer, _initial_root: y_0.root,
                  log_handler: logging.Handler, report: action(str, ?str) -> None):
    """Run the steps of case on stack, over the LMDB database at db_path,
    then report the case and what went wrong, or None. A check looks again
    every 50 ms, for five seconds at most."""
    var db = _initial_db
    var stack = _initial_stack
    var last = _initial_root
    var pending = _initial_root
    var step = 0
    var tries = 0
    var done = False
    var kept_completed: dict[str, u64] = {}
    var marks: dict[str, (int, list[str])] = {}
    var verdict: ?str = None

    def finish(error: ?str) -> None:
        if done:
            return
        done = True
        verdict = error
        cleanup(0)

    def cleanup(attempt: int) -> None:
        """Close the database once no transaction of the stack is open, and
        remove it."""
        try:
            await async db.db.close()
        except Exception as e:
            if attempt < 50:
                after 0.1: cleanup(attempt + 1)
                return
            report(case, "the database did not close: {e}")
            return
        await async fs.rmtree(db_path)
        await async fs.rmdir(db_path)
        report(case, verdict)

    def advance() -> None:
        step += 1
        tries = 0
        after 0.0: run()

    def again(what: str) -> None:
        tries += 1
        if tries > 100:
            finish("step {step} ({steps[step].kind}): {what}")
        else:
            after 0.05: run()

    def check(ok: bool, got: str) -> None:
        if ok:
            advance()
        else:
            again(got)

    def edited(result: value) -> None:
        if done:
            return
        s = steps[step]
        if isinstance(result, Exception):
            if s.error == "":
                finish("step {step}: the edit failed: {result}")
            elif s.error not in str(result):
                finish("step {step}: the edit failed with {result}, not {s.error}")
            else:
                advance()
        elif s.error != "":
            finish("step {step}: the edit was accepted")
        else:
            last = pending
            advance()

    def restart() -> None:
        """Restart once no transaction of the stack is open: a new stack
        restores the database of the old one."""
        try:
            await async db.db.close()
        except Exception as e:
            again("the database did not close: {e}")
            return
        db = swlmdb.LmdbStore(cap, db_path)
        campaigns.clear()
        stack = _campaign_stack(campaigns.register, log_handler, db)
        stack.load_from_db(restored, True)

    def restored(error: ?Exception) -> None:
        if error is not None:
            finish("step {step}: the restore failed: {error}")
            return
        stack.newsession().recompute(recomputed)

    def recomputed(r: value) -> None:
        if isinstance(r, Exception):
            finish("step {step}: the recompute after the restart failed: {r}")
            return
        advance()

    def on_wire(s: _Step, w: _Wire) -> None:
        """Take a step on the way from the actor to its transform."""
        k = s.kind
        if k == "hold":
            w.hold()
            advance()
        elif k == "release-one":
            w.release_one()
            advance()
        elif k == "queued":
            n = w.waiting()
            check([str(n)] == s.want, "{n} writes held")
        elif k == "hold-requests":
            w.hold_requests()
            advance()
        elif k == "release-requests":
            w.release_requests()
            advance()
        elif k == "release-request":
            w.release_request()
            advance()
        elif k == "mark":
            marks[s.campaign] = w.seen()
            advance()
        elif k == "requests":
            got = w.seen().1
            check(got == s.want, "requests {got}")
        else:
            seen = w.seen()
            mark = marks.get(s.campaign)
            if mark is not None:
                check(seen.0 == mark.0 and seen.1 == mark.1,
                      "{seen.0 - mark.0} writes, requests {seen.1[len(mark.1):]}")
            else:
                finish("step {step}: quiet without a mark")

    def on_actor(s: _Step, a: cfs.UpgradeCampaignTransform,
                 c: y0_oper.software__software__upgrade_campaign_entry) -> None:
        """Take a step on the actor of a campaign that has published its
        state."""
        k = s.kind
        if k == "report":
            tag: ?str = s.campaign
            target: ?str = s.target
            if s.tag == "-":
                tag = None
                target = None
            elif s.tag != "":
                tag = s.tag
            state = _attempt_state(s.status, tag, target, u64(s.attempt), s.stage, None).0
            state.connected = s.connected
            if s.veto != "":
                state.veto.create(s.veto, reason="held")
            boot = s.boot
            if boot is not None:
                state.platform.last_boot = u64(time.time().unix_s() + boot)
            a.on_rfs((rfs_name=cfs.flotilla_of(s.device), device_name=s.device), state, None)
            advance()
        elif k == "gone":
            a.on_rfs((rfs_name=cfs.flotilla_of(s.device), device_name=s.device), None, None)
            advance()
        elif k == "error":
            a.on_rfs(None, None, ValueError("the subscription failed"))
            advance()
        elif k == "sync":
            a.on_subscriptions_synced()
            advance()
        elif k == "state":
            got = _state_rows(c)
            completed = _completed_text(c)
            want = "complete" if s.complete else ""
            if got == s.want and completed == want:
                v = c.state.completed
                if v is not None:
                    kept_completed[s.campaign] = v
                advance()
            else:
                again("state {got} {completed}")
        elif k == "results":
            got = _result_rows(c)
            check(got == s.want, "results {got}")
        elif k == "kept":
            got = c.state.completed
            check(got is not None and got == kept_completed.get(s.campaign),
                  "completed {got}, not {kept_completed.get(s.campaign)}")
        elif k == "later":
            got = c.state.completed
            before = kept_completed.get(s.campaign)
            check(got is not None and before is not None and got > before,
                  "completed {got}, not after {before}")
        elif k == "row":
            ds = c.state.device_status.get(s.device)
            got = "{ds.status}" if ds is not None and ds.freed is None else "missing or freed"
            check([got] == s.want, "{s.device} {got}")
        elif k == "held":
            ds = c.state.device_status.get(s.device)
            got = "{ds.held} {ds.held_by}" if ds is not None else "missing"
            check([got] == s.want, "held {got}")
        elif k == "apart":
            start = -1
            for win in c.state.plan.window:
                for dev in win.device:
                    e = dev.estimated_start
                    if dev.name == s.device and e is not None:
                        start = int(e)
            finished = -1
            mate = c.state.device_status.get(s.want[0])
            if mate is not None:
                f = mate.finished
                if f is not None:
                    finished = int(f)
            check(start >= 0 and finished >= 0 and start - finished == int(s.seconds),
                  "{s.device} starts at {start}, {s.want[0]} finished at {finished}")
        else:
            finish("step {step}: unknown kind {k}")

    def run() -> None:
        if done:
            return
        if step == len(steps):
            finish(None)
            return
        s = steps[step]
        k = s.kind
        if k == "edit":
            pending = _stack_root(s.campaigns, s.images, s.group)
            d = gdata.diff(last.to_gdata(), pending.to_gdata())
            if d is not None:
                stack.edit_config(d, None, edited)
            else:
                finish("step {step}: the edit changes nothing")
        elif k == "restart":
            restart()
        elif k == "wait":
            after s.seconds: advance()
        elif k == "acquired":
            got = _acquired(stack.below().get())
            check(got == s.want, "acquired {got}")
        elif k == "rows":
            got = _lock_rows(stack.below().get())
            check(got == s.want, "rows {got}")
        elif k == "config":
            d = gdata.diff(last.to_gdata(), y_0.root.from_gdata(stack.get()).to_gdata())
            check(d is None, "the configuration differs from that of the last edit: "
                  + (d.prsrc() if d is not None else ""))
        elif k in ["hold", "release-one", "queued", "hold-requests", "release-requests",
                   "release-request", "mark", "requests", "quiet"]:
            w = campaigns.wire_of(s.campaign)
            if w is not None:
                if k == "quiet" and tries == 0:
                    # Let the time pass first, then check once.
                    tries = 100
                    after s.seconds: run()
                else:
                    on_wire(s, w)
            else:
                again("no actor of {s.campaign}")
        else:
            a = campaigns.actor_of(s.campaign)
            c = _published(stack.get_data(), s.campaign)
            if a is not None and c is not None:
                on_actor(s, a, c)
            else:
                again("no state of {s.campaign}")

    def __startup__():
        after 0.0: run()


proc def _stack_cases(t: testing.EnvT, cases: list[(str, list[_Step])]) -> None:
    """Run each case on a _stack_case() of its own, all at once, and pass t
    when every case passes."""
    t.timeout(60.0)
    fc = file.FileCap(t.env.cap)
    collector = _CaseResults(t, [c.0 for c in cases])
    for case in cases:
        _stack_case(case.0, case.1, fc, t.log_handler, collector.on_case)


# Campaign A over cpe-1 to cpe-3: cpe-1 and cpe-3 answer, and are released
# one after the other and marked. cpe-1 succeeds and cpe-3 fails. cpe-2
# does not answer, and the campaign has not touched it.
LOCK_MEMBERS = [_m("cpe-1"), _m("cpe-2"), _m("cpe-3")]


def _touched_two() -> list[_Step]:
    """The steps that bring campaign A to LOCK_MEMBERS."""
    return [
        _do_edit([_a("run", LOCK_MEMBERS)]),
        _do_report("A", "cpe-1", "upgrade-needed"),
        _do_report("A", "cpe-3", "upgrade-needed"),
        _step("sync", "A"),
        _step("rows", want=["cpe-1 A 17.18.03a 0 free locked", "cpe-2 A 17.18.03a 0 held",
                            "cpe-3 A 17.18.03a 0 held"]),
        _do_report("A", "cpe-1", "succeeded"),
        _step("rows", want=["cpe-1 A 17.18.03a 0 held locked", "cpe-2 A 17.18.03a 0 held",
                            "cpe-3 A 17.18.03a 0 free locked"]),
        _do_report("A", "cpe-3", "failed"),
        _step("rows", want=["cpe-1 A 17.18.03a 0 held locked", "cpe-2 A 17.18.03a 0 held",
                            "cpe-3 A 17.18.03a 0 held locked failed"]),
    ]


proc def _test_campaign_rejects_an_edit_of_a_touched_member(t: testing.EnvT):
    """On a layer like fleetmgr's top: after LOCK_MEMBERS, an edit that
    gives cpe-1 another image fails and names it, and so do an edit of the
    image list that gives IMAGE a new version, and one that removes IMAGE,
    which name cpe-1 and cpe-3. Each leaves the configuration and the
    intent as they were. Moving the file of IMAGE, another image for cpe-2,
    and removing cpe-1 are accepted; added again with another image, cpe-1
    is a new member."""
    held = ["cpe-1 A 17.18.03a 0 held locked", "cpe-2 A 17.18.03a 0 held",
            "cpe-3 A 17.18.03a 0 held locked failed"]
    newer = [(IMAGE, "17.18.04", "", IMAGE_SIZE), (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    removed = [(OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    moved = [(IMAGE, "17.18.03a", "iosxe/17.18/" + IMAGE, IMAGE_SIZE),
             (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    other_two = [_m("cpe-1"), _m("cpe-2", OTHER_IMAGE), _m("cpe-3")]
    _stack_cases(t, [
        ("touched members keep their image", _touched_two() + [
            _do_edit([_a("run", [_m("cpe-1", OTHER_IMAGE), _m("cpe-2"), _m("cpe-3")])],
                     error=_kept_image("cpe-1")),
            _do_edit([_a("run", LOCK_MEMBERS)], newer, error=_kept_image("cpe-1, cpe-3")),
            _do_edit([_a("run", LOCK_MEMBERS)], removed, error=_kept_image("cpe-1, cpe-3")),
            _step("config"),
            _step("rows", want=held),
            _do_edit([_a("run", LOCK_MEMBERS)], moved),
            _do_edit([_a("run", other_two)], moved),
            _step("rows", want=["cpe-1 A 17.18.03a 0 held locked", "cpe-2 A 17.18.04 0 held",
                                "cpe-3 A 17.18.03a 0 held locked failed"]),
            _do_edit([_a("run", [_m("cpe-2", OTHER_IMAGE), _m("cpe-3")])], moved),
            _do_edit([_a("run", [_m("cpe-1", OTHER_IMAGE), _m("cpe-2", OTHER_IMAGE),
                                 _m("cpe-3")])], moved),
            _step("rows", want=["cpe-1 A 17.18.04 0 held", "cpe-2 A 17.18.04 0 held",
                                "cpe-3 A 17.18.03a 0 held locked failed"]),
        ]),
    ])


proc def _test_campaign_rejects_a_new_attempt_of_a_member_that_did_not_fail(t: testing.EnvT):
    """On a layer like fleetmgr's top: after LOCK_MEMBERS, an edit that
    gives cpe-1, which succeeded, a new attempt fails and names it, and so
    does one that gives cpe-2, which waits, a new attempt; each leaves the
    configuration as it was. A new attempt with another image for cpe-3,
    which failed, fails too. A new attempt for cpe-3 alone is accepted: it
    keeps its image, and is no longer marked attempt-failed."""
    _stack_cases(t, [
        ("a new attempt only for a failed member", _touched_two() + [
            _do_edit([_a("run", [_m("cpe-1", attempt=1), _m("cpe-2"), _m("cpe-3")])],
                     error=_no_attempt("cpe-1")),
            _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1), _m("cpe-3")])],
                     error=_no_attempt("cpe-2")),
            _step("config"),
            _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2"), _m("cpe-3", OTHER_IMAGE, 1)])],
                     error=_kept_image("cpe-3")),
            _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2"), _m("cpe-3", attempt=1)])]),
            _step("rows", want=["cpe-1 A 17.18.03a 0 held locked", "cpe-2 A 17.18.03a 0 held",
                                "cpe-3 A 17.18.03a 1 held locked"]),
        ]),
    ])


proc def _test_campaign_keeps_its_rules_after_an_edit_that_only_removes_members(t: testing.EnvT):
    """On a layer like fleetmgr's top: after LOCK_MEMBERS, an edit that
    only removes cpe-2 keeps the rules for the members that stay. Then an
    edit that gives cpe-1, which succeeded, a new attempt or another image
    fails, and a new attempt for cpe-3, which failed, is accepted."""
    t.skip("TTT does not run a transform for an edit that only removes links: https://github.com/stratoweave/stratoweave/issues/827")
    _stack_cases(t, [
        ("a removal", _touched_two() + [
            _do_edit([_a("run", [_m("cpe-1"), _m("cpe-3")])]),
            _step("rows", want=["cpe-1 A 17.18.03a 0 held locked",
                                "cpe-3 A 17.18.03a 0 held locked failed"]),
            _do_edit([_a("run", [_m("cpe-1", attempt=1), _m("cpe-3")])],
                     error=_no_attempt("cpe-1")),
            _do_edit([_a("run", [_m("cpe-1", OTHER_IMAGE), _m("cpe-3")])],
                     error=_kept_image("cpe-1")),
            _step("config"),
            _do_edit([_a("run", [_m("cpe-1"), _m("cpe-3", attempt=1)])]),
        ]),
    ])


proc def _test_campaign_keeps_its_locks_through_a_restart(t: testing.EnvT):
    """On a layer like fleetmgr's top, campaign A releases cpe-1, and
    fleetmgr restarts with no edit in between. The recompute after the
    restart succeeds, the new actor marks cpe-1, and an edit that gives
    cpe-1 another image fails."""
    members = [_m("cpe-1"), _m("cpe-2")]
    _stack_cases(t, [
        ("a restart", [
            _do_edit([_a("run", members)]),
            _do_report("A", "cpe-1", "upgrade-needed"),
            _step("sync", "A"),
            _step("rows", want=["cpe-1 A 17.18.03a 0 free locked", "cpe-2 A 17.18.03a 0 held"]),
            _step("restart"),
            _step("rows", want=["cpe-1 A 17.18.03a 0 held locked", "cpe-2 A 17.18.03a 0 held"]),
            _do_edit([_a("run", [_m("cpe-1", OTHER_IMAGE), _m("cpe-2")])],
                     error=_kept_image("cpe-1")),
        ]),
    ])


proc def _test_campaign_lets_an_edit_overtake_a_release(t: testing.EnvT):
    """On a layer like fleetmgr's top, campaign A decides to release cpe-1
    at 17.18.03a, but the write of the release waits, and an edit gives
    cpe-1 OTHER_IMAGE first: TTT accepts it, as the campaign has not
    touched cpe-1 yet.

    The write of the release lands then, with the mark of cpe-1 at the old
    target. Then:

    - "the release lands late": an edit that changes nothing of cpe-1 is
      accepted, and gives cpe-1 the campaign's veto at 17.18.04, without
      the mark; so does the recompute after a restart, and then cpe-1 takes
      its first image again.
    - "the first image again": an edit that gives cpe-1 IMAGE again before
      the next write of the actor lands is accepted, and gives cpe-1 the
      campaign's veto at 17.18.03a, without the mark: the release that the
      edit before overtook does not come back.
    - "the actor takes the release back": the write of the actor after the
      edit follows: cpe-1 has the campaign's veto at 17.18.04, without the
      mark."""
    one = [_m("cpe-1")]
    other = [_m("cpe-1", OTHER_IMAGE)]
    overtaken = [
        _do_edit([_a("run", one)]),
        _do_report("A", "cpe-1", "upgrade-needed"),
        _step("hold", "A"),
        _step("sync", "A"),
        _step("queued", "A", want=["1"]),
        _do_edit([_a("run", other)]),
        _step("queued", "A", want=["2"]),
        _step("release-one", "A"),
        _step("rows", want=["cpe-1 A 17.18.03a 0 free locked"]),
    ]
    _stack_cases(t, [
        ("the release lands late", overtaken + [
            _do_edit([_a("run", other, "50")]),
            _step("rows", want=["cpe-1 A 17.18.04 0 held"]),
            _step("restart"),
            _step("rows", want=["cpe-1 A 17.18.04 0 held"]),
            _do_edit([_a("run", one, "50")]),
        ]),
        ("the first image again", overtaken + [
            _do_edit([_a("run", one)]),
            _step("rows", want=["cpe-1 A 17.18.03a 0 held"]),
        ]),
        ("the actor takes the release back", overtaken + [
            _step("release-one", "A"),
            _step("rows", want=["cpe-1 A 17.18.04 0 held"]),
        ]),
    ])


#############################################################################
# Completion: a campaign frees its members once all of it is done
#############################################################################

def _results_memory(run_since: ?int, results: list[(str, int, str)],
                    request: int=0) -> InputMemory:
    """A campaign's memory with run_since and a member for each of results,
    each as (device, attempt, status), done at 10 and freed at 20, that
    took the request with the number request, none when 0."""
    m = InputMemory(run_since=u64(run_since) if run_since is not None else None,
                    request=u64(request) if request > 0 else None)
    for r in results:
        m.member.create(r.0, attempt=u64(r.1), status=r.2, finished=u64(10), freed=u64(20))
    return m


def _results_request(results: list[(str, int, str)], request: int=1) -> InputDynstate:
    """A campaign's dynstate that asks to keep results, each as (device,
    attempt, status), done at 30 and freed at 40, as the request with the
    number request."""
    d = InputDynstate(request=u64(request))
    for r in results:
        d.result.create(r.0, attempt=u64(r.1), status=r.2, finished=u64(30), freed=u64(40))
    return d


def _test_campaign_function_leaves_out_freed_members():
    """The campaign's transform function keeps the results of the freed
    members that stand: those in memory, or, when dynstate has a new
    request of the actor, those of the request in their place. A result
    stands while its member keeps its attempt, also with another image or
    version. A freed member gets no intent; any other member in the fleet
    is acquired. Memory keeps run-since beside the results, and the number
    of the last request it took: a request with that number or a lower one
    changes nothing."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    inventory = _with_nightly(_flat_inventory(names))
    inventory.images.image.create(OTHER_IMAGE, os="IOS XE", version="17.18.04")
    newer = _with_version(_with_nightly(_flat_inventory(names)), "17.18.05")
    run = _paced_campaign(names)
    plan = _paced_campaign(names)
    plan.admin_state = "plan"
    tried = _paced_campaign(names)
    t2 = tried.device.get("cpe-2")
    if t2 is not None:
        t2.attempt = u64(1)
    prepared = _paced_campaign(names)
    p2 = prepared.device.get("cpe-2")
    if p2 is not None:
        p2.prepare_attempt = u64(1)
    other = _paced_campaign(names)
    o2 = other.device.get("cpe-2")
    if o2 is not None:
        o2.image = OTHER_IMAGE
    removed = _paced_campaign(["cpe-1", "cpe-3"])
    two = [("cpe-2", 0, "succeeded")]
    # (case, the campaign, its inventory, the results in memory, the results
    # requested, None for no request, the members that get an intent, the
    # results that memory keeps, as "device status", and the number of the
    # last request that memory took, and of the request)
    cases: list[(str, InputCampaign, y_0.root, list[(str, int, str)], ?list[(str, int, str)],
                 list[str], list[str], (int, int))] = [
        ("a standing result", run, inventory, two, None,
         ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("a not-started result", run, inventory, [("cpe-2", 0, "not-started")], None,
         ["cpe-1", "cpe-3"], ["cpe-2 not-started"], (0, 1)),
        ("a new attempt", tried, inventory, [("cpe-2", 0, "failed")], None, names, [], (0, 1)),
        ("a new prepare-attempt", prepared, inventory, two, None,
         ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("another image", other, inventory, two, None,
         ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("a member removed", removed, inventory, two, None, ["cpe-1", "cpe-3"], [], (0, 1)),
        ("the result of a device that is no member", run, inventory,
         [("cpe-9", 0, "succeeded")], None, names, [], (0, 1)),
        ("a new version in the image list", run, newer, two, None,
         ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("plan", plan, inventory, two, None, ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("every member freed", run, inventory,
         [("cpe-1", 0, "up-to-date"), ("cpe-2", 0, "failed"), ("cpe-3", 0, "rolled-back")], None,
         [], ["cpe-1 up-to-date", "cpe-2 failed", "cpe-3 rolled-back"], (0, 1)),
        ("a request adds a result", run, inventory, [], two,
         ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("a request for a member that an edit gave a new attempt", tried, inventory, [], two,
         names, [], (0, 1)),
        ("a request for a member that an edit removed", removed, inventory, [], two,
         ["cpe-1", "cpe-3"], [], (0, 1)),
        ("a request with memory's results and more", run, inventory,
         [("cpe-1", 0, "up-to-date")], [("cpe-1", 0, "up-to-date")] + two,
         ["cpe-3"], ["cpe-1 up-to-date", "cpe-2 succeeded"], (0, 1)),
        ("a request without a result that memory has", run, inventory,
         [("cpe-1", 0, "up-to-date")], two,
         ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("a request without results clears memory's results", run, inventory, two, [],
         names, [], (0, 1)),
        ("a request over memory for the same member", run, inventory,
         [("cpe-2", 0, "failed")], two, ["cpe-1", "cpe-3"], ["cpe-2 succeeded"], (0, 1)),
        ("a request that memory took", run, inventory, [], two, names, [], (1, 1)),
        ("a request that memory took keeps memory", run, inventory,
         [("cpe-1", 0, "up-to-date")], two, ["cpe-2", "cpe-3"], ["cpe-1 up-to-date"],
         (1, 1)),
        ("a later request", run, inventory, [], two, ["cpe-1", "cpe-3"], ["cpe-2 succeeded"],
         (1, 2)),
    ]
    for case in cases:
        memory = _results_memory(100, case.3, case.7.0)
        request: ?InputDynstate = None
        want_took = case.7.0
        asked = case.4
        if asked is not None:
            request = _results_request(asked, case.7.1)
            want_took = fctl.imax(case.7.0, case.7.1)
        out = cfs.UpgradeCampaign().transform(case.1, case.2.to_gdata(), memory, request, None)
        vetoed, free, targeted, unnamed = _vetoed(out.0.to_gdata(), "paced")
        testing.assertEqual(sorted(vetoed + free), case.5, "{case.0}: the members acquired")
        kept: list[str] = []
        run_since: ?u64 = None
        took = 0
        m = out.1
        if m is not None:
            mem = InputMemory.from_gdata(m.to_gdata())
            kept = ["{device} {r.status}" for device, r in cfs.memory_results(mem).items()]
            run_since = mem.run_since
            took = cfs.kept_request(mem)
        testing.assertEqual(kept, case.6, "{case.0}: the results in memory")
        testing.assertEqual(run_since, u64(100), "{case.0}: run-since")
        testing.assertEqual(took, want_took, "{case.0}: the request memory took")
    # A result keeps its leaves, and the memory written last is reused.
    memory = _results_memory(100, [("cpe-2", 0, "failed")])
    request = _results_request([("cpe-1", 0, "rolled-back"), ("cpe-2", 0, "failed")])
    r1 = request.result.get("cpe-1")
    if r1 is not None:
        r1.stage = "rollback"
        r1.reason = "post-check failed"
    wrapped = cfs.UpgradeCampaign().transform_wrapper(run.to_gdata(), inventory.to_gdata(),
                                                      memory.to_gdata(), request.to_gdata(), None)
    full = cfs.memory_results(InputMemory.from_gdata(wrapped.1))
    testing.assertEqual(["{device} {r.attempt} {r.status} {r.stage} {r.reason} "
                         + "{r.finished} {r.freed}" for device, r in full.items()],
                        ["cpe-1 0 rolled-back rollback post-check failed 30 40",
                         "cpe-2 0 failed None None 30 40"],
                        "every leaf of a result")
    again = cfs.UpgradeCampaign().transform_wrapper(run.to_gdata(), inventory.to_gdata(),
                                                    wrapped.1, request.to_gdata(), wrapped.0)
    again_memory = again.1
    wrapped_memory = wrapped.1
    reused = False
    if again_memory is not None and wrapped_memory is not None:
        reused = ttt.same_node(again_memory, wrapped_memory)
    testing.assertTrue(reused, "the memory written last is reused")


def _test_campaign_edit_rules_for_freed_members():
    """The output written last has no marks for a member that campaign A
    has freed: its result in memory says whether its attempt failed. An edit
    that gives it a new attempt fails, unless its result is failed,
    rolled-back or not-started; then the campaign acquires it again. An
    edit that gives it another image fails when the memory locks it, and
    else leaves it freed with its result."""
    # (case, the status of cpe-1's result, whether the memory locks cpe-1,
    # cpe-1 after the edit as (image, attempt), the error, or "", and
    # whether the campaign acquires cpe-1)
    cases: list[(str, str, bool, (str, int), str, bool)] = [
        ("failed, a new attempt", "failed", True, (IMAGE, 1), "", True),
        ("rolled back, a new attempt", "rolled-back", True, (IMAGE, 1), "", True),
        ("not started, a new attempt", "not-started", False, (IMAGE, 1), "", True),
        ("succeeded, a new attempt", "succeeded", True, (IMAGE, 1), _no_attempt("cpe-1"),
         False),
        ("up to date, a new attempt", "up-to-date", False, (IMAGE, 1), _no_attempt("cpe-1"),
         False),
        ("locked, another image", "succeeded", True, (OTHER_IMAGE, 0), _kept_image("cpe-1"),
         False),
        ("not locked, another image", "up-to-date", False, (OTHER_IMAGE, 0), "", False),
    ]
    for case in cases:
        memory = InputMemory()
        member = memory.member.create("cpe-1", image=IMAGE, target_release="17.18.03a",
                                      attempt=u64(0), status=case.1, finished=u64(10),
                                      freed=u64(20))
        if case.2:
            member.image_locked = True
        campaign = InputCampaign(name="A", admin_state="run")
        campaign.device.create("cpe-1", image=case.3.0, attempt=u64(case.3.1))
        got = ""
        acquired = False
        try:
            out = cfs.UpgradeCampaign().transform_wrapper(campaign.to_gdata(),
                                                          _rules_inventory(RULES_IMAGES).to_gdata(),
                                                          memory.to_gdata(), None, None)
            acquired = len(_lock_rows(out.0)) > 0
        except ValueError as e:
            got = e.error_message
        testing.assertEqual(got, case.4, case.0)
        testing.assertEqual(acquired, case.5, "{case.0}: acquired")


def _freed_ab(one: str="up-to-date", two: str="up-to-date") -> list[_Step]:
    """Campaign A in run over cpe-1 and cpe-2, whose devices report the
    final statuses one and two before the first decision: A is complete at
    that decision, and frees both."""
    ok = len([s for s in [one, two] if s == "up-to-date" or s == "succeeded"])
    return [
        _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])]),
        _do_report("A", "cpe-1", one),
        _do_report("A", "cpe-2", two),
        _step("sync", "A"),
        _step("acquired", want=[]),
        _step("state", "A", want=["cpe-1 {one} freed", "cpe-2 {two} freed",
                                  "counted {ok} {2 - ok} 0"], complete=True),
    ]


def _freed_ab_requests(one: str="up-to-date", two: str="up-to-date") -> list[str]:
    """What the actor of _freed_ab() writes to dynstate: its request."""
    return ["1: cpe-1 0 {one} None None, cpe-2 0 {two} None None"]


proc def _test_a_complete_campaign_frees_its_members(t: testing.EnvT):
    """A campaign in run whose members are all done, with a final status
    for its intent, is complete: in one commit, its transform writes its
    output without them and their results in memory, as its actor asks in
    dynstate. device-status shows each result, freed and finished, and
    nothing that the device reports; the counters count the results, and
    completed is the latest freed. Failures, also not-started, count as
    final. After a restart, the results come from memory, with every leaf.
    A campaign in plan does not complete: it completes when it runs."""
    two = [_m("cpe-1"), _m("cpe-2")]
    cases: list[(str, list[_Step])] = [
        ("up to date, at the first decision",
         _freed_ab() + [_step("requests", "A", want=_freed_ab_requests()),
                        _step("results", "A", want=["cpe-1 up-to-date 0 None None",
                                                    "cpe-2 up-to-date 0 None None"])]),
        ("succeeded in their run",
         [_do_edit([_a("run", two)]),
          _do_report("A", "cpe-1", "upgrade-needed"),
          _do_report("A", "cpe-2", "upgrade-needed"),
          _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "succeeded", stage="commit"),
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 free"]),
          _do_report("A", "cpe-2", "succeeded", stage="commit"),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 succeeded freed", "cpe-2 succeeded freed",
                                    "counted 2 0 0"], complete=True),
          _step("requests", "A", want=[
              "1: cpe-1 0 succeeded commit None, cpe-2 0 succeeded commit None"])]),
        ("succeeded, up to date and failed",
         [_do_edit([_a("run", two + [_m("cpe-3")])]),
          _do_report("A", "cpe-1", "upgrade-needed"),
          _do_report("A", "cpe-2", "up-to-date"),
          _do_report("A", "cpe-3", "upgrade-needed"),
          _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held", "cpe-3 A 0 held"]),
          _do_report("A", "cpe-1", "succeeded", stage="commit"),
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held", "cpe-3 A 0 free"]),
          _do_report("A", "cpe-3", "failed", stage="precheck"),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 succeeded freed", "cpe-2 up-to-date freed",
                                    "cpe-3 failed freed", "counted 2 1 0"], complete=True),
          _step("restart"),
          _step("acquired", want=[]),
          _step("results", "A", want=["cpe-1 succeeded 0 commit None",
                                      "cpe-2 up-to-date 0 None None",
                                      "cpe-3 failed 0 precheck None"]),
          _step("state", "A", want=["cpe-1 succeeded freed", "cpe-2 up-to-date freed",
                                    "cpe-3 failed freed", "counted 2 1 0"], complete=True)]),
        ("a failed rollback",
         [_do_edit([_a("run", two)]),
          _do_report("A", "cpe-1", "upgrade-needed"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "failed", stage="rollback"),
          _step("acquired", want=[]),
          _step("results", "A", want=["cpe-1 failed 0 rollback None",
                                      "cpe-2 up-to-date 0 None None"])]),
        ("rolled back",
         [_do_edit([_a("run", two)]),
          _do_report("A", "cpe-1", "upgrade-needed"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "rolled-back", stage="rollback"),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 rolled-back freed", "cpe-2 up-to-date freed",
                                    "counted 1 1 0"], complete=True)]),
        ("not started",
         [_do_edit([_a("run", two)]),
          _do_report("A", "cpe-1", "not-started"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("sync", "A"),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 not-started freed", "cpe-2 up-to-date freed",
                                    "counted 1 1 0"], complete=True),
          _step("results", "A", want=["cpe-1 not-started 0 None None",
                                      "cpe-2 up-to-date 0 None None"])]),
        ("in plan, then run",
         [_do_edit([_a("plan", two)]),
          _do_report("A", "cpe-1", "up-to-date"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("sync", "A"),
          _step("wait", seconds=1.5),
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _step("state", "A", want=["cpe-1 up-to-date", "cpe-2 up-to-date", "counted 2 0 0"]),
          _step("requests", "A", want=[]),
          _do_edit([_a("run", two)]),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                    "counted 2 0 0"], complete=True)]),
    ]
    _stack_cases(t, cases)


proc def _test_a_campaign_is_not_complete(t: testing.EnvT):
    """A campaign is not complete while a member waits, also when the
    failure budget or a group-mate that failed holds it, while a member is
    in flight, while a member is not in the fleet or has no status for the
    campaign's intent, and in plan: it frees no member, asks for nothing,
    and publishes no completed. Removing the member that is not in the
    fleet, or a new attempt of the group-mate that failed, lets it
    complete. A released member that is done keeps the campaign incomplete
    while its status is not final; when its final status comes back, the
    campaign frees its members, though it no longer decides. A member done
    without a release whose final status goes waits again, and the
    campaign decides again for it. A campaign without members is not
    complete, in run and in plan."""
    two = [_m("cpe-1"), _m("cpe-2")]
    quiet = [_step("wait", seconds=2.0), _step("requests", "A", want=[])]
    cases: list[(str, list[_Step])] = [
        ("a member that waits",
         [_do_edit([_a("run", two)]), _do_report("A", "cpe-1", "up-to-date"),
          _step("sync", "A")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _step("state", "A", want=["cpe-1 up-to-date", "cpe-2 pending", "counted 1 0 0"])]),
        ("a member in flight",
         [_do_edit([_a("run", two)]), _do_report("A", "cpe-1", "up-to-date"),
          _do_report("A", "cpe-2", "upgrade-needed"), _step("sync", "A")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 free"]),
          _step("state", "A", want=["cpe-1 up-to-date", "cpe-2 upgrade-needed",
                                    "counted 1 0 0"])]),
        ("a hold of the failure budget",
         [_do_edit([_a("run", two, "0")]), _do_report("A", "cpe-1", "failed"),
          _do_report("A", "cpe-2", "upgrade-needed"), _step("sync", "A")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _step("held", "A", "cpe-2", want=["failure-budget None"])]),
        ("a member not in the fleet, then removed",
         [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-9")])]),
          _do_report("A", "cpe-1", "up-to-date"), _step("sync", "A")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held"]),
          _step("state", "A", want=["cpe-1 up-to-date", "cpe-9 pending", "counted 1 0 0"]),
          _do_edit([_a("run", [_m("cpe-1")])]),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 up-to-date freed", "counted 1 0 0"],
                complete=True)]),
        ("a status for another campaign",
         [_do_edit([_a("run", two)]), _do_report("A", "cpe-1", "up-to-date"),
          _do_report("A", "cpe-2", "up-to-date", tag="B"), _step("sync", "A")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _step("state", "A", want=["cpe-1 up-to-date", "cpe-2 pending", "counted 1 0 0"])]),
        ("in plan",
         [_do_edit([_a("plan", two)]), _do_report("A", "cpe-1", "up-to-date"),
          _step("sync", "A"), _do_report("A", "cpe-2", "up-to-date")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _step("state", "A", want=["cpe-1 up-to-date", "cpe-2 up-to-date",
                                    "counted 2 0 0"])]),
        ("a group-mate that failed, then a new attempt",
         [_do_edit([_a("run", two)], group="hold"),
          _do_report("A", "cpe-1", "upgrade-needed"),
          _do_report("A", "cpe-2", "upgrade-needed"), _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "failed", stage="precheck")] + quiet + [
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _step("held", "A", "cpe-2", want=["group-failed cpe-1"]),
          _do_edit([_a("run", [_m("cpe-1", attempt=1), _m("cpe-2")])], group="hold"),
          _step("acquired", want=["cpe-1 A 1 held", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "up-to-date", attempt=1),
          _step("acquired", want=["cpe-1 A 1 held", "cpe-2 A 0 free"]),
          _do_report("A", "cpe-2", "succeeded", stage="commit"),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 succeeded freed",
                                    "counted 2 0 0"], complete=True)]),
        ("a released member whose final status goes and comes back",
         [_do_edit([_a("run", two)]), _do_report("A", "cpe-1", "upgrade-needed"),
          _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "succeeded", stage="commit"),
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "unknown"),
          _do_report("A", "cpe-2", "up-to-date")] + quiet + [
          _step("state", "A", want=["cpe-1 unknown", "cpe-2 up-to-date", "counted 1 0 0"]),
          _do_report("A", "cpe-1", "succeeded", stage="commit"),
          _step("acquired", want=[]),
          _step("state", "A", want=["cpe-1 succeeded freed", "cpe-2 up-to-date freed",
                                    "counted 2 0 0"], complete=True)]),
        ("a member that waits again after the campaign finished",
         [_do_edit([_a("run", two)]), _do_report("A", "cpe-1", "upgrade-needed"),
          _step("sync", "A"),
          _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "succeeded", stage="commit"),
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
          _do_report("A", "cpe-1", "unknown"),
          _do_report("A", "cpe-2", "up-to-date")] + quiet + [
          _do_report("A", "cpe-2", "upgrade-needed"),
          _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 free"])]),
        ("a campaign without members",
         [_do_edit([_a("run", [])])] + quiet + [
          _step("state", "A", want=["counted 0 0 0"]),
          _do_edit([_a("plan", [])]),
          _step("wait", seconds=1.0),
          _step("state", "A", want=["counted 0 0 0"])]),
    ]
    _stack_cases(t, cases)


proc def _test_a_freed_member_keeps_its_result(t: testing.EnvT):
    """What the device of a freed member reports changes nothing: an
    untagged state, a state for another campaign, a veto of another
    campaign, a state that goes, and a failed subscription. The campaign
    writes nothing, and keeps the results and completed. After a failed
    subscription, a freed failure still counts against the failure
    budget."""
    cases: list[(str, list[_Step])] = [
        ("each in turn",
         _freed_ab() + [
             _step("mark", "A"),
             _do_report("A", "cpe-1", "upgrade-needed", tag="-"),
             _do_report("A", "cpe-1", "in-progress", tag="B"),
             _do_report("A", "cpe-2", "upgrade-needed", tag="B", veto="campaign:B"),
             _step("gone", "A", "cpe-1"),
             _step("error", "A"),
             _step("quiet", "A", seconds=2.0),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True),
             _step("kept", "A"),
             _step("results", "A", want=["cpe-1 up-to-date 0 None None",
                                         "cpe-2 up-to-date 0 None None"]),
             _step("acquired", want=[])]),
        ("a failed subscription keeps a freed failure",
         [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")], "0")]),
          _do_report("A", "cpe-1", "failed", stage="precheck"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("sync", "A"),
          _step("acquired", want=[]),
          _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2"), _m("cpe-3")], "0")]),
          _do_report("A", "cpe-3", "upgrade-needed"),
          _step("held", "A", "cpe-3", want=["failure-budget None"]),
          _step("error", "A"),
          _do_report("A", "cpe-3", "upgrade-needed"),
          _step("wait", seconds=1.5),
          _step("held", "A", "cpe-3", want=["failure-budget None"]),
          _step("acquired", want=["cpe-3 A 0 held"])]),
    ]
    _stack_cases(t, cases)


proc def _test_a_restart_keeps_the_results(t: testing.EnvT):
    """After a restart of fleetmgr, a campaign takes the results of its
    freed members from memory, before any device reports: it acquires none
    of them, and frees nothing again, so completed stays, and it asks for
    nothing. A member that a new attempt acquired again keeps its intent. A
    freed failure still counts against the failure budget."""
    cases: list[(str, list[_Step])] = [
        ("every member freed",
         _freed_ab() + [_step("wait", seconds=1.1), _step("restart"),
                        _step("acquired", want=[]),
                        _step("state", "A", want=["cpe-1 up-to-date freed",
                                                  "cpe-2 up-to-date freed", "counted 2 0 0"],
                              complete=True),
                        _step("kept", "A"),
                        _step("requests", "A", want=[])]),
        ("a member acquired again",
         _freed_ab(two="failed") + [
             _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1)])]),
             _step("acquired", want=["cpe-2 A 1 held"]),
             _step("restart"),
             _step("acquired", want=["cpe-2 A 1 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 pending",
                                       "counted 1 0 0"]),
             _step("requests", "A", want=[])]),
        ("a freed failure and the failure budget",
         [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")], "0")]),
          _do_report("A", "cpe-1", "failed", stage="precheck"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("sync", "A"),
          _step("acquired", want=[]),
          _step("restart"),
          _step("state", "A", want=["cpe-1 failed freed", "cpe-2 up-to-date freed",
                                    "counted 1 1 0"], complete=True),
          _do_report("A", "cpe-3", "upgrade-needed"),
          _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2"), _m("cpe-3")], "0")]),
          _step("sync", "A"),
          _step("held", "A", "cpe-3", want=["failure-budget None"]),
          _step("acquired", want=["cpe-3 A 0 held"])]),
    ]
    _stack_cases(t, cases)


proc def _test_a_member_removed_and_added_again_is_acquired(t: testing.EnvT):
    """Removing a freed member forgets its result. Added again in a later
    edit, it is a new member: the campaign acquires it, and is not complete
    until it is done. A device whose state went, or a restart in between,
    leaves it pending. A device that still reports the final status of its
    attempt is done at once, and the campaign frees it again."""
    back = [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])]),
            _step("acquired", want=["cpe-2 A 0 held"]),
            _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 pending",
                                      "counted 1 0 0"])]
    cases: list[(str, list[_Step])] = [
        ("its state gone",
         _freed_ab() + [_step("gone", "A", "cpe-2"),
                        _do_edit([_a("run", [_m("cpe-1")])]),
                        _step("acquired", want=[]),
                        _step("state", "A", want=["cpe-1 up-to-date freed", "counted 1 0 0"],
                              complete=True)] + back),
        ("its final status kept",
         _freed_ab() + [_do_edit([_a("run", [_m("cpe-1")])]),
                        _step("state", "A", want=["cpe-1 up-to-date freed", "counted 1 0 0"],
                              complete=True),
                        _step("wait", seconds=1.1),
                        _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])]),
                        _step("later", "A"),
                        _step("acquired", want=[]),
                        _step("state", "A", want=["cpe-1 up-to-date freed",
                                                  "cpe-2 up-to-date freed", "counted 2 0 0"],
                              complete=True)]),
        ("with a restart between",
         _freed_ab() + [_do_edit([_a("run", [_m("cpe-1")])]), _step("wait", seconds=1.0),
                        _step("restart")] + back),
    ]
    _stack_cases(t, cases)


def _created_again() -> list[_Step]:
    """Campaign A over cpe-1 and cpe-2, created again after a delete: it has
    no results, and acquires every member again."""
    return [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])]),
            _step("acquired", want=["cpe-1 A 0 held", "cpe-2 A 0 held"]),
            _step("state", "A", want=["cpe-1 pending", "cpe-2 pending", "counted 0 0 0"])]


proc def _test_a_campaign_created_again_acquires_every_member(t: testing.EnvT):
    """A campaign deleted and created again under the same name, with the
    same members, attempts and images, has no results: it acquires every
    member again. The create comes after the delete has committed, while no
    other transaction holds the campaign list, so TTT makes a new list
    element for it."""
    _stack_cases(t, [
        ("delete, then create",
         _freed_ab() + [_do_edit([]), _step("acquired", want=[])] + _created_again()),
    ])


proc def _test_a_campaign_created_again_after_a_restart_acquires_every_member(t: testing.EnvT):
    """A complete campaign deleted before a restart leaves nothing in the
    database: created again, it acquires every member. Also when the delete
    crosses the freeing: the request then reaches the transform of the
    deleted campaign."""
    t.skip("TTT writes the dynstate of a deleted transform: https://github.com/stratoweave/stratoweave/issues/828")
    _stack_cases(t, [
        ("with a restart between",
         _freed_ab() + [_do_edit([]), _step("restart")] + _created_again()),
        ("a delete that crosses the freeing",
         [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])]),
          _do_report("A", "cpe-1", "up-to-date"),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("hold-requests", "A"),
          _step("sync", "A"),
          _step("requests", "A", want=_freed_ab_requests()),
          _do_edit([]),
          _step("release-requests", "A"),
          _step("wait", seconds=0.5),
          _step("restart"),
          _step("acquired", want=[])] + _created_again()),
    ])


proc def _test_a_new_attempt_acquires_a_freed_member(t: testing.EnvT):
    """A new attempt acquires a freed member whose attempt failed again,
    alone: the campaign writes its intent, is not complete until it is
    done, and then frees it again with its new result. A member whose
    rollback failed is released again. A new attempt for a freed member
    that succeeded fails, and so does another image for a freed member that
    the campaign released, also after a restart. Another image for a freed
    member that was up to date, a new version of the image in the image
    list and a new prepare-attempt leave the members freed, with their
    results."""
    released = [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])]),
                _do_report("A", "cpe-1", "upgrade-needed"),
                _do_report("A", "cpe-2", "up-to-date"),
                _step("sync", "A"),
                _step("acquired", want=["cpe-1 A 0 free", "cpe-2 A 0 held"])]
    newer = [(IMAGE, "17.18.05", "", IMAGE_SIZE), (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    freed = [_step("wait", seconds=1.0),
             _step("acquired", want=[]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True),
             _step("requests", "A", want=_freed_ab_requests())]
    cases: list[(str, list[_Step])] = [
        ("a new attempt",
         _freed_ab(two="failed") + [
             _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1)])]),
             _step("acquired", want=["cpe-2 A 1 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 pending",
                                       "counted 1 0 0"]),
             _do_report("A", "cpe-2", "up-to-date", attempt=1),
             _step("acquired", want=[]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True),
             _step("requests", "A", want=_freed_ab_requests(two="failed") + [
                 "2: cpe-1 0 up-to-date None None, cpe-2 1 up-to-date None None"])]),
        ("a new attempt for a member whose rollback failed",
         released + [
             _do_report("A", "cpe-1", "failed", stage="rollback"),
             _step("acquired", want=[]),
             _do_edit([_a("run", [_m("cpe-1", attempt=1), _m("cpe-2")])]),
             _step("acquired", want=["cpe-1 A 1 held"]),
             _do_report("A", "cpe-1", "upgrade-needed", attempt=1),
             _step("acquired", want=["cpe-1 A 1 free"])]),
        ("a new attempt for a member that succeeded",
         _freed_ab() + [
             _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1)])],
                      error=_no_attempt("cpe-2")),
             _step("config")] + freed),
        ("another image for a member that the campaign released",
         released + [
             _do_report("A", "cpe-1", "succeeded", stage="commit"),
             _step("acquired", want=[]),
             _do_edit([_a("run", [_m("cpe-1", OTHER_IMAGE), _m("cpe-2")])],
                      error=_kept_image("cpe-1")),
             _step("restart"),
             _do_edit([_a("run", [_m("cpe-1", OTHER_IMAGE), _m("cpe-2")])],
                      error=_kept_image("cpe-1")),
             _step("config"),
             _step("acquired", want=[])]),
        ("another image for a member that was up to date",
         _freed_ab() + [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", OTHER_IMAGE)])])] + freed),
        ("a new version in the image list",
         _freed_ab() + [_do_edit([_a("run", [_m("cpe-1"), _m("cpe-2")])], newer)] + freed),
        ("a new prepare-attempt",
         _freed_ab() + [
             _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", prepare_attempt=1)])])] + freed),
    ]
    _stack_cases(t, cases)


proc def _test_a_complete_campaign_ignores_a_pause(t: testing.EnvT):
    """A complete campaign set to plan and back to run changes nothing for
    its freed members, and asks for nothing. A member added to it is
    acquired alone."""
    two = [_m("cpe-1"), _m("cpe-2")]
    cases: list[(str, list[_Step])] = [
        ("plan, run, and a new member",
         _freed_ab() + [
             _do_edit([_a("plan", two)]),
             _step("wait", seconds=1.0),
             _step("acquired", want=[]),
             _do_edit([_a("run", two)]),
             _step("wait", seconds=1.0),
             _step("acquired", want=[]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True),
             _step("requests", "A", want=_freed_ab_requests()),
             _do_edit([_a("run", two + [_m("cpe-3")])]),
             _step("acquired", want=["cpe-3 A 0 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "cpe-3 pending", "counted 2 0 0"])]),
    ]
    _stack_cases(t, cases)


proc def _test_a_freed_device_can_join_another_campaign(t: testing.EnvT):
    """A freed device is acquired by no campaign, so another campaign can
    acquire it, also in the edit that removes it from the first. A new
    attempt in the first fails while the other has acquired the device, and
    goes through once the other frees it."""
    two = [_m("cpe-1"), _m("cpe-2")]
    tried = [_m("cpe-1", attempt=1), _m("cpe-2")]
    b = ("B", "run", [_m("cpe-1")], "")
    cases: list[(str, list[_Step])] = [
        ("another campaign acquires a freed device",
         _freed_ab(one="failed") + [
             _do_edit([_a("run", two), b]),
             _step("acquired", want=["cpe-1 B 0 held"]),
             _do_edit([_a("run", tried), b], error="/software/upgrade-campaign"),
             _step("acquired", want=["cpe-1 B 0 held"])]),
        ("a freed device moves in one edit",
         _freed_ab() + [
             _do_edit([_a("run", [_m("cpe-2")]), b]),
             _step("acquired", want=["cpe-1 B 0 held"])]),
        ("a new attempt once the other campaign frees the device",
         _freed_ab(one="failed") + [
             _do_edit([_a("run", two), b]),
             _do_report("B", "cpe-1", "up-to-date"),
             _step("sync", "B"),
             _step("acquired", want=[]),
             _do_edit([_a("run", tried), b]),
             _step("acquired", want=["cpe-1 A 1 held"])]),
    ]
    _stack_cases(t, cases)


proc def _test_a_freeing_and_an_edit_that_cross(t: testing.EnvT):
    """An edit whose transform runs before the actor's request lands does
    not undo the freeing: the actor writes the output without the freed
    members, asks again for the same results, and its requests add the
    results to memory after the edit. A request that lands after an edit
    gave a member a new attempt, or removed it, does not undo the edit: the
    result of that member no longer stands. A request that lands after an
    edit removed a member and another added it again frees it for a moment
    at most: the actor's next request, without it, acquires it again, also
    when that request has no result."""
    two = [_m("cpe-1"), _m("cpe-2")]
    crossing = [_do_edit([_a("run", two)]),
                _do_report("A", "cpe-1", "up-to-date"),
                _do_report("A", "cpe-2", "up-to-date"),
                _step("hold-requests", "A"),
                _step("sync", "A"),
                _step("requests", "A", want=_freed_ab_requests())]
    cases: list[(str, list[_Step])] = [
        ("an edit before the request",
         crossing + [
             _do_edit([_a("run", two)], [(IMAGE, "17.18.05", "", IMAGE_SIZE),
                                         (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]),
             _step("acquired", want=[]),
             _step("requests", "A",
                   want=_freed_ab_requests()
                        + ["2: cpe-1 0 up-to-date None None, cpe-2 0 up-to-date None None"]),
             _step("release-requests", "A"),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True),
             _step("wait", seconds=0.5),
             _step("restart"),
             _step("acquired", want=[]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True)]),
        ("a request after an edit that gives a member a new attempt",
         [_do_edit([_a("run", two)]),
          _do_report("A", "cpe-2", "failed"),
          _step("sync", "A"),
          _step("rows", want=["cpe-1 A 17.18.03a 0 held", "cpe-2 A 17.18.03a 0 held failed"]),
          _step("hold-requests", "A"),
          _do_report("A", "cpe-1", "up-to-date"),
          _step("requests", "A", want=_freed_ab_requests(two="failed")),
          _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1)])]),
          _step("acquired", want=["cpe-2 A 1 held"]),
          _step("release-requests", "A"),
          _step("wait", seconds=0.5),
          _step("acquired", want=["cpe-2 A 1 held"]),
          _step("restart"),
          _step("acquired", want=["cpe-2 A 1 held"]),
          _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 pending",
                                    "counted 1 0 0"])]),
        ("a request after an edit that removes a member",
         crossing + [
             _do_edit([_a("run", [_m("cpe-1")])]),
             _step("release-requests", "A"),
             _step("wait", seconds=0.5),
             _step("restart"),
             _step("acquired", want=[]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "counted 1 0 0"],
                   complete=True)]),
        ("a request after edits that remove a member and add it again",
         crossing + [
             _do_edit([_a("run", [_m("cpe-1")])]),
             _do_edit([_a("run", two + [_m("cpe-3")])]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date",
                                       "cpe-3 pending", "counted 2 0 0"]),
             _step("release-request", "A"),
             _step("wait", seconds=0.5),
             _step("release-requests", "A"),
             _step("wait", seconds=0.5),
             _step("acquired", want=["cpe-2 A 0 held", "cpe-3 A 0 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date",
                                       "cpe-3 pending", "counted 2 0 0"]),
             _step("restart"),
             _step("acquired", want=["cpe-2 A 0 held", "cpe-3 A 0 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 pending",
                                       "cpe-3 pending", "counted 1 0 0"])]),
        ("a request after edits that remove the only freed member and add it again",
         [_do_edit([_a("run", [_m("cpe-2")])]),
          _do_report("A", "cpe-2", "up-to-date"),
          _step("hold-requests", "A"),
          _step("sync", "A"),
          _step("requests", "A", want=["1: cpe-2 0 up-to-date None None"]),
          _do_edit([_a("run", [])]),
          _do_edit([_a("run", [_m("cpe-2"), _m("cpe-3")])]),
          _step("state", "A", want=["cpe-2 up-to-date", "cpe-3 pending", "counted 1 0 0"]),
          _step("release-request", "A"),
          _step("wait", seconds=0.5),
          _step("release-requests", "A"),
          _step("wait", seconds=0.5),
          _step("acquired", want=["cpe-2 A 0 held", "cpe-3 A 0 held"]),
          _step("restart"),
          _step("acquired", want=["cpe-2 A 0 held", "cpe-3 A 0 held"]),
          _step("state", "A", want=["cpe-2 pending", "cpe-3 pending", "counted 0 0 0"])]),
        ("a request after edits that remove a member with a new attempt and add it again",
         _freed_ab(two="failed") + [
             _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1)])]),
             _step("acquired", want=["cpe-2 A 1 held"]),
             _step("hold-requests", "A"),
             _do_report("A", "cpe-2", "up-to-date", attempt=1),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date freed",
                                       "counted 2 0 0"], complete=True),
             _do_edit([_a("run", [_m("cpe-1")])]),
             _do_edit([_a("run", [_m("cpe-1"), _m("cpe-2", attempt=1), _m("cpe-3")])]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date",
                                       "cpe-3 pending", "counted 2 0 0"]),
             _step("release-request", "A"),
             _step("wait", seconds=0.5),
             _step("release-requests", "A"),
             _step("wait", seconds=0.5),
             _step("acquired", want=["cpe-2 A 1 held", "cpe-3 A 0 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 up-to-date",
                                       "cpe-3 pending", "counted 2 0 0"]),
             _step("restart"),
             _step("acquired", want=["cpe-2 A 1 held", "cpe-3 A 0 held"]),
             _step("state", "A", want=["cpe-1 up-to-date freed", "cpe-2 pending",
                                       "cpe-3 pending", "counted 1 0 0"])]),
    ]
    _stack_cases(t, cases)


def _tried_after(group: str, budget: str, first: _Step,
                 meanwhile: list[_Step]=[]) -> list[_Step]:
    """Campaign A over cpe-1 and cpe-2 with group and budget: cpe-1 reports
    first, and cpe-2 fails, so A frees both. Then a new attempt of cpe-2
    acquires it again. Once the campaign shows it pending, cpe-1's device
    reports its status for no campaign, meanwhile happens, and then cpe-2
    answers that it needs the upgrade."""
    two = [_m("cpe-1"), _m("cpe-2")]
    tried = [_m("cpe-1"), _m("cpe-2", attempt=1)]
    return [_do_edit([_a("run", two, budget)], group=group), first,
            _do_report("A", "cpe-2", "failed"), _step("sync", "A"),
            _step("acquired", want=[]),
            _do_edit([_a("run", tried, budget)], group=group),
            _step("row", "A", "cpe-2", want=["pending"]),
            _do_report("A", "cpe-1", first.status, tag="-", stage=first.stage)] + meanwhile + [
            _do_report("A", "cpe-2", "upgrade-needed", attempt=1)]


proc def _test_a_complete_campaign_holds_a_new_attempt_by_its_results(t: testing.EnvT):
    """A member that gets a new attempt after its campaign freed its
    group-mates waits for them by their results, not by what their devices
    report: behind a group-mate that failed in a group that holds, one
    whose rollback failed, and one that is down, and for the
    min-separation from when the group-mate was done, also when its device
    reports a later boot, and after a restart. A group-mate whose device's
    state goes holds no one. A freed failure counts against the failure
    budget."""
    cases: list[(str, list[_Step])] = [
        ("a group-mate that failed in a group that holds",
         _tried_after("hold", "", _do_report("A", "cpe-1", "failed")) + [
             _step("held", "A", "cpe-2", want=["group-failed cpe-1"])]),
        ("a group-mate whose rollback failed",
         _tried_after("continue", "", _do_report("A", "cpe-1", "failed", stage="rollback")) + [
             _step("held", "A", "cpe-2", want=["group-failed cpe-1"])]),
        ("a group-mate that is down",
         _tried_after("continue", "", _do_report("A", "cpe-1", "up-to-date"), [
             _do_report("A", "cpe-1", "upgrade-needed", tag="-", connected=False)]) + [
             _step("held", "A", "cpe-2", want=["group-down cpe-1"])]),
        ("the min-separation from the group-mate",
         _tried_after("apart", "", _do_report("A", "cpe-1", "succeeded"), [
             _do_report("A", "cpe-1", "succeeded", tag="-", boot=600)]) + [
             _step("apart", "A", "cpe-2", seconds=3600.0, want=["cpe-1"]),
             _step("restart"),
             _step("row", "A", "cpe-2", want=["pending"]),
             _do_report("A", "cpe-2", "upgrade-needed", attempt=1),
             _step("sync", "A"),
             _step("apart", "A", "cpe-2", seconds=3600.0, want=["cpe-1"])]),
        ("over the failure budget",
         _tried_after("", "0", _do_report("A", "cpe-1", "failed")) + [
             _step("held", "A", "cpe-2", want=["failure-budget None"])]),
        ("a group-mate whose device's state goes",
         _tried_after("continue", "", _do_report("A", "cpe-1", "succeeded"), [
             _step("gone", "A", "cpe-1")]) + [
             _step("acquired", want=["cpe-2 A 1 free"])]),
    ]
    _stack_cases(t, cases)
