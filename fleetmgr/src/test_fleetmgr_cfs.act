actor _test_campaign_publishes_the_install_step(t: testing.AsyncT):
    """The campaign shows the install job that a member's flotilla relays,
    also when only its step changes."""
    var last = "nothing"
    names = ["cpe-1", "cpe-2"]
    wait = float(cfs.campaign_debounce_s(len(names))) + 0.5

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None:
            r = oper!.state.device_status.get("cpe-1")
            if r is not None:
                i = r.install
                last = "{r.stage}: {i.state} {i.release} {i.started} {i.ended} ({i.message})"

    def installing(message: str) -> y1_oper.stratoweave_rfs__rfs__device__state:
        status, a = _attempt_state("in-progress", "paced", "17.18.03a", 0, "install", None)
        a.install.state = "running"
        a.install.release = "17.18.03a"
        a.install.started = "2026-11-12T22:30:00Z"
        a.install.message = message
        return status

    def check(want: str) -> bool:
        if last == want:
            return True
        t.failure(ValueError("cpe-1 published as {last}, not {want}"))
        return False

    # Two waits of a debounce and its margin take 3 s, the default limit.
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def second() -> None:
        if check("install: running 17.18.03a 2026-11-12T22:30:00Z None (activate: reload)"):
            t.success()

    def first() -> None:
        if check("install: running 17.18.03a 2026-11-12T22:30:00Z None (add: extract)"):
            campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                            installing("activate: reload"), None)
            after wait: second()

    def __startup__():
        t.timeout(5.0)
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        campaign.on_subscriptions_synced()
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), installing("add: extract"), None)
        after wait: first()



actor _test_campaign_platform_change_publishes_nothing(t: testing.AsyncT):
    """A member's state that changes only in what the campaign does not
    show, here the serial number, and a device outside the campaign
    publish nothing."""
    var publications = 0

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        publications += 1

    def state(serial: str) -> y1_oper.stratoweave_rfs__rfs__device__state:
        s = y1_oper.stratoweave_rfs__rfs__device__state()
        s.platform.version = "17.18.2"
        s.platform.model = "C8000V"
        s.platform.serial_number = serial
        return s

    names = ["cpe-1", "cpe-2"]
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def quiet(seen: int) -> None:
        if publications == seen:
            t.success()
        else:
            t.failure(ValueError("published again"))

    def unchanged() -> None:
        seen = publications
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), state("9KSKL403GG7"), None)
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-9"), device_name="cpe-9"), state("9ABCDEFGHIJ"), None)
        after float(cfs.campaign_debounce_s(len(names))) + 0.5: quiet(seen)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), state("9ABCDEFGHIJ"), None)
        campaign.on_subscriptions_synced()

        # The publications of the conf and the sync are in.
        after 0.2: unchanged()



actor _test_campaign_device_status_platform(t: testing.AsyncT):
    """Each device's version and model reach the campaign with its state,
    also when one of them changes alone after a campaign in plan has
    published. A device not heard from has neither."""
    want = ["cpe-1 17.18.2 C8300-1N1S-4T2X", "cpe-2 17.18.3a ISR4331", "cpe-3 None None"]
    var last: list[str] = []

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None:
            got = []
            for name in ["cpe-1", "cpe-2", "cpe-3"]:
                r = oper!.state.device_status.get(name)
                if r is not None:
                    got.append("{name} {r.version} {r.model}")
                else:
                    got.append("{name} missing")
            last = got

    def check() -> None:
        if last == want:
            t.success()
        else:
            t.failure(ValueError("platforms not published: {last}"))

    names = ["cpe-1", "cpe-2", "cpe-3"]
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def report(name: str, version: str, model: str) -> None:
        s = y1_oper.stratoweave_rfs__rfs__device__state()
        s.platform.version = version
        s.platform.model = model
        campaign.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), s, None)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())

        report("cpe-1", "17.18.2", "C8000V")
        report("cpe-2", "17.18.2", "ISR4331")
        # The replay is in. A campaign in plan publishes once it is synced.
        campaign.on_subscriptions_synced()
        # cpe-1 is a new box; cpe-2 is upgraded by hand.
        report("cpe-1", "17.18.2", "C8300-1N1S-4T2X")
        report("cpe-2", "17.18.3a", "ISR4331")
        after float(cfs.campaign_debounce_s(len(names))) + 0.5: check()



def _render_layout(header: str, layout: list[(str, int, int, list[(str, int, int)])],
                   alarms: list[str]) -> str:
    """The materialized layout as the review artefact: per window, each
    device with its estimated start offset."""
    lines = [header]
    for win in layout:
        wend = "open" if win.2 == cfs.OPEN_END else "+{win.2}s"
        lines.append("")
        lines.append("window {win.0}: +{win.1}s to {wend}")
        counts: dict[int, int] = {}
        for entry in win.3:
            counts[entry.2] = counts.get_def(entry.2, 0) + 1
        mode = 0
        best = 0
        for dur, cnt in counts.items():
            if cnt > best:
                best = cnt
                mode = dur
        offset = -1
        names: list[str] = []
        for entry in win.3:
            if entry.1 != offset and len(names) > 0:
                lines.append("  +{offset:4d}s " + " ".join(names))
                names = []
            offset = entry.1
            # A device whose duration differs from the window's usual one
            # is marked, so a mixed fleet is visible in the record.
            names.append(entry.0 if entry.2 == mode else "{entry.0}({entry.2}s)")
        if len(names) > 0:
            lines.append("  +{offset:4d}s " + " ".join(names))
    for alarm in alarms:
        lines.append("")
        lines.append("ALARM: {alarm}")
    return "\n".join(lines)


def _test_snapshot_plan_estimates():
    """Estimated starts are the controller's own predicted launches: the
    ramp from one device, three more for each device done without a
    failure, up to the target of four, not an even spread."""
    campaign = InputCampaign(
        name="ramped",
        admin_state="plan",
        target_concurrency=u64(4),
        max_concurrency=u64(8),
    )
    names = []
    for i in range(10):
        campaign.device.create("dev-{i}", image=IMAGE)
        names.append("dev-{i}")
    layout, alarms, conc = _plan(campaign, _flat_inventory(names), 0)
    return _render_layout("10 mock devices, no windows, target 4, max 8 at once: "
                          + "4s nominal estimates, ramp to 4 in flight",
                          layout, alarms)

def _test_campaign_debounce_scales_with_members():
    testing.assertEqual(cfs.campaign_debounce_s(10), 1)
    testing.assertEqual(cfs.campaign_debounce_s(100), 1)
    testing.assertEqual(cfs.campaign_debounce_s(1000), 1)
    testing.assertEqual(cfs.campaign_debounce_s(10000), 10)
    testing.assertEqual(cfs.campaign_debounce_s(100000), 30)


def _test_snapshot_plan_estimates_slow_devices():
    """The same fleet with a configured 8s mock upgrade duration: the
    estimate comes from the device config, so the starts stretch to
    match."""
    campaign = InputCampaign(
        name="ramped",
        admin_state="plan",
        target_concurrency=u64(8),
        max_concurrency=u64(16),
    )
    names = []
    for i in range(10):
        campaign.device.create("dev-{i}", image=IMAGE)
        names.append("dev-{i}")
    layout, alarms, conc = _plan(campaign, _flat_inventory(names, upgrade_duration=8), 0)
    return _render_layout("10 mock devices at a configured 8s duration, "
                          + "target 8, max 16 at once",
                          layout, alarms)


def _test_snapshot_plan_estimates_mixed_fleet():
    """Nine quick mocks and one real device: the prediction runs the
    controller over the true mixture, so the ramp advances on the mock
    completions and the slow device rides a late wave, marked with its
    own duration."""
    campaign = InputCampaign(
        name="mixed",
        admin_state="plan",
        target_concurrency=u64(8),
        max_concurrency=u64(16),
    )
    linked = _flat_inventory(["dev-{i}" for i in range(9)])
    real = linked.fleet.device.create(
        "dev-real", type="iosxe",
        credentials=InputCredentials(username="admin"))
    for i in range(9):
        campaign.device.create("dev-{i}", image=IMAGE)
    campaign.device.create("dev-real", image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    return _render_layout("nine 4s mocks and one real device at the adapter's "
                          + "395s nominal, target 8, max 16 at once",
                          layout, alarms)


actor _test_campaign_deadline_honors_ramp_up(t: testing.AsyncT):
    """A deadline the steady-state division calls makeable but the ramp
    cannot make: ten 8 s devices before a deadline at 36 s. A device
    starts only while 12 s, one and a half upgrades, are left, so there is
    time for three rounds, at 0, 9 and 18 s. At four at once the ramp
    starts 1, 4 and 4, so they need five at once, and max is four. The
    plan alarms."""

    def __startup__():
        names = []
        for i in range(10):
            names.append("r{i}")
        campaign = InputCampaign(
            name="tight",
            admin_state="plan",
            deadline=u64(36),
            target_concurrency=u64(1),
            max_concurrency=u64(4),
        )
        for name in names:
            campaign.device.create(name, image=IMAGE)
        layout, alarms, conc = _plan(campaign, _flat_inventory(names, upgrade_duration=8), 0)
        testing.assertEqual(alarms, ["1 device(s) cannot start before the deadline even at "
                                     + "max-concurrency 4: r9"])
        testing.assertEqual(conc, 4)
        t.success()


actor _test_campaign_estimate_from_the_adapter(t: testing.AsyncT):
    """A device without mock config plans at the IOS XE adapter's nominal
    duration; a mocked one at its configured duration."""

    def __startup__():
        linked = y_0.root()
        real = linked.fleet.device.create(
            "real-1", type="iosxe",
            credentials=InputCredentials(username="admin"))
        mocked = linked.fleet.device.create(
            "mock-1", type="iosxe",
            credentials=InputCredentials(username="admin"))
        mocked.mock.enabled = True
        mocked.mock.software.upgrade_duration = u64(120)
        campaign = InputCampaign(
            name="mixed",
            admin_state="plan",
        )
        campaign.device.create("real-1", image=IMAGE)
        campaign.device.create("mock-1", image=IMAGE)
        layout, alarms, conc = _plan(campaign, linked, 0)
        ests: dict[str, int] = {}
        for win in layout:
            for entry in win.3:
                ests[entry.0] = entry.2
        testing.assertEqual(ests.get_def("real-1", 0), 395,
                            "a real device plans at the adapter's nominal duration")
        testing.assertEqual(ests.get_def("mock-1", 0), 120,
                            "a mocked device plans at its configured duration")
        t.success()


def _test_device_prepare_estimate():
    """A device's prepare estimate is the part of its upgrade estimate that
    the copy takes on the IOS XE adapter. The upgrade estimate does not
    change."""
    linked = y_0.root()
    # (name, mocked, upgrade-duration, prepare estimate, upgrade estimate)
    cases: list[(str, bool, ?int, int, int)] = [
        ("mock-395", True, 395, 130, 395),
        ("mock-8", True, 8, 2, 8),
        ("mock-3", True, 3, 1, 3),
        ("mock-no-duration", True, None, 1, 4),
        ("real", False, None, 130, 395),
    ]
    for c in cases:
        dev = linked.fleet.device.create(
            c.0, type="iosxe", credentials=InputCredentials(username="admin"))
        if c.1:
            dev.mock.enabled = True
            dur = c.2
            if dur is not None:
                dev.mock.software.upgrade_duration = u64(dur)
        testing.assertEqual(cfs.device_prepare_estimate(dev), c.3,
                            c.0 + ": prepare estimate")
        testing.assertEqual(cfs.device_estimate(dev), c.4,
                            c.0 + ": upgrade estimate")


def _test_window_open_since_yesterday_is_an_occurrence():
    """A window that opens at 23:00 for 4 h is still open at 01:00 the next
    day, so it is the first occurrence then."""
    linked = y_0.root()
    linked.schedules.schedule.create("late").window.create(u64(1), at=u64(23 * 3600), duration=u64(4 * 3600))
    sched = linked.schedules.schedule.get("late")
    if sched is not None:
        testing.assertEqual(cfs.occurrences(sched, 86400 + 3600)[0],
                            (23 * 3600, 27 * 3600))
    else:
        testing.assertTrue(False, "the schedule must exist")


def _test_windows_open_at_the_same_time():
    """Short weekday and long weekend windows both open at 22:00. On friday
    a 5 h window opens then too, and the longer of the two counts."""
    linked = y_0.root()
    sched = linked.schedules.schedule.create("split")
    weekdays = sched.window.create(u64(1), at=u64(22 * 3600), duration=u64(3 * 3600))
    weekdays.day = ["mon", "tue", "wed", "thu", "fri"]
    weekend = sched.window.create(u64(2), at=u64(22 * 3600), duration=u64(8 * 3600))
    weekend.day = ["sat", "sun"]
    friday = sched.window.create(u64(3), at=u64(22 * 3600), duration=u64(5 * 3600))
    friday.day = ["fri"]
    # Day 4, 1970-01-05, was a monday; sunday's window is still open then.
    want: list[(int, int)] = []
    for p in [(3, 8), (4, 3), (5, 3), (6, 3), (7, 3), (8, 5), (9, 8), (10, 8), (11, 3), (12, 3)]:
        want.append((p.0 * 86400 + 22 * 3600, p.0 * 86400 + (22 + p.1) * 3600))
    s = linked.schedules.schedule.get("split")
    if s is not None:
        testing.assertEqual(cfs.occurrences(s, 4 * 86400), want)
    else:
        testing.assertTrue(False, "the schedule must exist")


def _test_campaign_open_window_takes_only_its_rest():
    """A window opened 3.5 h ago with 30 min left takes the two 10 min
    devices that fit at one at a time; the rest go to tomorrow's window."""
    names = ["o{i}" for i in range(6)]
    linked = _flat_inventory(names, upgrade_duration=600)
    linked.schedules.schedule.create("day").window.create(u64(1), at=u64(0), duration=u64(14400))
    campaign = InputCampaign(
        name="late",
        admin_state="plan",
        default_schedule="day",
        target_concurrency=u64(1),
        max_concurrency=u64(1),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 12600)
    by_start: dict[int, list[str]] = {}
    for win in layout:
        by_start[win.1] = sorted([entry.0 for entry in win.3])
    testing.assertEqual(by_start.get_def(0, []), ["o0", "o1"],
                        "the open window keeps its real start and takes what fits")
    testing.assertEqual(by_start.get_def(86400, []), ["o2", "o3", "o4", "o5"],
                        "the rest go to tomorrow")
    testing.assertEqual(alarms, [], None)


def _daily_campaign(name: str, devices: int, deadline: ?int, target: int,
                    maxc: int, stagger: ?int=0) -> (InputCampaign, y_0.root):
    """devices 10 min devices d0, d1, ... in a 1 h window every day, at
    the stagger, by default none, so that the starts of a round go
    together. A stagger of None leaves the campaign's default."""
    names = ["d{i}" for i in range(devices)]
    linked = _flat_inventory(names, upgrade_duration=600)
    linked.schedules.schedule.create("day").window.create(u64(1), at=u64(0), duration=u64(3600))
    campaign = InputCampaign(
        name=name,
        admin_state="plan",
        default_schedule="day",
        target_concurrency=u64(target),
        max_concurrency=u64(maxc),
    )
    if deadline is not None:
        campaign.deadline = u64(deadline)
    if stagger is not None:
        campaign.stagger = u64(stagger)
    for n in names:
        campaign.device.create(n, image=IMAGE)
    return (campaign, linked)


def _window_sizes(layout: list[(str, int, int, list[(str, int, int)])]) -> list[int]:
    return [len(win.3) for win in layout]


def _test_campaign_window_takes_what_the_ramp_starts():
    """100 devices of 10 min, a 1 h window every day, 10 at once. The
    first window ramps 1, 4, 10, 10, 10 and has no time for a sixth
    round: it takes 35. The ramp belongs to the campaign, so the next
    window runs five rounds of 10 and takes 50, and the third the last
    15."""
    campaign, linked = _daily_campaign("ramp", 100, None, 10, 10)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(_window_sizes(layout), [35, 50, 15])
    testing.assertEqual([win.1 for win in layout], [0, 86400, 172800])
    testing.assertEqual(alarms, [])
    testing.assertEqual(conc, 10)


def _test_campaign_close_margin_reaches_the_controller():
    """The campaign's close-margin sets how late in a window a device
    starts. The same 100 devices of 10 min, a 1 h window every day, 10 at
    once. Each round starts one second, the debounce, after the round
    before ends, so the rounds of a window start at 0, 601, 1202, 1803 and
    2404 s. At the default of 150 percent a device starts while 900 s are
    left, up to 2700 s: all five rounds fit, and the windows take 35, 50
    and 15. At 200 percent it starts while 1200 s are left, up to 2400 s:
    the fifth round does not fit, so the first window takes 1, 4, 10 and
    10, 25, the second four rounds of 10, 40, and the third the last 35."""
    # (the campaign's close-margin, or None for the default, and the
    # number of devices in each window)
    cases: list[(?int, list[int])] = [
        (None, [35, 50, 15]),
        (200, [25, 40, 35]),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("margin", 100, None, 10, 10)
        margin = case.0
        if margin is not None:
            campaign.close_margin = u64(margin)
        layout, alarms, conc = _plan(campaign, linked, 0)
        testing.assertEqual(_window_sizes(layout), case.1, str(margin))
        testing.assertEqual(alarms, [], str(margin))


def _test_campaign_prepare_reaches_the_controller():
    """The campaign's allow-staging sets whether the controller lets members
    prepare, and each member's prepare estimate goes with it: 2 s for a
    mock of 8 s, and 1 s for a mock with no duration. So does the size of
    each member's image. prepare-before-first-window,
    prepare-between-windows and prepare-during-windows say when the members
    may prepare: by default before the first window, between windows by
    the plan's choice (None), and not during windows. The cap of their
    bandwidth is the campaign's prepare-max-bandwidth, or else the image
    list's, 1 Gbit/s by default, and at most the largest int. The same
    controller is configured in turn, so a setting that goes back reaches
    it too."""
    names = ["cpe-1", "cpe-2"]
    linked = _with_nightly(_flat_inventory(names, 8))
    cpe3 = linked.fleet.device.create("cpe-3", type="iosxe",
                                      credentials=InputCredentials(username="admin"))
    cpe3.mock.enabled = True
    campaign = _paced_campaign(names + ["cpe-3"])
    ctl = fctl.Controller()
    # (case, allow-staging, prepare-before-first-window,
    # prepare-between-windows, prepare-during-windows, the campaign's
    # prepare-max-bandwidth and the image list's, None for none set; the
    # controller's prepare, before the first window, between windows,
    # during windows and cap)
    cases: list[(str, bool, ?bool, ?bool, ?bool, ?int, ?int, bool, bool, ?bool, bool, int)] = [
        ("defaults", True, None, None, None, None, None, True, True, None, False, 1000000000),
        ("all set", True, False, True, True, 5000000, None, True, False, True, True, 5000000),
        ("between off, the image list's cap", True, None, False, None, None, 2000000, True,
         True, False, False, 2000000),
        ("allow-staging off", False, None, None, None, None, None, False, True, None, False,
         1000000000),
    ]
    for case in cases:
        label = case.0
        campaign.allow_staging = case.1
        before = case.2
        campaign.prepare_before_first_window = before if before is not None else True
        campaign.prepare_between_windows = case.3
        during = case.4
        campaign.prepare_during_windows = during if during is not None else False
        cap = case.5
        campaign.prepare_max_bandwidth = u64(cap) if cap is not None else None
        fleet_cap = case.6
        linked.images.prepare_max_bandwidth = u64(fleet_cap) if fleet_cap is not None \
            else u64(1000000000)
        cfs.configure_campaign(ctl, campaign, linked, 0)
        testing.assertEqual((ctl.prepare, ctl.prepare_first, str(ctl.prepare_between),
                             ctl.prepare_during, ctl.prepare_cap),
                            (case.7, case.8, str(case.9), case.10, case.11), label)
        testing.assertEqual(ctl.prepare_est, {"cpe-1": 2, "cpe-2": 2, "cpe-3": 1}, label)
        testing.assertEqual(ctl.prepare_size,
                            {"cpe-1": IMAGE_SIZE, "cpe-2": IMAGE_SIZE, "cpe-3": IMAGE_SIZE},
                            label)
    # The largest cap that the YANG takes, the campaign's or the image
    # list's.
    largest = u64(cfs.INT_MAX) * u64(2) + u64(1)
    for own in [True, False]:
        campaign.allow_staging = True
        campaign.prepare_max_bandwidth = largest if own else None
        linked.images.prepare_max_bandwidth = u64(1000000000) if own else largest
        cfs.configure_campaign(ctl, campaign, linked, 0)
        testing.assertEqual(ctl.prepare_cap, cfs.INT_MAX, "the largest cap, own: {own}")


def _test_campaign_stagger_reaches_the_controller():
    """The campaign's stagger spreads the starts. The same 100 devices of
    10 min, a 1 h window every day, 10 at once. The second window opens
    with room for 10 devices: at the default of 25 percent they start over
    a quarter of an upgrade, one every 15 s; at 100 percent over one
    upgrade, one a minute; at 0 all at once."""
    # (the campaign's stagger, or None for the default, and the planned
    # starts of the first three devices in the second window)
    cases: list[(?int, list[int])] = [
        (None, [86400, 86415, 86430]),
        (100, [86400, 86460, 86520]),
        (0, [86400, 86400, 86400]),
    ]
    for case in cases:
        stagger = case.0
        campaign, linked = _daily_campaign("stagger", 100, None, 10, 10, stagger)
        layout, alarms, conc = _plan(campaign, linked, 0)
        starts = sorted([entry.1 for entry in layout[1].3])
        testing.assertEqual(starts[:3], case.1, str(stagger))
        testing.assertEqual(alarms, [], str(stagger))


def _test_failure_budget_devices():
    """A failure budget in percent of a campaign's members gives the most
    members that may fail, rounded down to whole devices. Without a
    budget it gives -1."""
    # (the budget in percent, or None for no budget, the members, and the
    # devices)
    cases: list[(?str, int, int)] = [
        (None, 1000, -1),
        ("0", 1000, 0),
        ("0.5", 1000, 5),
        ("0.50", 1000, 5),
        ("1", 50, 0),
        ("2", 50, 1),
        ("10", 9, 0),
        ("10", 10, 1),
        ("10", 19, 1),
        ("2", 100, 2),
        ("2", 99, 1),
        ("33.33", 3, 0),
        ("33.34", 3, 1),
        ("0.01", 9999, 0),
        ("0.01", 10000, 1),
        ("2.5", 100000, 2500),
        ("100", 7, 7),
        ("100.00", 7, 7),
        ("50", 0, 0),
    ]
    for case in cases:
        label = "{str(case.0)} percent of {case.1}"
        p = case.0
        percent: ?Decimal = None
        if p is not None:
            percent = Decimal.parse(p)
        testing.assertEqual(cfs.failure_budget_devices(percent, case.1), case.2, label)


def _test_campaign_failure_budget_reaches_the_controller():
    """The campaign's failure-budget reaches the controller in devices of
    the members the campaign has: 25 percent of 10 members is 2, and of 4
    members 1. Without a budget the controller has none. The same
    controller is configured in turn, so a change of the members or of
    the budget reaches it too."""
    # (the failure-budget in percent, or None for none, the members, and
    # the controller's budget in devices)
    cases: list[(?str, int, int)] = [
        ("25", 10, 2),
        ("25", 4, 1),
        (None, 4, -1),
        ("0", 10, 0),
    ]
    ctl = fctl.Controller()
    for case in cases:
        names = ["cpe-{i}" for i in range(case.1)]
        campaign = _paced_campaign(names)
        p = case.0
        if p is not None:
            campaign.failure_budget = Decimal.parse(p)
        cfs.configure_campaign(ctl, campaign, _with_nightly(_flat_inventory(names)), 0)
        testing.assertEqual(ctl.failure_budget, case.2, "{str(p)} percent of {case.1}")


def _test_campaign_deadline_raises_the_planned_concurrency():
    """The same fleet with a deadline at the end of the second window. At
    11 at once the two windows take 38 and 55, seven short; at 12 they
    take 41 and 59, so the plan runs at 12."""
    campaign, linked = _daily_campaign("deadline", 100, 86400 + 3600, 10, 50)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(conc, 12)
    testing.assertEqual(_window_sizes(layout), [41, 59])
    testing.assertEqual(alarms, [])


def _test_campaign_replan_keeps_the_ramp():
    """The fleet with the deadline, run through the first window on the
    estimates and planned again between the windows. The run's ramp is
    at 12, so the second window still takes its 59 at 12 at once. A plan
    that ramped from one again would need 19 at once."""
    campaign, linked = _daily_campaign("deadline", 100, 86400 + 3600, 10, 50)
    campaign.admin_state = "run"
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    sim.drive(ctl, 0, {}, 50000)
    cfs.configure_campaign(ctl, campaign, linked, 50000)
    p = ctl.plan(50000)
    testing.assertEqual(_window_sizes(ctl.layout(p)), [41, 59])
    testing.assertEqual(p.alarms, [])
    testing.assertEqual(p.c, 12)


def _test_campaign_long_device_waits_for_a_window_it_fits():
    """Two devices of 30 min and ten of 1 min share a 1 h window every day,
    one at a time. The first long device fills half the window, and the
    second does not fit in the half left, so it goes to the next day,
    and the short ones take the rest of the first window."""
    linked = y_0.root()
    linked.schedules.schedule.create("day").window.create(u64(1), at=u64(0), duration=u64(3600))
    names: list[str] = []
    for group in [("a", 2, 1800), ("b", 10, 60)]:
        for i in range(group.1):
            name = "{group.0}{i}"
            dev = linked.fleet.device.create(name, type="iosxe",
                                             credentials=InputCredentials(username="admin"))
            dev.mock.enabled = True
            dev.mock.software.upgrade_duration = u64(group.2)
            names.append(name)
    campaign = InputCampaign(
        name="long",
        admin_state="plan",
        default_schedule="day",
        target_concurrency=u64(1),
        max_concurrency=u64(1),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    by_start: dict[int, list[str]] = {}
    for win in layout:
        by_start[win.1] = sorted([entry.0 for entry in win.3])
    testing.assertEqual(by_start.get_def(0, []),
                        ["a0", "b0", "b1", "b2", "b3", "b4", "b5", "b6", "b7", "b8", "b9"])
    testing.assertEqual(by_start.get_def(86400, []), ["a1"])
    testing.assertEqual(alarms, [])


def _test_campaign_device_without_a_window_keeps_the_concurrency():
    """A device bound to a schedule that opens only after the deadline fits
    no window at any concurrency. The other 99 fit at 10 at once, so the
    plan stays at 10 and only that device raises an alarm."""
    campaign, linked = _daily_campaign("unfit", 100, 2 * 86400 + 3600, 10, 50)
    sunday = linked.schedules.schedule.create("sunday").window.create(u64(1), at=u64(0),
                                                                     duration=u64(3600))
    sunday.day = ["sun"]
    _bind(linked, "d99", "sunday")
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(conc, 10)
    testing.assertEqual(_window_sizes(layout), [35, 50, 14])
    testing.assertEqual(alarms, ["1 device(s) cannot start before the deadline: d99"])


def _test_campaign_deadline_beyond_the_horizon_keeps_the_concurrency():
    """500 devices that need more windows than the planner looks ahead,
    and a deadline 30 days out. The planner does not see the windows
    that reach the deadline, so it does not raise the concurrency for
    it."""
    campaign, linked = _daily_campaign("far", 500, 30 * 86400, 10, 50)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(conc, 10)
    testing.assertEqual(len(alarms), 1)
    testing.assertTrue(alarms[0].startswith("65 device(s) are in no window yet: "), alarms[0])


def _test_notice_cut():
    """The notice cut is run-since, or now before the first run, plus the
    notification period in days. Without a notification period it is 0, so
    every window counts."""
    # (case, the notification period in days, run-since, now, the cut)
    cases: list[(str, int, ?int, int, int)] = [
        ("no notice", 0, None, 1000, 0),
        ("no notice, in a run", 0, 500, 1000, 0),
        ("a day, before the first run", 1, None, 1000, 1000 + 86400),
        ("a day, in a run", 1, 500, 1000, 500 + 86400),
        ("a week, in a run", 7, 500, 1000, 500 + 7 * 86400),
        ("a day, passed", 1, 500, 500 + 3 * 86400, 500 + 86400),
    ]
    for case in cases:
        testing.assertEqual(cfs.notice_cut(case.1, case.2, case.3), case.4, case.0)


def _notice_windows(period: int, run_since: ?int, now: int) -> list[(str, int, int)]:
    """The windows that the controller gets from a campaign with one member
    and a notification period of period days, at time now: its schedule has
    a 1 h window at 02:00 every day."""
    linked = _flat_inventory(["d0"])
    linked.schedules.schedule.create("day").window.create(u64(1), at=u64(7200), duration=u64(3600))
    campaign = InputCampaign(name="notice", admin_state="run", default_schedule="day",
                             notification_period=u64(period))
    campaign.device.create("d0", image=IMAGE)
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, now, None, run_since)
    return ctl.current


def _test_campaign_uses_the_windows_from_the_notice_cut():
    """A 1 h window at 02:00 every day, and now is midnight. The campaign
    uses only the windows that open at the cut or later. It leaves out a
    window that opens before the cut, also when the window closes after it.
    The horizon starts at the cut, so a notice longer than the horizon
    still gives windows."""
    now = 10 * 86400
    tonight = now + 7200
    # (case, the notification period in days, run-since, the first and the
    # last window's opening, and the number of windows)
    cases: list[(str, int, ?int, int, int, int)] = [
        ("no notice", 0, None, tonight, tonight + 8 * 86400, 9),
        ("no notice, in a run", 0, now - 86400, tonight, tonight + 8 * 86400, 9),
        ("a day, before the first run", 1, None, tonight + 86400, tonight + 9 * 86400, 9),
        ("the cut at the opening", 1, tonight - 86400, tonight, tonight + 8 * 86400, 9),
        ("the cut in the window", 1, tonight - 86400 + 1, tonight + 86400,
         tonight + 8 * 86400, 8),
        ("the cut at the close", 1, tonight - 86400 + 3600, tonight + 86400,
         tonight + 8 * 86400, 8),
        ("the cut passed", 1, now - 2 * 86400, tonight, tonight + 8 * 86400, 9),
        ("a week", 7, None, tonight + 7 * 86400, tonight + 15 * 86400, 9),
        ("past the horizon", 12, None, tonight + 12 * 86400, tonight + 20 * 86400, 9),
    ]
    for case in cases:
        windows = _notice_windows(case.1, case.2, now)
        testing.assertEqual(len(windows), case.5, case.0)
        if len(windows) > 0:
            testing.assertEqual((windows[0].1, windows[-1].1), (case.3, case.4), case.0)
            testing.assertEqual([w.2 - w.1 for w in windows], [3600 for w in windows], case.0)


def _test_campaign_without_a_schedule_opens_at_the_notice_cut():
    """A campaign without a schedule gets one window that opens at the cut,
    at 0 without a notice, and that closes at the deadline or never. A
    deadline at the cut or before it leaves no window."""
    now = 10 * 86400
    # (case, the notification period in days, run-since, the deadline, and
    # the windows)
    cases: list[(str, int, ?int, ?int, list[(str, int, int)])] = [
        ("no notice", 0, None, None, [("default", 0, cfs.OPEN_END)]),
        ("no notice, a deadline", 0, None, now + 86400, [("default", 0, now + 86400)]),
        ("a day, before the first run", 1, None, None, [("default", now + 86400, cfs.OPEN_END)]),
        ("a day, in a run", 1, now - 100, None, [("default", now + 86300, cfs.OPEN_END)]),
        ("a day, a deadline after the cut", 1, None, now + 2 * 86400,
         [("default", now + 86400, now + 2 * 86400)]),
        ("a day, a deadline at the cut", 1, None, now + 86400, []),
        ("two days, a deadline before the cut", 2, None, now + 86400, []),
    ]
    for case in cases:
        campaign = InputCampaign(name="anytime", admin_state="run",
                                 notification_period=u64(case.1))
        dl = case.3
        if dl is not None:
            campaign.deadline = u64(dl)
        campaign.device.create("d0", image=IMAGE)
        ctl = fctl.Controller()
        cfs.configure_campaign(ctl, campaign, _flat_inventory(["d0"]), now, None, case.2)
        testing.assertEqual(ctl.current, case.4, case.0)


def _test_campaign_deadline_and_the_notice_cut():
    """Two devices, a notification period of 5 days, and a deadline. A
    deadline before the cut leaves the campaign no window, and the plan says
    that the devices cannot start before the deadline. The planner sees
    every window before the deadline when the deadline is at most 8 days
    after the cut, so every device must start then."""
    now = 10 * 86400
    # (case, the schedule, or None for none, the deadline, whether every
    # device must start, and the alarms)
    cases: list[(str, ?str, int, bool, list[str])] = [
        ("a schedule, the deadline before the cut", "day", now + 3 * 86400, True,
         ["2 device(s) cannot start before the deadline even at max-concurrency 1: d0, d1"]),
        ("no schedule, the deadline before the cut", None, now + 3 * 86400, True,
         ["2 device(s) cannot start before the deadline even at max-concurrency 1: d0, d1"]),
        ("a schedule, the deadline 7 days after the cut", "day", now + 12 * 86400, True, []),
        ("a schedule, the deadline 10 days after the cut", "day", now + 15 * 86400, False, []),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("dl", 2, case.2, 1, 1)
        campaign.default_schedule = case.1
        campaign.notification_period = u64(5)
        layout, alarms, conc = _plan(campaign, linked, now)
        testing.assertEqual(alarms, case.4, case.0)
        ctl = fctl.Controller()
        cfs.configure_campaign(ctl, campaign, linked, now)
        testing.assertEqual(ctl.must_place, case.3, case.0)


def _test_campaign_notice_raised_in_a_run():
    """20 devices of 10 min, a 1 h window at midnight every day, 10 at once,
    in a run without a notice. The first decision releases d0 and promises
    the others tonight's window. A notification period of 2 days, set 10 s
    later, takes tonight's window and tomorrow's away. d0 keeps its window,
    and the others get the first window that is left."""
    campaign, linked = _daily_campaign("raise", 20, None, 10, 10)
    campaign.admin_state = "run"
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0, None, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    s = ctl.decide(0)
    testing.assertEqual(s.started, ["d0"])
    testing.assertEqual([win.1 for win in ctl.layout(s.plan)], [0])
    campaign.notification_period = u64(2)
    cfs.configure_campaign(ctl, campaign, linked, 10, None, 0)
    p = ctl.plan(10)
    layout = ctl.layout(p)
    testing.assertEqual([(win.1, len(win.3)) for win in layout], [(0, 1), (2 * 86400, 19)])
    testing.assertEqual([entry.0 for entry in layout[0].3], ["d0"])
    testing.assertEqual(p.alarms, [])


def _test_campaign_prepares_spread_over_the_notice():
    """Three members with allow-staging and a 1 h window at midnight every
    day, planned at 02:00, after tonight's window closed. The first window
    that the campaign uses is the deadline of the prepares. Without a
    notice, that is the window a day from now, so the prepares start within
    a day. With a notice of two days, it is the window three days from now,
    so the prepares spread over the notice."""
    now = 10 * 86400 + 7200
    # (case, the notification period in days, and whether the last prepare
    # starts more than a day from now)
    cases: list[(str, int, bool)] = [
        ("no notice", 0, False),
        ("two days", 2, True),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("prep", 3, None, 1, 1)
        campaign.allow_staging = True
        campaign.notification_period = u64(case.1)
        ctl = fctl.Controller()
        cfs.configure_campaign(ctl, campaign, linked, now)
        sim.answer_all(ctl, now)
        ctl.start()
        ctl.plan(now)
        starts = ctl.prepares(now).starts
        testing.assertEqual(sorted(list(starts.keys())), ["d0", "d1", "d2"], case.0)
        last = now
        for s in starts.values():
            last = fctl.imax(last, s)
        testing.assertEqual(last > now + 86400, case.2, "{case.0}: the last starts at {last - now}")


def _test_campaign_function_keeps_run_since():
    """The campaign's transform function keeps run-since in the campaign's
    memory. The edit that first sets the campaign to run sets it to the time
    of the edit. A later edit, a recompute, and a pause keep it. A campaign
    from an earlier version has no memory, so its first recompute or edit
    in run sets it."""
    names = ["cpe-1"]
    linked = _with_nightly(_flat_inventory(names)).to_gdata()
    # (case, admin-state, the run-since in the memory, and the run-since
    # that the function keeps, or -1 for the time of the edit)
    cases: list[(str, str, ?int, ?int)] = [
        ("plan, before the first run or from an earlier version", "plan", None, None),
        ("the first run, or a run from an earlier version", "run", None, -1),
        ("an edit or a recompute in run", "run", 50, 50),
        ("a pause", "plan", 50, 50),
        ("run after a pause", "run", 50, 50),
    ]
    for case in cases:
        campaign = _paced_campaign(names)
        campaign.admin_state = case.1
        memory: ?gdata.Node = None
        kept = case.2
        if kept is not None:
            memory = InputMemory(run_since=u64(kept)).to_gdata()
        before = time.time().unix_s()
        out = cfs.UpgradeCampaign().transform_wrapper(campaign.to_gdata(), linked, memory, None,
                                                      None)
        later = time.time().unix_s()
        got: ?int = None
        m = out.1
        if m is not None:
            r = InputMemory.from_gdata(m).run_since
            if r is not None:
                got = int(r)
        want = case.3
        if want is not None and want == -1:
            testing.assertTrue(got is not None and got! >= before and got! <= later,
                               "{case.0}: {got} in {before}..{later}")
        else:
            testing.assertEqual(got, want, case.0)


def _bind(linked: y_0.root, name: str, schedule: str) -> None:
    dev = linked.fleet.device.get(name)
    if dev is not None:
        dev.schedule = schedule


actor _test_campaign_devices_follow_their_own_schedule(t: testing.AsyncT):
    """A bound device lands only in its own schedule's windows; unbound
    members follow the campaign default."""

    def __startup__():
        linked = _flat_inventory(["n1", "w1", "w2"])
        sch = linked.schedules.schedule.create("night")
        sch.window.create(u64(1), at=u64(0), duration=u64(3600))
        wk = linked.schedules.schedule.create("weekend")
        wk.window.create(u64(1), at=u64(3600), duration=u64(3600))
        _bind(linked, "w1", "weekend")
        _bind(linked, "w2", "weekend")
        campaign = InputCampaign(
            name="split",
            admin_state="plan",
            default_schedule="night",
        )
        for name in ["n1", "w1", "w2"]:
            campaign.device.create(name, image=IMAGE)
        layout, alarms, conc = _plan(campaign, linked, 0)
        testing.assertEqual(len(alarms), 0, None)
        testing.assertEqual(_window_names(layout, "night"), ["n1"],
                            "the unbound member follows the campaign default")
        testing.assertEqual(_window_names(layout, "weekend"), ["w1", "w2"],
                            "bound members use their own schedule")
        t.success()


def _test_snapshot_plan_two_schedules():
    """The layout across two schedules: five nightly devices ramp from
    one in the first window. The ramp belongs to the campaign, so the five
    weekend bound devices in the later window start at once, at the eight
    it reached, spread by the default stagger."""
    linked = _flat_inventory(["n0", "n1", "n2", "n3", "n4",
                              "w0", "w1", "w2", "w3", "w4"], upgrade_duration=8)
    sch = linked.schedules.schedule.create("night")
    sch.window.create(u64(1), at=u64(0), duration=u64(3600))
    wk = linked.schedules.schedule.create("weekend")
    wk.window.create(u64(1), at=u64(7200), duration=u64(3600))
    for name in ["w0", "w1", "w2", "w3", "w4"]:
        _bind(linked, name, "weekend")
    campaign = InputCampaign(
        name="split",
        admin_state="plan",
        default_schedule="night",
        target_concurrency=u64(8),
        max_concurrency=u64(16),
    )
    for name in ["n0", "n1", "n2", "n3", "n4", "w0", "w1", "w2", "w3", "w4"]:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    return _render_layout("two schedules, ten 8s devices, half bound to the "
                          + "weekend window at +2h",
                          layout, alarms)


def _layout_lines(layout: list[(str, int, int, list[(str, int, int)])]) -> list[str]:
    """One line per window, each device at its start."""
    lines = []
    for win in layout:
        devs = ["{entry.0}@{entry.1}" for entry in win.3]
        lines.append("{win.0}@{win.1}: " + " ".join(devs))
    return lines


def _test_released_device_keeps_a_closed_window():
    """A device released in last night's window stays there at its real
    start after the window closed; the waiting one goes to tonight's."""
    linked = _with_nightly(_flat_inventory(["cpe-1", "cpe-2"]))
    campaign = _paced_campaign(["cpe-1", "cpe-2"])
    ctl = _replanned(campaign, linked, 1000)
    p = ctl.plan(1000)
    testing.assertEqual(_layout_lines(ctl.layout(p)),
                        ["nightly@0: cpe-1@10", "nightly@86400: cpe-2@86400"])
    testing.assertEqual(p.alarms, [])


def _test_mixed_fleet_runs_its_plan_without_alarm():
    """200 devices of 30 s bound to a 20 minute window and 20 of 1800 s
    bound to a 4 h window plan without alarms. Started the way the
    campaign actor starts a run, the controller's first decision starts
    the ramp's one device and raises no alarm either: it judges each
    device by its own estimate, not by the campaign's average of 191 s."""
    linked = y_0.root()
    linked.schedules.schedule.create("fast").window.create(u64(1), at=u64(0), duration=u64(1200))
    linked.schedules.schedule.create("slow").window.create(u64(1), at=u64(0), duration=u64(14400))
    names: list[str] = []
    # (name prefix, devices, upgrade duration, schedule)
    for group in [("f", 200, 30, "fast"), ("s", 20, 1800, "slow")]:
        for i in range(group.1):
            name = "{group.0}{i}"
            dev = linked.fleet.device.create(name, type="iosxe",
                                             credentials=InputCredentials(username="admin"))
            dev.mock.enabled = True
            dev.mock.software.upgrade_duration = u64(group.2)
            dev.schedule = group.3
            names.append(name)
    campaign = InputCampaign(
        name="mixed",
        admin_state="run",
        target_concurrency=u64(10),
        max_concurrency=u64(20),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(alarms, [])
    testing.assertEqual(conc, 10)
    testing.assertEqual(cfs.estimated_duration(campaign, linked), 191)
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    s = ctl.decide(0)
    testing.assertEqual(s.started, ["f0"])
    testing.assertEqual(s.plan.alarms, [])


def _window_start_of(layout: list[(str, int, int, list[(str, int, int)])], name: str) -> int:
    """The start of the window the layout puts the device name in, or -1."""
    for win in layout:
        for entry in win.3:
            if entry.0 == name:
                return win.1
    return -1


def _test_campaign_upgrades_a_redundancy_group_in_order():
    """30 devices of 10 min, a 1 h window every day, 4 at once: the plan
    uses the first two windows. d0 and d1 back each other up. d1 has the
    default priority, lower than d0's, so d1 goes first. A group with no
    entry spreads: d0 goes in the second window. A pack group starts d0
    in the first window, after d1, or with a min-separation of 1 h in the
    second window."""
    # (the group's separation-policy, or None for no entry, its
    # min-separation, and the windows of d1 and d0)
    cases: list[(?str, int, (int, int))] = [
        (None, 0, (0, 86400)),
        ("spread", 0, (0, 86400)),
        ("pack", 0, (0, 0)),
        ("pack", 3600, (0, 86400)),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("pair", 30, None, 4, 4)
        d0 = linked.fleet.device.get("d0")!
        d0.redundancy_group = ["core"]
        d0.redundancy_priority = u64(200)
        d1 = linked.fleet.device.get("d1")!
        d1.redundancy_group = ["core"]
        policy = case.0
        if policy is not None:
            linked.redundancy_groups.redundancy_group.create("core", separation_policy=policy,
                                                             min_separation=u64(case.1))
        layout, alarms, conc = _plan(campaign, linked, 0)
        testing.assertEqual((_window_start_of(layout, "d1"), _window_start_of(layout, "d0")),
                            case.2, str(policy) + " " + str(case.1))
        testing.assertEqual(alarms, [])


def _test_campaign_members_take_the_group_failure_policy():
    """A redundancy group holds on a failure only when its entry says
    hold. A group with no entry, or with continue, continues."""
    # (the group's failure-policy, or None for no entry, and whether it
    # holds on a failure)
    cases: list[(?str, bool)] = [
        (None, False),
        ("continue", False),
        ("hold", True),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("pair", 2, None, 1, 1)
        for name in ["d0", "d1"]:
            dev = linked.fleet.device.get(name)!
            dev.redundancy_group = ["core"]
        policy = case.0
        if policy is not None:
            linked.redundancy_groups.redundancy_group.create("core", failure_policy=policy)
        m = cfs.campaign_members(campaign, linked)
        testing.assertEqual("core" in m.hold_failed, case.1, str(policy))


def _test_closed_window_takes_no_new_devices():
    """Planned while tonight's window is open, last night's window still
    holds only the device released in it. The waiting device is placed
    once, in tonight's window, with no false overflow."""
    linked = _with_nightly(_flat_inventory(["cpe-1", "cpe-2"]))
    campaign = _paced_campaign(["cpe-1", "cpe-2"])
    ctl = _replanned(campaign, linked, 86500)
    p = ctl.plan(86500)
    testing.assertEqual(_layout_lines(ctl.layout(p)),
                        ["nightly@0: cpe-1@10", "nightly@86400: cpe-2@86500"])
    testing.assertEqual(p.alarms, [])


proc def _test_campaign_replan_keeps_released_devices(t: testing.AsyncT):
    """Run a campaign one device at a time, let two finish, then raise
    target-concurrency to two. The replan keeps the finished devices in
    their window with started and finished, and predicts the waiting ones
    from the device in flight instead of behind the finished ones. The
    ramp is at one device, because the run went one at a time, and it
    grows only when a device is done without a failure: d3 does not
    start at the replan. d3 starts when d2 is expected to finish, and d4
    at most a second later: at the default stagger, the two start over
    one upgrade at the observed pace. The plan expects the pace the run
    observed: d0 and d1 report done right away, so d2 is expected to
    finish before its 600 s estimate."""
    names = ["d0", "d1", "d2", "d3", "d4"]
    linked = _flat_inventory(names, upgrade_duration=600)
    ns = y0_oper.NS_software
    path = ttt.PathKey("replan",
                       ttt.PathElem(gdata.Id(ns, "upgrade-campaign"),
                                    ttt.PathElem(gdata.Id(ns, "software"), ttt.PathRoot("root"))),
                       {gdata.Id(ns, "name"): gdata.Leaf("replan")})
    done = False

    TestCampaignReplanKeepsReleasedDevicesActor(t=t, names=names, linked=linked, path=path, _initial_done=done)


actor TestCampaignReplanKeepsReleasedDevicesActor(t: testing.AsyncT, names, linked, path, _initial_done):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var seen: set[str] = set()
    var ready = False
    var replanned = False
    var done = _initial_done

    def campaign(conc: int) -> InputCampaign:
        cp = InputCampaign(
            name="replan",
            admin_state="run",
            target_concurrency=u64(conc),
            max_concurrency=u64(conc),
        )
        for name in names:
            cp.device.create(name, image=IMAGE)
        return cp

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            state = _tagged(status, "replan", "17.18.03a")
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), state, None)

    def finish(name: str) -> None:
        report(name, "succeeded")

    def replan() -> None:
        cc = controller
        if cc is not None:
            # Arm the check when submitting the new configuration, after
            # the publication belonging to d2's release has completed.
            replanned = True
            cc.on_conf(campaign(2), linked.to_gdata())

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None and not done:
            if replanned:
                done = True
                check(oper)

    def on_output(conf: gdata.Node):
        # A device in flight has no veto. A device that is done has it
        # again, so seen keeps every device released so far.
        for flotilla in y_1.root.from_gdata(conf).rfs:
            for d in flotilla.device:
                if d.software.veto.get(cfs.veto_holder("replan")) is None:
                    seen.add(d.name)
        if seen == {"d0"}:
            after 0.0: finish("d0")
        elif seen == {"d0", "d1"}:
            after 0.0: finish("d1")
        elif seen == {"d0", "d1", "d2"} and not ready:
            # Output is delivered asynchronously, after this decision's
            # oper publication. Queue the replan here; on_conf emits
            # this same released set again, so request it only once.
            ready = True
            after 0.0: replan()

    def check(oper: y0_oper.software__software__upgrade_campaign_entry) -> None:
        window: dict[str, str] = {}
        started: dict[str, int] = {}
        finished: dict[str, int] = {}
        estimated: dict[str, int] = {}
        for win in oper.state.plan.window:
            for dev in win.device:
                window[dev.name] = "{win.schedule}@{win.start}"
                s = dev.started
                if s is not None:
                    started[dev.name] = int(s)
                f = dev.finished
                if f is not None:
                    finished[dev.name] = int(f)
                e = dev.estimated_start
                if e is not None:
                    estimated[dev.name] = int(e)
        if window.get_def("d0", "") != "default@0" or window.get_def("d1", "") != "default@0":
            t.failure(ValueError("finished devices left their window: {window}"))
        elif "d0" not in started or "d0" not in finished or \
             "d1" not in started or "d1" not in finished:
            t.failure(ValueError("finished devices lost started or finished"))
        elif "d2" not in started or "d2" in finished:
            t.failure(ValueError("d2 must be in flight"))
        elif "d3" in started:
            t.failure(ValueError("d3 must wait for d2, as the ramp is at one: {started}"))
        elif estimated.get_def("d3", 0) <= started["d2"] or \
             estimated.get_def("d3", 0) >= started["d2"] + 600 or \
             estimated.get_def("d4", 0) < estimated.get_def("d3", 0) or \
             estimated.get_def("d4", 0) > estimated.get_def("d3", 0) + 1:
            t.failure(ValueError("d3 must start when d2 is expected to finish, at the "
                                 + "observed pace, and d4 at most a second later: "
                                 + "{estimated} {started}"))
        else:
            t.success()

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("no plan after the replan"))

    ctl = cfs.UpgradeCampaignTransform(path, on_output, lambda d: None, on_oper, None)

    def __startup__():
        controller = ctl
        # One device at a time.
        ctl.on_conf(campaign(1), linked.to_gdata())
        # Every member has read its release and needs the upgrade.
        for name in names:
            report(name, "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 5.0: timeout()



def _intents(out: gdata.Node) -> list[str]:
    """Each device in out, the output of a campaign, as "name campaign
    target URL [veto holders]", sorted."""
    lines: list[str] = []
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            sw = dev.software
            holders = ",".join([v.holder for v in sw.veto])
            lines.append("{dev.name} {sw.upgrade_campaign} {sw.target_release} {sw.image_url} [{holders}]")
    return sorted(lines)


def _tagged(status: str, campaign: ?str, target: ?str) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """A device state with attempt 0 at the target release target in
    campaign, with status."""
    return _attempt_state(status, campaign, target, 0, None, None).0


def _tagged_prepare(status: str, campaign: ?str, target: ?str, state: ?str,
                    release: ?str) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """A device state with attempt 0 at the target release target in
    campaign, with status and a prepare in state of release."""
    s, a = _attempt_state(status, campaign, target, 0, None, None)
    a.prepare.state = state
    a.prepare.release = release
    return s


def _with_version(linked: y_0.root, version: str) -> y_0.root:
    """linked with version as the version of IMAGE."""
    image = linked.images.image.get(IMAGE)
    if image is not None:
        image.version = version
    return linked


def _with_file(linked: y_0.root, path: str) -> y_0.root:
    """linked with path as the file of IMAGE."""
    image = linked.images.image.get(IMAGE)
    if image is not None:
        image.file = path
    return linked


actor _test_campaign_writes_its_intent_in_plan(t: testing.AsyncT):
    """A campaign in plan writes the intent of every member at once: the
    campaign's name, the target release, the image URL and the campaign's
    veto."""
    var done = False

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        done = True
        got = _intents(out)
        want = ["{name} paced 17.18.03a {URL_BASE}{IMAGE} [campaign:paced]"
                for name in ["cpe-1", "cpe-2", "cpe-3"]]
        if got == want:
            t.success()
        else:
            t.failure(ValueError("output: {got}"))

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("the campaign wrote no output"))

    names = ["cpe-1", "cpe-2", "cpe-3"]
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        after 2.0: timeout()



def _now_campaign(admin_state: str, names: list[str]) -> InputCampaign:
    """A campaign called now, with no schedule, so its window is open, and
    one device at a time."""
    campaign = InputCampaign(name="now", admin_state=admin_state,
                             target_concurrency=u64(1), max_concurrency=u64(1))
    for name in names:
        campaign.device.create(name, image=IMAGE)
    return campaign


proc def _test_campaign_run_to_plan_holds_members_in_flight(t: testing.AsyncT):
    """A campaign that goes from run to plan puts its veto back on the
    members in flight."""
    linked = _flat_inventory(["cpe-1"]).to_gdata()

    TestCampaignRunToPlanHoldsMembersInFlightActor(t=t, linked=linked)


actor TestCampaignRunToPlanHoldsMembersInFlightActor(t: testing.AsyncT, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var released = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if not released:
            if free == ["cpe-1"]:
                released = True
                cc = controller
                if cc is not None:
                    cc.on_conf(_now_campaign("plan", ["cpe-1"]), linked)
        elif vetoed == ["cpe-1"] and free == []:
            done = True
            t.success()
        else:
            fail("in plan: vetoed {vetoed}, not vetoed {free}")

    def timeout() -> None:
        if released:
            fail("no output in plan")
        else:
            fail("cpe-1 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(_now_campaign("run", ["cpe-1"]), linked)
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("upgrade-needed", "now", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 2.5: timeout()



actor _test_campaign_veto_back_when_done(t: testing.AsyncT):
    """A member in flight gets the campaign's veto back once its status
    says that it is done. cpe-2 never answers, so the campaign is not
    complete and does not free cpe-1."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var released = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if not released:
            if free == ["cpe-1"]:
                released = True
                cc = controller
                if cc is not None:
                    cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                              _tagged("succeeded", "now", "17.18.03a"), None)
        elif vetoed == ["cpe-1", "cpe-2"] and free == []:
            done = True
            t.success()
        else:
            fail("after done: vetoed {vetoed}, not vetoed {free}")

    def timeout() -> None:
        if released:
            fail("cpe-1 is done, but did not get the veto back")
        else:
            fail("cpe-1 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        t.timeout(5.0)
        controller = ctl
        ctl.on_conf(_now_campaign("run", ["cpe-1", "cpe-2"]),
                    _flat_inventory(["cpe-1", "cpe-2"]).to_gdata())
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("upgrade-needed", "now", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after float(cfs.campaign_debounce_s(1)) + 2.0: timeout()


proc def _WaitingRun(t: testing.AsyncT, mode: str):
    """Run the campaign late over cpe-1, whose window closes 8 s from now
    and whose upgrade takes 4 s. With the close margin of 150 percent, a
    try fits the window when it starts by 2 s from now. The campaign lifts
    the veto of cpe-1, and its device reports its run in-progress at the
    stage prepare. In the mode "waits", its prepare is retrying: the run
    waits to try its prepare again. In the mode "status goes", the status
    of cpe-1 goes right after that report. In the mode "tries again", its
    prepare runs, and 3.5 s from now it is retrying and then running
    again, before the campaign decides. In the mode "unknown", the device
    of cpe-1 cannot be read and reports its run unknown. Pass t when the
    campaign puts the veto back on cpe-1 within 7 s from now."""
    t.timeout(10.0)
    now = time.time().unix_s()
    campaign = InputCampaign(name="late", admin_state="run", default_schedule="late",
                             target_concurrency=u64(1), max_concurrency=u64(1))
    campaign.device.create("cpe-1", image=IMAGE)
    linked = _flat_inventory(["cpe-1"], 4)
    linked.schedules.schedule.create("late").window.create(u64(1), at=u64((now - 1) % 86400),
                                                           duration=u64(9))
    WaitingRunActor(t=t, mode=mode, campaign=campaign, linked=linked)


proc def _test_campaign_puts_the_veto_back_on_a_run_that_waits_past_its_window(
        t: testing.AsyncT):
    _WaitingRun(t, "waits")


proc def _test_campaign_keeps_the_wait_of_a_member_whose_status_goes(t: testing.AsyncT):
    _WaitingRun(t, "status goes")


proc def _test_campaign_puts_the_veto_back_on_a_run_that_tries_again_past_its_window(
        t: testing.AsyncT):
    _WaitingRun(t, "tries again")


proc def _test_campaign_puts_the_veto_back_on_a_run_that_waits_for_its_device(
        t: testing.AsyncT):
    _WaitingRun(t, "unknown")


def _in_prepare(prepare: str) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """The state of cpe-1 in the campaign late: in-progress at the stage
    prepare, with its prepare in the state prepare."""
    s, a = _attempt_state("in-progress", "late", "17.18.03a", 0, "prepare", None)
    a.prepare.state = prepare
    a.prepare.release = "17.18.03a"
    return s


actor WaitingRunActor(t: testing.AsyncT, mode: str, campaign, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var released = False
    var done = False

    keys = (rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1")

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "late")
        cc = controller
        if not released and free == ["cpe-1"] and cc is not None:
            released = True
            if mode == "tries again":
                cc.on_rfs(keys, _in_prepare("running"), None)
            elif mode == "unknown":
                cc.on_rfs(keys, _tagged("unknown", "late", "17.18.03a"), None)
            else:
                cc.on_rfs(keys, _in_prepare("retrying"), None)
            if mode == "status goes":
                cc.on_rfs(keys, None, None)
        elif released and vetoed == ["cpe-1"]:
            done = True
            t.success()

    def try_again() -> None:
        cc = controller
        if released and not done and cc is not None:
            cc.on_rfs(keys, _in_prepare("retrying"), None)
            cc.on_rfs(keys, _in_prepare("running"), None)

    def check() -> None:
        if not released:
            fail("cpe-1 was not released")
        else:
            fail("{mode}: the run of cpe-1 is past its window, and cpe-1 did not get the veto back")

    def __startup__():
        ctl = cfs.UpgradeCampaignTransform(_campaign_path("late"), on_output, lambda d: None, lambda o: None,
                                           None)
        controller = ctl
        ctl.on_conf(campaign, linked.to_gdata())
        ctl.on_rfs(keys, _tagged("upgrade-needed", "late", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        if mode == "tries again":
            after 3.5: try_again()
        after 7.0: check()


proc def _test_campaign_holds_a_member_with_a_stale_status(t: testing.AsyncT):
    """A member whose final status answers another campaign has not
    answered this one. The campaign holds it, shows it pending and names it
    in an alarm, until it answers. Then the campaign releases it, and it
    runs."""
    alarm = "1 device(s) have not answered the campaign's target: cpe-1"

    TestCampaignHoldsAMemberWithAStaleStatusActor(t=t, alarm=alarm)


actor TestCampaignHoldsAMemberWithAStaleStatusActor(t: testing.AsyncT, alarm):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var phase = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(status: str, campaign: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged(status, campaign, "17.18.03a"), None)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        if r is not None:
            held = False
            if r.status == "pending" and alarm in o.state.plan.alarm:
                held = True
            if phase == 0 and held:
                # The first decision holds cpe-1, which has not reported yet.
                phase = 1
                report("succeeded", "other")
            elif phase == 1 and held:
                # The decision after the status for the other campaign.
                phase = 2
                report("upgrade-needed", "now")

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if free == ["cpe-1"]:
            if phase == 2:
                done = True
                t.success()
            else:
                fail("cpe-1 was released at phase {phase}, before it answered")

    def timeout() -> None:
        fail("at phase {phase}, cpe-1 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(6.0)
        controller = ctl
        ctl.on_conf(_now_campaign("run", ["cpe-1"]), _flat_inventory(["cpe-1"]).to_gdata())
        ctl.on_subscriptions_synced()
        after 5.0: timeout()



proc def _SecondMemberStart(t: testing.AsyncT, name: str, boot_ago: ?int, least: int, most: int):
    now = time.time().unix_s()
    names = ["cpe-1", "cpe-2"]
    conf = InputCampaign(name=name, admin_state="plan", target_concurrency=u64(1),
                         max_concurrency=u64(1))
    for n in names:
        conf.device.create(n, image=IMAGE)
    linked = _flat_inventory(names)
    for n in names:
        d = linked.fleet.device.get(n)!
        d.redundancy_group = ["core"]
        if n == "cpe-1":
            d.redundancy_priority = u64(1)
    linked.redundancy_groups.redundancy_group.create("core", separation_policy="pack",
                                                     min_separation=u64(3600))
    first = _tagged("up-to-date", name, "17.18.03a")
    if boot_ago is not None:
        first.platform.last_boot = u64(now - boot_ago)
    SecondMemberStart(t, name, least, most, now, conf, linked, first)


actor SecondMemberStart(t: testing.AsyncT, name: str, least: int, most: int, now: int, conf, linked, first):
    var done = False

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        answered = False
        if r is not None:
            answered = r.status == "up-to-date"
        if not answered:
            return
        for win in o.state.plan.window:
            for dev in win.device:
                e = dev.estimated_start
                if dev.name == "cpe-2" and e is not None:
                    done = True
                    at = int(e) - now
                    if least <= at and at <= most:
                        t.success()
                    else:
                        t.failure(ValueError("cpe-2 starts {at} s from now, want {least} to {most}"))
                    return

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("the plan did not start cpe-2"))

    campaign = cfs.UpgradeCampaignTransform(_campaign_path(name), lambda c: None, lambda d: None, on_oper, None)

    def __startup__():
        campaign.on_conf(conf, linked.to_gdata())
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), first, None)
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-2"), device_name="cpe-2"),
                        _tagged("upgrade-needed", name, "17.18.03a"), None)
        campaign.on_subscriptions_synced()
        after 3.0: timeout()




actor _test_campaign_counts_the_min_separation_from_the_last_boot(t: testing.AsyncT):
    """cpe-1's device booted 30 days ago, so cpe-2 need not wait: it
    starts now."""

    def __startup__():
        _SecondMemberStart(t, "boot-long-ago", 30 * 86400, 0, 60)



actor _test_campaign_counts_the_min_separation_from_a_recent_boot(t: testing.AsyncT):
    """cpe-1's device booted 10 minutes ago, so cpe-2 waits the rest of
    the hour."""

    def __startup__():
        _SecondMemberStart(t, "boot-recent", 600, 2940, 3060)



actor _test_campaign_counts_the_min_separation_from_the_answer(t: testing.AsyncT):
    """cpe-1's device does not tell when it booted, so cpe-2 waits the hour
    from cpe-1's answer."""

    def __startup__():
        _SecondMemberStart(t, "boot-unknown", None, 3540, 3660)



proc def _test_campaign_image_change_holds_a_member_again(t: testing.AsyncT):
    """A member that answered up-to-date for the campaign's target in plan
    has not answered when the campaign runs with an image of another
    version: the device sends no new status for the change. The campaign
    holds it until it answers the new target, and then releases it, and it
    runs."""
    alarm = "1 device(s) have not answered the campaign's target: cpe-1"

    TestCampaignImageChangeHoldsAMemberAgainActor(t=t, alarm=alarm)


actor TestCampaignImageChangeHoldsAMemberAgainActor(t: testing.AsyncT, alarm):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var phase = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        cc = controller
        if r is not None and cc is not None:
            if phase == 0 and r.status == "up-to-date" and len(o.state.plan.alarm) == 0:
                # In plan, cpe-1 answered. Run with a newer image.
                phase = 1
                cc.on_conf(_now_campaign("run", ["cpe-1"]),
                           _with_version(_flat_inventory(["cpe-1"]), "17.18.04").to_gdata())
            elif phase == 1 and r.status == "pending" and alarm in o.state.plan.alarm:
                phase = 2
                cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                          _tagged("upgrade-needed", "now", "17.18.04"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if free == ["cpe-1"]:
            if phase == 2:
                done = True
                t.success()
            else:
                fail("cpe-1 was released at phase {phase}, before it answered")

    def timeout() -> None:
        fail("at phase {phase}, cpe-1 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(6.0)
        controller = ctl
        ctl.on_conf(_now_campaign("plan", ["cpe-1"]), _flat_inventory(["cpe-1"]).to_gdata())
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("up-to-date", "now", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 5.0: timeout()



proc def _test_campaign_image_change_makes_answers_stale(t: testing.AsyncT):
    """A member that answered the campaign's target shows pending, and
    counts nowhere, once its image in the campaign has another version.
    The device sends no new status for that. An up-to-date member counts
    in succeeded and in up-to-date."""
    names = ["cpe-1"]
    conf = _paced_campaign(names)

    TestCampaignImageChangeMakesAnswersStaleActor(t=t, names=names, conf=conf)


actor TestCampaignImageChangeMakesAnswersStaleActor(t: testing.AsyncT, names, conf):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var changed = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        got = "missing"
        if r is not None:
            got = "{r.status} {r.attempt}, succeeded {o.state.succeeded}, up-to-date {o.state.up_to_date}"
        if not changed:
            # The first publication comes before the device's state.
            if got == "up-to-date 0, succeeded 1, up-to-date 1":
                changed = True
                cc = controller
                if cc is not None:
                    newer = _with_version(_with_nightly(_flat_inventory(names)), "17.18.04")
                    cc.on_conf(conf, newer.to_gdata())
        elif got == "pending None, succeeded 0, up-to-date 0":
            done = True
            t.success()
        else:
            fail("after the image change: {got}")

    def timeout() -> None:
        if changed:
            fail("no publication after the image change")
        else:
            fail("cpe-1 did not show up-to-date")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def __startup__():
        conf.admin_state = "plan"
        controller = ctl
        ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("up-to-date", "paced", "17.18.03a"), None)
        # The replay is in. A campaign in plan publishes once it is synced.
        ctl.on_subscriptions_synced()
        after 2.0: timeout()



proc def _test_campaign_image_move_keeps_answers(t: testing.AsyncT):
    """Moving an image's file, a new file leaf, gives a member that already
    answered the new URL and keeps its answer: the target release is the
    same, so nothing is stale."""
    names = ["cpe-1"]
    conf = _paced_campaign(names)
    moved_file = "iosxe/17.18/" + IMAGE
    answered = "up-to-date 0, succeeded 1"

    TestCampaignImageMoveKeepsAnswersActor(t=t, names=names, conf=conf, moved_file=moved_file, answered=answered)


actor TestCampaignImageMoveKeepsAnswersActor(t: testing.AsyncT, names, conf, moved_file, answered):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var moved = False
    var url_written = False
    var done = False

    def move() -> None:
        cc = controller
        if cc is not None:
            cc.on_conf(conf, _with_file(_with_nightly(_flat_inventory(names)), moved_file).to_gdata())

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done or not moved:
            return
        dev = y_1.root.from_gdata(out).rfs.get(cfs.flotilla_of("cpe-1"))
        if dev is not None:
            d = dev.device.get("cpe-1")
            if d is not None and d.software.image_url == URL_BASE + moved_file and not url_written:
                url_written = True
                # A status can come before the output it goes with, so ask
                # for one more: it is from after the move.
                move()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        got = "missing"
        if r is not None:
            got = "{r.status} {r.attempt}, succeeded {o.state.succeeded}"
        if not moved:
            if got == answered:
                moved = True
                move()
        elif got != answered:
            fail("after the move: {got}")
        elif url_written:
            done = True
            t.success()

    def timeout() -> None:
        fail("moved {moved}, new URL written {url_written}")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        conf.admin_state = "plan"
        controller = ctl
        ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                   _tagged("up-to-date", "paced", "17.18.03a"), None)
        ctl.on_subscriptions_synced()
        after 2.0: timeout()



actor _test_campaign_counts_only_answers(t: testing.AsyncT):
    """The counters count only the statuses that answer the campaign: its
    name and the member's target release. A final status for another
    campaign or another target shows as pending, without an attempt."""
    var done = False
    names = ["cpe-1", "cpe-2", "cpe-3"]

    def row(o: y0_oper.software__software__upgrade_campaign_entry, name: str) -> str:
        r = o.state.device_status.get(name)
        if r is not None:
            return "{name} {r.status} {r.attempt}"
        return "{name} missing"

    def reported(o: y0_oper.software__software__upgrade_campaign_entry) -> bool:
        """Whether the states of the devices are in o. The first publication
        comes before them."""
        last = o.state.device_status.get("cpe-3")
        if last is not None:
            return last.version is not None
        return False

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        if not reported(o):
            return
        done = True
        st = o.state
        got = [row(o, name) for name in names] + [
            "in-progress {st.in_progress} succeeded {st.succeeded} failed {st.failed}"]
        want = [
            "cpe-1 succeeded 0",
            "cpe-2 pending None",
            "cpe-3 pending None",
            "in-progress 0 succeeded 1 failed 0",
        ]
        if got == want:
            t.success()
        else:
            t.failure(ValueError("device-status: {got}"))

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("the campaign published no states"))

    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)
    def report(name: str, status: str, tag_campaign: str, target: str) -> None:
        s = _tagged(status, tag_campaign, target)
        s.platform.version = "17.18.2"
        campaign.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), s, None)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())

        report("cpe-1", "succeeded", "paced", "17.18.03a")
        report("cpe-2", "succeeded", "other", "17.18.03a")
        report("cpe-3", "failed", "paced", "17.18.02")
        campaign.on_subscriptions_synced()
        after 2.0: timeout()



proc def _test_campaign_acquires_a_member_added_in_run(t: testing.AsyncT):
    """A member added to a campaign that runs is acquired as every member
    is: it gets the campaign's intent at once, held by the campaign's
    veto. The member in flight keeps no veto. The campaign holds the new
    member until it answers, also once the member in flight is done, and
    the plan names it in an alarm. When it answers, the campaign plans it
    and releases it."""
    # Once cpe-1 is done: whether the output has its veto back, and whether
    # a publication still holds cpe-2.
    done = False
    linked = _flat_inventory(["cpe-1", "cpe-2"]).to_gdata()
    alarm = "1 device(s) have not answered the campaign's target: cpe-2"

    TestCampaignAcquiresAMemberAddedInRunActor(t=t, _initial_done=done, linked=linked, alarm=alarm)


actor TestCampaignAcquiresAMemberAddedInRunActor(t: testing.AsyncT, _initial_done, linked, alarm):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var veto_back = False
    var still_held = False
    var done = _initial_done

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def answer() -> None:
        """Let cpe-2 answer once cpe-1 is done and cpe-2 is still held. The
        output and the publication of a decision come in either order."""
        if stage == 2 and veto_back and still_held:
            stage = 3
            report("cpe-2", "upgrade-needed")

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if "cpe-2" in free and stage < 3:
            fail("cpe-2 was released at stage {stage}, before it answered")
        elif stage == 0:
            if free == ["cpe-1"]:
                # cpe-1 is in flight. Add cpe-2.
                stage = 1
                cc = controller
                if cc is not None:
                    cc.on_conf(_now_campaign("run", ["cpe-1", "cpe-2"]), linked)
        elif stage == 1:
            if vetoed == ["cpe-2"] and free == ["cpe-1"] and targeted == ["cpe-1", "cpe-2"] \
               and unnamed == []:
                # cpe-2 is acquired. cpe-1 is done; cpe-2 has not answered.
                stage = 2
                report("cpe-1", "succeeded")
            else:
                fail("cpe-2 was not acquired: vetoed {vetoed}, not vetoed {free}, "
                     + "with a target {targeted}")
        elif stage == 2 and vetoed == ["cpe-1", "cpe-2"]:
            # cpe-1 is done: it has the veto again.
            veto_back = True
            answer()
        elif stage == 3 and free == ["cpe-2"]:
            done = True
            t.success()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or stage != 2:
            return
        o = oper!
        finished = False
        for win in o.state.plan.window:
            for dev in win.device:
                if dev.name == "cpe-1" and dev.finished is not None:
                    finished = True
        if finished:
            alarms = list(o.state.plan.alarm)
            if alarms == [alarm]:
                # The decision that saw cpe-1 done still holds cpe-2.
                still_held = True
                answer()
            else:
                fail("once cpe-1 is done, the alarms are {alarms}")

    def timeout() -> None:
        fail("at stage {stage}, cpe-2 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(8.0)
        controller = ctl
        ctl.on_conf(_now_campaign("run", ["cpe-1"]), linked)
        report("cpe-1", "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 6.0: timeout()



proc def _JoinsAgain(t: testing.AsyncT, failed: bool):
    t.timeout(8.0)
    """Run a campaign called now over cpe-1 and cpe-2, one at a time in a
    window that is open. cpe-2 never answers. The campaign releases cpe-1.
    When failed is true, cpe-1 then fails, and gets the veto back. cpe-1
    leaves the campaign, and joins it again with the same attempt. Its
    device keeps the attempt: the failed one, or, for a member that left in
    flight, the one that it ended before its install when it lost the
    target. Pass t when cpe-1 is held after it joins again, and then counts
    as failed, or is released again."""
    both = ["cpe-1", "cpe-2"]
    linked = _flat_inventory(both).to_gdata()

    JoinsAgainActor(t=t, failed=failed, both=both, linked=linked)


actor JoinsAgainActor(t: testing.AsyncT, failed: bool, both, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False
    var left_seen = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(status: str, reason: ?str) -> None:
        cc = controller
        if cc is not None:
            s, _a = _attempt_state(status, "now", "17.18.03a", 0, None, reason)
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), s, None)

    def members(names: list[str]) -> None:
        cc = controller
        if cc is not None:
            cc.on_conf(_now_campaign("run", names), linked)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0:
            if free == ["cpe-1"]:
                # cpe-1 is in flight.
                if failed:
                    stage = 1
                    report("failed", None)
                else:
                    stage = 2
                    members(["cpe-2"])
        elif stage == 1:
            if vetoed == both:
                # cpe-1 is done, and has the veto back.
                stage = 2
                members(["cpe-2"])
        elif stage == 2:
            if vetoed == ["cpe-2"] and free == []:
                stage = 3
                if not failed:
                    # The device ends its run before the install.
                    report("upgrade-needed", "target release withdrawn before install")
                members(both)
            else:
                fail("cpe-1 left: vetoed {vetoed}, not vetoed {free}")
        elif stage == 3:
            if vetoed == both and free == []:
                # cpe-1 is a new member: held until a decision takes its
                # answer.
                stage = 4
            else:
                fail("cpe-1 joined again: vetoed {vetoed}, not vetoed {free}")
        elif stage == 4 and free == ["cpe-1"]:
            if failed:
                fail("cpe-1 was released again after it failed")
            else:
                done = True
                t.success()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        # The publications come in order, but not in order with the output:
        # the decision that takes the answer of cpe-1 after it joined again
        # can publish before the output that gives cpe-1 the veto back. So
        # wait for the publication without cpe-1, after it left, and then
        # for one that counts it as failed.
        if done or oper is None or not failed or stage < 2:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        if r is None:
            left_seen = True
        if r is not None and left_seen:
            status = r.status
            if status == "failed" and o.state.failed == u64(1):
                done = True
                t.success()
            elif status is not None and status != "pending" and status != "failed":
                fail("cpe-1 joined again as {status}, failed {o.state.failed}")

    def timeout() -> None:
        fail("at stage {stage}, cpe-1 was not released again or counted as failed")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(_now_campaign("run", both), linked)
        report("upgrade-needed", None)
        ctl.on_subscriptions_synced()
        after 6.0: timeout()



def _attempts(out: gdata.Node) -> dict[str, u64]:
    """Return the attempt that out, the output of a campaign, writes for each
    device that has one."""
    attempts: dict[str, u64] = {}
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            r = dev.software.attempt
            if r is not None:
                attempts[dev.name] = r
    return attempts


def _tagged_attempt(status: str, attempt: int) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """A device state with the attempt attempt at the target release
    17.18.03a in the campaign now, with status."""
    return _attempt_state(status, "now", "17.18.03a", u64(attempt), None, None).0


def _with_attempt(names: list[str], name: str, attempt: int) -> InputCampaign:
    """The campaign now in run over names, with the attempt attempt for the
    member name."""
    campaign = _now_campaign("run", names)
    member = campaign.device.get(name)
    if member is not None:
        member.attempt = u64(attempt)
    return campaign


proc def _test_campaign_tries_a_failed_member_again_with_a_new_attempt(t: testing.AsyncT):
    t.timeout(8.0)
    """Run a campaign over cpe-1 and cpe-2, one at a time; cpe-2 never
    answers. cpe-1 is released, fails and gets the veto back. A new attempt
    for cpe-1 makes it a new member: the campaign writes the attempt, holds
    cpe-1 while its failure is for the old attempt, and releases it once it
    answers the new attempt."""
    both = ["cpe-1", "cpe-2"]
    linked = _flat_inventory(both).to_gdata()

    TestCampaignTriesAFailedMemberAgainWithANewAttemptActor(t=t, both=both, linked=linked)


actor TestCampaignTriesAFailedMemberAgainWithANewAttemptActor(t: testing.AsyncT, both, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(status: str, attempt: int) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged_attempt(status, attempt), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0:
            if free == ["cpe-1"]:
                stage = 1
                report("failed", 0)
        elif stage == 1:
            if vetoed == both:
                # cpe-1 is done, and has the veto back.
                stage = 2
                cc = controller
                if cc is not None:
                    cc.on_conf(_with_attempt(both, "cpe-1", 1), linked)
        elif stage == 2:
            if _attempts(out).get("cpe-1") == u64(1) and vetoed == both:
                # The failure is for attempt 0, so cpe-1 is held.
                stage = 3
                report("failed", 0)
                after 0.5: answer()
            else:
                fail("cpe-1 tried again: vetoed {vetoed}, attempts {_attempts(out)}")
        elif stage == 3:
            fail("cpe-1 released on the failure of the old attempt")
        elif stage == 4 and free == ["cpe-1"]:
            done = True
            t.success()

    def answer() -> None:
        if stage == 3:
            stage = 4
            report("upgrade-needed", 1)

    def timeout() -> None:
        fail("at stage {stage}, cpe-1 was not released again")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, lambda o: None, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(_with_attempt(both, "cpe-1", 0), linked)
        report("upgrade-needed", 0)
        ctl.on_subscriptions_synced()
        after 6.0: timeout()


actor _test_campaign_counts_a_failed_member_that_joins_again_as_failed(t: testing.AsyncT):
    """A member that failed, left the campaign and joined it again with the
    same attempt counts as failed, and is not released again: its device
    keeps the failed attempt. A new attempt tries it again."""

    def __startup__():
        _JoinsAgain(t, True)


actor _test_campaign_holds_a_member_that_left_in_flight_and_joins_again(t: testing.AsyncT):
    """A member that left the campaign while in flight, before its install,
    and joins it again gets the veto, and is released again: its device
    ended the attempt at upgrade-needed when it lost the target."""

    def __startup__():
        _JoinsAgain(t, False)


proc def _test_campaign_holds_a_member_with_a_veto_of_another_holder(t: testing.AsyncT):
    t.timeout(8.0)
    """cpe-1's device reports a veto of the holder health, besides the
    campaign's own. The campaign releases cpe-2 instead, and device-status
    says that health holds cpe-1. When the veto goes and cpe-2 is done,
    the campaign releases cpe-1."""
    done = False
    names = ["cpe-1", "cpe-2"]
    linked = _flat_inventory(names).to_gdata()

    TestCampaignHoldsAMemberWithAVetoOfAnotherHolderActor(t=t, _initial_done=done, names=names, linked=linked)


actor TestCampaignHoldsAMemberWithAVetoOfAnotherHolderActor(t: testing.AsyncT, _initial_done, names, linked):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = _initial_done

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str, vetoes: list[str]) -> None:
        state = _tagged(status, "now", "17.18.03a")
        for holder in vetoes:
            state.veto.create(holder, reason="held")
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), state, None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0 and free == ["cpe-1"]:
            fail("cpe-1 released under the veto of health")
        elif stage == 2 and free == ["cpe-1"]:
            done = True
            t.success()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or stage != 0:
            return
        o = oper!
        ds = o.state.device_status.get("cpe-1")
        if ds is not None and ds.held == "vetoed":
            if ds.held_by != "health":
                fail("cpe-1 held by {ds.held_by}")
            elif [v.holder for v in ds.veto] != ["campaign:now", "health"]:
                fail("cpe-1 shows the vetoes {[v.holder for v in ds.veto]}")
            else:
                stage = 1
                report("cpe-2", "succeeded", ["campaign:now"])
                after 1.5: lift()

    def lift() -> None:
        if stage == 1 and not done:
            stage = 2
            report("cpe-1", "upgrade-needed", ["campaign:now"])

    def timeout() -> None:
        fail("at stage {stage}, cpe-1 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        controller = ctl
        ctl.on_conf(_now_campaign("run", names), linked)
        report("cpe-1", "upgrade-needed", ["campaign:now", "health"])
        report("cpe-2", "upgrade-needed", ["campaign:now"])
        ctl.on_subscriptions_synced()
        after 7.0: timeout()



proc def _test_campaign_stops_releasing_over_its_failure_budget(t: testing.AsyncT):
    """A campaign of three members, one at a time, with a failure budget of
    10 percent: none of its three members may fail. cpe-1 fails, so the
    campaign releases no more members: the decision that counts the
    failure releases nothing, counts cpe-1 failed, and its plan's alarm
    says why. When the budget rises to 50 percent, one member may fail,
    and the campaign releases cpe-2."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    linked = _flat_inventory(names).to_gdata()
    alarm = "1 device(s) failed, more than the failure budget of 0: no more devices start"

    TestCampaignStopsReleasingOverItsFailureBudgetActor(t=t, names=names, linked=linked, alarm=alarm)


actor TestCampaignStopsReleasingOverItsFailureBudgetActor(t: testing.AsyncT, names, linked, alarm):
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False

    def budgeted(percent: str) -> InputCampaign:
        campaign = _now_campaign("run", names)
        campaign.failure_budget = Decimal.parse(percent)
        return campaign

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0:
            if free == ["cpe-1"]:
                # cpe-1 is in flight, and fails.
                stage = 1
                report("cpe-1", "failed")
        elif stage == 2 and free == ["cpe-2"]:
            done = True
            t.success()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or stage != 1:
            return
        o = oper!
        if alarm in o.state.plan.alarm:
            # The decision that published the alarm took its step: the
            # plan shows each member it released as started.
            started: list[str] = []
            for win in o.state.plan.window:
                for dev in win.device:
                    if dev.started is not None:
                        started.append(dev.name)
            if "cpe-2" in started or "cpe-3" in started:
                fail("over the budget, the campaign released {started}")
            elif o.state.failed != u64(1):
                fail("over the budget, failed is {o.state.failed}")
            else:
                stage = 2
                cc = controller
                if cc is not None:
                    cc.on_conf(budgeted("50"), linked)

    def timeout() -> None:
        fail("at stage {stage}, cpe-2 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda d: None, on_oper, None)

    def __startup__():
        t.timeout(8.0)
        controller = ctl
        ctl.on_conf(budgeted("10"), linked)
        for name in names:
            report(name, "upgrade-needed")
        ctl.on_subscriptions_synced()
        after 6.0: timeout()



def _test_device_live():
    """A device is down when the top is not connected to its flotilla, or
    the flotilla is not connected to the device. A connection that is
    unknown counts as up."""
    # (the top to the flotilla, the flotilla to the device, up)
    cases: list[(?bool, ?bool, bool)] = [
        (None, None, True),
        (True, None, True),
        (None, True, True),
        (True, True, True),
        (None, False, False),
        (True, False, False),
        (False, None, False),
        (False, True, False),
        (False, False, False),
    ]
    for c in cases:
        testing.assertEqual(cfs.device_live(c.0, c.1), c.2, "flotilla {c.0}, device {c.1}")


def _test_held_status():
    """A member that is down only because the top is not connected to its
    flotilla is held for flotilla-down, by the flotilla. Its own connection
    comes first, and the other reasons stay as the controller gives them."""
    # (reason, holder, the top to the flotilla, the flotilla to the device,
    # published reason and holder)
    cases: list[(str, str, ?bool, ?bool, (str, str))] = [
        ("down", "", None, False, ("down", "")),
        ("down", "", True, False, ("down", "")),
        ("down", "", False, None, ("flotilla-down", "flotilla-8")),
        ("down", "", False, True, ("flotilla-down", "flotilla-8")),
        ("down", "", False, False, ("down", "")),
        ("group-down", "cpe-007", False, None, ("group-down", "cpe-007")),
        ("not-answered", "", False, None, ("not-answered", "")),
        ("failure-budget", "", None, None, ("failure-budget", "")),
    ]
    for c in cases:
        testing.assertEqual(cfs.held_status(c.0, c.1, "flotilla-8", c.2, c.3), c.4,
                            "{c.0} by {c.1}, flotilla {c.2}, device {c.3}")


def _test_connection():
    """A fleet device is connected while its flotilla says so and the top
    is not cut off from the flotilla. Its own connection comes first, as a
    campaign's held gives it: a device that was down before the top lost
    its flotilla stays device-down. Nothing is said while neither is known,
    or while only the flotilla is up."""
    # (the top to the flotilla, the flotilla to the device, published)
    cases: list[(?bool, ?bool, ?str)] = [
        (None, None, None),
        (True, None, None),
        (None, True, "connected"),
        (True, True, "connected"),
        (None, False, "device-down"),
        (True, False, "device-down"),
        (False, None, "flotilla-down"),
        (False, True, "flotilla-down"),
        (False, False, "device-down"),
    ]
    for c in cases:
        testing.assertEqual(cfs.connection(c.0, c.1), c.2, "flotilla {c.0}, device {c.1}")
        held = cfs.held_status("down", "", "flotilla-8", c.0, c.1).0
        testing.assertEqual(held == "flotilla-down", c.2 == "flotilla-down",
                            "held {held}, flotilla {c.0}, device {c.1}")


def _fleet_device_path(name: str) -> ttt.Path:
    """Return the path of one /fleet/device entry, as TTT builds it."""
    fleet = ttt.PathElem(gdata.Id(y0_oper.NS_fleetmgr, "fleet"), ttt.PathRoot("root"))
    devices = ttt.PathElem(gdata.Id(y0_oper.NS_fleetmgr, "device"), fleet)
    return ttt.PathKey(name, devices, {gdata.Id(y0_oper.NS_fleetmgr, "name"): gdata.Leaf(name)})


actor _test_fleet_device_publishes_how_it_is_connected(t: testing.AsyncT):
    """A fleet device publishes whether it can be reached next to its
    platform, as its flotilla and the top's entry for the flotilla report
    it. Its flotilla going down shows while the device is connected. A
    device that was down before stays device-down while its flotilla is
    down and after it is back. Shutdown clears the state."""
    want = ["connected None None", "connected 17.18.2 1795075960",
            "flotilla-down 17.18.2 1795075960", "connected 17.18.2 1795075960",
            "device-down 17.18.2 1795075960", "connected 17.18.2 1795075960", "gone"]
    var got: list[str] = []

    def on_oper(oper: ?y0_oper.fleetmgr__fleet__device_entry) -> None:
        if oper is not None:
            p = oper!.state.platform
            got.append("{oper!.state.connected} {p.version} {p.last_boot}")
        else:
            got.append("gone")

    def check() -> None:
        if got == want:
            t.success()
        else:
            t.failure(ValueError("published {got}"))

    name = "cpe-001"
    f = cfs.flotilla_of(name)
    dev = cfs.DeviceTransform(_fleet_device_path(name), on_oper, None)

    def device(connected: bool) -> None:
        dev.on_connected((rfs_name=f, device_name=name),
                         y1_oper.stratoweave_rfs__rfs__device__state(connected=connected), None)

    def flotilla(connected: bool) -> None:
        dev.on_flotilla((device_name=f, adapter_type=cfs.FLOTILLA_TYPE),
                        _flotilla_state(connected), None)

    def __startup__():
        # The top is connected to the flotilla before the device first connects.
        flotilla(True)
        device(True)
        platform = y1_oper.stratoweave_rfs__rfs__device__state__platform()
        platform.version = "17.18.2"
        platform.last_boot = u64(1795075960)
        dev.on_platform((rfs_name=f, device_name=name), platform, None)
        flotilla(False)
        flotilla(True)
        device(False)
        # Neither publishes: the device stays device-down.
        flotilla(False)
        flotilla(True)
        device(True)
        dev.shutdown()
        after 0.5: check()



def _connected(status: str, campaign: str, connected: ?bool) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """A device state with status for the intent of campaign with the
    target release 17.18.03a, and whether its flotilla is connected to it."""
    s = _tagged(status, campaign, "17.18.03a")
    s.connected = connected
    return s


def _flotilla_state(connected: bool) -> y1_oper.stratoweave_rfs__device__state__adapter_entry:
    """The top's adapter entry for a flotilla."""
    return y1_oper.stratoweave_rfs__device__state__adapter_entry(cfs.FLOTILLA_TYPE, connected)


def _held_rows(o: y0_oper.software__software__upgrade_campaign_entry, names: list[str]) -> list[str]:
    """Each member in names as "name held held-by", from the device-status
    of o, and then the held counter."""
    rows: list[str] = []
    for name in names:
        r = o.state.device_status.get(name)
        if r is not None:
            rows.append("{name} {r.held} {r.held_by}")
        else:
            rows.append("{name} missing")
    rows.append("held {o.state.held}")
    return rows


# cpe-001 and cpe-007 are on flotilla-8, cpe-002 on flotilla-9.
HELD_MEMBERS = ["cpe-001", "cpe-002", "cpe-007"]


actor _HeldInPlan(t: testing.AsyncT, down: list[str], dead: list[str], unanswered: list[str],
                  group: list[str], want: list[str]):
    """Run the campaign paced in plan over HELD_MEMBERS. The members in
    group are the redundancy group core, in that order. Before the sync,
    as the replay does, each flotilla in dead says that the top is not
    connected to it, and each member reports for the campaign: unknown when
    it is in unanswered, upgrade-needed otherwise, and that its flotilla is
    not connected to it when it is in down. Pass t when the publication
    after the sync has the alarms, then each member as "name held
    held-by", then the held counter, that want gives."""
    var publications = 0

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is None:
            return
        publications += 1
        # The first publication comes from on_conf, before the reports.
        if publications == 2:
            o = oper!
            got = list(o.state.plan.alarm) + _held_rows(o, HELD_MEMBERS)
            if got == want:
                t.success()
            else:
                t.failure(ValueError("after the sync: {got}"))

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def replay() -> None:
        conf = _paced_campaign(HELD_MEMBERS)
        conf.admin_state = "plan"
        linked = _with_nightly(_flat_inventory(HELD_MEMBERS))
        for name in group:
            dev = linked.fleet.device.get(name)
            if dev is not None:
                dev.redundancy_group = ["core"]
        ctl.on_conf(conf, linked.to_gdata())
        for f in dead:
            ctl.on_flotilla((device_name=f, adapter_type=cfs.FLOTILLA_TYPE),
                            _flotilla_state(False), None)
        for name in HELD_MEMBERS:
            status = "unknown" if name in unanswered else "upgrade-needed"
            connected: ?bool = None
            if name in down:
                connected = False
            ctl.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                       _connected(status, "paced", connected), None)
        ctl.on_subscriptions_synced()

    def __startup__():
        replay()



actor _test_campaign_holds_a_member_that_is_down(t: testing.AsyncT):
