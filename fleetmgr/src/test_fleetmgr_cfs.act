def _attempt_state(status: str, campaign: ?str, target: ?str, attempt: u64, stage: ?str,
                   reason: ?str) -> (y1_oper.stratoweave_rfs__rfs__device__state,
                                     y1_oper.stratoweave_rfs__rfs__device__state__attempt_entry):
    """A device state as its flotilla relays it, for campaign and the target
    release target, with one attempt that has status, stage and reason; and
    that attempt."""
    s = y1_oper.stratoweave_rfs__rfs__device__state(upgrade_campaign=campaign,
                                                     target_release=target)
    a = s.attempt.create(attempt, status=status, stage=stage, reason=reason)
    return (s, a)


def _test_device_ssh_propagation():
    """CFS SSH options survive both transforms and the flotilla XML boundary."""
    config = xml.decode("""<config>
      <fleet xmlns="urn:fleetmgr:fleetmgr">
        <device>
          <name>configured</name>
          <type>iosxe</type>
          <credentials><username>admin</username></credentials>
          <ssh>
            <cipher>aes256-ctr</cipher>
            <cipher>aes128-ctr</cipher>
            <mac>hmac-sha2-512</mac>
            <mac>hmac-sha2-256</mac>
            <key-exchange>ecdh-sha2-nistp384</key-exchange>
            <key-exchange>curve25519-sha256</key-exchange>
            <host-key-algorithm>ssh-ed25519</host-key-algorithm>
            <host-key-algorithm>rsa-sha2-512</host-key-algorithm>
            <public-key-algorithm>ssh-ed25519</public-key-algorithm>
            <public-key-algorithm>rsa-sha2-256</public-key-algorithm>
            <compression-algorithm>zlib@openssh.com</compression-algorithm>
            <compression-algorithm>none</compression-algorithm>
            <compression-level>3</compression-level>
            <rekey-after-bytes>1048576</rekey-after-bytes>
            <rekey-after-seconds>3600</rekey-after-seconds>
            <minimum-rsa-bits>3072</minimum-rsa-bits>
          </ssh>
        </device>
        <device>
          <name>defaults</name>
          <type>iosxe</type>
          <credentials><username>admin</username></credentials>
        </device>
      </fleet>
    </config>""")
    inputs = y_0.root.from_gdata(yxml.from_xml(y_0.SRC_DNODE, config))
    di = ttt.DeviceInfo("flotilla-1", {
        "stratoweave-rfs": swadapt.ModCap(
            "stratoweave-rfs",
            "http://stratoweave.org/yang/stratoweave-rfs",
        )
    })
    devices: dict[str, DeviceMetaConfig] = {}
    for i in inputs.fleet.device:
        lower = y_1_config.root.from_gdata(cfs.Device().transform(i).to_gdata())
        entry = lower.rfs.get(cfs.flotilla_of(i.name))!.device.get(i.name)!
        rendered = rfs.Device().transform(entry, di).to_gdata()
        wire = xml.Node("config", children=rendered.to_xml())
        received = flotilla_rfs.root.from_gdata(
            yxml.from_xml(flotilla_rfs.SRC_DNODE, xml.decode(xml.encode(wire)))
        )
        devices[i.name] = DeviceMetaConfig.from_gdata(
            received.device.get(i.name)!.to_gdata()
        )

    configured = swadapt.ssh_transport_config(devices["configured"].ssh)
    testing.assertEqual([str(c) for c in configured.ciphers],
                        ["aes256-ctr", "aes128-ctr"])
    testing.assertEqual([str(m) for m in configured.macs],
                        ["hmac-sha2-512", "hmac-sha2-256"])
    testing.assertEqual([str(k) for k in configured.key_exchanges],
                        ["ecdh-sha2-nistp384", "curve25519-sha256"])
    testing.assertEqual([str(k) for k in configured.host_key_algorithms],
                        ["ssh-ed25519", "rsa-sha2-512"])
    testing.assertEqual([str(k) for k in configured.public_key_algorithms],
                        ["ssh-ed25519", "rsa-sha2-256"])
    testing.assertEqual([str(c) for c in configured.compression_algorithms],
                        ["zlib@openssh.com", "none"])
    testing.assertEqual(configured.compression_level, 3)
    testing.assertEqual(configured.rekey_after_bytes, 1048576)
    testing.assertEqual(configured.rekey_after_seconds, 3600)
    testing.assertEqual(configured.minimum_rsa_bits, 3072)

    defaults = devices["defaults"].ssh
    testing.assertEqual(defaults.cipher, [])
    testing.assertEqual(defaults.mac, [])
    testing.assertEqual(defaults.key_exchange, [])
    testing.assertEqual(defaults.host_key_algorithm, [])
    testing.assertEqual(defaults.public_key_algorithm, [])
    testing.assertEqual(defaults.compression_algorithm, [])
    testing.assertEqual(defaults.compression_level, u64(7))
    testing.assertEqual(defaults.rekey_after_bytes, None)
    testing.assertEqual(defaults.rekey_after_seconds, None)
    testing.assertEqual(defaults.minimum_rsa_bits, u64(1024))


def _test_device_extra_adapter_propagation():
    """A CFS extra adapter, with its own port, credentials and SSH options,
    survives both transforms and the flotilla XML boundary."""
    config = xml.decode("""<config>
      <fleet xmlns="urn:fleetmgr:fleetmgr">
        <device>
          <name>c1111</name>
          <type>iosxe</type>
          <address><name>oob</name><address>192.0.2.17</address><port>830</port></address>
          <credentials><username>admin</username></credentials>
          <extra-adapter>
            <type>iosxe-cli</type>
            <port>22</port>
            <credentials>
              <username>cli</username>
              <key><key>lab</key><private-key>KEY</private-key></key>
            </credentials>
            <ssh>
              <public-key-algorithm>ssh-rsa</public-key-algorithm>
              <key-exchange>diffie-hellman-group14-sha1</key-exchange>
            </ssh>
          </extra-adapter>
          <extra-adapter>
            <type>other</type>
          </extra-adapter>
        </device>
      </fleet>
    </config>""")
    inputs = y_0.root.from_gdata(yxml.from_xml(y_0.SRC_DNODE, config))
    di = ttt.DeviceInfo("flotilla-1", {
        "stratoweave-rfs": swadapt.ModCap(
            "stratoweave-rfs",
            "http://stratoweave.org/yang/stratoweave-rfs",
        )
    })
    i = inputs.fleet.device.get("c1111")!
    lower = y_1_config.root.from_gdata(cfs.Device().transform(i).to_gdata())
    entry = lower.rfs.get(cfs.flotilla_of(i.name))!.device.get(i.name)!
    rendered = rfs.Device().transform(entry, di).to_gdata()
    wire = xml.Node("config", children=rendered.to_xml())
    received = flotilla_rfs.root.from_gdata(
        yxml.from_xml(flotilla_rfs.SRC_DNODE, xml.decode(xml.encode(wire)))
    )
    dmc = DeviceMetaConfig.from_gdata(received.device.get(i.name)!.to_gdata())

    testing.assertEqual([a.type for a in dmc.extra_adapter], ["iosxe-cli", "other"], "in order")
    cli = dmc.extra_adapter.get("iosxe-cli")!
    testing.assertEqual(cli.port, u64(22))
    c = cli.credentials
    testing.assertTrue(c is not None, "the CLI has its own credentials")
    if c is not None:
        testing.assertEqual(c.username, "cli")
        testing.assertEqual([k.private_key for k in c.key], ["KEY"])
    ssh = cli.ssh
    testing.assertTrue(ssh is not None, "the CLI has its own SSH options")
    if ssh is not None:
        testing.assertEqual(ssh.public_key_algorithm, ["ssh-rsa"])
        testing.assertEqual(ssh.key_exchange, ["diffie-hellman-group14-sha1"])
    other = dmc.extra_adapter.get("other")!
    testing.assertEqual((other.port, other.credentials is None, other.ssh is None), (None, True, True))


IMAGE = "c8000v-universalk9.17.18.03a.SPA.bin"
IMAGE_MD5 = "35a91bebe3b1f38606bd0a845426929f"
IMAGE_SIZE = 962330352
URL_BASE = "https://images.example/"
OTHER_IMAGE = "c8000v-universalk9.17.18.04.SPA.bin"

# The image list of _rules_inventory() before an edit: (name, version,
# file, size).
RULES_IMAGES = [(IMAGE, "17.18.03a", "", IMAGE_SIZE), (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]


def _with_images(linked: y_0.root) -> y_0.root:
    """The image list the members name, with url-base."""
    linked.images.url_base = URL_BASE
    image = linked.images.image.create(IMAGE, os="IOS XE", version="17.18.03a")
    image.checksum.create("md5", IMAGE_MD5)
    image.size = u64(IMAGE_SIZE)
    return linked


actor _test_campaign_transform(t: testing.AsyncT):

    def __startup__():
        inventory = _with_images(y_0.root())
        inventory.fleet.device.create(
            "cpe-1",
            type="iosxe",
            credentials=InputCredentials(username="admin"),
        )
        campaign = InputCampaign(
            name="xe-upgrade",
            allow_staging=True,
            admin_state="run",
        )
        campaign.device.create("cpe-1", image=IMAGE)

        # cpe-1 is in flight, so it has no veto, and no allow-staging: the run
        # prepares anyway.
        o: y_1.root = y_1.root.from_gdata(
            cfs.campaign_config(campaign, inventory, {"cpe-1"}, {"cpe-1"}, None, set()).to_gdata()
        )
        dev = o.rfs.get(cfs.flotilla_of("cpe-1"))!.device.get("cpe-1")!

        digest = ""
        checksum = dev.software.image_checksum.get("md5")
        if checksum is not None:
            digest = checksum.digest
        if dev.software.target_release != "17.18.03a" or \
           dev.software.upgrade_campaign != "xe-upgrade" or \
           dev.software.image_url != URL_BASE + IMAGE or \
           digest != IMAGE_MD5 or len(dev.software.image_checksum) != 1 or \
           dev.software.image_size != u64(IMAGE_SIZE):
            t.failure(ValueError("campaign was not routed to the device's flotilla: md5 {digest}, size {dev.software.image_size}"))
        elif dev.software.allow_staging is not None:
            t.failure(ValueError("a member in flight has allow-staging"))
        elif len(dev.software.veto) != 0:
            t.failure(ValueError("a member in flight has a veto"))
        else:
            t.success()


proc def _test_campaign_link_routes_existing_inventory(t: testing.AsyncT):
    """A later campaign resolves and augments an existing inventory device."""
    root = _with_images(y_0.root())
    root.fleet.device.create(
        "cpe-1",
        type="iosxe",
        credentials=InputCredentials(username="admin"),
    )
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    TestCampaignLinkRoutesExistingInventoryActor(t=t, root=root, tr=tr)


actor TestCampaignLinkRoutesExistingInventoryActor(t: testing.AsyncT, root, tr):
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_campaign(result) -> None:
        # The campaign's transform function writes the intent in the
        # campaign's edit, so it is there when the edit is done.
        if isinstance(result, Exception):
            fail("campaign edit failed: {result}")
            return
        if done:
            return
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        found = "no entry"
        flotilla = lower.rfs.get(cfs.flotilla_of("cpe-1"))
        if flotilla is not None:
            out = flotilla.device.get("cpe-1")
            if out is not None:
                held = out.software.veto.get(cfs.veto_holder("xe-upgrade")) is not None
                found = "{out.software.upgrade_campaign} {out.software.target_release} {held}"
        if found == "xe-upgrade 17.18.03a True":
            done = True
            t.success()
        else:
            fail("linked campaign did not augment the existing inventory device: {found}")

    def on_inventory(result) -> None:
        if isinstance(result, Exception):
            fail("inventory edit failed: {result}")
            return
        # In plan, so the actor does not release the device.
        campaign = root.software.upgrade_campaign.create(
            "xe-upgrade",
            admin_state="plan",
        )
        campaign.device.create("cpe-1", image=IMAGE)
        tr.edit_config(root.to_gdata(), on_campaign)

    def __startup__():
        tr.edit_config(root.to_gdata(), on_inventory)
        after 8.0: fail("timed out waiting for linked campaign")



def _vetoed(out: gdata.Node, campaign: str) -> (list[str], list[str], list[str], list[str]):
    """Return the devices in out, the output of a campaign, that have the
    campaign's veto, the devices that do not, the devices with a target
    release, and the devices that do not have the campaign's name. Each
    list is sorted."""
    holder = cfs.veto_holder(campaign)
    vetoed: list[str] = []
    free: list[str] = []
    targeted: list[str] = []
    unnamed: list[str] = []
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            if dev.software.veto.get(holder) is not None:
                vetoed.append(dev.name)
            else:
                free.append(dev.name)
            if dev.software.target_release is not None:
                targeted.append(dev.name)
            if dev.software.upgrade_campaign != campaign:
                unnamed.append(dev.name)
    return (sorted(vetoed), sorted(free), sorted(targeted), sorted(unnamed))


def _staged(out: gdata.Node) -> list[str]:
    """Return the devices in out, the output of a campaign, that have
    allow-staging, sorted. A device with allow-staging false shows as
    "name false"."""
    staged: list[str] = []
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            a = dev.software.allow_staging
            if a is not None:
                staged.append(dev.name if a else dev.name + " false")
    return sorted(staged)


def _test_campaign_function_renders_the_claim():
    """The campaign's transform function gives every member the campaign's
    name, target and veto. In run, the members that the output written last
    has in flight, without the veto, keep no veto. A prev of another
    campaign gives none in flight. In run with allow-staging, the members
    that prev lets prepare stay let. A member that prev marks image-locked
    at the target that the memory has for it stays marked. prev is written
    as the actor writes it: the member in flight or let prepare is marked.
    A member in flight that prev does not mark gets the veto again."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    inventory = _with_nightly(_flat_inventory(names))
    linked = inventory.to_gdata()
    run = _paced_campaign(names)
    # The memory of the edit before: each member as it is now.
    memory = cfs.campaign_memory(None, cfs.chosen_members(run, inventory), set(), {}, 0)
    prev = cfs.campaign_config(run, inventory, {"cpe-2"}, set(), None, set(), {"cpe-2"}).to_gdata()
    unmarked = cfs.campaign_config(run, inventory, {"cpe-2"}, set(), None, set()).to_gdata()
    other = InputCampaign(name="other", admin_state="run")
    for name in names:
        other.device.create(name, image=IMAGE)
    prev_other = cfs.campaign_config(other, inventory, {"cpe-2"}, set(), None,
                                     set(), {"cpe-2"}).to_gdata()
    staging = _paced_campaign(names)
    staging.allow_staging = True
    prev_staged = cfs.campaign_config(staging, inventory, set(), {"cpe-2"}, None,
                                      set(), {"cpe-2"}).to_gdata()
    testing.assertEqual(_staged(prev_staged), ["cpe-2"], "prev lets cpe-2 prepare")
    # (case, prev, the campaign, the members in flight and let prepare)
    written: list[(str, gdata.Node, InputCampaign, set[str], set[str])] = [
        ("prev has cpe-2 in flight", prev, run, {"cpe-2"}, set()),
        ("prev has cpe-2 in flight without the mark", unmarked, run, set(), set()),
        ("the prev of another campaign has none of this one", prev_other, run, set(), set()),
        ("prev lets cpe-2 prepare", prev_staged, staging, set(), {"cpe-2"}),
        ("without allow-staging no member is let prepare", prev_staged, run, set(), set()),
    ]
    for case in written:
        marks = cfs.written_marks(case.1, case.2.name)
        w = cfs.written_in(case.2, marks, cfs.locked_members(memory, marks))
        testing.assertEqual(w.0, case.3, case.0)
        testing.assertEqual(w.1, case.4, case.0)
    # (case, admin-state, prev, the vetoed members, the marks)
    cases: list[(str, str, ?gdata.Node, list[str], list[str])] = [
        ("plan, no prev", "plan", None, names, []),
        ("plan, cpe-2 in flight in prev", "plan", prev, names, ["cpe-2 locked"]),
        ("run, no prev", "run", None, names, []),
        ("run, cpe-2 in flight in prev", "run", prev, ["cpe-1", "cpe-3"], ["cpe-2 locked"]),
        ("run, prev of another campaign", "run", prev_other, names, []),
    ]
    for case in cases:
        campaign = _paced_campaign(names)
        campaign.admin_state = case.1
        out = cfs.UpgradeCampaign().transform(campaign, linked, memory, None, case.2).0.to_gdata()
        vetoed, free, targeted, unnamed = _vetoed(out, "paced")
        testing.assertEqual(vetoed, case.3, case.0)
        testing.assertEqual(sorted(vetoed + free), names, case.0)
        testing.assertEqual(targeted, names, case.0)
        testing.assertEqual(unnamed, [], case.0)
        testing.assertEqual(_staged(out), [], case.0)
        testing.assertEqual(_mark_rows(out), case.4, case.0)

    # prev is in run with allow-staging, and lets cpe-2 prepare. (case,
    # admin-state, allow-staging, and the members with allow-staging)
    staged_cases: list[(str, str, bool, list[str])] = [
        ("run, on", "run", True, ["cpe-2"]),
        ("run, off", "run", False, []),
        ("plan, on", "plan", True, []),
    ]
    for case in staged_cases:
        campaign = _paced_campaign(names)
        campaign.admin_state = case.1
        campaign.allow_staging = case.2
        out = cfs.UpgradeCampaign().transform(campaign, linked, memory, None,
                                              prev_staged).0.to_gdata()
        vetoed, free, targeted, unnamed = _vetoed(out, "paced")
        testing.assertEqual(vetoed, names, case.0)
        testing.assertEqual(_staged(out), case.3, case.0)
        testing.assertEqual(_mark_rows(out), ["cpe-2 locked"], case.0)

    # With nothing changed the wrapper returns the last output itself, so
    # TTT skips the members.
    # (case, the campaign, prev)
    unchanged: list[(str, InputCampaign, gdata.Node)] = [
        ("cpe-2 in flight", run, prev),
        ("cpe-2 let prepare", staging, prev_staged),
    ]
    for case in unchanged:
        wrapped = cfs.UpgradeCampaign().transform_wrapper(case.1.to_gdata(), linked,
                                                          memory?.to_gdata(), None, case.2)
        testing.assertEqual(wrapped.0, case.2, "the function gives what the actor wrote: " + case.0)
        testing.assertTrue(ttt.same_node(wrapped.0, case.2),
                           "the wrapper returns prev itself: " + case.0)


def _rules_inventory(images: list[(str, str, str, int)]) -> y_0.root:
    """The fleet cpe-1 to cpe-3, and the image list images, each as (name,
    version, file, size). "" leaves the version or the file out."""
    root = y_0.root()
    root.images.url_base = URL_BASE
    for im in images:
        image = root.images.image.create(im.0, os="IOS XE")
        if im.1 != "":
            image.version = im.1
        if im.2 != "":
            image.file = im.2
        image.size = u64(im.3)
    for name in ["cpe-1", "cpe-2", "cpe-3"]:
        root.fleet.device.create(name, type="iosxe",
                                 credentials=InputCredentials(username="admin"))
    return root


def _committed(members: list[(str, str, str, int, bool)]) -> ?gdata.Node:
    """The memory of campaign A with each member in members as (device,
    image, target release, attempt, image-locked), or None for none."""
    if len(members) == 0:
        return None
    memory = InputMemory()
    for m in members:
        e = memory.member.create(m.0, image=m.1, target_release=m.2, attempt=u64(m.3))
        if m.4:
            e.image_locked = True
    return memory.to_gdata()


def _written(entries: list[(str, str, int, bool)], failed: list[str]=[]) -> ?gdata.Node:
    """The output of campaign A as its actor wrote it, with each device in
    entries as (name, target release, attempt, image-locked), and
    attempt-failed for the devices in failed, or None for none."""
    if len(entries) == 0:
        return None
    o = y_1.root()
    for e in entries:
        sw = o.rfs.create(cfs.flotilla_of(e.0)).device.create(e.0).software
        sw.upgrade_campaign = "A"
        sw.target_release = e.1
        sw.attempt = u64(e.2)
        if e.3:
            sw.image_locked = True
        if e.0 in failed:
            sw.attempt_failed = True
    return o.to_gdata()


def _kept_image(names: str) -> str:
    """The error of an edit that gives the members names of campaign A
    another image or another version."""
    return "upgrade-campaign A keeps the image and the release of {names}: it has let each " \
           + "prepare or released it"


def _test_campaign_edit_rules():
    """An edit of campaign A, or of its image list, fails with an error
    that names the campaign and the members, and the memory stays, when it
    gives a member whose image the campaign keeps another image or another
    version of its image. The campaign keeps the image of a member that the
    memory, the members as the last edit took them, locks, and of a member
    that the output written last marks image-locked with the target release
    that the memory has for it. A mark with another target is stale: an
    edit overtook the write that set it. Moving the image's file, or a new
    size, keeps its version. A member removed loses its lock, and a member
    that the memory does not have is new. The error names five members at
    most. Otherwise the memory keeps each member as the edit takes it,
    and whether the campaign keeps its image."""
    moved = [(IMAGE, "17.18.03a", "iosxe/17.18/" + IMAGE, IMAGE_SIZE),
             (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    resized = [(IMAGE, "17.18.03a", "", 1), (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    newer = [(IMAGE, "17.18.04", "", IMAGE_SIZE), (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    removed = [(OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    renamed = [("renamed.bin", "17.18.03a", "", IMAGE_SIZE),
               (OTHER_IMAGE, "17.18.04", "", IMAGE_SIZE)]
    other_newer = [(IMAGE, "17.18.03a", "", IMAGE_SIZE), (OTHER_IMAGE, "17.18.05", "", IMAGE_SIZE)]
    seven = ["d1", "d2", "d3", "d4", "d5", "d6", "d7"]
    # (case, the memory as (device, image, target, attempt, image-locked),
    # the output written last as (device, target, attempt, image-locked),
    # the members after the edit as (device, image, attempt), the image
    # list after the edit, the error, or "", and the members that the
    # memory locks after the edit)
    cases: list[(str, list[(str, str, str, int, bool)], list[(str, str, int, bool)],
                 list[(str, str, int)], list[(str, str, str, int)], str, list[str])] = [
        ("untouched, another image", [("cpe-1", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, False)], [("cpe-1", OTHER_IMAGE, 0)], RULES_IMAGES, "", []),
        ("untouched, a new version", [("cpe-1", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, False)], [("cpe-1", IMAGE, 0)], newer, "", []),
        ("locked, another image", [("cpe-1", IMAGE, "17.18.03a", 0, True)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", OTHER_IMAGE, 0)], RULES_IMAGES,
         _kept_image("cpe-1"), []),
        ("locked, a new version", [("cpe-1", IMAGE, "17.18.03a", 0, True)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", IMAGE, 0)], newer,
         _kept_image("cpe-1"), []),
        ("locked, the image removed", [("cpe-1", IMAGE, "17.18.03a", 0, True)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", IMAGE, 0)], removed,
         _kept_image("cpe-1"), []),
        ("locked, the image renamed", [("cpe-1", IMAGE, "17.18.03a", 0, True)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", "renamed.bin", 0)], renamed,
         _kept_image("cpe-1"), []),
        ("locked, the image's file moved", [("cpe-1", IMAGE, "17.18.03a", 0, True)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", IMAGE, 0)], moved, "", ["cpe-1"]),
        ("locked, a new size", [("cpe-1", IMAGE, "17.18.03a", 0, True)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", IMAGE, 0)], resized, "", ["cpe-1"]),
        ("marked, another image", [("cpe-1", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", OTHER_IMAGE, 0)], RULES_IMAGES,
         _kept_image("cpe-1"), []),
        ("marked, the same image", [("cpe-1", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", IMAGE, 0)], RULES_IMAGES, "", ["cpe-1"]),
        ("stale mark", [("cpe-1", OTHER_IMAGE, "17.18.04", 0, False)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", OTHER_IMAGE, 0)], RULES_IMAGES, "", []),
        ("stale mark, a new version", [("cpe-1", OTHER_IMAGE, "17.18.04", 0, False)],
         [("cpe-1", "17.18.03a", 0, True)], [("cpe-1", OTHER_IMAGE, 0)], other_newer, "", []),
        ("marked, not in the memory", [], [("cpe-1", "17.18.03a", 0, True)],
         [("cpe-1", IMAGE, 0)], newer, "", []),
        ("locked, removed", [("cpe-1", IMAGE, "17.18.03a", 0, True),
                             ("cpe-2", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, True), ("cpe-2", "17.18.03a", 0, False)],
         [("cpe-2", IMAGE, 0)], RULES_IMAGES, "", []),
        ("locked, not in the fleet, another image", [("cpe-9", IMAGE, "17.18.03a", 0, True)],
         [], [("cpe-9", OTHER_IMAGE, 0)], RULES_IMAGES, _kept_image("cpe-9"), []),
        ("only the untouched member changes", [("cpe-1", IMAGE, "17.18.03a", 0, True),
                                               ("cpe-2", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, True), ("cpe-2", "17.18.03a", 0, False)],
         [("cpe-1", IMAGE, 0), ("cpe-2", OTHER_IMAGE, 0)], RULES_IMAGES, "", ["cpe-1"]),
        ("a new version names only the locked member", [("cpe-1", IMAGE, "17.18.03a", 0, True),
                                                        ("cpe-2", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, True), ("cpe-2", "17.18.03a", 0, False)],
         [("cpe-1", IMAGE, 0), ("cpe-2", IMAGE, 0)], newer, _kept_image("cpe-1"), []),
        ("seven locked members", [(d, IMAGE, "17.18.03a", 0, True) for d in seven], [],
         [(d, OTHER_IMAGE, 0) for d in seven], RULES_IMAGES,
         _kept_image("d1, d2, d3, d4, d5 and 2 more"), []),
        ("the first edit", [], [], [("cpe-1", IMAGE, 0)], RULES_IMAGES, "", []),
    ]
    for case in cases:
        campaign = InputCampaign(name="A", admin_state="run")
        for m in case.3:
            campaign.device.create(m.0, image=m.1, attempt=u64(m.2))
        inventory = _rules_inventory(case.4)
        got = ""
        locked: list[str] = []
        try:
            out = cfs.UpgradeCampaign().transform_wrapper(campaign.to_gdata(),
                                                          inventory.to_gdata(),
                                                          _committed(case.1), None,
                                                          _written(case.2))
            m = out.1
            if m is not None:
                memory = InputMemory.from_gdata(m)
                locked = sorted([e.device for e in memory.member if e.image_locked])
                kept = {e.device: (e.image, e.target_release, e.attempt) for e in memory.member}
                chosen = {n: (c.image, c.target, c.attempt)
                          for n, c in cfs.chosen_members(campaign, inventory).items()}
                testing.assertEqual(kept, chosen, "{case.0}: the memory keeps each member")
        except ValueError as e:
            got = e.error_message
        testing.assertEqual(got, case.5, case.0)
        testing.assertEqual(locked, case.6, case.0)


def _no_attempt(names: str) -> str:
    """The error of an edit that gives the members names of campaign A a new
    attempt that they may not have."""
    return "upgrade-campaign A gives no new attempt to {names}: the attempt of each has not " \
           + "failed"


def _test_campaign_attempt_rules():
    """An edit of campaign A that gives a member a new attempt fails with an
    error that names the campaign and the members, unless the output
    written last marks the member attempt-failed with the attempt that the
    memory has for it. A new member, which the memory does not have, may
    have any attempt. A failed member with a new attempt keeps its
    image. The output marks attempt-failed the members
    whose mark the edit keeps: not one with a new attempt."""
    locked = [("cpe-1", IMAGE, "17.18.03a", 0, True)]
    marked = [("cpe-1", "17.18.03a", 0, True)]
    # (case, the memory as (device, image, target, attempt, image-locked),
    # the output written last as (device, target, attempt, image-locked),
    # the devices it marks attempt-failed, the members after the edit as
    # (device, image, attempt), the error, or "", and the members that the
    # output marks attempt-failed)
    cases: list[(str, list[(str, str, str, int, bool)], list[(str, str, int, bool)], list[str],
                 list[(str, str, int)], str, list[str])] = [
        ("failed, a new attempt", locked, marked, ["cpe-1"], [("cpe-1", IMAGE, 1)], "", []),
        ("failed, the same attempt", locked, marked, ["cpe-1"], [("cpe-1", IMAGE, 0)], "",
         ["cpe-1"]),
        ("succeeded, a new attempt", locked, marked, [], [("cpe-1", IMAGE, 1)],
         _no_attempt("cpe-1"), []),
        ("waiting, a new attempt", [("cpe-1", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, False)], [], [("cpe-1", IMAGE, 1)], _no_attempt("cpe-1"),
         []),
        ("failed in an earlier attempt", [("cpe-1", IMAGE, "17.18.03a", 1, True)], marked,
         ["cpe-1"], [("cpe-1", IMAGE, 2)], _no_attempt("cpe-1"), []),
        ("a new member", [], [], [], [("cpe-1", IMAGE, 3)], "", []),
        ("failed, a new attempt and another image", locked, marked, ["cpe-1"],
         [("cpe-1", OTHER_IMAGE, 1)], _kept_image("cpe-1"), []),
        ("both rules", [("cpe-1", IMAGE, "17.18.03a", 0, True),
                        ("cpe-2", IMAGE, "17.18.03a", 0, False)],
         [("cpe-1", "17.18.03a", 0, True), ("cpe-2", "17.18.03a", 0, False)], [],
         [("cpe-1", OTHER_IMAGE, 0), ("cpe-2", IMAGE, 1)],
         _kept_image("cpe-1") + "; " + _no_attempt("cpe-2"), []),
    ]
    for case in cases:
        campaign = InputCampaign(name="A", admin_state="run")
        for m in case.4:
            campaign.device.create(m.0, image=m.1, attempt=u64(m.2))
        got = ""
        failed: list[str] = []
        try:
            out = cfs.UpgradeCampaign().transform_wrapper(campaign.to_gdata(),
                                                          _rules_inventory(RULES_IMAGES).to_gdata(),
                                                          _committed(case.1), None,
                                                          _written(case.2, case.3))
            failed = [r.split(" ")[0] for r in _mark_rows(out.0) if r.endswith(" failed")]
        except ValueError as e:
            got = e.error_message
        testing.assertEqual(got, case.5, case.0)
        testing.assertEqual(failed, case.6, case.0)
    # A new prepare attempt is no new attempt.
    campaign = InputCampaign(name="A", admin_state="run")
    campaign.device.create("cpe-1", image=IMAGE, prepare_attempt=u64(1))
    out = cfs.UpgradeCampaign().transform_wrapper(campaign.to_gdata(),
                                                  _rules_inventory(RULES_IMAGES).to_gdata(),
                                                  _committed(locked), None, _written(marked))
    testing.assertEqual(_mark_rows(out.0), ["cpe-1 locked"], "a new prepare attempt")


proc def _test_campaign_edit_keeps_its_output(t: testing.AsyncT):
    """An edit of a running campaign keeps the intent that the campaign
    wrote for its member. The edit runs the campaign's transform function,
    and its output replaces what the actor wrote. The flotillas of the test
    system are mocks that report no device state, so cpe-1 never answers
    the campaign's target, and the campaign holds it under its veto, also
    after the edit. _test_campaign_function_renders_the_claim covers a
    member in flight."""
    root = _with_images(y_0.root())
    root.fleet.device.create(
        "cpe-1",
        type="iosxe",
        credentials=InputCredentials(username="admin"),
    )
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    TestCampaignEditKeepsItsOutputActor(t=t, root=root, tr=tr)


actor TestCampaignEditKeepsItsOutputActor(t: testing.AsyncT, root, tr):
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def intent() -> str:
        """cpe-1's target release in the layer below the campaigns, and
        whether it has the campaign's veto."""
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        flotilla = lower.rfs.get(cfs.flotilla_of("cpe-1"))
        if flotilla is not None:
            out = flotilla.device.get("cpe-1")
            if out is not None:
                held = out.software.veto.get(cfs.veto_holder("xe-upgrade")) is not None
                return "{out.software.target_release} held {held}"
        return "no entry"

    def on_edit(result) -> None:
        if isinstance(result, Exception):
            fail("campaign edit failed: {result}")
            return
        found = intent()
        if found == "17.18.03a held True":
            if not done:
                done = True
                t.success()
        else:
            fail("the edit did not keep cpe-1's intent: {found}")

    def still_held() -> None:
        if done:
            return
        # The campaign has decided by now. cpe-1 has not answered, so the
        # campaign has not released it.
        found = intent()
        if found == "17.18.03a held True":
            campaign = root.software.upgrade_campaign.get("xe-upgrade")
            if campaign is not None:
                campaign.target_concurrency = u64(2)
            tr.edit_config(root.to_gdata(), on_edit)
        else:
            fail("cpe-1 is not held for its answer: {found}")

    def on_campaign(result) -> None:
        if isinstance(result, Exception):
            fail("campaign create failed: {result}")
            return
        after float(cfs.campaign_debounce_s(1)) + 0.5: still_held()

    def on_inventory(result) -> None:
        if isinstance(result, Exception):
            fail("inventory edit failed: {result}")
            return
        campaign = root.software.upgrade_campaign.create(
            "xe-upgrade",
            admin_state="run",
        )
        campaign.device.create("cpe-1", image=IMAGE)
        tr.edit_config(root.to_gdata(), on_campaign)

    def __startup__():
        tr.edit_config(root.to_gdata(), on_inventory)
        after 8.0: fail("timed out waiting for the campaign edit")



mut def _lab_device() -> InputDevice:
    """Return a device with every option set."""
    credentials: InputCredentials = InputCredentials(
        username="netops",
        password="netops-password",
    )
    credentials.key.create("ssh-ed25519 public", private_key="private")

    i: InputDevice = InputDevice(
        name="cpe-1",
        type="iosxe",
        description="Lab CPE",
        credentials=credentials,
        approval_required=True,
        sync_check=False,
    )
    address: InputAddress = i.address.create(
        "oob",
        address="192.0.2.1",
        port=u64(830),
    )
    address.initial_credentials.create((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    i.initial_credentials.create((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    i.mock.enabled = True
    i.mock.software.upgrade_duration = u64(60)
    i.mock.software.upgrade_duration_variance = u64(35)
    i.mock.software.failure = "commit-failed"
    i.mock.platform.version = "17.18.03a"
    i.mock.platform.model = "C8300-1N1S-4T2X"
    i.mock.platform.serial_number = "FGL2231L0AB"
    module: InputMockModule = i.mock.module.create(
        "ietf-system",
        namespace="urn:ietf:params:xml:ns:yang:ietf-system",
        revision="2014-08-06",
    )
    module.feature = ["authentication", "local-users"]
    i.ssh.cipher = ["aes256-ctr", "aes128-ctr"]
    i.ssh.compression_level = u64(3)
    i.ssh.rekey_after_seconds = u64(3600)
    i.debug.connection = True
    i.feature_flags.runtime_schema_fetch = True
    i.upgrade_checks.enabled = False
    i.upgrade_checks.precheck_wait = u64(30)
    i.upgrade_checks.postcheck_wait = u64(120)
    return i


actor _test_device_transform(t: testing.AsyncT):

    def __startup__():
        transform: cfs.Device = cfs.Device()
        o: y_1.root = y_1.root.from_gdata(transform.transform(_lab_device()).to_gdata())
        flotilla = o.rfs.get(cfs.flotilla_of("cpe-1"))!
        dev: OutputDevice = flotilla.device.get("cpe-1")!
        out_address: OutputAddress = dev.address.get("oob")!
        address_credentials: ?AddressCredentials = out_address.initial_credentials.get((
            username="address-bootstrap",
            password="address-password",
            key="address-key",
        ))
        device_credentials: ?DeviceCredentials = dev.initial_credentials.get((
            username="device-bootstrap",
            password="device-password",
            key="device-key",
        ))
        out_key: OutputKey = dev.credentials.key.get("ssh-ed25519 public")!
        out_module: OutputMockModule = dev.mock.module.get("ietf-system")!

        if dev.type != "iosxe" or dev.description != "Lab CPE":
            t.failure(ValueError("device identity was not preserved"))
        elif out_address.address != "192.0.2.1" or out_address.port != u64(830):
            t.failure(ValueError("device address fields were not preserved"))
        elif address_credentials is None or device_credentials is None:
            t.failure(ValueError("initial credentials were not preserved"))
        elif dev.credentials.username != "netops" or dev.credentials.password != "netops-password":
            t.failure(ValueError("active credentials were not preserved"))
        elif out_key.private_key != "private":
            t.failure(ValueError("credential keys were not preserved"))
        elif not dev.approval_required! or dev.sync_check != False or not dev.mock.enabled!:
            t.failure(ValueError("device policy fields were not preserved"))
        elif out_module.namespace != "urn:ietf:params:xml:ns:yang:ietf-system" or \
             out_module.revision != "2014-08-06" or \
             out_module.feature != ["authentication", "local-users"]:
            t.failure(ValueError("mock module fields were not preserved"))
        elif dev.mock.software.upgrade_duration != u64(60) or \
             dev.mock.software.upgrade_duration_variance != u64(35) or \
             dev.mock.software.failure != "commit-failed" or \
             dev.mock.platform.version != "17.18.03a" or \
             dev.mock.platform.model != "C8300-1N1S-4T2X" or \
             dev.mock.platform.serial_number != "FGL2231L0AB":
            t.failure(ValueError("mock upgrade duration, variance, failure or platform was not preserved"))
        elif not dev.debug.connection! or not dev.feature_flags.runtime_schema_fetch!:
            t.failure(ValueError("debug or feature flags were not preserved"))
        elif dev.upgrade_checks.enabled != False or dev.upgrade_checks.precheck_wait != u64(30) \
             or dev.upgrade_checks.postcheck_wait != u64(120):
            t.failure(ValueError("upgrade checks were not preserved"))
        else:
            t.success()


def _test_device_writes_its_flotilla():
    """A device's transform also writes the top's entry for its flotilla, with
    the flotilla's local NETCONF port and the flotillas' default login."""
    o: y_1.root = y_1.root.from_gdata(cfs.Device().transform(_lab_device()).to_gdata())
    name = cfs.flotilla_of("cpe-1")
    testing.assertEqual([d.name for d in o.device], [name])
    dev: OutputNode = o.device.get(name)!
    testing.assertEqual(dev.type, "flotilla")
    testing.assertEqual(dev.sync_check, False)
    address = dev.address.get("primary")!
    testing.assertEqual(address.address, "127.0.0.1")
    testing.assertEqual(address.port, u64(12901 + cfs.flotilla_index("cpe-1")))
    testing.assertEqual(dev.credentials.username, "admin")
    testing.assertEqual(dev.credentials.password, "admin")


def _test_flotilla_placement():
    """A device's name picks its flotilla, the same on every run, and a fleet
    spreads over all ten. A change in Acton's hash would move devices to
    other flotillas; the pinned names catch that."""
    testing.assertEqual(cfs.flotilla_of("cpe-001"), "flotilla-8")
    testing.assertEqual(cfs.flotilla_of("cpe-002"), "flotilla-9")
    testing.assertEqual(cfs.flotilla_of("cpe-007"), "flotilla-8")
    seen: set[str] = set()
    for i in range(1, 101):
        seen.add(cfs.flotilla_of("cpe-{i:03d}"))
    testing.assertEqual(sorted(list(seen)), sorted(["flotilla-{n}" for n in range(1, 11)]))


def _paced_campaign(names: list[str]) -> InputCampaign:
    campaign = InputCampaign(
        name="paced",
        admin_state="run",
        default_schedule="nightly",
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    return campaign


def _with_nightly(linked: y_0.root) -> y_0.root:
    """A ten minute nightly window at launch, the schedule the paced
    campaign defaults to."""
    linked.schedules.schedule.create("nightly").window.create(u64(1), at=u64(0), duration=u64(600))
    return linked


def _plan(campaign: InputCampaign, linked: y_0.root,
          now: int) -> (list[(str, int, int, list[(str, int, int)])], list[str], int):
    """The campaign's plan at time now, before a run, with every member
    answered that it needs the upgrade: the layout, the alarms and the
    concurrency."""
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, now)
    sim.answer_all(ctl, now)
    p = ctl.plan(now)
    return (ctl.layout(p), p.alarms, p.c)


def _replanned(campaign: InputCampaign, linked: y_0.root, now: int) -> fctl.Controller:
    """A run of the campaign in which cpe-1 was released at 10 in last
    night's window and reported done at 14, planned again at time now.
    Every member answered at 0 that it needs the upgrade."""
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    ctl.resume("cpe-1", 10, ("nightly", 0, 600))
    ctl.report("cpe-1", "succeeded", 14)
    cfs.configure_campaign(ctl, campaign, linked, now)
    return ctl


def _flat_inventory(names: list[str], upgrade_duration: ?int = None) -> y_0.root:
    linked = _with_images(y_0.root())
    for name in names:
        dev = linked.fleet.device.create(
            name,
            type="iosxe",
            credentials=InputCredentials(username="admin"),
        )
        dev.mock.enabled = True
        if upgrade_duration is not None:
            dev.mock.software.upgrade_duration = u64(upgrade_duration)
    return linked


def _window_names(layout: list[(str, int, int, list[(str, int, int)])], window: str) -> list[str]:
    names = []
    for win in layout:
        if win.0 == window:
            for entry in win.3:
                names.append(entry.0)
    return sorted(names)


actor _test_campaign_without_windows_gets_default_window(t: testing.AsyncT):
    """No windows defined: one synthetic open window takes everyone, and
    the campaign's veto holds the device until the controller releases
    it."""

    def __startup__():
        linked = _flat_inventory(["cpe-1"])
        campaign = InputCampaign(
            name="now",
            admin_state="run",
        )
        campaign.device.create("cpe-1", image=IMAGE)
        layout, alarms, conc = _plan(campaign, linked, 0)
        testing.assertEqual(_window_names(layout, "default"), ["cpe-1"], None)
        vetoed, free, targeted, unnamed = _vetoed(
            cfs.campaign_config(campaign, linked, set(), set(), None, set()).to_gdata(), "now")
        testing.assertEqual((vetoed, free), (["cpe-1"], []), "an unreleased device is held")
        vetoed, free, targeted, unnamed = _vetoed(
            cfs.campaign_config(campaign, linked, {"cpe-1"}, set(), None, set()).to_gdata(), "now")
        testing.assertEqual((vetoed, free), ([], ["cpe-1"]), "a released device is not held")
        t.success()


def _routed(campaign: InputCampaign, inventory: y_0.root) -> list[str]:
    """The members campaign gives a target release, with no member in
    flight."""
    o = cfs.campaign_config(campaign, inventory, set(), set(), None, set()).to_gdata()
    vetoed, free, targeted, unnamed = _vetoed(o, campaign.name)
    return targeted


def _test_campaign_member_images():
    """A member whose image is not in the image list, or has no version,
    gets no target release, and the campaign says why. It still gets the
    campaign's name and veto, so no other campaign can take it. A member
    that the campaign has freed counts in no alarm."""
    inventory = _flat_inventory(["cpe-1", "cpe-2", "cpe-3"])
    inventory.images.image.create("no-version.bin", os="IOS XE")
    campaign = InputCampaign(name="images", admin_state="run")
    campaign.device.create("cpe-1", image=IMAGE)
    campaign.device.create("cpe-2", image="gone.bin")
    campaign.device.create("cpe-3", image="no-version.bin")
    testing.assertEqual(_routed(campaign, inventory), ["cpe-1"])
    o = cfs.campaign_config(campaign, inventory, set(), set(), None, set()).to_gdata()
    vetoed, free, targeted, unnamed = _vetoed(o, "images")
    testing.assertEqual(vetoed, ["cpe-1", "cpe-2", "cpe-3"], "every member is held")
    testing.assertEqual(unnamed, [], "every member has the campaign's name")
    out = y_1.root.from_gdata(o)
    for name in ["cpe-2", "cpe-3"]:
        dev = out.rfs.get(cfs.flotilla_of(name))!.device.get(name)!
        testing.assertEqual(dev.software.image_url, None, name)
    testing.assertEqual(cfs.member_targets(campaign, inventory), {"cpe-1": "17.18.03a"})
    testing.assertEqual(cfs.image_alarms(campaign, inventory, set()), [
        "image gone.bin is not in the image list (1 device)",
        "image no-version.bin has no version (1 device)",
    ])
    testing.assertEqual(cfs.image_alarms(campaign, inventory, {"cpe-2"}),
                        ["image no-version.bin has no version (1 device)"], "cpe-2 freed")


def _test_campaign_image_file():
    """A member's URL is url-base followed by its image's file, a path in
    the image folder, and without a file by the image's name."""
    inventory = _flat_inventory(["cpe-1"])
    campaign = InputCampaign(name="files", admin_state="run")
    campaign.device.create("cpe-1", image=IMAGE)

    def url() -> ?str:
        o: y_1.root = y_1.root.from_gdata(cfs.campaign_config(campaign, inventory, {"cpe-1"}, set(), None, set()).to_gdata())
        return o.rfs.get(cfs.flotilla_of("cpe-1"))!.device.get("cpe-1")!.software.image_url

    testing.assertEqual(url(), URL_BASE + IMAGE)
    moved = "iosxe/17.18/" + IMAGE
    _with_file(inventory, moved)
    testing.assertEqual(url(), URL_BASE + moved)
    testing.assertEqual(cfs.member_targets(campaign, inventory), {"cpe-1": "17.18.03a"})


def _test_campaign_without_url_base():
    """Without url-base the release is still set but there is no URL, and
    the campaign says devices cannot fetch images."""
    inventory = _flat_inventory(["cpe-1"])
    inventory.images.url_base = None
    campaign = InputCampaign(name="no-url", admin_state="run")
    campaign.device.create("cpe-1", image=IMAGE)
    o: y_1.root = y_1.root.from_gdata(cfs.campaign_config(campaign, inventory, {"cpe-1"}, set(), None, set()).to_gdata())
    dev = o.rfs.get(cfs.flotilla_of("cpe-1"))!.device.get("cpe-1")!
    testing.assertEqual(dev.software.target_release, "17.18.03a")
    testing.assertEqual(dev.software.image_url, None)
    testing.assertEqual(cfs.image_alarms(campaign, inventory, set()),
                        ["no url-base in the image list: devices cannot fetch images"])


actor _test_campaign_deadline_without_windows_plans(t: testing.AsyncT):
    """A deadline alone closes the synthetic window; devices still plan."""

    def __startup__():
        campaign = InputCampaign(
            name="dl",
            admin_state="plan",
            deadline=u64(3600),
        )
        for name in ["d1", "d2"]:
            campaign.device.create(name, image=IMAGE)
        layout, alarms, conc = _plan(campaign, _flat_inventory(["d1", "d2"]), 0)
        testing.assertEqual(_window_names(layout, "default"), ["d1", "d2"], None)
        testing.assertEqual(len(alarms), 0, "a meetable deadline must not alarm")
        for win in layout:
            testing.assertEqual(win.2 <= 3600, True, "the deadline closes the window")
        t.success()


actor _test_campaign_plan_state_holds_every_member(t: testing.AsyncT):
    """In plan admin-state the layout exists, and every member gets the
    campaign's name and target, held by the campaign's veto."""

    def __startup__():
        campaign = _paced_campaign(["cpe-1", "cpe-2"])
        campaign.admin_state = "plan"
        layout, alarms, conc = _plan(campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2"])), 0)
        testing.assertEqual(_window_names(layout, "nightly"), ["cpe-1", "cpe-2"], None)
        # In plan a member in flight is held too.
        out = cfs.campaign_config(campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2"])),
                                  {"cpe-2"}, set(), None, set())
        testing.assertEqual(_vetoed(out.to_gdata(), "paced"),
                            (["cpe-1", "cpe-2"], [], ["cpe-1", "cpe-2"], []))
        t.success()


actor _test_campaign_lifts_the_veto_only_in_flight(t: testing.AsyncT):
    """Every member gets the campaign's intent, and only the members in
    flight have no veto."""

    def __startup__():
        campaign = _paced_campaign(["cpe-1", "cpe-2", "cpe-3"])
        out = cfs.campaign_config(
            campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2", "cpe-3"])), {"cpe-2"}, set(), None, set())
        testing.assertEqual(_vetoed(out.to_gdata(), "paced"),
                            (["cpe-1", "cpe-3"], ["cpe-2"], ["cpe-1", "cpe-2", "cpe-3"], []))
        t.success()


actor _test_campaign_full_release_actuates_all(t: testing.AsyncT):
    """With every member in flight, no member has a veto."""

    def __startup__():
        campaign = _paced_campaign(["cpe-1", "cpe-2", "cpe-3"])
        released = {"cpe-1", "cpe-2", "cpe-3"}
        out = cfs.campaign_config(
            campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2", "cpe-3"])), released, set(), None, set())
        testing.assertEqual(_vetoed(out.to_gdata(), "paced"),
                            ([], ["cpe-1", "cpe-2", "cpe-3"], ["cpe-1", "cpe-2", "cpe-3"], []))
        t.success()


def _test_campaign_config_per_member():
    """What the campaign writes for each member. cpe-1 and cpe-2 have an
    image with a version, cpe-3 names an image that is not in the image
    list, and cpe-9 is not in the fleet. Every member in the fleet gets the
    campaign's name. Only a member in flight in a campaign that runs has no
    veto. Only a member with the veto that is let prepare, in a campaign
    that runs with allow-staging, has allow-staging. With names, only those
    members are written."""
    inventory = _flat_inventory(["cpe-1", "cpe-2", "cpe-3"])
    every = ["cpe-1", "cpe-2", "cpe-3"]
    targets = ["cpe-1", "cpe-2"]
    # (admin-state, allow-staging, the members in flight, the members let
    # prepare, the members to write, and the members vetoed, not vetoed,
    # with a target and with allow-staging)
    cases: list[(str, bool, set[str], set[str], ?set[str], list[str], list[str], list[str],
                 list[str])] = [
        ("plan", True, set(), set(), None, every, [], targets, []),
        ("plan", True, {"cpe-2"}, set(), None, every, [], targets, []),
        ("run", True, set(), set(), None, every, [], targets, []),
        ("run", True, {"cpe-2"}, set(), None, ["cpe-1", "cpe-3"], ["cpe-2"], targets, []),
        ("run", True, {"cpe-2"}, set(), {"cpe-2"}, [], ["cpe-2"], ["cpe-2"], []),
        ("run", True, set(), {"cpe-1"}, None, every, [], targets, ["cpe-1"]),
        ("run", False, set(), {"cpe-1"}, None, every, [], targets, []),
        ("plan", True, set(), {"cpe-1"}, None, every, [], targets, []),
        # In flight: the run prepares anyway.
        ("run", True, {"cpe-1"}, {"cpe-1"}, None, ["cpe-2", "cpe-3"], ["cpe-1"], targets, []),
        # Not in the fleet.
        ("run", True, set(), {"cpe-9"}, None, every, [], targets, []),
        ("run", True, set(), {"cpe-1", "cpe-2"}, {"cpe-2"}, ["cpe-2"], [], ["cpe-2"],
         ["cpe-2"]),
    ]
    for case in cases:
        campaign = InputCampaign(name="paced", admin_state=case.0, allow_staging=case.1)
        campaign.device.create("cpe-1", image=IMAGE)
        campaign.device.create("cpe-2", image=IMAGE)
        campaign.device.create("cpe-3", image="gone.bin")
        campaign.device.create("cpe-9", image=IMAGE)
        label = "{case.0}, allow-staging {case.1}, in flight {case.2}, let prepare {case.3}, " \
                + "names {case.4}"
        o = cfs.campaign_config(campaign, inventory, case.2, case.3, case.4, set()).to_gdata()
        testing.assertEqual(_vetoed(o, "paced"), (case.5, case.6, case.7, []), label)
        testing.assertEqual(_staged(o), case.8, label)
        for flotilla in y_1.root.from_gdata(o).rfs:
            for dev in flotilla.device:
                vetoes = [(v.holder, v.reason) for v in dev.software.veto]
                if dev.name in case.5:
                    testing.assertEqual(vetoes, [("campaign:paced", cfs.CAMPAIGN_VETO_REASON)],
                                        label)


def _test_campaign_writes_the_prepare_attempt():
    """Each member in the fleet gets its prepare attempt, also a member in
    flight, which has no veto: cpe-1 asks for its second prepare attempt,
    cpe-2 is in flight with its first, and cpe-3 keeps the default."""
    inventory = _flat_inventory(["cpe-1", "cpe-2", "cpe-3"])
    campaign = InputCampaign(name="paced", admin_state="run", allow_staging=True)
    # (member, its prepare attempt)
    members: list[(str, int)] = [("cpe-1", 2), ("cpe-2", 1), ("cpe-3", 0)]
    for m in members:
        member = campaign.device.create(m.0, image=IMAGE)
        if m.1 > 0:
            member.prepare_attempt = u64(m.1)
    testing.assertEqual(cfs.member_prepare_attempts(campaign),
                        {"cpe-1": u64(2), "cpe-2": u64(1), "cpe-3": u64(0)})
    o = cfs.campaign_config(campaign, inventory, {"cpe-2"}, set(), None, set()).to_gdata()
    testing.assertEqual(_vetoed(o, "paced"),
                        (["cpe-1", "cpe-3"], ["cpe-2"], ["cpe-1", "cpe-2", "cpe-3"], []))
    written: dict[str, ?u64] = {}
    for flotilla in y_1.root.from_gdata(o).rfs:
        for dev in flotilla.device:
            written[dev.name] = dev.software.prepare_attempt
    testing.assertEqual(written, {"cpe-1": u64(2), "cpe-2": u64(1), "cpe-3": u64(0)})


def _test_intent_patch():
    """The patch of a decision changes the veto, allow-staging,
    image-locked and attempt-failed of the members that went in flight or
    left it, of the members let prepare or no longer let, of the members
    marked or no longer marked, and of the members whose attempt failed or
    no longer failed, and gives the same output as writing the whole
    campaign again. With no change there is no patch."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    inventory = _with_nightly(_flat_inventory(names))
    campaign = _paced_campaign(names)
    campaign.allow_staging = True
    # (case, the members in flight, let prepare, marked and failed before,
    # and after)
    cases: list[(str, (set[str], set[str], set[str], set[str]),
                 (set[str], set[str], set[str], set[str]))] = [
        ("cpe-2 is released", (set(), set(), set(), set()), ({"cpe-2"}, set(), {"cpe-2"}, set())),
        ("cpe-2 is done", ({"cpe-2"}, set(), {"cpe-2"}, set()), (set(), set(), {"cpe-2"}, set())),
        ("cpe-1 is done and cpe-2 is released", ({"cpe-1"}, set(), {"cpe-1"}, set()),
         ({"cpe-2"}, set(), {"cpe-1", "cpe-2"}, set())),
        ("cpe-2 is let prepare", (set(), set(), set(), set()),
         (set(), {"cpe-2"}, {"cpe-2"}, set())),
        ("cpe-2 is done preparing", (set(), {"cpe-2"}, {"cpe-2"}, set()),
         (set(), set(), {"cpe-2"}, set())),
        ("cpe-2 is released while it prepares", (set(), {"cpe-2"}, {"cpe-2"}, set()),
         ({"cpe-2"}, set(), {"cpe-2"}, set())),
        ("cpe-1 is done preparing and cpe-3 is let", (set(), {"cpe-1"}, {"cpe-1"}, set()),
         (set(), {"cpe-3"}, {"cpe-1", "cpe-3"}, set())),
        ("cpe-3 is marked", (set(), set(), set(), set()), (set(), set(), {"cpe-3"}, set())),
        ("cpe-3 is no longer marked", (set(), set(), {"cpe-3"}, set()),
         (set(), set(), set(), set())),
        ("cpe-2 fails", ({"cpe-2"}, set(), {"cpe-2"}, set()),
         (set(), set(), {"cpe-2"}, {"cpe-2"})),
        ("cpe-2 has a new attempt", (set(), set(), {"cpe-2"}, {"cpe-2"}),
         (set(), set(), {"cpe-2"}, set())),
    ]
    for case in cases:
        old = case.1
        new = case.2
        first = cfs.campaign_config(campaign, inventory, old.0, old.1, None, set(), old.2,
                                    old.3).to_gdata()
        then = cfs.campaign_config(campaign, inventory, new.0, new.1, None, set(), new.2,
                                   new.3).to_gdata()
        testing.assertNotEqual(first, then, case.0)
        patched = cfs.intent_patch(first, campaign, inventory, old, new, set())
        testing.assertEqual(patched, then, case.0)
    same = ({"cpe-2"}, {"cpe-1"}, {"cpe-1", "cpe-2"}, {"cpe-3"})
    unchanged = cfs.campaign_config(campaign, inventory, same.0, same.1, None, set(), same.2,
                                    same.3).to_gdata()
    testing.assertEqual(cfs.intent_patch(unchanged, campaign, inventory, same, same, set()), None,
                        "nothing changes")


def _mark_rows(out: gdata.Node) -> list[str]:
    """Each mark in out, the output of a campaign, sorted: "device locked"
    for a device with image-locked, and "device failed" for one with
    attempt-failed."""
    rows: list[str] = []
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            locked = dev.software.image_locked
            if locked is not None and locked:
                rows.append("{dev.name} locked")
            failed = dev.software.attempt_failed
            if failed is not None and failed:
                rows.append("{dev.name} failed")
    return sorted(rows)


def _test_campaign_config_marks_the_members_it_keeps_the_image_of():
    """Each member in the fleet that is in locked gets image-locked, in plan
    and in run, also in flight; with names, only those members are written.
    Each member in the fleet that is in failed gets attempt-failed. cpe-9
    is not in the fleet and gets nothing."""
    inventory = _flat_inventory(["cpe-1", "cpe-2", "cpe-3"])
    # (case, admin-state, the members in flight, locked, the members to
    # write, the marks)
    cases: list[(str, str, set[str], ?set[str], ?set[str], list[str])] = [
        ("none", "run", set(), None, None, []),
        ("plan", "plan", set(), {"cpe-1", "cpe-2"}, None, ["cpe-1 locked", "cpe-2 locked"]),
        ("run, cpe-2 in flight", "run", {"cpe-2"}, {"cpe-1", "cpe-2"}, None,
         ["cpe-1 locked", "cpe-2 locked"]),
        ("not in the fleet", "run", set(), {"cpe-9"}, None, []),
        ("names", "run", set(), {"cpe-1", "cpe-2"}, {"cpe-2", "cpe-3"}, ["cpe-2 locked"]),
    ]
    for case in cases:
        campaign = InputCampaign(name="paced", admin_state=case.1)
        for name in ["cpe-1", "cpe-2", "cpe-3", "cpe-9"]:
            campaign.device.create(name, image=IMAGE)
        o = cfs.campaign_config(campaign, inventory, case.2, set(), case.4, set(), case.3).to_gdata()
        testing.assertEqual(_mark_rows(o), case.5, case.0)
    # Each member in failed gets attempt-failed.
    campaign = InputCampaign(name="paced", admin_state="run")
    for name in ["cpe-1", "cpe-2", "cpe-9"]:
        campaign.device.create(name, image=IMAGE)
    o = cfs.campaign_config(campaign, inventory, set(), set(), None, set(), {"cpe-1"},
                            {"cpe-2", "cpe-9"})
    testing.assertEqual(_mark_rows(o.to_gdata()), ["cpe-1 locked", "cpe-2 failed"], "failed")


def _test_prepare_for():
    """A prepare counts for the campaign only when the device reports it for
    the campaign's name and the member's target release, in the member's
    attempt, for the member's prepare attempt, and the prepare copies or
    copied that release. A prepare without a prepare attempt is for 0."""
    # (case, the device's campaign and target, the member's target, attempt
    # and prepare attempt, (attempt, release, state, prepare attempt) of
    # each prepare, and the state for the campaign)
    cases: list[(str, ?str, ?str, ?str, u64, u64, list[(u64, ?str, ?str, ?u64)], ?str)] = [
        ("same", "paced", "17.18.03a", "17.18.03a", 0, 0, [(0, "17.18.03a", "done", 0)],
         "done"),
        ("running", "paced", "17.18.03a", "17.18.03a", 0, 0, [(0, "17.18.03a", "running", 0)],
         "running"),
        ("other campaign", "other", "17.18.03a", "17.18.03a", 0, 0,
         [(0, "17.18.03a", "done", 0)], None),
        ("other device target", "paced", "17.18.02", "17.18.03a", 0, 0,
         [(0, "17.18.03a", "done", 0)], None),
        ("earlier attempt only", "paced", "17.18.03a", "17.18.03a", 1, 0,
         [(0, "17.18.03a", "done", 0)], None),
        ("the member's attempt", "paced", "17.18.03a", "17.18.03a", 1, 0,
         [(0, "17.18.03a", "failed", 0), (1, "17.18.03a", "done", 0)], "done"),
        ("other release", "paced", "17.18.03a", "17.18.03a", 0, 0, [(0, "17.18.02", "done", 0)],
         None),
        ("no prepare", "paced", "17.18.03a", "17.18.03a", 0, 0, [(0, None, None, None)], None),
        ("no attempt", "paced", "17.18.03a", "17.18.03a", 0, 0, [], None),
        ("member without a target", "paced", None, None, 0, 0, [(0, "17.18.03a", "done", 0)],
         None),
        ("no prepare attempt", "paced", "17.18.03a", "17.18.03a", 0, 0,
         [(0, "17.18.03a", "done", None)], "done"),
        ("the member's prepare attempt", "paced", "17.18.03a", "17.18.03a", 0, 1,
         [(0, "17.18.03a", "done", 1)], "done"),
        ("earlier prepare attempt", "paced", "17.18.03a", "17.18.03a", 0, 1,
         [(0, "17.18.03a", "failed", 0)], None),
        ("later prepare attempt", "paced", "17.18.03a", "17.18.03a", 0, 0,
         [(0, "17.18.03a", "done", 1)], None),
    ]
    for case in cases:
        testing.assertEqual(cfs.prepare_for("paced", case.3, case.4, case.5, case.1, case.2,
                                            case.6), case.7, case.0)


def _test_counted_attempt():
    """Of the attempts that a device reports for the campaign's name, the one
    in progress counts, whatever its target release, and else the member's
    attempt once the device has answered it for the member's target
    release."""
    # (case, the device's campaign and target, the member's target and
    # attempt, (attempt, status) of each attempt, and the attempt that counts)
    cases: list[(str, ?str, ?str, ?str, u64, list[(u64, ?str)], ?u64)] = [
        ("answered", "paced", "17.18.03a", "17.18.03a", 0, [(0, "upgrade-needed")], 0),
        ("answered unknown", "paced", "17.18.03a", "17.18.03a", 0, [(0, "unknown")], 0),
        ("other campaign", "other", "17.18.03a", "17.18.03a", 0, [(0, "succeeded")], None),
        ("other target", "paced", "17.18.02", "17.18.03a", 0, [(0, "succeeded")], None),
        ("not answered", "paced", "17.18.03a", "17.18.03a", 1, [(0, "failed")], None),
        ("earlier attempt in progress", "paced", "17.18.03a", "17.18.03a", 1,
         [(0, "in-progress")], 0),
        ("earlier attempt in progress for an earlier target", "paced", "17.18.02",
         "17.18.03a", 1, [(0, "in-progress")], 0),
        ("in progress for an earlier target", "paced", "17.18.02", "17.18.03a", 0,
         [(0, "in-progress")], 0),
        ("in progress in another campaign", "other", "17.18.03a", "17.18.03a", 0,
         [(0, "in-progress")], None),
        ("earlier attempt upgrade needed", "paced", "17.18.03a", "17.18.03a", 1,
         [(0, "upgrade-needed")], None),
        ("new attempt answered", "paced", "17.18.03a", "17.18.03a", 1,
         [(0, "failed"), (1, "upgrade-needed")], 1),
        ("later attempt answered", "paced", "17.18.03a", "17.18.03a", 0,
         [(0, "failed"), (1, "succeeded")], 0),
        ("no attempt", "paced", "17.18.03a", "17.18.03a", 0, [], None),
        ("no tag", None, None, "17.18.03a", 0, [(0, "failed")], None),
        ("member has no target", "paced", None, None, 0, [(0, "up-to-date")], None),
    ]
    for case in cases:
        testing.assertEqual(cfs.counted_attempt("paced", case.3, case.4, case.1, case.2,
                                                case.5),
                            case.6, case.0)


def _test_controller_status():
    """The controller takes the status of a member's counted attempt, and a
    failed rollback when the attempt failed in its rollback. A not-started
    attempt is a failed rollback: an earlier attempt failed its rollback."""
    # (status, stage, and what the controller takes)
    cases: list[(?str, ?str, (?str, bool))] = [
        ("succeeded", "commit", ("succeeded", False)),
        ("upgrade-needed", None, ("upgrade-needed", False)),
        ("failed", "install", ("failed", False)),
        ("failed", "rollback", ("failed", True)),
        ("rolled-back", "rollback", ("rolled-back", False)),
        ("in-progress", "rollback", ("in-progress", False)),
        ("not-started", None, ("failed", True)),
        (None, None, (None, False)),
    ]
    for case in cases:
        testing.assertEqual(cfs.controller_status(case.0, case.1), case.2,
                            "{case.0} at {case.1}")


def _test_waits_to_prepare():
    """A member's run waits when its counted attempt is in-progress at the
    stage prepare and its prepare is retrying, or when it is unknown."""
    # (status, stage, prepare state, whether the run waits)
    cases: list[(?str, ?str, ?str, bool)] = [
        ("in-progress", "prepare", "retrying", True),
        ("unknown", None, None, True),
        ("unknown", "prepare", "retrying", True),
        ("in-progress", "prepare", "running", False),
        ("in-progress", "prepare", None, False),
        ("in-progress", "precheck", "retrying", False),
        ("upgrade-needed", None, "retrying", False),
        ("failed", "prepare", "failed", False),
        (None, None, None, False),
    ]
    for case in cases:
        testing.assertEqual(cfs.waits_to_prepare(case.0, case.1, case.2), case.3,
                            "{case.0} at {case.1}, prepare {case.2}")


def _campaign_path(name: str) -> ttt.Path:
    """Return the path of one campaign entry, as TTT builds it."""
    software = ttt.PathElem(gdata.Id(y0_oper.NS_software, "software"), ttt.PathRoot("root"))
    campaigns = ttt.PathElem(gdata.Id(y0_oper.NS_software, "upgrade-campaign"), software)
    return ttt.PathKey(name, campaigns, {gdata.Id(y0_oper.NS_software, "name"): gdata.Leaf(name)})


def _cleared_last(published: list[bool]) -> bool:
    """Whether a campaign published nothing after clearing its state: its
    only None, False here, came last."""
    nones = [p for p in published if not p]
    return len(nones) == 1 and not published[len(published) - 1]


actor _test_deleted_campaign_publishes_nothing_more(t: testing.AsyncT):
    """A campaign in plan deleted while a member change waits out its
    debounce clears its state and then publishes nothing: not for that
    change, nor for a sync that comes after the delete."""
    var published: list[bool] = []

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        published.append(oper is not None)

    def check() -> None:
        if _cleared_last(published):
            t.success()
        else:
            t.failure(ValueError("published {published}"))

    names = ["cpe-1", "cpe-2"]
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda d: None, on_oper, None)

    def __startup__():
        conf = _paced_campaign(names)
        conf.admin_state = "plan"
        campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
        campaign.on_subscriptions_synced()
        # cpe-1's state goes, a member change like any other.
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), None, None)
        campaign.shutdown()
        # Closing the subscriptions fires a sync that is still pending.
        campaign.on_subscriptions_synced()
        after float(cfs.campaign_debounce_s(len(names))) + 0.5: check()



actor _test_deleted_running_campaign_stops_deciding(t: testing.AsyncT):
    """A deleted running campaign clears its state, and a member change
    after the delete does not make it decide again."""
    var published: list[bool] = []

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
