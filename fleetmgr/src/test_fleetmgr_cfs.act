def _test_device_ssh_propagation():
    """CFS SSH options survive both transforms and the flotilla XML boundary."""
    config = xml.decode("""<config>
      <fleet xmlns="urn:fleetmgr:fleetmgr">
        <device>
          <name>configured</name>
          <type>iosxe</type>
          <credentials><username>admin</username></credentials>
          <ssh>
            <cipher>aes256-ctr</cipher>
            <cipher>aes128-ctr</cipher>
            <mac>hmac-sha2-512</mac>
            <mac>hmac-sha2-256</mac>
            <key-exchange>ecdh-sha2-nistp384</key-exchange>
            <key-exchange>curve25519-sha256</key-exchange>
            <host-key-algorithm>ssh-ed25519</host-key-algorithm>
            <host-key-algorithm>rsa-sha2-512</host-key-algorithm>
            <public-key-algorithm>ssh-ed25519</public-key-algorithm>
            <public-key-algorithm>rsa-sha2-256</public-key-algorithm>
            <compression-algorithm>zlib@openssh.com</compression-algorithm>
            <compression-algorithm>none</compression-algorithm>
            <compression-level>3</compression-level>
            <rekey-after-bytes>1048576</rekey-after-bytes>
            <rekey-after-seconds>3600</rekey-after-seconds>
            <minimum-rsa-bits>3072</minimum-rsa-bits>
          </ssh>
        </device>
        <device>
          <name>defaults</name>
          <type>iosxe</type>
          <credentials><username>admin</username></credentials>
        </device>
      </fleet>
    </config>""")
    inputs = y_0.root.from_gdata(yxml.from_xml(y_0.SRC_DNODE, config))
    di = ttt.DeviceInfo("flotilla-1", {
        "stratoweave-rfs": swadapt.ModCap(
            "stratoweave-rfs",
            "http://stratoweave.org/yang/stratoweave-rfs",
        )
    })
    devices: dict[str, DeviceMetaConfig] = {}
    for i in inputs.fleet.device:
        lower = y_1_config.root.from_gdata(cfs.Device().transform(i).to_gdata())
        entry = lower.rfs.get(cfs.flotilla_of(i.name))!.device.get(i.name)!
        rendered = rfs.Device().transform(entry, di).to_gdata()
        wire = xml.Node("config", children=rendered.to_xml())
        received = flotilla_rfs.root.from_gdata(
            yxml.from_xml(flotilla_rfs.SRC_DNODE, xml.decode(xml.encode(wire)))
        )
        devices[i.name] = DeviceMetaConfig.from_gdata(
            received.device.get(i.name)!.to_gdata()
        )

    configured = swadapt.ssh_transport_config(devices["configured"].ssh)
    testing.assertEqual([str(c) for c in configured.ciphers],
                        ["aes256-ctr", "aes128-ctr"])
    testing.assertEqual([str(m) for m in configured.macs],
                        ["hmac-sha2-512", "hmac-sha2-256"])
    testing.assertEqual([str(k) for k in configured.key_exchanges],
                        ["ecdh-sha2-nistp384", "curve25519-sha256"])
    testing.assertEqual([str(k) for k in configured.host_key_algorithms],
                        ["ssh-ed25519", "rsa-sha2-512"])
    testing.assertEqual([str(k) for k in configured.public_key_algorithms],
                        ["ssh-ed25519", "rsa-sha2-256"])
    testing.assertEqual([str(c) for c in configured.compression_algorithms],
                        ["zlib@openssh.com", "none"])
    testing.assertEqual(configured.compression_level, 3)
    testing.assertEqual(configured.rekey_after_bytes, 1048576)
    testing.assertEqual(configured.rekey_after_seconds, 3600)
    testing.assertEqual(configured.minimum_rsa_bits, 3072)

    defaults = devices["defaults"].ssh
    testing.assertEqual(defaults.cipher, [])
    testing.assertEqual(defaults.mac, [])
    testing.assertEqual(defaults.key_exchange, [])
    testing.assertEqual(defaults.host_key_algorithm, [])
    testing.assertEqual(defaults.public_key_algorithm, [])
    testing.assertEqual(defaults.compression_algorithm, [])
    testing.assertEqual(defaults.compression_level, u64(7))
    testing.assertEqual(defaults.rekey_after_bytes, None)
    testing.assertEqual(defaults.rekey_after_seconds, None)
    testing.assertEqual(defaults.minimum_rsa_bits, u64(1024))


def _test_device_extra_adapter_propagation():
    """A CFS extra adapter, with its own port, credentials and SSH options,
    survives both transforms and the flotilla XML boundary."""
    config = xml.decode("""<config>
      <fleet xmlns="urn:fleetmgr:fleetmgr">
        <device>
          <name>c1111</name>
          <type>iosxe</type>
          <address><name>oob</name><address>192.0.2.17</address><port>830</port></address>
          <credentials><username>admin</username></credentials>
          <extra-adapter>
            <type>iosxe-cli</type>
            <port>22</port>
            <credentials>
              <username>cli</username>
              <key><key>lab</key><private-key>KEY</private-key></key>
            </credentials>
            <ssh>
              <public-key-algorithm>ssh-rsa</public-key-algorithm>
              <key-exchange>diffie-hellman-group14-sha1</key-exchange>
            </ssh>
          </extra-adapter>
          <extra-adapter>
            <type>other</type>
          </extra-adapter>
        </device>
      </fleet>
    </config>""")
    inputs = y_0.root.from_gdata(yxml.from_xml(y_0.SRC_DNODE, config))
    di = ttt.DeviceInfo("flotilla-1", {
        "stratoweave-rfs": swadapt.ModCap(
            "stratoweave-rfs",
            "http://stratoweave.org/yang/stratoweave-rfs",
        )
    })
    i = inputs.fleet.device.get("c1111")!
    lower = y_1_config.root.from_gdata(cfs.Device().transform(i).to_gdata())
    entry = lower.rfs.get(cfs.flotilla_of(i.name))!.device.get(i.name)!
    rendered = rfs.Device().transform(entry, di).to_gdata()
    wire = xml.Node("config", children=rendered.to_xml())
    received = flotilla_rfs.root.from_gdata(
        yxml.from_xml(flotilla_rfs.SRC_DNODE, xml.decode(xml.encode(wire)))
    )
    dmc = DeviceMetaConfig.from_gdata(received.device.get(i.name)!.to_gdata())

    testing.assertEqual([a.type for a in dmc.extra_adapter], ["iosxe-cli", "other"], "in order")
    cli = dmc.extra_adapter.get("iosxe-cli")!
    testing.assertEqual(cli.port, u64(22))
    c = cli.credentials
    testing.assertTrue(c is not None, "the CLI has its own credentials")
    if c is not None:
        testing.assertEqual(c.username, "cli")
        testing.assertEqual([k.private_key for k in c.key], ["KEY"])
    ssh = cli.ssh
    testing.assertTrue(ssh is not None, "the CLI has its own SSH options")
    if ssh is not None:
        testing.assertEqual(ssh.public_key_algorithm, ["ssh-rsa"])
        testing.assertEqual(ssh.key_exchange, ["diffie-hellman-group14-sha1"])
    other = dmc.extra_adapter.get("other")!
    testing.assertEqual((other.port, other.credentials is None, other.ssh is None), (None, True, True))


IMAGE = "c8000v-universalk9.17.18.03a.SPA.bin"
IMAGE_MD5 = "35a91bebe3b1f38606bd0a845426929f"
IMAGE_SIZE = 962330352
URL_BASE = "https://images.example/"


def _with_images(linked: y_0.root) -> y_0.root:
    """The image list the members name, with url-base."""
    linked.images.url_base = URL_BASE
    image = linked.images.image.create(IMAGE, os="IOS XE", version="17.18.03a")
    image.checksum.create("md5", IMAGE_MD5)
    image.size = u64(IMAGE_SIZE)
    return linked


actor _test_campaign_transform(t: testing.AsyncT):
    inventory = _with_images(y_0.root())
    inventory.fleet.device.create(
        "cpe-1",
        type="iosxe",
        credentials=InputCredentials(username="admin"),
    )
    campaign = InputCampaign(
        name="xe-upgrade",
        allow_staging=True,
        admin_state="run",
    )
    campaign.device.create("cpe-1", image=IMAGE)

    # cpe-1 is in flight, so it has no veto.
    o: y_1.root = y_1.root.from_gdata(
        cfs.campaign_config(campaign, inventory, {"cpe-1"}, None).to_gdata()
    )
    dev = o.rfs.get(cfs.flotilla_of("cpe-1"))!.device.get("cpe-1")!

    digest = ""
    checksum = dev.software.image_checksum.get("md5")
    if checksum is not None:
        digest = checksum.digest
    if dev.software.target_release != "17.18.03a" or \
       dev.software.upgrade_campaign != "xe-upgrade" or \
       dev.software.image_url != URL_BASE + IMAGE or \
       digest != IMAGE_MD5 or len(dev.software.image_checksum) != 1 or \
       dev.software.image_size != u64(IMAGE_SIZE):
        t.failure(ValueError("campaign was not routed to the device's flotilla: md5 {digest}, size {dev.software.image_size}"))
    elif dev.software.allow_staging is not None:
        t.failure(ValueError("the campaign passed allow-staging to the device"))
    elif len(dev.software.veto) != 0:
        t.failure(ValueError("a member in flight has a veto"))
    else:
        t.success()


actor _test_campaign_link_routes_existing_inventory(t: testing.AsyncT):
    """A later campaign resolves and augments an existing inventory device."""
    root = _with_images(y_0.root())
    root.fleet.device.create(
        "cpe-1",
        type="iosxe",
        credentials=InputCredentials(username="admin"),
    )
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_campaign(result) -> None:
        # The campaign's transform function writes the intent in the
        # campaign's edit, so it is there when the edit is done.
        if isinstance(result, Exception):
            fail("campaign edit failed: {result}")
            return
        if done:
            return
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        found = "no entry"
        flotilla = lower.rfs.get(cfs.flotilla_of("cpe-1"))
        if flotilla is not None:
            out = flotilla.device.get("cpe-1")
            if out is not None:
                held = out.software.veto.get(cfs.veto_holder("xe-upgrade")) is not None
                found = "{out.software.upgrade_campaign} {out.software.target_release} {held}"
        if found == "xe-upgrade 17.18.03a True":
            done = True
            t.success()
        else:
            fail("linked campaign did not augment the existing inventory device: {found}")

    def on_inventory(result) -> None:
        if isinstance(result, Exception):
            fail("inventory edit failed: {result}")
            return
        # In plan, so the actor does not release the device.
        campaign = root.software.upgrade_campaign.create(
            "xe-upgrade",
            admin_state="plan",
        )
        campaign.device.create("cpe-1", image=IMAGE)
        tr.edit_config(root.to_gdata(), on_campaign)

    tr.edit_config(root.to_gdata(), on_inventory)
    after 8.0: fail("timed out waiting for linked campaign")


def _vetoed(out: gdata.Node, campaign: str) -> (list[str], list[str], list[str], list[str]):
    """Return the devices in out, the output of a campaign, that have the
    campaign's veto, the devices that do not, the devices with a target
    release, and the devices that do not have the campaign's name. Each
    list is sorted."""
    holder = cfs.veto_holder(campaign)
    vetoed: list[str] = []
    free: list[str] = []
    targeted: list[str] = []
    unnamed: list[str] = []
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            if dev.software.veto.get(holder) is not None:
                vetoed.append(dev.name)
            else:
                free.append(dev.name)
            if dev.software.target_release is not None:
                targeted.append(dev.name)
            if dev.software.upgrade_campaign != campaign:
                unnamed.append(dev.name)
    return (sorted(vetoed), sorted(free), sorted(targeted), sorted(unnamed))


def _test_campaign_function_renders_the_claim():
    """The campaign's transform function gives every member the campaign's
    name, target and veto. In run, the members that the output written last
    has in flight, without the veto, keep no veto. A prev of another
    campaign gives none in flight."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    inventory = _with_nightly(_flat_inventory(names))
    linked = inventory.to_gdata()
    run = _paced_campaign(names)
    prev = cfs.campaign_config(run, inventory, {"cpe-2"}, None).to_gdata()
    other = InputCampaign(name="other", admin_state="run")
    for name in names:
        other.device.create(name, image=IMAGE)
    prev_other = cfs.campaign_config(other, inventory, {"cpe-2"}, None).to_gdata()
    testing.assertEqual(cfs.unheld_in(prev, run), {"cpe-2"}, "prev has cpe-2 in flight")
    testing.assertEqual(cfs.unheld_in(prev_other, run), set(),
                        "the prev of another campaign has none of this one in flight")
    # (case, admin-state, prev, the vetoed members)
    cases: list[(str, str, ?gdata.Node, list[str])] = [
        ("plan, no prev", "plan", None, names),
        ("plan, cpe-2 in flight in prev", "plan", prev, names),
        ("run, no prev", "run", None, names),
        ("run, cpe-2 in flight in prev", "run", prev, ["cpe-1", "cpe-3"]),
        ("run, prev of another campaign", "run", prev_other, names),
    ]
    for case in cases:
        campaign = _paced_campaign(names)
        campaign.admin_state = case.1
        out = cfs.UpgradeCampaign().transform(campaign, linked, case.2).to_gdata()
        vetoed, free, targeted, unnamed = _vetoed(out, "paced")
        testing.assertEqual(vetoed, case.3, case.0)
        testing.assertEqual(sorted(vetoed + free), names, case.0)
        testing.assertEqual(targeted, names, case.0)
        testing.assertEqual(unnamed, [], case.0)

    # With nothing changed the wrapper returns the last output itself, so
    # TTT skips the members.
    wrapped = cfs.UpgradeCampaign().transform_wrapper(run.to_gdata(), linked, None, None, prev)
    testing.assertEqual(wrapped.0, prev, "the function gives what the actor wrote")
    testing.assertTrue(ttt.same_node(wrapped.0, prev), "the wrapper returns prev itself")


actor _test_campaign_edit_keeps_its_output(t: testing.AsyncT):
    """An edit of a running campaign keeps the intent that the campaign
    wrote for its member. The edit runs the campaign's transform function,
    and its output replaces what the actor wrote. The flotillas of the test
    system are mocks that report no device state, so cpe-1 never answers
    the campaign's target, and the campaign holds it under its veto, also
    after the edit. _test_campaign_function_renders_the_claim covers a
    member in flight."""
    root = _with_images(y_0.root())
    root.fleet.device.create(
        "cpe-1",
        type="iosxe",
        credentials=InputCredentials(username="admin"),
    )
    tr = stratoweave.test_main(sysspec.SYSSPEC, t.log_handler)
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def intent() -> str:
        """cpe-1's target release in the layer below the campaigns, and
        whether it has the campaign's veto."""
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        flotilla = lower.rfs.get(cfs.flotilla_of("cpe-1"))
        if flotilla is not None:
            out = flotilla.device.get("cpe-1")
            if out is not None:
                held = out.software.veto.get(cfs.veto_holder("xe-upgrade")) is not None
                return "{out.software.target_release} held {held}"
        return "no entry"

    def on_edit(result) -> None:
        if isinstance(result, Exception):
            fail("campaign edit failed: {result}")
            return
        found = intent()
        if found == "17.18.03a held True":
            if not done:
                done = True
                t.success()
        else:
            fail("the edit did not keep cpe-1's intent: {found}")

    def still_held() -> None:
        if done:
            return
        # The campaign has decided by now. cpe-1 has not answered, so the
        # campaign has not released it.
        found = intent()
        if found == "17.18.03a held True":
            campaign = root.software.upgrade_campaign.get("xe-upgrade")
            if campaign is not None:
                campaign.target_concurrency = u64(2)
            tr.edit_config(root.to_gdata(), on_edit)
        else:
            fail("cpe-1 is not held for its answer: {found}")

    def on_campaign(result) -> None:
        if isinstance(result, Exception):
            fail("campaign create failed: {result}")
            return
        after float(cfs.campaign_debounce_s(1)) + 0.5: still_held()

    def on_inventory(result) -> None:
        if isinstance(result, Exception):
            fail("inventory edit failed: {result}")
            return
        campaign = root.software.upgrade_campaign.create(
            "xe-upgrade",
            admin_state="run",
        )
        campaign.device.create("cpe-1", image=IMAGE)
        tr.edit_config(root.to_gdata(), on_campaign)

    tr.edit_config(root.to_gdata(), on_inventory)
    after 8.0: fail("timed out waiting for the campaign edit")


mut def _lab_device() -> InputDevice:
    """Return a device with every option set."""
    credentials: InputCredentials = InputCredentials(
        username="netops",
        password="netops-password",
    )
    credentials.key.create("ssh-ed25519 public", private_key="private")

    i: InputDevice = InputDevice(
        name="cpe-1",
        type="iosxe",
        description="Lab CPE",
        credentials=credentials,
        approval_required=True,
        sync_check=False,
    )
    address: InputAddress = i.address.create(
        "oob",
        address="192.0.2.1",
        port=u64(830),
    )
    address.initial_credentials.create((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    i.initial_credentials.create((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    i.mock.enabled = True
    i.mock.software.upgrade_duration = u64(60)
    i.mock.software.upgrade_duration_variance = u64(35)
    i.mock.software.failure = "commit-failed"
    i.mock.platform.version = "17.18.03a"
    i.mock.platform.model = "C8300-1N1S-4T2X"
    i.mock.platform.serial_number = "FGL2231L0AB"
    module: InputMockModule = i.mock.module.create(
        "ietf-system",
        namespace="urn:ietf:params:xml:ns:yang:ietf-system",
        revision="2014-08-06",
    )
    module.feature = ["authentication", "local-users"]
    i.ssh.cipher = ["aes256-ctr", "aes128-ctr"]
    i.ssh.compression_level = u64(3)
    i.ssh.rekey_after_seconds = u64(3600)
    i.debug.connection = True
    i.feature_flags.runtime_schema_fetch = True
    i.upgrade_checks.precheck_wait = u64(30)
    i.upgrade_checks.postcheck_wait = u64(120)
    return i


actor _test_device_transform(t: testing.AsyncT):
    transform: cfs.Device = cfs.Device()
    o: y_1.root = y_1.root.from_gdata(transform.transform(_lab_device()).to_gdata())
    flotilla = o.rfs.get(cfs.flotilla_of("cpe-1"))!
    dev: OutputDevice = flotilla.device.get("cpe-1")!
    out_address: OutputAddress = dev.address.get("oob")!
    address_credentials: ?AddressCredentials = out_address.initial_credentials.get((
        username="address-bootstrap",
        password="address-password",
        key="address-key",
    ))
    device_credentials: ?DeviceCredentials = dev.initial_credentials.get((
        username="device-bootstrap",
        password="device-password",
        key="device-key",
    ))
    out_key: OutputKey = dev.credentials.key.get("ssh-ed25519 public")!
    out_module: OutputMockModule = dev.mock.module.get("ietf-system")!

    if dev.type != "iosxe" or dev.description != "Lab CPE":
        t.failure(ValueError("device identity was not preserved"))
    elif out_address.address != "192.0.2.1" or out_address.port != u64(830):
        t.failure(ValueError("device address fields were not preserved"))
    elif address_credentials is None or device_credentials is None:
        t.failure(ValueError("initial credentials were not preserved"))
    elif dev.credentials.username != "netops" or dev.credentials.password != "netops-password":
        t.failure(ValueError("active credentials were not preserved"))
    elif out_key.private_key != "private":
        t.failure(ValueError("credential keys were not preserved"))
    elif not dev.approval_required! or dev.sync_check != False or not dev.mock.enabled!:
        t.failure(ValueError("device policy fields were not preserved"))
    elif out_module.namespace != "urn:ietf:params:xml:ns:yang:ietf-system" or \
         out_module.revision != "2014-08-06" or \
         out_module.feature != ["authentication", "local-users"]:
        t.failure(ValueError("mock module fields were not preserved"))
    elif dev.mock.software.upgrade_duration != u64(60) or \
         dev.mock.software.upgrade_duration_variance != u64(35) or \
         dev.mock.software.failure != "commit-failed" or \
         dev.mock.platform.version != "17.18.03a" or \
         dev.mock.platform.model != "C8300-1N1S-4T2X" or \
         dev.mock.platform.serial_number != "FGL2231L0AB":
        t.failure(ValueError("mock upgrade duration, variance, failure or platform was not preserved"))
    elif not dev.debug.connection! or not dev.feature_flags.runtime_schema_fetch!:
        t.failure(ValueError("debug or feature flags were not preserved"))
    elif dev.upgrade_checks.precheck_wait != u64(30) or dev.upgrade_checks.postcheck_wait != u64(120):
        t.failure(ValueError("upgrade check waits were not preserved"))
    else:
        t.success()


def _test_device_writes_its_flotilla():
    """A device's transform also writes the top's entry for its flotilla, with
    the flotilla's local NETCONF port and the flotillas' default login."""
    o: y_1.root = y_1.root.from_gdata(cfs.Device().transform(_lab_device()).to_gdata())
    name = cfs.flotilla_of("cpe-1")
    testing.assertEqual([d.name for d in o.device], [name])
    dev: OutputNode = o.device.get(name)!
    testing.assertEqual(dev.type, "flotilla")
    testing.assertEqual(dev.sync_check, False)
    address = dev.address.get("primary")!
    testing.assertEqual(address.address, "127.0.0.1")
    testing.assertEqual(address.port, u64(12901 + cfs.flotilla_index("cpe-1")))
    testing.assertEqual(dev.credentials.username, "admin")
    testing.assertEqual(dev.credentials.password, "admin")


def _test_flotilla_placement():
    """A device's name picks its flotilla, the same on every run, and a fleet
    spreads over all ten. A change in Acton's hash would move devices to
    other flotillas; the pinned names catch that."""
    testing.assertEqual(cfs.flotilla_of("cpe-001"), "flotilla-8")
    testing.assertEqual(cfs.flotilla_of("cpe-002"), "flotilla-9")
    seen: set[str] = set()
    for i in range(1, 101):
        seen.add(cfs.flotilla_of("cpe-{i:03d}"))
    testing.assertEqual(sorted(list(seen)), sorted(["flotilla-{n}" for n in range(1, 11)]))


def _paced_campaign(names: list[str]) -> InputCampaign:
    campaign = InputCampaign(
        name="paced",
        admin_state="run",
        default_schedule="nightly",
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    return campaign


def _with_nightly(linked: y_0.root) -> y_0.root:
    """A ten minute nightly window at launch, the schedule the paced
    campaign defaults to."""
    linked.schedules.schedule.create("nightly").window.create(u64(0), duration=u64(600))
    return linked


def _plan(campaign: InputCampaign, linked: y_0.root,
          now: int) -> (list[(str, int, int, list[(str, int, int)])], list[str], int):
    """The campaign's plan at time now, before a run, with every member
    answered that it needs the upgrade: the layout, the alarms and the
    concurrency."""
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, now)
    sim.answer_all(ctl, now)
    p = ctl.plan(now)
    return (ctl.layout(p), p.alarms, p.c)


def _replanned(campaign: InputCampaign, linked: y_0.root, now: int) -> fctl.Controller:
    """A run of the campaign in which cpe-1 was released at 10 in last
    night's window and reported done at 14, planned again at time now.
    Every member answered at 0 that it needs the upgrade."""
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    ctl.resume("cpe-1", 10, ("nightly", 0, 600))
    ctl.report("cpe-1", "succeeded", 14)
    cfs.configure_campaign(ctl, campaign, linked, now)
    return ctl


def _flat_inventory(names: list[str], upgrade_duration: ?int = None) -> y_0.root:
    linked = _with_images(y_0.root())
    for name in names:
        dev = linked.fleet.device.create(
            name,
            type="iosxe",
            credentials=InputCredentials(username="admin"),
        )
        dev.mock.enabled = True
        if upgrade_duration is not None:
            dev.mock.software.upgrade_duration = u64(upgrade_duration)
    return linked


def _window_names(layout: list[(str, int, int, list[(str, int, int)])], window: str) -> list[str]:
    names = []
    for win in layout:
        if win.0 == window:
            for entry in win.3:
                names.append(entry.0)
    return sorted(names)


actor _test_campaign_without_windows_gets_default_window(t: testing.AsyncT):
    """No windows defined: one synthetic open window takes everyone, and
    the campaign's veto holds the device until the controller releases
    it."""
    linked = _flat_inventory(["cpe-1"])
    campaign = InputCampaign(
        name="now",
        admin_state="run",
    )
    campaign.device.create("cpe-1", image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(_window_names(layout, "default"), ["cpe-1"], None)
    vetoed, free, targeted, unnamed = _vetoed(
        cfs.campaign_config(campaign, linked, set(), None).to_gdata(), "now")
    testing.assertEqual((vetoed, free), (["cpe-1"], []), "an unreleased device is held")
    vetoed, free, targeted, unnamed = _vetoed(
        cfs.campaign_config(campaign, linked, {"cpe-1"}, None).to_gdata(), "now")
    testing.assertEqual((vetoed, free), ([], ["cpe-1"]), "a released device is not held")
    t.success()


def _routed(campaign: InputCampaign, inventory: y_0.root) -> list[str]:
    """The members campaign gives a target release, with no member in
    flight."""
    o = cfs.campaign_config(campaign, inventory, set(), None).to_gdata()
    vetoed, free, targeted, unnamed = _vetoed(o, campaign.name)
    return targeted


def _test_campaign_member_images():
    """A member whose image is not in the image list, or has no version,
    gets no target release, and the campaign says why. It still gets the
    campaign's name and veto, so no other campaign can take it."""
    inventory = _flat_inventory(["cpe-1", "cpe-2", "cpe-3"])
    inventory.images.image.create("no-version.bin", os="IOS XE")
    campaign = InputCampaign(name="images", admin_state="run")
    campaign.device.create("cpe-1", image=IMAGE)
    campaign.device.create("cpe-2", image="gone.bin")
    campaign.device.create("cpe-3", image="no-version.bin")
    testing.assertEqual(_routed(campaign, inventory), ["cpe-1"])
    o = cfs.campaign_config(campaign, inventory, set(), None).to_gdata()
    vetoed, free, targeted, unnamed = _vetoed(o, "images")
    testing.assertEqual(vetoed, ["cpe-1", "cpe-2", "cpe-3"], "every member is held")
    testing.assertEqual(unnamed, [], "every member has the campaign's name")
    out = y_1.root.from_gdata(o)
    for name in ["cpe-2", "cpe-3"]:
        dev = out.rfs.get(cfs.flotilla_of(name))!.device.get(name)!
        testing.assertEqual(dev.software.image_url, None, name)
    testing.assertEqual(cfs.member_targets(campaign, inventory), {"cpe-1": "17.18.03a"})
    testing.assertEqual(cfs.image_alarms(campaign, inventory), [
        "image gone.bin is not in the image list (1 device)",
        "image no-version.bin has no version (1 device)",
    ])


def _test_campaign_without_url_base():
    """Without url-base the release is still set but there is no URL, and
    the campaign says devices cannot fetch images."""
    inventory = _flat_inventory(["cpe-1"])
    inventory.images.url_base = None
    campaign = InputCampaign(name="no-url", admin_state="run")
    campaign.device.create("cpe-1", image=IMAGE)
    o: y_1.root = y_1.root.from_gdata(cfs.campaign_config(campaign, inventory, {"cpe-1"}, None).to_gdata())
    dev = o.rfs.get(cfs.flotilla_of("cpe-1"))!.device.get("cpe-1")!
    testing.assertEqual(dev.software.target_release, "17.18.03a")
    testing.assertEqual(dev.software.image_url, None)
    testing.assertEqual(cfs.image_alarms(campaign, inventory),
                        ["no url-base in the image list: devices cannot fetch images"])


actor _test_campaign_deadline_without_windows_plans(t: testing.AsyncT):
    """A deadline alone closes the synthetic window; devices still plan."""
    campaign = InputCampaign(
        name="dl",
        admin_state="plan",
        deadline=u64(3600),
    )
    for name in ["d1", "d2"]:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, _flat_inventory(["d1", "d2"]), 0)
    testing.assertEqual(_window_names(layout, "default"), ["d1", "d2"], None)
    testing.assertEqual(len(alarms), 0, "a meetable deadline must not alarm")
    for win in layout:
        testing.assertEqual(win.2 <= 3600, True, "the deadline closes the window")
    t.success()


actor _test_campaign_plan_state_holds_every_member(t: testing.AsyncT):
    """In plan admin-state the layout exists, and every member gets the
    campaign's name and target, held by the campaign's veto."""
    campaign = _paced_campaign(["cpe-1", "cpe-2"])
    campaign.admin_state = "plan"
    layout, alarms, conc = _plan(campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2"])), 0)
    testing.assertEqual(_window_names(layout, "nightly"), ["cpe-1", "cpe-2"], None)
    # In plan a member in flight is held too.
    out = cfs.campaign_config(campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2"])),
                              {"cpe-2"}, None)
    testing.assertEqual(_vetoed(out.to_gdata(), "paced"),
                        (["cpe-1", "cpe-2"], [], ["cpe-1", "cpe-2"], []))
    t.success()


actor _test_campaign_lifts_the_veto_only_in_flight(t: testing.AsyncT):
    """Every member gets the campaign's intent, and only the members in
    flight have no veto."""
    campaign = _paced_campaign(["cpe-1", "cpe-2", "cpe-3"])
    out = cfs.campaign_config(
        campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2", "cpe-3"])), {"cpe-2"}, None)
    testing.assertEqual(_vetoed(out.to_gdata(), "paced"),
                        (["cpe-1", "cpe-3"], ["cpe-2"], ["cpe-1", "cpe-2", "cpe-3"], []))
    t.success()


actor _test_campaign_full_release_actuates_all(t: testing.AsyncT):
    """With every member in flight, no member has a veto."""
    campaign = _paced_campaign(["cpe-1", "cpe-2", "cpe-3"])
    released = {"cpe-1", "cpe-2", "cpe-3"}
    out = cfs.campaign_config(
        campaign, _with_nightly(_flat_inventory(["cpe-1", "cpe-2", "cpe-3"])), released, None)
    testing.assertEqual(_vetoed(out.to_gdata(), "paced"),
                        ([], ["cpe-1", "cpe-2", "cpe-3"], ["cpe-1", "cpe-2", "cpe-3"], []))
    t.success()


def _test_campaign_config_per_member():
    """What the campaign writes for each member. cpe-1 and cpe-2 have an
    image with a version, cpe-3 names an image that is not in the image
    list, and cpe-9 is not in the fleet. Every member in the fleet gets the
    campaign's name. Only a member in flight in a campaign that runs has no
    veto. With names, only those members are written. allow-staging is
    never written."""
    inventory = _flat_inventory(["cpe-1", "cpe-2", "cpe-3"])
    # (admin-state, the members in flight, the members to write, and the
    # members vetoed, not vetoed and with a target)
    cases: list[(str, set[str], ?set[str], list[str], list[str], list[str])] = [
        ("plan", set(), None, ["cpe-1", "cpe-2", "cpe-3"], [], ["cpe-1", "cpe-2"]),
        ("plan", {"cpe-2"}, None, ["cpe-1", "cpe-2", "cpe-3"], [], ["cpe-1", "cpe-2"]),
        ("run", set(), None, ["cpe-1", "cpe-2", "cpe-3"], [], ["cpe-1", "cpe-2"]),
        ("run", {"cpe-2"}, None, ["cpe-1", "cpe-3"], ["cpe-2"], ["cpe-1", "cpe-2"]),
        ("run", {"cpe-2"}, {"cpe-2"}, [], ["cpe-2"], ["cpe-2"]),
    ]
    for case in cases:
        campaign = InputCampaign(name="paced", admin_state=case.0, allow_staging=True)
        campaign.device.create("cpe-1", image=IMAGE)
        campaign.device.create("cpe-2", image=IMAGE)
        campaign.device.create("cpe-3", image="gone.bin")
        campaign.device.create("cpe-9", image=IMAGE)
        label = "{case.0}, in flight {case.1}, names {case.2}"
        o = cfs.campaign_config(campaign, inventory, case.1, case.2).to_gdata()
        testing.assertEqual(_vetoed(o, "paced"), (case.3, case.4, case.5, []), label)
        for flotilla in y_1.root.from_gdata(o).rfs:
            for dev in flotilla.device:
                testing.assertEqual(dev.software.allow_staging, None, label)
                vetoes = [(v.holder, v.reason) for v in dev.software.veto]
                if dev.name in case.3:
                    testing.assertEqual(vetoes, [("campaign:paced", cfs.CAMPAIGN_VETO_REASON)],
                                        label)


def _test_release_patch():
    """The patch of a decision changes the veto of the members that went in
    flight or left it, and gives the same output as writing the whole
    campaign again. With no change there is no patch."""
    names = ["cpe-1", "cpe-2", "cpe-3"]
    inventory = _with_nightly(_flat_inventory(names))
    campaign = _paced_campaign(names)
    # (case, the members in flight before and after)
    cases: list[(str, set[str], set[str])] = [
        ("cpe-2 is released", set(), {"cpe-2"}),
        ("cpe-2 is done", {"cpe-2"}, set()),
        ("cpe-1 is done and cpe-2 is released", {"cpe-1"}, {"cpe-2"}),
    ]
    for case in cases:
        first = cfs.campaign_config(campaign, inventory, case.1, None).to_gdata()
        then = cfs.campaign_config(campaign, inventory, case.2, None).to_gdata()
        patched = cfs.release_patch(first, campaign, inventory, case.1, case.2)
        testing.assertEqual(patched, then, case.0)
    unchanged = cfs.campaign_config(campaign, inventory, {"cpe-2"}, None).to_gdata()
    testing.assertEqual(cfs.release_patch(unchanged, campaign, inventory, {"cpe-2"}, {"cpe-2"}),
                        None, "nothing changes")


def _test_status_for():
    """A status counts for the campaign only when the device says that it
    answers the campaign's name and the member's target release."""
    # (case, the tag's campaign and target, the member's target, the
    # status, and the status for the campaign)
    cases: list[(str, ?str, ?str, ?str, ?str, ?str)] = [
        ("same", "paced", "17.18.03a", "17.18.03a", "upgrade-needed", "upgrade-needed"),
        ("same, unknown", "paced", "17.18.03a", "17.18.03a", "unknown", "unknown"),
        ("other campaign", "other", "17.18.03a", "17.18.03a", "succeeded", None),
        ("other target", "paced", "17.18.02", "17.18.03a", "succeeded", None),
        ("no tag", None, None, "17.18.03a", "failed", None),
        ("member has no target", "paced", None, None, "up-to-date", None),
    ]
    for case in cases:
        testing.assertEqual(cfs.status_for("paced", case.3, case.1, case.2, case.4), case.5,
                            case.0)


def _campaign_path(name: str) -> ttt.Path:
    """Return the path of one campaign entry, as TTT builds it."""
    software = ttt.PathElem(gdata.Id(y0_oper.NS_software, "software"), ttt.PathRoot("root"))
    campaigns = ttt.PathElem(gdata.Id(y0_oper.NS_software, "upgrade-campaign"), software)
    return ttt.PathKey(name, campaigns, {gdata.Id(y0_oper.NS_software, "name"): gdata.Leaf(name)})


def _cleared_last(published: list[bool]) -> bool:
    """Whether a campaign published nothing after clearing its state: its
    only None, False here, came last."""
    nones = [p for p in published if not p]
    return len(nones) == 1 and not published[len(published) - 1]


actor _test_deleted_campaign_publishes_nothing_more(t: testing.AsyncT):
    """A campaign in plan deleted while a member change waits out its
    debounce clears its state and then publishes nothing: not for that
    change, nor for a sync that comes after the delete."""
    var published: list[bool] = []

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        published.append(oper is not None)

    def check() -> None:
        if _cleared_last(published):
            t.success()
        else:
            t.failure(ValueError("published {published}"))

    names = ["cpe-1", "cpe-2"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    campaign.on_subscriptions_synced()
    # cpe-1's state goes, a member change like any other.
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), None, None)
    campaign.shutdown()
    # Closing the subscriptions fires a sync that is still pending.
    campaign.on_subscriptions_synced()
    after float(cfs.campaign_debounce_s(len(names))) + 0.5: check()


actor _test_deleted_running_campaign_stops_deciding(t: testing.AsyncT):
    """A deleted running campaign clears its state, and a member change
    after the delete does not make it decide again."""
    var published: list[bool] = []

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        published.append(oper is not None)

    def check() -> None:
        if _cleared_last(published):
            t.success()
        else:
            t.failure(ValueError("published {published}"))

    names = ["cpe-1", "cpe-2"]
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(_paced_campaign(names), _with_nightly(_flat_inventory(names)).to_gdata())
    campaign.on_subscriptions_synced()
    campaign.shutdown()
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), None, None)
    after float(cfs.campaign_debounce_s(len(names))) + 0.5: check()


actor _SubscriptionLog():
    """The owner ids declared to and removed from a _LoggingTreeProvider;
    each declaration syncs at once."""
    var declared: list[str] = []
    var removed: list[str] = []

    def declare(owner_id: str, synced: ?action(str) -> None) -> None:
        declared.append(owner_id)
        if synced is not None:
            synced(owner_id)

    def remove(owner_id: str) -> None:
        removed.append(owner_id)

    def owners() -> (list[str], list[str]):
        return (list(declared), list(removed))


class _LoggingTreeProvider(gdata.TreeProvider):
    log: _SubscriptionLog

    def __init__(self, log: _SubscriptionLog):
        self.log = log

    proc def rpc(self, cb: action(?gdata.Node, ?Exception) -> None, gdata_rpc: gdata.Node):
        cb(None, ValueError("no RPC"))

    proc def declare_subscriptions(self, owner_id: str, cb: action(?gdata.Node, ?Exception) -> None, want: set[gdata.SubscriptionSpec], synced: ?action(str) -> None=None):
        self.log.declare(owner_id, synced)

    proc def remove_subscriptions(self, owner_id: str):
        self.log.remove(owner_id)


actor _test_recreated_campaign_keeps_its_subscription(t: testing.AsyncT):
    """A campaign deleted and one created again under the same name declare
    subscriptions of their own, so the delete of the old one removes only
    its own, also when it comes after the new one has subscribed."""
    log = _SubscriptionLog()
    names = ["cpe-1", "cpe-2"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    old = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda o: None,
                                       _LoggingTreeProvider(log))
    old.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    new = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, lambda o: None,
                                       _LoggingTreeProvider(log))
    new.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())

    def check() -> None:
        declared, removed = log.owners()
        kept = [d for d in declared if d not in removed]
        if len(removed) == 0:
            after 0.05: check()
        elif len(set(declared)) == 2 and len(removed) == 1 and len(kept) == 1:
            t.success()
        else:
            t.failure(ValueError("declared {declared}, removed {removed}"))

    def delete_old() -> None:
        if len(log.owners().0) < 2:
            after 0.05: delete_old()
        else:
            old.shutdown()
            check()

    delete_old()


actor _test_campaign_device_status_verdicts(t: testing.AsyncT):
    """Each device's stage, reason, prepare and check verdicts reach the
    campaign next to its status, as its flotilla reports them. A device not
    heard from has none."""
    var done = False

    def row(o: y0_oper.software__software__upgrade_campaign_entry, name: str) -> str:
        r = o.state.device_status.get(name)
        if r is not None:
            prep = r.prepare
            pre = r.precheck
            post = r.postcheck
            return ("{name} {r.status} {r.stage} ({r.reason}), "
                    + "prepare {prep.state} {prep.release} {prep.started} {prep.ended} ({prep.message}), "
                    + "pre {pre.verdict} {pre.detail} {pre.at}, post {post.verdict} {post.detail} {post.at}")
        return "{name} missing"

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        first = o.state.device_status.get("cpe-1")
        # The first publication comes before the device states.
        if first is not None:
            if first.precheck.verdict is not None:
                done = True
                got = [row(o, "cpe-1"), row(o, "cpe-2"), row(o, "cpe-3"), row(o, "cpe-4")]
                want = [
                    "cpe-1 rolled-back rollback (post-check failed: rfs-device-health: not back to the baseline), "
                    + "prepare None None None None (None), "
                    + "pre pass rfs-device-health: 1/1 sessions established 2026-10-07T12:00:00Z, "
                    + "post fail rfs-device-health: not back to the baseline 2026-10-07T12:12:00Z",
                    "cpe-2 failed precheck (pre-check failed: did not answer: rfs-device-health), "
                    + "prepare None None None None (None), "
                    + "pre fail did not answer: rfs-device-health 2026-10-07T12:01:00Z, post not-run None None",
                    "cpe-3 pending None (None), prepare None None None None (None), "
                    + "pre None None None, post None None None",
                    "cpe-4 upgrade-needed None (None), "
                    + "prepare failed 17.18.03a 2026-10-07T11:00:00Z 2026-10-07T11:02:10Z "
                    + "(copy failed: no space left on bootflash:), "
                    + "pre None None None, post None None None",
                ]
                if got != want:
                    t.failure(ValueError("device-status: {got}"))
                else:
                    t.success()

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    names = ["cpe-1", "cpe-2", "cpe-3", "cpe-4"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())

    rolled_back = y1_oper.stratoweave_rfs__rfs__device__state(
        status="rolled-back", upgrade_campaign="paced", target_release="17.18.03a",
        stage="rollback",
        reason="post-check failed: rfs-device-health: not back to the baseline")
    rolled_back.precheck.verdict = "pass"
    rolled_back.precheck.detail = "rfs-device-health: 1/1 sessions established"
    rolled_back.precheck.at = "2026-10-07T12:00:00Z"
    rolled_back.postcheck.verdict = "fail"
    rolled_back.postcheck.detail = "rfs-device-health: not back to the baseline"
    rolled_back.postcheck.at = "2026-10-07T12:12:00Z"
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), rolled_back, None)

    refused = y1_oper.stratoweave_rfs__rfs__device__state(
        status="failed", upgrade_campaign="paced", target_release="17.18.03a",
        stage="precheck",
        reason="pre-check failed: did not answer: rfs-device-health")
    refused.precheck.verdict = "fail"
    refused.precheck.detail = "did not answer: rfs-device-health"
    refused.precheck.at = "2026-10-07T12:01:00Z"
    refused.postcheck.verdict = "not-run"
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-2"), device_name="cpe-2"), refused, None)

    not_prepared = _tagged_prepare("upgrade-needed", "paced", "17.18.03a", "failed", "17.18.03a")
    not_prepared.prepare.started = "2026-10-07T11:00:00Z"
    not_prepared.prepare.ended = "2026-10-07T11:02:10Z"
    not_prepared.prepare.message = "copy failed: no space left on bootflash:"
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-4"), device_name="cpe-4"), not_prepared, None)

    # The replay is in. A campaign in plan publishes once it is synced.
    campaign.on_subscriptions_synced()
    after 2.0: fail("the campaign published no verdicts")


actor _test_campaign_not_running_publishes_changes(t: testing.AsyncT):
    """A campaign that does not decide, here one in plan, still publishes
    what its members report after it has synced."""
    var last = "nothing"

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None:
            r = oper!.state.device_status.get("cpe-1")
            last = r.status if r is not None and r.status is not None else "missing"

    def check() -> None:
        if last == "in-progress":
            t.success()
        else:
            t.failure(ValueError("cpe-1 published as {last}"))

    names = ["cpe-1", "cpe-2"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    campaign.on_subscriptions_synced()
    # cpe-1 starts its upgrade, as when a stopped campaign's released
    # device carries on.
    status = y1_oper.stratoweave_rfs__rfs__device__state(
        status="in-progress", upgrade_campaign="paced", target_release="17.18.03a")
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), status, None)
    after float(cfs.campaign_debounce_s(len(names))) + 0.5: check()


actor _test_campaign_platform_change_publishes_nothing(t: testing.AsyncT):
    """A member's state that changes only in what the campaign does not
    show, here the serial number, and a device outside the campaign
    publish nothing."""
    var publications = 0

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        publications += 1

    def state(serial: str) -> y1_oper.stratoweave_rfs__rfs__device__state:
        s = y1_oper.stratoweave_rfs__rfs__device__state(status="unknown")
        s.platform.version = "17.18.2"
        s.platform.model = "C8000V"
        s.platform.serial_number = serial
        return s

    names = ["cpe-1", "cpe-2"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), state("9ABCDEFGHIJ"), None)
    campaign.on_subscriptions_synced()

    def quiet(seen: int) -> None:
        if publications == seen:
            t.success()
        else:
            t.failure(ValueError("published again"))

    def unchanged() -> None:
        seen = publications
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"), state("9KSKL403GG7"), None)
        campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-9"), device_name="cpe-9"), state("9ABCDEFGHIJ"), None)
        after float(cfs.campaign_debounce_s(len(names))) + 0.5: quiet(seen)

    # The publications of the conf and the sync are in.
    after 0.2: unchanged()


actor _test_campaign_device_status_platform(t: testing.AsyncT):
    """Each device's version and model reach the campaign with its state,
    also when one of them changes alone after a campaign in plan has
    published. A device not heard from has neither."""
    want = ["cpe-1 17.18.2 C8300-1N1S-4T2X", "cpe-2 17.18.3a ISR4331/K9", "cpe-3 None None"]
    var last: list[str] = []

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None:
            got = []
            for name in ["cpe-1", "cpe-2", "cpe-3"]:
                r = oper!.state.device_status.get(name)
                if r is not None:
                    got.append("{name} {r.version} {r.model}")
                else:
                    got.append("{name} missing")
            last = got

    def check() -> None:
        if last == want:
            t.success()
        else:
            t.failure(ValueError("platforms not published: {last}"))

    names = ["cpe-1", "cpe-2", "cpe-3"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())

    def report(name: str, version: str, model: str) -> None:
        s = y1_oper.stratoweave_rfs__rfs__device__state(status="unknown")
        s.platform.version = version
        s.platform.model = model
        campaign.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), s, None)

    report("cpe-1", "17.18.2", "C8000V")
    report("cpe-2", "17.18.2", "ISR4331/K9")
    # The replay is in. A campaign in plan publishes once it is synced.
    campaign.on_subscriptions_synced()
    # cpe-1 is a new box; cpe-2 is upgraded by hand.
    report("cpe-1", "17.18.2", "C8300-1N1S-4T2X")
    report("cpe-2", "17.18.3a", "ISR4331/K9")
    after float(cfs.campaign_debounce_s(len(names))) + 0.5: check()


def _render_layout(header: str, layout: list[(str, int, int, list[(str, int, int)])],
                   alarms: list[str]) -> str:
    """The materialized layout as the review artefact: per window, each
    device with its estimated start offset."""
    lines = [header]
    for win in layout:
        wend = "open" if win.2 == cfs.OPEN_END else "+{win.2}s"
        lines.append("")
        lines.append("window {win.0}: +{win.1}s to {wend}")
        counts: dict[int, int] = {}
        for entry in win.3:
            counts[entry.2] = counts.get_def(entry.2, 0) + 1
        mode = 0
        best = 0
        for dur, cnt in counts.items():
            if cnt > best:
                best = cnt
                mode = dur
        offset = -1
        names: list[str] = []
        for entry in win.3:
            if entry.1 != offset and len(names) > 0:
                lines.append("  +{offset:4d}s " + " ".join(names))
                names = []
            offset = entry.1
            # A device whose duration differs from the window's usual one
            # is marked, so a mixed fleet is visible in the record.
            names.append(entry.0 if entry.2 == mode else "{entry.0}({entry.2}s)")
        if len(names) > 0:
            lines.append("  +{offset:4d}s " + " ".join(names))
    for alarm in alarms:
        lines.append("")
        lines.append("ALARM: {alarm}")
    return "\n".join(lines)


def _test_snapshot_plan_estimates():
    """Estimated starts are the controller's own predicted launches: the
    ramp from one device, three more for each device done without a
    failure, up to the target of four, not an even spread."""
    campaign = InputCampaign(
        name="ramped",
        admin_state="plan",
        target_concurrency=u64(4),
        max_concurrency=u64(8),
    )
    names = []
    for i in range(10):
        campaign.device.create("dev-{i}", image=IMAGE)
        names.append("dev-{i}")
    layout, alarms, conc = _plan(campaign, _flat_inventory(names), 0)
    return _render_layout("10 mock devices, no windows, target 4, max 8 at once: "
                          + "4s nominal estimates, ramp to 4 in flight",
                          layout, alarms)

def _test_campaign_debounce_scales_with_members():
    testing.assertEqual(cfs.campaign_debounce_s(10), 1)
    testing.assertEqual(cfs.campaign_debounce_s(100), 1)
    testing.assertEqual(cfs.campaign_debounce_s(1000), 1)
    testing.assertEqual(cfs.campaign_debounce_s(10000), 10)
    testing.assertEqual(cfs.campaign_debounce_s(100000), 30)


def _test_snapshot_plan_estimates_slow_devices():
    """The same fleet with a configured 8s mock upgrade duration: the
    estimate comes from the device config, so the starts stretch to
    match."""
    campaign = InputCampaign(
        name="ramped",
        admin_state="plan",
        target_concurrency=u64(8),
        max_concurrency=u64(16),
    )
    names = []
    for i in range(10):
        campaign.device.create("dev-{i}", image=IMAGE)
        names.append("dev-{i}")
    layout, alarms, conc = _plan(campaign, _flat_inventory(names, upgrade_duration=8), 0)
    return _render_layout("10 mock devices at a configured 8s duration, "
                          + "target 8, max 16 at once",
                          layout, alarms)


def _test_snapshot_plan_estimates_mixed_fleet():
    """Nine quick mocks and one real device: the prediction runs the
    controller over the true mixture, so the ramp advances on the mock
    completions and the slow device rides a late wave, marked with its
    own duration."""
    campaign = InputCampaign(
        name="mixed",
        admin_state="plan",
        target_concurrency=u64(8),
        max_concurrency=u64(16),
    )
    linked = _flat_inventory(["dev-{i}" for i in range(9)])
    real = linked.fleet.device.create(
        "dev-real", type="iosxe",
        credentials=InputCredentials(username="admin"))
    for i in range(9):
        campaign.device.create("dev-{i}", image=IMAGE)
    campaign.device.create("dev-real", image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    return _render_layout("nine 4s mocks and one real device at the adapter's "
                          + "395s nominal, target 8, max 16 at once",
                          layout, alarms)


actor _test_campaign_deadline_honors_ramp_up(t: testing.AsyncT):
    """A deadline the steady-state division calls makeable but the ramp
    cannot make: ten 8 s devices before a deadline at 36 s. A device
    starts only while 12 s, one and a half upgrades, are left, so there is
    time for three rounds, at 0, 9 and 18 s. At four at once the ramp
    starts 1, 4 and 4, so they need five at once, and max is four. The
    plan alarms."""
    names = []
    for i in range(10):
        names.append("r{i}")
    campaign = InputCampaign(
        name="tight",
        admin_state="plan",
        deadline=u64(36),
        target_concurrency=u64(1),
        max_concurrency=u64(4),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, _flat_inventory(names, upgrade_duration=8), 0)
    testing.assertEqual(alarms, ["1 device(s) cannot start before the deadline even at "
                                 + "max-concurrency 4: r9"])
    testing.assertEqual(conc, 4)
    t.success()


actor _test_campaign_estimate_from_the_adapter(t: testing.AsyncT):
    """A device without mock config plans at the IOS XE adapter's nominal
    duration; a mocked one at its configured duration."""
    linked = y_0.root()
    real = linked.fleet.device.create(
        "real-1", type="iosxe",
        credentials=InputCredentials(username="admin"))
    mocked = linked.fleet.device.create(
        "mock-1", type="iosxe",
        credentials=InputCredentials(username="admin"))
    mocked.mock.enabled = True
    mocked.mock.software.upgrade_duration = u64(120)
    campaign = InputCampaign(
        name="mixed",
        admin_state="plan",
    )
    campaign.device.create("real-1", image=IMAGE)
    campaign.device.create("mock-1", image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    ests: dict[str, int] = {}
    for win in layout:
        for entry in win.3:
            ests[entry.0] = entry.2
    testing.assertEqual(ests.get_def("real-1", 0), 395,
                        "a real device plans at the adapter's nominal duration")
    testing.assertEqual(ests.get_def("mock-1", 0), 120,
                        "a mocked device plans at its configured duration")
    t.success()


def _test_window_open_since_yesterday_is_an_occurrence():
    """A window that opens at 23:00 for 4 h is still open at 01:00 the next
    day, so it is the first occurrence then."""
    linked = y_0.root()
    linked.schedules.schedule.create("late").window.create(u64(23 * 3600), duration=u64(4 * 3600))
    sched = linked.schedules.schedule.get("late")
    if sched is not None:
        testing.assertEqual(cfs.occurrences(sched, 86400 + 3600)[0],
                            (23 * 3600, 27 * 3600))
    else:
        testing.assertTrue(False, "the schedule must exist")


def _test_campaign_open_window_takes_only_its_rest():
    """A window opened 3.5 h ago with 30 min left takes the two 10 min
    devices that fit at one at a time; the rest go to tomorrow's window."""
    names = ["o{i}" for i in range(6)]
    linked = _flat_inventory(names, upgrade_duration=600)
    linked.schedules.schedule.create("day").window.create(u64(0), duration=u64(14400))
    campaign = InputCampaign(
        name="late",
        admin_state="plan",
        default_schedule="day",
        target_concurrency=u64(1),
        max_concurrency=u64(1),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 12600)
    by_start: dict[int, list[str]] = {}
    for win in layout:
        by_start[win.1] = sorted([entry.0 for entry in win.3])
    testing.assertEqual(by_start.get_def(0, []), ["o0", "o1"],
                        "the open window keeps its real start and takes what fits")
    testing.assertEqual(by_start.get_def(86400, []), ["o2", "o3", "o4", "o5"],
                        "the rest go to tomorrow")
    testing.assertEqual(alarms, [], None)


def _daily_campaign(name: str, devices: int, deadline: ?int, target: int,
                    maxc: int, stagger: ?int=0) -> (InputCampaign, y_0.root):
    """devices 10 min devices d0, d1, ... in a 1 h window every day, at
    the stagger, by default none, so that the starts of a round go
    together. A stagger of None leaves the campaign's default."""
    names = ["d{i}" for i in range(devices)]
    linked = _flat_inventory(names, upgrade_duration=600)
    linked.schedules.schedule.create("day").window.create(u64(0), duration=u64(3600))
    campaign = InputCampaign(
        name=name,
        admin_state="plan",
        default_schedule="day",
        target_concurrency=u64(target),
        max_concurrency=u64(maxc),
    )
    if deadline is not None:
        campaign.deadline = u64(deadline)
    if stagger is not None:
        campaign.stagger = u64(stagger)
    for n in names:
        campaign.device.create(n, image=IMAGE)
    return (campaign, linked)


def _window_sizes(layout: list[(str, int, int, list[(str, int, int)])]) -> list[int]:
    return [len(win.3) for win in layout]


def _test_campaign_window_takes_what_the_ramp_starts():
    """100 devices of 10 min, a 1 h window every day, 10 at once. The
    first window ramps 1, 4, 10, 10, 10 and has no time for a sixth
    round: it takes 35. The ramp belongs to the campaign, so the next
    window runs five rounds of 10 and takes 50, and the third the last
    15."""
    campaign, linked = _daily_campaign("ramp", 100, None, 10, 10)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(_window_sizes(layout), [35, 50, 15])
    testing.assertEqual([win.1 for win in layout], [0, 86400, 172800])
    testing.assertEqual(alarms, [])
    testing.assertEqual(conc, 10)


def _test_campaign_close_margin_reaches_the_controller():
    """The campaign's close-margin sets how late in a window a device
    starts. The same 100 devices of 10 min, a 1 h window every day, 10 at
    once. Each round starts one second, the debounce, after the round
    before ends, so the rounds of a window start at 0, 601, 1202, 1803 and
    2404 s. At the default of 150 percent a device starts while 900 s are
    left, up to 2700 s: all five rounds fit, and the windows take 35, 50
    and 15. At 200 percent it starts while 1200 s are left, up to 2400 s:
    the fifth round does not fit, so the first window takes 1, 4, 10 and
    10, 25, the second four rounds of 10, 40, and the third the last 35."""
    # (the campaign's close-margin, or None for the default, and the
    # number of devices in each window)
    cases: list[(?int, list[int])] = [
        (None, [35, 50, 15]),
        (200, [25, 40, 35]),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("margin", 100, None, 10, 10)
        margin = case.0
        if margin is not None:
            campaign.close_margin = u64(margin)
        layout, alarms, conc = _plan(campaign, linked, 0)
        testing.assertEqual(_window_sizes(layout), case.1, str(margin))
        testing.assertEqual(alarms, [], str(margin))


def _test_campaign_stagger_reaches_the_controller():
    """The campaign's stagger spreads the starts. The same 100 devices of
    10 min, a 1 h window every day, 10 at once. The second window opens
    with room for 10 devices: at the default of 25 percent they start over
    a quarter of an upgrade, one every 15 s; at 100 percent over one
    upgrade, one a minute; at 0 all at once."""
    # (the campaign's stagger, or None for the default, and the planned
    # starts of the first three devices in the second window)
    cases: list[(?int, list[int])] = [
        (None, [86400, 86415, 86430]),
        (100, [86400, 86460, 86520]),
        (0, [86400, 86400, 86400]),
    ]
    for case in cases:
        stagger = case.0
        campaign, linked = _daily_campaign("stagger", 100, None, 10, 10, stagger)
        layout, alarms, conc = _plan(campaign, linked, 0)
        starts = sorted([entry.1 for entry in layout[1].3])
        testing.assertEqual(starts[:3], case.1, str(stagger))
        testing.assertEqual(alarms, [], str(stagger))


def _test_campaign_deadline_raises_the_planned_concurrency():
    """The same fleet with a deadline at the end of the second window. At
    11 at once the two windows take 38 and 55, seven short; at 12 they
    take 41 and 59, so the plan runs at 12."""
    campaign, linked = _daily_campaign("deadline", 100, 86400 + 3600, 10, 50)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(conc, 12)
    testing.assertEqual(_window_sizes(layout), [41, 59])
    testing.assertEqual(alarms, [])


def _test_campaign_replan_keeps_the_ramp():
    """The fleet with the deadline, run through the first window on the
    estimates and planned again between the windows. The run's ramp is
    at 12, so the second window still takes its 59 at 12 at once. A plan
    that ramped from one again would need 19 at once."""
    campaign, linked = _daily_campaign("deadline", 100, 86400 + 3600, 10, 50)
    campaign.admin_state = "run"
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    sim.drive(ctl, 0, {}, 50000)
    cfs.configure_campaign(ctl, campaign, linked, 50000)
    p = ctl.plan(50000)
    testing.assertEqual(_window_sizes(ctl.layout(p)), [41, 59])
    testing.assertEqual(p.alarms, [])
    testing.assertEqual(p.c, 12)


def _test_campaign_long_device_waits_for_a_window_it_fits():
    """Two devices of 30 min and ten of 1 min share a 1 h window every day,
    one at a time. The first long device fills half the window, and the
    second does not fit in the half left, so it goes to the next day,
    and the short ones take the rest of the first window."""
    linked = y_0.root()
    linked.schedules.schedule.create("day").window.create(u64(0), duration=u64(3600))
    names: list[str] = []
    for group in [("a", 2, 1800), ("b", 10, 60)]:
        for i in range(group.1):
            name = "{group.0}{i}"
            dev = linked.fleet.device.create(name, type="iosxe",
                                             credentials=InputCredentials(username="admin"))
            dev.mock.enabled = True
            dev.mock.software.upgrade_duration = u64(group.2)
            names.append(name)
    campaign = InputCampaign(
        name="long",
        admin_state="plan",
        default_schedule="day",
        target_concurrency=u64(1),
        max_concurrency=u64(1),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    by_start: dict[int, list[str]] = {}
    for win in layout:
        by_start[win.1] = sorted([entry.0 for entry in win.3])
    testing.assertEqual(by_start.get_def(0, []),
                        ["a0", "b0", "b1", "b2", "b3", "b4", "b5", "b6", "b7", "b8", "b9"])
    testing.assertEqual(by_start.get_def(86400, []), ["a1"])
    testing.assertEqual(alarms, [])


def _test_campaign_device_without_a_window_keeps_the_concurrency():
    """A device bound to a schedule that opens only after the deadline fits
    no window at any concurrency. The other 99 fit at 10 at once, so the
    plan stays at 10 and only that device raises an alarm."""
    campaign, linked = _daily_campaign("unfit", 100, 2 * 86400 + 3600, 10, 50)
    sunday = linked.schedules.schedule.create("sunday").window.create(u64(0),
                                                                     duration=u64(3600))
    sunday.day = ["sun"]
    _bind(linked, "d99", "sunday")
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(conc, 10)
    testing.assertEqual(_window_sizes(layout), [35, 50, 14])
    testing.assertEqual(alarms, ["1 device(s) cannot start before the deadline: d99"])


def _test_campaign_deadline_beyond_the_horizon_keeps_the_concurrency():
    """500 devices that need more windows than the planner looks ahead,
    and a deadline 30 days out. The planner does not see the windows
    that reach the deadline, so it does not raise the concurrency for
    it."""
    campaign, linked = _daily_campaign("far", 500, 30 * 86400, 10, 50)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(conc, 10)
    testing.assertEqual(len(alarms), 1)
    testing.assertTrue(alarms[0].startswith("65 device(s) are in no window yet: "), alarms[0])


def _bind(linked: y_0.root, name: str, schedule: str) -> None:
    dev = linked.fleet.device.get(name)
    if dev is not None:
        dev.schedule = schedule


actor _test_campaign_devices_follow_their_own_schedule(t: testing.AsyncT):
    """A bound device lands only in its own schedule's windows; unbound
    members follow the campaign default."""
    linked = _flat_inventory(["n1", "w1", "w2"])
    sch = linked.schedules.schedule.create("night")
    sch.window.create(u64(0), duration=u64(3600))
    wk = linked.schedules.schedule.create("weekend")
    wk.window.create(u64(3600), duration=u64(3600))
    _bind(linked, "w1", "weekend")
    _bind(linked, "w2", "weekend")
    campaign = InputCampaign(
        name="split",
        admin_state="plan",
        default_schedule="night",
    )
    for name in ["n1", "w1", "w2"]:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(len(alarms), 0, None)
    testing.assertEqual(_window_names(layout, "night"), ["n1"],
                        "the unbound member follows the campaign default")
    testing.assertEqual(_window_names(layout, "weekend"), ["w1", "w2"],
                        "bound members use their own schedule")
    t.success()


def _test_snapshot_plan_two_schedules():
    """The layout across two schedules: five nightly devices ramp from
    one in the first window. The ramp belongs to the campaign, so the five
    weekend bound devices in the later window start at once, at the eight
    it reached, spread by the default stagger."""
    linked = _flat_inventory(["n0", "n1", "n2", "n3", "n4",
                              "w0", "w1", "w2", "w3", "w4"], upgrade_duration=8)
    sch = linked.schedules.schedule.create("night")
    sch.window.create(u64(0), duration=u64(3600))
    wk = linked.schedules.schedule.create("weekend")
    wk.window.create(u64(7200), duration=u64(3600))
    for name in ["w0", "w1", "w2", "w3", "w4"]:
        _bind(linked, name, "weekend")
    campaign = InputCampaign(
        name="split",
        admin_state="plan",
        default_schedule="night",
        target_concurrency=u64(8),
        max_concurrency=u64(16),
    )
    for name in ["n0", "n1", "n2", "n3", "n4", "w0", "w1", "w2", "w3", "w4"]:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    return _render_layout("two schedules, ten 8s devices, half bound to the "
                          + "weekend window at +2h",
                          layout, alarms)


def _layout_lines(layout: list[(str, int, int, list[(str, int, int)])]) -> list[str]:
    """One line per window, each device at its start."""
    lines = []
    for win in layout:
        devs = ["{entry.0}@{entry.1}" for entry in win.3]
        lines.append("{win.0}@{win.1}: " + " ".join(devs))
    return lines


def _test_released_device_keeps_a_closed_window():
    """A device released in last night's window stays there at its real
    start after the window closed; the waiting one goes to tonight's."""
    linked = _with_nightly(_flat_inventory(["cpe-1", "cpe-2"]))
    campaign = _paced_campaign(["cpe-1", "cpe-2"])
    ctl = _replanned(campaign, linked, 1000)
    p = ctl.plan(1000)
    testing.assertEqual(_layout_lines(ctl.layout(p)),
                        ["nightly@0: cpe-1@10", "nightly@86400: cpe-2@86400"])
    testing.assertEqual(p.alarms, [])


def _test_mixed_fleet_runs_its_plan_without_alarm():
    """200 devices of 30 s bound to a 20 minute window and 20 of 1800 s
    bound to a 4 h window plan without alarms. Started the way the
    campaign actor starts a run, the controller's first decision starts
    the ramp's one device and raises no alarm either: it judges each
    device by its own estimate, not by the campaign's average of 191 s."""
    linked = y_0.root()
    linked.schedules.schedule.create("fast").window.create(u64(0), duration=u64(1200))
    linked.schedules.schedule.create("slow").window.create(u64(0), duration=u64(14400))
    names: list[str] = []
    # (name prefix, devices, upgrade duration, schedule)
    for group in [("f", 200, 30, "fast"), ("s", 20, 1800, "slow")]:
        for i in range(group.1):
            name = "{group.0}{i}"
            dev = linked.fleet.device.create(name, type="iosxe",
                                             credentials=InputCredentials(username="admin"))
            dev.mock.enabled = True
            dev.mock.software.upgrade_duration = u64(group.2)
            dev.schedule = group.3
            names.append(name)
    campaign = InputCampaign(
        name="mixed",
        admin_state="run",
        target_concurrency=u64(10),
        max_concurrency=u64(20),
    )
    for name in names:
        campaign.device.create(name, image=IMAGE)
    layout, alarms, conc = _plan(campaign, linked, 0)
    testing.assertEqual(alarms, [])
    testing.assertEqual(conc, 10)
    testing.assertEqual(cfs.estimated_duration(campaign, linked), 191)
    ctl = fctl.Controller()
    cfs.configure_campaign(ctl, campaign, linked, 0)
    sim.answer_all(ctl, 0)
    ctl.start()
    s = ctl.decide(0)
    testing.assertEqual(s.started, ["f0"])
    testing.assertEqual(s.plan.alarms, [])


def _window_start_of(layout: list[(str, int, int, list[(str, int, int)])], name: str) -> int:
    """The start of the window the layout puts the device name in, or -1."""
    for win in layout:
        for entry in win.3:
            if entry.0 == name:
                return win.1
    return -1


def _test_campaign_upgrades_a_redundancy_group_in_order():
    """30 devices of 10 min, a 1 h window every day, 4 at once: the plan
    uses the first two windows. d0 and d1 back each other up. d1 has the
    default priority, lower than d0's, so d1 goes first. A group with no
    entry spreads: d0 goes in the second window. A pack group starts d0
    in the first window, after d1, or with a min-separation of 1 h in the
    second window."""
    # (the group's separation-policy, or None for no entry, its
    # min-separation, and the windows of d1 and d0)
    cases: list[(?str, int, (int, int))] = [
        (None, 0, (0, 86400)),
        ("spread", 0, (0, 86400)),
        ("pack", 0, (0, 0)),
        ("pack", 3600, (0, 86400)),
    ]
    for case in cases:
        campaign, linked = _daily_campaign("pair", 30, None, 4, 4)
        d0 = linked.fleet.device.get("d0")!
        d0.redundancy_group = ["core"]
        d0.redundancy_priority = u64(200)
        d1 = linked.fleet.device.get("d1")!
        d1.redundancy_group = ["core"]
        policy = case.0
        if policy is not None:
            linked.redundancy_groups.redundancy_group.create("core", separation_policy=policy,
                                                             min_separation=u64(case.1))
        layout, alarms, conc = _plan(campaign, linked, 0)
        testing.assertEqual((_window_start_of(layout, "d1"), _window_start_of(layout, "d0")),
                            case.2, str(policy) + " " + str(case.1))
        testing.assertEqual(alarms, [])


def _test_closed_window_takes_no_new_devices():
    """Planned while tonight's window is open, last night's window still
    holds only the device released in it. The waiting device is placed
    once, in tonight's window, with no false overflow."""
    linked = _with_nightly(_flat_inventory(["cpe-1", "cpe-2"]))
    campaign = _paced_campaign(["cpe-1", "cpe-2"])
    ctl = _replanned(campaign, linked, 86500)
    p = ctl.plan(86500)
    testing.assertEqual(_layout_lines(ctl.layout(p)),
                        ["nightly@0: cpe-1@10", "nightly@86400: cpe-2@86500"])
    testing.assertEqual(p.alarms, [])


actor _test_campaign_replan_keeps_released_devices(t: testing.AsyncT):
    """Run a campaign one device at a time, let two finish, then raise
    target-concurrency to two. The replan keeps the finished devices in
    their window with started and finished, and predicts the waiting ones
    from the device in flight instead of behind the finished ones. The
    ramp is at one device, because the run went one at a time, and it
    grows only when a device is done without a failure: d3 does not
    start at the replan. d3 starts when d2 is expected to finish, and d4
    at most a second later: at the default stagger, the two start over
    one upgrade at the observed pace. The plan expects the pace the run
    observed: d0 and d1 report done right away, so d2 is expected to
    finish before its 600 s estimate."""
    names = ["d0", "d1", "d2", "d3", "d4"]
    linked = _flat_inventory(names, upgrade_duration=600)
    ns = y0_oper.NS_software
    path = ttt.PathKey("replan",
                       ttt.PathElem(gdata.Id(ns, "upgrade-campaign"),
                                    ttt.PathElem(gdata.Id(ns, "software"), ttt.PathRoot("root"))),
                       {gdata.Id(ns, "name"): gdata.Leaf("replan")})
    var controller: ?cfs.UpgradeCampaignTransform = None
    var seen: set[str] = set()
    var ready = False
    var replanned = False
    var done = False

    def campaign(conc: int) -> InputCampaign:
        cp = InputCampaign(
            name="replan",
            admin_state="run",
            target_concurrency=u64(conc),
            max_concurrency=u64(conc),
        )
        for name in names:
            cp.device.create(name, image=IMAGE)
        return cp

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            state = y1_oper.stratoweave_rfs__rfs__device__state(
                status=status, upgrade_campaign="replan", target_release="17.18.03a")
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name), state, None)

    def finish(name: str) -> None:
        report(name, "succeeded")

    def replan() -> None:
        cc = controller
        if cc is not None:
            # Arm the check when submitting the new configuration, after
            # the publication belonging to d2's release has completed.
            replanned = True
            cc.on_conf(campaign(2), linked.to_gdata())

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is not None and not done:
            if replanned:
                done = True
                check(oper)

    def on_output(conf: gdata.Node):
        # A device in flight has no veto. A device that is done has it
        # again, so seen keeps every device released so far.
        for flotilla in y_1.root.from_gdata(conf).rfs:
            for d in flotilla.device:
                if d.software.veto.get(cfs.veto_holder("replan")) is None:
                    seen.add(d.name)
        if seen == {"d0"}:
            after 0.0: finish("d0")
        elif seen == {"d0", "d1"}:
            after 0.0: finish("d1")
        elif seen == {"d0", "d1", "d2"} and not ready:
            # Output is delivered asynchronously, after this decision's
            # oper publication. Queue the replan here; on_conf emits
            # this same released set again, so request it only once.
            ready = True
            after 0.0: replan()

    def check(oper: y0_oper.software__software__upgrade_campaign_entry) -> None:
        window: dict[str, str] = {}
        started: dict[str, int] = {}
        finished: dict[str, int] = {}
        estimated: dict[str, int] = {}
        for win in oper.state.plan.window:
            for dev in win.device:
                window[dev.name] = "{win.schedule}@{win.start}"
                s = dev.started
                if s is not None:
                    started[dev.name] = int(s)
                f = dev.finished
                if f is not None:
                    finished[dev.name] = int(f)
                e = dev.estimated_start
                if e is not None:
                    estimated[dev.name] = int(e)
        if window.get_def("d0", "") != "default@0" or window.get_def("d1", "") != "default@0":
            t.failure(ValueError("finished devices left their window: {window}"))
        elif "d0" not in started or "d0" not in finished or \
             "d1" not in started or "d1" not in finished:
            t.failure(ValueError("finished devices lost started or finished"))
        elif "d2" not in started or "d2" in finished:
            t.failure(ValueError("d2 must be in flight"))
        elif "d3" in started:
            t.failure(ValueError("d3 must wait for d2, as the ramp is at one: {started}"))
        elif estimated.get_def("d3", 0) <= started["d2"] or \
             estimated.get_def("d3", 0) >= started["d2"] + 600 or \
             estimated.get_def("d4", 0) < estimated.get_def("d3", 0) or \
             estimated.get_def("d4", 0) > estimated.get_def("d3", 0) + 1:
            t.failure(ValueError("d3 must start when d2 is expected to finish, at the "
                                 + "observed pace, and d4 at most a second later: "
                                 + "{estimated} {started}"))
        else:
            t.success()

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("no plan after the replan"))

    ctl = cfs.UpgradeCampaignTransform(path, on_output, on_oper, None)
    controller = ctl
    # One device at a time.
    ctl.on_conf(campaign(1), linked.to_gdata())
    # Every member has read its release and needs the upgrade.
    for name in names:
        report(name, "upgrade-needed")
    ctl.on_subscriptions_synced()
    after 5.0: timeout()


def _intents(out: gdata.Node) -> list[str]:
    """Each device in out, the output of a campaign, as "name campaign
    target URL [veto holders]", sorted."""
    lines: list[str] = []
    for flotilla in y_1.root.from_gdata(out).rfs:
        for dev in flotilla.device:
            sw = dev.software
            holders = ",".join([v.holder for v in sw.veto])
            lines.append("{dev.name} {sw.upgrade_campaign} {sw.target_release} {sw.image_url} [{holders}]")
    return sorted(lines)


def _tagged(status: str, campaign: ?str, target: ?str) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """A device state with status, which answers the intent of campaign
    with the target release target."""
    return y1_oper.stratoweave_rfs__rfs__device__state(
        status=status, upgrade_campaign=campaign, target_release=target)


def _tagged_prepare(status: str, campaign: ?str, target: ?str, state: ?str,
                    release: ?str) -> y1_oper.stratoweave_rfs__rfs__device__state:
    """A device state with status, which answers the intent of campaign
    with the target release target, and a prepare in state of release."""
    s = _tagged(status, campaign, target)
    s.prepare.state = state
    s.prepare.release = release
    return s


def _with_version(linked: y_0.root, version: str) -> y_0.root:
    """linked with version as the version of IMAGE."""
    image = linked.images.image.get(IMAGE)
    if image is not None:
        image.version = version
    return linked


actor _test_campaign_writes_its_intent_in_plan(t: testing.AsyncT):
    """A campaign in plan writes the intent of every member at once: the
    campaign's name, the target release, the image URL and the campaign's
    veto."""
    var done = False

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        done = True
        got = _intents(out)
        want = ["{name} paced 17.18.03a {URL_BASE}{IMAGE} [campaign:paced]"
                for name in ["cpe-1", "cpe-2", "cpe-3"]]
        if got == want:
            t.success()
        else:
            t.failure(ValueError("output: {got}"))

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("the campaign wrote no output"))

    names = ["cpe-1", "cpe-2", "cpe-3"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), on_output, lambda o: None, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    after 2.0: timeout()


def _now_campaign(admin_state: str, names: list[str]) -> InputCampaign:
    """A campaign called now, with no schedule, so its window is open, and
    one device at a time."""
    campaign = InputCampaign(name="now", admin_state=admin_state,
                             target_concurrency=u64(1), max_concurrency=u64(1))
    for name in names:
        campaign.device.create(name, image=IMAGE)
    return campaign


actor _test_campaign_run_to_plan_holds_members_in_flight(t: testing.AsyncT):
    """A campaign that goes from run to plan puts its veto back on the
    members in flight."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var released = False
    var done = False
    linked = _flat_inventory(["cpe-1"]).to_gdata()

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if not released:
            if free == ["cpe-1"]:
                released = True
                cc = controller
                if cc is not None:
                    cc.on_conf(_now_campaign("plan", ["cpe-1"]), linked)
        elif vetoed == ["cpe-1"] and free == []:
            done = True
            t.success()
        else:
            fail("in plan: vetoed {vetoed}, not vetoed {free}")

    def timeout() -> None:
        if released:
            fail("no output in plan")
        else:
            fail("cpe-1 was not released")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda o: None, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", ["cpe-1"]), linked)
    ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
               _tagged("upgrade-needed", "now", "17.18.03a"), None)
    ctl.on_subscriptions_synced()
    after 2.5: timeout()


actor _test_campaign_veto_back_when_done(t: testing.AsyncT):
    """A member in flight gets the campaign's veto back once its status
    says that it is done."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var released = False
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if not released:
            if free == ["cpe-1"]:
                released = True
                cc = controller
                if cc is not None:
                    cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                              _tagged("succeeded", "now", "17.18.03a"), None)
        elif vetoed == ["cpe-1"] and free == []:
            done = True
            t.success()
        else:
            fail("after done: vetoed {vetoed}, not vetoed {free}")

    def timeout() -> None:
        if released:
            fail("cpe-1 is done, but did not get the veto back")
        else:
            fail("cpe-1 was not released")

    t.timeout(5.0)
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda o: None, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", ["cpe-1"]), _flat_inventory(["cpe-1"]).to_gdata())
    ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
               _tagged("upgrade-needed", "now", "17.18.03a"), None)
    ctl.on_subscriptions_synced()
    after float(cfs.campaign_debounce_s(1)) + 2.0: timeout()


actor _test_campaign_holds_a_member_with_a_stale_status(t: testing.AsyncT):
    """A member whose final status answers another campaign has not
    answered this one. The campaign holds it, shows it pending and names it
    in an alarm, until it answers. Then the campaign releases it, and it
    runs."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var phase = 0
    var done = False
    alarm = "1 device(s) have not answered the campaign's target: cpe-1"

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(status: str, campaign: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged(status, campaign, "17.18.03a"), None)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        if r is not None:
            held = False
            if r.status == "pending" and alarm in o.state.plan.alarm:
                held = True
            if phase == 0 and held:
                # The first decision holds cpe-1, which has not reported yet.
                phase = 1
                report("succeeded", "other")
            elif phase == 1 and held and r.upgrade_campaign == "other":
                phase = 2
                report("upgrade-needed", "now")

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if free == ["cpe-1"]:
            if phase == 2:
                done = True
                t.success()
            else:
                fail("cpe-1 was released at phase {phase}, before it answered")

    def timeout() -> None:
        fail("at phase {phase}, cpe-1 was not released")

    t.timeout(6.0)
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, on_oper, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", ["cpe-1"]), _flat_inventory(["cpe-1"]).to_gdata())
    ctl.on_subscriptions_synced()
    after 5.0: timeout()


actor _test_campaign_image_change_holds_a_member_again(t: testing.AsyncT):
    """A member that answered up-to-date for the campaign's target in plan
    has not answered when the campaign runs with an image of another
    version: the device sends no new status for the change. The campaign
    holds it until it answers the new target, and then releases it, and it
    runs."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var phase = 0
    var done = False
    alarm = "1 device(s) have not answered the campaign's target: cpe-1"

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        cc = controller
        if r is not None and cc is not None:
            if phase == 0 and r.status == "up-to-date" and len(o.state.plan.alarm) == 0:
                # In plan, cpe-1 answered. Run with a newer image.
                phase = 1
                cc.on_conf(_now_campaign("run", ["cpe-1"]),
                           _with_version(_flat_inventory(["cpe-1"]), "17.18.04").to_gdata())
            elif phase == 1 and r.status == "pending" and alarm in o.state.plan.alarm:
                phase = 2
                cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                          _tagged("upgrade-needed", "now", "17.18.04"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if free == ["cpe-1"]:
            if phase == 2:
                done = True
                t.success()
            else:
                fail("cpe-1 was released at phase {phase}, before it answered")

    def timeout() -> None:
        fail("at phase {phase}, cpe-1 was not released")

    t.timeout(6.0)
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, on_oper, None)
    controller = ctl
    ctl.on_conf(_now_campaign("plan", ["cpe-1"]), _flat_inventory(["cpe-1"]).to_gdata())
    ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
               _tagged("up-to-date", "now", "17.18.03a"), None)
    ctl.on_subscriptions_synced()
    after 5.0: timeout()


actor _test_campaign_image_change_makes_answers_stale(t: testing.AsyncT):
    """A member that answered the campaign's target shows pending, and
    counts nowhere, once its image in the campaign has another version.
    The device sends no new status for that."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var changed = False
    var done = False
    names = ["cpe-1"]
    conf = _paced_campaign(names)
    conf.admin_state = "plan"

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        r = o.state.device_status.get("cpe-1")
        got = "missing"
        if r is not None:
            got = "{r.status} {r.upgrade_campaign} {r.target_release}, succeeded {o.state.succeeded}"
        if not changed:
            # The first publication comes before the device's state.
            if got == "up-to-date paced 17.18.03a, succeeded 1":
                changed = True
                cc = controller
                if cc is not None:
                    newer = _with_version(_with_nightly(_flat_inventory(names)), "17.18.04")
                    cc.on_conf(conf, newer.to_gdata())
        elif got == "pending paced 17.18.03a, succeeded 0":
            done = True
            t.success()
        else:
            fail("after the image change: {got}")

    def timeout() -> None:
        if changed:
            fail("no publication after the image change")
        else:
            fail("cpe-1 did not show up-to-date")

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    controller = ctl
    ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
               _tagged("up-to-date", "paced", "17.18.03a"), None)
    # The replay is in. A campaign in plan publishes once it is synced.
    ctl.on_subscriptions_synced()
    after 2.0: timeout()


actor _test_campaign_counts_only_answers(t: testing.AsyncT):
    """The counters count only the statuses that answer the campaign: its
    name and the member's target release. A status for another campaign
    or another target shows as pending, with the tag the device reports."""
    var done = False
    names = ["cpe-1", "cpe-2", "cpe-3"]

    def row(o: y0_oper.software__software__upgrade_campaign_entry, name: str) -> str:
        r = o.state.device_status.get(name)
        if r is not None:
            return "{name} {r.status} {r.upgrade_campaign} {r.target_release}"
        return "{name} missing"

    def reported(o: y0_oper.software__software__upgrade_campaign_entry) -> bool:
        """Whether the states of the devices are in o. The first publication
        comes before them."""
        last = o.state.device_status.get("cpe-3")
        if last is not None:
            return last.target_release is not None
        return False

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        o = oper!
        if not reported(o):
            return
        done = True
        st = o.state
        got = [row(o, name) for name in names] + [
            "in-progress {st.in_progress} succeeded {st.succeeded} failed {st.failed}"]
        want = [
            "cpe-1 succeeded paced 17.18.03a",
            "cpe-2 pending other 17.18.03a",
            "cpe-3 pending paced 17.18.02",
            "in-progress 0 succeeded 1 failed 0",
        ]
        if got == want:
            t.success()
        else:
            t.failure(ValueError("device-status: {got}"))

    def timeout() -> None:
        if not done:
            done = True
            t.failure(ValueError("the campaign published no states"))

    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    campaign = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    campaign.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                    _tagged("succeeded", "paced", "17.18.03a"), None)
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-2"), device_name="cpe-2"),
                    _tagged("succeeded", "other", "17.18.03a"), None)
    campaign.on_rfs((rfs_name=cfs.flotilla_of("cpe-3"), device_name="cpe-3"),
                    _tagged("failed", "paced", "17.18.02"), None)
    campaign.on_subscriptions_synced()
    after 2.0: timeout()


actor _test_campaign_acquires_a_member_added_in_run(t: testing.AsyncT):
    """A member added to a campaign that runs is acquired as every member
    is: it gets the campaign's intent at once, held by the campaign's
    veto. The member in flight keeps no veto. The campaign holds the new
    member until it answers, also once the member in flight is done, and
    the plan names it in an alarm. When it answers, the campaign plans it
    and releases it."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    # Once cpe-1 is done: whether the output has its veto back, and whether
    # a publication still holds cpe-2.
    var veto_back = False
    var still_held = False
    var done = False
    linked = _flat_inventory(["cpe-1", "cpe-2"]).to_gdata()
    alarm = "1 device(s) have not answered the campaign's target: cpe-2"

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def answer() -> None:
        """Let cpe-2 answer once cpe-1 is done and cpe-2 is still held. The
        output and the publication of a decision come in either order."""
        if stage == 2 and veto_back and still_held:
            stage = 3
            report("cpe-2", "upgrade-needed")

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if "cpe-2" in free and stage < 3:
            fail("cpe-2 was released at stage {stage}, before it answered")
        elif stage == 0:
            if free == ["cpe-1"]:
                # cpe-1 is in flight. Add cpe-2.
                stage = 1
                cc = controller
                if cc is not None:
                    cc.on_conf(_now_campaign("run", ["cpe-1", "cpe-2"]), linked)
        elif stage == 1:
            if vetoed == ["cpe-2"] and free == ["cpe-1"] and targeted == ["cpe-1", "cpe-2"] \
               and unnamed == []:
                # cpe-2 is acquired. cpe-1 is done; cpe-2 has not answered.
                stage = 2
                report("cpe-1", "succeeded")
            else:
                fail("cpe-2 was not acquired: vetoed {vetoed}, not vetoed {free}, "
                     + "with a target {targeted}")
        elif stage == 2 and vetoed == ["cpe-1", "cpe-2"]:
            # cpe-1 is done: it has the veto again.
            veto_back = True
            answer()
        elif stage == 3 and free == ["cpe-2"]:
            done = True
            t.success()

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or stage != 2:
            return
        o = oper!
        finished = False
        for win in o.state.plan.window:
            for dev in win.device:
                if dev.name == "cpe-1" and dev.finished is not None:
                    finished = True
        if finished:
            alarms = list(o.state.plan.alarm)
            if alarms == [alarm]:
                # The decision that saw cpe-1 done still holds cpe-2.
                still_held = True
                answer()
            else:
                fail("once cpe-1 is done, the alarms are {alarms}")

    def timeout() -> None:
        fail("at stage {stage}, cpe-2 was not released")

    t.timeout(8.0)
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, on_oper, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", ["cpe-1"]), linked)
    report("cpe-1", "upgrade-needed")
    ctl.on_subscriptions_synced()
    after 6.0: timeout()


actor _JoinsAgain(t: testing.AsyncT, failed: bool):
    """Run a campaign called now over cpe-1 and cpe-2, one at a time in a
    window that is open. cpe-2 never answers. The campaign releases cpe-1.
    When failed is true, cpe-1 then fails, and gets the veto back. cpe-1
    leaves the campaign, its device loses the intent and keeps its last
    status, and cpe-1 joins the campaign again. Pass t when cpe-1 is held
    after it joins again, and is released once it answers again."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False
    both = ["cpe-1", "cpe-2"]
    linked = _flat_inventory(both).to_gdata()

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(status: str, campaign: ?str, target: ?str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
                      _tagged(status, campaign, target), None)

    def members(names: list[str]) -> None:
        cc = controller
        if cc is not None:
            cc.on_conf(_now_campaign("run", names), linked)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0:
            if free == ["cpe-1"]:
                # cpe-1 is in flight.
                if failed:
                    stage = 1
                    report("failed", "now", "17.18.03a")
                else:
                    stage = 2
                    members(["cpe-2"])
        elif stage == 1:
            if vetoed == both:
                # cpe-1 is done, and has the veto back.
                stage = 2
                members(["cpe-2"])
        elif stage == 2:
            if vetoed == ["cpe-2"] and free == []:
                stage = 3
                report("failed", None, None)
                members(both)
            else:
                fail("cpe-1 left: vetoed {vetoed}, not vetoed {free}")
        elif stage == 3:
            if vetoed == both and free == []:
                # cpe-1 is a new member: held until it answers.
                stage = 4
                report("upgrade-needed", "now", "17.18.03a")
            else:
                fail("cpe-1 joined again: vetoed {vetoed}, not vetoed {free}")
        elif stage == 4 and free == ["cpe-1"]:
            done = True
            t.success()

    def timeout() -> None:
        fail("at stage {stage}, cpe-1 was not released again")

    t.timeout(8.0)
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, lambda o: None, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", both), linked)
    report("upgrade-needed", "now", "17.18.03a")
    ctl.on_subscriptions_synced()
    after 6.0: timeout()


actor _test_campaign_retries_a_failed_member_that_joins_again(t: testing.AsyncT):
    """A member that failed, left the campaign and joined it again is
    released again once it answers. That is the retry of a failed
    member."""
    _JoinsAgain(t, True)


actor _test_campaign_holds_a_member_that_left_in_flight_and_joins_again(t: testing.AsyncT):
    """A member that left the campaign while in flight, and joins it again,
    gets the veto and is released only once it answers again."""
    _JoinsAgain(t, False)


actor _test_campaign_holds_a_member_still_upgrading(t: testing.AsyncT):
    """cpe-1 reports in-progress for the campaign, which has not released
    it: it still upgrades from before, as after a restart of fleetmgr. The
    campaign counts it in flight and keeps its veto, so cpe-2 does not
    start while it runs, one at a time. When cpe-1 is done, the campaign
    releases cpe-2."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var stage = 0
    var done = False

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def report(name: str, status: str) -> None:
        cc = controller
        if cc is not None:
            cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                      _tagged(status, "now", "17.18.03a"), None)

    def on_output(out: gdata.Node) -> None:
        if done:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if stage == 0 and free != []:
            fail("{free} released while cpe-1 still upgrades")
        elif stage == 1 and free == ["cpe-2"]:
            done = True
            t.success()
        elif stage == 1 and free != []:
            fail("once cpe-1 is done: not vetoed {free}")

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None or stage != 0:
            return
        started: list[str] = []
        for win in oper!.state.plan.window:
            for dev in win.device:
                if dev.started is not None:
                    started.append(dev.name)
        if "cpe-2" in started:
            fail("cpe-2 started while cpe-1 still upgrades")
        elif "cpe-1" in started:
            # A decision has cpe-1 in flight.
            stage = 1
            report("cpe-1", "succeeded")

    def timeout() -> None:
        fail("at stage {stage}, cpe-2 was not released")

    t.timeout(6.0)
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, on_oper, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", ["cpe-1", "cpe-2"]),
                _flat_inventory(["cpe-1", "cpe-2"]).to_gdata())
    report("cpe-1", "in-progress")
    report("cpe-2", "upgrade-needed")
    ctl.on_subscriptions_synced()
    after 5.0: timeout()


actor _test_campaign_in_plan_shows_a_new_run(t: testing.AsyncT):
    """A campaign set back from run to plan publishes the plan of a new run:
    cpe-1, which the paused run released, waits in it again, with an
    estimated start and no start."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var paused = False
    var done = False
    linked = _flat_inventory(["cpe-1"]).to_gdata()

    def on_output(out: gdata.Node) -> None:
        if paused:
            return
        vetoed, free, targeted, unnamed = _vetoed(out, "now")
        if free == ["cpe-1"]:
            paused = True
            cc = controller
            if cc is not None:
                cc.on_conf(_now_campaign("plan", ["cpe-1"]), linked)

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or not paused or oper is None:
            return
        for win in oper!.state.plan.window:
            for dev in win.device:
                if dev.name == "cpe-1" and dev.started is None \
                   and dev.estimated_start is not None:
                    done = True
                    t.success()

    def timeout() -> None:
        if not done:
            done = True
            if paused:
                t.failure(ValueError("in plan, the plan still shows cpe-1 started"))
            else:
                t.failure(ValueError("cpe-1 was not released"))

    ctl = cfs.UpgradeCampaignTransform(_campaign_path("now"), on_output, on_oper, None)
    controller = ctl
    ctl.on_conf(_now_campaign("run", ["cpe-1"]), linked)
    ctl.on_rfs((rfs_name=cfs.flotilla_of("cpe-1"), device_name="cpe-1"),
               _tagged("upgrade-needed", "now", "17.18.03a"), None)
    ctl.on_subscriptions_synced()
    after 3.0: timeout()


actor _test_campaign_in_plan_replans_on_answers(t: testing.AsyncT):
    """A campaign in plan plans again when its members answer: the alarm
    that names the members that have not answered goes once they
    answer."""
    var controller: ?cfs.UpgradeCampaignTransform = None
    var answered = False
    var done = False
    names = ["cpe-1", "cpe-2", "cpe-3"]
    waiting = ["3 device(s) have not answered the campaign's target: cpe-1, cpe-2, cpe-3"]

    def fail(message: str) -> None:
        if not done:
            done = True
            t.failure(ValueError(message))

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if done or oper is None:
            return
        alarms = list(oper!.state.plan.alarm)
        if not answered:
            if alarms == waiting:
                answered = True
                cc = controller
                if cc is not None:
                    for name in names:
                        cc.on_rfs((rfs_name=cfs.flotilla_of(name), device_name=name),
                                  _tagged("upgrade-needed", "paced", "17.18.03a"), None)
            else:
                fail("before the answers, the alarms are {alarms}")
        elif alarms == []:
            done = True
            t.success()
        elif alarms != waiting:
            fail("after the answers, the alarms are {alarms}")

    def timeout() -> None:
        fail("the campaign did not plan again after the answers")

    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    controller = ctl
    ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    ctl.on_subscriptions_synced()
    after float(cfs.campaign_debounce_s(len(names))) + 1.5: timeout()


actor _PlanAfterReplay(t: testing.AsyncT, reports: list[(str, str)], want: list[str]):
    """Run a campaign called paced in plan over cpe-1 to cpe-3. Before the
    sync, each member in reports, as (name, campaign), reports
    upgrade-needed for that campaign and the target 17.18.03a, as the
    replay of the subscription does. Pass t when the publication after the
    sync has the alarms, followed by the status of each member as "name
    status", that want gives."""
    var publications = 0
    names = ["cpe-1", "cpe-2", "cpe-3"]

    def on_oper(oper: ?y0_oper.software__software__upgrade_campaign_entry) -> None:
        if oper is None:
            return
        publications += 1
        # The first publication comes from on_conf, before the reports.
        if publications == 2:
            o = oper!
            got = list(o.state.plan.alarm)
            for name in names:
                r = o.state.device_status.get(name)
                if r is not None:
                    got.append("{name} {r.status}")
            if got == want:
                t.success()
            else:
                t.failure(ValueError("after the sync: {got}"))

    conf = _paced_campaign(names)
    conf.admin_state = "plan"
    ctl = cfs.UpgradeCampaignTransform(_campaign_path("paced"), lambda c: None, on_oper, None)
    ctl.on_conf(conf, _with_nightly(_flat_inventory(names)).to_gdata())
    for r in reports:
        ctl.on_rfs((rfs_name=cfs.flotilla_of(r.0), device_name=r.0),
                   _tagged("upgrade-needed", r.1, "17.18.03a"), None)
    ctl.on_subscriptions_synced()


actor _test_campaign_in_plan_plans_with_the_replay(t: testing.AsyncT):
    """The statuses of the replay come before the sync, and the plan that
    the campaign publishes at the sync has them: every member has
    answered, so there is no alarm."""
    _PlanAfterReplay(t, [("cpe-1", "paced"), ("cpe-2", "paced"), ("cpe-3", "paced")],
                     ["cpe-1 upgrade-needed", "cpe-2 upgrade-needed", "cpe-3 upgrade-needed"])


actor _test_campaign_holds_a_member_of_another_campaign(t: testing.AsyncT):
    """cpe-2's status answers another campaign, so cpe-2 has not answered
    this one: it shows pending, and the plan holds it and names it in an
    alarm."""
    _PlanAfterReplay(t, [("cpe-1", "paced"), ("cpe-2", "other"), ("cpe-3", "paced")],
                     ["1 device(s) have not answered the campaign's target: cpe-2",
                      "cpe-1 upgrade-needed", "cpe-2 pending", "cpe-3 upgrade-needed"])


def _claims_root(campaigns: list[(str, str, list[(str, str)])]) -> y_0.root:
    """The fleet cpe-1 and cpe-2, the image list, and campaigns, each as
    (name, admin-state, its members as (device, image))."""
    root = _with_images(y_0.root())
    for name in ["cpe-1", "cpe-2"]:
        root.fleet.device.create(name, type="iosxe", credentials=InputCredentials(username="admin"))
    for c in campaigns:
        campaign = root.software.upgrade_campaign.create(c.0, admin_state=c.1)
        for m in c.2:
            campaign.device.create(m.0, image=m.1)
    return root


actor _ClaimEdits(name: str, edits: list[(list[(str, str, list[(str, str)])], bool)],
                  want: list[str], held: list[str], log_handler: logging.Handler,
                  report: action(str, ?str) -> None):
    """Apply edits in order to a new system, then report the case name and
    what went wrong, or None.

    Each edit gives the campaigns of the whole configuration, and whether
    TTT accepts the edit. It is sent as the diff from the last accepted
    configuration, so a member or campaign that is left out is removed. A
    refused edit must fail on the campaigns' names. At the end, want is
    each device that has a campaign's name, as "device campaign target",
    and held are the devices that have their campaign's veto. Edit 0
    creates the fleet and the image list, and edit 1 is the first of
    edits."""
    var last = y_0.root()
    var pending = y_0.root()
    var step = 0
    var done = False
    tr = stratoweave.test_main(sysspec.SYSSPEC, log_handler)
    steps = [([], True)] + edits

    def finish(error: ?str) -> None:
        if not done:
            done = True
            report(name, error)

    def check() -> None:
        lower = y_1.root.from_gdata(tr.cfs.below().newsession().get_data())
        got: list[str] = []
        vetoed: list[str] = []
        for flotilla in lower.rfs:
            for dev in flotilla.device:
                c = dev.software.upgrade_campaign
                if c is not None:
                    got.append("{dev.name} {c} {dev.software.target_release}")
                    if dev.software.veto.get(cfs.veto_holder(c)) is not None:
                        vetoed.append(dev.name)
        not_held = [d for d in held if d not in vetoed]
        if sorted(got) != want:
            finish("claims {sorted(got)}")
        elif len(not_held) > 0:
            finish("not held: {not_held}")
        else:
            finish(None)

    def apply() -> None:
        if done:
            return
        if step == len(steps):
            check()
            return
        pending = _claims_root(steps[step].0)
        d = gdata.diff(last.to_gdata(), pending.to_gdata())
        if d is not None:
            tr.cfs.edit_config(d, on_edit)
        else:
            finish("edit {step} changes nothing")

    def on_edit(result: value) -> None:
        if done:
            return
        accept = steps[step].1
        if isinstance(result, Exception):
            if accept:
                finish("edit {step} failed: {result}")
                return
            if "upgrade-campaign" not in str(result):
                finish("edit {step} failed for another reason: {result}")
                return
        elif not accept:
            finish("edit {step} was accepted")
            return
        else:
            last = pending
        step += 1
        # The campaign actors write their output after the edit.
        after 0.5: apply()

    def timeout() -> None:
        finish("timed out at edit {step}")

    apply()
    after 10.0: timeout()


actor _test_one_campaign_per_device(t: testing.AsyncT):
    """A device is in one campaign at most, also while the campaign is in
    plan. An edit that names a device in a second campaign fails, and
    changes nothing. A member added to a campaign that runs is held like
    every member. A device that is not in the fleet gets no intent, so two
    campaigns can name it.

    A device moves to another campaign in two edits: the first removes it
    from its campaign, or deletes the campaign. In one edit the move
    fails. TTT removes the old campaign's name from the device only when
    it locks the device, after it merged the new campaign's name with
    it."""
    var results: dict[str, ?str] = {}
    var done = False
    a = ("A", "plan", [("cpe-1", IMAGE)])
    a_run = ("A", "run", [("cpe-1", IMAGE)])
    a_both = ("A", "plan", [("cpe-1", IMAGE), ("cpe-2", IMAGE)])
    a_two = ("A", "plan", [("cpe-2", IMAGE)])
    b = ("B", "plan", [("cpe-1", IMAGE)])
    # (case, the edits with whether TTT accepts each, each device's
    # campaign and target at the end, and the devices that must be held)
    cases: list[(str, list[(list[(str, str, list[(str, str)])], bool)], list[str], list[str])] = [
        ("a second campaign",
         [([a], True), ([a, b], False)],
         ["cpe-1 A 17.18.03a"], ["cpe-1"]),
        ("a held device added to another campaign",
         [([a], True), ([a, ("B", "plan", [("cpe-2", IMAGE)])], True),
          ([a, ("B", "plan", [("cpe-2", IMAGE), ("cpe-1", IMAGE)])], False)],
         ["cpe-1 A 17.18.03a", "cpe-2 B 17.18.03a"], ["cpe-1", "cpe-2"]),
        ("both in one edit",
         [([a, b], False)],
         [], []),
        ("a campaign in run holds too",
         [([a_run], True), ([a_run, b], False)],
         ["cpe-1 A 17.18.03a"], []),
        ("delete, then create",
         [([a], True), ([], True), ([b], True)],
         ["cpe-1 B 17.18.03a"], ["cpe-1"]),
        ("delete and create in one edit",
         [([a], True), ([b], False)],
         ["cpe-1 A 17.18.03a"], ["cpe-1"]),
        ("move in two edits",
         [([a_both], True), ([a_two], True), ([a_two, b], True)],
         ["cpe-1 B 17.18.03a", "cpe-2 A 17.18.03a"], ["cpe-1", "cpe-2"]),
        ("move in one edit",
         [([a_both], True), ([a_two, b], False)],
         ["cpe-1 A 17.18.03a", "cpe-2 A 17.18.03a"], ["cpe-1", "cpe-2"]),
        ("a member without an image",
         [([("A", "plan", [("cpe-1", "gone.bin")])], True),
          ([("A", "plan", [("cpe-1", "gone.bin")]), b], False)],
         ["cpe-1 A None"], ["cpe-1"]),
        ("a member not in the fleet",
         [([("A", "plan", [("cpe-9", IMAGE)])], True),
          ([("A", "plan", [("cpe-9", IMAGE)]), ("B", "plan", [("cpe-9", IMAGE)])], True)],
         [], []),
        ("a member added to a campaign that runs",
         [([a_run], True), ([("A", "run", [("cpe-1", IMAGE), ("cpe-2", IMAGE)])], True)],
         ["cpe-1 A 17.18.03a", "cpe-2 A 17.18.03a"], ["cpe-2"]),
    ]

    def on_case(name: str, error: ?str) -> None:
        if done:
            return
        results[name] = error
        if len(results) == len(cases):
            done = True
            failed = ["{case.0}: {results[case.0]}" for case in cases if results[case.0] is not None]
            if len(failed) == 0:
                t.success()
            else:
                t.failure(ValueError("; ".join(failed)))

    t.timeout(15.0)
    for case in cases:
        _ClaimEdits(case.0, case.1, case.2, case.3, t.log_handler, on_case)

