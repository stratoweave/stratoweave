import stratoweave

import fleetmgr.health_api as health_api
import fleetmgr.supervisor as supervisor
import fleetmgr.sysspec as sysspec
import fleetmgr.webui_assets as webui_assets


actor main(env):
    def start_top() -> None:
        # The top serves the embedded web UI next to its RESTCONF API, and
        # the device health details it reads from the flotillas.
        stratoweave.main(sysspec.SYSSPEC, env, static_assets=webui_assets.ASSETS,
                         extra_routes=health_api.install)

    supervisor.Supervisor(env, start_top)
