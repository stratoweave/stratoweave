import stratoweave

import fleetmgr.supervisor as supervisor
import fleetmgr.sysspec as sysspec
import fleetmgr.webui_assets as webui_assets


actor main(env):
    def start_top() -> None:
        # The top serves the embedded web UI next to its RESTCONF API.
        stratoweave.main(sysspec.SYSSPEC, env, static_assets=webui_assets.ASSETS)

    supervisor.Supervisor(env, start_top)
