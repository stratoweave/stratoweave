acton := env_var_or_default("ACTON", "acton")
fleetmgr_api := env_var_or_default("FLEETMGR_API", "http://127.0.0.1:18200")

# Regenerate both system specifications from YANG.
gen:
	cd spec && {{acton}} build && out/bin/gen

build:
	{{acton}} build

# Start one RFS-only bottom node without the fleet manager supervisor.
flotilla:
	out/bin/flotilla --http.port 18201 --netconf.port 12901

# Start the top, which spawns ten flotillas, with the 20-device demo and a
# planned sample campaign.
demo:
	out/bin/fleetmgr --http.port 18200 --netconf.port 12900 demo.xml demo-campaign.xml

# Start the demo with a generated fleet of N mock devices across ten
# flotillas, installs slowed to eight seconds so pacing is watchable, and
# a fleet-upgrade campaign over all of them in plan mode: inspect the
# plan in the web UI and set it to run from there. Rates are devices per
# hour; with the 8s installs the defaults ramp to eight in flight.
demo-fleet n="100" target="3600" max="7200":
	#!/usr/bin/env bash
	set -euo pipefail
	mkdir -p out
	f=out/demo-fleet.xml
	c=out/demo-fleet-campaign.xml
	{
	  echo '<?xml version="1.0" encoding="utf-8"?>'
	  echo '<data>'
	  echo '    <fleet xmlns="urn:fleetmgr:fleetmgr">'
	  for i in $(seq 1 10); do
	    printf '        <node><name>flotilla-%d</name><address><name>primary</name><address>127.0.0.1</address><port>%d</port></address><credentials><username>admin</username><password>admin</password></credentials></node>\n' "$i" "$((12900 + i))"
	  done
	  for i in $(seq 1 {{n}}); do
	    printf '        <device><name>dev-%04d</name><type>iosxe</type><shard>flotilla-%d</shard><credentials><username>admin</username><password>admin</password></credentials><mock><enabled>true</enabled><software><upgrade-duration>8</upgrade-duration></software></mock></device>\n' "$i" "$(( (i - 1) % 10 + 1 ))"
	  done
	  echo '    </fleet>'
	  echo '</data>'
	} > "$f"
	{
	  echo '<?xml version="1.0" encoding="utf-8"?>'
	  echo '<data>'
	  echo '    <software xmlns="urn:fleetmgr:software">'
	  echo '        <upgrade-campaign>'
	  echo '            <name>fleet-upgrade</name>'
	  echo '            <target-release>17.18.03a</target-release>'
	  echo '            <image-url>scp://admin:admin@127.0.0.1:/images/c8000v-universalk9.17.18.03a.SPA.bin</image-url>'
	  for i in $(seq 1 {{n}}); do
	    printf '            <device><name>dev-%04d</name></device>\n' "$i"
	  done
	  echo '            <admin-state>plan</admin-state>'
	  echo '            <target-rate>{{target}}</target-rate>'
	  echo '            <max-rate>{{max}}</max-rate>'
	  echo '        </upgrade-campaign>'
	  echo '    </software>'
	  echo '</data>'
	} > "$c"
	echo "Generated $f and $c: {{n}} devices, target {{target}}/h, max {{max}}/h"
	out/bin/fleetmgr --http.port 18200 --netconf.port 12900 "$f" "$c"

# Submit the three-device IOS XE demo campaign. The transaction applies but
# its response can hang (open engine bug), so cap the wait and watch state.
upgrade:
	@curl -fsS --max-time 5 -X PATCH -H "Content-Type: application/yang-data+xml" --data-binary @upgrade.xml "{{fleetmgr_api}}/restconf/data" || true
	@echo "Submitted xe-upgrade"

# Print one normalized snapshot of a campaign's operational state.
campaign-status campaign="xe-upgrade":
	#!/usr/bin/env bash
	set -euo pipefail
	state="$(curl -fsS -H 'Accept: application/yang-data+json' '{{fleetmgr_api}}/restconf/data' | jq -c --arg campaign '{{campaign}}' '
	  .["software:software"]["upgrade-campaign"][]?
	  | select(.name == $campaign)
	  | {
	      campaign: .name,
	      total: (.state.total // 0),
	      in_progress: (.state["in-progress"] // 0),
	      succeeded: (.state.succeeded // 0),
	      failed: (.state.failed // 0),
	      devices: [
	        .state["device-status"][]?
	        | {
	            device,
	            status: (.status // "pending"),
	            running_release: .["running-release"]
	          }
	      ]
	    }
	')"
	if [[ -z "$state" ]]; then
	  echo "Campaign {{campaign}} does not exist" >&2
	  exit 1
	fi
	jq . <<<"$state"

# Poll a campaign, printing only state changes and stopping when it completes.
watch-campaign campaign="xe-upgrade":
	#!/usr/bin/env bash
	set -euo pipefail
	previous=''
	while true; do
	  state="$(curl -fsS -H 'Accept: application/yang-data+json' '{{fleetmgr_api}}/restconf/data' | jq -c --arg campaign '{{campaign}}' '
	    .["software:software"]["upgrade-campaign"][]?
	    | select(.name == $campaign)
	    | {
	        campaign: .name,
	        total: (.state.total // 0),
	        in_progress: (.state["in-progress"] // 0),
	        succeeded: (.state.succeeded // 0),
	        failed: (.state.failed // 0),
	        devices: [
	          .state["device-status"][]?
	          | {
	              device,
	              status: (.status // "pending"),
	              running_release: .["running-release"]
	            }
	        ]
	      }
	  ')"
	  if [[ -z "$state" ]]; then
	    state='{"campaign":"{{campaign}}","status":"waiting for campaign"}'
	  fi
	  if [[ "$state" != "$previous" ]]; then
	    jq . <<<"$state"
	    previous="$state"
	  fi
	  if jq -e '(.total // 0) > 0 and .in_progress == 0 and ((.succeeded + .failed) >= .total)' <<<"$state" >/dev/null; then
	    exit 0
	  fi
	  sleep 0.1
	done

# Start watching before submitting, so the short mock in-progress state is visible.
upgrade-and-watch:
	#!/usr/bin/env bash
	set -euo pipefail
	just watch-campaign xe-upgrade &
	watcher=$!
	trap 'kill "$watcher" 2>/dev/null || true' EXIT
	sleep 0.1
	just upgrade
	wait "$watcher"
	trap - EXIT

# Start the web UI dev server, proxying /restconf to the top. Run npm install in webui/ once.
webui port="3000":
	cd webui && STRATOWEAVE_API_ORIGIN={{fleetmgr_api}} npm run dev -- --port {{port}}

# Rebuild the web UI and regenerate the embedded-assets module
# (src/fleetmgr/webui_assets.act, committed); then `just build`. Needs Node.
gen-webui:
	rm -rf webui/build
	cd webui && npm ci --no-audit --no-fund && npm run check && npm run build && node scripts/gen-embedded-assets.mjs

# Controller pacing system test: a real fleetmgr deployment with slow mock
# devices, asserting releases arrive a few at a time. About a minute.
system-test:
	{{acton}} test --jobs 1 --module test_fleetmgr_pacing --tag fleetmgr-system --max-iter 1 --max-time 180000

test:
	{{acton}} test --module test_fleetmgr_cfs
	{{acton}} test --module test_fleetmgr_rfs
	{{acton}} test --module test_flotilla_rfs
	{{acton}} test --module fleetmgr.test_webui_assets
