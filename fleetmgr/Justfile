acton := env_var_or_default("ACTON", "acton")
fleetmgr_api := env_var_or_default("FLEETMGR_API", "http://127.0.0.1:18200")

# Regenerate both system specifications from YANG.
gen:
	cd spec && {{acton}} build && out/bin/gen

build:
	{{acton}} build --release

# Deploy the CEs, start the top, load both campaigns and run only the mocks; Ctrl-C stops the top.
demo-all:
	#!/usr/bin/env bash
	set -euo pipefail
	export HTTP_PORT="${HTTP_PORT:-18200}"
	export CAMPAIGN="${CAMPAIGN:-lab}"
	api_ready() {
	  curl -fsS --max-time 2 -H "Accept: application/yang-data+json" "http://localhost:$HTTP_PORT/restconf/data/fleetmgr:fleet" 2>/dev/null | jq -e 'has("fleetmgr:fleet")' >/dev/null 2>&1
	}
	if api_ready; then
	  echo "Fleet Manager already running on port $HTTP_PORT; stop it first" >&2
	  exit 1
	fi
	[ -x out/bin/fleetmgr ] || { echo "fleetmgr not built; run just build" >&2; exit 1; }
	just --justfile test/lab/Justfile start
	just --justfile test/lab/Justfile wait
	(exec out/bin/fleetmgr --http.port "$HTTP_PORT" --netconf.port 12900) &
	manager_pid=$!
	trap 'kill "$manager_pid" 2>/dev/null || true; wait "$manager_pid" 2>/dev/null || true' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	ready=false
	for i in $(seq 1 120); do
	  kill -0 "$manager_pid" 2>/dev/null || { wait "$manager_pid"; exit 1; }
	  if api_ready; then ready=true; break; fi
	  sleep 1
	done
	$ready || { echo "Fleet Manager API did not become ready" >&2; exit 1; }
	just --justfile test/lab/Justfile add-devices
	just --justfile test/lab/Justfile load-big
	just --justfile test/lab/Justfile load-ces
	just --justfile test/lab/Justfile CAMPAIGN=fleet-upgrade campaign-run
	echo "Demo ready at http://localhost:$HTTP_PORT; $CAMPAIGN remains in plan."
	echo "Ctrl-C stops Fleet Manager; just --justfile test/lab/Justfile stop removes the lab."
	wait "$manager_pid"

# Start one RFS-only bottom node without the fleet manager supervisor.
flotilla:
	out/bin/flotilla --http.port 18201 --netconf.port 12901

# Start the top and its ten flotillas like `just demo`, with no config.
run:
	mkdir -p out/images
	out/bin/fleetmgr --http.port 18200 --netconf.port 12900 --software.image-dir out/images

# `just demo-fleet` with a hundred devices, 120 to 150 s installs, a tenth
# failing and the regional windows opening soon.
# Start the demo with a hundred mock devices.
demo: (demo-fleet "100" "8" "16" "10" "120-150" "3600" "all")

# Start the demo with a generated fleet of N mock devices across ten
# flotillas, installs slowed to eight seconds so pacing is watchable, and
# a fleet-upgrade campaign over four fifths of them in plan mode: inspect the
# plan in the web UI and set it to run from there. TARGET and MAX are
# devices upgrading at once: the controller ramps to TARGET, and goes up
# to MAX only when a window falls behind.
# There are three schedules, americas (UTC-5), europe (UTC+1) and asia
# (UTC+8), and we pretend everyone does maintenance at midnight in their
# local timezone. Actual midnight is hours away, so to make the demo
# watchable the windows are computed when the demo starts: europe opens
# about 30 seconds in, americas at 90 and asia at 150. Every device is
# bound to a schedule: 60% to europe, 30% to americas and 10% to asia.
# The campaign has no default schedule.
# Three more knobs make the fleet realistic. FAIL is the percentage of
# devices whose upgrade fails, each in one of the mock's nine ways in turn,
# picked by a fixed shuffle so the grids show no pattern. DURATION is the
# install time in seconds; a range like 120-150 spreads it over the
# devices like a lab c8000v, and each upgrade takes up to 20% more or
# less. WINDOW is the length of every regional window in seconds, an hour
# by default: a slow fleet at a low concurrency needs a longer one, since
# europe holds 60% of the devices and what does not fit its window is
# planned into the next day's. SOON names the schedules whose
# windows are pulled forward to open shortly after the start, all of them
# by default; the others open at their real local midnight, where a
# fleet's windows are. Models follow a rough field mix of five IOS XE
# routers, branch ISR 1100 and ISR 4300 the most, each with its own
# serial number. Most devices run 17.15.04, the release before the
# campaign's 17.18.03a, 15% run an older 17.12.03 and 5% already run
# 17.18.03a. A fifth of the devices stay out of the campaign, to pick for
# a new one in the web UI. Every thirtieth device and the next form a
# redundancy group, site-0001 and on, and cpe-0003 to cpe-0005 form hub,
# which packs with a minute between upgrades and starts with cpe-0005.
demo-fleet n="100" target="8" max="16" fail="0" duration="8" window="3600" soon="all": (gen-demo-fleet n target max fail duration window soon) demo-image-files
	out/bin/fleetmgr --http.port 18200 --netconf.port 12900 --software.image-dir out/images out/demo-fleet.xml out/demo-fleet-campaign.xml demo-images.xml

# The files are sparse: the size looks real but takes no disk. Existing
# files are left alone.
# Make an empty file in out/images for every image in demo-images.xml, in its folder.
demo-image-files:
	#!/usr/bin/env bash
	set -euo pipefail
	for f in $(sed -n 's|.*<file>\([^<]*\)</file>.*|\1|p' demo-images.xml); do
	  p=out/images/$f
	  [ -e "$p" ] && continue
	  case $f in
	    c1100/*) mb=700 ;;
	    isr4300/*) mb=760 ;;
	    c8000be/*) mb=880 ;;
	    *) mb=1000 ;;
	  esac
	  case $f in
	    *.17.15.*) mb=$((mb + 15)) ;;
	    *.17.18.*) mb=$((mb + 30)) ;;
	  esac
	  mkdir -p "${p%/*}"
	  truncate -s "${mb}M" "$p"
	done

# Generate the demo fleet's two files into out/ without starting the top;
# `just demo-fleet` runs this first, and the lab loads them into a running
# top. The knobs are demo-fleet's.
gen-demo-fleet n="100" target="8" max="16" fail="0" duration="8" window="3600" soon="all":
	#!/usr/bin/env bash
	set -euo pipefail
	fail={{fail}}
	[[ $fail =~ ^[0-9]+$ && $fail -le 100 ]] || { echo "fail must be a percentage 0-100, not '$fail'" >&2; exit 1; }
	[[ "{{duration}}" =~ ^([0-9]+)(-([0-9]+))?$ ]] || { echo "duration must be seconds or a range like 8 or 120-150, not '{{duration}}'" >&2; exit 1; }
	lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[3]:-$lo}
	(( lo >= 1 && hi >= lo && hi <= 65535 )) || { echo "duration must be 1-65535 s, low before high" >&2; exit 1; }
	span=$((hi - lo + 1))
	[[ "{{window}}" =~ ^[0-9]+$ && {{window}} -gt 0 ]] || { echo "window must be seconds, not '{{window}}'" >&2; exit 1; }
	soon="{{soon}}"
	[[ $soon =~ ^(all|(europe|americas|asia)(,(europe|americas|asia))*)$ ]] || { echo "soon must be all or a list of europe, americas and asia, not '$soon'" >&2; exit 1; }
	mkdir -p out
	f=out/demo-fleet.xml
	c=out/demo-fleet-campaign.xml
	# The failing devices in a fixed pseudo-random order, the nine kinds
	# rotating along it. A Park-Miller generator in awk: exact in doubles,
	# so gawk, mawk and busybox pick the same devices, unlike rand().
	kinds=(download-failed add-failed activate-refused commit-failed reverts bgp-down bgp-lost interface-lost ospf-lost)
	count=$(( ({{n}} * fail + 50) / 100 ))
	failing=()
	if (( count > 0 )); then
	  k=0
	  for i in $(awk -v n={{n}} 'BEGIN { x = 20260921; for (i = 1; i <= n; i++) { x = (x * 48271) % 2147483647; printf "%d %d\n", x, i } }' | LC_ALL=C sort -n | awk -v k="$count" 'NR <= k { print $2 }'); do
	    failing[$i]=${kinds[$(( k % ${#kinds[@]} ))]}
	    k=$((k + 1))
	  done
	fi
	# Models as a percentage of the fleet, an estimate of how common each is
	# in the field, placed by another fixed shuffle. Serial numbers follow
	# Cisco's format, factory, year, week and sequence; a virtual C8000V
	# has eleven random characters.
	mix="30 C1111-8P 25 ISR4331 20 C8200L-1N-4T 15 C8300-1N1S-6T 10 C8000V"
	models=()
	serials=()
	while read -r i m s; do models[$i]=$m; serials[$i]=$s; done < <(
	  awk -v n={{n}} 'BEGIN { x = 20261012; for (i = 1; i <= n; i++) { x = (x * 48271) % 2147483647; printf "%d %d\n", x, i } }' | LC_ALL=C sort -n |
	  awk -v n={{n}} -v mix="$mix" '
	    function b36(v, k,   s) { s = ""; while (k-- > 0) { s = substr(c, v % 36 + 1, 1) s; v = int(v / 36) } return s }
	    BEGIN { c = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"; k = split(mix, a, " "); split("FGL FDO FOC JAE", fac, " ") }
	    {
	      x = $1
	      cum = 0
	      for (j = 1; j < k; j += 2) { cum += a[j]; if ((NR - 1) * 100 < cum * n) break }
	      if (a[j + 1] == "C8000V") s = "9" b36(x, 6) b36(int(x / 7), 4)
	      else s = fac[x % 4 + 1] sprintf("%02d%02d", 18 + int(x / 4) % 8, 1 + int(x / 32) % 52) b36(int(x / 1664), 4)
	      print $2, a[j + 1], s
	    }')
	# The releases the devices run, by a third shuffle: 5% already run the
	# campaign's 17.18.03a, 15% an older 17.12.03 and the rest 17.15.04.
	current=$(( ({{n}} * 5 + 50) / 100 ))
	older=$(( ({{n}} * 15 + 50) / 100 ))
	versions=()
	k=0
	for i in $(awk -v n={{n}} 'BEGIN { x = 20261117; for (i = 1; i <= n; i++) { x = (x * 48271) % 2147483647; printf "%d %d\n", x, i } }' | LC_ALL=C sort -n | awk '{ print $2 }'); do
	  if (( k < current )); then versions[$i]=17.18.03a
	  elif (( k < current + older )); then versions[$i]=17.12.03
	  else versions[$i]=17.15.04
	  fi
	  k=$((k + 1))
	done
	# A fifth of the devices stay out of the campaign, by a fourth shuffle,
	# to pick for a new one in the web UI. Grouped devices all stay in, so
	# no group is split.
	grouped() { (( ($1 % 30 == 1 && $1 < {{n}}) || $1 % 30 == 2 || ({{n}} >= 5 && $1 >= 3 && $1 <= 5) )); }
	spare=$(( ({{n}} * 20 + 50) / 100 ))
	left=()
	k=0
	for i in $(awk -v n={{n}} 'BEGIN { x = 20261118; for (i = 1; i <= n; i++) { x = (x * 48271) % 2147483647; printf "%d %d\n", x, i } }' | LC_ALL=C sort -n | awk '{ print $2 }'); do
	  (( k < spare )) || break
	  if ! grouped "$i"; then
	    left[$i]=1
	    k=$((k + 1))
	  fi
	done
	spare=$k
	# A failing check gives up once it has waited as long as the shortest
	# install, at most a minute, so the demo stays watchable: ten minutes
	# by default for a post-check.
	check_wait=$(( lo < 60 ? lo : 60 ))
	{
	  echo '<?xml version="1.0" encoding="utf-8"?>'
	  echo '<data>'
	  echo '    <fleet xmlns="urn:fleetmgr:fleetmgr">'
	  for i in $(seq 1 {{n}}); do
	    case $((i % 10)) in
	      7|8|9) b="<schedule>americas</schedule>" ;;
	      0) b="<schedule>asia</schedule>" ;;
	      *) b="<schedule>europe</schedule>" ;;
	    esac
	    d=""
	    x=""
	    w=""
	    if [ -n "${failing[$i]:-}" ]; then
	      d="<description>mock, fails: ${failing[$i]}</description>"
	      x="<failure>${failing[$i]}</failure>"
	    fi
	    if [[ "${failing[$i]:-}" == bgp-down ]]; then
	      w="<upgrade-checks><precheck-wait>$check_wait</precheck-wait></upgrade-checks>"
	    elif [[ "${failing[$i]:-}" == *-lost ]]; then
	      w="<upgrade-checks><postcheck-wait>$check_wait</postcheck-wait></upgrade-checks>"
	    fi
	    g=""
	    if (( i % 30 == 1 && i < {{n}} )); then
	      g=$(printf '<redundancy-group>site-%04d</redundancy-group>' "$i")
	    elif (( i % 30 == 2 )); then
	      g=$(printf '<redundancy-group>site-%04d</redundancy-group>' "$((i - 1))")
	    fi
	    if (( {{n}} >= 5 && i >= 3 && i <= 5 )); then
	      g="$g<redundancy-group>hub</redundancy-group>"
	      if (( i == 5 )); then g="$g<redundancy-priority>50</redundancy-priority>"; fi
	    fi
	    printf '        <device><name>cpe-%04d</name><type>iosxe</type>%s%s%s<credentials><username>admin</username><password>admin</password></credentials><mock><enabled>true</enabled><software><upgrade-duration>%d</upgrade-duration>%s</software><platform><version>%s</version><model>%s</model><serial-number>%s</serial-number></platform></mock>%s</device>\n' "$i" "$b" "$d" "$g" "$(( lo + (i * 7) % span ))" "$x" "${versions[$i]}" "${models[$i]}" "${serials[$i]}" "$w"
	  done
	  echo '    </fleet>'
	  if (( {{n}} >= 5 )); then
	    echo '    <redundancy-groups xmlns="urn:fleetmgr:fleetmgr">'
	    echo '        <redundancy-group><name>hub</name><separation-policy>pack</separation-policy><min-separation>60</min-separation></redundancy-group>'
	    echo '    </redundancy-groups>'
	  fi
	  echo '</data>'
	} > "$f"
	{
	  echo '<?xml version="1.0" encoding="utf-8"?>'
	  echo '<data>'
	  now=$(date +%s)
	  at() { echo $(( (now + $1 * 60 + $2) % 86400 )); }
	  # A schedule named in SOON opens $3 seconds from now; any other at
	  # its local midnight.
	  opens() { if [[ $soon == all || ",$soon," == *",$1,"* ]]; then at "$2" "$3"; else echo 0; fi; }
	  echo '    <schedules xmlns="urn:fleetmgr:maintenance">'
	  printf '        <schedule><name>europe</name><utc-offset>60</utc-offset><window><at>%d</at><duration>{{window}}</duration></window></schedule>\n' "$(opens europe 60 30)"
	  printf '        <schedule><name>americas</name><utc-offset>-300</utc-offset><window><at>%d</at><duration>{{window}}</duration></window></schedule>\n' "$(opens americas -300 90)"
	  printf '        <schedule><name>asia</name><utc-offset>480</utc-offset><window><at>%d</at><duration>{{window}}</duration></window></schedule>\n' "$(opens asia 480 150)"
	  echo '    </schedules>'
	  echo '    <software xmlns="urn:fleetmgr:software">'
	  echo '        <upgrade-campaign>'
	  echo '            <name>fleet-upgrade</name>'
	  # Each member installs the 17.18.03a image of its model's family,
	  # from demo-images.xml.
	  for i in $(seq 1 {{n}}); do
	    [ -n "${left[$i]:-}" ] && continue
	    case "${models[$i]}" in
	      C1111-8P) family=c1100-universalk9 ;;
	      ISR4331) family=isr4300-universalk9 ;;
	      C8200L-1N-4T|C8300-1N1S-6T) family=c8000be-universalk9 ;;
	      C8000V) family=c8000v-universalk9 ;;
	      *) echo "No demo image for model ${models[$i]}" >&2; exit 1 ;;
	    esac
	    printf '            <device><name>cpe-%04d</name><image>%s.17.18.03a.SPA.bin</image></device>\n' "$i" "$family"
	  done
	  echo '            <admin-state>plan</admin-state>'
	  echo '            <target-concurrency>{{target}}</target-concurrency>'
	  echo '            <max-concurrency>{{max}}</max-concurrency>'
	  echo '        </upgrade-campaign>'
	  echo '    </software>'
	  echo '</data>'
	} > "$c"
	echo "Generated $f and $c: {{n}} devices, $(( {{n}} - spare )) in the campaign, target {{target}} and max {{max}} at once, $count failing, $current up to date, $older on 17.12.03, installs {{duration}} s, windows {{window}} s, opening soon: $soon"

# Recompute the running demo's regional windows so they open about 30, 90
# and 150 seconds from now, WINDOW seconds long; pass the length and the
# SOON list the demo was started with, so a demo that keeps americas and
# asia at their local midnight only moves europe. The campaigns replan on
# the schedule change. Devices that already upgraded stay upgraded;
# restart the demo for a fresh run.
demo-reschedule window="3600" soon="all":
	#!/usr/bin/env bash
	set -euo pipefail
	[[ "{{window}}" =~ ^[0-9]+$ && {{window}} -gt 0 ]] || { echo "window must be seconds, not '{{window}}'" >&2; exit 1; }
	soon="{{soon}}"
	[[ $soon =~ ^(all|(europe|americas|asia)(,(europe|americas|asia))*)$ ]] || { echo "soon must be all or a list of europe, americas and asia, not '$soon'" >&2; exit 1; }
	now=$(date +%s)
	at() { echo $(( (now + $1 * 60 + $2) % 86400 )); }
	chosen() { [[ $soon == all || ",$soon," == *",$1,"* ]]; }
	# async: the write applies but its answer can get lost when a live
	# campaign links the schedule, the same open engine bug as elsewhere.
	put() { curl -fsS --max-time 5 -X PUT -H "Content-Type: application/yang-data+json" -H "async: true" --data-binary "{\"maintenance:schedule\": [{\"name\": \"$1\", \"utc-offset\": $2, \"window\": [{\"at\": $3, \"duration\": {{window}}}]}]}" "{{fleetmgr_api}}/restconf/data/maintenance:schedules/schedule=$1" > /dev/null; }
	moved=()
	chosen europe && put europe 60 "$(at 60 30)" && moved+=("europe in ~30s")
	chosen americas && put americas -300 "$(at -300 90)" && moved+=("americas in ~90s")
	chosen asia && put asia 480 "$(at 480 150)" && moved+=("asia in ~150s")
	echo "Windows recomputed, {{window}} s long: ${moved[*]}"

# The thousand-device preset: `just demo-fleet` with 120-150 s installs, a
# tenth of the fleet failing and four-hour windows with a hundredth of the
# fleet at once, ten for a thousand, so the campaign's 480 or so europe
# devices take under two hours of their window. Only europe is pulled forward
# to open half a minute in; americas and asia keep their local midnight,
# so the plan shows them where a real fleet's windows are, and
# `just demo-reschedule 14400 europe` reopens europe alone. A thousand
# devices come up in about half a minute and take about a gigabyte. Do not
# run it alongside `just demo`.
demo-big n="1000":
	#!/usr/bin/env bash
	set -euo pipefail
	target=$(( ({{n}} + 99) / 100 ))
	exec just demo-fleet {{n}} "$target" "$((target * 2))" 10 120-150 14400 europe

# Print one normalized snapshot of a campaign's operational state.
campaign-status campaign="fleet-upgrade":
	#!/usr/bin/env bash
	set -euo pipefail
	state="$(curl -fsS -H 'Accept: application/yang-data+json' '{{fleetmgr_api}}/restconf/data' | jq -c --arg campaign '{{campaign}}' '
	  .["software:software"]["upgrade-campaign"][]?
	  | select(.name == $campaign)
	  | {
	      campaign: .name,
	      total: (.state.total // 0),
	      in_progress: (.state["in-progress"] // 0),
	      succeeded: (.state.succeeded // 0),
	      failed: (.state.failed // 0),
	      devices: [
	        .state["device-status"][]?
	        | {
	            device,
	            status: (.status // "pending"),
	            version
	          }
	      ]
	    }
	')"
	if [[ -z "$state" ]]; then
	  echo "Campaign {{campaign}} does not exist" >&2
	  exit 1
	fi
	jq . <<<"$state"

# Poll a campaign, printing only state changes and stopping when it completes.
watch-campaign campaign="fleet-upgrade":
	#!/usr/bin/env bash
	set -euo pipefail
	previous=''
	while true; do
	  state="$(curl -fsS -H 'Accept: application/yang-data+json' '{{fleetmgr_api}}/restconf/data' | jq -c --arg campaign '{{campaign}}' '
	    .["software:software"]["upgrade-campaign"][]?
	    | select(.name == $campaign)
	    | {
	        campaign: .name,
	        total: (.state.total // 0),
	        in_progress: (.state["in-progress"] // 0),
	        succeeded: (.state.succeeded // 0),
	        failed: (.state.failed // 0),
	        devices: [
	          .state["device-status"][]?
	          | {
	              device,
	              status: (.status // "pending"),
	              version
	            }
	        ]
	      }
	  ')"
	  if [[ -z "$state" ]]; then
	    state='{"campaign":"{{campaign}}","status":"waiting for campaign"}'
	  fi
	  if [[ "$state" != "$previous" ]]; then
	    jq . <<<"$state"
	    previous="$state"
	  fi
	  if jq -e '(.total // 0) > 0 and .in_progress == 0 and ((.succeeded + .failed) >= .total)' <<<"$state" >/dev/null; then
	    exit 0
	  fi
	  sleep 0.1
	done

# Start the web UI dev server, proxying /restconf to the top. Run npm install in webui/ once.
webui port="3000":
	cd webui && STRATOWEAVE_API_ORIGIN={{fleetmgr_api}} npm run dev -- --port {{port}}

# Rebuild the web UI into webui/build (committed); then `just build` embeds it
# (derived_modules in Build.act). Needs Node 22.17+. The adapter replaces
# webui/build only after a good build, so a failed run keeps the old one.
gen-webui:
	cd webui && npm ci --no-audit --no-fund && npm run check && npm run build

# Controller pacing system test: a real fleetmgr deployment with slow mock
# devices, asserting releases arrive a few at a time. About a minute.
system-test:
	{{acton}} test --jobs 1 --module test_fleetmgr_pacing --tag fleetmgr-system --min-iter 1 --max-iter 1 --max-time 180000

test:
	{{acton}} test
