acton := env_var_or_default("ACTON", "acton")
fleetmgr_api := env_var_or_default("FLEETMGR_API", "http://127.0.0.1:18200")

# Regenerate both system specifications from YANG.
gen:
	cd spec && {{acton}} build && out/bin/gen

build:
	{{acton}} build

# Start one RFS-only bottom node without the fleet manager supervisor.
flotilla:
	out/bin/flotilla --http.port 18201 --netconf.port 12901

# Start the top, which spawns ten flotillas, with the 100-device demo and a
# planned sample campaign.
demo:
	out/bin/fleetmgr --http.port 18200 --netconf.port 12900 demo.xml demo-campaign.xml

# Start the demo with a generated fleet of N mock devices across ten
# flotillas, installs slowed to eight seconds so pacing is watchable, and
# a fleet-upgrade campaign over all of them in plan mode: inspect the
# plan in the web UI and set it to run from there. Rates are devices per
# hour; with the 8s installs the defaults ramp to eight in flight.
# There are three schedules, americas (UTC-5), europe (UTC+1) and asia
# (UTC+8), and we pretend everyone does maintenance at midnight in their
# local timezone. Actual midnight is hours away, so to make the demo
# watchable the windows are computed when the demo starts: europe opens
# about 30 seconds in, americas at 90 and asia at 150. 30% of the
# devices are bound to americas and 10% to asia; the remaining 60%
# follow the campaign default europe.
# Three more knobs make the fleet realistic. FAIL is the percentage of
# devices whose upgrade fails, each in one of the mock's five ways in turn,
# picked by a fixed shuffle so the grids show no pattern. DURATION is the
# install time in seconds; a range like 120-150 spreads it over the
# devices like a lab c8000v. WINDOW is the length of every regional window
# in seconds, an hour by default: a slow fleet at a low rate needs a longer
# one, since europe holds 60% of the devices and what does not fit its
# window is planned into the next day's. SOON names the schedules whose
# windows are pulled forward to open shortly after the start, all of them
# by default; the others open at their real local midnight, where a
# fleet's windows are.
demo-fleet n="100" target="3600" max="7200" fail="0" duration="8" window="3600" soon="all": (gen-demo-fleet n target max fail duration window soon)
	out/bin/fleetmgr --http.port 18200 --netconf.port 12900 out/demo-fleet.xml out/demo-fleet-campaign.xml

# Generate the demo fleet's two files into out/ without starting the top;
# `just demo-fleet` runs this first, and the lab loads them into a running
# top. The knobs are demo-fleet's.
gen-demo-fleet n="100" target="3600" max="7200" fail="0" duration="8" window="3600" soon="all":
	#!/usr/bin/env bash
	set -euo pipefail
	fail={{fail}}
	[[ $fail =~ ^[0-9]+$ && $fail -le 100 ]] || { echo "fail must be a percentage 0-100, not '$fail'" >&2; exit 1; }
	[[ "{{duration}}" =~ ^([0-9]+)(-([0-9]+))?$ ]] || { echo "duration must be seconds or a range like 8 or 120-150, not '{{duration}}'" >&2; exit 1; }
	lo=${BASH_REMATCH[1]}; hi=${BASH_REMATCH[3]:-$lo}
	(( lo >= 1 && hi >= lo && hi <= 65535 )) || { echo "duration must be 1-65535 s, low before high" >&2; exit 1; }
	span=$((hi - lo + 1))
	[[ "{{window}}" =~ ^[0-9]+$ && {{window}} -gt 0 ]] || { echo "window must be seconds, not '{{window}}'" >&2; exit 1; }
	soon="{{soon}}"
	[[ $soon =~ ^(all|(europe|americas|asia)(,(europe|americas|asia))*)$ ]] || { echo "soon must be all or a list of europe, americas and asia, not '$soon'" >&2; exit 1; }
	mkdir -p out
	f=out/demo-fleet.xml
	c=out/demo-fleet-campaign.xml
	# The failing devices in a fixed pseudo-random order, the five kinds
	# rotating along it. A Park-Miller generator in awk: exact in doubles,
	# so gawk, mawk and busybox pick the same devices, unlike rand().
	kinds=(download-failed add-failed activate-refused commit-failed reverts)
	count=$(( ({{n}} * fail + 50) / 100 ))
	failing=()
	if (( count > 0 )); then
	  k=0
	  for i in $(awk -v n={{n}} 'BEGIN { x = 20260921; for (i = 1; i <= n; i++) { x = (x * 48271) % 2147483647; printf "%d %d\n", x, i } }' | LC_ALL=C sort -n | awk -v k="$count" 'NR <= k { print $2 }'); do
	    failing[$i]=${kinds[$(( k % 5 ))]}
	    k=$((k + 1))
	  done
	fi
	{
	  echo '<?xml version="1.0" encoding="utf-8"?>'
	  echo '<data>'
	  echo '    <fleet xmlns="urn:fleetmgr:fleetmgr">'
	  for i in $(seq 1 10); do
	    printf '        <node><name>flotilla-%d</name><address><name>primary</name><address>127.0.0.1</address><port>%d</port></address><credentials><username>admin</username><password>admin</password></credentials></node>\n' "$i" "$((12900 + i))"
	  done
	  for i in $(seq 1 {{n}}); do
	    case $((i % 10)) in
	      7|8|9) b="<schedule>americas</schedule>" ;;
	      0) b="<schedule>asia</schedule>" ;;
	      *) b="" ;;
	    esac
	    d=""
	    x=""
	    if [ -n "${failing[$i]:-}" ]; then
	      d="<description>mock c8000v, fails: ${failing[$i]}</description>"
	      x="<failure>${failing[$i]}</failure>"
	    fi
	    printf '        <device><name>cpe-%04d</name><type>iosxe</type><shard>flotilla-%d</shard>%s%s<credentials><username>admin</username><password>admin</password></credentials><mock><enabled>true</enabled><software><upgrade-duration>%d</upgrade-duration>%s</software></mock></device>\n' "$i" "$(( (i - 1) % 10 + 1 ))" "$b" "$d" "$(( lo + (i * 7) % span ))" "$x"
	  done
	  echo '    </fleet>'
	  echo '</data>'
	} > "$f"
	{
	  echo '<?xml version="1.0" encoding="utf-8"?>'
	  echo '<data>'
	  now=$(date +%s)
	  at() { echo $(( (now + $1 * 60 + $2) % 86400 )); }
	  # A schedule named in SOON opens $3 seconds from now; any other at
	  # its local midnight.
	  opens() { if [[ $soon == all || ",$soon," == *",$1,"* ]]; then at "$2" "$3"; else echo 0; fi; }
	  echo '    <schedules xmlns="urn:fleetmgr:maintenance">'
	  printf '        <schedule><name>europe</name><utc-offset>60</utc-offset><window><at>%d</at><duration>{{window}}</duration></window></schedule>\n' "$(opens europe 60 30)"
	  printf '        <schedule><name>americas</name><utc-offset>-300</utc-offset><window><at>%d</at><duration>{{window}}</duration></window></schedule>\n' "$(opens americas -300 90)"
	  printf '        <schedule><name>asia</name><utc-offset>480</utc-offset><window><at>%d</at><duration>{{window}}</duration></window></schedule>\n' "$(opens asia 480 150)"
	  echo '    </schedules>'
	  echo '    <software xmlns="urn:fleetmgr:software">'
	  echo '        <upgrade-campaign>'
	  echo '            <name>fleet-upgrade</name>'
	  echo '            <target-release>17.18.03a</target-release>'
	  echo '            <image-url>scp://admin:admin@127.0.0.1:/images/c8000v-universalk9.17.18.03a.SPA.bin</image-url>'
	  for i in $(seq 1 {{n}}); do
	    printf '            <device><name>cpe-%04d</name></device>\n' "$i"
	  done
	  echo '            <admin-state>plan</admin-state>'
	  echo '            <default-schedule>europe</default-schedule>'
	  echo '            <target-rate>{{target}}</target-rate>'
	  echo '            <max-rate>{{max}}</max-rate>'
	  echo '        </upgrade-campaign>'
	  echo '    </software>'
	  echo '</data>'
	} > "$c"
	echo "Generated $f and $c: {{n}} devices, target {{target}}/h, max {{max}}/h, $count failing, installs {{duration}} s, windows {{window}} s, opening soon: $soon"

# Recompute the running demo's regional windows so they open about 30, 90
# and 150 seconds from now, WINDOW seconds long; pass the length and the
# SOON list the demo was started with, so a demo that keeps americas and
# asia at their local midnight only moves europe. The campaigns replan on
# the schedule change. Devices that already upgraded stay upgraded;
# restart the demo for a fresh run.
demo-reschedule window="3600" soon="all":
	#!/usr/bin/env bash
	set -euo pipefail
	[[ "{{window}}" =~ ^[0-9]+$ && {{window}} -gt 0 ]] || { echo "window must be seconds, not '{{window}}'" >&2; exit 1; }
	soon="{{soon}}"
	[[ $soon =~ ^(all|(europe|americas|asia)(,(europe|americas|asia))*)$ ]] || { echo "soon must be all or a list of europe, americas and asia, not '$soon'" >&2; exit 1; }
	now=$(date +%s)
	at() { echo $(( (now + $1 * 60 + $2) % 86400 )); }
	chosen() { [[ $soon == all || ",$soon," == *",$1,"* ]]; }
	# async: the write applies but its answer can get lost when a live
	# campaign links the schedule, the same open engine bug as elsewhere.
	put() { curl -fsS --max-time 5 -X PUT -H "Content-Type: application/yang-data+json" -H "async: true" --data-binary "{\"maintenance:schedule\": [{\"name\": \"$1\", \"utc-offset\": $2, \"window\": [{\"at\": $3, \"duration\": {{window}}}]}]}" "{{fleetmgr_api}}/restconf/data/maintenance:schedules/schedule=$1" > /dev/null; }
	moved=()
	chosen europe && put europe 60 "$(at 60 30)" && moved+=("europe in ~30s")
	chosen americas && put americas -300 "$(at -300 90)" && moved+=("americas in ~90s")
	chosen asia && put asia 480 "$(at 480 150)" && moved+=("asia in ~150s")
	echo "Windows recomputed, {{window}} s long: ${moved[*]}"

# The thousand-device preset: `just demo-fleet` with 120-150 s installs, a
# tenth of the fleet failing and four-hour windows at a quarter of the fleet
# per hour, about ten in flight, so europe's six hundred devices take two
# and a half hours of their window. Only europe is pulled forward to open
# half a minute in; americas and asia keep their local midnight, so the
# plan shows them where a real fleet's windows are, and
# `just demo-reschedule 14400 europe` reopens europe alone. A thousand
# devices come up in about half a minute and take about a gigabyte. Do not
# run it alongside `just demo`.
demo-big n="1000":
	#!/usr/bin/env bash
	set -euo pipefail
	target=$(( ({{n}} + 3) / 4 ))
	exec just demo-fleet {{n}} "$target" "$((target * 2))" 10 120-150 14400 europe

# Submit the three-device IOS XE demo campaign. The transaction applies but
# its response can hang (open engine bug), so cap the wait and watch state.
upgrade:
	@curl -fsS --max-time 5 -X PATCH -H "Content-Type: application/yang-data+xml" --data-binary @upgrade.xml "{{fleetmgr_api}}/restconf/data" || true
	@echo "Submitted xe-upgrade"

# Print one normalized snapshot of a campaign's operational state.
campaign-status campaign="xe-upgrade":
	#!/usr/bin/env bash
	set -euo pipefail
	state="$(curl -fsS -H 'Accept: application/yang-data+json' '{{fleetmgr_api}}/restconf/data' | jq -c --arg campaign '{{campaign}}' '
	  .["software:software"]["upgrade-campaign"][]?
	  | select(.name == $campaign)
	  | {
	      campaign: .name,
	      total: (.state.total // 0),
	      in_progress: (.state["in-progress"] // 0),
	      succeeded: (.state.succeeded // 0),
	      failed: (.state.failed // 0),
	      devices: [
	        .state["device-status"][]?
	        | {
	            device,
	            status: (.status // "pending"),
	            running_release: .["running-release"]
	          }
	      ]
	    }
	')"
	if [[ -z "$state" ]]; then
	  echo "Campaign {{campaign}} does not exist" >&2
	  exit 1
	fi
	jq . <<<"$state"

# Poll a campaign, printing only state changes and stopping when it completes.
watch-campaign campaign="xe-upgrade":
	#!/usr/bin/env bash
	set -euo pipefail
	previous=''
	while true; do
	  state="$(curl -fsS -H 'Accept: application/yang-data+json' '{{fleetmgr_api}}/restconf/data' | jq -c --arg campaign '{{campaign}}' '
	    .["software:software"]["upgrade-campaign"][]?
	    | select(.name == $campaign)
	    | {
	        campaign: .name,
	        total: (.state.total // 0),
	        in_progress: (.state["in-progress"] // 0),
	        succeeded: (.state.succeeded // 0),
	        failed: (.state.failed // 0),
	        devices: [
	          .state["device-status"][]?
	          | {
	              device,
	              status: (.status // "pending"),
	              running_release: .["running-release"]
	            }
	        ]
	      }
	  ')"
	  if [[ -z "$state" ]]; then
	    state='{"campaign":"{{campaign}}","status":"waiting for campaign"}'
	  fi
	  if [[ "$state" != "$previous" ]]; then
	    jq . <<<"$state"
	    previous="$state"
	  fi
	  if jq -e '(.total // 0) > 0 and .in_progress == 0 and ((.succeeded + .failed) >= .total)' <<<"$state" >/dev/null; then
	    exit 0
	  fi
	  sleep 0.1
	done

# Start watching before submitting, so the short mock in-progress state is visible.
upgrade-and-watch:
	#!/usr/bin/env bash
	set -euo pipefail
	just watch-campaign xe-upgrade &
	watcher=$!
	trap 'kill "$watcher" 2>/dev/null || true' EXIT
	sleep 0.1
	just upgrade
	wait "$watcher"
	trap - EXIT

# Start the web UI dev server, proxying /restconf to the top. Run npm install in webui/ once.
webui port="3000":
	cd webui && STRATOWEAVE_API_ORIGIN={{fleetmgr_api}} npm run dev -- --port {{port}}

# Rebuild the web UI and regenerate the embedded-assets module
# (src/fleetmgr/webui_assets.act, committed); then `just build`. Needs Node.
gen-webui:
	rm -rf webui/build
	cd webui && npm ci --no-audit --no-fund && npm run check && npm run build && node scripts/gen-embedded-assets.mjs

# Controller pacing system test: a real fleetmgr deployment with slow mock
# devices, asserting releases arrive a few at a time. About a minute.
system-test:
	{{acton}} test --jobs 1 --module test_fleetmgr_pacing --tag fleetmgr-system --max-iter 1 --max-time 180000

test:
	{{acton}} test --module test_fleetmgr_cfs
	{{acton}} test --module test_fleetmgr_rfs
	{{acton}} test --module test_flotilla_rfs
	{{acton}} test --module fleetmgr.test_webui_assets
