module fleetmgr-rfs {
  yang-version "1.1";
  namespace "urn:fleetmgr:rfs";
  prefix fleetmgr-rfs;

  import stratoweave {
    prefix sw;
  }
  import stratoweave-rfs {
    prefix sw-rfs;
  }
  import fleetmgr-types {
    prefix fleetmgr-types;
  }

  augment "/sw-rfs:rfs" {
    list device {
      key name;

      sw:rfs-transform fleetmgr.rfs.Device;

      leaf name {
        type string;
      }

      leaf type {
        type string;
        mandatory true;
      }

      uses fleetmgr-types:device-options;
      uses fleetmgr-types:upgrade-checks;
      uses fleetmgr-types:software-options;

      container state {
        config false;
        description
          "What the flotilla reports for this device: the software state
           from its /device/software/state and the platform from its
           /device/state/platform. One container, so one subscription
           takes both: a subtree filter of two branches drops a device
           while either is absent.";
        uses fleetmgr-types:upgrade-status;
        container platform {
          uses fleetmgr-types:platform;
        }
      }
    }
  }
}
