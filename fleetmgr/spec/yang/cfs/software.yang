module software {
  yang-version "1.1";
  namespace "urn:fleetmgr:software";
  prefix sw-cfs;

  import stratoweave {
    prefix sw;
  }
  import fleetmgr {
    prefix fleetmgr;
  }

  container software {
    list upgrade-campaign {
      key name;

      sw:transform fleetmgr.cfs.UpgradeCampaign;
      leaf name {
        type string;
      }
      leaf target-release {
        description "Software release the selected devices should be running.";
        type string;
        mandatory true;
      }
      leaf image-url {
        description "Image URL used by devices that pull their own software.";
        type string;
      }
      leaf allow-staging {
        description "Allow the image to be staged before the impacting step.";
        type boolean;
        default "false";
      }
      list device {
        key name;
        description "Devices this campaign upgrades.";
        leaf name {
          sw:link inventory;
          type leafref {
            path "/fleetmgr:fleet/fleetmgr:device/fleetmgr:name";
          }
        }
      }
      leaf admin-state {
        description
          "plan: the campaign is declared and inspectable but does nothing.
           run: the campaign sets the software target on its devices.";
        type enumeration {
          enum plan;
          enum run;
        }
        default plan;
      }

      list window {
        description
          "Explicit maintenance window occurrences the campaign is planned
           into, as offsets from the moment the campaign is set to run. An
           interim stand-in for referencing maintenance-schedule objects,
           which will feed the planner's window generators. Devices that do
           not fit in the given windows are not actuated and surface as
           alarms in the plan.";
        key "start";
        leaf start {
          description "Window open, seconds after campaign launch.";
          type uint32;
          units "seconds";
        }
        leaf duration {
          type uint32;
          units "seconds";
          mandatory true;
        }
      }
      leaf deadline {
        description
          "When the campaign must be finished, seconds after launch. The
           deadline cuts off the window iterator: only window time before it
           counts, and the required rate is computed backwards from it.
           Devices that cannot be placed before the deadline surface as
           alarms.";
        type uint32;
        units "seconds";
      }
      leaf target-rate {
        description
          "Preferred upgrade pace. The planner goes faster only when the
           deadline requires it. 0 means no preference.";
        type uint32;
        units "devices per hour";
        default 100;
      }
      leaf max-rate {
        description
          "Hard cap on the upgrade pace, regardless of deadline pressure.
           A deadline that cannot be met within max-rate raises an alarm.
           0 means no cap.";
        type uint32;
        units "devices per hour";
        default 500;
      }

      container state {
        config false;
        leaf total {
          type uint32;
        }
        leaf in-progress {
          type uint32;
        }
        leaf succeeded {
          type uint32;
        }
        leaf failed {
          type uint32;
        }
        container plan {
          description
            "The materialized plan: every window the campaign is placed
             into, the devices assigned to each, and their estimated times.
             Starts and durations are estimates, not guarantees; the plan is
             computed the same way whether the campaign is in plan or run,
             so it can be inspected before anything is actuated.";
          list window {
            key "start";
            leaf start {
              description "Estimated window open, seconds since the Unix epoch.";
              type uint64;
            }
            leaf end {
              type uint64;
            }
            leaf schedule {
              type string;
            }
            list device {
              key name;
              leaf name {
                type string;
              }
              leaf estimated-start {
                description "Seconds since the Unix epoch; an estimate.";
                type uint64;
              }
              leaf estimated-duration {
                type uint32;
                units "seconds";
              }
            }
          }
          leaf-list alarm {
            description "Placement problems, such as devices that did not fit.";
            type string;
          }
        }
        list device-status {
          key device;
          leaf device {
            type string;
          }
          leaf status {
            type string;
          }
          leaf running-release {
            type string;
          }
        }
      }
    }
  }
}
