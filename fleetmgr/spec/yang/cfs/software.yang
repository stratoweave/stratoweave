module software {
  yang-version "1.1";
  namespace "urn:fleetmgr:software";
  prefix sw-cfs;

  import stratoweave {
    prefix sw;
  }
  import maintenance {
    prefix maint;
  }
  import fleetmgr {
    prefix fleetmgr;
  }

  grouping plan-layout {
    list window {
      description
        "One planned window occurrence: when it opens and closes as seconds
         after campaign launch, and the devices placed in it with their
         estimated offsets. An open-ended window has no end.";
      key "schedule start";
      leaf schedule {
        description "Name of the window's source; a campaign without
           windows plans into one synthetic default window.";
        type string;
      }
      leaf start {
        type uint32;
        units "seconds";
      }
      leaf end {
        type uint32;
        units "seconds";
      }
      list device {
        key name;
        leaf name {
          type string;
        }
        leaf estimated-start {
          type uint32;
          units "seconds";
        }
        leaf estimated-duration {
          type uint32;
          units "seconds";
        }
      }
    }
    leaf-list alarm {
      description "Placement problems, such as devices that did not fit.";
      type string;
    }
  }

  container software {
    list upgrade-campaign {
      key name;

      sw:transform fleetmgr.cfs.UpgradeCampaign;
      sw:link schedules {
        sw:path /maint:schedules;
      }
      leaf name {
        type string;
      }
      leaf target-release {
        description "Software release the selected devices should be running.";
        type string;
        mandatory true;
      }
      leaf image-url {
        description "Image URL used by devices that pull their own software.";
        type string;
      }
      leaf allow-staging {
        description "Allow the image to be staged before the impacting step.";
        type boolean;
        default "false";
      }
      list device {
        key name;
        description "Devices this campaign upgrades.";
        leaf name {
          sw:link inventory;
          type leafref {
            path "/fleetmgr:fleet/fleetmgr:device/fleetmgr:name";
          }
        }
      }
      leaf admin-state {
        description
          "plan: the campaign is declared and inspectable but does nothing.
           run: the campaign sets the software target on its devices.";
        type enumeration {
          enum plan;
          enum run;
        }
        default plan;
      }

      leaf default-schedule {
        description
          "Schedule for members whose device has no binding of its own.
           Devices bound to a schedule are placed only in its windows, and
           devices that do not fit are not actuated and surface as alarms
           in the plan. A campaign with no default and no bound members
           gets one synthetic window that opens at launch and never
           closes; a deadline closes it like any window.";
        type leafref {
          path "/maint:schedules/maint:schedule/maint:name";
        }
      }
      leaf deadline {
        description
          "When the campaign must be finished, seconds after launch. The
           deadline cuts off the window iterator: only window time before it
           counts, and the required rate is computed backwards from it.
           Devices that cannot be placed before the deadline surface as
           alarms.";
        type uint32;
        units "seconds";
      }
      leaf target-rate {
        description
          "Preferred upgrade pace. The planner goes faster only when the
           deadline requires it. 0 means no preference.";
        type uint32;
        units "devices per hour";
        default 100;
      }
      leaf max-rate {
        description
          "Hard cap on the upgrade pace, regardless of deadline pressure.
           A deadline that cannot be met within max-rate raises an alarm.
           0 means no cap.";
        type uint32;
        units "devices per hour";
        default 500;
      }

      container dynstate {
        sw:dynstate;
        description
          "The controller's decision: which planned devices are released.
           The companion actor computes releases from telemetry and the
           planned layout; the transform actuates exactly this set. Every
           campaign is paced this way - a device never starts before the
           controller says so.";
        leaf-list released {
          type string;
        }
      }

      container state {
        config false;
        leaf total {
          type uint32;
        }
        leaf in-progress {
          type uint32;
        }
        leaf succeeded {
          type uint32;
        }
        leaf failed {
          type uint32;
        }
        container plan {
          description
            "The materialized plan: every window the campaign is placed
             into, the devices assigned to each, and their estimated times
             as offsets from launch. The companion actor computes it from
             the campaign; the transform actuates the same computation, so
             what runs is what is shown. Estimates, not guarantees; the
             plan is computed the same way whether the campaign is in plan
             or run, so it can be inspected before anything is actuated.";
          uses plan-layout;
        }
        list device-status {
          key device;
          leaf device {
            type string;
          }
          leaf status {
            type string;
          }
          leaf running-release {
            type string;
          }
        }
      }
    }
  }
}
