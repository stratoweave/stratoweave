module maintenance {
  yang-version "1.1";
  namespace "urn:fleetmgr:maintenance";
  prefix maint;

  import stratoweave {
    prefix sw;
  }

  container schedules {
    description
      "The named maintenance schedules: generators of the absolute window
       occurrences in which impacting work on the devices bound to a
       schedule may run. Devices bind to a schedule by name on their
       inventory entry and campaigns name one as their default, so a
       schedule outlives any one campaign. The container is a transform
       so campaigns can link it and re-plan when any schedule changes.";

    sw:transform fleetmgr.cfs.Schedules;

    list schedule {
      key name;
      leaf name {
        type string;
      }
      leaf utc-offset {
        description
          "The schedule's local timezone, as minutes east of UTC. A stand
           in until proper timezone names arrive: it pretends there is no
           daylight saving.";
        type int16 {
          range "-720..840";
        }
        units "minutes";
        default 0;
      }
      list window {
        description
          "One recurrence rule: the window opens at the local time of day
           on the listed weekdays, and every day when none are listed.
           An edit of the rules or of utc-offset that takes away a window
           that a campaign promised to waiting members, before it closes,
           moves each promise to the window of the schedule that has not
           closed and whose opening is nearest, the later one of two as
           near. So a window moved by less than half a day, or made longer
           or shorter, that closes after the edit keeps its members on
           their day; a larger move can put them on the day before or
           after.";
        key "id";
        leaf id {
          description "Number of the window within its schedule.";
          type uint8;
        }
        leaf description {
          description "Optional label, e.g. weeknights.";
          type string;
        }
        leaf at {
          description
            "Local time of day the window opens, as seconds after
             midnight. On a day two windows open at the same time, the
             longer one counts.";
          type uint32 {
            range "0..86399";
          }
          units "seconds";
          mandatory true;
        }
        leaf duration {
          type uint32;
          units "seconds";
          mandatory true;
        }
        leaf-list day {
          type enumeration {
            enum mon;
            enum tue;
            enum wed;
            enum thu;
            enum fri;
            enum sat;
            enum sun;
          }
        }
      }
    }
  }
}
