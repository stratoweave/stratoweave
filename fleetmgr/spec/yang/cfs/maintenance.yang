module maintenance {
  yang-version "1.1";
  namespace "urn:fleetmgr:maintenance";
  prefix maint;

  import stratoweave {
    prefix sw;
  }

  container schedules {
    description
      "The named maintenance schedules: the windows in which impacting
       work on the devices bound to a schedule may run. Devices bind to a
       schedule by name on their inventory entry and campaigns name one
       as their default, so a schedule outlives any one campaign. The
       container is a transform so campaigns can link it and re-plan when
       any schedule changes.";

    sw:transform fleetmgr.cfs.Schedules;

    list schedule {
      key name;
      leaf name {
        type string;
      }
      list window {
        description
          "Window occurrences as offsets from campaign launch for now;
           recurring wall-clock windows come later.";
        key "start";
        leaf start {
          description "Window open, seconds after campaign launch.";
          type uint32;
          units "seconds";
        }
        leaf duration {
          type uint32;
          units "seconds";
          mandatory true;
        }
      }
    }
  }
}
