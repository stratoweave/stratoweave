module fleetmgr {
  yang-version "1.1";
  namespace "urn:fleetmgr:fleetmgr";
  prefix fleetmgr;

  import stratoweave {
    prefix sw;
  }
  import maintenance {
    prefix maint;
  }
  import fleetmgr-types {
    prefix fleetmgr-types;
  }

  container fleet {
    list node {
      key name;

      sw:transform fleetmgr.cfs.Node;

      leaf name {
        type string;
      }

      uses fleetmgr-types:device-options;
    }

    list device {
      key name;

      sw:transform fleetmgr.cfs.Device;

      leaf name {
        type string;
      }

      leaf type {
        description "Device platform type understood by the owning flotilla.";
        type string;
        mandatory true;
      }

      leaf shard {
        description "Name of the flotilla node that owns this device.";
        type string;
        mandatory true;
      }

      leaf schedule {
        description
          "Maintenance schedule this device is bound to. A campaign places
           the device only in windows of this schedule; without a binding
           the campaign's default schedule applies.";
        type leafref {
          path "/maint:schedules/maint:schedule/maint:name";
        }
      }

      uses fleetmgr-types:device-options;
    }
  }
}
