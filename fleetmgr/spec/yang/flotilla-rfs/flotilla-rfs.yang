module flotilla-rfs {
  yang-version "1.1";
  namespace "urn:fleetmgr:flotilla-rfs";
  prefix flotilla-rfs;

  import stratoweave {
    prefix sw;
  }
  import stratoweave-rfs {
    prefix sw-rfs;
  }

  augment "/sw-rfs:rfs" {
    container device-health {
      description
        "BGP health read off the device: which sessions are established and
         how many prefixes the device advertises. The transform registers the
         device's software upgrade pre-check and post-check. The pre-check
         refuses while a configured session is down and records a baseline;
         the post-check passes once the device is back at that baseline, judged
         on a sample taken after the reload. The device is read only while a
         check runs, and the verdict detail carries what the check saw. Emits
         no device configuration.";

      sw:rfs-transform flotilla.rfs.DeviceHealth;

      container dynstate {
        description
          "Empty on purpose. The generator gives a transform an actor only
           when it has dynstate or operational state; this one publishes
           nothing but needs the actor to register the checks.";
        sw:dynstate;
      }

      leaf enabled {
        type boolean;
        default "true";
      }

      leaf poll-period {
        description
          "Seconds between reads of the device's BGP state while a check
           runs. A check answers from the first read taken after it started,
           so this bounds how long it waits.";
        units "seconds";
        type uint16 {
          range "1..max";
        }
        default 2;
      }

      leaf precheck-wait {
        description
          "Seconds the pre-check waits for an established session before it
           refuses. Keep it below the software manager's 60 s pre-check
           deadline, or the check counts as not answering.";
        units "seconds";
        type uint16 {
          range "1..max";
        }
        default 45;
      }

      leaf postcheck-wait {
        description
          "Seconds the post-check waits for the device to get back to the
           pre-check's baseline before it refuses, which aborts the
           activation. Keep it below the software manager's 900 s post-check
           deadline.";
        units "seconds";
        type uint16 {
          range "1..max";
        }
        default 600;
      }

    }
  }
}
