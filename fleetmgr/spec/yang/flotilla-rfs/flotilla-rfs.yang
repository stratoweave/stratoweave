module flotilla-rfs {
  yang-version "1.1";
  namespace "urn:fleetmgr:flotilla-rfs";
  prefix flotilla-rfs;

  import stratoweave {
    prefix sw;
  }
  import stratoweave-rfs {
    prefix sw-rfs;
  }

  augment "/sw-rfs:rfs" {
    container device-health {
      description
        "Health read off the device, in three checks. bgp: which sessions
         are established and how many prefixes the device advertises.
         interfaces: which interfaces are up with their line protocol up.
         ospf: the OSPF neighbors and their adjacency state. The transform
         registers each as one of the device's software upgrade pre-checks
         and post-checks, under its name. A pre-check records a baseline;
         the bgp pre-check also refuses while every configured session is
         down. A post-check passes once the device is back at its baseline,
         judged on a read taken after the reload. The device is read for a
         check only while it runs, and the verdict detail carries what the
         check saw. Emits no device configuration.";

      sw:rfs-transform flotilla.rfs.DeviceHealth;

      container dynstate {
        description
          "Empty on purpose. The generator gives a transform an actor only
           when it has dynstate or operational state; this one publishes
           nothing but needs the actor to register the checks.";
        sw:dynstate;
      }

      leaf enabled {
        type boolean;
        default "true";
      }

      leaf poll-period {
        description
          "Seconds between reads of the device for a check while it runs. A
           check answers from the first read taken after it started, so this
           bounds how long it waits.";
        units "seconds";
        type uint16 {
          range "1..max";
        }
        default 2;
      }

      leaf precheck-wait {
        description
          "Seconds a pre-check waits for a read that passes before it
           refuses. Keep it below the software manager's 60 s pre-check
           deadline, or the check counts as not answering.";
        units "seconds";
        type uint16 {
          range "1..max";
        }
        default 45;
      }

      leaf postcheck-wait {
        description
          "Seconds a post-check waits for the device to get back to the
           pre-check's baseline before it refuses, which aborts the
           activation. Keep it below the software manager's 900 s post-check
           deadline.";
        units "seconds";
        type uint16 {
          range "1..max";
        }
        default 600;
      }

    }
  }
}
