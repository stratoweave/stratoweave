name = "fleetmgr"
fingerprint = 0x06beb4d801beae1a
dependencies = {
    "lmdb": (
        follows="stratoweave.lmdb"
    ),
    "stratoweave": (
        path="../"
    ),
    "yang": (
        follows="stratoweave.yang"
    )
}
zig_dependencies = {}

# 16 KiB GC blocks with an 8192-byte thread-local limit, and no object end
# padding: on a 50k-device load the default collector settings take ~95
# collections, these take 5-8 (actonlang/acton#3212).
build_options = {
    "gc_block_size": "16384",
    "gc_thread_local_size_limit": "8192",
    "gc_no_end_padding": "true"
}
